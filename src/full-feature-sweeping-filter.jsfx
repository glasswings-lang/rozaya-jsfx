desc: Resonant Sweeping Filter with Shaped LFO and Pan Modes
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/

slider1:500<20,20000,1>Frequency Low Hz
slider2:5000<20,20000,1>Frequency High Hz
slider5:2<0.001,1000,0.001>Rate Value (BPM / sec / Hz / beats per cycle / per beat)
// RATE MODE ORDER IS {BPM, Seconds, Hz, Host x} since 2026-09-04 -- the suite's
// canonical order, shared with both Polyrhythms, Shepard Tone and the Morpher.
// This plugin ran {Hz, Seconds, BPM, Host x}: the same four, a different order,
// for no reason anyone recorded. Rozaya: "this is what I mean when I talk about
// shit needing to be standardized."
//
// EVERY DISPATCH LISTS ALL FOUR BRANCHES EXPLICITLY. The old code used a bare
// else to mean BPM; after the reorder that same else means Hz, and nothing would
// have complained -- the plugin would simply have run the wrong unit. Saved
// projects are carried over by tools/ratemode_migrate_order.py.
slider6:0<0,4,1{BPM,Seconds,Hz,Every N beats,N per beat}>Rate Mode
slider7:0<-180,180,0.1>LFO Start Phase (degrees)
slider8:50<0,100,0.1>On Duration % of Cycle
slider9:100<0,100,0.1>Depth %
slider10:0<0,100,0.1>Attack %
slider12:0<0,100,0.1>Release %
slider11:1<0,3,1{Linear,Cosine,Logarithmic,Exponential}>Attack Shape
slider13:1<0,3,1{Linear,Cosine,Logarithmic,Exponential}>Release Shape
slider3:0.7<0,1,0.01>Resonance
slider14:0<-180,180,0.1>R Channel Phase Offset degrees
slider15:0<0,1,1{Independent L+R,Offset from L}>Phase Mode
slider24:1<0,1,0.01>Wet/Dry Mix
// ===== PAN BLOCK SLIDERS START =====
slider16:0<0,1,1{Off,On}>Pan Enabled
slider17:0<0,15,1{Mono,Alternating,Alternating (Flipped),Distributed,Distributed (Flipped),Distributed (Ping-pong),Converging,Converging (Ping-pong),Diverging,Diverging (Ping-pong),Pan Sweep,Pan Sweep (Flipped),Linked Sweep,Alternating every 2,Alternating every 4,Alternating every 8}>Pan Mode
slider18:1<0,1,0.01>Pan Spread (0=mono, 1=full)
slider19:5<0,1000,0.1>Pan Glide ms (0=instant)
slider20:8<2,1000,1>Cycle Steps (per-cycle modes)
slider21:2<0.001,1000,0.001>Pan Sweep Rate
// R20, 2026-09-05: the canonical four, in the canonical order, and it gains
// Host x. This list used to read {Hz, Seconds, BPM} -- BACKWARDS against the
// Rate Mode eighteen places above it in this same plugin, so position one meant
// Hz here and BPM there. For someone arrowing the parameter list one control at
// a time that is a trap. All 20 stored instances are on Hz, so the migration is
// one uniform index 0 -> 2.
slider22:0<0,4,1{BPM,Seconds,Hz,Every N beats,N per beat}>Pan sweep rate mode
slider23:1<0.001,1000,0.001>Pan sweep every (cycles)

// Named picker for the Linked Sweep multiplier, same idea as Host ratio: the
// raw control is a MULTIPLIER with 0.125 steps, so asking for half speed means
// typing 0.5 and a quarter means 0.25 -- exposed decimals for something you
// could just name. Entries are labelled by what you HEAR, never as note values.
// Only ratios that land on the 0.125 grid are offered (no "every 3 cycles",
// since a third isn't representable there).
// Writes the multiplier on change then gets out of the way; "Custom" (default)
// never writes, and is what a project saved before this slider existed lands
// on, so nothing already tuned by hand is touched.
// ===== PAN BLOCK SLIDERS END =====

// Pass-through for N units after playback starts, then apply the
// filter sweep + pan effect normally. Units match Rate Mode (BPM
// beats / Seconds / Hz cycles), interpreted against Rate Value. As an
// EFFECT plugin the dry signal passes through during the delay. Re-
// arms on every transport stop/start. 0 disables the delay.
slider25:0<0,1000,0.001>Start delay (in rate mode units)

// Per-cycle Play/Rest gate. Effect is applied normally for N cycles
// of the Rate Value, then bypassed (dry signal passes through
// unchanged) for M cycles, then resumes — repeats forever. Cycle
// unit matches Start Delay. As an EFFECT plugin, "rest" means dry
// pass-through (NOT silence) — silencing the input would mute the
// upstream track. The transition between effect-on and dry uses a
// ~3 ms fade. 0 in either slider disables the gate. Resets on
// every transport stop/start.
slider26:0<0,1000,1>Play for (cycles)
slider27:0<0,1000,1>Rest for (cycles)

// What the LFOs do during the rest period.
//   Walk through (default) — filter sweep LFO and pan LFOs keep
//     cycling during rest. When the effect resumes, the cutoff has
//     swept to a different position.
//   Freeze in place — LFO phases pause, frozen at their values at
//     rest entry. When the effect resumes, the cutoff picks up
//     from the same position. The rhythmic sweep pauses and
//     resumes in lockstep with the gate.
slider28:0<0,1,1{Walk through,Freeze in place}>LFO at rest

// What the output does during the rest period.
//   Pass-through (default) — dry signal passes through unchanged
//     (matches Start Delay's behavior). Effect plugins normally
//     don't silence their input.
//   Silence — wet+dry mix smooths to 0; the audio drops out during
//     rest instead of passing dry. Useful when you want the gate
//     to act like a hard mute rather than a filter bypass.
//     Combines cleanly with either Rest LFO setting.
slider29:0<0,1,1{Pass-through,Silence}>Output at rest

// Speed ramp: signed-delta, nested-selector (brought to Drift parity in
// the automation-replacement sweep, see docs/planned-features.md). Ships in
// v2.14. Pick a target (slider38), then slider39 is the `by` amount for THAT
// target; all 6 targets ramp in parallel and the selector only chooses which
// one slider39 is editing. Same 6 targets as Drift (Sweep Rate, Frequency
// Low, Frequency High, Pan Sweep Rate, Resonance, Wet/Dry).
//
// Units per target match Drift. For the rate-type targets (Sweep Rate, Pan
// Sweep Rate) mode-direction is handled the same way drift does it — in
// BPM/Hz modes negative `by` = slower, in Seconds mode positive `by` = slower
// (longer period). Frequency targets are Hz, Resonance/Wet-Dry are 0-1
// fractions. The ±5000 range covers ±5 kHz frequency ramps and full rate
// ramps; Resonance/Wet-Dry use the low end.
//
// A ~100 ms smoother on freq removes clicks from manual Rate adjustment.
// Linked Sweep pan mode (12) scales with the Sweep Rate ramp; the two
// pan-sweep modes (10, 11) have their own rate, now rampable via the Pan
// Sweep Rate target. Engage (slider44) is a freeze/resume gate (NOT a restart
// edge); only transport play resets ramp_t.
//
// The Speed ramp target selector is slider38 (top of this block) so that in
// the UI / NVDA parameter order it reads ABOVE the by/duration/engage
// controls it governs. Achieving that meant renumbering the Speed Ramp +
// Drift blocks (REAPER orders sliders by ID, not file position): Speed Ramp
// is now 29-33, Drift is 34-38. Existing Sweeping Filter projects reset their
// Speed Ramp + Drift configs on upgrade (both off-by-default; the filter
// sound on sliders 1-28 is untouched). Re-add the instance for clean
// defaults, or reconfigure. See the manual's migration note.
slider38:0<0,5,1{Sweep Rate,Frequency Low,Frequency High,Pan Sweep Rate,Resonance,Wet/Dry}>Ramp target
slider39:0<-5000,5000,0.001>Ramp by (units match target)
// NEW 2026-09-05. Minutes is what this plugin's Ramp duration and start delay
// already counted in, so index 0 leaves every saved value meaning what it did.
slider40:2<0,3,1{Cycles,Seconds,Minutes,Beats}>Ramp time unit
slider41:0<0,1000,0.1>Ramp duration (in ramp time units)
// NEW 2026-09-05. Turns the climb into a STAIRCASE -- climb, hold, climb. The
// holds come OUT of the duration rather than extending it, so Ramp duration goes
// on meaning "you arrive in about this long". Off unless BOTH are > 0.
slider42:0<0,1000,0.01>Ramp play for (0 = smooth)
slider43:0<0,1000,0.01>Ramp rest for (0 = smooth)
slider44:0<0,1,1{Off,On}>Ramp engage
slider45:0<0,1000,0.1>Ramp start delay (in ramp time units)

// Per-target drift: nested-selector pattern matching Womb v3 / the rest of
// the sweep. Pick a target (slider30), then sliders 35-38 hold THAT target's
// drift config. Switching the selector saves current values to the old
// target's memory slot and loads the new target's values into the sliders.
// All 6 targets drift in parallel; the selector just chooses which one you're
// currently editing.
//
// Targets:
//   Sweep Rate      — wanders the filter LFO rate.
//   Frequency Low   — wanders the low edge of the sweep band (Hz).
//   Frequency High  — wanders the high edge of the sweep band (Hz).
//   Pan Sweep Rate  — wanders the Pan Sweep Rate (pan modes 10/11 only).
//   Resonance       — wanders the filter resonance (0-1).
//   Wet/Dry         — wanders the wet/dry mix (0-1).
//
// Period unit is filter LFO cycles for ALL targets, scaled by Speed Ramp. For
// slow wall-clock-feel drift, set a long period.
//
// Up/Down amount is in the target's natural unit: the rate's current unit
// (BPM / Seconds / Hz) for Sweep Rate, Hz for the two Frequency targets, the
// Pan Sweep Rate's unit for Pan Sweep Rate, and a 0-1 fraction for Resonance
// and Wet/Dry. The 0-5000 range covers the frequencies (±5 kHz wander) and
// rate/BPM; Resonance and Wet/Dry use the low end (e.g. 0.3), Hz-mode rates
// use small values. (Drift IDs shifted +1 from the old 33-37 layout in the
// v2.14 reorg above — same reset story.)
slider30:0<0,5,1{Sweep Rate,Frequency Low,Frequency High,Pan Sweep Rate,Resonance,Wet/Dry}>Drift target
slider31:0<0,5000,0.01>Drift up amount (units match target)
slider32:0<0,5000,0.01>Drift down amount (units match target)
slider33:8<0,1000,1>Drift period (0 = off)
// NEW 2026-09-05. The first entry is whatever THIS plugin already counted in,
// which here is CYCLES of its own sweep -- so nothing saved changes meaning, and
// a period of 8 goes on meaning "wander over eight sweeps" and follows the rate.
// Veil, the Phaser, Bubbler and Dapple say Seconds instead, because seconds is
// what THEY natively count in. The second entry is Beats in every case.
slider34:0<0,2,1{Cycles,Seconds,Beats}>Drift period unit
slider35:0<0,2,1{Sine,Triangle,Random}>Drift shape
// NEW 2026-09-05. Drift runs for a while and then FREEZES WHERE IT STANDS
// rather than returning to centre. Off unless BOTH are > 0, which is the
// default and is bit-identical to the old always-wandering behaviour.
slider36:0<0,1000,0.01>Drift play for (periods, 0 = always)
slider37:0<0,1000,0.01>Drift rest for (periods, 0 = always)

// Convenience picker for Host x. Writes a multiplier into Rate Value on
// change then gets out of the way; "Custom" (default) never writes. Not
// called "Free" -- that means FREE-RUNNING in sync UI, which the other
// three modes already are. Named for what you HEAR, not as note values.

// --- Slope, and an honest frequency axis -------------------------------------
// This plugin used to be a fixed two-pole Kellett cascade -- two one-pole
// sections with a resonance feedback path -- whose cutoff coefficient was
// `cut = 2*fc/srate`. That is the standard musicdsp idiom for it and it is
// approximately right at low frequencies, but measured, the real -3 dB corner
// landed at 0.21x to 0.77x the number on the slider, DEPENDING ON RESONANCE:
// at "500 Hz" the corner sat at 103 Hz with Resonance down and 382 Hz with it
// up. So Frequency Hz was never Hz, and Resonance was secretly a second
// frequency control -- sweeping it 0 to 1 moved the corner nearly two octaves.
//
// Replaced with a Butterworth cascade of TPT (zero-delay-feedback) state
// variable sections, 1 to 6 of them, which fixes both and adds the slope
// control this plugin never had. Each section gets its OWN Q from the pole
// angle formula, which is what puts -3 dB exactly on the number at every slope;
// cascading identical sections instead would slide the corner down by
// sqrt(2^(1/N)-1) and the label would drift further from the truth the steeper
// you went. Resonance is spread across the sections rather than applied to
// each, because peaks add in dB -- six mild ones would stack into a wall.
//
// Existing projects are migrated by tools/sweepfilter_migrate_hz.py, which
// rewrites each instance's Frequency Low/High so the real corner lands where it
// used to. The numbers change a lot; the sound does not.
slider4:0<0,5,1{-12,-24,-36,-48,-60,-72}>Slope (dB/oct)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: REAPER re-runs @init on every transport play / render
// start, resetting all runtime for free (LFO phases honoring Start Phase,
// filter state + cutoff smoothers, pan state, rate smoother re-seeded
// from the slider, drift runtime, Speed Ramp, Start Delay, Play/Rest +
// effect mix). Only the drift CONFIG bank must survive the re-run; it's
// guarded by drift_cfg_inited below.

// Host tempo capture. `tempo` is READ-ONLY in JSFX; read only, into a global
// deliberately not named `tempo`. Nothing remembers it across transport.
host_bpm   = max(tempo, 0.001);
host_scale = 1;
host_ratio_inited = 0;

phase_l = 0;
phase_r = 0;
// (n3/n4/rn3/rn4 were the old Kellett core's state; the cascade keeps its
//  own in svf_l/svf_r, cleared with the memset above.)
// Seeded in HZ now, not as a coefficient -- a 0.1 here used to mean a
// harmless 0.1 coefficient and would now mean 0.1 Hz, i.e. an audible
// ramp up from silence on every load.
cut_smooth_l = cut_smooth_r = max(20, slider1);
last_start_phase = -999;

// ===== PAN BLOCK INIT START =====
pan_l           = 0;
pan_l_smooth    = 0;
pan_cycle_index = 0;
pan_cycle_dir   = 1;
last_phase_l    = 0;
pan_phase       = 0;
// ===== PAN BLOCK INIT END =====


function apply_curve(t, shape) (
  shape == 0 ? t :
  shape == 1 ? (0.5 - 0.5 * cos(t * $pi)) :
  shape == 2 ? (log(1 + 9*t) / log(10)) :
               ((10^t - 1) / 9)
);

function calc_lfo(ph, on_secs, att_secs, rel_secs, period, att_shape, rel_shape)
local(on_frac, aw, rw, hold_w, re_start, t, result, total) (
  on_secs = min(on_secs, period);
  on_frac = on_secs / period;

  aw = att_secs / period;
  rw = rel_secs / period;

  aw + rw > on_frac ? (
    total = aw + rw;
    aw = aw / total * on_frac;
    rw = rw / total * on_frac;
  );

  hold_w   = on_frac - aw - rw;
  re_start = aw + hold_w;

  ph < aw ? (
    aw > 0.0001 ? (
      t = ph / aw;
      result = apply_curve(t, att_shape);
    ) : (result = 1);
  ) :
  ph < re_start ? (
    result = 1;
  ) :
  ph < on_frac ? (
    rw > 0.0001 ? (
      t = 1 - (ph - re_start) / rw;
      result = apply_curve(t, rel_shape);
    ) : (result = 0);
  ) : (
    result = 0;
  );
  result
);

// ===== PAN BLOCK FUNCTIONS START =====
function percycle_pan(idx, n_steps) local(steps, step, pos) (
  n_steps = max(n_steps, 1);
  steps   = max(ceil((n_steps - 1) / 2.0), 1);

  pan_mode == 0 ? (
    pos = 0;
  ) : pan_mode == 1 ? (
    pos = (idx % 2 == 0) ? -1 : 1;
  ) : pan_mode == 2 ? (
    pos = (idx % 2 == 0) ? 1 : -1;
  ) : pan_mode == 3 ? (
    n_steps > 1 ? (pos = (idx % n_steps) / (n_steps - 1.0) * 2.0 - 1.0) : (pos = 0);
  ) : pan_mode == 4 ? (
    n_steps > 1 ? (pos = 1.0 - (idx % n_steps) / (n_steps - 1.0) * 2.0) : (pos = 0);
  ) : pan_mode == 5 ? (
    n_steps > 1 ? (pos = idx / (n_steps - 1.0) * 2.0 - 1.0) : (pos = 0);
  ) : pan_mode == 6 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = -1.0;
    ) : (
      step = ceil((idx + 1) / 2);
      pos = (idx % 2 == 1) ?  (1.0 - (step - 1.0) / steps)
                            : -(1.0 - (step - 1.0) / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : pan_mode == 7 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = -1.0;
    ) : (
      step = ceil((idx + 1) / 2);
      pos = (idx % 2 == 1) ?  (1.0 - (step - 1.0) / steps)
                            : -(1.0 - (step - 1.0) / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : pan_mode == 8 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = 0.0;
    ) : (
      step = floor((idx + 1) / 2);
      pos = (idx % 2 == 1) ? -(step / steps)
                            :  (step / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : pan_mode == 9 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = 0.0;
    ) : (
      step = floor((idx + 1) / 2);
      pos = (idx % 2 == 1) ? -(step / steps)
                            :  (step / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : (pan_mode == 13 || pan_mode == 14 || pan_mode == 15) ? (
    // Alternating every N. The same flip, held for N cycles a side, so
    // bilateral stays usable when the cycles themselves are fast.
    step = pan_mode == 13 ? 2 : pan_mode == 14 ? 4 : 8;
    pos  = (floor(idx / step) % 2 == 0) ? -1 : 1;
  ) : (
    pos = 0;
  );

  pos * pan_spread
);
// ===== PAN BLOCK FUNCTIONS END =====

// Start Delay state.
last_play_state     = 0;
start_delay_elapsed = 0;
start_delay_sec     = 0;

// Play/Rest gate state. pr_cycle_progress is a continuous fractional
// counter (cycles elapsed in the current play or rest period).
// effect_mix smoothly transitions between 1 (effect fully on) and
// 0 (full dry pass-through) at rest boundaries — the wet mix and
// pan blend with their dry equivalents via this mix, so the gate
// is a soft fade rather than an abrupt switch.
pr_resting        = 0;
pr_cycle_progress = 0;
play_for_cycles   = 0;
rest_for_cycles   = 0;
pr_enabled        = 0;
rest_lfo_mode     = 0;
rest_output_mode  = 0;
effect_mix        = 1;

// Speed ramp + rate smoother state. Seeded from current slider values
// in @init so the first sample after transport-start uses the saved
// rate, not a default — same pattern as Tremolo.
rate_smoother_coeff      = 1.0 - exp(-1.0 / (srate * 0.1));
// Host x (3) was MISSING from this list and fell through to the BPM branch,
// seeding the smoother 60x too slow in that mode. The Tremolo had this same bug
// and had it fixed; the fix was never carried across -- found 2026-09-04 only
// because the reorder made the fallthrough impossible to leave implicit.
slider6 == 0 ? (freq_smoothed = slider5 / 60) :
slider6 == 1 ? (freq_smoothed = 1 / max(slider5, 0.001)) :
slider6 == 2 ? (freq_smoothed = slider5) :
               (freq_smoothed = slider5 > 0.001 ? 1 / slider5 : 0.001);   // 3 Host x
// Speed Ramp state. Engage (global) is a freeze/resume gate, not an edge;
// only transport play resets the per-target ramp clocks. As of v2.14 the
// ramp is PER-TARGET (own by/duration/start-delay/clock per target; banks
// below). speed_scale_current is the Sweep-Rate ramp factor (recomputed each
// sample).
speed_scale_current      = 1.0;

// --- v2.9 Drift target memory banks ---
//
// 6 targets × 8 fields. Each array is 16-slot-spaced so targets can
// grow to 16 later. This plugin uses no other memory arrays (all
// scalar state), so the bank lives at 1024 with plenty of headroom.
//
// Targets:
//   0 = Sweep Rate      (units: rate's current unit)
//   1 = Frequency Low   (units: Hz)
//   2 = Frequency High  (units: Hz)
//   3 = Pan Sweep Rate  (units: Pan Sweep Rate's unit; modes 10/11 only)
//   4 = Resonance       (units: 0-1 fraction)
//   5 = Wet/Dry         (units: 0-1 fraction)
N_TARGETS = 6;
target_drift_up     = 1024;
target_drift_down   = 1040;
target_drift_per    = 1056;
target_drift_shape  = 1072;
target_drift_phase  = 1088;
target_drift_prev   = 1104;
target_drift_curr   = 1120;
target_drift_offset = 1136;

// Speed ramp per-target banks (v2.14). Mirror the drift banks; 16-slot-spaced
// after target_drift_offset (1136). `by` / duration / start-delay are CONFIG
// (survive transport, restored by @serialize); ramp_t / delay_elapsed are
// RUNTIME (reset every @init / transport play).
speed_ramp_by_mem            = 1152;  // signed delta per target (CONFIG)
speed_ramp_dur_mem           = 1168;  // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 1184;  // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 1200;  // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 1216;  // delay sample counter per target (RUNTIME)

// CONFIG banks (drift up/down/period/shape + speed-ramp by/duration/start-delay
// + selector trackers) — guarded by drift_cfg_inited so the @init re-run on
// every transport play (Path A render fix, no ext_noinit) does NOT wipe the
// user's setup. @serialize restores saved configs on project reload.
drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_TARGETS,
    target_drift_up[i]    = 0;
    target_drift_down[i]  = 0;
    target_drift_per[i]   = 8;
    target_drift_shape[i] = 0;
    speed_ramp_by_mem[i]    = 0;
    speed_ramp_dur_mem[i]   = 0;
    speed_ramp_delay_mem[i] = 0;
    i += 1;
  );
  last_target_select = 0;
  last_sr_target     = 0;
  drift_cfg_inited = 1;
);

// Drift + speed-ramp RUNTIME resets on EVERY @init (every transport play).
i = 0;
loop(N_TARGETS,
  target_drift_phase[i]  = 0;
  target_drift_prev[i]   = 0;
  target_drift_curr[i]   = 0;
  target_drift_offset[i] = 0;
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  i += 1;
);


// --- Butterworth cascade state. Two words per section, per channel, plus the
//     per-section damping table (1/Q). ---
FILT_MAXSTAGES = 6;
filt_stages = 1; filt_res_k = 0;   // floor: never let the cascade be a wire                       // 6 x 2 poles = 72 dB/oct
FILT_RES_DB_MAX = 34;                     // total emphasis Resonance = 1 asks for
                                          // (34, not 24: the retired core hit ~+29 dB
                                          //  at Resonance 0.98 and migrated projects
                                          //  need to be representable)
svf_l  = 1300;
svf_r  = 1300 + 2*FILT_MAXSTAGES;
svf_qb = 1300 + 4*FILT_MAXSTAGES;     // 1/Q per section
memset(1300, 0, 5*FILT_MAXSTAGES);

// --- Drift and Ramp play/rest, added 2026-09-05. Placed ABOVE the filter state,
//     whose top is 1300 + 5*FILT_MAXSTAGES -- derived, not a literal, because
//     the stage count has changed before.
swf_db = 1300 + 5*FILT_MAXSTAGES;
drift_play_mem       = swf_db;        // CONFIG   periods; 0 = gate off
drift_rest_mem       = swf_db + 16;   // CONFIG
drift_pr_resting_mem = swf_db + 32;   // RUNTIME  1 = frozen
drift_pr_accum_mem   = swf_db + 48;   // RUNTIME  fractional period while frozen
sr_play_mem          = swf_db + 64;   // CONFIG
sr_rest_mem          = swf_db + 80;   // CONFIG
sr_pr_resting_mem    = swf_db + 96;   // RUNTIME
sr_pr_accum_mem      = swf_db + 112;  // RUNTIME
// first free slot: swf_db + 128

// Shared play/rest window counter, the same one Veil and the Phaser use.
// `tick` is how much of ONE window passes per sample, which lets each caller
// keep its own units: Drift passes 1/period_samples so its windows are drift
// periods; Ramp passes 1/(unit_seconds*srate) so its windows are minutes or
// beats. Off unless BOTH values are > 0.
function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

// CONFIG defaults, one-time only, guarded by the same flag the existing drift
// banks use so a transport re-run of @init cannot wipe the setup.
swf_pr_cfg_inited != 1 ? (
  i = 0;
  loop(N_TARGETS,
    drift_play_mem[i] = 0; drift_rest_mem[i] = 0;
    sr_play_mem[i]    = 0; sr_rest_mem[i]    = 0;
    i += 1;
  );
  swf_pr_cfg_inited = 1;
);
// RUNTIME, reset every @init.
i = 0;
loop(N_TARGETS,
  drift_pr_resting_mem[i] = 0; drift_pr_accum_mem[i] = 0;
  sr_pr_resting_mem[i]    = 0; sr_pr_accum_mem[i]    = 0;
  i += 1;
);

@slider
// True for the ONE @slider pass where Rate Mode really moved INTO the
// tempo-following mode. The named pickers below use it to apply their ratio on
// entry: the raw multiplier HIDES behind a picker, so a stale picker value left
// unapplied would name one speed on screen while the plugin ran another.
// rate_mode_inited gates it, so a half-restored instance can never see an edge.

freq_lo      = min(slider1, slider2);
freq_hi      = max(slider1, slider2);
rate_val     = slider5;
rate_mode    = slider6;
// RETIRED 2026-09-04 (R13-revised). Guard forced to 0 rather than deleted, so
// the reasoning stays beside the code it disabled. Rate Value says beats per
// cycle now, so there is no multiplier for a picker to translate -- and a picker
// that WRITES a value is the shape that stamped 0.5 over this very plugin's
// hand-set rate on every load in infantile.RPP.
// The LANDING BLOCK is gone (R13-revised step 4). It used to stamp the picker
// to "1 per beat" and Rate Value to 1 on entering Host x, because meeting a
// bare MULTIPLIER first was the trap. There is no trap now: 2 beats per cycle
// is a legible number, so nothing needs stamping and, crucially, the RATE
// SLIDER NEVER HIDES. Hiding it is what forced the stamp -- and this is the
// plugin where that cost a whole session, in infantile.RPP.
rate_mode_inited ? last_rate_mode = rate_mode;

dur_pct      = slider8;
depth_pct    = slider9 * 0.01;
att_pct      = slider10;
rel_pct      = slider12;
att_shape    = slider11;
rel_shape    = slider13;
resonance    = slider3;
phase_offset = slider14 / 360;
wet          = slider24;
dry          = 1 - wet;

slider7 != last_start_phase ? (
  phase_l = slider7 / 360.0;
  phase_l < 0 ? phase_l += 1;
  phase_r = phase_l;
  last_start_phase = slider7;
);

// ===== PAN BLOCK SLIDER READ START =====
pan_enabled     = slider16;
pan_mode        = slider17;
pan_spread      = slider18;
pan_glide_ms    = slider19;
pan_cycle_steps = slider20;
// The every-N alternations count in their own pattern length (2N). Cycle Steps
// says how many positions the Distributed / Converging / Diverging walks use
// and has nothing to say about a two-sided flip.
pan_cycle_mod = pan_mode == 13 ? 4 : pan_mode == 14 ? 8 : pan_mode == 15 ? 16 : pan_cycle_steps;
pan_sweep_val   = slider21;
pan_sweep_mode  = slider22;
// INVERTED 2026-09-05: the slider now says how many CYCLES one pan pass takes,
// so the ratio the phase accumulator wants is its reciprocal. Guarded on the
// denominator via max() only because the declared minimum is 0.001 and cannot
// reach zero -- inverting a unit inverts its edge cases, and the value someone
// leaves alone is 1, which comes through as 1.
pan_sweep_ratio = 1 / max(slider23, 0.001);

slider_show(slider17, pan_enabled);
slider_show(slider18, pan_enabled);
slider_show(slider19, pan_enabled);
slider_show(slider20, pan_enabled && pan_mode >= 1 && pan_mode <= 9);
slider_show(slider21, pan_enabled && (pan_mode == 10 || pan_mode == 11));
slider_show(slider22, pan_enabled && (pan_mode == 10 || pan_mode == 11));
// Linked Sweep pan-speed picker. Adopt-on-load so opening a project never
// overwrites a hand-set multiplier; writes only on a real change.
// The Linked Sweep pair is GONE, replaced by one number (2026-09-05, R13's
// shape applied to the last place it survived). It used to be a MULTIPLIER you
// could not hear without arithmetic, plus a named picker that WROTE into it to
// hide the arithmetic -- and a picker that writes a value is exactly the shape
// that stamped 0.5 over a hand-set rate on every load in infantile.RPP.
//
// Rozaya, 2026-09-04: "I don't actually know what that one does. It seems right,
// but I don't know what it does in practice." Then, on hearing what it was:
// "I've never used it and I've never liked it being the current way BECAUSE of
// that exact thing."
//
// `Pan sweep every (cycles)` says the sentence out loud: pan sweep every 4
// cycles. Bigger is slower, the same direction as Seconds and beats per cycle,
// and thirds are now reachable -- the old 0.125 grid could not express "every
// 3 cycles", which is why that entry was missing from the picker.
slider_show(slider23, pan_enabled && pan_mode == 12);
// ===== PAN BLOCK SLIDER READ END =====

// Start Delay: convert to seconds based on Rate Mode. BPM beats and
// Hz cycles are interpreted against Rate Value; Seconds is literal.
start_delay_units = slider25;
// These branches were keyed as if Rate Mode were {BPM,Seconds,Hz} like Melody
// Phase / Polyrhythm. It is {Hz,Seconds,BPM} here, so mode 0 is Hz and mode 2
// is BPM -- Hz got the BPM formula and BPM the Hz one, putting Start Delay
// 60x out in both. Same bug as Full Feature Tremolo, copied with the code.
// (Mode 3 = Host x shares the Hz form: its nominal rate is also cycles per
// second, with the live tempo applied to the counter via host_scale.)
slider6 == 1 ? start_delay_sec = start_delay_units :
slider6 == 0 ? start_delay_sec = start_delay_units * 60 / max(slider5, 0.001) :
               start_delay_sec = start_delay_units / max(slider5, 0.001);   // 2 Hz, 3 Host x

// Play/Rest gate: integer cycle counts. Both must be > 0 for the
// gate to engage; 0 in either slider disables.
play_for_cycles = slider26;
rest_for_cycles = slider27;
new_pr_enabled  = (play_for_cycles > 0 && rest_for_cycles > 0);
!new_pr_enabled && pr_resting ? (
  pr_resting = 0;
  pr_cycle_progress = 0;
);
pr_enabled       = new_pr_enabled;
rest_lfo_mode    = slider28;
rest_output_mode = slider29;

// Speed ramp engage-edge.
// No engage-edge detection. Engage is a freeze/resume gate handled
// in @sample. Only transport play resets ramp_t.

// Drift target selector save/restore (nested-selector pattern).
// Switching slider30 saves sliders 35-38 into the OLD target's slot,
// then loads the NEW target's stored config into sliders 35-38.
// Otherwise captures live edits to the current target's slot. All 6
// targets drift in parallel from @sample regardless of selection.
sel_target = slider30;
sel_up     = slider31;
sel_down   = slider32;
sel_per    = slider33;
sel_shape  = slider35;
sel_dplay  = slider36;
sel_drest  = slider37;

last_target_select != sel_target ? (
  target_drift_up[last_target_select]    = sel_up;
  target_drift_down[last_target_select]  = sel_down;
  target_drift_per[last_target_select]   = sel_per;
  target_drift_shape[last_target_select] = sel_shape;
  drift_play_mem[last_target_select]     = sel_dplay;
  drift_rest_mem[last_target_select]     = sel_drest;

  slider31 = target_drift_up[sel_target];
  slider32 = target_drift_down[sel_target];
  slider33 = target_drift_per[sel_target];
  slider35 = target_drift_shape[sel_target];
  slider36 = drift_play_mem[sel_target];
  slider37 = drift_rest_mem[sel_target];
  slider_automate(slider36);
  slider_automate(slider37);
  slider_automate(slider31);
  slider_automate(slider32);
  slider_automate(slider33);
  slider_automate(slider35);

  last_target_select = sel_target;
) : (
  target_drift_up[sel_target]    = sel_up;
  target_drift_down[sel_target]  = sel_down;
  target_drift_per[sel_target]   = sel_per;
  target_drift_shape[sel_target] = sel_shape;
  drift_play_mem[sel_target]     = sel_dplay;
  drift_rest_mem[sel_target]     = sel_drest;
);

// Speed ramp target selector save/restore (nested-selector, mirrors the drift
// block above). slider38 = target; slider39 = per-target `by`; slider41 =
// per-target duration; slider45 = per-target start delay (all three per-target
// as of v2.14). slider44 (engage) stays GLOBAL. Switching slider38 saves the
// three per-target sliders into the OLD target's slots, then loads the NEW
// target's stored values. Otherwise captures live edits. All targets ramp in
// parallel from @sample, each on its own duration/delay clock.
sr_sel_target = slider38;
sr_sel_by     = slider39;
sr_sel_dur    = slider41;
sr_sel_delay  = slider45;
sr_sel_play   = slider42;
sr_sel_rest   = slider43;

last_sr_target != sr_sel_target ? (
  speed_ramp_by_mem[last_sr_target]    = sr_sel_by;
  speed_ramp_dur_mem[last_sr_target]   = sr_sel_dur;
  speed_ramp_delay_mem[last_sr_target] = sr_sel_delay;
  sr_play_mem[last_sr_target]          = sr_sel_play;
  sr_rest_mem[last_sr_target]          = sr_sel_rest;
  slider39 = speed_ramp_by_mem[sr_sel_target];
  slider41 = speed_ramp_dur_mem[sr_sel_target];
  slider45 = speed_ramp_delay_mem[sr_sel_target];
  slider42 = sr_play_mem[sr_sel_target];
  slider43 = sr_rest_mem[sr_sel_target];
  slider_automate(slider42);
  slider_automate(slider43);
  slider_automate(slider39);
  slider_automate(slider41);
  slider_automate(slider45);
  last_sr_target = sr_sel_target;
) : (
  speed_ramp_by_mem[sr_sel_target]    = sr_sel_by;
  speed_ramp_dur_mem[sr_sel_target]   = sr_sel_dur;
  speed_ramp_delay_mem[sr_sel_target] = sr_sel_delay;
  sr_play_mem[sr_sel_target]          = sr_sel_play;
  sr_rest_mem[sr_sel_target]          = sr_sel_rest;
);




@block
// --- Restore-order guard for the change-detecting controls below -----------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the picker then fires and slider_automate()s
//     its ratio over a rate that was set by hand. @block cannot run before the
//     instance is configured, so adopting here is right whatever order the
//     restore paths ran in. (Proved 2026-08-23: a Sweeping Filter in BPM mode
//     with Host ratio "every 2 beats" had Rate Value stamped to 0.5 on every
//     load and every track duplicate.)
!rate_mode_inited ? ( last_rate_mode = slider6; rate_mode_inited = 1; );
// --- Per-section Butterworth Q for the selected slope. In @block, NOT in
//     @slider: the audio path reads filt_stages as a loop count, and a loop
//     count of 0 is not a quiet filter, it is a STRAIGHT WIRE. On a pasted
//     or duplicated instance @slider has not necessarily run before the
//     first block, so the cascade ran zero sections and passed the input
//     through untouched -- which sounds exactly like 'the LFO does nothing',
//     because the LFO was fine and had nothing to drive. @block runs every
//     block regardless, so by the first sample this is always set.
//     (The Resonance multiplier varies per sample and is applied in @sample.)
filt_stages = min(FILT_MAXSTAGES, slider4 + 1);
filt_order  = 2 * filt_stages;
filt_i = 0;
loop(filt_stages,
  // 1/Q directly, from the pole angle. Butterworth, 1930 -- textbook, no table.
  svf_qb[filt_i] = 2 * cos($pi * (2*filt_i + 1) / (2*filt_order));
  filt_i += 1;
);
// Resonance spread across the sections: the peak is the SUM of their dB.
filt_res_k = FILT_RES_DB_MAX / filt_stages * (log(10) / 20);
// Follow the project tempo while Host x is active. ABSOLUTE (tempo / 60), not
// a ratio against a remembered reference -- @init re-runs on play and wipes
// globals, so a reference would reset and silently discard the change.
host_bpm = max(tempo, 0.001);
// R21: >= 3 covers BOTH host modes -- Every N beats (3) and N per beat (4).
// Both are computed against a NOMINAL 60 BPM and then scaled by the live tempo
// here, which is what keeps them tempo-independent upstream (@init re-runs on
// play and would wipe a remembered tempo).
host_scale = rate_mode >= 3 ? host_bpm / 60 : 1;

// Transport POSITION, for phase-locking the sweep in Host x. Tempo sync sets
// the sweep's speed; this sets where in the cycle it is, so the filter lands
// the same way at the same bar however you got there. Deriving phase from the
// position also means it can't drift over a long session, and it survives
// seeking and looping. Only while the transport is actually moving
// (1 = playing, 5 = recording); stopped or paused, beat_position doesn't
// advance and locking to it would freeze the sweep for live monitoring.
host_beat_pos   = beat_position;
host_pos_locked = (play_state == 1 || play_state == 5);
blk_sample      = 0;

@sample

// (No transport-edge reset here — Path A. REAPER re-runs @init on every
// transport play / render start, which resets all runtime state — LFO
// phases (honoring Start Phase slider7), filter state + cutoff smoothers,
// pan state, rate smoother (re-seeded from slider5), drift runtime, Speed
// Ramp, Start Delay, Play/Rest + effect mix; the drift CONFIG bank is
// preserved across those re-runs by the drift_cfg_inited guard in @init.
// See docs/v2.9-render-state-bug.md.)

start_delay_elapsed < start_delay_sec ? (
  // * host_scale: start_delay_sec derives from the NOMINAL rate, so a
  // wall-clock counter would be off by exactly the tempo ratio while every
  // other timing was right -- the partial failure Melody Phase shipped.
  start_delay_elapsed += host_scale / srate;
  // No-op — spl0 and spl1 pass through unchanged.
) : (

freq_lo      = min(slider1, slider2);
freq_hi      = max(slider1, slider2);
rate_val     = slider5;
rate_mode    = slider6;
dur_pct      = slider8;
depth_pct    = slider9 * 0.01;
att_pct      = slider10;
rel_pct      = slider12;
att_shape    = slider11;
rel_shape    = slider13;
resonance    = slider3;
phase_offset = slider14 / 360;
wet          = slider24;
dry          = 1 - wet;

// ===== PAN BLOCK SAMPLE READ START =====
pan_enabled     = slider16;
pan_mode        = slider17;
pan_spread      = slider18;
pan_glide_ms    = slider19;
pan_cycle_steps = slider20;
// The every-N alternations count in their own pattern length (2N). Cycle Steps
// says how many positions the Distributed / Converging / Diverging walks use
// and has nothing to say about a two-sided flip.
pan_cycle_mod = pan_mode == 13 ? 4 : pan_mode == 14 ? 8 : pan_mode == 15 ? 16 : pan_cycle_steps;
pan_sweep_val   = slider21;
pan_sweep_mode  = slider22;
// INVERTED 2026-09-05: the slider now says how many CYCLES one pan pass takes,
// so the ratio the phase accumulator wants is its reciprocal. Guarded on the
// denominator via max() only because the declared minimum is 0.001 and cannot
// reach zero -- inverting a unit inverts its edge cases, and the value someone
// leaves alone is 1, which comes through as 1.
pan_sweep_ratio = 1 / max(slider23, 0.001);
// ===== PAN BLOCK SAMPLE READ END =====

// Host x (3) is a NOMINAL cycles-per-second (as if the project were at 60
// BPM); the live tempo arrives separately as host_scale, so nothing here has
// to remember a tempo and go stale when @init re-runs on transport play.
rate_mode == 0 ? (freq_raw = rate_val / 60) :
rate_mode == 1 ? (freq_raw = 1 / max(rate_val, 0.001)) :
// Host x: BEATS PER CYCLE (R13-revised). Guarded on the NUMERATOR -- inverting
// a unit inverts its edge cases, and 1/max(v,0.001) clamps the denominator,
// turning a stopped sweep into a 1000 Hz one.
// R21 (fixed 2026-09-06). THIS CHAIN IS THE BUG `N per beat` HAD HERE.
// It used to end `rate_mode == 2 ? (Hz) : (1/rate_val)`, so mode 4 fell into the
// LAST branch -- the `Every N beats` one -- and ran at the RECIPROCAL of what it
// said. `N per beat` = 8 gave one cycle every eight beats instead of eight per
// beat, which is precisely the arithmetic R21 exists to abolish, done backwards.
//
// The correct shape, and it is the one both Polyrhythms already had: name mode 3
// EXPLICITLY and let mode 4 fall through to the Hz branch. `N per beat` IS Hz
// against a nominal 60 BPM -- that is the whole trick -- and host_scale
// (rate_mode >= 3) supplies the live tempo afterwards.
rate_mode == 3 ? (freq_raw = rate_val > 0.001 ? 1 / rate_val : 0.001) :
                 (freq_raw = max(rate_val, 0.001));   // 2 Hz and 4 N per beat

// Smooth the rate slider, advance the speed ramp, apply per-plugin
// drift, then derive the effective freq used downstream by the LFO
// phase advance and the cycle counter.
freq_smoothed += (freq_raw - freq_smoothed) * rate_smoother_coeff;

// Advance each target's own ramp clock (v2.14 per-target timeline). Engage
// (slider44, GLOBAL) is the freeze/resume gate: while On, each target whose
// duration > 0 advances its own ramp_t 0->1 over its own duration, after its
// own start delay; while Off, all clocks freeze and resume. Only transport
// play (via @init) resets them.
slider44 ? (
  // Ramp time unit (slider40): one factor converts the block's time values into
  // seconds. A minute is 60 s; a beat is 60/tempo s, recomputed per sample so a
  // tempo change is followed live in Beats mode. This replaced a hardcoded 60.
  // Ramp time unit. One factor turns the Ramp block's time values into seconds.
  // Cycles counts THIS plugin's own cycles, referenced against the rate BEFORE
  // drift and ramp touch it, so a ramp cannot alter its own clock. Seconds is
  // wall clock. Minutes is 60 s and is the DEFAULT -- every saved instance has
  // this control unset, so the default is what they all run on, and moving it
  // would rewrite live ramps (2026-09-05). A beat is 60/tempo s, recomputed per
  // sample so Beats follows a live tempo change rather than remembering one.
  ramp_time_scale =
    slider40 == 3 ? 60 / max(host_bpm, 0.001) :
    slider40 == 2 ? 60 :
    slider40 == 1 ? 1 :
                    1 / max(freq_smoothed, 0.00001);
  i = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * ramp_time_scale * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        // Staircase (sliders 42/43). The ramp advances for `play`, holds for
        // `rest`, and repeats. The holds come OUT of the duration rather than
        // extending it -- the advancing step is scaled by (play+rest)/play --
        // so Ramp duration goes on meaning "you arrive in about this long".
        sr_pl = sr_play_mem[i];
        sr_rs = sr_rest_mem[i];
        sr_pr_on = sr_pl > 0 && sr_rs > 0;
        sr_hold = pr_frozen(sr_pr_accum_mem, sr_pr_resting_mem, i,
                            1.0 / (ramp_time_scale * srate), sr_pl, sr_rs);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !sr_hold ? (
          sr_step = 1.0 / (srate * speed_ramp_dur_mem[i] * ramp_time_scale);
          sr_pr_on ? sr_step *= (sr_pl + sr_rs) / sr_pl;
          speed_ramp_ramp_t_mem[i] += sr_step;
          speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
        );
      );
    );
    i += 1;
  );
);

// Each target's live ramp offset is speed_ramp_ramp_t_mem[t] *
// speed_ramp_by_mem[t], applied at that target's consumption site alongside
// the matching drift offset.
//
// Sweep Rate (target 0): effective rate value = rate_val + ramp offset (in
// the rate's current unit). Convert to Hz the same way freq_raw is computed
// above, then express as a multiplicative factor on freq_smoothed so the
// existing combined_scale-based audio path keeps working. No "snapshot at
// engage" — live edits adjust trajectory.
// Rate drift and Speed Ramp are in BPM in EVERY mode, Host x included --
// "BPM is BPM". In Host x the rate slider is a multiplier, so a BPM delta has
// to be converted before it can be added to it: D BPM is D/tempo in multiplier
// terms, and the PLUGIN does that division, never the user. (Equivalently it
// lands as D/60 Hz downstream, which is the same formula the BPM mode uses --
// keeping the two modes literally identical here.)
// Rejected alternative: a multiplier delta. It reads consistent and it fails
// in use, because reaching a musical destination then needs arithmetic
// (1 - 1/3 = 0.667 for "every three beats"), and a ramp deliberately leaves
// the grid anyway, so a fraction of a beat buys nothing.
//
// WHERE the amount is added changed with the unit, and it had to. While Host x's
// Rate Value WAS the nominal rate, adding a converted amount to the slider value
// and adding it to the Hz were the same operation. Beats per cycle INVERTS that,
// so adding to the raw value would move the wrong quantity in the wrong
// direction -- more beats per cycle is slower. The divisor is unchanged and was
// always right; only its destination was wrong. The same oversight shipped in
// both Polyrhythms and was fixed the same day this landed.
//
// The Drift block further down needs NO such change: it adds its amount to
// freq_base, which already has host_scale folded in, so D BPM is simply D/60 Hz
// there. Two different domains, both correct -- said out loud because the two
// divisors look inconsistent side by side and are not.
sr_rate_by = speed_ramp_ramp_t_mem[0] * speed_ramp_by_mem[0];
// `>= 3` because BOTH host modes hold a NOMINAL rate with the tempo applied
// separately, so a BPM amount converts the same way in both: D BPM is D/tempo in
// nominal terms. The free modes add the amount to the slider value directly.
rate_mode >= 3 ? (
  effective_rate_hz = max(freq_raw + sr_rate_by / max(host_bpm, 0.001), 0.0001);
) : (
  effective_rate_val = rate_val + sr_rate_by;
  rate_mode == 0 ? (effective_rate_hz = effective_rate_val / 60) :
  rate_mode == 1 ? (effective_rate_hz = 1 / max(effective_rate_val, 0.001)) :
                   (effective_rate_hz = effective_rate_val);   // 2 Hz
);
// host_scale folds the live project tempo in here rather than into a
// combined_scale (this plugin has none -- speed_scale_current is the shared
// factor, consumed by freq_base below and everything downstream of it).
// 1 outside Host x, so other modes are bit-identical.
speed_scale_current = effective_rate_hz / max(freq_raw, 0.001) * host_scale;

// Per-target drift wave computation. 6 targets (0=Sweep Rate, 1=Freq
// Low, 2=Freq High, 3=Pan Sweep Rate, 4=Resonance, 5=Wet/Dry). Each
// gets a phase counter advancing per sample. Period unit is filter
// LFO cycles for ALL targets, referenced against freq_base (the
// Speed-Ramp-adjusted sweep rate BEFORE drift) so Sweep Rate drift
// doesn't self-modulate its own period.
freq_base = freq_smoothed * speed_scale_current;
drift_ref_freq = max(freq_base, 0.00001);
i = 0;
loop(N_TARGETS,
  up    = target_drift_up[i];
  down  = target_drift_down[i];
  per   = target_drift_per[i];
  shape = target_drift_shape[i];

  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    // Drift period unit (slider34). Cycles is this plugin's native count -- a
    // period of 8 means eight sweeps, and it follows the rate for free. Beats
    // converts at the LIVE project tempo instead, so the wander follows the
    // host rather than the sweep.
    period_samples =
      slider34 == 2 ? max(per * 60 / max(host_bpm, 0.001) * srate, 1) :
      slider34 == 1 ? max(per * srate, 1) :
                      max(per * srate / drift_ref_freq, 1);

    // Drift play/rest (sliders 36/37), per target, counted in PERIODS. While
    // resting the phase does not advance at all, so shape_val below is
    // recomputed from the held phase and the offset simply STAYS where it
    // stopped -- freeze in place, not a return to centre. The FRACTION of the
    // play value chooses where it parks: x.25 crest, x.75 trough, x.0 and x.5
    // neutral -- so a whole number parks at no change every time and is nearly
    // inaudible, and an awkward fraction is the interesting one.
    d_frozen = pr_frozen(drift_pr_accum_mem, drift_pr_resting_mem, i,
                         1.0 / period_samples,
                         drift_play_mem[i], drift_rest_mem[i]);
    d_frozen ? (
      new_phase = target_drift_phase[i];
    ) : (
      new_phase = target_drift_phase[i] + 1.0 / period_samples;
      new_phase >= 1.0 ? (
        new_phase -= 1.0;
        shape == 2 ? (
          target_drift_prev[i] = target_drift_curr[i];
          target_drift_curr[i] = rand(2) - 1;
        );
      );
      target_drift_phase[i] = new_phase;
    );

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = target_drift_prev[i] +
        (target_drift_curr[i] - target_drift_prev[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  target_drift_offset[i] = drift_offset_local;
  i += 1;
);

// Sweep Rate drift (target 0): offset is in the rate's current unit;
// convert to a Hz delta on freq the same way the old drift did (in
// Seconds mode it's a period delta). Clamp so a heavy Down-by can't
// freeze the LFO.
rate_drift_user = target_drift_offset[0];
rate_drift_hz   = 0;
rate_drift_user != 0 ? (
  // Keyed by NAME, not index: 0 Hz, 1 Seconds, 2 BPM, 3 Host x. This chain
  // used to end in a bare else, which swallowed Host x into the BPM branch
  // and made Sweep Rate drift 60x too small — i.e. inaudible. In Host x the
  // offset is a multiplier delta, so it converts like Hz and then takes
  // host_scale, because it is added to freq_base AFTER speed_scale_current.
  rate_mode == 0 ? (rate_drift_hz = rate_drift_user / 60) :
  rate_mode == 1 ? (
    cur_period    = 1 / drift_ref_freq;
    new_period    = max(cur_period + rate_drift_user, 0.0001);
    rate_drift_hz = (1 / new_period) - freq_base;
  ) :
  // Host x takes the SAME formula as BPM: the amount is BPM in both.
  rate_mode == 2 ? (rate_drift_hz = rate_drift_user) :
                   (rate_drift_hz = rate_drift_user / 60);   // 3 Host x
);
freq = max(freq_base + rate_drift_hz, 0.001);

// Frequency Low / High drift + Speed Ramp (targets 1, 2): wander the band
// edges in Hz, clamped to [20, 20000]. If it pushes lo past hi, min/max keeps
// the band coherent (just inverts which edge leads).
eff_freq_lo = max(20, min(20000, freq_lo + target_drift_offset[1] + speed_ramp_ramp_t_mem[1] * speed_ramp_by_mem[1]));
eff_freq_hi = max(20, min(20000, freq_hi + target_drift_offset[2] + speed_ramp_ramp_t_mem[2] * speed_ramp_by_mem[2]));
band_lo = min(eff_freq_lo, eff_freq_hi);
band_hi = max(eff_freq_lo, eff_freq_hi);

// Resonance drift + Speed Ramp (target 4): clamp to [0, 1] (slider range).
eff_resonance = max(0, min(1, resonance + target_drift_offset[4] + speed_ramp_ramp_t_mem[4] * speed_ramp_by_mem[4]));

// Wet/Dry drift + Speed Ramp (target 5): clamp to [0, 1], re-derive dry.
eff_wet = max(0, min(1, wet + target_drift_offset[5] + speed_ramp_ramp_t_mem[5] * speed_ramp_by_mem[5]));
eff_dry = 1 - eff_wet;

// Pan Sweep Rate drift + Speed Ramp (target 3): fold into the pan sweep value
// used by pan modes 10/11 below (in the Pan Sweep Rate's own unit).
eff_pan_sweep_val = max(0.001, pan_sweep_val + target_drift_offset[3] + speed_ramp_ramp_t_mem[3] * speed_ramp_by_mem[3]);

period   = 1 / max(freq, 0.00001);
on_secs  = (dur_pct / 100.0) * period;
att_secs = (att_pct / 100.0) * period;
rel_secs = (rel_pct / 100.0) * period;

// Smoother coefficient — moved up from the cut_smooth section so
// effect_mix can reuse it for the rest-boundary fade.
smooth = exp(-1 / (srate * 0.003));

// Play/Rest gate state machine. pr_cycle_progress accumulates
// fractional cycles at the LFO rate; when it crosses the
// threshold for the current state, pr_resting flips and the
// counter resets.
pr_enabled ? (
  pr_cycle_progress += freq / srate;
  !pr_resting ? (
    pr_cycle_progress >= play_for_cycles ? (
      pr_resting = 1;
      pr_cycle_progress = 0;
    );
  ) : (
    pr_cycle_progress >= rest_for_cycles ? (
      pr_resting = 0;
      pr_cycle_progress = 0;
    );
  );
);

// in_frozen_rest gates LFO phase advancement (filter sweep LFO and
// pan_phase) so Freeze pauses the modulation during rest. Walk
// leaves it false. Independent of Rest output, so all four
// LFO×output combinations work.
in_frozen_rest = pr_enabled && pr_resting && rest_lfo_mode == 1;

// effect_mix smoothly transitions between 1 (effect fully on) and
// 0 (rest target) at rest boundaries. The rest target depends on
// Rest output: dry_l/r (pass-through) for Pass-through, 0 (full
// silence) for Silence. Below, the play-mode wet/dry mix output
// and the rest target are interpolated by effect_mix to produce
// the final spl0/spl1 — soft fade between effect-on and the rest
// state, regardless of which rest target was chosen.
target_effect_mix = pr_enabled && pr_resting ? 0 : 1;
effect_mix        = effect_mix * smooth + target_effect_mix * (1 - smooth);
silence_mode      = (rest_output_mode == 1);

// Where this sample sits in the project, in beats -- @block gives the position
// at the start of the block, so step forward by however far in we are.
sample_beat_pos = host_beat_pos + blk_sample * host_bpm / (60 * srate);
blk_sample += 1;

// Lock the phase to the project only while NOTHING is moving the rate. The
// position formula answers "where would the sweep be if it had run at this
// rate all along", which is only the right question when that's true. As soon
// as Drift or Speed Ramp touches the rate you've asked for something off the
// grid, so it hands over to the free-running accumulator from wherever it is
// -- no jump on the handover, and it stays free until the next transport
// start rather than lurching back onto the grid mid-play.
// R21 (corrected 2026-09-06). `>= 3` is the WIDENED gate -- "am I following the
// project tempo" -- and it has to cover BOTH host modes. It said `== 3` until
// now, which is the one R21 gate left unwidened when `N per beat` was added: a
// sweep in `N per beat` followed the tempo but was NOT locked to the grid, so it
// free-ran while the identical setting in `Every N beats` was nailed to it. Two
// modes meant to be two ways of saying the same speed behaved differently.
// The Stereo Phaser had it right; this and Full Feature Tremolo did not.
rate_pos_lock = (rate_mode >= 3) && host_pos_locked
                && rate_drift_hz == 0
                && speed_ramp_ramp_t_mem[0] * speed_ramp_by_mem[0] == 0;

// Advance filter sweep LFO phases unless Freeze rest is pinning them.
!in_frozen_rest ? (
  rate_pos_lock ? (
    // ...and THIS one stays exact, because it is a conversion rather than a
    // sync test. In `Every N beats` (3) rate_val is beats per cycle, so cycles
    // elapsed is the beat position DIVIDED by it; in `N per beat` (4) it is
    // cycles per beat, so it is MULTIPLIED. The two are reciprocals, so using
    // one formula for both would lock the phase to a speed the plugin is not
    // running at -- silently, and only in host mode. Widening the gate above
    // without branching here would have been worse than leaving both alone.
    // Same shape as stereo-phaser.jsfx, which is the plugin that got this right.
    phase_l = rate_mode == 4 ? sample_beat_pos * max(rate_val, 0.001)
            : rate_val > 0.001 ? sample_beat_pos / rate_val : 0;
    phase_l -= floor(phase_l);
  ) : (
    phase_l += freq / srate;
    phase_l >= 1 ? phase_l -= 1;
  );

  slider15 == 0 ? (
    rate_pos_lock ? (
      phase_r = phase_l;
    ) : (
      phase_r += freq / srate;
      phase_r >= 1 ? phase_r -= 1;
    );
  ) : (
    phase_r = phase_l + phase_offset;
    phase_r >= 1 ? phase_r -= 1;
    phase_r < 0  ? phase_r += 1;
  );
);

lfo_l = calc_lfo(phase_l, on_secs, att_secs, rel_secs, period, att_shape, rel_shape);
lfo_r = calc_lfo(phase_r, on_secs, att_secs, rel_secs, period, att_shape, rel_shape);

fcenter = (band_lo + band_hi) * 0.5;
fsize   = (band_hi - band_lo) * 0.5 * depth_pct;

target_freq_l = fcenter + (lfo_l * 2 - 1) * fsize;
target_freq_r = fcenter + (lfo_r * 2 - 1) * fsize;

// Smooth the CUTOFF IN HZ now, not a raw coefficient. The old code smoothed
// `freq * 2/srate`, which is what made "Hz" a coefficient wearing a Hz label.
cut_target_l = target_freq_l;
cut_target_r = target_freq_r;

cut_smooth_l = cut_smooth_l * smooth + cut_target_l * (1 - smooth);
cut_smooth_r = cut_smooth_r * smooth + cut_target_r * (1 - smooth);

dry_l = spl0;
dry_r = spl1;

filt_g = tan($pi * min(cut_smooth_l, srate*0.49) / srate);
filt_qm_l = exp(-filt_res_k * eff_resonance);
filt_in = spl0;
filt_i = 0;
loop(filt_stages,
  filt_x = filt_i * 2;
  filt_k = svf_qb[filt_i] * filt_qm_l;
  filt_a1 = 1 / (1 + filt_g*(filt_g + filt_k));
  filt_a2 = filt_g * filt_a1;
  filt_a3 = filt_g * filt_a2;
  filt_v3 = filt_in - svf_l[filt_x + 1];
  filt_v1 = filt_a1*svf_l[filt_x] + filt_a2*filt_v3;
  filt_v2 = svf_l[filt_x + 1] + filt_a2*svf_l[filt_x] + filt_a3*filt_v3;
  svf_l[filt_x]     = 2*filt_v1 - svf_l[filt_x];
  svf_l[filt_x + 1] = 2*filt_v2 - svf_l[filt_x + 1];
  filt_in = filt_v2;                  // v2 is the lowpass output
  filt_i += 1;
);
out_l = filt_in;
filt_g = tan($pi * min(cut_smooth_r, srate*0.49) / srate);
filt_qm_r = exp(-filt_res_k * eff_resonance);
filt_in = spl1;
filt_i = 0;
loop(filt_stages,
  filt_x = filt_i * 2;
  filt_k = svf_qb[filt_i] * filt_qm_r;
  filt_a1 = 1 / (1 + filt_g*(filt_g + filt_k));
  filt_a2 = filt_g * filt_a1;
  filt_a3 = filt_g * filt_a2;
  filt_v3 = filt_in - svf_r[filt_x + 1];
  filt_v1 = filt_a1*svf_r[filt_x] + filt_a2*filt_v3;
  filt_v2 = svf_r[filt_x + 1] + filt_a2*svf_r[filt_x] + filt_a3*filt_v3;
  svf_r[filt_x]     = 2*filt_v1 - svf_r[filt_x];
  svf_r[filt_x + 1] = 2*filt_v2 - svf_r[filt_x + 1];
  filt_in = filt_v2;                  // v2 is the lowpass output
  filt_i += 1;
);
out_r = filt_in;

// Compute the play-mode output (normal wet/dry mix), then blend
// with the rest target via effect_mix. Rest target depends on
// Rest mode: dry_l/r (pass-through) for Walk and Freeze, 0 for
// Silence. The cut_smooth and cascade state keep
// running through the filter math even during rest, so the filter
// is "warm" and re-engages cleanly when the gate exits rest.
play_spl0 = eff_dry * dry_l + eff_wet * out_l;
play_spl1 = eff_dry * dry_r + eff_wet * out_r;
rest_spl0 = silence_mode ? 0 : dry_l;
rest_spl1 = silence_mode ? 0 : dry_r;
spl0 = effect_mix * play_spl0 + (1 - effect_mix) * rest_spl0;
spl1 = effect_mix * play_spl1 + (1 - effect_mix) * rest_spl1;

// ===== PAN BLOCK SAMPLE LOGIC START =====
pan_enabled ? (
  // Per-cycle pan modes (0-9) advance pan_cycle_index on filter LFO
  // phase wraps. Since the filter LFO advancement above is gated by
  // !in_frozen_rest, cycle_fired never triggers during Freeze rest
  // — pan_cycle_index naturally pauses without needing its own gate.
  cycle_fired  = (phase_l < last_phase_l);
  last_phase_l = phase_l;

  // 13-15 are the every-N alternations, appended after the sweeps because enum
  // options can only ever be added at the end. They are per-cycle modes, so
  // they belong in this branch despite sitting above the sweep indices.
  (pan_mode <= 9 || pan_mode >= 13) ? (
    cycle_fired ? (
      pan_mode == 5 || pan_mode == 7 || pan_mode == 9 ? (
        pan_cycle_index += pan_cycle_dir;
        (pan_cycle_index >= pan_cycle_steps - 1 || pan_cycle_index <= 0) ?
          pan_cycle_dir = -pan_cycle_dir;
      ) : (
        pan_cycle_index = (pan_cycle_index + 1) % pan_cycle_mod;
      );
    );
    cur_pan = percycle_pan(pan_cycle_index, pan_cycle_steps);
    pan_l = cur_pan;

  ) : pan_mode == 10 ? (
    // Pan Sweep — gate phase advance for Freeze mode. eff_pan_sweep_val
    // carries the Pan Sweep Rate drift offset (target 3).
    // R20 canonical order {BPM, Seconds, Hz, Host x}. BPM and Hz swapped places
    // when the list was put right on 2026-09-05, and Host x is new: there the
    // value is EVERY N BEATS, so (tempo/60)/N pan sweeps per second. Guarded on
    // the numerator -- inverting a unit inverts its edge cases.
    pan_sweep_mode == 0 ? (pan_freq = eff_pan_sweep_val / 60) :
    pan_sweep_mode == 1 ? (pan_freq = 1 / max(eff_pan_sweep_val, 0.001)) :
    // R21: mode 3 is Every N beats (divide), mode 4 is N per beat (multiply).
    pan_sweep_mode == 4 ? (pan_freq = max(host_bpm, 0.001) / 60 * max(eff_pan_sweep_val, 0.001)) :
    pan_sweep_mode == 2 ? (pan_freq = eff_pan_sweep_val) :
                          (pan_freq = eff_pan_sweep_val > 0.001
                                        ? max(host_bpm, 0.001) / 60 / eff_pan_sweep_val
                                        : 0.001);
    !in_frozen_rest ? (
      pan_phase += pan_freq / srate;
      pan_phase >= 1 ? pan_phase -= 1;
    );
    cur_pan = (pan_phase * 2.0 - 1.0) * pan_spread;
    pan_l = cur_pan;

  ) : pan_mode == 11 ? (
    // Pan Sweep Flipped — gate phase advance for Freeze mode.
    // R20 canonical order {BPM, Seconds, Hz, Host x}. BPM and Hz swapped places
    // when the list was put right on 2026-09-05, and Host x is new: there the
    // value is EVERY N BEATS, so (tempo/60)/N pan sweeps per second. Guarded on
    // the numerator -- inverting a unit inverts its edge cases.
    pan_sweep_mode == 0 ? (pan_freq = eff_pan_sweep_val / 60) :
    pan_sweep_mode == 1 ? (pan_freq = 1 / max(eff_pan_sweep_val, 0.001)) :
    // R21: mode 3 is Every N beats (divide), mode 4 is N per beat (multiply).
    pan_sweep_mode == 4 ? (pan_freq = max(host_bpm, 0.001) / 60 * max(eff_pan_sweep_val, 0.001)) :
    pan_sweep_mode == 2 ? (pan_freq = eff_pan_sweep_val) :
                          (pan_freq = eff_pan_sweep_val > 0.001
                                        ? max(host_bpm, 0.001) / 60 / eff_pan_sweep_val
                                        : 0.001);
    !in_frozen_rest ? (
      pan_phase += pan_freq / srate;
      pan_phase >= 1 ? pan_phase -= 1;
    );
    cur_pan = (1.0 - pan_phase * 2.0) * pan_spread;
    pan_l = cur_pan;

  ) : (
    // Linked Sweep — gate phase advance for Freeze mode.
    !in_frozen_rest ? (
      pan_phase += (freq * pan_sweep_ratio) / srate;
      pan_phase >= 1 ? pan_phase -= 1;
    );
    cur_pan = (pan_phase * 2.0 - 1.0) * pan_spread;
    pan_l = cur_pan;
  );

  // Glide smoothing — runs always; with phases frozen pan_l stays
  // constant so the smoother converges to it.
  pan_glide_coeff = pan_glide_ms > 0 ? exp(-1 / (srate * pan_glide_ms * 0.001)) : 0;
  pan_l_smooth = pan_l_smooth * pan_glide_coeff + pan_l * (1 - pan_glide_coeff);

  // Apply the pan, then blend with the un-panned signal via
  // effect_mix. During rest, effect_mix → 0 means the output is the
  // un-panned (already dry, since wet was scaled to 0 above) signal.
  pan_pos = (pan_l_smooth + 1.0) * 0.5;
  mono = (spl0 + spl1) * 0.5;
  spl0_panned = mono * cos(pan_pos * $pi * 0.5);
  spl1_panned = mono * sin(pan_pos * $pi * 0.5);
  spl0 = spl0 * (1 - effect_mix) + spl0_panned * effect_mix;
  spl1 = spl1 * (1 - effect_mix) + spl1_panned * effect_mix;
);
// ===== PAN BLOCK SAMPLE LOGIC END =====

);  // close start-delay else branch

@serialize
// Persist per-target drift AND speed-ramp configurations. Without this,
// only the most-recently-edited target's values survive a save/load because
// the sliders hold whichever target was selected at save time.
//
// VERSION-GUARDED (CLAUDE.md @serialize gotcha): leads with a magic marker so
// format changes degrade to defaults instead of scrambling. Magic bumped to
// 2100000 + N_TARGETS in v2.14 when Speed Ramp went PER-TARGET timeline (added
// the duration + start-delay banks); an older 2000000-base blob won't match
// and falls through to @init defaults (drift + ramp reset — acceptable, this
// is pre-release). Marker is well above any plausible first-field value and
// float32-exact (< 2^24).
// BUMPED to 2200000 on 2026-09-05: the blob now also carries drift play/rest
// and ramp play/rest. A 2100000 blob is still READ -- it has every field it ever
// had, and the four new banks simply stay at their @init defaults, which is both
// gates off, i.e. exactly how this plugin behaved before today. Gated on the
// blob HAVING the field, never on "the blob is old".
sr_magic_v1 = 2100000 + N_TARGETS;
sr_magic = 2200000 + N_TARGETS;
file_var(0, sr_magic);
swf_is_v1 = sr_magic == sr_magic_v1;
swf_is_v2 = sr_magic == 2200000 + N_TARGETS;
(swf_is_v1 || swf_is_v2) ? (
  file_mem(0, target_drift_up,     N_TARGETS);
  file_mem(0, target_drift_down,   N_TARGETS);
  file_mem(0, target_drift_per,    N_TARGETS);
  file_mem(0, target_drift_shape,  N_TARGETS);
  file_var(0, last_target_select);
  file_mem(0, speed_ramp_by_mem,    N_TARGETS);
  file_mem(0, speed_ramp_dur_mem,   N_TARGETS);
  file_mem(0, speed_ramp_delay_mem, N_TARGETS);

  // v2 additions. On WRITE swf_is_v2 is always true, so these are always saved.
  swf_is_v2 ? (
    file_mem(0, drift_play_mem, N_TARGETS);
    file_mem(0, drift_rest_mem, N_TARGETS);
    file_mem(0, sr_play_mem,    N_TARGETS);
    file_mem(0, sr_rest_mem,    N_TARGETS);
  );
  file_var(0, last_sr_target);

  // TRACK-DUPLICATE FIX (v2.14). On READ (load/duplicate) file_avail(0) >= 0;
  // on WRITE (save/undo) it is < 0. @serialize is the only section guaranteed
  // to run on both load AND duplicate, so it re-establishes the bank<->slider
  // invariant here: force the visible config sliders to match the restored
  // bank for the restored selectors, correcting any transient @slider clobber
  // (which would otherwise zero whichever target was selected on the copy).
  file_avail(0) >= 0 ? (
    slider39 = speed_ramp_by_mem[last_sr_target];        // Speed ramp `by`
    slider41 = speed_ramp_dur_mem[last_sr_target];       // Speed ramp duration
    slider45 = speed_ramp_delay_mem[last_sr_target];     // Speed ramp start delay
    slider31 = target_drift_up[last_target_select];      // Drift up
    slider32 = target_drift_down[last_target_select];    // Drift down
    slider33 = target_drift_per[last_target_select];     // Drift period
    slider35 = target_drift_shape[last_target_select];
    slider36 = drift_play_mem[last_target_select];
    slider37 = drift_rest_mem[last_target_select];
    slider42 = sr_play_mem[last_sr_target];
    slider43 = sr_rest_mem[last_sr_target];   // Drift shape
    sliderchange(-1);
  );
);
