desc: Tremolo with Shaped Envelope, Stereo Phase, and Pan Modulation
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/

slider1:2<0.001,1000,0.001>Rate Value
slider2:0<0,3,1{Hz,Seconds,BPM,Host x}>Rate Mode
slider3:50<0,100,0.1>On Duration % of Cycle
slider4:-6<-60,0,0.1>Depth dB
slider5:0<0,100,0.1>Attack %
slider6:0<0,100,0.1>Release %
slider7:1<0,3,1{Linear,Cosine,Logarithmic,Exponential}>Attack Shape
slider8:1<0,3,1{Linear,Cosine,Logarithmic,Exponential}>Release Shape
slider9:0<-180,180,0.1>Stereo Phase Offset degrees
slider10:0<0,1,1{Independent L+R,Offset from L}>Phase Mode
// ===== PAN BLOCK SLIDERS START =====
slider11:0<0,1,1{Off,On}>Pan Enabled
slider12:0<0,11,1{Mono,Alternating,Distributed,Distributed (Flipped),Distributed (Ping-pong),Converging,Converging (Ping-pong),Diverging,Diverging (Ping-pong),Pan Sweep,Pan Sweep (Flipped),Linked Sweep}>Pan Mode
slider13:1<0,1,0.01>Pan Spread (0=mono, 1=full)
slider14:5<0,100,0.1>Pan Glide ms (0=instant)
slider15:8<2,32,1>Cycle Steps (per-cycle modes)
slider16:2<0.001,1000,0.001>Pan Sweep Rate
slider17:0<0,2,1{Hz,Seconds,BPM}>Pan Sweep Rate Unit
slider18:1<0.125,8,0.125>Filter Speed Multiplier (Linked Sweep)
// ===== PAN BLOCK SLIDERS END =====

// Pass-through for N units after playback starts, then apply the
// tremolo + pan effect normally. Units match Rate Mode (BPM beats /
// Seconds / Hz cycles), interpreted against Rate Value. As an EFFECT
// plugin (not a generator) the dry signal passes through during the
// delay rather than being silenced — silence-during-delay would mute
// the dry track too, which is rarely what you want. Re-arms on every
// transport stop/start. 0 disables the delay.
slider19:0<0,1000,0.001>Start Delay (in Rate Mode units)

// Per-cycle Play/Rest gate. Effect is applied normally for N cycles
// of the Rate Value, then bypassed (dry signal passes through
// unchanged) for M cycles, then resumes — repeats forever. Cycle
// unit matches Start Delay (Rate Mode units against Rate Value).
// As with Start Delay, "rest" here means dry pass-through, NOT
// silence — silencing the input would mute the upstream track.
// The transition between effect-on and dry uses a ~3 ms fade so
// the gate is click-free. 0 in either slider disables the gate.
// Resets on every transport stop/start.
slider20:0<0,1000,1>Play for (cycles)
slider21:0<0,1000,1>Rest for (cycles)

// What the LFOs do during the rest period.
//   Walk through (default) — tremolo + pan LFOs keep cycling
//     during rest. When the effect resumes, the LFOs are at new
//     phase positions reflecting wall-clock time passed. The
//     rhythmic cycle keeps running silently.
//   Freeze in place — LFO phases pause, frozen at their values at
//     rest entry. When the effect resumes, the LFOs pick up from
//     the same phase. The rhythmic cycle pauses and resumes in
//     lockstep with the gate.
slider22:0<0,1,1{Walk through,Freeze in place}>LFO at rest

// What the output does during the rest period.
//   Pass-through (default) — dry signal passes through unchanged.
//     Effect plugins normally don't silence their input (silencing
//     would mute the upstream track in the FX chain), so this
//     matches Start Delay's pass-through-during-delay behavior.
//   Silence — gain target smooths to 0; the audio drops out during
//     rest instead of passing dry. Useful when you want the gate
//     to act like a hard mute rather than an effect bypass — e.g.,
//     for rhythmic drop-outs in an arrangement. Combines cleanly
//     with either Rest LFO setting.
slider23:0<0,1,1{Pass-through,Silence}>Output at rest

// Speed ramp: signed-delta, nested-selector (brought to Drift parity in
// the automation-replacement sweep, see docs/planned-features.md). Ships in
// v2.14. Pick a target (slider24), then slider25 is the `by` amount for THAT
// target; all 6 targets ramp in parallel and the selector only chooses which
// one slider25 is editing. Same 6 targets as Drift (Rate Value, Depth dB,
// Pan Sweep Rate, On Duration %, Attack %, Release %). Engage (slider27) is a
// freeze/resume gate (NOT a restart edge); only transport play resets ramp_t.
// A ~100 ms smoother sits between the Rate slider and freq so manual Rate
// tweaks don't click.
//
// Units per target match Drift. For the rate-type targets (Rate Value, Pan
// Sweep Rate) mode-direction is handled the same way drift does it — in
// BPM/Hz modes negative `by` = slower, in Seconds mode positive `by` = slower
// (longer period). Depth is dB, the three % targets are percentage points.
//
// The Speed ramp target selector is slider24 (top of this block) so that in
// the UI / NVDA parameter order it reads ABOVE the by/duration/engage
// controls it governs. Achieving that meant renumbering the Speed Ramp +
// Drift blocks (REAPER orders sliders by ID, not file position): Speed Ramp
// is now 24-28, Drift is 29-33. Existing Tremolo projects reset their Speed
// Ramp + Drift configs on upgrade (both off-by-default; the tremolo sound on
// sliders 1-23 is untouched). Re-add the instance for clean defaults, or
// reconfigure. See the manual's migration note.
slider24:0<0,5,1{Rate Value,Depth dB,Pan Sweep Rate,On Duration %,Attack %,Release %}>Speed ramp target
slider25:0<-1000,1000,0.001>Speed ramp by (units match target)
slider26:0<0,60,0.1>Speed ramp duration (minutes)
slider27:0<0,1,1{Off,On}>Speed ramp engage
slider28:0<0,60,0.1>Speed ramp start delay (minutes)

// Per-target drift: nested-selector pattern matching Womb v3 / the rest of
// the sweep. Pick a target (slider29), then sliders 30-33 hold THAT target's
// drift config. Switching the selector saves current values to the old
// target's memory slot and loads the new target's values into the sliders.
// All 6 targets drift in parallel; the selector just chooses which one you're
// currently editing.
//
// Targets:
//   Rate Value      — wanders the tremolo rate.
//   Depth dB        — wanders the modulation depth.
//   Pan Sweep Rate  — wanders the Pan Sweep Rate (pan modes 9/10 only).
//   On Duration %   — wanders the on-portion of each cycle.
//   Attack %        — wanders the attack ramp length.
//   Release %       — wanders the release ramp length.
//
// Period unit is tremolo cycles for ALL targets, scaled by Speed Ramp (so the
// wave-per-cycle relationship stays constant under wind-down). For slow
// wall-clock-feel drift, set a long period.
//
// Up/Down amount is in the target's natural unit: the rate's current unit
// (BPM / Seconds / Hz) for Rate Value, dB for Depth, the Pan Sweep Rate's
// unit for Pan Sweep Rate, percent for the three % targets. The 0-100 range
// covers all of them; rate/pan-rate targets in Hz mode use the low end.
// (Drift IDs shifted +1 from the old 28-32 layout in the v2.14 reorg above —
// same reset story.)
slider29:0<0,5,1{Rate Value,Depth dB,Pan Sweep Rate,On Duration %,Attack %,Release %}>Drift target
slider30:0<0,100,0.01>Drift up amount (units match target)
slider31:0<0,100,0.01>Drift down amount (units match target)
slider32:8<1,1000,1>Drift period (cycles)
slider33:0<0,2,1{Sine,Triangle,Random}>Drift shape

// Convenience picker for Host x. WRITES a multiplier into Rate Value on
// change then gets out of the way; "Custom" (default) never writes. Not
// called "Free" -- in sync UI that means FREE-RUNNING, which is what the
// other three modes already are. Named for what you HEAR, not note values.
slider34:0<0,15,1{Custom,every 8 beats,every 4 beats,every 3 beats,every 2 beats,phi slow,2 per 3 beats,3 per 4 beats,1 per beat,4 per 3 beats,3 per 2 beats,phi fast,2 per beat,3 per beat,4 per beat,8 per beat}>Host ratio (writes Rate Value)

@init
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: REAPER re-runs @init on every transport play / render
// start, resetting all runtime for free (LFO phases/gains, pan state,
// rate smoother re-seeded from the slider, drift runtime, Speed Ramp,
// Start Delay, Play/Rest + effect mix). Only the drift CONFIG bank must
// survive the re-run; it's guarded by drift_cfg_inited below.

// Host tempo capture. `tempo` is READ-ONLY in JSFX; we only read it, into a
// global deliberately not named `tempo`. Nothing remembers it across play.
host_bpm   = max(tempo, 0.001);
host_scale = 1;
host_ratio_inited = 0;

phase_l = 0;
phase_r = 0;
gain_l  = 1;
gain_r  = 1;

// ===== PAN BLOCK INIT START =====
pan_l           = 0;
pan_l_smooth    = 0;
pan_cycle_index = 0;
pan_cycle_dir   = 1;
last_phase_l    = 0;
pan_phase       = 0;
// ===== PAN BLOCK INIT END =====


function apply_curve(t, shape) (
  shape == 0 ? t :
  shape == 1 ? (0.5 - 0.5 * cos(t * $pi)) :
  shape == 2 ? (log(1 + 9*t) / log(10)) :
               ((10^t - 1) / 9)
);

function calc_lfo(ph, on_secs, att_secs, rel_secs, period, att_shape, rel_shape)
local(on_frac, aw, rw, hold_w, re_start, t, result, total) (
  on_secs = min(on_secs, period);
  on_frac = on_secs / period;

  aw = att_secs / period;
  rw = rel_secs / period;

  // Scale attack+release down if they exceed on-time
  aw + rw > on_frac ? (
    total = aw + rw;
    aw = aw / total * on_frac;
    rw = rw / total * on_frac;
  );

  hold_w   = on_frac - aw - rw;  // hold-high portion (may be zero)
  re_start = aw + hold_w;        // phase point where release begins

  ph < aw ? (
    // Attack: ramp up from 0 to 1
    aw > 0.0001 ? (
      t = ph / aw;
      result = apply_curve(t, att_shape);
    ) : (result = 1);
  ) :
  ph < re_start ? (
    // Hold high
    result = 1;
  ) :
  ph < on_frac ? (
    // Release: ramp down from 1 to 0
    rw > 0.0001 ? (
      t = 1 - (ph - re_start) / rw;
      result = apply_curve(t, rel_shape);
    ) : (result = 0);
  ) : (
    // Hold low (off-time)
    result = 0;
  );
  result
);

// ===== PAN BLOCK FUNCTIONS START =====
function percycle_pan(idx, n_steps) local(steps, step, pos) (
  n_steps = max(n_steps, 1);
  steps   = max(ceil((n_steps - 1) / 2.0), 1);

  pan_mode == 0 ? (
    pos = 0;
  ) : pan_mode == 1 ? (
    pos = (idx % 2 == 0) ? -1 : 1;
  ) : pan_mode == 2 ? (
    n_steps > 1 ? (pos = (idx % n_steps) / (n_steps - 1.0) * 2.0 - 1.0) : (pos = 0);
  ) : pan_mode == 3 ? (
    n_steps > 1 ? (pos = 1.0 - (idx % n_steps) / (n_steps - 1.0) * 2.0) : (pos = 0);
  ) : pan_mode == 4 ? (
    n_steps > 1 ? (pos = idx / (n_steps - 1.0) * 2.0 - 1.0) : (pos = 0);
  ) : pan_mode == 5 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = -1.0;
    ) : (
      step = ceil((idx + 1) / 2);
      pos = (idx % 2 == 1) ?  (1.0 - (step - 1.0) / steps)
                            : -(1.0 - (step - 1.0) / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : pan_mode == 6 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = -1.0;
    ) : (
      step = ceil((idx + 1) / 2);
      pos = (idx % 2 == 1) ?  (1.0 - (step - 1.0) / steps)
                            : -(1.0 - (step - 1.0) / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : pan_mode == 7 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = 0.0;
    ) : (
      step = floor((idx + 1) / 2);
      pos = (idx % 2 == 1) ? -(step / steps)
                            :  (step / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : pan_mode == 8 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = 0.0;
    ) : (
      step = floor((idx + 1) / 2);
      pos = (idx % 2 == 1) ? -(step / steps)
                            :  (step / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : (
    pos = 0;
  );

  pos * pan_spread
);
// ===== PAN BLOCK FUNCTIONS END =====

// Start Delay state.
last_play_state     = 0;
start_delay_elapsed = 0;
start_delay_sec     = 0;

// Play/Rest gate state. pr_cycle_progress is a continuous fractional
// counter (cycles elapsed in the current play or rest period) that
// flips pr_resting and resets when it crosses the threshold for the
// current state. effect_mix smoothes between 1 (effect fully on) and
// 0 (full dry pass-through) — the tremolo gain target blends with
// 1.0 via this mix, and the pan output blends with the un-panned
// signal the same way, so the transition between play and rest is
// a soft fade rather than an abrupt switch.
pr_resting        = 0;
pr_cycle_progress = 0;
play_for_cycles   = 0;
rest_for_cycles   = 0;
pr_enabled        = 0;
rest_lfo_mode     = 0;
rest_output_mode  = 0;
effect_mix        = 1;

// Speed ramp + rate smoother state.
// freq_smoothed is the per-sample-smoothed tremolo frequency; the
// speed ramp's multiplier is applied on top to produce the effective
// freq used by phase advance + LFO calculations. Seeded from the
// current slider values so the first audio sample isn't smoothed up
// from 0 (would otherwise produce ~100 ms of wrong-rate modulation at
// every transport start since @init re-runs on play).
rate_smoother_coeff      = 1.0 - exp(-1.0 / (srate * 0.1));
slider2 == 0 ? (freq_smoothed = slider1) :
slider2 == 1 ? (freq_smoothed = 1 / max(slider1, 0.001)) :
               (freq_smoothed = slider1 / 60);
// Speed Ramp state. Engage (global) is a freeze/resume gate, not an edge;
// only transport play resets the per-target ramp clocks. As of v2.14 the
// ramp is PER-TARGET (own by/duration/start-delay/clock per target; banks
// below). speed_scale_current is the Rate-Value ramp factor (recomputed each
// sample).
speed_scale_current      = 1.0;

// --- v2.9 Drift target memory banks ---
//
// 6 targets × 8 fields. Each array is 16-slot-spaced so targets can
// grow to 16 later. This plugin uses no other memory arrays (all
// scalar state), so the bank lives at 1024 with plenty of headroom.
//
// Targets:
//   0 = Rate Value      (units: rate's current unit)
//   1 = Depth dB        (units: dB)
//   2 = Pan Sweep Rate  (units: Pan Sweep Rate's unit; modes 9/10 only)
//   3 = On Duration %   (units: %)
//   4 = Attack %        (units: %)
//   5 = Release %       (units: %)
N_TARGETS = 6;
target_drift_up     = 1024;
target_drift_down   = 1040;
target_drift_per    = 1056;
target_drift_shape  = 1072;
target_drift_phase  = 1088;
target_drift_prev   = 1104;
target_drift_curr   = 1120;
target_drift_offset = 1136;

// Speed ramp per-target banks (v2.14). Mirror the drift banks; 16-slot-spaced
// after target_drift_offset (1136). `by` / duration / start-delay are CONFIG
// (survive transport, restored by @serialize); ramp_t / delay_elapsed are
// RUNTIME (reset every @init / transport play).
speed_ramp_by_mem            = 1152;  // signed delta per target (CONFIG)
speed_ramp_dur_mem           = 1168;  // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 1184;  // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 1200;  // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 1216;  // delay sample counter per target (RUNTIME)

// CONFIG banks (drift up/down/period/shape + speed-ramp by/duration/start-delay
// + selector trackers) — guarded by drift_cfg_inited so the @init re-run on
// every transport play (Path A render fix, no ext_noinit) does NOT wipe the
// user's setup. @serialize restores saved configs on project reload.
drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_TARGETS,
    target_drift_up[i]    = 0;
    target_drift_down[i]  = 0;
    target_drift_per[i]   = 8;
    target_drift_shape[i] = 0;
    speed_ramp_by_mem[i]    = 0;
    speed_ramp_dur_mem[i]   = 0;
    speed_ramp_delay_mem[i] = 0;
    i += 1;
  );
  last_target_select = 0;
  last_sr_target     = 0;
  drift_cfg_inited = 1;
);

// Drift + speed-ramp RUNTIME resets on EVERY @init (every transport play).
i = 0;
loop(N_TARGETS,
  target_drift_phase[i]  = 0;
  target_drift_prev[i]   = 0;
  target_drift_curr[i]   = 0;
  target_drift_offset[i] = 0;
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  i += 1;
);


@slider

rate_val     = slider1;
rate_mode    = slider2;
!host_ratio_inited ? ( host_ratio_sel = slider34; host_ratio_inited = 1; );
host_ratio_sel != slider34 ? (
  host_ratio_sel = slider34;
  host_ratio_sel > 0 ? (
    slider1 =
      host_ratio_sel ==  1 ? 0.125 : host_ratio_sel ==  2 ? 0.25  :
      host_ratio_sel ==  3 ? 1/3   : host_ratio_sel ==  4 ? 0.5   :
      host_ratio_sel ==  5 ? 0.618 : host_ratio_sel ==  6 ? 2/3   :
      host_ratio_sel ==  7 ? 0.75  : host_ratio_sel ==  8 ? 1     :
      host_ratio_sel ==  9 ? 4/3   : host_ratio_sel == 10 ? 1.5   :
      host_ratio_sel == 11 ? 1.618 : host_ratio_sel == 12 ? 2     :
      host_ratio_sel == 13 ? 3     : host_ratio_sel == 14 ? 4     : 8;
    slider_automate(slider1);
  );
);
slider_show(slider34, rate_mode == 3);
dur_pct      = slider3;
depth        = slider4;
att_pct      = slider5;
rel_pct      = slider6;
att_shape    = slider7;
rel_shape    = slider8;
phase_offset = slider9 / 360;

amount = 2 ^ (depth / 6);
sc     = 0.5 * amount;
amount = 1 - amount;

// ===== PAN BLOCK SLIDER READ START =====
pan_enabled     = slider11;
pan_mode        = slider12;
pan_spread      = slider13;
pan_glide_ms    = slider14;
pan_cycle_steps = slider15;
pan_sweep_val   = slider16;
pan_sweep_mode  = slider17;
pan_sweep_ratio = slider18;

slider_show(slider12, pan_enabled);
slider_show(slider13, pan_enabled);
slider_show(slider14, pan_enabled);
slider_show(slider15, pan_enabled && pan_mode >= 1 && pan_mode <= 8);
slider_show(slider16, pan_enabled && (pan_mode == 9 || pan_mode == 10));
slider_show(slider17, pan_enabled && (pan_mode == 9 || pan_mode == 10));
slider_show(slider18, pan_enabled && pan_mode == 11);
// ===== PAN BLOCK SLIDER READ END =====

// Start Delay: convert to seconds based on Rate Mode. BPM beats and
// Hz cycles are interpreted against Rate Value; Seconds is literal.
start_delay_units = slider19;
// NOTE: these branches used to be keyed as if the enum were {BPM,Seconds,Hz}
// like Melody Phase / Polyrhythm. It is not -- this plugin's Rate Mode is
// {Hz,Seconds,BPM}, so mode 0 is Hz and mode 2 is BPM. The old code gave Hz
// the BPM formula and BPM the Hz one, making Start Delay 60x out in BOTH.
// Fixed here while adding Host x. (Mode 3 = Host x takes the same form as Hz
// because its nominal rate is also cycles-per-second; the live tempo is
// applied to the counter via host_scale.)
slider2 == 1 ? start_delay_sec = start_delay_units :
slider2 == 2 ? start_delay_sec = start_delay_units * 60 / max(slider1, 0.001) :
               start_delay_sec = start_delay_units / max(slider1, 0.001);

// Play/Rest gate: integer cycle counts. Both must be > 0 for the
// gate to engage; 0 in either slider disables.
play_for_cycles = slider20;
rest_for_cycles = slider21;
new_pr_enabled  = (play_for_cycles > 0 && rest_for_cycles > 0);
// Defensive reset: if user disables the gate mid-rest, snap pr_resting
// back to 0 and zero the progress counter. effect_mix will smoothly
// ramp back to 1 via the @sample smoother.
!new_pr_enabled && pr_resting ? (
  pr_resting = 0;
  pr_cycle_progress = 0;
);
pr_enabled       = new_pr_enabled;
rest_lfo_mode    = slider22;
rest_output_mode = slider23;

// No engage-edge detection. Engage is a freeze/resume gate handled
// in @sample. Only transport play resets ramp_t.

// Drift target selector save/restore (nested-selector pattern).
// Switching slider29 saves sliders 30-33 into the OLD target's slot,
// then loads the NEW target's stored config into sliders 30-33.
// Otherwise captures live edits to the current target's slot. All 6
// targets drift in parallel from @sample regardless of selection.
sel_target = slider29;
sel_up     = slider30;
sel_down   = slider31;
sel_per    = slider32;
sel_shape  = slider33;

last_target_select != sel_target ? (
  target_drift_up[last_target_select]    = sel_up;
  target_drift_down[last_target_select]  = sel_down;
  target_drift_per[last_target_select]   = sel_per;
  target_drift_shape[last_target_select] = sel_shape;

  slider30 = target_drift_up[sel_target];
  slider31 = target_drift_down[sel_target];
  slider32 = target_drift_per[sel_target];
  slider33 = target_drift_shape[sel_target];
  slider_automate(slider30);
  slider_automate(slider31);
  slider_automate(slider32);
  slider_automate(slider33);

  last_target_select = sel_target;
) : (
  target_drift_up[sel_target]    = sel_up;
  target_drift_down[sel_target]  = sel_down;
  target_drift_per[sel_target]   = sel_per;
  target_drift_shape[sel_target] = sel_shape;
);

// Speed ramp target selector save/restore (nested-selector, mirrors the drift
// block above). slider24 = target; slider25 = per-target `by`; slider26 =
// per-target duration; slider28 = per-target start delay (all three per-target
// as of v2.14). slider27 (engage) stays GLOBAL. Switching slider24 saves the
// three per-target sliders into the OLD target's slots, then loads the NEW
// target's stored values. Otherwise captures live edits. All targets ramp in
// parallel from @sample, each on its own duration/delay clock.
sr_sel_target = slider24;
sr_sel_by     = slider25;
sr_sel_dur    = slider26;
sr_sel_delay  = slider28;

last_sr_target != sr_sel_target ? (
  speed_ramp_by_mem[last_sr_target]    = sr_sel_by;
  speed_ramp_dur_mem[last_sr_target]   = sr_sel_dur;
  speed_ramp_delay_mem[last_sr_target] = sr_sel_delay;
  slider25 = speed_ramp_by_mem[sr_sel_target];
  slider26 = speed_ramp_dur_mem[sr_sel_target];
  slider28 = speed_ramp_delay_mem[sr_sel_target];
  slider_automate(slider25);
  slider_automate(slider26);
  slider_automate(slider28);
  last_sr_target = sr_sel_target;
) : (
  speed_ramp_by_mem[sr_sel_target]    = sr_sel_by;
  speed_ramp_dur_mem[sr_sel_target]   = sr_sel_dur;
  speed_ramp_delay_mem[sr_sel_target] = sr_sel_delay;
);


@block
// Follow the project tempo while Host x is active. ABSOLUTE (tempo / 60),
// never a ratio against a remembered reference -- @init re-runs on transport
// play and wipes globals, so a reference would reset and silently discard the
// change. 1 in every other mode, so those stay bit-identical.
host_bpm = max(tempo, 0.001);
host_scale = rate_mode == 3 ? host_bpm / 60 : 1;

// Transport POSITION, for phase-locking the LFO in Host x. Tempo sync sets
// the LFO's speed; this sets where in the cycle it is, so the tremolo lands
// the same way at the same bar however you got there -- the thing a
// tempo-synced effect is expected to do. Deriving phase from the position
// also means it can't drift over a long session, and it survives seeking and
// looping. Only while the transport is actually moving (1 = playing,
// 5 = recording); stopped or paused, beat_position doesn't advance and
// locking to it would freeze the LFO for anyone monitoring live.
host_beat_pos   = beat_position;
host_pos_locked = (play_state == 1 || play_state == 5);
blk_sample      = 0;

@sample

// (No transport-edge reset here — Path A. REAPER re-runs @init on every
// transport play / render start, which resets all runtime state — LFO
// phases/gains, pan state, rate smoother (re-seeded from slider1), drift
// runtime, Speed Ramp, Start Delay, Play/Rest + effect mix; the drift
// CONFIG bank is preserved across those re-runs by the drift_cfg_inited
// guard in @init. See docs/v2.9-render-state-bug.md.)

start_delay_elapsed < start_delay_sec ? (
  // * host_scale: start_delay_sec derives from the NOMINAL rate, so a
  // wall-clock counter would be wrong by exactly the tempo ratio while
  // everything else was right -- the partial failure Melody Phase hit.
  start_delay_elapsed += host_scale / srate;
  // No-op — spl0 and spl1 pass through unchanged.
) : (

rate_val     = slider1;
rate_mode    = slider2;
dur_pct      = slider3;
depth        = slider4;
att_pct      = slider5;
rel_pct      = slider6;
att_shape    = slider7;
rel_shape    = slider8;
phase_offset = slider9 / 360;

// ===== PAN BLOCK SAMPLE READ START =====
pan_enabled     = slider11;
pan_mode        = slider12;
pan_spread      = slider13;
pan_glide_ms    = slider14;
pan_cycle_steps = slider15;
pan_sweep_val   = slider16;
pan_sweep_mode  = slider17;
pan_sweep_ratio = slider18;
// ===== PAN BLOCK SAMPLE READ END =====

// (amount / sc are computed AFTER the drift block below, so the Depth
// dB drift target can fold into depth first.)

// Host x (3) yields a NOMINAL cycles-per-second, as if the project were at
// 60 BPM; the live tempo arrives separately as host_scale, so nothing here
// has to remember a tempo and go stale when @init re-runs on play.
rate_mode == 0 ? (freq_raw = rate_val) :
rate_mode == 1 ? (freq_raw = 1 / max(rate_val, 0.001)) :
rate_mode == 3 ? (freq_raw = rate_val) :
                 (freq_raw = rate_val / 60);

// Smooth the rate slider so manual tweaks don't click, then advance
// the speed ramp. Drift offsets are added below.
freq_smoothed += (freq_raw - freq_smoothed) * rate_smoother_coeff;

// Advance each target's own ramp clock (v2.14 per-target timeline). Engage
// (slider27, GLOBAL) is the freeze/resume gate: while On, each target whose
// duration > 0 advances its own ramp_t 0->1 over its own duration, after its
// own start delay; while Off, all clocks freeze and resume. Only transport
// play (via @init) resets them.
slider27 ? (
  i = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * 60 * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        speed_ramp_ramp_t_mem[i] += 1.0 / (srate * speed_ramp_dur_mem[i] * 60);
        speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
      );
    );
    i += 1;
  );
);

// Each target's live ramp offset is speed_ramp_ramp_t_mem[t] *
// speed_ramp_by_mem[t], applied at that target's consumption site alongside
// the matching drift offset.
//
// Rate Value (target 0): effective rate value = slider1 + ramp offset (in
// the rate's current unit). Convert to Hz the same way freq_raw is computed
// above, then express as a multiplicative factor on freq so the existing
// combined_scale-based audio path keeps working. No "snapshot at engage" —
// live edits adjust trajectory.
effective_rate_val = rate_val + speed_ramp_ramp_t_mem[0] * speed_ramp_by_mem[0];
rate_mode == 0 ? (effective_rate_hz = effective_rate_val) :
rate_mode == 1 ? (effective_rate_hz = 1 / max(effective_rate_val, 0.001)) :
rate_mode == 3 ? (effective_rate_hz = effective_rate_val) :
                 (effective_rate_hz = effective_rate_val / 60);
speed_scale_current = effective_rate_hz / max(freq_raw, 0.001);
// host_scale folds the live project tempo in alongside Speed Ramp (1 outside
// Host x, so a no-op elsewhere). The tremolo and pan phases ride
// combined_scale, so they follow the tempo for free.
combined_scale = speed_scale_current * host_scale;
freq = freq_smoothed * combined_scale;

// ===== DRIFT BLOCK START =====
// Per-target drift wave computation. 6 targets (0=Rate Value, 1=Depth
// dB, 2=Pan Sweep Rate, 3=On Duration %, 4=Attack %, 5=Release %).
// Each gets a phase counter advancing per sample. Period unit is
// tremolo cycles for ALL targets, referenced against drift_ref_freq
// (the Speed-Ramp-adjusted rate BEFORE drift, captured here) so drift
// on Rate Value doesn't self-modulate its own period.
drift_ref_freq = max(freq, 0.00001);
i = 0;
loop(N_TARGETS,
  up    = target_drift_up[i];
  down  = target_drift_down[i];
  per   = target_drift_per[i];
  shape = target_drift_shape[i];

  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    period_samples = max(per * srate / drift_ref_freq, 1);
    new_phase = target_drift_phase[i] + 1.0 / period_samples;
    new_phase >= 1.0 ? (
      new_phase -= 1.0;
      shape == 2 ? (
        target_drift_prev[i] = target_drift_curr[i];
        target_drift_curr[i] = rand(2) - 1;
      );
    );
    target_drift_phase[i] = new_phase;

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = target_drift_prev[i] +
        (target_drift_curr[i] - target_drift_prev[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  target_drift_offset[i] = drift_offset_local;
  i += 1;
);

// Rate Value drift (target 0): offset is in the rate's current unit;
// convert to a Hz delta on freq the same way the old drift did (in
// Seconds mode it's a period delta, not a Hz delta). Clamp the result
// so an aggressive Down-by can't freeze the LFO.
rate_drift_user = target_drift_offset[0];
rate_drift_hz   = 0;
rate_drift_user != 0 ? (
  // Keyed by NAME, not index: 0 Hz, 1 Seconds, 2 BPM, 3 Host x. This chain
  // used to end in a bare else, which swallowed Host x into the BPM branch
  // and made Rate Value drift 60x too small — i.e. inaudible. In Host x the
  // offset is a multiplier delta, so it converts like Hz and then takes
  // host_scale, because it is added to freq AFTER combined_scale.
  rate_mode == 0 ? (rate_drift_hz = rate_drift_user) :
  rate_mode == 1 ? (
    cur_period    = 1 / drift_ref_freq;
    new_period    = max(cur_period + rate_drift_user, 0.0001);
    rate_drift_hz = (1 / new_period) - freq;
  ) :
  rate_mode == 2 ? (rate_drift_hz = rate_drift_user / 60) :
                   (rate_drift_hz = rate_drift_user * host_scale);
);
freq = max(freq + rate_drift_hz, 0.001);
// ===== DRIFT BLOCK END =====

// Depth dB drift + Speed Ramp (target 1): fold into depth, then compute
// amount/sc. Clamp to the slider's range (-60..0 dB).
eff_depth = max(-60, min(0, depth + target_drift_offset[1] + speed_ramp_ramp_t_mem[1] * speed_ramp_by_mem[1]));
amount = 2 ^ (eff_depth / 6);
sc     = 0.5 * amount;
amount = 1 - amount;

// On Duration / Attack / Release drift + Speed Ramp (targets 3, 4, 5): fold
// into the per-cycle fractions, clamped to [0, 100] %.
eff_dur_pct = max(0, min(100, dur_pct + target_drift_offset[3] + speed_ramp_ramp_t_mem[3] * speed_ramp_by_mem[3]));
eff_att_pct = max(0, min(100, att_pct + target_drift_offset[4] + speed_ramp_ramp_t_mem[4] * speed_ramp_by_mem[4]));
eff_rel_pct = max(0, min(100, rel_pct + target_drift_offset[5] + speed_ramp_ramp_t_mem[5] * speed_ramp_by_mem[5]));

// Pan Sweep Rate drift + Speed Ramp (target 2): fold into the pan sweep
// value used by pan modes 9/10 below (in the Pan Sweep Rate's own unit).
eff_pan_sweep_val = max(0.001, pan_sweep_val + target_drift_offset[2] + speed_ramp_ramp_t_mem[2] * speed_ramp_by_mem[2]);

period   = 1 / max(freq, 0.00001);
on_secs  = (eff_dur_pct / 100.0) * period;
att_secs = (eff_att_pct / 100.0) * period;
rel_secs = (eff_rel_pct / 100.0) * period;

// Play/Rest gate state machine. pr_cycle_progress accumulates
// fractional cycles at the tremolo rate; when it crosses the
// threshold for the current state (play_for_cycles when playing,
// rest_for_cycles when resting), pr_resting flips and the counter
// resets.
pr_enabled ? (
  pr_cycle_progress += freq / srate;
  !pr_resting ? (
    pr_cycle_progress >= play_for_cycles ? (
      pr_resting = 1;
      pr_cycle_progress = 0;
    );
  ) : (
    pr_cycle_progress >= rest_for_cycles ? (
      pr_resting = 0;
      pr_cycle_progress = 0;
    );
  );
);

// Smoother coefficient — used for the existing gain smoother and
// (just below) for effect_mix. Moved up from its original spot
// inside the gain section so effect_mix can reuse it.
smooth = exp(-1 / (srate * 0.003));

// in_frozen_rest gates LFO phase advancement (tremolo phase_l/r
// and pan_phase) so Freeze pauses the modulation during rest. Walk
// leaves it false and the LFOs keep cycling silently. Independent
// of Rest output, so all four LFO×output combinations work.
in_frozen_rest = pr_enabled && pr_resting && rest_lfo_mode == 1;

// effect_mix smoothly transitions between 1 (effect fully on) and
// 0 (rest target) at rest boundaries. The rest target depends on
// Rest output: 1.0 (unity gain = dry pass-through) for Pass-through,
// 0 (full silence) for Silence. The tremolo gain target blends
// between LFO-driven gain and rest_gain_target via effect_mix;
// pan output blends with the pre-pan signal (which will already
// be 0 in Silence mode because gain_l has smoothed to 0).
target_effect_mix = pr_enabled && pr_resting ? 0 : 1;
effect_mix        = effect_mix * smooth + target_effect_mix * (1 - smooth);
rest_gain_target  = (rest_output_mode == 1) ? 0 : 1;

// Where this sample sits in the project, in beats -- @block gives the position
// at the start of the block, so step forward by however far in we are.
sample_beat_pos = host_beat_pos + blk_sample * host_bpm / (60 * srate);
blk_sample += 1;

// Lock the phase to the project only while NOTHING is moving the rate. The
// position formula answers "where would the LFO be if it had run at this rate
// all along", which is only the right question when that's true. The moment
// Drift or Speed Ramp touches the rate you've asked for something off the
// grid, so it hands over to the free-running accumulator from wherever it is
// -- no jump on the handover, and it stays free until the next transport
// start rather than lurching back onto the grid mid-play.
rate_pos_lock = (rate_mode == 3) && host_pos_locked
                && rate_drift_hz == 0
                && speed_ramp_ramp_t_mem[0] * speed_ramp_by_mem[0] == 0;

// Advance tremolo phases unless Freeze rest is pinning them.
!in_frozen_rest ? (
  rate_pos_lock ? (
    // rate_val is cycles per beat in Host x, so this is simply how far
    // through the cycle the project position is.
    phase_l = sample_beat_pos * rate_val;
    phase_l -= floor(phase_l);
  ) : (
    phase_l += freq / srate;
    phase_l >= 1 ? phase_l -= 1;
  );

  slider10 == 0 ? (
    rate_pos_lock ? (
      phase_r = phase_l;
    ) : (
      phase_r += freq / srate;
      phase_r >= 1 ? phase_r -= 1;
    );
  ) : (
    phase_r = phase_l + phase_offset;
    phase_r >= 1 ? phase_r -= 1;
    phase_r < 0  ? phase_r += 1;
  );
);

lfo_l = calc_lfo(phase_l, on_secs, att_secs, rel_secs, period, att_shape, rel_shape);
lfo_r = calc_lfo(phase_r, on_secs, att_secs, rel_secs, period, att_shape, rel_shape);

// Gain target blends LFO-based modulation with rest_gain_target
// (1 for Walk/Freeze = dry pass-through, 0 for Silence = mute)
// based on effect_mix. During rest, effect_mix → 0, gain target
// → rest_gain_target, the smoother ramps gain there over ~3 ms.
target_gain_l = effect_mix * (lfo_l * sc + amount) + (1 - effect_mix) * rest_gain_target;
target_gain_r = effect_mix * (lfo_r * sc + amount) + (1 - effect_mix) * rest_gain_target;
gain_l = gain_l * smooth + target_gain_l * (1 - smooth);
gain_r = gain_r * smooth + target_gain_r * (1 - smooth);

spl0 *= gain_l;
spl1 *= gain_r;

// ===== PAN BLOCK SAMPLE LOGIC START =====
pan_enabled ? (
  // Per-cycle pan modes (0-8) advance pan_cycle_index on tremolo
  // phase wraps. Since the tremolo phase advancement above is
  // gated by !in_frozen_rest, cycle_fired never triggers during
  // Freeze rest — pan_cycle_index naturally pauses without needing
  // its own gate.
  cycle_fired  = (phase_l < last_phase_l);
  last_phase_l = phase_l;

  pan_mode <= 8 ? (
    cycle_fired ? (
      pan_mode == 4 || pan_mode == 6 || pan_mode == 8 ? (
        pan_cycle_index += pan_cycle_dir;
        (pan_cycle_index >= pan_cycle_steps - 1 || pan_cycle_index <= 0) ?
          pan_cycle_dir = -pan_cycle_dir;
      ) : (
        pan_cycle_index = (pan_cycle_index + 1) % pan_cycle_steps;
      );
    );
    cur_pan = percycle_pan(pan_cycle_index, pan_cycle_steps);
    pan_l = cur_pan;

  ) : pan_mode == 9 ? (
    // Pan Sweep — gate phase advance for Freeze mode. eff_pan_sweep_val
    // carries the Pan Sweep Rate drift offset (target 2).
    pan_sweep_mode == 0 ? (pan_freq = eff_pan_sweep_val) :
    pan_sweep_mode == 1 ? (pan_freq = 1 / max(eff_pan_sweep_val, 0.001)) :
                          (pan_freq = eff_pan_sweep_val / 60);
    !in_frozen_rest ? (
      pan_phase += pan_freq / srate;
      pan_phase >= 1 ? pan_phase -= 1;
    );
    cur_pan = (pan_phase * 2.0 - 1.0) * pan_spread;
    pan_l = cur_pan;

  ) : pan_mode == 10 ? (
    // Pan Sweep Flipped — gate phase advance for Freeze mode.
    pan_sweep_mode == 0 ? (pan_freq = eff_pan_sweep_val) :
    pan_sweep_mode == 1 ? (pan_freq = 1 / max(eff_pan_sweep_val, 0.001)) :
                          (pan_freq = eff_pan_sweep_val / 60);
    !in_frozen_rest ? (
      pan_phase += pan_freq / srate;
      pan_phase >= 1 ? pan_phase -= 1;
    );
    cur_pan = (1.0 - pan_phase * 2.0) * pan_spread;
    pan_l = cur_pan;

  ) : (
    // Linked Sweep — gate phase advance for Freeze mode.
    !in_frozen_rest ? (
      pan_phase += (freq * pan_sweep_ratio) / srate;
      pan_phase >= 1 ? pan_phase -= 1;
    );
    cur_pan = (pan_phase * 2.0 - 1.0) * pan_spread;
    pan_l = cur_pan;
  );

  // Glide smoothing — runs always, so pan_l_smooth still tracks
  // pan_l targets even when phases are frozen (pan_l just stays
  // constant in that case, smoother converges to it).
  pan_glide_coeff = pan_glide_ms > 0 ? exp(-1 / (srate * pan_glide_ms * 0.001)) : 0;
  pan_l_smooth = pan_l_smooth * pan_glide_coeff + pan_l * (1 - pan_glide_coeff);

  // Apply the pan, then blend the panned output with the un-panned
  // signal via effect_mix. During rest, effect_mix → 0 means the
  // output is the un-panned (post-tremolo, but tremolo has also
  // smoothed back to 1.0) signal — i.e., dry pass-through.
  pan_pos = (pan_l_smooth + 1.0) * 0.5;
  mono = (spl0 + spl1) * 0.5;
  spl0_panned = mono * cos(pan_pos * $pi * 0.5);
  spl1_panned = mono * sin(pan_pos * $pi * 0.5);
  spl0 = spl0 * (1 - effect_mix) + spl0_panned * effect_mix;
  spl1 = spl1 * (1 - effect_mix) + spl1_panned * effect_mix;
);
// ===== PAN BLOCK SAMPLE LOGIC END =====

);  // close start-delay else branch

@serialize
// Persist per-target drift AND speed-ramp configurations. Without this,
// only the most-recently-edited target's values survive a save/load because
// the sliders hold whichever target was selected at save time.
//
// VERSION-GUARDED (CLAUDE.md @serialize gotcha): leads with a magic marker so
// format changes degrade to defaults instead of scrambling. Magic bumped to
// 2100000 + N_TARGETS in v2.14 when Speed Ramp went PER-TARGET timeline (added
// the duration + start-delay banks); an older 2000000-base blob won't match
// and falls through to @init defaults (drift + ramp reset — acceptable, this
// is pre-release). Marker is well above any plausible first-field value and
// float32-exact (< 2^24).
sr_magic = 2100000 + N_TARGETS;
file_var(0, sr_magic);
sr_magic == 2100000 + N_TARGETS ? (
  file_mem(0, target_drift_up,     N_TARGETS);
  file_mem(0, target_drift_down,   N_TARGETS);
  file_mem(0, target_drift_per,    N_TARGETS);
  file_mem(0, target_drift_shape,  N_TARGETS);
  file_var(0, last_target_select);
  file_mem(0, speed_ramp_by_mem,    N_TARGETS);
  file_mem(0, speed_ramp_dur_mem,   N_TARGETS);
  file_mem(0, speed_ramp_delay_mem, N_TARGETS);
  file_var(0, last_sr_target);

  // TRACK-DUPLICATE FIX (v2.14). On READ (load/duplicate) file_avail(0) >= 0;
  // on WRITE (save/undo) it is < 0. @serialize is the only section guaranteed
  // to run on both load AND duplicate, so it re-establishes the bank<->slider
  // invariant here: force the visible config sliders to match the restored
  // bank for the restored selectors, correcting any transient @slider clobber
  // (which would otherwise zero whichever target was selected on the copy).
  file_avail(0) >= 0 ? (
    slider25 = speed_ramp_by_mem[last_sr_target];        // Speed ramp `by`
    slider26 = speed_ramp_dur_mem[last_sr_target];       // Speed ramp duration
    slider28 = speed_ramp_delay_mem[last_sr_target];     // Speed ramp start delay
    slider30 = target_drift_up[last_target_select];      // Drift up
    slider31 = target_drift_down[last_target_select];    // Drift down
    slider32 = target_drift_per[last_target_select];     // Drift period
    slider33 = target_drift_shape[last_target_select];   // Drift shape
    sliderchange(-1);
  );
);