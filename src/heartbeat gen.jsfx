desc: Heartbeat Generator
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/

// RANGE WIDENED 2026-09-04, from 20..200 step 1, and it was FORCED by the Host x
// conversion rather than chosen. In Host x this number is beats per cycle, and a
// heart wants roughly half a beat to two beats per cycle -- none of which the old
// range could express, and the step of 1 could not have reached anyway. The old
// landing block even tried to write 1 into it, which REAPER would have clamped
// straight back up to 20, i.e. twenty times the project tempo.
//
// Widening cannot disturb a saved project: every value that fitted 20..200 still
// fits, and no stored value is clamped. (Narrowing is the dangerous direction --
// that clamps permanently, which is why the plan puts range changes in the risky
// row.) The step matches every other rate slider in the suite; you type the
// number you want and nudge from there.
slider1:70<0.001,1000,0.001>Heart rate (BPM / sec / Hz / beats per cycle / per beat)
slider2:0<0,4,1{BPM,Seconds,Hz,Every N beats,N per beat}>Rate Mode
slider3:120<50,1000,1>Systole ms (S1->S2 gap)
slider4:1.0<0.0,1.0,0.01>S1 Volume
slider5:0.7<0.0,1.0,0.01>S2 Volume
slider6:0.3<0.0,1.0,0.01>Brightness
slider7:60<10,1000,1>S1 Decay ms
slider8:25<5,1000,1>S2 Decay ms
// --- Pitch (R22) ----------------------------------------------------------
// One block behind a target, exactly as Breath Generator ships it. The two
// thump frequencies are real pitches -- tuning a heart to a note is a musical
// act, which is Rozaya's own call: "Filters: yes, they should. Musicality
// integration, not exclusivity, is the idea here."
slider9:0<0,2,1{All,S1,S2}>Pitch target
slider10:0<0,2,1{Hz,Semitones,Cents}>Pitch mode
slider11:34<0,127,1{C-1,C#-1,D-1,D#-1,E-1,F-1,F#-1,G-1,G#-1,A-1,A#-1,B-1,C0,C#0,D0,D#0,E0,F0,F#0,G0,G#0,A0,A#0,B0,C1,C#1,D1,D#1,E1,F1,F#1,G1,G#1,A1,A#1,B1,C2,C#2,D2,D#2,E2,F2,F#2,G2,G#2,A2,A#2,B2,C3,C#3,D3,D#3,E3,F3,F#3,G3,G#3,A3,A#3,B3,C4,C#4,D4,D#4,E4,F4,F#4,G4,G#4,A4,A#4,B4,C5,C#5,D5,D#5,E5,F5,F#5,G5,G#5,A5,A#5,B5,C6,C#6,D6,D#6,E6,F6,F#6,G6,G#6,A6,A#6,B6,C7,C#7,D7,D#7,E7,F7,F#7,G7,G#7,A7,A#7,B7,C8,C#8,D8,D#8,E8,F8,F#8,G8,G#8,A8,A#8,B8,C9,C#9,D9,D#9,E9,F9,F#9,G9}>Note name
slider12:45<0,20000,0.001>Pitch value (Hz / semitones / cents)
slider13:0<-1000,1000,0.001>Fine tune
slider14:2<0,2,1{Hz,Semitones,Cents}>Fine tune unit
slider15:440<20,2000,0.1>Tuning reference (Hz)
slider16:3.0<-15.0,15.0,0.1>Stereo Width ms (neg = heart right)
slider17:6.0<0.001,1000,0.001>Breath Cycle Seconds
slider18:0.08<0.0,0.25,0.01>Breath HRV Depth
slider19:0.02<0.0,0.08,0.005>Random HRV Depth

// Sit silent for N heartbeats after playback starts, then begin
// normally. Beats are counted at the current BPM (slider1) so a delay
// value of 4 at 60 BPM is 4 seconds; at 120 BPM it's 2 seconds.
// Re-arms on every transport stop/start. 0 disables the delay.
slider20:0<0,1000,0.001>Start delay (beats)

// Per-beat Play/Rest gate. Fires beats normally for N beats, then
// suppresses the next M beat triggers (silent), then resumes —
// repeats forever. Each beat counted is one full heartbeat at the
// current BPM (S1 + S2 with the systole interval). The previous
// beat's S1/S2 envelopes finish naturally during the silent gap,
// so "rest" here is "don't trigger new beats" rather than any kind
// of fade. 0 in either slider disables the gate entirely. Resets
// on every transport stop/start, same as Start Delay.
slider21:0<0,1000,1>Play for (beats)
slider22:0<0,1000,1>Rest for (beats)

// Speed ramp: nested-selector pattern matching Womb v3. Pick a target
// (slider32), set a signed delta `by` amount (slider33) in the target's
// natural unit; per-target duration (31) + start delay (33); global engage
// (32). All 4 targets ramp in parallel, each on its own clock; switching the
// selector doesn't stop a running ramp. Engage is a freeze/resume gate (NOT a
// restart edge); only transport play resets the ramp clocks. (v2.14 reorg:
// the block was renumbered to a contiguous selector-first group 29-33.)
//
// Migration from v2.7: slider22 changed from multiplier (0.1-4.0) to
// integer selector (0-3). Old projects' multiplier value rounds down
// to a selector index; slider25 (new amount) defaults to 0, so Speed
// Ramp produces no effect on reload until reconfigured.
// v2.14 REORG: the Speed Ramp block is renumbered into a contiguous
// selector-first group (target 29, by 30, duration 31, engage 32, start-delay
// 33) so the controls tab together — previously `by` sat after engage and
// start-delay was stranded at slider34. Old IDs 17-20 + 28 are now unused;
// Speed Ramp configs reset on this upgrade (magic already bumped). Declared
// here for context; REAPER orders by ID so they appear grouped at 29-33.
slider32:0<0,17,1{Heart rate,S1-S2 gap,S1 volume,S2 volume,Brightness,S1 decay,S2 decay,S1 pitch,S2 pitch,S1 fine tune,S2 fine tune,Tuning reference,Stereo width,Breath cycle,Breath HRV depth,Random HRV depth,Play for,Rest for}>Ramp target
slider33:0<-1000,1000,0.001>Ramp by (per target)
// What the duration and start delay are counted in -- one unit for both, so they
// always mean the same thing as each other. DEFAULT IS 2, Minutes, which is what
// this block always did; index 0 would silently reinterpret every saved ramp.
// Cycles counts heartbeats at the rate BEFORE drift and ramp touch it, so a ramp
// cannot alter its own clock.
slider34:2<0,3,1{Cycles,Seconds,Minutes,Beats}>Ramp time unit (all targets)
slider35:0<0,1000,0.1>Ramp duration (per target, in ramp time units)
// Ramp play/rest, per target, in ramp time units: the ramp advances for `play`,
// holds for `rest`, and repeats -- a staircase instead of a smooth glide. The
// holds come OUT of the duration rather than extending it, so Ramp duration goes
// on meaning "you arrive in about this long". Both zero is the smooth ramp.
slider36:0<0,1000,0.01>Ramp play for (per target, 0 = smooth)
slider37:0<0,1000,0.01>Ramp rest for (per target, 0 = smooth)
slider38:0<0,1,1{Off,On}>Ramp engage (all targets)

// Per-target drift: nested-selector pattern matching Womb v3 / breath
// gen v2.9. Pick a target (slider23), then sliders 22-25 hold THAT
// target's drift config. Switching the selector saves current values
// to the old target's memory slot and loads the new target's values
// into the sliders. All 4 targets drift in parallel; the selector
// just chooses which one you're currently editing. Period unit is
// heartbeats for all 4 targets. For slow wall-clock-feel drift, set
// a long period (~360 heartbeats ≈ 5 min at 72 BPM).
//
// Target indices align with the Speed Ramp selector above — same
// selector value means the same parameter for both, which is a
// convenience for users coordinating drift and ramp on the same
// target.
//
// Migration from v2.8: the old flat drift block (musical_up,
// musical_down, musical_period, slow_up, slow_down, slow_period,
// drift_shape on sliders 21-27) was 7 sliders covering one target
// (Heart BPM only). This is 5 sliders covering 4 independent targets,
// reusing slider IDs 21-25; sliders 26 and 27 are no longer declared.
// Old projects' slider values get reinterpreted (selector defaults
// to Heart BPM, slider24-23 become up/down amounts in BPM). Reset
// drift sliders to defaults after upgrade and reconfigure if you'd
// used the old block.
// EIGHTEEN since 2026-09-11 (R24), in the order of the controls they reach. The
// two HRV depths moved from 2 and 3 to 14 and 15; the plugin remaps an old save.
slider23:0<0,17,1{Heart rate,S1-S2 gap,S1 volume,S2 volume,Brightness,S1 decay,S2 decay,S1 pitch,S2 pitch,S1 fine tune,S2 fine tune,Tuning reference,Stereo width,Breath cycle,Breath HRV depth,Random HRV depth,Play for,Rest for}>Drift target
slider24:0<0,1000,0.01>Drift up amount (per target, units match target)
slider25:0<0,1000,0.01>Drift down amount (per target, units match target)
slider26:8<0,1000,1>Drift period (per target, 0 = off)
// What the period is COUNTED IN. Cycles is this plugin's native count -- one
// heartbeat -- and the default, which is exactly what this control did before
// the unit existed. Seconds is wall clock. Beats counts the PROJECT tempo, a
// different clock from the heart's own whenever the two disagree.
slider27:0<0,2,1{Cycles,Seconds,Beats}>Drift period unit (all targets)
// WHETHER THIS TARGET'S DRIFT MOVES WITH ITS OWN THING, OR ON A CLOCK.
// Rozaya, 2026-09-09: the choice "should have been a switch from the very
// beginning" -- both are valid artistic decisions and neither is the plugin's
// to make. INSERTED beside the period controls, not appended, on its call.
//
// `With the target` advances the drift one whole step each time that target's
// own thing happens, so a period of 8 counts eight of them. `On a clock`
// advances it continuously, drawing the whole curve.
//
// DEFAULTS REPRODUCE WHAT drift_is_stepped() HARDCODED, so nothing saved moves.
slider28:0<0,1,1{With the target,On a clock}>Drift movement (per target)
slider29:0<0,2,1{Sine,Triangle,Random}>Drift shape (per target)
// Drift play/rest, per target, counted in PERIODS. Both must be above zero or
// the gate is off, which is what 0 means. While resting the phase does not
// advance, so the offset FREEZES where it stopped rather than returning to
// centre -- and the FRACTION of the play value chooses where it parks: x.25
// crest, x.75 trough, x.0 and x.5 neutral. A whole number parks at no-change
// every time and is nearly inaudible; an awkward fraction is the useful one.
slider30:0<0,1000,0.01>Drift play for (per target, periods, 0 = always)
slider31:0<0,1000,0.01>Drift rest for (per target, periods, 0 = always)

// Speed ramp start delay — part of the v2.14 selector-first block (appears at
// 33 in the UI, right after engage/32).
slider39:0<0,1000,0.1>Ramp start delay (per target, in ramp time units)

// --- Host tempo sync (sliders 34-35) ------------------------------------
// Own BPM: free-running, project tempo ignored -- original behaviour.
// Host x:  the heart rate means BEATS PER CYCLE -- one heartbeat every N project
//          beats. 1 is a beat per beat; 0.5 is two heartbeats a beat; 2 is one
//          every two beats. Bigger is slower. It used to be a MULTIPLIER of the
//          tempo (R13-revised, 2026-09-02), which on a slider whose minimum was
//          20 meant the gentlest available setting was twenty times the tempo.
// Two entries, not four: only one unit here, so Seconds / Hz would be
// meaningless. Appended at the END per the never-renumber rule.

// RETIRED 2026-09-04 by R13-revised, and hidden. It existed only to spare you
// arithmetic on a multiplier; "every 4 beats" is now typing 4. NOT deleted --
// slider ids are primary keys and removing one shifts every control above it in
// every saved project.
slider40:0<0,15,1{Custom,every 8 beats,every 4 beats,every 3 beats,every 2 beats,phi slow,2 per 3 beats,3 per 4 beats,1 per beat,4 per 3 beats,3 per 2 beats,phi fast,2 per beat,3 per beat,4 per beat,8 per beat}>Host ratio (retired)

@init
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: REAPER re-runs @init on every transport play / render
// start, resetting all runtime for free (state machine, oscillators,
// filters, delay buffer, drift runtime, Speed Ramp, Start Delay, noise
// seeds, BPM smoother). Only the drift + Speed Ramp CONFIG banks must
// survive the re-run; they're guarded by drift_cfg_inited below.

// Host tempo capture. `tempo` is READ-ONLY in JSFX; read only, into a
// global deliberately not named `tempo`. Nothing remembers it across play.
host_bpm = max(tempo, 0.001);
host_ratio_inited = 0;

srate_inv = 1.0 / srate;
two_pi = 2.0 * $pi;

s1_freq = 45.0;
s2_freq = 120.0;
s1_phase_osc_near = 0; s1_phase_osc_far = 0;
s2_phase_osc_near = 0; s2_phase_osc_far = 0;

cycle_len_base = floor(srate * 60.0 / 70.0);
cycle_len = cycle_len_base;
systole_samples = floor(srate * 120.0 * 0.001);
s1_vol = 1.0;
s2_vol = 0.7;
s1_decay = exp(-srate_inv / 0.060);
s2_decay = exp(-srate_inv / 0.025);
s1_attack_rate = exp(-srate_inv / 0.008);
s2_attack_rate = exp(-srate_inv / 0.004);

delay_buf_size = 4096;
memset(0, 0, delay_buf_size);
delay_write = 0;
delay_samples = floor(srate * 0.003);
delay_sign = 1;

phase = 0;
s1_active = 1; s2_active = 0;
s1_env = 1.0; s2_env = 0;
s1_attack_phase = 0; s2_attack_phase = 0;

breath_phase = 0.0;
breath_rate = two_pi / (6.0 * srate);
breath_depth = 0.08;

rand_hrv = 0.0;
rand_hrv_target = 0.0;
rand_hrv_depth = 0.02;
rand_hrv_step = 0;
rand_hrv_step_len = floor(srate * 5.0);
rand_hrv_slew = exp(-srate_inv / 3.0);
hrv_seed = 99999;

s1_res_f_near = min(2.0 * sin($pi * 50.0 * srate_inv), 0.98);
s1_res_q_near = 2.8;
s1_res_low_near = 0; s1_res_band_near = 0;
s2_res_f_near = min(2.0 * sin($pi * 138.0 * srate_inv), 0.98);
s2_res_q_near = 2.0;
s2_res_low_near = 0; s2_res_band_near = 0;
lp_f_near = min(2.0 * sin($pi * 200.0 * srate_inv), 0.98);
lp_low_near = 0; lp_band_near = 0; lp_low2_near = 0; lp_band2_near = 0;

s1_res_f_far = min(2.0 * sin($pi * 58.0 * srate_inv), 0.98);
s1_res_q_far = 2.2;
s1_res_low_far = 0; s1_res_band_far = 0;
s2_res_f_far = min(2.0 * sin($pi * 150.0 * srate_inv), 0.98);
s2_res_q_far = 1.6;
s2_res_low_far = 0; s2_res_band_far = 0;
lp_f_far = min(2.0 * sin($pi * 175.0 * srate_inv), 0.98);
lp_low_far = 0; lp_band_far = 0; lp_low2_far = 0; lp_band2_far = 0;

lp_q = 0.5;

// STABILITY CEILING for the resonators above (2026-09-10). This is a Chamberlin
// state variable filter, and it has a speed limit that falls as damping rises:
// it is stable only while f*f + 2*q*f < 4, so f must stay under 4/(sqrt(q*q+4)+q).
// With S1's q of 2.8 that is a centre of about 4.6 kHz, and a thump pitch above
// roughly 5 kHz sent the output to infinity within a hundredth of a second, in
// any pitch mode. The min(..., 0.98) below never protected it. 0.9 of the limit
// keeps clear of the edge, where the filter rings before it fails. Below the
// ceiling nothing changes; above it the resonant body stops rising while the
// thump's own oscillator keeps the pitch that was set.
function svf_f_max(q) ( 0.9 * 4 / (sqrt(q * q + 4) + q); );
s1_f_max_near = svf_f_max(s1_res_q_near);
s2_f_max_near = svf_f_max(s2_res_q_near);
s1_f_max_far  = svf_f_max(s1_res_q_far);
s2_f_max_far  = svf_f_max(s2_res_q_far);

noise_seed = 12345;
noise_seed2 = 67890;

// Start Delay state.
// (last_play_state removed in v2.10 Path A — no transport-edge handler
// anymore; @init re-running on play is the reset.)
start_delay_elapsed = 0;
start_delay_sec     = 0;

// Play/Rest gate state. pr_beat counts heartbeats elapsed in the
// current play (or rest) period; threshold compare flips the period
// at each phase wrap. Init to 1 because @init's s1_active=1 already
// starts the first heartbeat firing — that pre-fire is beat 1 of
// the first play period, so the first phase wrap is beat 2.
pr_resting     = 0;
pr_beat        = 1;
play_for_beats = 0;
rest_for_beats = 0;
pr_enabled     = 0;

// Speed ramp + BPM smoother state.
// rate_smoother_coeff eases bpm_smoothed toward bpm_target with a
// ~100 ms time constant — short enough to feel responsive on manual
// tweaks, long enough to bury any per-sample discontinuity.
// Speed Ramp's BPM offset is ADDED to bpm_smoothed in @sample (not
// multiplied) so it composes additively with drift. Seeded from the
// current BPM slider so the first beat after transport-start isn't
// smoothed from a stale default.
rate_smoother_coeff      = 1.0 - exp(-1.0 / (srate * 0.1));
bpm_target               = slider1;
// host_mult is GONE. It used to turn slider1's own unit into BPM -- 1 in Own BPM
// mode, the project tempo in Host x, where slider1 was a multiplier. R13-revised
// made slider1 beats per cycle, so the relationship is a DIVISION and is done
// inline where bpm_target is computed. Nothing else read it.
bpm_smoothed             = slider1;
// Speed Ramp state. Per-target memory bank for 4 targets' signed
// `by` amounts (Heart BPM, S1-S2 gap, Breath HRV depth, Random HRV
// depth). Engage is a freeze/resume gate, not an edge; only transport
// play resets ramp_t.
// Engage (global) is a freeze/resume gate; only transport play resets the
// per-target ramp clocks. As of v2.14 the ramp is PER-TARGET: each target has
// its own `by`, duration, start delay, and progress clock (banks below).
// 18 since 2026-09-11, which outgrew the 16-slot stride: every per-target bank
// moved to 32-slot spacing from 8192. The pitch banks at 4464-4559 stay put.
N_SPEED_TARGETS              = 18;
speed_ramp_target_value_mem  = 8192;  // signed `by` per target (CONFIG)

// --- v2.9 Drift target memory banks ---
//
// 4 targets × 8 fields = 32 slots. 16-slot-aligned per array so
// targets can grow up to 16 later without re-laying-out. Speed ramp
// bank uses 4 slots at 4096; drift banks start at 4112.
//
// Targets, in control order since 2026-09-11 (units in brackets):
//   0 Heart rate (BPM)   1 S1-S2 gap (ms)   2 S1 volume, 3 S2 volume (0-1)
//   4 Brightness (0-1)   5 S1 decay, 6 S2 decay (ms)
//   7 S1 pitch, 8 S2 pitch (that thump's pitch mode)
//   9 S1 fine tune, 10 S2 fine tune (that thump's fine tune unit)
//  11 Tuning reference (Hz)   12 Stereo width (ms, never crossing to the other side)
//  13 Breath cycle (s)   14 Breath HRV depth, 15 Random HRV depth (fraction)
//  16 Play for, 17 Rest for (beats)
N_TARGETS = 18;
target_drift_up     = 8224;
target_drift_down   = 8256;
target_drift_per    = 8288;
target_drift_shape  = 8320;
target_drift_phase  = 8352;
target_drift_prev   = 8384;
target_drift_curr   = 8416;
target_drift_offset = 8448;
hb_scratch          = 8928;   // an old save's four, while remapping
// Old four-target index -> new: Heart rate, S1-S2 gap stay; the HRV depths move.
function hb_o2n(o) ( o <= 1 ? o : o + 12; );
// Drift + ramp on one target, in its own unit.
function hb_q(k) ( target_drift_offset[k] + speed_ramp_ramp_t_mem[k] * speed_ramp_target_value_mem[k]; );

// Speed ramp per-target timeline banks (v2.14). duration + start-delay are
// CONFIG (survive transport, restored by @serialize); ramp_t + delay_elapsed
// are RUNTIME (reset every @init / transport play).
speed_ramp_dur_mem           = 8480;  // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 8512;  // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 8544;  // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 8576;  // delay sample counter per target (RUNTIME)

// Drift and Ramp play/rest, per target (2026-09-06). 16-slot-spaced like the
// banks above. play/rest are CONFIG (survive a transport re-init, restored by
// @serialize); accumulator and resting flag are RUNTIME. The per-target banks
// end at 8943 with hb_scratch -- re-derive rather than trusting this comment.
drift_play_mem       = 8608;
drift_rest_mem       = 8640;
sr_play_mem          = 8672;
sr_rest_mem          = 8704;
drift_pr_accum_mem   = 8736;
drift_pr_resting_mem = 8768;
sr_pr_accum_mem      = 8800;
sr_pr_resting_mem    = 8832;

// --- "your turn came round" flags, per target (2026-09-09) ------------------
drift_step_mem       = 8864;   // RUNTIME
target_drift_moves = 8896;   // CONFIG -- 0 with the target, 1 clock

// --- Pitch banks (R22, 2026-09-09) ----------------------------------------
// Targets: 0 = All (writes across), 1 = S1, 2 = S2. Only 1 and 2 hold data;
// All is a writing convenience, the same shape as Breath Generator's.
// FIRST FREE SLOT AFTER THIS BLOCK IS 4560 -- re-derive rather than trusting it.
N_PITCH        = 3;
pitch_note_mem = 4464;   // MIDI note                    (CONFIG)
pitch_val_mem  = 4480;   // the pitch                    (CONFIG)
pitch_mode_mem = 4496;   // 0 Hz, 1 semitones, 2 cents   (CONFIG)
pitch_fine_mem = 4512;   // fine offset                  (CONFIG)
pitch_fmod_mem = 4528;   // fine unit                    (CONFIG)
pui_last       = 4544;   // mirror of the five visible pitch controls (RUNTIME)

function pitch_read_slot(psel) ( psel > 0 ? psel : 1; );
function pitch_write(psel, pbank, pval) (
  psel > 0 ? ( pbank[psel] = pval; ) : ( pbank[1] = pval; pbank[2] = pval; );
);
// WRITE ONLY IF THE CONTROL ACTUALLY MOVED -- what makes parking on All safe.
function pitch_capture(psel, pbank, pval, pslot) (
  pval != pui_last[pslot] ? ( pitch_write(psel, pbank, pval); pui_last[pslot] = pval; );
);
// The VALUE is the pitch. Nothing here is an offset from a note.
// voff and foff are drift + ramp on the pitch and on its fine tune, each in its
// own unit (2026-09-11).
function pitch_to_hz(idx, voff, foff) local(m, v, f, fm, hz) (
  m  = pitch_mode_mem[idx];
  v  = pitch_val_mem[idx] + voff;
  hz = m == 1 ? tuning_ref * pow(2, (v - 69) / 12) :
       m == 2 ? tuning_ref * pow(2, (v / 100 - 69) / 12) :
                v;
  fm = pitch_fmod_mem[idx];
  f  = pitch_fine_mem[idx] + foff;
  hz = fm == 1 ? hz * pow(2, f / 12) :
       fm == 2 ? hz * pow(2, f / 1200) :
                 hz + f;
  min(max(hz, 1), 20000);
);
tuning_ref        = 440;
pitch_ui_inited   = 0;
last_pitch_target = 0;

// WHICH TARGETS STEP, AND WHICH FLOW. Same rule as Womb, whose heart this one
// is a sibling of.
//
//   0 Heart rate      STEPPED. Its period counts heartbeats and it is what
//                     changes a heartbeat's length, so continuously it was
//                     measuring itself with a ruler it was stretching. A real
//                     heart settles a beat's length when the beat starts.
//   1 S1-S2 gap       STEPPED. Read once per beat, at the S2 trigger.
//  14 Breath HRV depth   continuous -- applied to the cycle length every sample.
//  15 Random HRV depth   continuous -- likewise.
//   Everything added 2026-09-11 is continuous too, and defaults to `On a clock`;
//   set to `With the target`, any of them steps once per heartbeat.
function drift_is_stepped(idx) ( target_drift_moves[idx] == 0; );

// Shared play/rest gate, byte-identical to the one in Melody, the Sweeping
// Filter, Tremolo, Phaser, Bubbler, Dapple, Resonance Bank and the Morpher.
// `tick` is how much of one play/rest unit passes per sample, so the caller owns
// the unit and this stays unitless. Returns 1 while the target is resting.
function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

// CONFIG banks (drift up/down/period/shape + the Speed Ramp by/duration/
// start-delay banks + selector trackers) — initialized ONCE per instance,
// guarded by drift_cfg_inited so the @init re-run on every transport play
// (Path A render fix, no ext_noinit) does NOT wipe the user's setup.
// @serialize below restores saved configs on project reload.
drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_SPEED_TARGETS,
    speed_ramp_target_value_mem[i] = 0;
    drift_play_mem[i] = 0; drift_rest_mem[i] = 0;
    sr_play_mem[i]    = 0; sr_rest_mem[i]    = 0;
    speed_ramp_dur_mem[i]          = 0;
    speed_ramp_delay_mem[i]        = 0;
    i += 1;
  );
  last_speed_target = 0;
  i = 0;
  loop(N_TARGETS,
    target_drift_up[i]    = 0;
    target_drift_down[i]  = 0;
    target_drift_per[i]   = 8;
    target_drift_shape[i] = 0;
    target_drift_moves[i] = (i < 2) ? 0 : 1;
    i += 1;
  );
  last_target_select = 0;

  // The two thump frequencies this plugin has always had, said as pitches now.
  pitch_val_mem[0] = 45;  pitch_note_mem[0] = 34;
  pitch_val_mem[1] = 45;  pitch_note_mem[1] = 34;
  pitch_val_mem[2] = 120; pitch_note_mem[2] = 51;
  i = 0;
  loop(N_PITCH,
    pitch_mode_mem[i] = 0;
    pitch_fine_mem[i] = 0;
    pitch_fmod_mem[i] = 2;   // matches slider14's declared default
    i += 1;
  );
  last_pitch_target = 0;
  drift_cfg_inited = 1;
);

// Drift + speed-ramp RUNTIME (phase / random-shape targets / computed offset /
// ramp clocks) resets on EVERY @init — i.e. every transport play.
i = 0;
loop(N_SPEED_TARGETS,
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  drift_pr_accum_mem[i] = 0; drift_pr_resting_mem[i] = 0;
  sr_pr_accum_mem[i]    = 0; sr_pr_resting_mem[i]    = 0;
  i += 1;
);
i = 0;
loop(N_TARGETS,
  target_drift_phase[i]  = 0;
  target_drift_prev[i]   = 0;
  target_drift_curr[i]   = 0;
  target_drift_offset[i] = 0;
  drift_step_mem[i]      = 0;
  i += 1;
);

@slider
// bpm_target feeds the per-sample smoother; cycle_len_base is now
// recomputed each sample in @sample from the smoothed, speed-scaled
// value, so we don't compute it here anymore.
rate_mode  = slider2;
// RETIRED (R13-revised). Guard forced to 0 rather than the block deleted, so the
// reasoning stays beside the code it disabled. There is no multiplier left for a
// picker to translate, and a picker that WRITES a value is the shape that
// stamped 0.5 over a hand-set rate on every load in infantile.RPP.
0 ? (
  host_ratio_sel = slider40;
  host_ratio_sel > 0 ? (
    slider1 =
      host_ratio_sel ==  1 ? 0.125 : host_ratio_sel ==  2 ? 0.25  :
      host_ratio_sel ==  3 ? 1/3   : host_ratio_sel ==  4 ? 0.5   :
      host_ratio_sel ==  5 ? 0.618 : host_ratio_sel ==  6 ? 2/3   :
      host_ratio_sel ==  7 ? 0.75  : host_ratio_sel ==  8 ? 1     :
      host_ratio_sel ==  9 ? 4/3   : host_ratio_sel == 10 ? 1.5   :
      host_ratio_sel == 11 ? 1.618 : host_ratio_sel == 12 ? 2     :
      host_ratio_sel == 13 ? 3     : host_ratio_sel == 14 ? 4     : 8;
    slider_automate(slider1);
  );
);
slider_show(slider40, 0);
// The LANDING BLOCK is gone (R13-revised step 4). It stamped the picker to
// "1 per beat" and the rate to 1 on entering Host x, because meeting a bare
// MULTIPLIER first was the trap -- 70 as a multiplier is seventy times the
// tempo. Worth noting what that stamp actually did HERE: it wrote 1 into a
// slider whose declared minimum was 20, so REAPER clamped it straight back to
// 20 and you got twenty times the tempo anyway. The cure was as broken as the
// disease, and neither is left.
//
// Nothing is stamped now and the rate slider NEVER HIDES. Hiding it is what
// forced the stamp in the first place.
rate_mode_inited ? last_rate_mode = rate_mode;

// Host x: slider1 is BEATS PER CYCLE. The project runs at `tempo` beats per
// minute, so a heartbeat every N beats is tempo/N beats per minute -- which is
// what bpm_target has always been. cycle_len, the drift period and Start Delay
// all derive from it, so feeding the right number in is the whole job. A pulse
// locked to musical tempo is a deliberate creative option here.
//
// Guarded on the NUMERATOR: 1/max(raw,0.001) would clamp the denominator and
// turn a stopped heart into a thousand-times-tempo one.
bpm_target = rate_mode == 4 ? max(tempo, 0.001) * max(slider1, 0.001) :
             rate_mode == 3 ?
               (slider1 > 0.001 ? max(tempo, 0.001) / slider1 : 0.001) :
             rate_mode == 2 ? slider1 * 60 :
             rate_mode == 1 ? 60 / max(slider1, 0.001) :
               slider1;

// Speed Ramp target selector save/restore (nested-selector pattern). slider32
// = target; slider33 = per-target `by`; slider35 = per-target duration;
// slider39 = per-target start delay (all three per-target as of v2.14).
// slider38 (engage) stays GLOBAL. When the selector changes, save the three
// per-target sliders to the OLD slot, load the NEW slot's values. Otherwise
// capture live edits. All targets ramp in parallel, each on its own clock.
sel_speed_target = slider32;
last_speed_target != sel_speed_target ? (
  speed_ramp_target_value_mem[last_speed_target] = slider33;
  speed_ramp_dur_mem[last_speed_target]          = slider35;
  speed_ramp_delay_mem[last_speed_target]        = slider39;
  sr_play_mem[last_speed_target]                 = slider36;
  sr_rest_mem[last_speed_target]                 = slider37;
  slider33 = speed_ramp_target_value_mem[sel_speed_target];
  slider35 = speed_ramp_dur_mem[sel_speed_target];
  slider39 = speed_ramp_delay_mem[sel_speed_target];
  slider_automate(slider33);
  slider_automate(slider35);
  slider36 = sr_play_mem[sel_speed_target];
  slider37 = sr_rest_mem[sel_speed_target];
  slider_automate(slider39);
  slider_automate(slider36);
  slider_automate(slider37);
  last_speed_target = sel_speed_target;
) : (
  speed_ramp_target_value_mem[sel_speed_target] = slider33;
  speed_ramp_dur_mem[sel_speed_target]          = slider35;
  speed_ramp_delay_mem[sel_speed_target]        = slider39;
  sr_play_mem[sel_speed_target]                 = slider36;
  sr_rest_mem[sel_speed_target]                 = slider37;
);
// No engage-edge detection. Engage is a freeze/resume gate handled
// in @sample. Only transport play resets ramp_t.

// Drift target selector save/restore (nested-selector pattern).
// Switching slider23 saves sliders 22-25 into the OLD target's slot,
// then loads the NEW target's stored config into sliders 22-25.
// Otherwise captures live edits to the current target's slot. All 4
// targets drift in parallel from @sample regardless of selection.
sel_target = slider23;
sel_up     = slider24;
sel_down   = slider25;
sel_per    = slider26;
sel_shape  = slider29;
sel_moves  = slider28;
sel_dplay  = slider30;
sel_drest  = slider31;

last_target_select != sel_target ? (
  target_drift_up[last_target_select]    = sel_up;
  target_drift_down[last_target_select]  = sel_down;
  target_drift_per[last_target_select]   = sel_per;
  target_drift_shape[last_target_select] = sel_shape;
  target_drift_moves[last_target_select] = sel_moves;
  drift_play_mem[last_target_select]     = sel_dplay;
  drift_rest_mem[last_target_select]     = sel_drest;

  slider24 = target_drift_up[sel_target];
  slider25 = target_drift_down[sel_target];
  slider26 = target_drift_per[sel_target];
  slider29 = target_drift_shape[sel_target];
  slider28 = target_drift_moves[sel_target];
  slider_automate(slider24);
  slider_automate(slider25);
  slider_automate(slider26);
  slider30 = drift_play_mem[sel_target];
  slider31 = drift_rest_mem[sel_target];
  slider_automate(slider29);
  slider_automate(slider30);
  slider_automate(slider31);

  last_target_select = sel_target;
) : (
  target_drift_up[sel_target]    = sel_up;
  target_drift_down[sel_target]  = sel_down;
  target_drift_per[sel_target]   = sel_per;
  target_drift_shape[sel_target] = sel_shape;
  target_drift_moves[sel_target] = sel_moves;
  drift_play_mem[sel_target]     = sel_dplay;
  drift_rest_mem[sel_target]     = sel_drest;
);

systole_samples = floor(srate * slider3 * 0.001);
s1_vol = slider4;
s2_vol = slider5;
// --- Pitch: selector, note binding, capture -------------------------------
tuning_ref = slider15;
pitch_ui_inited ? (
  sel_pitch = slider9;
  last_pitch_target != sel_pitch ? (
    prs = pitch_read_slot(sel_pitch);
    slider10 = pitch_mode_mem[prs];
    slider11 = pitch_note_mem[prs];
    slider12 = pitch_val_mem[prs];
    slider13 = pitch_fine_mem[prs];
    slider14 = pitch_fmod_mem[prs];
    slider_automate(slider10); slider_automate(slider11);
    slider_automate(slider12); slider_automate(slider13);
    slider_automate(slider14);
    // Refresh the mirror to what was just loaded, so the next pass does not
    // read a selector move as five user edits.
    pui_last[0] = slider10; pui_last[1] = slider11; pui_last[2] = slider12;
    pui_last[3] = slider13; pui_last[4] = slider14;
    last_pitch_target = sel_pitch;
  ) : (
    // RECONCILE THE PAIR FIRST, then capture -- the other order banks the stale
    // half. The note name is a REAL control: semitones ARE note positions, so
    // picking C4 and typing 60 say the same thing. The MIRROR says which end
    // moved, so nothing guesses.
    slider10 == 1 ? (
      slider11 != pui_last[1] ? (
        slider12 = slider11;
        slider_automate(slider12);
      ) : slider12 != pui_last[2] ? (
        slider11 = max(0, min(127, floor(slider12 + 0.5)));
        slider_automate(slider11);
      );
    );
    pitch_capture(sel_pitch, pitch_mode_mem, slider10, 0);
    pitch_capture(sel_pitch, pitch_note_mem, slider11, 1);
    pitch_capture(sel_pitch, pitch_val_mem,  slider12, 2);
    pitch_capture(sel_pitch, pitch_fine_mem, slider13, 3);
    pitch_capture(sel_pitch, pitch_fmod_mem, slider14, 4);
  );
);
// The note name is a lie outside Semitones, so it does not appear there.
slider_show(slider11, slider10 == 1);

s1_freq = pitch_to_hz(1, 0, 0);
s2_freq = pitch_to_hz(2, 0, 0);

breath_rate = two_pi / (slider17 * srate);
breath_depth = slider18;
rand_hrv_depth = slider19;

s1_center_near = s1_freq * 1.1;
s2_center_near = s2_freq * 1.15;
s1_center_far = s1_freq * 1.28;
s2_center_far = s2_freq * 1.25;
lp_cutoff_near = 200.0 + slider6 * 250.0;
lp_cutoff_far = 175.0 + slider6 * 220.0;

// Each resonator capped at its stability ceiling (see svf_f_max in @init).
// sin() is also clamped at pi/2: past a quarter of the sample rate it would
// fold back DOWN, so a very high pitch would have sounded low instead.
s1_res_f_near = min(2.0 * sin(min($pi * s1_center_near * srate_inv, $pi / 2)), s1_f_max_near);
s2_res_f_near = min(2.0 * sin(min($pi * s2_center_near * srate_inv, $pi / 2)), s2_f_max_near);
lp_f_near = min(2.0 * sin($pi * lp_cutoff_near * srate_inv), 0.98);
s1_res_f_far = min(2.0 * sin(min($pi * s1_center_far * srate_inv, $pi / 2)), s1_f_max_far);
s2_res_f_far = min(2.0 * sin(min($pi * s2_center_far * srate_inv, $pi / 2)), s2_f_max_far);
lp_f_far = min(2.0 * sin($pi * lp_cutoff_far * srate_inv), 0.98);

s1_decay = exp(-srate_inv / (slider7 * 0.001));
s2_decay = exp(-srate_inv / (slider8 * 0.001));

delay_samples = floor(srate * abs(slider16) * 0.001);
delay_samples = min(delay_samples, delay_buf_size - 1);
new_sign = slider16 >= 0 ? 1 : -1;
new_sign != delay_sign ? (
  s1_res_low_near = 0; s1_res_band_near = 0;
  s2_res_low_near = 0; s2_res_band_near = 0;
  lp_low_near = 0; lp_band_near = 0; lp_low2_near = 0; lp_band2_near = 0;
  s1_res_low_far = 0; s1_res_band_far = 0;
  s2_res_low_far = 0; s2_res_band_far = 0;
  lp_low_far = 0; lp_band_far = 0; lp_low2_far = 0; lp_band2_far = 0;
  memset(0, 0, delay_buf_size);
);
delay_sign = new_sign;

// Start Delay: convert beats to seconds at the current BPM.
start_delay_sec = slider20 * 60 / max(bpm_target, 0.001);

// Play/Rest gate: integer beat counts. Both must be > 0 for the
// gate to engage; 0 in either slider disables.
play_for_beats = slider21;
rest_for_beats = slider22;
pr_enabled     = (play_for_beats > 0 && rest_for_beats > 0);

@block
// ADOPT THE PITCH MIRROR HERE, NOT IN @slider. A tracker adopted in @slider can
// capture a DEFAULT, because @slider may run with declared defaults before a
// project's saved values are applied; the next pass then reads the load itself
// as five user edits. That is the August 2026 Sweeping Filter fault. While the
// flag is 0 the block writes nothing.
!pitch_ui_inited ? (
  pui_last[0] = slider10; pui_last[1] = slider11; pui_last[2] = slider12;
  pui_last[3] = slider13; pui_last[4] = slider14;
  last_pitch_target = slider9;
  pitch_ui_inited = 1;
);
// --- Restore-order guard for the change-detecting controls below -----------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the picker then fires and slider_automate()s
//     its ratio over a rate that was set by hand. @block cannot run before the
//     instance is configured, so adopting here is right whatever order the
//     restore paths ran in. (Proved 2026-08-23: a Sweeping Filter in BPM mode
//     with Host ratio "every 2 beats" had Rate Value stamped to 0.5 on every
//     load and every track duplicate.)
!host_ratio_inited ? ( host_ratio_sel = slider40; host_ratio_inited = 1; );
!rate_mode_inited ? ( last_rate_mode = slider2; rate_mode_inited = 1; );
// Follow the project tempo live in Host x. @slider does not re-run on a
// tempo change, so these repeat here; everything else is per-sample.
rate_mode >= 3 ? (
  bpm_target = rate_mode == 4 ? max(tempo, 0.001) * max(slider1, 0.001)
             : slider1 > 0.001 ? max(tempo, 0.001) / slider1 : 0.001;
  start_delay_sec = slider20 * 60 / max(bpm_target, 0.001);
);

// --- The sound-shaping targets added 2026-09-11 (R24), rebuilt per block from
//     the same formulas @slider uses, with drift and ramp folded in. With both
//     at zero every value here is exactly @slider's. The offsets are from the
//     previous block's samples -- about 11 ms behind, on slow modulators.
//     Also where the thump pitches belong anyway: they derive from the pitch
//     BANKS, which @serialize restores by a path with no order against @slider.
tuning_ref = max(20, min(2000, slider15 + hb_q(11)));
s1_freq = pitch_to_hz(1, hb_q(7), hb_q(9));
s2_freq = pitch_to_hz(2, hb_q(8), hb_q(10));
s1_center_near = s1_freq * 1.1;
s2_center_near = s2_freq * 1.15;
s1_center_far = s1_freq * 1.28;
s2_center_far = s2_freq * 1.25;
hb_bright = max(0, min(1, slider6 + hb_q(4)));
lp_cutoff_near = 200.0 + hb_bright * 250.0;
lp_cutoff_far = 175.0 + hb_bright * 220.0;
s1_res_f_near = min(2.0 * sin(min($pi * s1_center_near * srate_inv, $pi / 2)), s1_f_max_near);
s2_res_f_near = min(2.0 * sin(min($pi * s2_center_near * srate_inv, $pi / 2)), s2_f_max_near);
lp_f_near = min(2.0 * sin($pi * lp_cutoff_near * srate_inv), 0.98);
s1_res_f_far = min(2.0 * sin(min($pi * s1_center_far * srate_inv, $pi / 2)), s1_f_max_far);
s2_res_f_far = min(2.0 * sin(min($pi * s2_center_far * srate_inv, $pi / 2)), s2_f_max_far);
lp_f_far = min(2.0 * sin($pi * lp_cutoff_far * srate_inv), 0.98);
s1_decay = exp(-srate_inv / (max(slider7 + hb_q(5), 1) * 0.001));
s2_decay = exp(-srate_inv / (max(slider8 + hb_q(6), 1) * 0.001));
breath_rate = two_pi / (max(slider17 + hb_q(13), 0.001) * srate);
// Stereo width in ms. A drift never carries it across zero: the sign picks
// which side the heart sits on, and crossing it clears the filters and the delay
// line (@slider), which would click on every pass.
hb_w = slider16 + hb_q(12);
hb_w = slider16 >= 0 ? max(hb_w, 0) : min(hb_w, 0);
delay_samples = min(floor(srate * abs(hb_w) * 0.001), delay_buf_size - 1);

@sample

// Smooth BPM toward slider1's target.
bpm_smoothed += (bpm_target - bpm_smoothed) * rate_smoother_coeff;

// Advance each target's own ramp clock (v2.14 per-target timeline). Engage
// (slider38, GLOBAL) is the freeze/resume gate: while On, each target whose
// duration > 0 advances its own ramp_t 0->1 over its own duration, after its
// own start delay; while Off, all clocks freeze and resume. Only transport
// play (via @init) resets them.
slider38 ? (
  // Ramp time unit (slider34). One factor turns the block's time values into
  // seconds, so Duration and Start delay always mean the same as each other.
  // Cycles is one heartbeat at the PRE-drift rate. Beats is 60/project tempo,
  // recomputed per sample so it follows a live tempo change.
  ramp_time_scale =
    slider34 == 3 ? 60 / max(tempo, 0.001) :
    slider34 == 2 ? 60 :
    slider34 == 1 ? 1 :
                    60 / max(bpm_target, 0.001);
  i = 0;
  loop(N_SPEED_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * ramp_time_scale * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        // Staircase: advance for `play`, hold for `rest`, repeat. The holds come
        // OUT of the duration rather than extending it -- the advancing step is
        // scaled by (play+rest)/play -- so Ramp duration goes on meaning "you
        // arrive in about this long".
        sr_pl = sr_play_mem[i];
        sr_rs = sr_rest_mem[i];
        sr_pr_on = sr_pl > 0 && sr_rs > 0;
        sr_hold = pr_frozen(sr_pr_accum_mem, sr_pr_resting_mem, i,
                            1.0 / (ramp_time_scale * srate), sr_pl, sr_rs);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !sr_hold ? (
          sr_step = 1.0 / (srate * speed_ramp_dur_mem[i] * ramp_time_scale);
          sr_pr_on ? sr_step *= (sr_pl + sr_rs) / sr_pl;
          speed_ramp_ramp_t_mem[i] += sr_step;
          speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
        );
      );
    );
    i += 1;
  );
);

// Per-target Speed Ramp offsets (parallel — all 4 ramp regardless of which
// target the selector is currently showing). Each target gets its own
// ramp_t * stored_amount in its native unit.
speed_ramp_heart_offset    = speed_ramp_ramp_t_mem[0] * speed_ramp_target_value_mem[0]; // BPM
speed_ramp_systole_offset  = speed_ramp_ramp_t_mem[1] * speed_ramp_target_value_mem[1]; // ms
speed_ramp_breath_offset   = speed_ramp_ramp_t_mem[14] * speed_ramp_target_value_mem[14]; // HRV depth
speed_ramp_rand_hrv_offset = speed_ramp_ramp_t_mem[15] * speed_ramp_target_value_mem[15]; // HRV depth

// Per-target drift wave computation. Each of 4 targets gets a phase
// counter advancing per sample at rate 1 / (period_heartbeats *
// cycle_len_base_samples). All 4 targets use heartbeats as period
// unit. Drift offset for each target is computed in target-native
// units and stored back into target_drift_offset[i], then consumed
// at the effective-value computations below. The drift loop uses
// cycle_len_base from the PREVIOUS sample (acoustically negligible
// 1-sample lag).
i = 0;
loop(N_TARGETS,
  up    = target_drift_up[i];
  down  = target_drift_down[i];
  per   = target_drift_per[i];
  shape = target_drift_shape[i];

  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    // Drift period unit (slider27). Cycles is one heartbeat, which is exactly
    // what this control counted before the unit existed. Seconds is wall clock.
    // Beats counts the PROJECT tempo.
    period_samples =
      slider27 == 2 ? max(per * 60 / max(tempo, 0.001) * srate, 1) :
      slider27 == 1 ? max(per * srate, 1) :
                      max(per * max(cycle_len_base, 1), 1);

    // Drift play/rest, per target, counted in PERIODS. While resting the phase
    // does not advance at all, so the offset FREEZES where it stopped rather
    // than returning to centre.
    // How much phase this sample is worth. A STEPPED target gets a whole
    // 1/period, but only on the sample its own beat begins; a continuous one
    // gets the usual per-sample slice. Play/rest ticks on the same quantity, so
    // "rest for N periods" keeps meaning the same thing either way.
    // STEPPED targets, 2026-09-10. In the first unit, a whole 1/period on the
    // sample the target's turn comes. In Seconds or Beats the clock runs in that
    // unit ONLY while the target's own thing is happening, and freezes between
    // turns -- Rozaya: "stop mid-cycle, freeze the clock mid-whatever unit, then
    // pick up on the next cycle from wherever the clock was last." So the unit
    // means what it says, and each target still keeps its own time.
    // Both stepped targets are per beat, and the beat cycle runs once the start
    // delay is over, through play/rest silences too.
    drift_is_stepped(i) ? (
      slider27 == 0 ? (
        d_tick = drift_step_mem[i] ? 1.0 / max(per, 0.001) : 0;
      ) : (
        d_run = start_delay_elapsed >= start_delay_sec;
        d_tick = d_run ? 1.0 / period_samples : 0;
      );
      drift_step_mem[i] = 0;
    ) : (
      d_tick = 1.0 / period_samples;
    );

    d_frozen = pr_frozen(drift_pr_accum_mem, drift_pr_resting_mem, i,
                         d_tick,
                         drift_play_mem[i], drift_rest_mem[i]);
    // One-armed pairs: an empty else-branch is a silent compile failure in eel2.
    d_frozen ? ( new_phase = target_drift_phase[i]; );
    !d_frozen ? (
      new_phase = target_drift_phase[i] + d_tick;
      new_phase >= 1.0 ? (
        new_phase -= 1.0;
        shape == 2 ? (
          target_drift_prev[i] = target_drift_curr[i];
          target_drift_curr[i] = rand(2) - 1;
        );
      );
    );
    target_drift_phase[i] = new_phase;

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = target_drift_prev[i] +
        (target_drift_curr[i] - target_drift_prev[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  target_drift_offset[i] = drift_offset_local;
  i += 1;
);

// Effective per-target values: baseline (from slider) + Speed Ramp
// offset + per-target drift offset. These OVERRIDE @slider-set values
// for the per-sample consumption sites.
effective_systole_ms = max(slider3  + speed_ramp_systole_offset  + target_drift_offset[1], 1);
systole_samples      = floor(srate * effective_systole_ms * 0.001);
breath_depth         = max(slider18 + speed_ramp_breath_offset   + target_drift_offset[14], 0);
rand_hrv_depth       = max(slider19 + speed_ramp_rand_hrv_offset + target_drift_offset[15], 0);
// S1 and S2 volume (2, 3), 0-1; Play for and Rest for (16, 17), in beats. Each
// is exactly its slider while drift and ramp leave it alone. The gate still
// switches on only when both SLIDERS are above zero.
s1_vol         = max(0, min(1, slider4 + hb_q(2)));
s2_vol         = max(0, min(1, slider5 + hb_q(3)));
play_for_beats = max(0, slider21 + hb_q(16));
rest_for_beats = max(0, slider22 + hb_q(17));

// Clamp effective BPM at 10 so an over-aggressive Down amount or
// Speed Ramp delta can't drag the heartbeat to a stop or invert it.
// Floor lowered from 10 to 0.01: it existed as a physiological sanity bound,
// but in Host x a small multiplier can legitimately land below it and a
// silent clamp would defeat the mode exactly as rhythm-track's did.
// Drift and Speed Ramp offsets are in the plugin's OWN unit in every mode --
// BPM here, never a multiplier, even in Host x. Tried it the other way and it
// fails on the slider grid: these amount sliders step in 0.1, chosen for BPM,
// and in multiplier terms 0.1 is a 10% wander with nothing finer reachable.
// The value you want stops being settable, which is worse than the
// inconsistency it fixed. Consequence, deliberate and documented: a ramp does
// NOT stretch when the project tempo changes -- -60 stays -60 BPM.
effective_bpm  = max(bpm_smoothed + speed_ramp_heart_offset + target_drift_offset[0], 0.01);
cycle_len_base = floor(srate * 60.0 / effective_bpm);

// (No transport-edge reset here — Path A. REAPER re-runs @init on every
// transport play / render start, which resets all runtime state — state
// machine, oscillators, filters, delay buffer, drift runtime, Speed Ramp,
// Start Delay, Play/Rest, BPM smoother (re-seeded from slider1), noise
// seeds; the CONFIG banks are preserved across those re-runs by the
// drift_cfg_inited guard in @init. See docs/v2.9-render-state-bug.md.)

start_delay_elapsed < start_delay_sec ? (
  start_delay_elapsed += 1 / srate;
  spl0 = 0;
  spl1 = 0;
) : (

breath_phase += breath_rate;
breath_phase > two_pi ? breath_phase -= two_pi;
breath_mod = sin(breath_phase) * breath_depth;

rand_hrv_step += 1;
rand_hrv_step >= rand_hrv_step_len ? (
  rand_hrv_step = 0;
  hrv_seed = (hrv_seed * 1664525 + 1013904223) & 0xFFFFFFFF;
  rand_hrv_target = ((hrv_seed - 0x80000000) * (1.0 / 2147483648.0)) * rand_hrv_depth;
);
rand_hrv += (rand_hrv_target - rand_hrv) * (1.0 - rand_hrv_slew);

cycle_len = floor(cycle_len_base * (1.0 - breath_mod + rand_hrv));
// Cap raised from 200 to 1000 BPM for the same reason.
cycle_len = max(cycle_len, floor(srate * 60.0 / 1000.0));

phase += 1;
phase >= cycle_len ? (
  phase = 0;
  // A new heartbeat begins: the heart rate's turn and the S1-S2 gap's turn.
  // Raised on the CYCLE, not on the audible beat -- the play/rest gate silences
  // beats without stopping the cycle, and drift should follow the cycle.
  drift_step_mem[0] = 1;
  drift_step_mem[1] = 1;
  // ...and every later target's, for any set to step with the heartbeat.
  hb_k = 2; loop(N_TARGETS - 2, drift_step_mem[hb_k] = 1; hb_k += 1;);
  // Per-beat Play/Rest gate. On each new heartbeat, advance the
  // period counter; if it reaches the threshold for the current
  // state, flip play↔rest and reset the counter. Then suppress the
  // S1 trigger (and the matching S2 trigger below) if we're in the
  // rest period. The previous beat's S1/S2 envelopes are still
  // decaying naturally — the gate only stops NEW triggers.
  pr_enabled ? (
    pr_beat >= (pr_resting ? rest_for_beats : play_for_beats) ? (
      pr_resting = 1 - pr_resting;
      pr_beat = 0;
    );
    pr_beat += 1;
  );
  (!pr_enabled || !pr_resting) ? (
    s1_active = 1;
    s1_env = 0.0;
    s1_attack_phase = 1;
  );
);

// S2 fires systole_samples into each cycle — matched to S1 above,
// so it's gated by the same pr_resting state. Within a single cycle
// pr_resting can't change (it only flips on phase wrap), so the S1
// and S2 of any given beat see consistent state.
phase == systole_samples && (!pr_enabled || !pr_resting) ? (
  s2_active = 1;
  s2_env = 0.0;
  s2_attack_phase = 1;
);

// White noise per channel via Park-Miller / MINSTD (see CLAUDE.md gotcha
// "LCG random/noise generators overflow EEL2's 2^53 integer limit"). EEL2
// rounds an LCG multiply once a*seed exceeds 2^53; the old right-channel
// multiplier 22695477 overflowed and degenerated into a periodic tone +
// DC offset on R. Two different multipliers (48271 / 69621) give
// independent streams; seeds must be nonzero in [1, 2^31-2].
noise_seed  = (noise_seed  * 48271) % 2147483647;
n  = noise_seed  * (2.0 / 2147483647.0) - 1.0;
noise_seed2 = (noise_seed2 * 69621) % 2147483647;
n2 = noise_seed2 * (2.0 / 2147483647.0) - 1.0;

s1_active ? (
  s1_attack_phase ? (
    s1_env += (1.0 - s1_env) * (1.0 - s1_attack_rate);
    s1_env >= 0.98 ? s1_attack_phase = 0;
  ) : (
    s1_env *= s1_decay;
    s1_env < 0.0001 ? s1_active = 0;
  );
) : 0;

s2_active ? (
  s2_attack_phase ? (
    s2_env += (1.0 - s2_env) * (1.0 - s2_attack_rate);
    s2_env >= 0.98 ? s2_attack_phase = 0;
  ) : (
    s2_env *= s2_decay;
    s2_env < 0.0001 ? s2_active = 0;
  );
) : 0;

s1_phase_osc_near += two_pi * s1_freq * srate_inv;
s1_phase_osc_near > two_pi ? s1_phase_osc_near -= two_pi;
s2_phase_osc_near += two_pi * s2_freq * srate_inv;
s2_phase_osc_near > two_pi ? s2_phase_osc_near -= two_pi;
s1_phase_osc_far += two_pi * (s1_freq * 1.003) * srate_inv;
s1_phase_osc_far > two_pi ? s1_phase_osc_far -= two_pi;
s2_phase_osc_far += two_pi * (s2_freq * 0.997) * srate_inv;
s2_phase_osc_far > two_pi ? s2_phase_osc_far -= two_pi;

s1_active ? (
  s1_res_low_near += s1_res_f_near * s1_res_band_near;
  s1_res_high_near = (sin(s1_phase_osc_near)*0.8 + n*0.2) - s1_res_low_near - s1_res_q_near * s1_res_band_near;
  s1_res_band_near += s1_res_f_near * s1_res_high_near;
  s1_out_near = s1_res_band_near * s1_env * s1_env * 2.0 * s1_vol;
) : s1_out_near = 0;

s2_active ? (
  s2_res_low_near += s2_res_f_near * s2_res_band_near;
  s2_res_high_near = (sin(s2_phase_osc_near)*0.5 + n*0.5) - s2_res_low_near - s2_res_q_near * s2_res_band_near;
  s2_res_band_near += s2_res_f_near * s2_res_high_near;
  s2_out_near = s2_res_band_near * s2_env * s2_env * s2_vol;
) : s2_out_near = 0;

raw_near = s1_out_near + s2_out_near;
lp_low_near += lp_f_near * lp_band_near;
lp_high_near = raw_near - lp_low_near - lp_q * lp_band_near;
lp_band_near += lp_f_near * lp_high_near;
lp_low2_near += lp_f_near * lp_band2_near;
lp_high2_near = lp_low_near - lp_low2_near - lp_q * lp_band2_near;
lp_band2_near += lp_f_near * lp_high2_near;
heart_near = lp_low2_near * 1.5;

s1_active ? (
  s1_res_low_far += s1_res_f_far * s1_res_band_far;
  s1_res_high_far = (sin(s1_phase_osc_far)*0.8 + n2*0.2) - s1_res_low_far - s1_res_q_far * s1_res_band_far;
  s1_res_band_far += s1_res_f_far * s1_res_high_far;
  s1_out_far = s1_res_band_far * s1_env * s1_env * 2.0 * s1_vol;
) : s1_out_far = 0;

s2_active ? (
  s2_res_low_far += s2_res_f_far * s2_res_band_far;
  s2_res_high_far = (sin(s2_phase_osc_far)*0.5 + n2*0.5) - s2_res_low_far - s2_res_q_far * s2_res_band_far;
  s2_res_band_far += s2_res_f_far * s2_res_high_far;
  s2_out_far = s2_res_band_far * s2_env * s2_env * s2_vol;
) : s2_out_far = 0;

raw_far = s1_out_far + s2_out_far;
lp_low_far += lp_f_far * lp_band_far;
lp_high_far = raw_far - lp_low_far - lp_q * lp_band_far;
lp_band_far += lp_f_far * lp_high_far;
lp_low2_far += lp_f_far * lp_band2_far;
lp_high2_far = lp_low_far - lp_low2_far - lp_q * lp_band2_far;
lp_band2_far += lp_f_far * lp_high2_far;
heart_far_now = lp_low2_far * 1.5;

delay_write_pos = delay_write & (delay_buf_size - 1);
delay_read_pos = (delay_write - delay_samples) & (delay_buf_size - 1);
delay_write_pos[0] = heart_far_now;
heart_far = delay_read_pos[0];
delay_write = (delay_write + 1) & (delay_buf_size - 1);

delay_sign == 1 ? (
  spl0 = heart_near;
  spl1 = heart_far;
) : (
  spl0 = heart_far;
  spl1 = heart_near;
);

);  // close start-delay else branch

@serialize
// Persist per-target Speed Ramp (by / duration / start-delay) + drift configs
// so reload restores all targets, not just whichever was selected at save.
//
// VERSION-GUARDED (CLAUDE.md @serialize gotcha; NEW in v2.14 — heartbeat's
// stream was previously unversioned). Magic = 2100000 + N_TARGETS marks the
// per-target-timeline format (added the duration + start-delay banks). Older
// (unversioned) blobs won't match and fall through to @init defaults — drift +
// ramp reset on upgrade (accepted; pre-release). Marker is float32-exact.
// 2026-09-06: four per-target banks added (Drift play/rest, Ramp play/rest), so
// the magic bumps and the READ accepts BOTH. A bump rather than a bare append,
// because appending would let an older blob's trailing bytes land in the new
// banks -- "migrate what was RESTORED, never what was DEFAULTED". Gated on
// "this blob HAS the field", so an older blob keeps its Drift and Ramp config
// and leaves the new banks at @init's zeros, which is off.
// 2500018 since 2026-09-11: eighteen targets in control order. A four-target save
// (2400004 back to 2100004) is read at its own width, then remapped through
// hb_o2n, both remembered selectors with it. Only what the blob HELD is remapped:
// play/rest and Drift movement stay at @init's defaults where it never stored them.
function hb_remap(bank, dflt) local(k) (
  k = 0; loop(4, hb_scratch[k] = bank[k]; k += 1;);
  k = 0; loop(N_TARGETS, bank[k] = dflt; k += 1;);
  k = 0; loop(4, bank[hb_o2n(k)] = hb_scratch[k]; k += 1;);
);
sr_magic = 2500000 + N_TARGETS;
file_var(0, sr_magic);
hb_is_new = sr_magic == 2500000 + N_TARGETS;
hb_is_old = sr_magic == 2400004 || sr_magic == 2300004 || sr_magic == 2200004 || sr_magic == 2100004;
hb_n = hb_is_new ? N_TARGETS : 4;
(hb_is_new || hb_is_old) ? (
  file_mem(0, speed_ramp_target_value_mem, hb_n);
  file_mem(0, speed_ramp_dur_mem,          hb_n);
  file_mem(0, speed_ramp_delay_mem,        hb_n);
  file_var(0, last_speed_target);
  file_mem(0, target_drift_up,    hb_n);
  file_mem(0, target_drift_down,  hb_n);
  file_mem(0, target_drift_per,   hb_n);
  file_mem(0, target_drift_shape, hb_n);
  file_var(0, last_target_select);
  sr_magic >= 2200000 ? (
    file_mem(0, drift_play_mem, hb_n);
    file_mem(0, drift_rest_mem, hb_n);
    file_mem(0, sr_play_mem,    hb_n);
    file_mem(0, sr_rest_mem,    hb_n);
  );

  // Drift movement, per target -- LAST in the stream, so appending it to an
  // existing blob is a pure append. An older blob has no such field and keeps
  // @init's defaults, which are exactly the behaviour it was written under.
  sr_magic >= 2300000 ? ( file_mem(0, target_drift_moves, hb_n); );

  hb_is_old ? (
    hb_remap(speed_ramp_target_value_mem, 0); hb_remap(speed_ramp_dur_mem, 0);
    hb_remap(speed_ramp_delay_mem, 0);
    hb_remap(target_drift_up, 0);   hb_remap(target_drift_down, 0);
    hb_remap(target_drift_per, 8);  hb_remap(target_drift_shape, 0);
    sr_magic >= 2200000 ? (
      hb_remap(drift_play_mem, 0);  hb_remap(drift_rest_mem, 0);
      hb_remap(sr_play_mem, 0);     hb_remap(sr_rest_mem, 0);
    );
    sr_magic >= 2300000 ? hb_remap(target_drift_moves, 1);
    last_speed_target  = hb_o2n(max(0, min(3, last_speed_target | 0)));
    last_target_select = hb_o2n(max(0, min(3, last_target_select | 0)));
  );

  // The pitch banks, LAST in the stream so adding them is a pure append. An
  // older blob has none and keeps @init's 45 Hz and 120 Hz, which is exactly
  // what it was written under.
  sr_magic >= 2400000 ? (
    file_mem(0, pitch_note_mem, N_PITCH);
    file_mem(0, pitch_val_mem,  N_PITCH);
    file_mem(0, pitch_mode_mem, N_PITCH);
    file_mem(0, pitch_fine_mem, N_PITCH);
    file_mem(0, pitch_fmod_mem, N_PITCH);
    file_var(0, last_pitch_target);
  );

  // TRACK-DUPLICATE FIX (v2.14). On READ (load/duplicate) file_avail(0) >= 0;
  // on WRITE (save/undo) it is < 0. @serialize is the only section guaranteed
  // to run on both load AND duplicate, so it re-establishes the bank<->slider
  // invariant: force the visible config sliders to match the restored bank for
  // the restored selectors, correcting any transient @slider clobber (which
  // would otherwise zero whichever target was selected on the copy).
  file_avail(0) >= 0 ? (
    slider36 = sr_play_mem[last_speed_target];           // Ramp play for
    slider37 = sr_rest_mem[last_speed_target];           // Ramp rest for
    slider30 = drift_play_mem[last_target_select];       // Drift play for
    slider31 = drift_rest_mem[last_target_select];       // Drift rest for
    slider33 = speed_ramp_target_value_mem[last_speed_target]; // Ramp `by`
    slider35 = speed_ramp_dur_mem[last_speed_target];          // Speed ramp duration
    slider39 = speed_ramp_delay_mem[last_speed_target];        // Speed ramp start delay
    slider24 = target_drift_up[last_target_select];            // Drift up
    slider25 = target_drift_down[last_target_select];          // Drift down
    slider26 = target_drift_per[last_target_select];           // Drift period
    slider29 = target_drift_shape[last_target_select];         // Drift shape
    // The pitch block is backed by live sliders too, so it needs the same
    // treatment. `All` reads back from S1.
    slider9  = last_pitch_target;
    prs = pitch_read_slot(last_pitch_target);
    slider10 = pitch_mode_mem[prs];
    slider11 = pitch_note_mem[prs];
    slider12 = pitch_val_mem[prs];
    slider13 = pitch_fine_mem[prs];
    slider14 = pitch_fmod_mem[prs];
    slider28 = target_drift_moves[last_target_select];
    // The selectors themselves, so a remapped old save shows the target it had.
    slider23 = last_target_select;
    slider32 = last_speed_target;
    sliderchange(-1);
  );
);
