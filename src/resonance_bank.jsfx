desc: Resonance Bank
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/
//
// 16 parallel bandpass filters (or serial peaking EQ filters) with
// per-band drift wander on any combination of parameters, stereo
// processing, asymmetric width control, and cascade-order rolloff.
//
// === Two modes ===
//
// Parallel bandpass: each band selects its frequency range out of
// the input; slices are summed.
//
// Serial peaking EQ: each band emphasizes or cuts its center on
// the running signal.
//
// === Selector pattern ===
//
// Only one band's parameters are visible at a time. The Band
// selector picks which band to edit; per-band sliders snap to
// that band's stored values. All 16 bands run simultaneously.
//
// === Multi-target drift (nested selector pattern) ===
//
// Each band can have up to 5 simultaneous drifts, one per
// possible target (Frequency, Width up, Width down, Gain, Pan).
// The Drift target slider picks which target you're currently
// editing — the drift up/down/period/mode/shape sliders snap to
// THAT target's stored values. Configure them, they're saved to
// that target. Change Drift target → previous target's drift
// keeps running; sliders now show the new target's stored values.
//
// All configured drifts on a band run together. So a single band
// can have its frequency wandering, gain pulsing, and pan
// sweeping simultaneously, each at its own rate.
//
// === Order (parallel mode only) ===
//
//   Order 1: -6 dB/oct rolloff
//   Order 2: -12 dB/oct
//   Order 4: -24 dB/oct
//   Order 8: -48 dB/oct (near brick-wall)

slider1:0.0<-24.0,24.0,0.01>Input gain (dB)

slider3:0<0,15,1>Band selector (0-15)

slider4:500<0,20000,1>Frequency (Hz)
slider5:250<1,5000,1>Width up (Hz above center)
slider6:250<1,5000,1>Width down (Hz below center)
slider7:-60<-60,24,0.01>Gain (dB; -60 = off)
slider8:0<-1,1,0.01>Pan (-1=L, 0=center, +1=R)
slider9:0<0,3,1{1 (-6 dB/oct),2 (-12 dB/oct),4 (-24 dB/oct),8 (-48 dB/oct)}>Order (parallel mode only)
slider12:0<0,4,1{Frequency,Width up,Width down,Gain,Pan}>Drift target
slider13:0<0,1000,0.01>Drift up amount (units match target)
slider14:0<0,1000,0.01>Drift down amount (units match target)
slider15:0<0,1000,0.001>Drift period (BPM / sec / Hz / beats per cycle by mode; 0 = off)
// NOTE the ordering here is {BPM,Hz,Seconds} -- a THIRD variant. Melody Phase
// and Polyrhythm use {BPM,Seconds,Hz}; Tremolo and the sweeping filter use
// {Hz,Seconds,BPM}. Seconds is index 2 here, not 1. Any code copied between
// plugins that special-cases "the Seconds branch" by index will be WRONG here
// -- that mistake put Start Delay 60x out in two plugins already. The
// conversions below are correct for THIS ordering; leave them keyed by name.
//
// Host x appends at index 3, and there Drift period means BEATS PER CYCLE --
// 4 is one full wander every four beats (R13-revised, 2026-09-02). It used to
// be a MULTIPLIER of the tempo, which is a number you cannot hear without doing
// arithmetic against the project tempo first.
//
// No ratio picker on this one, and there never was: the period is a PER-BAND
// value living behind the drift selector, not a headline rate, so a picker
// writing into the visible slider would fight the selector's own save/restore
// (see the nested-selector note in CLAUDE.md). That accident of design means
// this plugin skips steps 3 and 4 of the R13-revised recipe entirely -- there
// is no picker to retire and no landing block to delete.
slider16:1<0,3,1{BPM,Seconds,Hz,Host x}>Drift period mode
slider17:0<0,2,1{Sine,Triangle,Random}>Drift shape
// --- Drift play/rest, and the Ramp block ---------------------------------
// Added 2026-09-05. Rozaya spotted the gap: this plugin had Drift but not the
// play/rest that goes with it, and no Ramp at all. "Anything that has Ramp
// should have all the controls that go with Ramp."
//
// Both are stored PER (band, target), the same 16x5 shape the drift config
// already uses -- so band 3's ramp on Frequency is a different setting from
// band 4's, and switching either selector edits one without stopping the other.
slider18:0<0,64,0.01>Drift play for (periods, 0 = always)
slider19:0<0,64,0.01>Drift rest for (periods, 0 = always)

slider20:0<0,4,1{Frequency,Width up,Width down,Gain,Pan}>Ramp target
slider21:0<-1000,1000,0.001>Ramp by (units match target)
slider22:0<0,1,1{Minutes,Beats}>Ramp time unit
slider23:0<0,1000,0.01>Ramp duration
slider24:0<0,1000,0.01>Ramp play for (0 = smooth)
slider25:0<0,1000,0.01>Ramp rest for (0 = smooth)
slider26:0<0,1,1{Off,On}>Ramp engage
slider27:0<0,1000,0.01>Ramp start delay

slider2:0<0,1,1{Parallel bandpass,Serial peaking EQ}>Mode
slider10:0.5<0,1,0.01>Wet/dry mix
slider11:0.5<0,1,0.01>Output volume

@init
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: REAPER re-runs @init on every transport play / render
// start, which resets all RUNTIME for free (SVF/biquad filter state +
// per-band drift phase). Only the 16-band CONFIG (per-band params + per-
// (band,target) drift config) must survive the re-run — guarded by
// cfg_inited below. ext_noinit used to be load-bearing here because the
// nested selector keeps 15 of 16 bands only in memory (not on sliders);
// the guard replaces that protection without freezing runtime on render.

srate_inv = 1.0 / srate;
pi_srate  = $pi * srate_inv;
two_pi    = 2.0 * $pi;

N_BANDS    = 16;
N_TARGETS  = 5;
MAX_ORDER  = 8;

// === Per-band parameter memory banks (16 slots each) ===
band_freq              = 0;
band_gain              = 16;
band_width_up          = 32;
band_width_down        = 48;
band_pan               = 64;
band_order_idx         = 80;
band_last_drift_target = 96;

// === Per-(band, target) drift configuration banks (80 slots each) ===
// Indexing: band * N_TARGETS + target
band_drift_up    = 112;
band_drift_down  = 192;
band_drift_per   = 272;
band_drift_mode  = 352;
band_drift_shape = 432;

// === Per-(band, target) drift runtime state (80 slots each) ===
band_drift_phase = 512;
band_rand_old    = 592;
band_rand_new    = 672;

// --- Drift play/rest and the whole Ramp block, added 2026-09-05. Same 16x5
//     (band, target) shape the drift config already uses. band_rand_new ends at
//     751, so these start at 752 and the first free slot is 1808 -- re-derive
//     rather than trusting that number.
band_drift_play      = 752;    // CONFIG   periods; 0 = gate off
band_drift_rest      = 832;    // CONFIG
band_drift_pr_rest   = 912;    // RUNTIME  1 = frozen
band_drift_pr_accum  = 992;    // RUNTIME  fractional period while frozen
band_ramp_by         = 1072;   // CONFIG   signed delta in the target's unit
band_ramp_dur        = 1152;   // CONFIG
band_ramp_delay      = 1232;   // CONFIG
band_ramp_play       = 1312;   // CONFIG
band_ramp_rest       = 1392;   // CONFIG
band_ramp_t          = 1472;   // RUNTIME  progress 0..1
band_ramp_elapsed    = 1552;   // RUNTIME  start-delay sample counter
band_ramp_pr_rest    = 1632;   // RUNTIME
band_ramp_pr_accum   = 1712;   // RUNTIME
band_last_ramp_target = 1792;  // CONFIG   per BAND (16), not per slot

// === Parallel SVF cascade state ===
band_svf_L = 768;   // 16 bands * 8 stages * 2 vars = 256 floats
band_svf_R = 1024;  // same shape for R

// === Serial peaking biquad state ===
band_bq_x1_L = 1280;
band_bq_x2_L = 1296;
band_bq_y1_L = 1312;
band_bq_y2_L = 1328;
band_bq_x1_R = 1344;
band_bq_x2_R = 1360;
band_bq_y1_R = 1376;
band_bq_y2_R = 1392;

// CONFIG banks (per-band params + per-(band,target) drift config) —
// initialized ONCE per instance, guarded by cfg_inited so the @init
// re-run on every transport play does NOT wipe the user's 16-band setup.
// @serialize restores saved configs on project load.
cfg_inited != 1 ? (
  i = 0;
  loop(N_BANDS,
    band_freq[i]              = 500;
    band_gain[i]              = -60;
    band_width_up[i]          = 250;
    band_width_down[i]        = 250;
    band_pan[i]               = 0;
    band_order_idx[i]         = 0;
    band_last_drift_target[i] = 0;
    t = 0;
    loop(N_TARGETS,
      slot = i * N_TARGETS + t;
      band_drift_up[slot]    = 0;
      band_drift_down[slot]  = 0;
      band_drift_per[slot]   = 0;
      band_drift_mode[slot]  = 2;
      band_drift_shape[slot] = 0;
      t += 1;
    );
    i += 1;
  );
  last_band_select         = -1;
  last_drift_target_select = -1;
  cfg_inited = 1;
);

// RUNTIME — resets on EVERY @init (every transport play / render start)
// so renders and alt-tab resume start fresh: per-(band,target) drift
// phase + random-shape state, and SVF/biquad filter state per band. Drift
// phase is randomized per slot so the bands don't all crest together
// (matches the original load-time seeding).
i = 0;
loop(N_BANDS,
  t = 0;
  loop(N_TARGETS,
    slot = i * N_TARGETS + t;
    band_drift_phase[slot] = rand(1);
    band_rand_old[slot]    = rand(2) - 1;
    band_rand_new[slot]    = rand(2) - 1;
    t += 1;
  );
  j = 0;
  loop(MAX_ORDER * 2,
    band_svf_L[i * MAX_ORDER * 2 + j] = 0;
    band_svf_R[i * MAX_ORDER * 2 + j] = 0;
    j += 1;
  );
  band_bq_x1_L[i] = 0;
  band_bq_x2_L[i] = 0;
  band_bq_y1_L[i] = 0;
  band_bq_y2_L[i] = 0;
  band_bq_x1_R[i] = 0;
  band_bq_x2_R[i] = 0;
  band_bq_y1_R[i] = 0;
  band_bq_y2_R[i] = 0;
  i += 1;
);

// Shared play/rest window counter, same one Veil and the Phaser use. `tick` is
// how much of ONE window passes per sample, which lets each caller keep its own
// units: Drift passes 1/period_samples so its windows are drift periods; Ramp
// passes 1/(unit_seconds*srate) so its windows are minutes or beats. Off unless
// BOTH values are > 0.
function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

// New banks. The CONFIG half is guarded so a transport re-run of @init cannot
// wipe the user's setup; @serialize overwrites them on project reload. The
// RUNTIME half resets every time, which is the convention here.
rb_new_cfg_inited != 1 ? (
  i = 0;
  loop(N_BANDS * N_TARGETS,
    band_drift_play[i] = 0;  band_drift_rest[i] = 0;
    band_ramp_by[i]    = 0;  band_ramp_dur[i]   = 0;
    band_ramp_delay[i] = 0;
    band_ramp_play[i]  = 0;  band_ramp_rest[i]  = 0;
    i += 1;
  );
  i = 0;
  loop(N_BANDS, band_last_ramp_target[i] = 0; i += 1; );
  rb_new_cfg_inited = 1;
);
i = 0;
loop(N_BANDS * N_TARGETS,
  band_drift_pr_rest[i] = 0;   band_drift_pr_accum[i] = 0;
  band_ramp_t[i] = 0;          band_ramp_elapsed[i] = 0;
  band_ramp_pr_rest[i] = 0;    band_ramp_pr_accum[i] = 0;
  i += 1;
);

// Project tempo, absolute -- never a ratio against a remembered reference,
// because @init re-runs on every transport play and would wipe the reference.
host_bpm = max(tempo, 0.001);

@block
// Refreshed once per block; the tempo never changes mid-block. Used by the
// Drift period mode's Host x branch and by the Ramp time unit's Beats setting.
// This plugin had no @block section at all before 2026-09-05.
host_bpm = max(tempo, 0.001);

@slider
in_gain     = 10 ^ (slider1 / 20);
band_select = slider3;

sel_freq         = slider4;
sel_width_up     = slider5;
sel_width_down   = slider6;
sel_gain         = slider7;
sel_pan          = slider8;
sel_order_idx    = slider9;
sel_drift_target = slider12;
sel_drift_up     = slider13;
sel_drift_down   = slider14;
sel_drift_per    = slider15;
sel_drift_mode   = slider16;
sel_drift_shape  = slider17;
sel_drift_play   = slider18;
sel_drift_rest   = slider19;

mode = slider2;
wet  = slider10;
vol  = slider11;

band_changed = last_band_select != band_select;

band_changed ? (
  // Load this band's per-band sliders.
  slider4 = band_freq[band_select];
  slider5 = band_width_up[band_select];
  slider6 = band_width_down[band_select];
  slider7 = band_gain[band_select];
  slider8 = band_pan[band_select];
  slider9 = band_order_idx[band_select];
  slider_automate(slider4);
  slider_automate(slider5);
  slider_automate(slider6);
  slider_automate(slider7);
  slider_automate(slider8);
  slider_automate(slider9);

  // Load this band's last selected drift target.
  saved_target = band_last_drift_target[band_select];
  slider12 = saved_target;
  slider_automate(slider12);
  sel_drift_target = saved_target;

  // Load that target's drift config from (band, target) slot.
  drift_slot = band_select * N_TARGETS + saved_target;
  slider13 = band_drift_up[drift_slot];
  slider14 = band_drift_down[drift_slot];
  slider15 = band_drift_per[drift_slot];
  slider16 = band_drift_mode[drift_slot];
  slider17 = band_drift_shape[drift_slot];
  slider18 = band_drift_play[drift_slot];
  slider19 = band_drift_rest[drift_slot];
  slider_automate(slider18);
  slider_automate(slider19);
  slider_automate(slider13);
  slider_automate(slider14);
  slider_automate(slider15);
  slider_automate(slider16);
  slider_automate(slider17);
) : (
  // Band didn't change. Check if drift target changed.
  drift_target_changed = last_drift_target_select != sel_drift_target;

  drift_target_changed ? (
    // Save current drift sliders to OLD (band, old_target) slot.
    old_slot = band_select * N_TARGETS + last_drift_target_select;
    band_drift_up[old_slot]    = sel_drift_up;
    band_drift_down[old_slot]  = sel_drift_down;
    band_drift_per[old_slot]   = sel_drift_per;
    band_drift_mode[old_slot]  = sel_drift_mode;
    band_drift_shape[old_slot] = sel_drift_shape;
    band_drift_play[old_slot]  = sel_drift_play;
    band_drift_rest[old_slot]  = sel_drift_rest;

    // Update this band's last drift target memory.
    band_last_drift_target[band_select] = sel_drift_target;

    // Load NEW (band, new_target) drift config into sliders.
    new_slot = band_select * N_TARGETS + sel_drift_target;
    slider13 = band_drift_up[new_slot];
    slider14 = band_drift_down[new_slot];
    slider15 = band_drift_per[new_slot];
    slider16 = band_drift_mode[new_slot];
    slider17 = band_drift_shape[new_slot];
    slider18 = band_drift_play[new_slot];
    slider19 = band_drift_rest[new_slot];
    slider_automate(slider18);
    slider_automate(slider19);
    slider_automate(slider13);
    slider_automate(slider14);
    slider_automate(slider15);
    slider_automate(slider16);
    slider_automate(slider17);
  ) : (
    // Neither changed. Save current slider values to their stored
    // locations.
    band_freq[band_select]       = sel_freq;
    band_width_up[band_select]   = sel_width_up;
    band_width_down[band_select] = sel_width_down;
    band_gain[band_select]       = sel_gain;
    band_pan[band_select]        = sel_pan;
    band_order_idx[band_select]  = sel_order_idx;

    drift_slot = band_select * N_TARGETS + sel_drift_target;
    band_drift_up[drift_slot]    = sel_drift_up;
    band_drift_down[drift_slot]  = sel_drift_down;
    band_drift_per[drift_slot]   = sel_drift_per;
    band_drift_mode[drift_slot]  = sel_drift_mode;
    band_drift_shape[drift_slot] = sel_drift_shape;
    band_drift_play[drift_slot]  = sel_drift_play;
    band_drift_rest[drift_slot]  = sel_drift_rest;
  );
);

// --- Ramp target selector, the same nested-selector pattern as Drift and
//     stored per (band, target) exactly like it. Kept as its own block rather
//     than folded into the drift branches above, because Ramp has its OWN
//     target: you can be ramping Frequency on band 3 while drifting its Pan.
//     slider26 (engage) and slider22 (time unit) stay GLOBAL.
sel_ramp_target = slider20;
band_changed ? (
  // New band: adopt whatever ramp target that band was last left on, and load
  // its config. No save here -- the outgoing band's values were written on the
  // pass that set them, in the else-branch below.
  rb_rt = band_last_ramp_target[band_select];
  slider20 = rb_rt;
  slider_automate(slider20);
  sel_ramp_target = rb_rt;
  rslot = band_select * N_TARGETS + rb_rt;
  slider21 = band_ramp_by[rslot];
  slider23 = band_ramp_dur[rslot];
  slider24 = band_ramp_play[rslot];
  slider25 = band_ramp_rest[rslot];
  slider27 = band_ramp_delay[rslot];
  slider_automate(slider21); slider_automate(slider23);
  slider_automate(slider24); slider_automate(slider25);
  slider_automate(slider27);
) : (
  last_ramp_target_select != sel_ramp_target ? (
    rslot = band_select * N_TARGETS + last_ramp_target_select;
    band_ramp_by[rslot]    = slider21;
    band_ramp_dur[rslot]   = slider23;
    band_ramp_play[rslot]  = slider24;
    band_ramp_rest[rslot]  = slider25;
    band_ramp_delay[rslot] = slider27;
    band_last_ramp_target[band_select] = sel_ramp_target;
    rslot = band_select * N_TARGETS + sel_ramp_target;
    slider21 = band_ramp_by[rslot];
    slider23 = band_ramp_dur[rslot];
    slider24 = band_ramp_play[rslot];
    slider25 = band_ramp_rest[rslot];
    slider27 = band_ramp_delay[rslot];
    slider_automate(slider21); slider_automate(slider23);
    slider_automate(slider24); slider_automate(slider25);
    slider_automate(slider27);
  ) : (
    rslot = band_select * N_TARGETS + sel_ramp_target;
    band_ramp_by[rslot]    = slider21;
    band_ramp_dur[rslot]   = slider23;
    band_ramp_play[rslot]  = slider24;
    band_ramp_rest[rslot]  = slider25;
    band_ramp_delay[rslot] = slider27;
    band_last_ramp_target[band_select] = sel_ramp_target;
  );
);

last_band_select         = band_select;
last_drift_target_select = sel_drift_target;
last_ramp_target_select  = sel_ramp_target;

@sample
// --- Ramp clocks, one per (band, target). Engage (slider26) is a freeze/resume
//     gate: while Off, progress HOLDS; only transport play (via @init) resets
//     it. Advanced ONCE per sample here rather than inside the mode branches,
//     because only one of those two branches runs and the clocks must not
//     depend on which.
//     A minute is 60 s, a beat is 60/tempo s, recomputed per sample so a tempo
//     change is followed live in Beats mode.
rb_ramp_scale = slider22 == 1 ? 60 / host_bpm : 60;
slider26 ? (
  rs = 0;
  loop(N_BANDS * N_TARGETS,
    band_ramp_dur[rs] > 0 ? (
      rb_delay_samples = band_ramp_delay[rs] * rb_ramp_scale * srate;
      band_ramp_elapsed[rs] < rb_delay_samples ? (
        band_ramp_elapsed[rs] += 1;
      ) : (
        // Staircase: advance for `play`, hold for `rest`, repeat. The holds come
        // OUT of the duration rather than extending it -- the advancing step is
        // scaled by (play+rest)/play -- so Ramp duration still means "you arrive
        // in about this long".
        rb_pl = band_ramp_play[rs];
        rb_rs = band_ramp_rest[rs];
        rb_on = rb_pl > 0 && rb_rs > 0;
        rb_hold = pr_frozen(band_ramp_pr_accum, band_ramp_pr_rest, rs,
                            1.0 / (rb_ramp_scale * srate), rb_pl, rb_rs);
        !rb_hold ? (
          rb_step = 1.0 / (srate * band_ramp_dur[rs] * rb_ramp_scale);
          rb_on ? rb_step *= (rb_pl + rb_rs) / rb_pl;
          band_ramp_t[rs] += rb_step;
          band_ramp_t[rs] > 1.0 ? band_ramp_t[rs] = 1.0;
        );
      );
    );
    rs += 1;
  );
);

in_L = spl0 * in_gain;
in_R = spl1 * in_gain;

mode == 1 ? (
  // === Serial peaking EQ mode ===
  serial_L = in_L;
  serial_R = in_R;

  i = 0;
  loop(N_BANDS,
    b_freq_base   = band_freq[i];
    b_w_up_base   = band_width_up[i];
    b_w_down_base = band_width_down[i];
    b_gain_base   = band_gain[i];
    b_pan_base    = band_pan[i];

    eff_freq   = b_freq_base;
    eff_w_up   = b_w_up_base;
    eff_w_down = b_w_down_base;
    eff_gain   = b_gain_base;
    eff_pan    = b_pan_base;

    // Loop through all 5 drift slots for this band
    t = 0;
    loop(N_TARGETS,
      slot         = i * N_TARGETS + t;
      d_up         = band_drift_up[slot];
      d_down       = band_drift_down[slot];
      d_per        = band_drift_per[slot];
      d_per_mode   = band_drift_mode[slot];

      // Zeroed before the guard: Ramp applies even when Drift is off, and the
      // two are summed below.
      d_offset = 0;
      d_per > 0 && (d_up > 0 || d_down > 0) ? (
        d_cps = 0;
        // R20 canonical order {BPM, Seconds, Hz, Host x}. Seconds and Hz were
        // the other way round until 2026-09-05; the stored bank is remapped in
        // @serialize for any project saved before that.
        d_per_mode == 0 ? d_cps = d_per / 60;
        d_per_mode == 1 ? d_cps = 1.0 / d_per;
        d_per_mode == 2 ? d_cps = d_per;
        // Host x: d_per is BEATS PER CYCLE. tempo/60 is beats per second, so N
        // beats per cycle is (tempo/60)/N cycles per second. Applied right here,
        // per band, so bands in other modes are untouched. The enclosing guard
        // is `d_per > 0`, so the division cannot meet a zero -- but it is
        // written the safe way anyway, because inverting a unit inverts its edge
        // cases and `1/max(raw,0.001)` clamps the wrong side.
        d_per_mode == 3 ? d_cps = d_per > 0.001 ? max(tempo, 0.001) / 60 / d_per : 0.001;

        // Drift play/rest, per (band, target), counted in PERIODS. While
        // resting the phase does not advance at all, so the offset STAYS where
        // it stopped -- freeze in place, not a return to centre. The FRACTION
        // of the play value chooses where it parks: x.25 crest, x.75 trough,
        // x.0 and x.5 neutral, so a whole number parks at no change every time
        // and is nearly inaudible.
        d_hold = pr_frozen(band_drift_pr_accum, band_drift_pr_rest, slot,
                           d_cps / srate,
                           band_drift_play[slot], band_drift_rest[slot]);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !d_hold ? (
          band_drift_phase[slot] += d_cps / srate;
          band_drift_phase[slot] >= 1.0 ? (
            band_drift_phase[slot] -= 1.0;
            band_drift_shape[slot] == 2 ? (
              band_rand_old[slot] = band_rand_new[slot];
              band_rand_new[slot] = rand(2) - 1;
            );
          );
        );

        d_phi   = band_drift_phase[slot];
        d_shape = band_drift_shape[slot];
        d_mod   = 0;
        d_shape == 0 ? d_mod = sin(two_pi * d_phi);
        d_shape == 1 ? d_mod = 1 - 4 * abs(d_phi - 0.5);
        d_shape == 2 ? d_mod = band_rand_old[slot] + (band_rand_new[slot] - band_rand_old[slot]) * d_phi;

        d_offset = d_mod >= 0 ? d_mod * d_up : d_mod * d_down;
      );

      // Ramp rides OUTSIDE the drift guard, because a ramp with no drift set is
      // an ordinary thing to want. Its progress is advanced once per sample in
      // the ramp clock block above; here it is only read.
      tot_offset = d_offset + band_ramp_t[slot] * band_ramp_by[slot];

      t == 0 ? eff_freq   = eff_freq + tot_offset;
      t == 1 ? eff_w_up   = max(eff_w_up + tot_offset, 1);
      t == 2 ? eff_w_down = max(eff_w_down + tot_offset, 1);
      t == 3 ? eff_gain   = eff_gain + tot_offset;
      t == 4 ? eff_pan    = max(min(eff_pan + tot_offset, 1), -1);

      t += 1;
    );

    eff_gain > -59 ? (
      b_bw       = eff_w_up + eff_w_down;
      eff_center = eff_freq + (eff_w_up - eff_w_down) * 0.5;
      eff_center = max(min(eff_center, srate * 0.45), 1);

      b_Q = max(eff_center / b_bw, 0.1);

      // Gain is now in dB directly. Peaking EQ formula needs A = sqrt(linear_gain) = 10^(dB/40).
      gain_db   = eff_gain;
      A         = 10 ^ (gain_db / 40);
      omega0    = two_pi * eff_center * srate_inv;
      sin_w     = sin(omega0);
      cos_w     = cos(omega0);
      alpha     = sin_w / (2 * b_Q);

      bq_b0 = 1 + alpha * A;
      bq_b1 = -2 * cos_w;
      bq_b2 = 1 - alpha * A;
      bq_a0 = 1 + alpha / A;
      bq_a1 = -2 * cos_w;
      bq_a2 = 1 - alpha / A;

      inv_a0 = 1 / bq_a0;
      b0n    = bq_b0 * inv_a0;
      b1n    = bq_b1 * inv_a0;
      b2n    = bq_b2 * inv_a0;
      a1n    = bq_a1 * inv_a0;
      a2n    = bq_a2 * inv_a0;

      x_in_L  = serial_L;
      out_bq_L = b0n * x_in_L
               + b1n * band_bq_x1_L[i]
               + b2n * band_bq_x2_L[i]
               - a1n * band_bq_y1_L[i]
               - a2n * band_bq_y2_L[i];
      band_bq_x2_L[i] = band_bq_x1_L[i];
      band_bq_x1_L[i] = x_in_L;
      band_bq_y2_L[i] = band_bq_y1_L[i];
      band_bq_y1_L[i] = out_bq_L;
      serial_L        = out_bq_L;

      x_in_R  = serial_R;
      out_bq_R = b0n * x_in_R
               + b1n * band_bq_x1_R[i]
               + b2n * band_bq_x2_R[i]
               - a1n * band_bq_y1_R[i]
               - a2n * band_bq_y2_R[i];
      band_bq_x2_R[i] = band_bq_x1_R[i];
      band_bq_x1_R[i] = x_in_R;
      band_bq_y2_R[i] = band_bq_y1_R[i];
      band_bq_y1_R[i] = out_bq_R;
      serial_R        = out_bq_R;
    );
    i += 1;
  );

  wet_L = serial_L;
  wet_R = serial_R;
) : (
  // === Parallel bandpass mode with cascade ===
  wet_L = 0;
  wet_R = 0;

  i = 0;
  loop(N_BANDS,
    b_freq_base   = band_freq[i];
    b_w_up_base   = band_width_up[i];
    b_w_down_base = band_width_down[i];
    b_gain_base   = band_gain[i];
    b_pan_base    = band_pan[i];

    eff_freq   = b_freq_base;
    eff_w_up   = b_w_up_base;
    eff_w_down = b_w_down_base;
    eff_gain   = b_gain_base;
    eff_pan    = b_pan_base;

    t = 0;
    loop(N_TARGETS,
      slot         = i * N_TARGETS + t;
      d_up         = band_drift_up[slot];
      d_down       = band_drift_down[slot];
      d_per        = band_drift_per[slot];
      d_per_mode   = band_drift_mode[slot];

      // Zeroed before the guard: Ramp applies even when Drift is off, and the
      // two are summed below.
      d_offset = 0;
      d_per > 0 && (d_up > 0 || d_down > 0) ? (
        d_cps = 0;
        // R20 canonical order {BPM, Seconds, Hz, Host x}. Seconds and Hz were
        // the other way round until 2026-09-05; the stored bank is remapped in
        // @serialize for any project saved before that.
        d_per_mode == 0 ? d_cps = d_per / 60;
        d_per_mode == 1 ? d_cps = 1.0 / d_per;
        d_per_mode == 2 ? d_cps = d_per;
        // Host x: d_per is BEATS PER CYCLE. tempo/60 is beats per second, so N
        // beats per cycle is (tempo/60)/N cycles per second. Applied right here,
        // per band, so bands in other modes are untouched. The enclosing guard
        // is `d_per > 0`, so the division cannot meet a zero -- but it is
        // written the safe way anyway, because inverting a unit inverts its edge
        // cases and `1/max(raw,0.001)` clamps the wrong side.
        d_per_mode == 3 ? d_cps = d_per > 0.001 ? max(tempo, 0.001) / 60 / d_per : 0.001;

        // Drift play/rest, per (band, target), counted in PERIODS. While
        // resting the phase does not advance at all, so the offset STAYS where
        // it stopped -- freeze in place, not a return to centre. The FRACTION
        // of the play value chooses where it parks: x.25 crest, x.75 trough,
        // x.0 and x.5 neutral, so a whole number parks at no change every time
        // and is nearly inaudible.
        d_hold = pr_frozen(band_drift_pr_accum, band_drift_pr_rest, slot,
                           d_cps / srate,
                           band_drift_play[slot], band_drift_rest[slot]);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !d_hold ? (
          band_drift_phase[slot] += d_cps / srate;
          band_drift_phase[slot] >= 1.0 ? (
            band_drift_phase[slot] -= 1.0;
            band_drift_shape[slot] == 2 ? (
              band_rand_old[slot] = band_rand_new[slot];
              band_rand_new[slot] = rand(2) - 1;
            );
          );
        );

        d_phi   = band_drift_phase[slot];
        d_shape = band_drift_shape[slot];
        d_mod   = 0;
        d_shape == 0 ? d_mod = sin(two_pi * d_phi);
        d_shape == 1 ? d_mod = 1 - 4 * abs(d_phi - 0.5);
        d_shape == 2 ? d_mod = band_rand_old[slot] + (band_rand_new[slot] - band_rand_old[slot]) * d_phi;

        d_offset = d_mod >= 0 ? d_mod * d_up : d_mod * d_down;
      );

      // Ramp rides OUTSIDE the drift guard, because a ramp with no drift set is
      // an ordinary thing to want. Its progress is advanced once per sample in
      // the ramp clock block above; here it is only read.
      tot_offset = d_offset + band_ramp_t[slot] * band_ramp_by[slot];

      t == 0 ? eff_freq   = eff_freq + tot_offset;
      t == 1 ? eff_w_up   = max(eff_w_up + tot_offset, 1);
      t == 2 ? eff_w_down = max(eff_w_down + tot_offset, 1);
      t == 3 ? eff_gain   = eff_gain + tot_offset;
      t == 4 ? eff_pan    = max(min(eff_pan + tot_offset, 1), -1);

      t += 1;
    );

    eff_gain > -59 ? (
      b_bw       = eff_w_up + eff_w_down;
      eff_center = eff_freq + (eff_w_up - eff_w_down) * 0.5;
      eff_center = max(min(eff_center, srate * 0.45), 1);

      b_damp = max(min(b_bw / eff_center, 2.0), 0.01);
      b_coef = min(2 * sin(pi_srate * eff_center), 0.98);

      ord_idx = band_order_idx[i];
      b_order = 1;
      ord_idx == 1 ? b_order = 2;
      ord_idx == 2 ? b_order = 4;
      ord_idx == 3 ? b_order = 8;

      // Convert dB to linear multiplier for parallel mode.
      gain_linear = 10 ^ (eff_gain / 20);

      svf_base_L = i * MAX_ORDER * 2;
      cascade_in_L = in_L;
      s = 0;
      loop(b_order,
        slot_svf = svf_base_L + s * 2;
        band_svf_L[slot_svf]     += b_coef * band_svf_L[slot_svf + 1];
        stage_high                = cascade_in_L - band_svf_L[slot_svf] - b_damp * band_svf_L[slot_svf + 1];
        band_svf_L[slot_svf + 1] += b_coef * stage_high;
        cascade_in_L              = band_svf_L[slot_svf + 1];
        s += 1;
      );
      b_out_L = cascade_in_L * gain_linear;

      svf_base_R = i * MAX_ORDER * 2;
      cascade_in_R = in_R;
      s = 0;
      loop(b_order,
        slot_svf = svf_base_R + s * 2;
        band_svf_R[slot_svf]     += b_coef * band_svf_R[slot_svf + 1];
        stage_high                = cascade_in_R - band_svf_R[slot_svf] - b_damp * band_svf_R[slot_svf + 1];
        band_svf_R[slot_svf + 1] += b_coef * stage_high;
        cascade_in_R              = band_svf_R[slot_svf + 1];
        s += 1;
      );
      b_out_R = cascade_in_R * gain_linear;

      b_left_keep  = eff_pan <= 0 ? 1 : 1 - eff_pan;
      b_right_keep = eff_pan >= 0 ? 1 : 1 + eff_pan;

      wet_L += b_out_L * b_left_keep;
      wet_R += b_out_R * b_right_keep;
    );
    i += 1;
  );
);

out_L = in_L * (1 - wet) + wet_L * wet;
out_R = in_R * (1 - wet) + wet_R * wet;

spl0 = out_L * vol;
spl1 = out_R * vol;

@serialize
// Versioned config persistence (added 2026-06-15). resonance_bank shipped
// (v2.5) with NO @serialize, so per-band setups never survived a project
// save/load — only the selected band's slider values came back. This adds
// it: the full 16-band config (per-band params + per-(band,target) drift
// config) now persists. Lead with a count-encoded magic so future format
// changes (band or drift-target count) degrade to @init defaults instead
// of mis-reading a stale blob; projects saved before this had no blob, so
// they deterministically load as defaults too. Runtime (filter state,
// drift phase / random-shape state) is NOT serialized — it resets per
// play in @init.
// FORMAT BUMPED 2026-09-05 (v1 -> v2). v2 adds drift play/rest, the whole Ramp
// block, and puts Drift period mode into the suite's canonical enum order.
//
// A v1 blob is still READ, and then its drift-mode values are MIGRATED, because
// the enum order changed underneath them: v1 was {BPM, Hz, Seconds, Host x} and
// v2 is {BPM, Seconds, Hz, Host x}, so a stored 1 and a stored 2 swap places.
// The migration is gated on the blob HAVING the field (v1 magic), never on "the
// blob is old" -- a pre-drift blob would not have written those banks at all,
// and permuting @init's defaults is how that mistake mutes things (CLAUDE.md).
// The new banks are only read from a v2 blob; a v1 blob leaves them at their
// @init defaults, which is drift play/rest off and ramp off -- exactly how this
// plugin behaved before today.
rb_magic_v1 = 1000000 + N_BANDS * 1000 + N_TARGETS;   // 1016005
rb_magic_v2 = 2000000 + N_BANDS * 1000 + N_TARGETS;   // 2016005
res_ser_magic = rb_magic_v2;
file_var(0, res_ser_magic);
rb_is_v1 = res_ser_magic == rb_magic_v1;
rb_is_v2 = res_ser_magic == rb_magic_v2;
(rb_is_v1 || rb_is_v2) ? (
  file_mem(0, band_freq,              N_BANDS);
  file_mem(0, band_gain,              N_BANDS);
  file_mem(0, band_width_up,          N_BANDS);
  file_mem(0, band_width_down,        N_BANDS);
  file_mem(0, band_pan,               N_BANDS);
  file_mem(0, band_order_idx,         N_BANDS);
  file_mem(0, band_last_drift_target, N_BANDS);
  file_mem(0, band_drift_up,    N_BANDS * N_TARGETS);
  file_mem(0, band_drift_down,  N_BANDS * N_TARGETS);
  file_mem(0, band_drift_per,   N_BANDS * N_TARGETS);
  file_mem(0, band_drift_mode,  N_BANDS * N_TARGETS);
  file_mem(0, band_drift_shape, N_BANDS * N_TARGETS);

  // v2 additions. On WRITE rb_is_v2 is always true, so these are always saved.
  rb_is_v2 ? (
    file_mem(0, band_drift_play,  N_BANDS * N_TARGETS);
    file_mem(0, band_drift_rest,  N_BANDS * N_TARGETS);
    file_mem(0, band_ramp_by,     N_BANDS * N_TARGETS);
    file_mem(0, band_ramp_dur,    N_BANDS * N_TARGETS);
    file_mem(0, band_ramp_delay,  N_BANDS * N_TARGETS);
    file_mem(0, band_ramp_play,   N_BANDS * N_TARGETS);
    file_mem(0, band_ramp_rest,   N_BANDS * N_TARGETS);
    file_mem(0, band_last_ramp_target, N_BANDS);
  );

  // Enum migration, read-only by construction: rb_is_v1 can only be true after
  // a READ, because a WRITE stamps rb_magic_v2 above. Swaps the two values that
  // changed places and leaves 0 (BPM) and 3 (Host x) alone.
  rb_is_v1 ? (
    rbm = 0;
    loop(N_BANDS * N_TARGETS,
      band_drift_mode[rbm] == 1 ? ( band_drift_mode[rbm] = 2; )
      : band_drift_mode[rbm] == 2 ? ( band_drift_mode[rbm] = 1; );
      rbm += 1;
    );
  );

  // TRACK-DUPLICATE FIX (v2.14). On READ (load/duplicate) file_avail(0) >= 0;
  // on WRITE it is < 0. @serialize is the only section guaranteed to run on
  // both load AND duplicate, so it re-establishes the bank<->slider invariant.
  // This plugin has TWO nested selectors (band + drift-target), so on read we
  // force BOTH the per-band config sliders (3-8) for the selected band AND the
  // drift config sliders (10-14) for that band's remembered drift target back
  // to their restored bank values, and sync the last_* trackers so the next
  // @slider capture writes the correct values (not a transient clobbered 0).
  file_avail(0) >= 0 ? (
    rb_band = slider3;
    slider4 = band_freq[rb_band];
    slider5 = band_width_up[rb_band];
    slider6 = band_width_down[rb_band];
    slider7 = band_gain[rb_band];
    slider8 = band_pan[rb_band];
    slider9 = band_order_idx[rb_band];
    rb_dt   = band_last_drift_target[rb_band];
    slider12 = rb_dt;
    rb_slot = rb_band * N_TARGETS + rb_dt;
    slider13 = band_drift_up[rb_slot];
    slider14 = band_drift_down[rb_slot];
    slider15 = band_drift_per[rb_slot];
    slider16 = band_drift_mode[rb_slot];
    slider17 = band_drift_shape[rb_slot];
    slider18 = band_drift_play[rb_slot];
    slider19 = band_drift_rest[rb_slot];
    rb_rt    = band_last_ramp_target[rb_band];
    slider20 = rb_rt;
    rb_rslot = rb_band * N_TARGETS + rb_rt;
    slider21 = band_ramp_by[rb_rslot];
    slider23 = band_ramp_dur[rb_rslot];
    slider24 = band_ramp_play[rb_rslot];
    slider25 = band_ramp_rest[rb_rslot];
    slider27 = band_ramp_delay[rb_rslot];
    last_band_select         = rb_band;
    last_drift_target_select = rb_dt;
    last_ramp_target_select  = rb_rt;
    sliderchange(-1);
  );
);
