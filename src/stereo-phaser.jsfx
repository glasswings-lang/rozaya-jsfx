desc: Stereo Phaser
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/
//
// A classic swept-allpass phaser. A chain of first-order allpass filters is
// swept by an LFO; summing the swept signal with the dry input creates moving
// notches in the spectrum (the "whoosh"). Feedback deepens and resonates them.
// Stereo comes from an LFO phase offset between the channels, so the sweep
// swirls across the field instead of moving in lockstep.
//
// Allpass topology follows Cockos' stock "4-Tap Phaser" (LGPL) — reimplemented
// here, generalised to a selectable number of stages and a stereo spread.
//
// HEADS-UP — REAPER auto-mute with stacked copies: one instance is safe at any
// setting. But if you put SEVERAL identical copies on one track with very high
// Feedback, their sweeps stay phase-locked (each starts its LFO at the same
// point) so the resonant peaks line up and multiply in series — the level can
// spike hard enough that REAPER auto-mutes the track to protect your speakers.
// If that happens: drop Feedback (~0.5 is safe), OR vary the Rate / Range
// between the copies so they drift apart instead of reinforcing, OR put a
// limiter after them. It's specifically the stacked-AND-identical-AND-hot case.

// THE RATE TRIPLE IS CONTIGUOUS (R7). Rate, the mode that says what Rate
// MEANS, and the picker that writes it, sit together. They used to be at 1, 8
// and 9 -- the control seven places from the thing that defines it, which is
// the single clearest argument in the whole consistency plan. Reordered
// 2026-09-04. Old projects are repaired IN THE PROJECT FILE by
// tools/phaser_migrate_rate_triple.py -- there is no runtime self-repair, and
// there deliberately isn't one (see the note above @serialize).
slider1:0.3<0.001,1000,0.001>Rate (BPM / sec / Hz / beats per cycle)
// Own Hz: free-running at Rate Hz -- the original behaviour.
// Host x: Rate means BEATS PER CYCLE. 4 is one sweep every four beats; 3.7 is
//         one every three and seven tenths, which a note-division grid cannot
//         express and which is what this suite exists for. It is NOT a
//         multiplier any more (R13-revised, 2026-09-02) -- a multiplier is a
//         number you have to do arithmetic against the tempo to hear.
slider2:2<0,3,1{BPM,Seconds,Hz,Host x}>Rate Mode
// RETIRED 2026-09-04 by R13-revised, and hidden. It existed only to spare you
// arithmetic on a multiplier; "every 4 beats" is now typing 4 into Rate. The
// slider is NOT deleted -- ids are primary keys and can never be renumbered, so
// removing it would shift everything above it in every saved project.
slider3:0<0,15,1{Custom,every 8 beats,every 4 beats,every 3 beats,every 2 beats,phi slow,2 per 3 beats,3 per 4 beats,1 per beat,4 per 3 beats,3 per 2 beats,phi fast,2 per beat,3 per beat,4 per beat,8 per beat}>Host ratio (retired)

slider4:300<40,20000,1>Range Min Hz
slider5:1500<40,20000,1>Range Max Hz
slider6:0.6<0,0.95,0.01>Feedback
slider7:6<2,64,2>Stages
slider8:90<0,180,1>Stereo Spread (degrees)
slider9:0.5<0,1,0.01>Wet/Dry Mix

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
// Path A render convention: NO ext_noinit, so REAPER re-runs @init on every
// transport play / render start and resets all runtime for free.
lfoPhase = 0;
// `tempo` is READ-ONLY in JSFX; read only, into a global not named `tempo`.
host_ratio_inited = 0;
// paired allpass state (y and x history), 64 stages max, per channel.
// Each array holds 64 slots, so the four never overlap.
lyL = 0;    lxL = 64;    // left
lyR = 128;  lxR = 192;   // right
memset(0, 0, 256);

@slider
// True for the ONE @slider pass where Rate Mode really moved INTO the
// tempo-following mode. The named pickers below use it to apply their ratio on
// entry: the raw multiplier HIDES behind a picker, so a stale picker value left
// unapplied would name one speed on screen while the plugin ran another.
// rate_mode_inited gates it, so a half-restored instance can never see an edge.
//
// NOTE, R20 2026-09-05: this plugin's Rate Mode DEFAULTS TO 2 (Hz), not 0 (BPM)
// like the rest of the suite. That is deliberate and it is what let this change
// ship with no project migration: all three saved instances in strangeness.RPP
// store `-` for this slider -- nothing at all -- so they take whatever the
// DECLARED default is. It was `Own Hz` at index 0; moving the default to Hz at
// index 2 lands them on exactly the behaviour they had. Writing explicit values
// into the project would have worked too and would have been the riskier way to
// get the same result. The enum ORDER is canonical; only the default differs.
rate_mode = slider2;
// RETIRED (R13-revised). The guard is forced to 0 rather than the block being
// deleted, so the reasoning stays next to the code it disabled. Rate says beats
// per cycle in Host x now, so there is no multiplier for a picker to translate
// -- and a picker that WRITES a value is exactly the shape that stamped 0.5
// over a hand-set rate on every load in infantile.RPP.
0 ? (
  host_ratio_sel = slider3;
  host_ratio_sel > 0 ? (
    slider1 =
      host_ratio_sel ==  1 ? 0.125 : host_ratio_sel ==  2 ? 0.25  :
      host_ratio_sel ==  3 ? 1/3   : host_ratio_sel ==  4 ? 0.5   :
      host_ratio_sel ==  5 ? 0.618 : host_ratio_sel ==  6 ? 2/3   :
      host_ratio_sel ==  7 ? 0.75  : host_ratio_sel ==  8 ? 1     :
      host_ratio_sel ==  9 ? 4/3   : host_ratio_sel == 10 ? 1.5   :
      host_ratio_sel == 11 ? 1.618 : host_ratio_sel == 12 ? 2     :
      host_ratio_sel == 13 ? 3     : host_ratio_sel == 14 ? 4     : 8;
    slider_automate(slider1);
  );
);
slider_show(slider3, 0);
// The LANDING BLOCK is gone (R13-revised step 4). It used to stamp the picker
// to "1 per beat" and the rate to 1 on entering Host x, because meeting a bare
// MULTIPLIER first was the trap -- 0.3 as a multiplier is a third of the tempo,
// which is nothing anyone asked for. There is no trap now: 0.3 beats per cycle
// is a legible number, so nothing needs stamping and, crucially, the RATE
// SLIDER NEVER HIDES. Hiding it is what forced the stamp in the first place.
rate_mode_inited ? last_rate_mode = rate_mode;

// Host x: Rate is BEATS PER CYCLE, converted to cycles per second here.
// tempo/60 is beats per second, so N beats per cycle is (tempo/60)/N cycles per
// second. lfoInc below is the only thing that uses it, and @block repeats this
// so a tempo change lands live.
//
// The guard is on the NUMERATOR side deliberately. Inverting a unit inverts its
// edge cases: `1 / max(raw, 0.001)` clamps the DENOMINATOR, so a rate of 0
// comes out as 1000 -- screaming, rather than stopped. Under the old multiplier
// 0 meant "effectively stopped" and it has to keep meaning that. This slider's
// declared minimum is 0.001 so it cannot actually reach 0, but the safe form
// costs nothing and the unsafe one nearly shipped elsewhere in this suite.
// `rate` is in Hz. R20's four modes convert into it:
//   0 BPM      cycles per minute      -> /60
//   1 Seconds  seconds per cycle      -> 1/x
//   2 Hz       cycles per second      -> as-is  (THIS PLUGIN'S DEFAULT, see slider2)
//   3 Host x   every N beats          -> tempo/60/x
rate      = rate_mode == 3 ?
              (slider1 > 0.001 ? max(tempo, 0.001) / 60 / slider1 : 0.001) :
            rate_mode == 2 ? slider1 :
            rate_mode == 1 ? 1 / max(slider1, 0.001) :
              slider1 / 60;
rangeMin  = min(slider4, slider5);
rangeMax  = max(slider4, slider5);
fb        = slider6;
stages    = slider7;
spreadRad = slider8 * $pi / 180;
wet       = slider9;
dry       = 1 - wet;

// LFO sweeps the allpass corner between the two range edges. Working in the
// stock's normalised-frequency domain (d = 2*fc/srate) so coef=(1-d)/(1+d)
// places the phase transition at the audible sweep frequency.
dmin = 2 * rangeMin / srate;
dmax = 2 * rangeMax / srate;
dsc  = abs(dmax - dmin) * 0.5;
dmin = min(dmin, dmax);
lfoInc = 2 * $pi * rate / srate;

@block
// The 2026-09-04 reorder is repaired IN THE PROJECT FILE, not here. An earlier
// version of this plugin carried a runtime self-repair that keyed on "no blob
// means old layout" -- and it was actively dangerous once the file was migrated,
// because a correctly-migrated project ALSO has no blob, so the plugin would
// have permuted it a second time and scrambled it. REAPER reads the slider line
// as positional numbers and nothing else, so the numbers are what to fix.
// See tools/phaser_migrate_rate_triple.py.
// --- Restore-order guard for the change-detecting controls below -----------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the picker then fires and slider_automate()s
//     its ratio over a rate that was set by hand. @block cannot run before the
//     instance is configured, so adopting here is right whatever order the
//     restore paths ran in. (Proved 2026-08-23: a Sweeping Filter in BPM mode
//     with Host ratio "every 2 beats" had Rate Value stamped to 0.5 on every
//     load and every track duplicate.)
!host_ratio_inited ? ( host_ratio_sel = slider3; host_ratio_inited = 1; );
!rate_mode_inited ? ( last_rate_mode = slider2; rate_mode_inited = 1; );
// Follow the project tempo live in Host x. @slider does not re-run on a tempo
// change, so the rate and the LFO increment are recomputed here.
rate_mode == 3 ? (
  rate   = slider1 > 0.001 ? max(tempo, 0.001) / 60 / slider1 : 0.001;
  lfoInc = 2 * $pi * rate / srate;
);

// Transport POSITION, for phase-locking the sweep in Host x. Tempo sync sets
// the sweep's speed; this sets where in it we are, so the phaser lands the
// same way at the same bar however you got there. Nothing in this plugin can
// modulate the rate -- no Drift, no Speed Ramp -- so the lock needs no
// "is something moving the rate" guard, unlike the tremolo and the sweeping
// filter. Only while the transport is moving (1 = playing, 5 = recording);
// stopped or paused, beat_position doesn't advance and locking would freeze
// the sweep for live monitoring.
host_beat_pos   = beat_position;
host_pos_locked = (rate_mode == 3) && (play_state == 1 || play_state == 5);
blk_sample      = 0;

@sample
// Where this sample sits in the project, in beats -- @block gives the position
// at the start of the block, so step forward by however far in we are. slider1
// is BEATS PER CYCLE in Host x, so the number of whole cycles elapsed is the
// beat position DIVIDED by it. This division is the same inversion as the rate
// conversion above and HAD to change with it -- multiplying here while dividing
// there would lock the phase to a different speed than the sweep runs at, which
// sounds like the sweep jumping every block.
host_pos_locked ? (
  sample_beat_pos = host_beat_pos + blk_sample * max(tempo, 0.001) / (60 * srate);
  lfo_turns = slider1 > 0.001 ? sample_beat_pos / slider1 : 0;
  lfoPhase  = (lfo_turns - floor(lfo_turns)) * 2 * $pi;
);
blk_sample += 1;

// per-channel swept coefficient (right channel offset by Stereo Spread)
dL = dmin + dsc * (sin(lfoPhase) + 1);
dR = dmin + dsc * (sin(lfoPhase + spreadRad) + 1);
lfoPhase += lfoInc;
lfoPhase >= 2*$pi ? lfoPhase -= 2*$pi;
coefL = (1 - dL) / (1 + dL);
coefR = (1 - dR) / (1 + dR);

// --- left allpass chain: y = coef*(y_prev + x) - x_prev ---
x = spl0 + fbL * fb;
i = 0;
loop(stages,
  ny = coefL * (lyL[i] + x) - lxL[i];
  lxL[i] = x;
  lyL[i] = ny;
  x = ny;
  i += 1;
);
fbL = x;
spl0 = dry * spl0 + wet * x;

// --- right allpass chain ---
x = spl1 + fbR * fb;
i = 0;
loop(stages,
  ny = coefR * (lyR[i] + x) - lxR[i];
  lxR[i] = x;
  lyR[i] = ny;
  x = ny;
  i += 1;
);
fbR = x;
spl1 = dry * spl1 + wet * x;
