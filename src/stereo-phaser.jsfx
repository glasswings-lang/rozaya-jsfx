desc: Stereo Phaser
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/
//
// A classic swept-allpass phaser. A chain of first-order allpass filters is
// swept by an LFO; summing the swept signal with the dry input creates moving
// notches in the spectrum (the "whoosh"). Feedback deepens and resonates them.
// Stereo comes from an LFO phase offset between the channels, so the sweep
// swirls across the field instead of moving in lockstep.
//
// Allpass topology follows Cockos' stock "4-Tap Phaser" (LGPL) — reimplemented
// here, generalised to a selectable number of stages and a stereo spread.
//
// HEADS-UP — REAPER auto-mute with stacked copies: one instance is safe at any
// setting. But if you put SEVERAL identical copies on one track with very high
// Feedback, their sweeps stay phase-locked (each starts its LFO at the same
// point) so the resonant peaks line up and multiply in series — the level can
// spike hard enough that REAPER auto-mutes the track to protect your speakers.
// If that happens: drop Feedback (~0.5 is safe), OR vary the Rate / Range
// between the copies so they drift apart instead of reinforcing, OR put a
// limiter after them. It's specifically the stacked-AND-identical-AND-hot case.

// THE RATE TRIPLE IS CONTIGUOUS (R7). Rate, the mode that says what Rate
// MEANS, and the picker that writes it, sit together. They used to be at 1, 8
// and 9 -- the control seven places from the thing that defines it, which is
// the single clearest argument in the whole consistency plan. Reordered
// 2026-09-04. Old projects are repaired IN THE PROJECT FILE by
// tools/phaser_migrate_rate_triple.py -- there is no runtime self-repair, and
// there deliberately isn't one (see the note above @serialize).
// === THE SWEEP ==========================================================
// The notch travels between a bottom and a top, and the GAP between them is the
// sweep: narrow for tight focused phasing, wide to cover the spectrum. Both ends
// are always live; the picker only says which one you are editing, and its word
// is at the FRONT so first-letter nav reaches the whole block.
//
// `Both (keeps the gap)` shows the midpoint of the two and applies your CHANGE to
// both, clamped so neither end runs off its range and squeezes the gap -- so it
// slides the whole sweep up or down at a fixed width. Rozaya, 2026-09-16, on this
// replacing the suite's older two-separate-blocks rule: "I like your idea. I
// highly suspect the older one was me + claude on a me tired day heh."
slider1:0<0,2,1{Both (keeps the gap),Bottom,Top}>Range end
slider2:0<0,2,1{Hz,Semitones,Cents}>Range pitch mode
slider3:81<0,127,1{C-1,C#-1,D-1,D#-1,E-1,F-1,F#-1,G-1,G#-1,A-1,A#-1,B-1,C0,C#0,D0,D#0,E0,F0,F#0,G0,G#0,A0,A#0,B0,C1,C#1,D1,D#1,E1,F1,F#1,G1,G#1,A1,A#1,B1,C2,C#2,D2,D#2,E2,F2,F#2,G2,G#2,A2,A#2,B2,C3,C#3,D3,D#3,E3,F3,F#3,G3,G#3,A3,A#3,B3,C4,C#4,D4,D#4,E4,F4,F#4,G4,G#4,A4,A#4,B4,C5,C#5,D5,D#5,E5,F5,F#5,G5,G#5,A5,A#5,B5,C6,C#6,D6,D#6,E6,F6,F#6,G6,G#6,A6,A#6,B6,C7,C#7,D7,D#7,E7,F7,F#7,G7,G#7,A7,A#7,B7,C8,C#8,D8,D#8,E8,F8,F#8,G8,G#8,A8,A#8,B8,C9,C#9,D9,D#9,E9,F9,F#9,G9}>Range note name
slider4:900<0,20000,0.001>Range frequency (Hz / semitones / cents)
slider5:2<0,2,1{Hz,Semitones,Cents}>Range fine tune unit
slider6:0<-1000,1000,0.001>Range fine tune
slider7:440<20,2000,0.1>Tuning reference (Hz, all ends)
slider8:60<0,95,0.1>Feedback (%)
// A structural count, so not a drift or ramp target (R24).
slider9:6<2,64,2>Stages

// === ITS RATE ===========================================================
// The mode comes BEFORE the value it qualifies (Part 2). Own Hz free-runs; the
// beat modes mean beats per cycle, never a multiplier.
slider10:2<0,4,1{BPM,Seconds,Hz,Every N beats,N per beat}>Rate mode
slider11:0.3<0.001,1000,0.001>Rate value

// === STEREO =============================================================
slider12:90<0,180,1>Stereo spread (degrees)

// === OUTPUT =============================================================
slider13:50<0,100,0.1>Wet/dry mix (%)

// === TRANSPORT ==========================================================
// New in this version. Cycles is the default because this plugin HAS a turn of
// its own to count, unlike Veil.
slider14:0<0,2,1{Cycles,Seconds,Beats}>Transport unit
slider15:0<0,1000,0.001>Start delay (in transport units)
slider16:0<0,1000,0.001>Play for (in transport units, 0 = always)
slider17:0<0,1000,0.001>Rest for (in transport units, 0 = always)
// The Phaser works on incoming sound, so a rest has something to pass.
slider18:0<0,1,1{Pass-through,Silence}>Output at rest

// --- Drift (nested selector) ---
slider19:0<0,12,1{Range frequency (both ends),Bottom frequency,Top frequency,Range fine tune (both ends),Bottom fine tune,Top fine tune,Tuning reference,Feedback,Rate value,Stereo spread,Wet/dry mix,Play for,Rest for}>Drift target
// R26. `Target default` is what the amount meant before, so a migrated copy
// sounds the same; a unit that cannot fit its target falls back to it.
slider20:0<0,12,1{Target default,Hz,Semitones,Cents,Milliseconds,Seconds,Minutes,BPM,Beats,Cycles,dB,Percent,Degrees}>Drift amount unit
slider21:0<0,20000,0.01>Drift up amount (in the Drift amount unit)
slider22:0<0,20000,0.01>Drift down amount (in the Drift amount unit)
slider23:0<0,2,1{Cycles,Seconds,Beats}>Drift period unit
slider24:20<0,1000,0.001>Drift period (0 = off)
slider25:0<0,2,1{Sine,Triangle,Random}>Drift shape
slider26:0<0,1000,0.01>Drift play for (periods, 0 = always)
slider27:0<0,1000,0.01>Drift rest for (periods, 0 = always)
// R27: the rest switch sits IN the block it freezes.
slider28:0<0,1,1{Walk through,Freeze in place}>Drift rest mode

// --- Ramp (nested selector; signed delta) ---
slider29:0<0,12,1{Range frequency (both ends),Bottom frequency,Top frequency,Range fine tune (both ends),Bottom fine tune,Top fine tune,Tuning reference,Feedback,Rate value,Stereo spread,Wet/dry mix,Play for,Rest for}>Ramp target
slider30:0<0,12,1{Target default,Hz,Semitones,Cents,Milliseconds,Seconds,Minutes,BPM,Beats,Cycles,dB,Percent,Degrees}>Ramp by unit
slider31:0<-20000,20000,0.001>Ramp by (in the Ramp by unit)
slider32:2<0,3,1{Cycles,Seconds,Minutes,Beats}>Ramp time unit
slider33:0<0,1000,0.01>Ramp duration (in ramp time units)
slider34:0<0,1000,0.01>Ramp play for (0 = smooth)
slider35:0<0,1000,0.01>Ramp rest for (0 = smooth)
slider36:0<0,1,1{Walk through,Freeze in place}>Ramp rest mode
slider37:0<0,1,1{Off,On}>Ramp engage (all targets)
slider38:0<0,1000,0.01>Ramp start delay (in ramp time units)

@init
// Path A render convention: NO ext_noinit, so REAPER re-runs @init on every
// transport play / render start and resets all runtime for free.
lfoPhase = 0;
// `tempo` is READ-ONLY in JSFX; read only, into a global not named `tempo`.
// paired allpass state (y and x history), 64 stages max, per channel.
// Each array holds 64 slots, so the four never overlap.
lyL = 0;    lxL = 64;    // left
lyR = 128;  lxR = 192;   // right
memset(0, 0, 256);

// --- Drift / Ramp state. Six targets, 16-slot strides, allpass owns 0..255.
//     Re-derive rather than trusting this list: the first free slot is 608.
// 13 since 2026-09-16 (R24/R26/R27): the sweep's two ends each gained an entry and
// a fine tune, a `(both ends)` entry apiece, and Tuning reference, Play for and
// Rest for joined. In control order, so the list reads the way the plugin does.
N_TARGETS = 13;
speed_ramp_by_mem            = 256;   // CONFIG  signed `by` per target
speed_ramp_dur_mem           = 288;   // CONFIG  duration per target
speed_ramp_delay_mem         = 320;   // CONFIG  start delay per target
speed_ramp_ramp_t_mem        = 352;   // RUNTIME progress 0..1
speed_ramp_delay_elapsed_mem = 384;   // RUNTIME delay sample counter
sr_play_mem                  = 416;   // CONFIG
sr_rest_mem                  = 448;   // CONFIG
sr_pr_resting_mem            = 480;   // RUNTIME
sr_pr_accum_mem              = 512;   // RUNTIME
drift_up_mem                 = 544;   // CONFIG
drift_down_mem               = 576;   // CONFIG
drift_per_mem                = 608;   // CONFIG
drift_shape_mem              = 640;   // CONFIG
drift_play_mem               = 672;   // CONFIG
drift_rest_mem               = 704;   // CONFIG
drift_phase_mem              = 736;   // RUNTIME
drift_prev_mem               = 768;   // RUNTIME (Random shape)
drift_curr_mem               = 800;   // RUNTIME (Random shape)
drift_offset_mem             = 832;   // RUNTIME (computed offset per target)
drift_pr_resting_mem         = 864;   // RUNTIME
drift_pr_accum_mem           = 896;

// Banks widened from 16 to 32 on 2026-09-16 with the targets going 6 -> 13, so the
// next target added is not a second migration.
// R26: which unit each target's amounts are typed in. Per target, CONFIG.
drift_unit_mem = 928;
ramp_unit_mem  = 960;

// --- Per-end banks (2 slots each: 0 = Bottom, 1 = Top). The Range end picker only
// chooses which the six visible controls are editing; both ends are always live.
end_pmode = 992;
end_note  = 1000;
end_freq  = 1008;
end_funit = 1016;
end_fine  = 1024;
// What the five visible controls read LAST pass, so an edit can be told from a view
// change -- without it, parking on Both and touching nothing would still write the
// midpoint into both ends and close the gap.
end_seen  = 1032;

// The transport gate reuses pr_frozen, which takes banks, so one slot each.
tr_accum   = 1040;
tr_resting = 1042;
tr_delay_elapsed = 0;
// Starts FULLY WET, or every transport play fades the effect in over 3 ms.
tr_mix = 1;
// Old-blob remap scratch, read by @serialize.
sp_old_to_new = 1048;
sp_tmp        = 1064;   // RUNTIME
// Per target since 2026-09-16: which unit each target's drift period and ramp
// times are counted in. CONFIG.
drift_punit_mem = 1120;
ramp_tunit_mem  = 1152;

// Shared play/rest window counter for both blocks. `tick` is how much of ONE
// window passes per sample, which is what lets each caller keep its own units:
// Drift passes 1/period_samples so its windows are drift periods; Ramp passes
// 1/(unit_seconds*srate) so its windows are minutes or beats. Returns 1 while
// frozen. Off unless BOTH values are > 0.
// --- A frequency in Hz from one end's pitch block. Hz mode passes the value
// through untouched, which is what keeps a migrated project bit-identical.
function sp_hz(m, v, f, fm) local(hz) (
  hz = m == 1 ? tuning_ref * pow(2, (v - 69) / 12) :
       m == 2 ? tuning_ref * pow(2, (v / 100 - 69) / 12) :
                v;
  hz = fm == 1 ? hz * pow(2, f / 12) :
       fm == 2 ? hz * pow(2, f / 1200) :
                 hz + f;
  min(max(hz, 20), 20000);
);
// --- The note name an end's value sits on, so the name reads back in every mode.
function sp_note(m, v) (
  m == 1 ? min(127, max(0, floor(v + 0.5))) :
  m == 2 ? min(127, max(0, floor(v / 100 + 0.5))) :
           min(127, max(0, floor(69 + 12 * log(max(v, 0.0001) / tuning_ref) / log(2) + 0.5)))
);
// --- How far one end WOULD really move, after its own range clamps it. `Both
// (keeps the gap)` shifts by the smaller of the two, so the span never closes.
function sp_try(bank, i, d, lo, hi) ( min(max(bank[i] + d, lo), hi) - bank[i]; );

// === R26: the amount unit ===============================================
// An amount is typed in whatever the picker says; this converts it into the unit
// the TARGET keeps. `Target default` (0) passes it through untouched, which is
// what makes a migrated project sound the same, and a unit that cannot fit its
// target falls back to that rather than inventing a meaning.
// Units: 0 Target default, 1 Hz, 2 Semitones, 3 Cents, 4 Milliseconds, 5 Seconds,
// 6 Minutes, 7 BPM, 8 Beats, 9 Cycles, 10 dB, 11 Percent, 12 Degrees.
//
// An interval is a RATIO, so `up 2 semitones` on a value kept in Hz is not `+2`,
// it is the Hz between the base and two semitones above it.
function sp_pitch(off, u, nu, base) local(r, sm, sm2) (
  (u < 1 || u > 3) || (u == 1 && nu == 0) || (u == 2 && nu == 1) || (u == 3 && nu == 2) ? off : (
    r = max(tuning_ref, 0.001);
    sm = nu == 1 ? base : nu == 2 ? base / 100 :
                   69 + 12 * log(max(base, 0.001) / r) / log(2);
    sm2 = u == 2 ? sm + off : u == 3 ? sm + off / 100 :
          69 + 12 * log(max(r * pow(2, (sm - 69) / 12) + off, 0.001) / r) / log(2);
    (nu == 1 ? sm2 : nu == 2 ? sm2 * 100 : r * pow(2, (sm2 - 69) / 12)) - base;
  );
);
// A rate amount. The Rate target is counted in BPM in EVERY rate mode -- the
// suite's settled rule, so a wander of 5 means the same whether the sweep is set
// in Hz, seconds or beats. BPM is therefore the target default and passes through;
// Hz converts (60 BPM is 1 Hz); a time or a beat count does not describe a rate
// DELTA without a base to count from, so it falls back.
function sp_rate(off, u) ( u == 1 ? off * 60 : off );
// A time amount in the Transport unit {0 Cycles, 1 Seconds, 2 Beats}.
function sp_time(off, u) local(sec) (
  sec = u == 4 ? off / 1000 : u == 6 ? off * 60 :
        u == 8 ? off * 60 / max(tempo, 0.001) : off;
  slider14 == 2 ? sec * max(tempo, 0.001) / 60 :
  slider14 == 0 ? sec * max(rate, 0.000001) : sec;
);
// The amount for target k, in that target's own unit.
function sp_amt(off, u, k) local(e) (
  u == 0 ? off :
  // 0-2 the two ends: the value is kept in that end's pitch mode.
  k <= 2 ? ( e = k == 2 ? 1 : 0; sp_pitch(off, u, end_pmode[e], end_freq[e]); ) :
  // 3-5 the fine tunes: kept in that end's fine tune unit, counted from its value.
  k <= 5 ? ( e = k == 5 ? 1 : 0; sp_pitch(off, u, end_funit[e], end_freq[e]); ) :
  // 6 Tuning reference, in Hz: an interval counted from the reference itself.
  k == 6 ? ( u == 2 ? slider7 * pow(2, off / 12) - slider7 :
             u == 3 ? slider7 * pow(2, off / 1200) - slider7 : off ) :
  // 7 Feedback, in percent since 2026-09-16 (R9): Percent is its own unit now.
  k == 7 ? off :
  // 8 Rate value, in the Rate mode's unit.
  k == 8 ? sp_rate(off, u) :
  // 9 Stereo spread, in degrees.
  k == 9 ? off :
  // 10 Wet/dry, in percent since 2026-09-16 (R9).
  k == 10 ? off :
  // 11-12 Play for and Rest for, kept in the Transport unit.
  ( u == 4 || u == 5 || u == 6 || u == 8 ? sp_time(off, u) : off )
);
// --- One target's total offset: its drift plus its ramp, the ramp's `by`
// converted the same way the drift amounts are.
function sq(k) ( drift_offset_mem[k] +
  speed_ramp_ramp_t_mem[k] * sp_amt(speed_ramp_by_mem[k], ramp_unit_mem[k], k) );

function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

// CONFIG defaults -- ONE TIME ONLY. @init re-runs on every transport play (no
// ext_noinit here), and without this guard every press of play would wipe the
// drift setup. @serialize overwrites these on project reload.
// Per-end defaults, guarded like the drift config so an @init re-run on transport
// play does not wipe what the user set. 300 Hz and 1500 Hz is what the Phaser has
// always opened with, and the span between them IS its sweep.
end_cfg_inited != 1 ? (
  end_pmode[0] = 0;   end_pmode[1] = 0;      // Hz
  end_note[0]  = 62;  end_note[1]  = 86;     // the nearest names to 300 and 1500
  end_freq[0]  = 300; end_freq[1]  = 1500;
  end_funit[0] = 2;   end_funit[1] = 2;      // Cents
  end_fine[0]  = 0;   end_fine[1]  = 0;
  end_cfg_inited = 1;
);
end_seen[0] = slider2; end_seen[1] = slider3; end_seen[2] = slider4;
end_seen[3] = slider5; end_seen[4] = slider6;
last_end = slider1;

drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_TARGETS,
    speed_ramp_by_mem[i]    = 0;
    speed_ramp_dur_mem[i]   = 0;
    speed_ramp_delay_mem[i] = 0;
    sr_play_mem[i]          = 0;
    sr_rest_mem[i]          = 0;
    drift_up_mem[i]         = 0;
    drift_down_mem[i]       = 0;
    drift_per_mem[i]        = 20;
    drift_punit_mem[i]      = 0;   // Cycles
    ramp_tunit_mem[i]       = 2;   // Minutes, the slider's own default
    drift_shape_mem[i]      = 0;
    drift_play_mem[i]       = 0;
    drift_rest_mem[i]       = 0;
    i += 1;
  );
  drift_cfg_inited = 1;
);

// RUNTIME reset on EVERY @init. Phases seeded with rand so two targets do not
// crest together.
i = 0;
loop(N_TARGETS,
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  sr_pr_resting_mem[i]            = 0;
  sr_pr_accum_mem[i]              = 0;
  drift_phase_mem[i]      = rand(1);
  drift_prev_mem[i]       = 0;
  drift_curr_mem[i]       = 0;
  drift_offset_mem[i]     = 0;
  drift_pr_resting_mem[i] = 0;
  drift_pr_accum_mem[i]   = 0;
  i += 1;
);

// Project tempo. ABSOLUTE, never a ratio against a remembered reference --
// @init re-runs on every transport play and would wipe the reference.
host_bpm = max(tempo, 0.001);

@slider
tuning_ref = slider7 >= 20 ? slider7 : 440;

// === The Range end picker ===============================================
// Two jobs that must never be confused: a VIEW CHANGE loads the end you just
// selected and writes nothing; an EDIT writes what you just moved. end_seen is
// what tells them apart -- without it, parking on Both and touching nothing would
// still write the midpoint into both ends and close the sweep.
esel = slider1;
last_end != esel ? (
  esel > 0 ? (
    slider2 = end_pmode[esel-1]; slider3 = end_note[esel-1];
    slider4 = end_freq[esel-1];  slider5 = end_funit[esel-1];
    slider6 = end_fine[esel-1];
  ) : (
    // Both shows the MIDPOINT of the two ends. The unit pickers show Bottom's,
    // because a mode is not a thing that can be averaged.
    slider2 = end_pmode[0]; slider5 = end_funit[0];
    slider4 = (end_freq[0] + end_freq[1]) * 0.5;
    slider6 = (end_fine[0] + end_fine[1]) * 0.5;
    slider3 = sp_note(slider2, slider4);
  );
  slider_automate(slider2); slider_automate(slider3); slider_automate(slider4);
  slider_automate(slider5); slider_automate(slider6);
  last_end = esel;
) : (
  esel > 0 ? (
    end_pmode[esel-1] = slider2; end_funit[esel-1] = slider5;
    end_freq[esel-1]  = slider4; end_fine[esel-1]  = slider6;
    slider3 != end_seen[1] ? (
      slider4 = slider2 == 1 ? slider3 : slider2 == 2 ? slider3 * 100 :
                tuning_ref * pow(2, (slider3 - 69) / 12);
      end_freq[esel-1] = slider4; slider_automate(slider4);
    ) : (
      slider3 = sp_note(slider2, slider4);
      slider_automate(slider3);
    );
    end_note[esel-1] = slider3;
  ) : (
    // BOTH. A picker writes the same value to both ends; a continuous control
    // applies its CHANGE to both, by the smaller of the two real moves, so the
    // sweep slides at a fixed width instead of closing at the end of a range.
    slider2 != end_seen[0] ? ( end_pmode[0] = slider2; end_pmode[1] = slider2; );
    slider5 != end_seen[3] ? ( end_funit[0] = slider5; end_funit[1] = slider5; );
    ed = 0;
    slider3 != end_seen[1] ? (
      ed = (slider2 == 1 ? slider3 : slider2 == 2 ? slider3 * 100 :
            tuning_ref * pow(2, (slider3 - 69) / 12)) - slider4;
    );
    slider4 != end_seen[2] ? ( ed = slider4 - end_seen[2]; );
    ed != 0 ? (
      em  = sp_try(end_freq, 0, ed, 0, 20000);
      em2 = sp_try(end_freq, 1, ed, 0, 20000);
      em  = abs(em2) < abs(em) ? em2 : em;
      end_freq[0] += em; end_freq[1] += em;
      slider4 = (end_freq[0] + end_freq[1]) * 0.5;
      slider3 = sp_note(slider2, slider4);
      slider_automate(slider4); slider_automate(slider3);
    );
    slider6 != end_seen[4] ? (
      ed  = slider6 - end_seen[4];
      em  = sp_try(end_fine, 0, ed, -1000, 1000);
      em2 = sp_try(end_fine, 1, ed, -1000, 1000);
      em  = abs(em2) < abs(em) ? em2 : em;
      end_fine[0] += em; end_fine[1] += em;
      slider6 = (end_fine[0] + end_fine[1]) * 0.5;
      slider_automate(slider6);
    );
  );
);
end_seen[0] = slider2; end_seen[1] = slider3; end_seen[2] = slider4;
end_seen[3] = slider5; end_seen[4] = slider6;
// True for the ONE @slider pass where Rate Mode really moved INTO the
// tempo-following mode. The named pickers below use it to apply their ratio on
// entry: the raw multiplier HIDES behind a picker, so a stale picker value left
// unapplied would name one speed on screen while the plugin ran another.
// rate_mode_inited gates it, so a half-restored instance can never see an edge.
//
// NOTE, R20 2026-09-05: this plugin's Rate Mode DEFAULTS TO 2 (Hz), not 0 (BPM)
// like the rest of the suite. That is deliberate and it is what let this change
// ship with no project migration: all three saved instances in strangeness.RPP
// store `-` for this slider -- nothing at all -- so they take whatever the
// DECLARED default is. It was `Own Hz` at index 0; moving the default to Hz at
// index 2 lands them on exactly the behaviour they had. Writing explicit values
// into the project would have worked too and would have been the riskier way to
// get the same result. The enum ORDER is canonical; only the default differs.
rate_mode = slider10;
// RETIRED (R13-revised). The guard is forced to 0 rather than the block being
// deleted, so the reasoning stays next to the code it disabled. Rate says beats
// per cycle in Host x now, so there is no multiplier for a picker to translate
// `Host ratio` lived here until 2026-09-16. Retired on 2026-09-04 by R13-revised,
// hidden, and its body sat behind a literal `0 ?` so it did nothing; the source
// already said it would go in this plugin's own reorder pass, and this is that
// pass. Rozaya, 2026-09-04: "host ratio. can't be deleted? why." Deleting a
// slider is safe -- ids are written explicitly, so the declaration simply goes
// and nothing below it renumbers. (RENUMBERING is the dangerous one.)
// The LANDING BLOCK is gone (R13-revised step 4). It used to stamp the picker
// to "1 per beat" and the rate to 1 on entering Host x, because meeting a bare
// MULTIPLIER first was the trap -- 0.3 as a multiplier is a third of the tempo,
// which is nothing anyone asked for. There is no trap now: 0.3 beats per cycle
// is a legible number, so nothing needs stamping and, crucially, the RATE
// SLIDER NEVER HIDES. Hiding it is what forced the stamp in the first place.
rate_mode_inited ? last_rate_mode = rate_mode;

// Host x: Rate is BEATS PER CYCLE, converted to cycles per second here.
// tempo/60 is beats per second, so N beats per cycle is (tempo/60)/N cycles per
// second. lfoInc below is the only thing that uses it, and @block repeats this
// so a tempo change lands live.
//
// The guard is on the NUMERATOR side deliberately. Inverting a unit inverts its
// edge cases: `1 / max(raw, 0.001)` clamps the DENOMINATOR, so a rate of 0
// comes out as 1000 -- screaming, rather than stopped. Under the old multiplier
// 0 meant "effectively stopped" and it has to keep meaning that. This slider's
// declared minimum is 0.001 so it cannot actually reach 0, but the safe form
// costs nothing and the unsafe one nearly shipped elsewhere in this suite.
// `rate` is in Hz. R20's four modes convert into it:
//   0 BPM      cycles per minute      -> /60
//   1 Seconds  seconds per cycle      -> 1/x
//   2 Hz       cycles per second      -> as-is  (THIS PLUGIN'S DEFAULT, see slider10)
//   3 Host x   every N beats          -> tempo/60/x
rate      = rate_mode == 4 ? max(tempo, 0.001) / 60 * max(slider11, 0.001) :
            rate_mode == 3 ?
              (slider11 > 0.001 ? max(tempo, 0.001) / 60 / slider11 : 0.001) :
            rate_mode == 2 ? slider11 :
            rate_mode == 1 ? 1 / max(slider11, 0.001) :
              slider11 / 60;
rangeMin  = min(end_freq[0], end_freq[1]);
rangeMax  = max(end_freq[0], end_freq[1]);
fb        = slider8 / 100;
stages    = slider9;
spreadRad = slider12 * $pi / 180;
wet       = slider13 / 100;
dry       = 1 - wet;

// LFO sweeps the allpass corner between the two range edges. Working in the
// stock's normalised-frequency domain (d = 2*fc/srate) so coef=(1-d)/(1+d)
// places the phase transition at the audible sweep frequency.
// These five are now BASELINES ONLY -- @sample rebuilds the sweep window and the
// LFO increment every sample as d_lo / dsc_s / lfoInc_s, because Drift and Ramp
// can move the range edges and the rate. Left in place rather than deleted:
// they are provably inert (nothing downstream reads them since 2026-09-05) and
// deleting them buys nothing, which is this repo's standing rule for dead code.
dmin = 2 * rangeMin / srate;
dmax = 2 * rangeMax / srate;
dsc  = abs(dmax - dmin) * 0.5;
dmin = min(dmin, dmax);
lfoInc = 2 * $pi * rate / srate;

// --- Ramp target selector save/restore (nested-selector pattern) ----------
// slider29 = target; 19 by; 21 duration; 22/23 play/rest; 25 start delay --
// all per target, and so is slider32 (time unit) since 2026-09-16. Only slider37
// (engage) stays global.
sel_speed_target = slider29;
last_speed_target != sel_speed_target ? (
  ramp_unit_mem[last_speed_target]        = slider30;
  speed_ramp_by_mem[last_speed_target]    = slider31;
  ramp_tunit_mem[last_speed_target]       = slider32;
  speed_ramp_dur_mem[last_speed_target]   = slider33;
  sr_play_mem[last_speed_target]          = slider34;
  sr_rest_mem[last_speed_target]          = slider35;
  speed_ramp_delay_mem[last_speed_target] = slider38;
  slider30 = ramp_unit_mem[sel_speed_target];
  slider31 = speed_ramp_by_mem[sel_speed_target];
  slider32 = ramp_tunit_mem[sel_speed_target];
  slider33 = speed_ramp_dur_mem[sel_speed_target];
  slider34 = sr_play_mem[sel_speed_target];
  slider35 = sr_rest_mem[sel_speed_target];
  slider38 = speed_ramp_delay_mem[sel_speed_target];
  slider_automate(slider30);
  slider_automate(slider31);
  slider_automate(slider32);
  slider_automate(slider33);
  slider_automate(slider34);
  slider_automate(slider35);
  slider_automate(slider38);
  last_speed_target = sel_speed_target;
) : (
  ramp_unit_mem[sel_speed_target]        = slider30;
  speed_ramp_by_mem[sel_speed_target]    = slider31;
  ramp_tunit_mem[sel_speed_target]       = slider32;
  speed_ramp_dur_mem[sel_speed_target]   = slider33;
  sr_play_mem[sel_speed_target]          = slider34;
  sr_rest_mem[sel_speed_target]          = slider35;
  speed_ramp_delay_mem[sel_speed_target] = slider38;
);

// --- Drift target selector save/restore (same pattern) -------------------
sel_target = slider19;
last_target_select != sel_target ? (
  drift_unit_mem[last_target_select]  = slider20;
  drift_up_mem[last_target_select]    = slider21;
  drift_down_mem[last_target_select]  = slider22;
  drift_punit_mem[last_target_select] = slider23;
  drift_per_mem[last_target_select]   = slider24;
  drift_shape_mem[last_target_select] = slider25;
  drift_play_mem[last_target_select]  = slider26;
  drift_rest_mem[last_target_select]  = slider27;
  slider20 = drift_unit_mem[sel_target];
  slider21 = drift_up_mem[sel_target];
  slider22 = drift_down_mem[sel_target];
  slider23 = drift_punit_mem[sel_target];
  slider24 = drift_per_mem[sel_target];
  slider25 = drift_shape_mem[sel_target];
  slider26 = drift_play_mem[sel_target];
  slider27 = drift_rest_mem[sel_target];
  slider_automate(slider20);
  slider_automate(slider21);
  slider_automate(slider22);
  slider_automate(slider23);
  slider_automate(slider24);
  slider_automate(slider25);
  slider_automate(slider26);
  slider_automate(slider27);
  last_target_select = sel_target;
) : (
  drift_unit_mem[sel_target]  = slider20;
  drift_up_mem[sel_target]    = slider21;
  drift_down_mem[sel_target]  = slider22;
  drift_punit_mem[sel_target] = slider23;
  drift_per_mem[sel_target]   = slider24;
  drift_shape_mem[sel_target] = slider25;
  drift_play_mem[sel_target]  = slider26;
  drift_rest_mem[sel_target]  = slider27;
);

@block
// Project tempo, refreshed once per block (it never changes mid-block). Used by
// the Drift period unit and the Ramp time unit when either is set to Beats.
host_bpm = max(tempo, 0.001);
// The 2026-09-04 reorder is repaired IN THE PROJECT FILE, not here. An earlier
// version of this plugin carried a runtime self-repair that keyed on "no blob
// means old layout" -- and it was actively dangerous once the file was migrated,
// because a correctly-migrated project ALSO has no blob, so the plugin would
// have permuted it a second time and scrambled it. REAPER reads the slider line
// as positional numbers and nothing else, so the numbers are what to fix.
// See tools/phaser_migrate_rate_triple.py.
// --- Restore-order guard for the change-detecting controls below -----------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the picker then fires and slider_automate()s
//     its ratio over a rate that was set by hand. @block cannot run before the
//     instance is configured, so adopting here is right whatever order the
//     restore paths ran in. (Proved 2026-08-23: a Sweeping Filter in BPM mode
//     with Host ratio "every 2 beats" had Rate Value stamped to 0.5 on every
//     load and every track duplicate.)
!rate_mode_inited ? ( last_rate_mode = slider10; rate_mode_inited = 1; );
// Follow the project tempo live in Host x. @slider does not re-run on a tempo
// change, so the rate and the LFO increment are recomputed here.
rate_mode >= 3 ? (
  rate   = rate_mode == 4 ? max(tempo, 0.001) / 60 * max(slider11, 0.001)
         : slider11 > 0.001 ? max(tempo, 0.001) / 60 / slider11 : 0.001;
  lfoInc = 2 * $pi * rate / srate;
);

// Transport POSITION, for phase-locking the sweep in Host x. Tempo sync sets
// the sweep's speed; this sets where in it we are, so the phaser lands the
// same way at the same bar however you got there. Nothing in this plugin can
// modulate the rate -- no Drift, no Speed Ramp -- so the lock needs no
// "is something moving the rate" guard, unlike the tremolo and the sweeping
// filter. Only while the transport is moving (1 = playing, 5 = recording);
// stopped or paused, beat_position doesn't advance and locking would freeze
// the sweep for live monitoring.
host_beat_pos   = beat_position;
// Position-lock applies to BOTH host modes; the cycle count differs and is
// handled where lfo_turns is computed.
host_pos_locked = (rate_mode >= 3) && (play_state == 1 || play_state == 5);
blk_sample      = 0;

@sample
// === TRANSPORT ==========================================================
// New 2026-09-16 (R27). Start delay, Play for and Rest for share ONE unit, and
// Cycles is the default because this plugin HAS a turn of its own to count --
// unlike Veil, which counts in Seconds. Recomputed per sample so a tempo change
// is followed live in Beats, and a drifting rate is followed live in Cycles.
tr_sec = slider14 == 2 ? 60 / max(tempo, 0.001) :
         slider14 == 0 ? 1 / max(rate, 0.000001) : 1;
tr_delay_samples = slider15 * tr_sec * srate;
tr_started = tr_delay_elapsed >= tr_delay_samples;
!tr_started ? tr_delay_elapsed += 1;
// One window is one transport unit, so the two values need no second unit and no
// arithmetic. Both must be > 0 or the gate is off -- the default, and exactly
// what this plugin did before it had a transport at all.
tr_at_rest = tr_started ?
  pr_frozen(tr_accum, tr_resting, 0, 1 / max(tr_sec * srate, 1), slider16, slider17) : 0;
// A start delay holds BOTH, which is what a start delay is for; a rest holds
// only what its own switch says.
tr_drift_hold = !tr_started || (tr_at_rest && slider28 == 1);
tr_ramp_hold  = !tr_started || (tr_at_rest && slider36 == 1);
// Where this sample sits in the project, in beats -- @block gives the position
// at the start of the block, so step forward by however far in we are. slider11
// is BEATS PER CYCLE in Host x, so the number of whole cycles elapsed is the
// beat position DIVIDED by it. This division is the same inversion as the rate
// conversion above and HAD to change with it -- multiplying here while dividing
// there would lock the phase to a different speed than the sweep runs at, which
// sounds like the sweep jumping every block.
// --- Ramp clocks, one per target. Engage (slider37) is a freeze/resume gate:
//     while Off, progress HOLDS; only transport play (via @init) resets it.
//     One factor converts the block's time values into seconds -- a minute is
//     60 s, a beat is 60/tempo s -- recomputed per sample so a tempo change is
//     followed live in Beats mode.
// Ramp time unit. One factor turns the Ramp block's time values into seconds.
// Cycles counts THIS plugin's own cycles, referenced against the rate BEFORE
// drift and ramp touch it, so a ramp cannot alter its own clock. Seconds is
// wall clock. Minutes is 60 s and is the DEFAULT -- every saved instance has
// this control unset, so the default is what they all run on, and moving it
// would rewrite live ramps (2026-09-05). A beat is 60/tempo s, recomputed per
// sample so Beats follows a live tempo change rather than remembering one.
slider37 && !tr_ramp_hold ? (
  i = 0;
  loop(N_TARGETS,
    // Per target since 2026-09-16, so each ramp keeps its own clock.
    ramp_time_scale =
      ramp_tunit_mem[i] == 3 ? 60 / max(host_bpm, 0.001) :
      ramp_tunit_mem[i] == 2 ? 60 :
      ramp_tunit_mem[i] == 1 ? 1 :
                               1 / max(rate, 0.00001);
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * ramp_time_scale * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        // Staircase. The ramp advances for `play`, holds for `rest`, repeats.
        // The holds come OUT of the duration rather than extending it -- the
        // advancing step is scaled by (play+rest)/play -- so Ramp duration goes
        // on meaning "you arrive in about this long".
        sr_pl = sr_play_mem[i];
        sr_rs = sr_rest_mem[i];
        sr_pr_on = sr_pl > 0 && sr_rs > 0;
        sr_hold = pr_frozen(sr_pr_accum_mem, sr_pr_resting_mem, i,
                            1.0 / (ramp_time_scale * srate),
                            sr_pl, sr_rs);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !sr_hold ? (
          sr_step = 1.0 / (srate * speed_ramp_dur_mem[i] * ramp_time_scale);
          sr_pr_on ? sr_step *= (sr_pl + sr_rs) / sr_pl;
          speed_ramp_ramp_t_mem[i] += sr_step;
          speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
        );
      );
    );
    i += 1;
  );
);

// --- Per-target drift wave. Phase advances at 1/(period_seconds*srate);
//     offset = shape * (up when the wave is positive, down when negative).
i = 0;
loop(N_TARGETS,
  // R26: the amounts are typed in drift_unit_mem[i] and converted into the unit this
  // target actually keeps. Target default passes straight through.
  //
  // MISSING from 2026-09-16 morning to afternoon: this plugin was built from Veil's
  // rebuild, which had lost the line, so the drift amount unit was saved and shown and
  // did nothing. No live project had a non-default drift unit (checked in every blob).
  up    = sp_amt(drift_up_mem[i],   drift_unit_mem[i], i);
  down  = sp_amt(drift_down_mem[i], drift_unit_mem[i], i);
  per   = drift_per_mem[i];
  shape = drift_shape_mem[i];

  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    // Period unit (slider23): Seconds as-is; Beats converted at the LIVE
    // project tempo, so the wander follows the host.
    // Cycles is the default and counts THIS plugin's own cycles, referenced
    // against the PRE-drift rate so drifting the rate cannot modulate its own
    // drift period. Seconds is wall clock. Beats follows the live tempo.
    period_samples =
      drift_punit_mem[i] == 2 ? max(per * 60 / max(host_bpm, 0.001) * srate, 1) :
      drift_punit_mem[i] == 1 ? max(per * srate, 1) :
                      max(per * srate / max(rate, 0.00001), 1);

    // Drift play/rest, counted in PERIODS. While resting the phase does not
    // advance at all, so the offset STAYS where it stopped -- freeze in place,
    // not a return to centre. The FRACTION of the play value chooses where it
    // parks: x.25 at the crest, x.75 at the trough, x.0 and x.5 at neutral --
    // so an awkward fraction beats a tidy one, and a whole number parks at no
    // change every time and is nearly inaudible.
    // A start delay, or a transport rest with Drift rest mode on Freeze in
    // place, holds every target's drift as surely as its own rest does.
    d_frozen = tr_drift_hold ||
               pr_frozen(drift_pr_accum_mem, drift_pr_resting_mem, i,
                         1.0 / period_samples,
                         drift_play_mem[i], drift_rest_mem[i]);
    d_frozen ? (
      new_phase = drift_phase_mem[i];
    ) : (
      new_phase = drift_phase_mem[i] + 1.0 / period_samples;
      new_phase >= 1.0 ? (
        new_phase -= 1.0;
        shape == 2 ? (
          drift_prev_mem[i] = drift_curr_mem[i];
          drift_curr_mem[i] = rand(2) - 1;
        );
      );
      drift_phase_mem[i] = new_phase;
    );

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = drift_prev_mem[i] +
        (drift_curr_mem[i] - drift_prev_mem[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  drift_offset_mem[i] = drift_offset_local;
  i += 1;
);

// --- Effective parameters = baseline + drift + ramp, every sample, so drift
//     and ramp actually move. Targets: 0 Rate, 1 Range min, 2 Range max,
//     3 Feedback, 4 Stereo spread, 5 Wet/dry.
r0 = speed_ramp_ramp_t_mem[0] * speed_ramp_by_mem[0];
r1 = speed_ramp_ramp_t_mem[1] * speed_ramp_by_mem[1];
r2 = speed_ramp_ramp_t_mem[2] * speed_ramp_by_mem[2];
r3 = speed_ramp_ramp_t_mem[3] * speed_ramp_by_mem[3];
r4 = speed_ramp_ramp_t_mem[4] * speed_ramp_by_mem[4];
r5 = speed_ramp_ramp_t_mem[5] * speed_ramp_by_mem[5];

// RATE amounts are in BPM in EVERY rate mode -- the suite's settled rule, so a
// wander of 5 means the same thing whether the sweep is set in Hz, seconds or
// beats. `rate` is in Hz, so convert: 60 BPM is 1 Hz.
rate_delta_hz = sq(8) / 60;
eff_rate      = max(0.0001, rate + rate_delta_hz);

// Thirteen targets now, in control order:
//   0 Range frequency (both ends)  1 Bottom frequency   2 Top frequency
//   3 Range fine tune (both ends)  4 Bottom fine tune   5 Top fine tune
//   6 Tuning reference  7 Feedback  8 Rate value  9 Stereo spread
//  10 Wet/dry mix      11 Play for 12 Rest for
// A `(both ends)` target and one end's own target ADD, so the whole sweep can
// wander while one end also wanders on its own.
tuning_ref = max(20, min(2000, slider7 + sq(6)));
sq_both = sq(0); sq_bothf = sq(3);
eff_min = sp_hz(end_pmode[0], end_freq[0] + sq_both + sq(1),
                end_fine[0] + sq_bothf + sq(4), end_funit[0]);
eff_max = sp_hz(end_pmode[1], end_freq[1] + sq_both + sq(2),
                end_fine[1] + sq_bothf + sq(5), end_funit[1]);
eff_min  = max(40, min(20000, eff_min));
eff_max  = max(40, min(20000, eff_max));
// Feedback and Wet/dry are counted in PERCENT everywhere a person sees them (R9);
// the chain wants fractions, so each is divided once, here.
fb_s     = max(0,  min(95,    slider8 + sq(7))) / 100;
spread_s = max(0,  min(180,   slider12 + sq(9))) * $pi / 180;
wet_s    = max(0,  min(100,   slider13 + sq(10))) / 100;
dry_s    = 1 - wet_s;

// Sweep window, in the stock's normalised-frequency domain (d = 2*fc/srate),
// rebuilt per sample because the two range edges can now move.
d_lo     = 2 * min(eff_min, eff_max) / srate;
d_hi     = 2 * max(eff_min, eff_max) / srate;
dsc_s    = (d_hi - d_lo) * 0.5;
lfoInc_s = 2 * $pi * eff_rate / srate;

// Where this sample sits in the project, in beats. @block gives the position at
// the start of the block, so step forward by however far in we are.
sample_beat_pos = host_beat_pos + blk_sample * host_bpm / (60 * srate);
blk_sample += 1;

// Lock the phase to the project ONLY while nothing is moving the rate. The
// position formula answers "where would the sweep be if it had run at this rate
// all along", which stops being the right question the moment Drift or Ramp
// touches it. This guard did not exist before 2026-09-05 and did not need to --
// the plugin had no Drift and no Ramp, and the comment here said exactly that.
// Adding them made the old assumption false, which is what an honest comment
// is for.
rate_pos_lock = host_pos_locked && rate_delta_hz == 0;
rate_pos_lock ? (
  // slider11 is BEATS PER CYCLE in Host x, so whole cycles elapsed is the beat
  // position DIVIDED by it -- the same inversion as the rate conversion, and it
  // has to stay matched or the lock runs at a different speed than the sweep.
  // Every N beats divides the beat position; N per beat multiplies it.
  lfo_turns = rate_mode == 4 ? sample_beat_pos * max(slider11, 0.001)
            : slider11 > 0.001 ? sample_beat_pos / slider11 : 0;
  lfoPhase  = (lfo_turns - floor(lfo_turns)) * 2 * $pi;
);

// per-channel swept coefficient (right channel offset by Stereo Spread)
dL = d_lo + dsc_s * (sin(lfoPhase) + 1);
dR = d_lo + dsc_s * (sin(lfoPhase + spread_s) + 1);
lfoPhase += lfoInc_s;
lfoPhase >= 2*$pi ? lfoPhase -= 2*$pi;
coefL = (1 - dL) / (1 + dL);
coefR = (1 - dR) / (1 + dR);

// --- left allpass chain: y = coef*(y_prev + x) - x_prev ---
x = spl0 + fbL * fb_s;
i = 0;
loop(stages,
  ny = coefL * (lyL[i] + x) - lxL[i];
  lxL[i] = x;
  lyL[i] = ny;
  x = ny;
  i += 1;
);
fbL = x;
// Output at rest. The Phaser works on incoming sound, so a rest has something to
// pass: Pass-through hands the dry signal on untouched, Silence mutes. Crossfaded
// over 3 ms either way so neither edge clicks.
tr_smooth = exp(-1 / (srate * 0.003));
// A start delay waits with the effect OFF: the sound passes through untouched until
// the delay ends, as in Tremolo and Sweep Dwell. Rozaya, 2026-09-16: "The effect
// should of course wait." (Until then it only held drift and ramp.)
tr_mix = tr_mix * tr_smooth + ((tr_at_rest || !tr_started) ? 0 : 1) * (1 - tr_smooth);
tr_dry = (tr_at_rest && slider18 == 1) ? 0 : 1;
sp_in0 = spl0;
spl0 = (dry_s * spl0 + wet_s * x) * tr_mix + sp_in0 * tr_dry * (1 - tr_mix);

// --- right allpass chain ---
x = spl1 + fbR * fb_s;
i = 0;
loop(stages,
  ny = coefR * (lyR[i] + x) - lxR[i];
  lxR[i] = x;
  lyR[i] = ny;
  x = ny;
  i += 1;
);
fbR = x;
sp_in1 = spl1;
spl1 = (dry_s * spl1 + wet_s * x) * tr_mix + sp_in1 * tr_dry * (1 - tr_mix);
@serialize
// Drift and Ramp remember a separate amount per target, and (new 2026-09-16) the
// sweep remembers a separate pitch block per end, so both have to travel with the
// project.
//
// Version-guarded, and the magic encodes the target count, so a format change
// degrades to @init defaults rather than to garbage. 3400013 since 2026-09-16.
// A 3300006 save is read at its own width of six and REMAPPED, because its six
// targets are still among the thirteen: Rate was 0 and is 8, Range min 1 -> 1,
// Range max 2 -> 2, Feedback 3 -> 7, Stereo spread 4 -> 9, Wet/dry 5 -> 10.
// An OLD project with no blob at all fails the check and lands on defaults --
// drift and ramp both off, i.e. how the plugin behaved before it had either.
// 3500013 since 2026-09-16 (later the same day): Drift period unit and Ramp time
// unit became per target. A 3400013 save is the same layout minus those two banks,
// so it reads at full width and seeds both from the value its slider still holds.
// 3600013 since 2026-09-16 (later still): Feedback and Wet/dry count in percent (R9).
// A 3500013 save is the same layout with them as fractions; 3400013 also lacks the
// per-target period units.
sp_magic = 3600000 + N_TARGETS;
file_var(0, sp_magic);
sp_new   = sp_magic == 3600000 + N_TARGETS;
sp_prev2 = sp_magic == 3500000 + N_TARGETS;
sp_prev  = sp_magic == 3400000 + N_TARGETS;
sp_units = sp_new || sp_prev2;
sp_full  = sp_units || sp_prev;
sp_n = sp_full ? N_TARGETS : sp_magic == 3300006 ? 6 : 0;
sp_old_to_new[0] = 8; sp_old_to_new[1] = 1; sp_old_to_new[2] = 2;
sp_old_to_new[3] = 7; sp_old_to_new[4] = 9; sp_old_to_new[5] = 10;
// One bank. On the current format a straight read; on the older one it reads at
// the old width into scratch and scatters into the new indices, leaving every
// other target on its @init default.
function sp_bank(bank, n, isnew) local(bi) (
  isnew ? (
    file_mem(0, bank, n);
  ) : (
    file_mem(0, sp_tmp, n);
    bi = 0;
    loop(n, bank[sp_old_to_new[bi]] = sp_tmp[bi]; bi += 1; );
  );
);
sp_n > 0 ? (
  sp_bank(speed_ramp_by_mem,    sp_n, sp_full);
  sp_bank(speed_ramp_dur_mem,   sp_n, sp_full);
  sp_bank(speed_ramp_delay_mem, sp_n, sp_full);
  sp_bank(sr_play_mem,          sp_n, sp_full);
  sp_bank(sr_rest_mem,          sp_n, sp_full);
  file_var(0, last_speed_target);
  sp_bank(drift_up_mem,    sp_n, sp_full);
  sp_bank(drift_down_mem,  sp_n, sp_full);
  sp_bank(drift_per_mem,   sp_n, sp_full);
  sp_bank(drift_shape_mem, sp_n, sp_full);
  sp_bank(drift_play_mem,  sp_n, sp_full);
  sp_bank(drift_rest_mem,  sp_n, sp_full);
  file_var(0, last_target_select);
  // Below exists only in the new format. An older blob leaves the amount units on
  // Target default -- what the amounts meant before -- and the per-end banks on
  // their @init defaults, which the .RPP migration fills.
  sp_full ? (
    file_mem(0, drift_unit_mem, N_TARGETS);
    file_mem(0, ramp_unit_mem,  N_TARGETS);
    file_mem(0, end_pmode, 2); file_mem(0, end_note,  2);
    file_mem(0, end_freq,  2); file_mem(0, end_funit, 2);
    file_mem(0, end_fine,  2);
    file_var(0, last_end);
    sp_units ? (
      file_mem(0, drift_punit_mem, N_TARGETS);
      file_mem(0, ramp_tunit_mem,  N_TARGETS);
    );
  ) : (
    last_speed_target  = last_speed_target  < 6 ? sp_old_to_new[last_speed_target]  : 0;
    last_target_select = last_target_select < 6 ? sp_old_to_new[last_target_select] : 0;
  );

  // TRACK-DUPLICATE FIX, and it is not optional -- without it a duplicated track
  // silently ZEROES whichever target happens to be selected. On READ (load or
  // duplicate) file_avail(0) >= 0; on WRITE it is < 0. @serialize is the ONE
  // section guaranteed to run on both load AND duplicate, so it re-establishes the
  // bank-matches-slider invariant whatever order the restore paths ran in.
  //
  // sliderchange(-1), NOT slider_automate: refresh the display and the parameter
  // without WRITING AUTOMATION.
  // Older than 3500013: every target was using the ONE shared unit the slider
  // still holds, so give each target that unit and nothing changes sound.
  !sp_units ? (
    sp_i = 0;
    loop(N_TARGETS,
      drift_punit_mem[sp_i] = slider23; ramp_tunit_mem[sp_i] = slider32;
      sp_i += 1;
    );
  );

  // Older than 3600013: Feedback (target 7) and Wet/dry (target 10) were fractions.
  // Every DRIFT amount aimed at them is scaled x100 -- the drift unit was never applied
  // before 2026-09-16, so all were in the old fraction -- and every RAMP amount not
  // already typed as Percent, which was applied and already meant the same thing.
  !sp_new && sp_n > 0 ? (
    sp_k = 7;
    loop(2,
      drift_up_mem[sp_k] *= 100; drift_down_mem[sp_k] *= 100;
      ramp_unit_mem[sp_k] != 11 ? ( speed_ramp_by_mem[sp_k] *= 100; );
      sp_k = 10;
    );
  );

  file_avail(0) >= 0 ? (
    slider30 = ramp_unit_mem[last_speed_target];
    slider31 = speed_ramp_by_mem[last_speed_target];
    slider32 = ramp_tunit_mem[last_speed_target];
    slider33 = speed_ramp_dur_mem[last_speed_target];
    slider34 = sr_play_mem[last_speed_target];
    slider35 = sr_rest_mem[last_speed_target];
    slider38 = speed_ramp_delay_mem[last_speed_target];
    slider20 = drift_unit_mem[last_target_select];
    slider21 = drift_up_mem[last_target_select];
    slider22 = drift_down_mem[last_target_select];
    slider23 = drift_punit_mem[last_target_select];
    slider24 = drift_per_mem[last_target_select];
    slider25 = drift_shape_mem[last_target_select];
    slider26 = drift_play_mem[last_target_select];
    slider27 = drift_rest_mem[last_target_select];
    slider19 = last_target_select; slider29 = last_speed_target;
    sp_new ? (
      slider1 = last_end;
      last_end > 0 ? (
        slider2 = end_pmode[last_end-1]; slider3 = end_note[last_end-1];
        slider4 = end_freq[last_end-1];  slider5 = end_funit[last_end-1];
        slider6 = end_fine[last_end-1];
      ) : (
        slider2 = end_pmode[0]; slider5 = end_funit[0];
        slider4 = (end_freq[0] + end_freq[1]) * 0.5;
        slider6 = (end_fine[0] + end_fine[1]) * 0.5;
        slider3 = sp_note(slider2, slider4);
      );
      end_seen[0] = slider2; end_seen[1] = slider3; end_seen[2] = slider4;
      end_seen[3] = slider5; end_seen[4] = slider6;
    );
    end_cfg_inited = 1;
    sliderchange(-1);
  );
);
