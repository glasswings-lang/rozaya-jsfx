desc: Veil
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/
//
//tags: veil womb voice muffle muffled underwater lowpass prenatal fetal in-utero stereo
//
// Muffles a MONO voice the way the womb does — a steep lowpass around
// ~500 Hz, "like speech from behind a heavy curtain." (Real prenatal
// hearing: tissue + fluid attenuate everything above ~600 Hz; researchers
// mimic it with a ~400 Hz lowpass, and newborns actually PREFER that
// filtered version of the mother's voice.)
//
// === Stereo from a mono source ===
//
// A lowpass can't make something stereo — a mono voice stays a point in
// the centre. Width has to be MANUFACTURED by making the two channels
// different. The Left and Right chains are fully independent, each with
// its own cutoff and resonance. The WIDTH is the DIFFERENCE between the
// two cutoffs — pull them apart for more width, together for mono.
// Because the channels differ only in spectral rolloff (no phase/delay
// offset), a mono sum just averages the two rolloffs: no comb-notch
// cancellation, safe on a single speaker / HomePod / phone.
//
// === Slope ===
//
// Each SVF lowpass stage is -12 dB/oct; Slope cascades 1-4 of them for
// -12 / -24 / -36 / -48 dB/oct. Steeper = more muffled. Shared across
// both channels (a discrete character choice, not a drift target).
//
// === Drift + Speed Ramp (per channel) ===
//
// All four per-channel params — both cutoffs AND both resonances — are
// independent Drift and Speed Ramp targets, so the muffle can MOVE:
// a living womb, not a static EQ.
//   * Drift = a slow perpetual wander on a target. Give the two channels
//     slightly different periods and the stereo width itself breathes.
//   * Speed Ramp = a one-time signed ride on a target over N minutes.
//     Positive `by` on both cutoffs = the voice slowly CLEARING (the
//     muffle opening as the baby "grows"); negative = deepening.
// Nested-selector pattern: one target selector + shared up/down/period/
// shape sliders; ALL targets drift in parallel, the selector just picks
// which one you're editing. The amount is in the TARGET'S native unit —
// Hz for cutoff, 0-1 for resonance ("units match target", the suite
// convention; you tune it by ear). Cutoff uses the big end of the amount
// range, resonance the 0-1 end.
//
// Pair with: Womb (heartbeat/breath bed underneath), Bubbler / Dapple
// (fluid texture).

// === THE FILTER =========================================================
// One block behind a side picker, with the group's word at the FRONT: tap F in
// the parameter list and you are at the top of the whole filter. Left and Right
// stay fully independent inside -- the picker only says which you are editing.
//
// `Both (keeps the gap)` is NOT the suite's usual `All`. Everywhere else All
// writes the SAME value to every option. Veil's stereo width IS the gap between
// the two cutoffs and it has no other stereo mechanism, so a normal All would
// set both sides equal on the first nudge and take the plugin mono for good.
// This applies the CHANGE to both sides instead and holds the offset, clamped so
// neither side runs off the end of its range. It shows the midpoint of the two.
// Rozaya, 2026-09-15: "I'd go with the 'both, keeps the gap' option." The option
// says so in its own name, because a control never changes what it MEANS without
// saying so on itself.
slider1:0<0,2,1{Both (keeps the gap),Left,Right}>Filter side
// The pitch block, R22's shape: mode, note name, value, then fine tune unit and
// fine tune, with one Tuning reference for the plugin. The note name is a real
// control in every mode and reads both ways.
slider2:0<0,2,1{Hz,Semitones,Cents}>Filter pitch mode
slider3:71<0,127,1{C-1,C#-1,D-1,D#-1,E-1,F-1,F#-1,G-1,G#-1,A-1,A#-1,B-1,C0,C#0,D0,D#0,E0,F0,F#0,G0,G#0,A0,A#0,B0,C1,C#1,D1,D#1,E1,F1,F#1,G1,G#1,A1,A#1,B1,C2,C#2,D2,D#2,E2,F2,F#2,G2,G#2,A2,A#2,B2,C3,C#3,D3,D#3,E3,F3,F#3,G3,G#3,A3,A#3,B3,C4,C#4,D4,D#4,E4,F4,F#4,G4,G#4,A4,A#4,B4,C5,C#5,D5,D#5,E5,F5,F#5,G5,G#5,A5,A#5,B5,C6,C#6,D6,D#6,E6,F6,F#6,G6,G#6,A6,A#6,B6,C7,C#7,D7,D#7,E7,F7,F#7,G7,G#7,A7,A#7,B7,C8,C#8,D8,D#8,E8,F8,F#8,G8,G#8,A8,A#8,B8,C9,C#9,D9,D#9,E9,F9,F#9,G9}>Filter note name
slider4:500<0,20000,0.001>Filter cutoff (Hz / semitones / cents)
slider5:2<0,2,1{Hz,Semitones,Cents}>Filter fine tune unit
slider6:0<-1000,1000,0.001>Filter fine tune
slider7:0.15<0,1,0.01>Filter resonance
slider8:440<20,2000,0.1>Tuning reference (Hz, all sides)
// Slope is a character choice, not a continuous control, so it is not a drift or
// ramp target. Shared across both channels.
slider9:0<0,5,1{-12,-24,-36,-48,-60,-72}>Slope (dB/oct, all sides)

// === OUTPUT =============================================================
slider10:0<-60,24,0.01>Output (dB)

// === TRANSPORT ==========================================================
// New in this version: Veil had none at all. Start delay, Play for and Rest for
// share ONE unit, and Veil counts in Seconds because it has no turn of its own.
slider11:0<0,1,1{Seconds,Beats}>Transport unit
slider12:0<0,1000,0.001>Start delay (in transport units)
slider13:0<0,1000,0.001>Play for (in transport units, 0 = always)
slider14:0<0,1000,0.001>Rest for (in transport units, 0 = always)
// Veil works on incoming sound, so a rest has something to pass.
slider15:0<0,1,1{Pass-through,Silence}>Output at rest

// --- Drift (nested selector) ---
slider16:0<0,12,1{Cutoff (all sides),Left cutoff,Right cutoff,Fine tune (all sides),Left fine tune,Right fine tune,Resonance (all sides),Left resonance,Right resonance,Tuning reference,Output,Play for,Rest for}>Drift target
// R26, the amount unit. `Target default` is what the amount meant before, so a
// migrated copy sounds the same; a unit that cannot fit its target falls back to
// it. Per target, so it carries no scope mark.
slider17:0<0,12,1{Target default,Hz,Semitones,Cents,Milliseconds,Seconds,Minutes,BPM,Beats,Cycles,dB,Percent,Degrees}>Drift amount unit
slider18:0<0,20000,0.01>Drift up amount (in the Drift amount unit)
slider19:0<0,20000,0.01>Drift down amount (in the Drift amount unit)
// Host tempo sync for the drift period. Veil has no rate -- the only musical
// length in it is the drift period, so that is the only thing tempo touches. The
// unit comes BEFORE the value it qualifies (Part 2).
slider20:0<0,1,1{Seconds,Beats}>Drift period unit (all targets)
slider21:20<0,1000,0.001>Drift period (0 = off)
slider22:0<0,2,1{Sine,Triangle,Random}>Drift shape
// Drift Play/Rest. The drift wanders for `play` periods, then FREEZES where it
// stands for `rest` periods, then wanders on. Counted in drift periods, so there
// is no second unit and no arithmetic. Per target -- so Left cutoff can wander
// while Right cutoff holds, which makes the WIDTH itself move in steps.
slider23:0<0,1000,0.01>Drift play for (periods, 0 = always)
slider24:0<0,1000,0.01>Drift rest for (periods, 0 = always)
// R27: the rest switch sits IN the block it freezes. Rozaya, 2026-09-13:
// "Otherwise we get slider scatter stuff."
slider25:0<0,1,1{Walk through,Freeze in place}>Rest mode (for Drift)

// --- Ramp (nested selector; signed delta) ---
slider26:0<0,12,1{Cutoff (all sides),Left cutoff,Right cutoff,Fine tune (all sides),Left fine tune,Right fine tune,Resonance (all sides),Left resonance,Right resonance,Tuning reference,Output,Play for,Rest for}>Ramp target
slider27:0<0,12,1{Target default,Hz,Semitones,Cents,Milliseconds,Seconds,Minutes,BPM,Beats,Cycles,dB,Percent,Degrees}>Ramp by unit
slider28:0<-20000,20000,0.001>Ramp by (in the Ramp by unit)
// Beats, never bars: bars would need the time signature, which nothing in this
// suite reads, so the number would mean something different in 3/4 than in 4/4.
// In Beats the ramp follows a live tempo change.
slider29:1<0,2,1{Seconds,Minutes,Beats}>Ramp time unit (all targets)
slider30:0<0,1000,0.01>Ramp duration (in ramp time units)
// Ramp Play/Rest -- the STAIRCASE. The ramp advances for `play`, holds still for
// `rest`, and repeats. The rests come OUT of the duration, they do NOT extend it.
slider31:0<0,1000,0.01>Ramp play for (0 = smooth)
slider32:0<0,1000,0.01>Ramp rest for (0 = smooth)
slider33:0<0,1,1{Walk through,Freeze in place}>Rest mode (for Ramp)
slider34:0<0,1,1{Off,On}>Ramp engage (all targets)
slider35:0<0,1000,0.01>Ramp start delay (in ramp time units)

@init
// NO ext_noinit: REAPER re-runs @init on every transport play / render
// start, which resets all RUNTIME state (filter memory, drift phases,
// ramp clocks). CONFIG banks are guarded by drift_cfg_inited so those
// re-runs do NOT wipe the user's drift/ramp setup (Path A render fix).
// @serialize restores CONFIG across project save/load.

// Output joined 2026-09-11 (R24). It is last among the controls as well, so it
// appends in control order and no saved target index moves.
// 13 since 2026-09-15 (R24/R26/R27): the cutoffs and resonances each gained an
// `(all sides)` entry and a fine tune, and Tuning reference, Play for and Rest
// for joined. In control order, so the list reads the way the plugin does.
N_TARGETS = 13;

// Chamberlin SVF state: up to 4 cascaded stages per channel, 2 vars
// (low, band) each. L uses slots 0-7, R uses slots 8-15. Reset every
// @init (fresh filter start on play — normal).
// Two state words per stage, per channel, plus the per-stage damping table.
MAXSTAGES = 6;                 // 6 x 2 poles = 72 dB/oct
// Total peak emphasis, in dB, that Resonance = 1 asks for. Spread across the
// stages, so it means the same thing at -12 as at -72.
// 34 nominal, not a rounder 24, because the retired Kellett core reached ~+29 dB
// of real peak at Resonance 0.98 and migrated projects need to be representable.
// Nominal because a Butterworth section delivers a few dB less than it is asked
// for -- 34 here is about +31 dB of actual peak at Resonance 1.
RES_DB_MAX = 34;
sv_L   = 0;                    // 0 .. 2*MAXSTAGES-1
sv_R   = 2*MAXSTAGES;          // and the same again
inv_qb = 4*MAXSTAGES;          // 1/Q per stage, Butterworth, set in @slider
memset(0, 0, 5*MAXSTAGES);

// Per-target banks, 32-slot-spaced, based at 4096. Widened from 16 on 2026-09-15
// when the targets went 5 -> 13, so the next one added is not a second migration.
speed_ramp_by_mem            = 4096;   // signed `by` per target (CONFIG)
speed_ramp_dur_mem           = 4128;   // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 4160;   // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 4192;   // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 4224;   // delay sample counter per target (RUNTIME)
drift_up_mem                 = 4256;   // CONFIG
drift_down_mem               = 4288;   // CONFIG
drift_per_mem                = 4320;   // CONFIG (period in seconds)
drift_shape_mem              = 4352;   // CONFIG
drift_phase_mem              = 4384;   // RUNTIME
drift_prev_mem               = 4416;   // RUNTIME (Random shape)
drift_curr_mem               = 4448;   // RUNTIME (Random shape)
drift_offset_mem             = 4480;   // RUNTIME (computed Hz offset per target)
// Drift Play/Rest, per target. Counted in drift PERIODS.
drift_play_mem               = 4512;   // CONFIG (periods; 0 = gate off)
drift_rest_mem               = 4544;   // CONFIG (periods; 0 = gate off)
drift_pr_resting_mem         = 4576;   // RUNTIME (1 = frozen)
drift_pr_count_mem           = 4608;   // RUNTIME (whole periods in this state)
drift_pr_accum_mem           = 4640;   // RUNTIME (fractional period while frozen)
// Ramp Play/Rest -- the staircase. Counted in MINUTES, matching Ramp duration.
sr_play_mem                  = 4672;   // CONFIG (minutes; 0 = gate off)
sr_rest_mem                  = 4704;   // CONFIG (minutes; 0 = gate off)
sr_pr_resting_mem            = 4736;   // RUNTIME (1 = holding)
sr_pr_accum_mem              = 4768;   // RUNTIME (samples into this window)

// R26: which unit each target's amounts are typed in. Per target, CONFIG.
drift_unit_mem = 4800;
ramp_unit_mem  = 4832;

// --- Per-side banks (2 slots each: 0 = Left, 1 = Right). The Filter side picker
// only chooses which one the six visible controls are editing; both sides are
// always live. CONFIG, so @serialize carries them and an @init re-run on play
// does not wipe them.
side_pmode = 4864;
side_note  = 4872;
side_cut   = 4880;
side_funit = 4888;
side_fine  = 4896;
side_res   = 4904;
// What the six visible controls read LAST pass, so an edit can be told from a
// view change. Without it, parking the picker on Both and touching nothing would
// still write the midpoint into both sides and close the gap.
side_seen  = 4912;

// The transport gate reuses pr_frozen, which takes banks, so it gets one slot
// each. RUNTIME: an @init re-run on play restarts the delay, which is right.
tr_accum   = 4920;
tr_resting = 4922;
tr_delay_elapsed = 0;
// Starts FULLY WET. Without this the smoother begins at 0 and every transport
// play fades the filter in over 3 ms -- a change of sound nobody asked for.
tr_mix = 1;
// Old-blob remap scratch, read by @serialize.
wv_old_to_new = 4928;
wv_tmp        = 4944;   // RUNTIME (samples into this window)

// ---- Play/Rest alternation, ONE implementation, shared by Drift and Ramp.
// Both features alternate between a running window and a frozen one, and the
// flip logic is identical; only the CLOCK and the thing being frozen differ.
// Written twice it would become 28 copies once this reaches the other 14
// plugins -- 28 chances at a typo no linter can see. So it is written once.
//
// `tick` is how much of ONE WINDOW passes per sample, which is what lets each
// caller keep its own units: Drift passes 1/period_samples, so its windows are
// drift periods; Ramp passes 1/(unit_seconds*srate), so its windows are
// minutes or beats. Returns 1 while frozen, 0 while running, and 0 always
// unless BOTH values are > 0.
//
// What is deliberately NOT shared is what freezing DOES -- Drift holds its
// wave where it stands, the Ramp halts its progress toward a destination.
// Those genuinely differ, and each still has to be heard on its own.
// --- A cutoff in Hz, from one side's pitch block. Hz mode passes the value
// through untouched, which is what keeps a migrated project bit-identical. Same
// shape as the rest of the suite (R22): mode, value, fine tune, fine tune unit.
function vl_hz(m, v, f, fm) local(hz) (
  hz = m == 1 ? tuning_ref * pow(2, (v - 69) / 12) :
       m == 2 ? tuning_ref * pow(2, (v / 100 - 69) / 12) :
                v;
  hz = fm == 1 ? hz * pow(2, f / 12) :
       fm == 2 ? hz * pow(2, f / 1200) :
                 hz + f;
  min(max(hz, 20), 20000);
);
// --- The note name a side's value sits on, so the name reads back in every mode
// rather than only in Semitones.
function vl_note(m, v) (
  m == 1 ? min(127, max(0, floor(v + 0.5))) :
  m == 2 ? min(127, max(0, floor(v / 100 + 0.5))) :
           min(127, max(0, floor(69 + 12 * log(max(v, 0.0001) / tuning_ref) / log(2) + 0.5)))
);
// --- How far one side WOULD really move if asked to move by `d`, after its own
// range clamps it. `Both (keeps the gap)` then shifts by the smaller of the two
// sides' real moves, so the gap between them never closes at the end of a range.
function vl_try(bank, i, d, lo, hi) ( min(max(bank[i] + d, lo), hi) - bank[i]; );

// === R26: the amount unit ===============================================
// An amount is typed in whatever unit the picker says; this converts it into the
// unit the TARGET actually keeps. `Target default` (0) passes it through
// untouched, which is what makes a migrated project sound the same, and a unit
// that cannot fit its target falls back to that rather than inventing a meaning.
// Units: 0 Target default, 1 Hz, 2 Semitones, 3 Cents, 4 Milliseconds, 5 Seconds,
// 6 Minutes, 7 BPM, 8 Beats, 9 Cycles, 10 dB, 11 Percent, 12 Degrees. Veil has no
// rate, so Cycles, BPM and Degrees fit nothing here and fall back.
//
// Pitch is the fiddly one: an interval is a RATIO, so `up 2 semitones` on a value
// kept in Hz is not `+2`, it is the Hz between the base and two semitones above
// it. Converted at the base, the way the rest of the suite does it.
function vl_pitch(off, u, nu, base) local(r, sm, sm2) (
  (u < 1 || u > 3) || (u == 1 && nu == 0) || (u == 2 && nu == 1) || (u == 3 && nu == 2) ? off : (
    r = max(tuning_ref, 0.001);
    sm = nu == 1 ? base : nu == 2 ? base / 100 :
                   69 + 12 * log(max(base, 0.001) / r) / log(2);
    sm2 = u == 2 ? sm + off : u == 3 ? sm + off / 100 :
          69 + 12 * log(max(r * pow(2, (sm - 69) / 12) + off, 0.001) / r) / log(2);
    (nu == 1 ? sm2 : nu == 2 ? sm2 * 100 : r * pow(2, (sm2 - 69) / 12)) - base;
  );
);
// A time amount in the Transport unit {0 Seconds, 1 Beats}: to seconds first,
// then into whichever of the two the transport is counting in.
function vl_time(off, u) local(sec) (
  sec = u == 4 ? off / 1000 : u == 6 ? off * 60 :
        u == 8 ? off * 60 / max(host_bpm, 0.001) : off;
  slider11 == 1 ? sec * max(host_bpm, 0.001) / 60 : sec;
);
// The amount for target k, in that target's own unit.
function vl_amt(off, u, k) local(sd) (
  u == 0 ? off :
  // 0-2 the cutoffs: the value is kept in that side's pitch mode.
  k <= 2 ? ( sd = k == 2 ? 1 : 0; vl_pitch(off, u, side_pmode[sd], side_cut[sd]); ) :
  // 3-5 the fine tunes: kept in that side's fine tune unit, counted from its cutoff.
  k <= 5 ? ( sd = k == 5 ? 1 : 0; vl_pitch(off, u, side_funit[sd], side_cut[sd]); ) :
  // 6-8 resonance, a 0-1 fraction. Percent is the only unit that fits it.
  k <= 8 ? ( u == 11 ? off / 100 : off ) :
  // 9 Tuning reference, in Hz: an interval is counted from the reference itself.
  k == 9 ? ( u == 2 ? slider8 * pow(2, off / 12) - slider8 :
             u == 3 ? slider8 * pow(2, off / 1200) - slider8 : off ) :
  // 10 Output, in dB. Percent is a percentage of AMPLITUDE, not of the dB number.
  k == 10 ? ( u == 11 ? 20 * log(max(1 + off / 100, 0.0001)) / log(10) : off ) :
  // 11-12 Play for and Rest for, kept in the Transport unit.
  ( u == 4 || u == 5 || u == 6 || u == 8 ? vl_time(off, u) : off )
);
// --- One target's total offset: its drift plus its ramp, the ramp's `by`
// converted the same way the drift amounts are. Written once here rather than
// spelled out at each of the thirteen use sites.
function vq(k) ( drift_offset_mem[k] +
  speed_ramp_ramp_t_mem[k] * vl_amt(speed_ramp_by_mem[k], ramp_unit_mem[k], k) );

function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

// CONFIG defaults — one-time only, so transport re-runs of @init don't
// wipe user setup. @serialize overwrites these on project reload.
// Per-side defaults, guarded like the drift config so an @init re-run on transport
// play does not wipe what the user set. 480 Hz left and 520 Hz right is what Veil
// has always opened with, and the 40 Hz between them IS its stereo width.
side_cfg_inited != 1 ? (
  side_pmode[0] = 0;   side_pmode[1] = 0;      // Hz
  side_note[0]  = 71;  side_note[1]  = 71;     // B4, the nearest name to 480-520
  side_cut[0]   = 480; side_cut[1]   = 520;
  side_funit[0] = 2;   side_funit[1] = 2;      // Cents
  side_fine[0]  = 0;   side_fine[1]  = 0;
  side_res[0]   = 0.15; side_res[1]  = 0.15;
  side_cfg_inited = 1;
);
// The visible six start on the view the picker is showing, so the first @slider
// pass sees no change and writes nothing.
side_seen[0] = slider2; side_seen[1] = slider3; side_seen[2] = slider4;
side_seen[3] = slider5; side_seen[4] = slider6; side_seen[5] = slider7;
last_side = slider1;

drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_TARGETS,
    speed_ramp_by_mem[i]    = 0;
    speed_ramp_dur_mem[i]   = 0;
    speed_ramp_delay_mem[i] = 0;
    drift_up_mem[i]         = 0;
    drift_down_mem[i]       = 0;
    drift_per_mem[i]        = 20;
    drift_shape_mem[i]      = 0;
    drift_play_mem[i]       = 0;
    drift_rest_mem[i]       = 0;
    sr_play_mem[i]          = 0;
    sr_rest_mem[i]          = 0;
    i += 1;
  );
  drift_cfg_inited = 1;
);

// RUNTIME reset on EVERY @init (i.e. every transport play). Phases seeded
// with rand so the two drifts don't crest together.
// rand() is ONE stream shared with the Random drift shape in @sample, so only
// the four original targets draw from it here; drawing a fifth would shift every
// later Random drift in a saved project. Output is scattered from Left cutoff.
i = 0;
loop(N_TARGETS,
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  i < 4 ? drift_phase_mem[i] = rand(1) : (
    drift_phase_mem[i] = drift_phase_mem[0] + 0.618034;
    drift_phase_mem[i] -= floor(drift_phase_mem[i]);
  );
  drift_prev_mem[i]   = 0;
  drift_curr_mem[i]   = 0;
  drift_offset_mem[i] = 0;
  drift_pr_resting_mem[i] = 0;
  drift_pr_count_mem[i]   = 0;
  drift_pr_accum_mem[i]   = 0;
  sr_pr_resting_mem[i]    = 0;
  sr_pr_accum_mem[i]      = 0;
  i += 1;
);

// Host tempo. ABSOLUTE, never a ratio against a remembered reference — @init
// re-runs on every transport play and would wipe the reference. Seeded here
// so the first @sample after a play has a sane value before @block runs.
host_bpm = max(tempo, 0.001);

@block
// Project tempo, refreshed once per block (it never changes mid-block).
host_bpm = max(tempo, 0.001);

@slider
tuning_ref = slider8 >= 20 ? slider8 : 440;

// === The Filter side picker =============================================
// Two jobs that must never be confused: a VIEW CHANGE loads the side you just
// selected and writes nothing; an EDIT writes what you just moved. side_seen is
// what tells them apart -- without it, parking on Both and touching nothing would
// still write the midpoint into both sides and close the gap that IS Veil's
// stereo width.
vsel = slider1;
last_side != vsel ? (
  vsel > 0 ? (
    slider2 = side_pmode[vsel-1]; slider3 = side_note[vsel-1];
    slider4 = side_cut[vsel-1];   slider5 = side_funit[vsel-1];
    slider6 = side_fine[vsel-1];  slider7 = side_res[vsel-1];
  ) : (
    // Both shows the MIDPOINT of the two sides. The two unit pickers show Left's,
    // because a mode is not a thing that can be averaged.
    slider2 = side_pmode[0]; slider5 = side_funit[0];
    slider4 = (side_cut[0]  + side_cut[1])  * 0.5;
    slider6 = (side_fine[0] + side_fine[1]) * 0.5;
    slider7 = (side_res[0]  + side_res[1])  * 0.5;
    slider3 = vl_note(slider2, slider4);
  );
  slider_automate(slider2); slider_automate(slider3); slider_automate(slider4);
  slider_automate(slider5); slider_automate(slider6); slider_automate(slider7);
  last_side = vsel;
) : (
  vsel > 0 ? (
    // One side: every control writes straight into that side's slot, and the note
    // name reads back from the value, in every mode, both ways.
    side_pmode[vsel-1] = slider2; side_funit[vsel-1] = slider5;
    side_cut[vsel-1]   = slider4; side_fine[vsel-1]  = slider6;
    side_res[vsel-1]   = slider7;
    slider3 != side_seen[1] ? (
      slider4 = slider2 == 1 ? slider3 : slider2 == 2 ? slider3 * 100 :
                tuning_ref * pow(2, (slider3 - 69) / 12);
      side_cut[vsel-1] = slider4; slider_automate(slider4);
    ) : (
      slider3 = vl_note(slider2, slider4);
      slider_automate(slider3);
    );
    side_note[vsel-1] = slider3;
  ) : (
    // BOTH. A picker writes the same value to both sides; a continuous control
    // applies its CHANGE to both, by the smaller of the two real moves, so
    // neither side runs off the end of its range and squeezes the gap.
    slider2 != side_seen[0] ? ( side_pmode[0] = slider2; side_pmode[1] = slider2; );
    slider5 != side_seen[3] ? ( side_funit[0] = slider5; side_funit[1] = slider5; );
    vd = 0;
    // A note name change on Both is the same move as typing the value it means.
    slider3 != side_seen[1] ? (
      vd = (slider2 == 1 ? slider3 : slider2 == 2 ? slider3 * 100 :
            tuning_ref * pow(2, (slider3 - 69) / 12)) - slider4;
    );
    slider4 != side_seen[2] ? ( vd = slider4 - side_seen[2]; );
    vd != 0 ? (
      vm  = vl_try(side_cut, 0, vd, 0, 20000);
      vm2 = vl_try(side_cut, 1, vd, 0, 20000);
      vm  = abs(vm2) < abs(vm) ? vm2 : vm;
      side_cut[0] += vm; side_cut[1] += vm;
      slider4 = (side_cut[0] + side_cut[1]) * 0.5;
      slider3 = vl_note(slider2, slider4);
      slider_automate(slider4); slider_automate(slider3);
    );
    slider6 != side_seen[4] ? (
      vd  = slider6 - side_seen[4];
      vm  = vl_try(side_fine, 0, vd, -1000, 1000);
      vm2 = vl_try(side_fine, 1, vd, -1000, 1000);
      vm  = abs(vm2) < abs(vm) ? vm2 : vm;
      side_fine[0] += vm; side_fine[1] += vm;
      slider6 = (side_fine[0] + side_fine[1]) * 0.5;
      slider_automate(slider6);
    );
    slider7 != side_seen[5] ? (
      vd  = slider7 - side_seen[5];
      vm  = vl_try(side_res, 0, vd, 0, 1);
      vm2 = vl_try(side_res, 1, vd, 0, 1);
      vm  = abs(vm2) < abs(vm) ? vm2 : vm;
      side_res[0] += vm; side_res[1] += vm;
      slider7 = (side_res[0] + side_res[1]) * 0.5;
      slider_automate(slider7);
    );
  );
);
side_seen[0] = slider2; side_seen[1] = slider3; side_seen[2] = slider4;
side_seen[3] = slider5; side_seen[4] = slider6; side_seen[5] = slider7;

n_stages = min(MAXSTAGES, slider9 + 1);   // 1..6 cascaded 2-pole stages
// --- Per-stage Q, Butterworth.
// Cascading N IDENTICAL sections is the obvious way to get a steeper slope and
// it is wrong twice over: the resonant peaks multiply (six sections at 6 dB
// each is a 36 dB lump), and the composite -3 dB point slides DOWN by
// sqrt(2^(1/N)-1) -- at six stages a cutoff set to 480 Hz actually corners near
// 168. The number on the slider would drift further from the truth the steeper
// you went, which is the exact dishonesty this suite keeps refusing elsewhere.
//
// A Butterworth cascade gives each section its OWN Q, which is what makes the
// composite maximally flat and puts the corner exactly on the number at every
// slope. For 2N poles, section k takes Q = 1/(2*cos(pi*(2k+1)/(4N))) -- the
// standard pole-angle formula, so no table to keep in step with anything.
// (Butterworth, 1930. The idea is textbook; nothing here is ported.)
vq_order = 2 * n_stages;
vq_s = 0;
loop(n_stages,
  inv_qb[vq_s] = 2 * cos($pi * (2*vq_s + 1) / (2*vq_order));   // = 1/Q directly
  vq_s += 1;
);
// Resonance is spread ACROSS the stages rather than applied to each: the peak
// is the SUM of the sections' peaks in dB, so a given Resonance asks for the
// same total emphasis whether it is one stage or six. Without this, turning
// Resonance up at -72 would be a wall rather than a peak.
res_k = RES_DB_MAX / n_stages * (log(10) / 20);
out_gain = 10 ^ (slider10 / 20);
// (qL/qR are computed per-sample in @sample now — resonance drifts/ramps too.)

// Speed Ramp target selector save/restore. slider26 = target; slider28 =
// per-target `by`; slider30 = per-target duration; slider35 = per-target
// start delay. slider34 (engage) stays GLOBAL.
sel_speed_target = slider26;
last_speed_target != sel_speed_target ? (
  ramp_unit_mem[last_speed_target]        = slider27;
  speed_ramp_by_mem[last_speed_target]    = slider28;
  speed_ramp_dur_mem[last_speed_target]   = slider30;
  speed_ramp_delay_mem[last_speed_target] = slider35;
  sr_play_mem[last_speed_target]          = slider31;
  sr_rest_mem[last_speed_target]          = slider32;
  slider27 = ramp_unit_mem[sel_speed_target];
  slider28 = speed_ramp_by_mem[sel_speed_target];
  slider30 = speed_ramp_dur_mem[sel_speed_target];
  slider35 = speed_ramp_delay_mem[sel_speed_target];
  slider31 = sr_play_mem[sel_speed_target];
  slider32 = sr_rest_mem[sel_speed_target];
  slider_automate(slider27);
  slider_automate(slider28);
  slider_automate(slider30);
  slider_automate(slider35);
  slider_automate(slider31);
  slider_automate(slider32);
  last_speed_target = sel_speed_target;
) : (
  ramp_unit_mem[sel_speed_target]        = slider27;
  speed_ramp_by_mem[sel_speed_target]    = slider28;
  speed_ramp_dur_mem[sel_speed_target]   = slider30;
  speed_ramp_delay_mem[sel_speed_target] = slider35;
  sr_play_mem[sel_speed_target]          = slider31;
  sr_rest_mem[sel_speed_target]          = slider32;
);

// Drift target selector save/restore (same nested-selector pattern).
sel_target = slider16;
last_target_select != sel_target ? (
  drift_unit_mem[last_target_select]  = slider17;
  drift_up_mem[last_target_select]    = slider18;
  drift_down_mem[last_target_select]  = slider19;
  drift_per_mem[last_target_select]   = slider21;
  drift_shape_mem[last_target_select] = slider22;
  drift_play_mem[last_target_select]  = slider23;
  drift_rest_mem[last_target_select]  = slider24;
  slider17  = drift_unit_mem[sel_target];
  slider18  = drift_up_mem[sel_target];
  slider19  = drift_down_mem[sel_target];
  slider21 = drift_per_mem[sel_target];
  slider22 = drift_shape_mem[sel_target];
  slider23 = drift_play_mem[sel_target];
  slider24 = drift_rest_mem[sel_target];
  slider_automate(slider17);
  slider_automate(slider18);
  slider_automate(slider19);
  slider_automate(slider21);
  slider_automate(slider22);
  slider_automate(slider23);
  slider_automate(slider24);
  last_target_select = sel_target;
) : (
  drift_unit_mem[sel_target]  = slider17;
  drift_up_mem[sel_target]    = slider18;
  drift_down_mem[sel_target]  = slider19;
  drift_per_mem[sel_target]   = slider21;
  drift_shape_mem[sel_target] = slider22;
  drift_play_mem[sel_target]  = slider23;
  drift_rest_mem[sel_target]  = slider24;
);

@sample
// mono-sum the source (handles dual-mono or single-sided mono cleanly)
mono_in = (spl0 + spl1) * 0.5;

// === TRANSPORT ==========================================================
// New 2026-09-15 (R27). Veil had none. Start delay, Play for and Rest for share
// ONE unit; Veil counts in Seconds because it has no turn of its own to count.
// Recomputed per sample so a tempo change is followed live in Beats.
tr_sec = slider11 == 1 ? 60 / max(host_bpm, 0.001) : 1;
tr_delay_samples = slider12 * tr_sec * srate;
tr_started = tr_delay_elapsed >= tr_delay_samples;
!tr_started ? tr_delay_elapsed += 1;
// Play for / Rest for, in transport units: one window is one unit, so the tick is
// one unit's worth per sample and the two values need no second unit and no
// arithmetic. Both must be > 0 or the gate is off -- the default, and exactly
// what Veil did before it had a transport at all.
tr_at_rest = tr_started ?
  pr_frozen(tr_accum, tr_resting, 0, 1 / max(tr_sec * srate, 1), slider13, slider14) : 0;
// R27's two rest switches, each read where it acts. A start delay holds BOTH,
// which is what a start delay is for; a rest holds only what its own switch says.
tr_drift_hold = !tr_started || (tr_at_rest && slider25 == 1);
tr_ramp_hold  = !tr_started || (tr_at_rest && slider33 == 1);

// --- Advance each target's own ramp clock. Engage (slider34) is a
//     freeze/resume gate: while Off, ramp_t holds; only transport play
//     (via @init) resets it. Each target waits its own start-delay, then
//     advances its own ramp_t 0->1 over its own duration. ---
// One factor converts the Ramp block's four time values into seconds:
// a minute is 60 s; a beat is 60/tempo s. Recomputed per sample so a tempo
// change is followed live in Beats mode.
// Ramp time unit. No Cycles entry here: this plugin has no rate, so there are no
// cycles to count, and an option that did nothing would be worse than its
// absence -- the same rule the drift period unit follows. Minutes is the DEFAULT
// because every saved instance has this control unset.
ramp_time_scale =
  slider29 == 2 ? 60 / max(host_bpm, 0.001) :
  slider29 == 1 ? 60 :
                  1;
slider34 && !tr_ramp_hold ? (
  i = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * ramp_time_scale * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        // Staircase (sliders 19/20). The ramp advances for `play`, holds for
        // `rest`, and repeats, in whatever unit slider29 selects. The holds
        // come OUT of the duration rather than extending it -- the advancing
        // step is scaled by (play+rest)/play -- so Ramp duration goes on
        // meaning "you arrive in about this long" and the staircase changes
        // only HOW you get there.
        //
        // The last climb lands you on the LANDING, and the landing is part of
        // the staircase. A 32-beat ramp stepping 2 and holding 2 reaches its
        // destination on beat 30 and stands there for the last 2 -- so the
        // duration covers the whole thing, climb and landing, and is not
        // short by anything. (Two earlier versions of this comment got this
        // wrong in both directions: one claimed exact arrival, the next
        // called the same behaviour a fencepost fault to be disclosed. It is
        // just what a staircase is. -- Rozaya, 2026-09-04.)
        // Off unless BOTH are > 0.
        sr_pl = sr_play_mem[i];
        sr_rs = sr_rest_mem[i];
        sr_pr_on = sr_pl > 0 && sr_rs > 0;
        // Windows here are whole Ramp time units -- a minute, or a beat.
        sr_hold = pr_frozen(sr_pr_accum_mem, sr_pr_resting_mem, i,
                            1.0 / (ramp_time_scale * srate),
                            sr_pl, sr_rs);
        // Advance only while not holding. One-armed on purpose -- an empty
        // else-branch is a silent compile failure in eel2 (CLAUDE.md).
        !sr_hold ? (
          sr_step = 1.0 / (srate * speed_ramp_dur_mem[i] * ramp_time_scale);
          sr_pr_on ? sr_step *= (sr_pl + sr_rs) / sr_pl;
          speed_ramp_ramp_t_mem[i] += sr_step;
          speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
        );
      );
    );
    i += 1;
  );
);
// (ramp offset per target = ramp_t * by; computed inline below with the
//  effective values, all 4 targets in parallel.)

// --- Per-target drift wave. Each target's phase advances per sample at
//     1 / (period_seconds * srate); offset (Hz) = shape * (up or down). ---
i = 0;
loop(N_TARGETS,
  up    = drift_up_mem[i];
  down  = drift_down_mem[i];
  per   = drift_per_mem[i];
  shape = drift_shape_mem[i];

  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    // Drift period unit (slider20): Seconds = per as-is; Beats = per beats
    // converted at the live project tempo, so the wander follows the host.
    per_seconds = slider20 == 1 ? per * 60 / host_bpm : per;
    period_samples = max(per_seconds * srate, 1);

    // Drift Play/Rest (sliders 13/14), per target, counted in PERIODS.
    // While resting the phase does not advance at all, so shape_val below
    // is recomputed from the held phase and the offset simply STAYS where
    // it stopped -- freeze in place, not a return to centre. The rest
    // interval needs its own clock precisely because the phase is frozen.
    // Off unless BOTH are > 0, which is the default and is bit-identical
    // to the old always-wandering behaviour.
    // Windows here are drift PERIODS, and pr_frozen is ticked every sample
    // whether frozen or not. Two reasons this is not a whole-period counter
    // checked on the phase wrap: that can only ever
    // switch state ON a boundary, and phase 0 is the zero crossing of both
    // Sine and Triangle -- so every freeze landed at NO drift, which is the
    // least interesting point in the cycle and the exact opposite of the
    // point. Fractional values are therefore meaningful, and the FRACTION
    // chooses where the parameter parks: x.25 freezes at the crest (drifted
    // fully up), x.75 at the trough (fully down), x.0 and x.5 at neutral.
    // Verified by simulating the loop, not by reading it -- an earlier
    // version of this comment claimed 2.5 was the crest, and 2.5 is a zero
    // crossing. (Random shape was the one that already worked, since at
    // phase 0 it reads the previous random target rather than zero.)
    // A start delay, or a transport rest with Rest mode (for Drift) on Freeze in
    // place, holds every target's drift as surely as its own rest does.
    d_frozen = tr_drift_hold ||
               pr_frozen(drift_pr_accum_mem, drift_pr_resting_mem, i,
                         1.0 / period_samples,
                         drift_play_mem[i], drift_rest_mem[i]);

    d_frozen ? (
      new_phase = drift_phase_mem[i];   // FROZEN: hold wherever we stopped
    ) : (
      new_phase = drift_phase_mem[i] + 1.0 / period_samples;
      new_phase >= 1.0 ? (
        new_phase -= 1.0;
        shape == 2 ? (
          drift_prev_mem[i] = drift_curr_mem[i];
          drift_curr_mem[i] = rand(2) - 1;
        );
      );
      drift_phase_mem[i] = new_phase;
    );

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = drift_prev_mem[i] +
        (drift_curr_mem[i] - drift_prev_mem[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  drift_offset_mem[i] = drift_offset_local;
  i += 1;
);

// --- Effective params = baseline + drift + ramp, per sample. Thirteen targets
//     now, in control order:
//       0 Cutoff (all sides)  1 Left cutoff      2 Right cutoff
//       3 Fine tune (all)     4 Left fine tune   5 Right fine tune
//       6 Resonance (all)     7 Left resonance   8 Right resonance
//       9 Tuning reference   10 Output          11 Play for   12 Rest for
//     An `(all sides)` target and a side's own target ADD, so both can wander
//     together while one of them also wanders on its own. All recomputed per
//     sample, so drift and ramp actually move.
// Tuning reference can drift too, so the note-to-Hz conversion is redone here
// rather than held from @slider.
tuning_ref = max(20, min(2000, slider8 + vq(9)));
vq_all_cut = vq(0); vq_all_fine = vq(3); vq_all_res = vq(6);
eff_l_cut = vl_hz(side_pmode[0], side_cut[0] + vq_all_cut + vq(1),
                  side_fine[0] + vq_all_fine + vq(4), side_funit[0]);
eff_r_cut = vl_hz(side_pmode[1], side_cut[1] + vq_all_cut + vq(2),
                  side_fine[1] + vq_all_fine + vq(5), side_funit[1]);
eff_l_cut = max(20, min(eff_l_cut, srate * 0.45));
eff_r_cut = max(20, min(eff_r_cut, srate * 0.45));
eff_l_res = max(0, min(side_res[0] + vq_all_res + vq(7), 1));
eff_r_res = max(0, min(side_res[1] + vq_all_res + vq(8), 1));

gL = tan($pi * min(eff_l_cut, srate*0.49) / srate);
gR = tan($pi * min(eff_r_cut, srate*0.49) / srate);
// Resonance -> a Q multiplier shared by every stage (see res_k in @slider).
// exp() rather than pow() because only the exponent varies per sample.
inv_qm_L = exp(-res_k * eff_l_res);
inv_qm_R = exp(-res_k * eff_r_res);

// --- Left chain: n_stages lowpass stages in series ---
// Topology-preserving (zero-delay-feedback) SVF, one 2-pole lowpass per stage.
// The old Chamberlin form goes unstable at high Q near Nyquist, which a
// six-stage Butterworth cascade reaches on its own -- its last section sits at
// Q 3.83 before Resonance touches it. This form is stable across the range.
in_L = mono_in;
s = 0;
loop(n_stages,
  idx = s * 2;
  kk  = inv_qb[s] * inv_qm_L;
  a1  = 1 / (1 + gL*(gL + kk));
  a2  = gL * a1;
  a3  = gL * a2;
  v3  = in_L - sv_L[idx + 1];
  v1  = a1*sv_L[idx] + a2*v3;
  v2  = sv_L[idx + 1] + a2*sv_L[idx] + a3*v3;
  sv_L[idx]     = 2*v1 - sv_L[idx];
  sv_L[idx + 1] = 2*v2 - sv_L[idx + 1];
  in_L = v2;                     // v2 is the lowpass output
  s += 1;
);

// --- Right chain: independent cutoff + resonance, shared slope ---
in_R = mono_in;
s = 0;
loop(n_stages,
  idx = s * 2;
  kk  = inv_qb[s] * inv_qm_R;
  a1  = 1 / (1 + gR*(gR + kk));
  a2  = gR * a1;
  a3  = gR * a2;
  v3  = in_R - sv_R[idx + 1];
  v1  = a1*sv_R[idx] + a2*v3;
  v2  = sv_R[idx + 1] + a2*sv_R[idx] + a3*v3;
  sv_R[idx]     = 2*v1 - sv_R[idx];
  sv_R[idx + 1] = 2*v2 - sv_R[idx + 1];
  in_R = v2;
  s += 1;
);

// Output (target 4), in dB, clamped to the slider's own range. Untouched by
// drift and ramp it is exactly the @slider value, as it always was.
out_move = vq(10);
out_gain_eff = out_move != 0 ? 10 ^ (max(-60, min(24, slider10 + out_move)) / 20) : out_gain;

// Output at rest. Veil works on incoming sound, so a rest has something to pass:
// Pass-through hands the dry signal on untouched, Silence mutes. Crossfaded over
// 3 ms either way so neither edge clicks.
tr_smooth = exp(-1 / (srate * 0.003));
tr_mix = tr_mix * tr_smooth + (tr_at_rest ? 0 : 1) * (1 - tr_smooth);
tr_dry = (tr_at_rest && slider15 == 1) ? 0 : 1;
spl0 = (in_L * out_gain_eff) * tr_mix + mono_in * tr_dry * (1 - tr_mix);
spl1 = (in_R * out_gain_eff) * tr_mix + mono_in * tr_dry * (1 - tr_mix);

@serialize
// Persist the per-target drift and ramp config and (new 2026-09-15) the per-side
// filter banks, so a reload restores every target and both sides -- not just
// whichever the pickers happened to be on at save.
//
// Version-guarded (CLAUDE.md gotcha): the magic encodes the target count, so a
// format change degrades to @init defaults rather than to garbage. 3400013 since
// 2026-09-15 (13 targets, the amount units, the side banks). An older save is
// read at ITS width and REMAPPED, because its targets are still among the new
// ones: Left cutoff, Right cutoff, Left resonance, Right resonance and Output
// were 0-4 and are now 1, 2, 7, 8 and 10.
wv_magic = 3400000 + N_TARGETS;
file_var(0, wv_magic);
wv_new = wv_magic == 3400000 + N_TARGETS;
wv_n = wv_new ? N_TARGETS : wv_magic == 3300005 ? 5 : wv_magic == 3200004 ? 4 : 0;
wv_old_to_new[0] = 1; wv_old_to_new[1] = 2; wv_old_to_new[2] = 7;
wv_old_to_new[3] = 8; wv_old_to_new[4] = 10;
// One bank. On the current format a straight read; on an older one it reads at
// the old width into scratch and scatters into the new indices, leaving every
// other target on its @init default.
function wv_bank(bank, n, isnew) local(bi) (
  isnew ? (
    file_mem(0, bank, n);
  ) : (
    file_mem(0, wv_tmp, n);
    bi = 0;
    loop(n, bank[wv_old_to_new[bi]] = wv_tmp[bi]; bi += 1; );
  );
);
wv_n > 0 ? (
  wv_bank(speed_ramp_by_mem,    wv_n, wv_new);
  wv_bank(speed_ramp_dur_mem,   wv_n, wv_new);
  wv_bank(speed_ramp_delay_mem, wv_n, wv_new);
  wv_bank(sr_play_mem,          wv_n, wv_new);
  wv_bank(sr_rest_mem,          wv_n, wv_new);
  file_var(0, last_speed_target);
  wv_bank(drift_up_mem,    wv_n, wv_new);
  wv_bank(drift_down_mem,  wv_n, wv_new);
  wv_bank(drift_per_mem,   wv_n, wv_new);
  wv_bank(drift_shape_mem, wv_n, wv_new);
  wv_bank(drift_play_mem,  wv_n, wv_new);
  wv_bank(drift_rest_mem,  wv_n, wv_new);
  file_var(0, last_target_select);
  // Everything below exists only in the new format. An older blob leaves the
  // amount units on Target default -- which is what the amounts meant before --
  // and the side banks on their @init defaults, which the .RPP migration fills.
  wv_new ? (
    file_mem(0, drift_unit_mem, N_TARGETS);
    file_mem(0, ramp_unit_mem,  N_TARGETS);
    file_mem(0, side_pmode, 2); file_mem(0, side_note,  2);
    file_mem(0, side_cut,   2); file_mem(0, side_funit, 2);
    file_mem(0, side_fine,  2); file_mem(0, side_res,   2);
    file_var(0, last_side);
  ) : (
    // Both selectors point at an OLD target number, so they move with the rest.
    last_speed_target  = last_speed_target  < 5 ? wv_old_to_new[last_speed_target]  : 0;
    last_target_select = last_target_select < 5 ? wv_old_to_new[last_target_select] : 0;
  );

  // TRACK-DUPLICATE FIX. On READ (load/duplicate) file_avail(0) >= 0; on WRITE it
  // is < 0. @serialize is the only section guaranteed to run on both load AND
  // duplicate, so it re-establishes the bank<->slider invariant: force the visible
  // config sliders to match the restored banks for the restored selectors,
  // correcting any transient @slider clobber. (sliderchange, NOT slider_automate
  // -- no automation write.)
  file_avail(0) >= 0 ? (
    slider27 = ramp_unit_mem[last_speed_target];
    slider28 = speed_ramp_by_mem[last_speed_target];
    slider30 = speed_ramp_dur_mem[last_speed_target];
    slider35 = speed_ramp_delay_mem[last_speed_target];
    slider31 = sr_play_mem[last_speed_target];
    slider32 = sr_rest_mem[last_speed_target];
    slider17 = drift_unit_mem[last_target_select];
    slider18 = drift_up_mem[last_target_select];
    slider19 = drift_down_mem[last_target_select];
    slider21 = drift_per_mem[last_target_select];
    slider22 = drift_shape_mem[last_target_select];
    slider23 = drift_play_mem[last_target_select];
    slider24 = drift_rest_mem[last_target_select];
    slider16 = last_target_select; slider26 = last_speed_target;
    // and the six visible filter controls, for whichever side the picker is on.
    wv_new ? (
      slider1 = last_side;
      last_side > 0 ? (
        slider2 = side_pmode[last_side-1]; slider3 = side_note[last_side-1];
        slider4 = side_cut[last_side-1];   slider5 = side_funit[last_side-1];
        slider6 = side_fine[last_side-1];  slider7 = side_res[last_side-1];
      ) : (
        slider2 = side_pmode[0]; slider5 = side_funit[0];
        slider4 = (side_cut[0]  + side_cut[1])  * 0.5;
        slider6 = (side_fine[0] + side_fine[1]) * 0.5;
        slider7 = (side_res[0]  + side_res[1])  * 0.5;
        slider3 = vl_note(slider2, slider4);
      );
      side_seen[0] = slider2; side_seen[1] = slider3; side_seen[2] = slider4;
      side_seen[3] = slider5; side_seen[4] = slider6; side_seen[5] = slider7;
      last_side_ui = last_side;
    );
    side_cfg_inited = 1;
    sliderchange(-1);
  );
);
