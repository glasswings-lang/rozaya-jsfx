slider109:0<0,1000,0.1>Ramp duration (per target, in ramp time units)
slider110:0<0,1000,0.01>Ramp play for (per target, 0 = smooth)
slider111:0<0,1000,0.01>Ramp rest for (per target, 0 = smooth)
slider112:0<0,1,1{Off,On}>Ramp engage (all targets)
slider113:0<0,1000,0.1>Ramp start delay (per target, in ramp time units)

@init
// Rate drift and Ramp are in BPM in EVERY mode -- "BPM is BPM". This mattered
// more when Host x made the rate slider a multiplier, so a BPM amount was
// converted to multiplier terms (D BPM = D/tempo) before it's added. The
// PLUGIN does that division, never the user. Rejected alternative: a
// multiplier delta -- consistent on paper, unusable in practice, since
// reaching a musical destination then needs arithmetic (1 - 1/3 = 0.667 for
// "every three beats"), and a ramp deliberately leaves the grid anyway.
// Parameter deliberately NOT a short name: EEL2 folds case, so a global `D`
// anywhere in the file would BE this parameter and the function would
// silently self-assign (the spectral_vowel_probe silence bug in CLAUDE.md).
// Host x is gone (R13), so a BPM amount is just a BPM amount in every mode.
// Kept as a function rather than inlined: the Drift and Ramp call sites read
// better naming what they are doing, and it is where sync-aware handling would
// go if a synced rate ever needs drift expressed in beats.
function host_bpm_delta(bpm_amt) (
  bpm_amt
);
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: we let REAPER re-run @init on every transport play
// (its default), which resets all runtime state for free — sequencer,
// voices, drift phases, Speed Ramp, Start Delay. This is how REAPER's
// own stock filters work, and it fixes render-after-stop (the render's
// transport-play re-runs @init → fresh) without an explicit edge
// handler. Crucially it does NOT reset on STOP, so a note's release
// tail rings out naturally instead of being cut to silence (the
// "crunchy last notes" the v2.9 stop-edge attempt caused).
//
// The ONLY thing @init must NOT wipe on a transport-play re-run is the
// drift CONFIG bank (user's per-target up/down/period/shape). That's
// guarded by drift_cfg_inited below so it survives across play presses
// while everything else resets.

// Host tempo capture. `tempo` is one of REAPER's READ-ONLY system
// variables (see CLAUDE.md — assigning to it is silently ignored, which
// is how rhythm-track's Tempo slider did nothing for months). We only ever
// READ it, into our own global, and the global is deliberately NOT called
// `tempo`. The live tempo is applied as host_scale in @block; nothing
// here needs to remember it (see the rate_to_cycle_seconds note).
// `tempo` is documented valid in @block and @sample ONLY -- the community
// report is that it reads zero in @init, and Womb never touches it here.
// @block owns host_bpm now; seed a neutral value.
host_bpm     = 120;
// --- Tempo sync (R20/R21). The R11 shape that used to live here -- a
//     `Sync to host` switch, a `Host sync target` selector and a per-target
//     `Every N beats` bank -- was RETIRED 2026-09-05. Both rates now carry
//     their own complete R20 pair (a value, then a mode of
//     {BPM, Seconds, Hz, Every N beats, N per beat}), so there is nothing left
//     for a selector to reach across. The measurement that settled it: across
//     73 saved instances, all 27 synced ones targeted the sequencer and not one
//     targeted the pan -- the capability the selector existed for had never
//     been used, and the real gap was simply that the pan had no mode of its
//     own. One slider fixed that; three had been spent instead.
// NOT seq_synced / pan_synced. @init re-runs on every transport play and
// @slider does NOT, so zeroing them here left the sequence-placement gate
// false on every play press -- the placement never ran, and the instances
// started from the top of the sequence instead of from where the project
// says they are. They are derived in @block instead, below, which runs
// before the placement test in the same block.
pan_host_scale = 1;
host_scale   = 1;

// Memory layout per voice (16 slots each — V0 starts at the
// labelled base, voice i offsets by i; e.g., V3's osc_phase_l is
// at osc_phase_l[3] = base + 3).
osc_phase_l       = 0;
osc_phase_r       = 16;
voice_state       = 32;   // 0 = silent, 1 = attack, 2 = sustain, 3 = release
state_elapsed     = 48;   // seconds elapsed in current state
v_envelope        = 64;   // current envelope output, 0..1 (raw state-machine value)
v_freq_l          = 80;
v_freq_r          = 96;
// 240 is the next free 16-slot bank — see CLAUDE.md for the
// Polyrhythm Phase layout; we follow the same per-voice 16-slot
// convention.
v_env_smoothed    = 240;  // amplitude after the click-prevention one-pole smoother
// Pan (sliders 15-19, mirrored from Polyrhythm Phase).
pan_phase         = 256;  // per-voice pan LFO phase (Tremolo / Increment modes)
pan_smooth        = 272;  // smoothed pan position, -1..+1
v_pan_freq        = 288;  // cached pan LFO frequency (Hz)
v_pan_static      = 304;  // static pan target for Spread / Spread Reversed modes
// Glide / portamento (slider 60). Each voice tracks its currently-
// playing frequency (slides toward v_freq_l/r[i] over glide_time);
// the oscillator phase increment uses v_freq_current_l/r instead
// of v_freq_l/r directly so the pitch slides smoothly.
v_freq_current_l  = 320;
v_freq_current_r  = 336;
v_active          = 112;
v_semitones       = 128;
v_step_seconds    = 144;  // computed at @slider: step_length_cycles * cycle_seconds
v_note_seconds    = 160;  // computed at @slider: note_length_cycles * cycle_seconds
v_attack_seconds  = 176;  // attack_pct * note_seconds (clamped if att+rel > 100%)
v_release_seconds = 192;  // release_pct * note_seconds (clamped)
v_sustain_seconds = 208;  // note_seconds - attack - release
v_gain            = 224;  // linear gain, from dB

// Initialise per-voice state. Phases start at 0; states start
// silent. The sequencer's first tick will trigger V0's attack.
i = 0;
loop(8,
  osc_phase_l[i]       = 0;
  osc_phase_r[i]       = 0;
  voice_state[i]       = 0;
  state_elapsed[i]     = 0;
  v_envelope[i]        = 0;
  v_env_smoothed[i]    = 0;
  v_freq_l[i]          = 440;
  v_freq_r[i]          = 440;
  v_active[i]          = 0;
  v_semitones[i]       = 0;
  v_step_seconds[i]    = 1;
  v_note_seconds[i]    = 1;
  v_attack_seconds[i]  = 0.1;
  v_release_seconds[i] = 0.3;
  v_sustain_seconds[i] = 0.6;
  v_gain[i]            = 1;
  pan_phase[i]         = 0;
  pan_smooth[i]        = 0;
  v_pan_cycle_pos[i]   = 0;
  v_pan_freq[i]        = 1;
  v_pan_static[i]      = 0;
  v_freq_current_l[i]  = 440;
  v_freq_current_r[i]  = 440;
  i += 1;
);

// Glide / portamento state. Tracks the last triggered voice's
// target frequencies so the NEXT triggered voice can start its
// glide from there. have_prev_trigger guards the first-ever
// trigger (no previous voice to slide from — just snap so we
// don't sweep up from 0 Hz on the very first note).
// prev_seq_index also tracks WHICH voice was previously playing
// — needed for Legato glide to inherit envelope state and the
// oscillator phase from the previous voice on hand-off.
prev_trigger_freq_l = 440;
prev_trigger_freq_r = 440;
have_prev_trigger   = 0;
prev_seq_index      = -1;

// Sequencer global state. seq_index is the voice whose step is
// currently elapsing. seq_step_elapsed tracks how far into that
// step we are. seq_started=0 until we trigger the very first
// voice's attack; once started, the sequencer keeps advancing.
seq_index        = 0;
seq_step_elapsed = 0;
seq_started      = 0;
// Per-cycle pan runtime. Reset on every @init, so a transport play restarts the
// pan pattern along with the sequence, exactly like the filter plugins.
pan_cycle_index = 0;
pan_cycle_dir   = 1;
seq_finished     = 0;  // set when Loop=Off and we've walked off the end

// Direction state. seq_dir is +1 for Up walks, -1 for Down walks; it
// flips at pool boundaries in the bounce modes. bounce_count_total
// counts boundary crossings within a Loop=Off cycle so the sequence
// stops after a complete bounce (start → other end → back to start).
seq_dir            = 1;
bounce_count_total = 0;

// Start Delay state. start_delay_elapsed counts up from 0 at each
// play start; while it's below start_delay_sec the @sample work is
// gated and output is silent. start_delay_sec is computed in @slider
// from the user-facing units; default 0 means no delay.
// (last_play_state removed in v2.10 Path A — no transport-edge handler
// anymore; @init re-running on play is the reset.)
start_delay_elapsed = 0;
start_delay_sec     = 0;

// The sequencer must not start before this instance has been configured.
// @sample has no transport test (deliberately -- the plugin has to sound with
// the transport stopped), so on project load it begins advancing the moment
// audio flows, which can be BEFORE REAPER has handed over the saved slider
// values. In that window v_step_seconds is still @init's 1.0 and, in the
// pre-reorder build, host_scale was 1 instead of tempo/60 -- the TIME BASE
// itself was wrong, so the first note ran long by (1 - 1/host_scale) * T,
// with T differing per instance. Every note after it was correct, which left
// the instances permanently offset from each other by that one bad note.
//   Rozaya, 2026-09-02: "the first note failing to come in on beat, it was
//   much longer than the rest... and then when everything synced up, it
//   synced up in each instance's own time."
// This build already reads the sync state from the raw sliders in @block, so
// the host_scale half cannot happen here -- but v_step_seconds would still be
// 1.0, which fires the first handoff early instead. Same fault, other sign.
// cfg_ready is set in @block, the one section proved not to run before the
// instance is configured (2026-08-23, the restore-order fix), and it runs
// BEFORE @sample within the same block -- so this costs no audio, and it
// gates on CONFIGURATION, never on the transport.
cfg_ready = 0;
mel_ui_init = 0;
pm_prev = 0;
mo1_was = mo7_was = mo8_was = mo9_was = mo52_was = mo53_was = 0;

// How long after @init to prefer the remembered tempo over REAPER's live one.
// The measured placeholder window on a 12-track project was ~0.67 s; 2 s is
// comfortably past it and still short enough that an unsaved tempo change
// takes effect almost immediately. host_bpm_saved is deliberately NOT reset
// here -- @serialize owns it, and @init re-runs on every transport play.
// NOT named TEMPO_SETTLE_SEC: EEL2 folds case, so that IS
// tempo_settle_sec -- the constant and the counter would be one
// variable and the whole guard silently does nothing. Shipped that
// way once (75dca5b) and it was completely inert.
tempo_settle_limit = 2;
tempo_settle_sec = 0;

// --- Wait for the CONFIGURATION to settle, not just to arrive ---------------
// slider_ran is set by the FIRST @slider pass -- and on project load that pass
// runs with the DEFAULT slider values, before REAPER has handed over the saved
// ones. So it releases the sequencer too early and the first note runs on
// defaults: Rate mode Seconds, Rate value 1, a 1.0 s step where the project
// wants 0.585. Then the real values land and it snaps. That is the drag.
//
// The tell that pinned it (Rozaya, 2026-09-02): "the drag only shows up on
// project first-load, not alt+tab." Alt-tab is a SAMPLERATE CHANGE -- @init
// re-runs, but memory is not cleared (Cockos: a non-empty @serialize prevents
// that) and @slider does not re-run, so every derived value is already right
// and the sequencer restarts cleanly. First load is the only case where it
// starts on defaults.
//
// So: watch the values the sequencer actually uses, and hold until they have
// stopped moving. Deliberately NOT the raw sliders -- these are the derived
// numbers, identical in both builds, and they cover any layout.
cfg_sig       = -1;
cfg_stable    = 0;
CFG_HOLD_BLOCKS = 2;

// Play/Rest gate state. pr_step counts sequencer steps elapsed in
// the current play (or rest) period; threshold compare flips the
// period at each handoff. Init to 0 because the first trigger
// (inside seq_started == 0 branch) increments pr_step at the
// moment the first note fires — same "count notes that have fired"
// semantic as Heartbeat / Rhythm Track.
pr_resting     = 0;
pr_step        = 0;
play_for_steps = 0;
rest_for_steps = 0;
pr_enabled     = 0;

// Rest mode state. rest_mode = 0 → Walk through (sequencer advances
// during rest, current behavior). rest_mode = 1 → Freeze in place
// (sequencer pauses; rest is a sample-counted timer instead of a
// step counter). pr_frozen_prev_voice remembers the voice that was
// playing when Freeze rest started — used as the "prev_voice"
// argument to the trigger function when rest ends. The frozen
// "would-be-next" voice index lives in seq_index itself (we set it
// at the handoff above the PR check and never overwrite it during
// Freeze rest, since the sequencer advance is gated off).
rest_mode                = 0;
pr_rest_elapsed          = 0;
pr_rest_duration_samples = 0;
pr_frozen_prev_voice     = -1;

// Speed Ramp state. speed_scale_current carries the Rate-Value ramp+drift
// ratio into the audio path each sample; the per-target ramp clocks live in
// the speed_ramp_*_mem banks declared alongside the drift banks below.
// Engage is a freeze/resume gate, not an edge; only transport play resets
// the per-target clocks (via the @init runtime reset).
speed_scale_current = 1.0;

// NOTE what is deliberately NOT set here: rate_mode and rate_value. They are set
// only in the slider section, and seeding them here would CLOBBER the project's
// real rate on every transport play -- @init re-runs on play, the slider section
// does not. (Same trap as the remembered-reference-tempo bug.) The two
// consequences of them being 0 before the first slider pass are handled where
// they arise instead:
//   * @sample's `effective_rate_val_ramp / rate_value` was a division by zero.
//     EEL2 returns 0 for that, so speed_scale_current became 0, combined_scale
//     became 0, and dt became 0 -- seq_step_elapsed stopped advancing entirely.
//     The first note of a freshly loaded project therefore lasted for the WHOLE
//     window before the first slider pass, then snapped to its correct length.
//     Every note after it was right, so each instance ended up permanently
//     offset by however long its own window happened to be. That is the stagger.
//       Rozaya, 2026-09-02: "the first note failing to come in on beat. It was
//       much longer than the rest. And then, of course, when everything synced
//       up, it synced up in each instance's own time."
//     The symptom picks the direction for us: had EEL2 returned infinity there,
//     dt would be enormous and the sequence would rip through instantly. It was
//     slow. Now guarded with max(rate_value, 0.001) at the division itself.
//   * the sequencer must not start before the slider section has run at all,
//     which slider_ran (set there, never reset) answers exactly.
// NOT host-sync-specific and NOT new -- it is in every build back to before host
// sync. It hid wherever steps are long (upswing's are 4 s, so the freeze is a
// few percent) and is glaring in simple-sequence, whose steps are 0.585 s.

// --- v2.9 Drift target memory banks ---
//
// 28 targets × 8 fields. Each array is 32-slot-spaced (must exceed the
// target count, which is why this plugin uses 32 not the 16 the others
// use — 28 targets would overflow 16-slot arrays into each other).
// Placed at 512 — above the highest per-voice bank (v_freq_current_r
// at 336, ending at 351), with a safety gap.
//
// Targets:
//   0       = Rate Value      (units: rate's current unit)
//   1..8    = V1..V8 Timing    (units: cycles — "Next voice in")
//   9       = Pan Rate         (units: rate's current unit)
//   10..17  = V1..V8 Gain       (units: dB)
//   18..25  = V1..V8 Note dur   (units: cycles — "Note duration")
//   26      = Attack %          (units: %)
//   27      = Release %         (units: %)
N_TARGETS = 55;
target_drift_up     = 2048;
target_drift_down   = 2112;
target_drift_per    = 2176;
target_drift_shape  = 2240;
target_drift_phase  = 2304;
target_drift_prev   = 2368;
target_drift_curr   = 2432;
target_drift_offset = 2496;

// Speed Ramp per-target banks (v2.14 automation-replacement sweep).
// 32-slot-spaced like the drift banks (28 targets overflow 16-slot arrays),
// placed above target_drift_offset (736..763). by / duration / start-delay
// are CONFIG (survive transport re-init, restored by @serialize); ramp_t /
// delay_elapsed are RUNTIME (reset every @init / transport play).
speed_ramp_by_mem            = 2560;  // signed delta per target (CONFIG)
speed_ramp_dur_mem           = 2624;  // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 2688;  // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 2752;  // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 2816;
// Per-cycle pan: the position each voice was HANDED at its own trigger. Held
// for the life of that note, so a voice still releasing keeps where it was put
// instead of jumping when the next note advances the pattern.
v_pan_cycle_pos = 928;  // delay sample counter per target (RUNTIME)

// Drift and Ramp play/rest, per target (2026-09-05). 32-slot-spaced like every
// other per-target bank here. play/rest are CONFIG (survive a transport re-init,
// restored by @serialize); the accumulator and the resting flag are RUNTIME.
// FIRST FREE SLOT AFTER THIS BLOCK IS 1216 -- re-derive it rather than trusting
// this comment, with:
//   grep -nE '^[a-z_]+ *= *[0-9]{2,} *;' src/melody_phase.jsfx
drift_play_mem       = 2880;   // periods of drift to run   (CONFIG)
drift_rest_mem       = 2944;   // periods to hold frozen    (CONFIG)
sr_play_mem          = 3008;  // ramp time to advance      (CONFIG)
sr_rest_mem          = 3072;  // ramp time to hold         (CONFIG)
drift_pr_accum_mem   = 3136;  // (RUNTIME)
drift_pr_resting_mem = 3200;  // (RUNTIME)
sr_pr_accum_mem      = 3264;  // (RUNTIME)
sr_pr_resting_mem    = 3328;  // (RUNTIME)

// --- "your turn came round" flags, per target (2026-09-09) ------------------
// Next free slot after this one: 1248.
drift_step_mem       = 3392;
// Per-voice fine tune, in the unit at slider6. ABOVE everything else -- the
// first attempt put it at 144, which is v_step_seconds. Read the plugin's own
// map before choosing an offset; the numbers are not transferable between
// plugins in this suite.
v_fine               = 1280;  // (RUNTIME)
// 2026-09-10: the per-target banks are 64 apart at 2048..3519, for 55
// targets. These sit in the room the old banks left.
v_pan_freq_d         = 1296;  // pan LFO frequency while Pan increment drifts
mel_ln               = 1312;  // note-name mirror, per voice
mel_lv               = 1328;  // pitch-value mirror, per voice
// Scratch for reading a save made before 2026-09-10, 28 targets wide.
o_up = 4096; o_down = 4128; o_per = 4160; o_shape = 4192;
o_by = 4224; o_dur = 4256; o_delay = 4288;
o_play = 4320; o_rest = 4352; o_srplay = 4384; o_srrest = 4416; o_moves = 4448;
// Solo, 2026-09-10 (docs/layouts/solo-propagation-20260910.md): 1 = soloed, per voice.
v_solo = 4480;
target_drift_moves = 3456;   // CONFIG -- 0 with the target, 1 clock

// WHICH TARGETS STEP, AND WHICH FLOW.
//
// A target the engine reads ONCE PER EVENT was being sampled out of a wander
// that never stopped spinning: nearly all the motion was thrown away and the
// period did not count what it said it counted. Rozaya, 2026-09-09.
//
// Here that is targets 18-27, and ONLY those. This plugin says so itself, two
// hundred lines down: "Done ONCE per note here (not per-sample) -- a note's
// length and envelope shape are fixed for the duration of its ring."
//   18..25  V1-V8 Note duration -- each steps when ITS voice is triggered.
//   26, 27  Attack % / Release % -- shared, so they step on ANY note trigger.
//
// Everything else stays continuous, and that is not an oversight:
//   0       Rate value    -- its period is referenced against
//                            samples_per_primary_cycle, taken PRE-drift, so it
//                            never measures itself. (Womb's heart rate DID, and
//                            that is why Womb's steps and this does not.)
//   1..8    V Timing      -- the step boundary is a threshold compared every
//                            sample, so the wander is expressed, not sampled.
//   9       Pan base rate -- continuous.
//   10..17  V Gain        -- continuous, applied every sample.
function drift_is_stepped(idx) ( target_drift_moves[idx] == 0; );

// Drift CONFIG (up/down/period/shape) + selector tracker — initialized
// ONCE per plugin instance, guarded by drift_cfg_inited so @init
// re-running on every transport play does NOT wipe the user's drift
// setup. A fresh instance starts with drift_cfg_inited = 0 (REAPER
// zeroes memory on instantiation); @serialize restores saved configs
// on project load.
drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_TARGETS,
    target_drift_up[i]    = 0;
    target_drift_down[i]  = 0;
    target_drift_per[i]   = 8;
    target_drift_shape[i] = 0;
    // Stepped by default: Transpose, Attack, Release, Play for, Rest for, and
    // each voice's Pitch, Fine tune and Note duration.
    target_drift_moves[i] = (i == 3 || i == 5 || i == 6 || i == 53 || i == 54 ||
      (i >= 12 && i <= 51 && ((i - 12) % 5 == 0 || (i - 12) % 5 == 1 || (i - 12) % 5 == 3))) ? 0 : 1;
    speed_ramp_by_mem[i]    = 0;
    speed_ramp_dur_mem[i]   = 0;
    speed_ramp_delay_mem[i] = 0;
    drift_play_mem[i] = 0; drift_rest_mem[i] = 0;
    sr_play_mem[i]    = 0; sr_rest_mem[i]    = 0;
    i += 1;
  );
  last_target_select = 0;
  last_sr_target     = 0;
  drift_cfg_inited = 1;
);

// Drift RUNTIME (phase / random-shape targets / computed offset) resets
// on EVERY @init — i.e. every transport play — so drift restarts from
// phase 0 each play, continues across stop, and is clean on render.
i = 0;
loop(N_TARGETS,
  target_drift_phase[i]  = 0;
  target_drift_prev[i]   = 0;
  target_drift_curr[i]   = 0;
  target_drift_offset[i] = 0;
  drift_step_mem[i]      = 0;
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  drift_pr_accum_mem[i]   = 0; drift_pr_resting_mem[i] = 0;
  sr_pr_accum_mem[i]      = 0; sr_pr_resting_mem[i]    = 0;
  i += 1;
);

// One-pole exponential smoother coefficient for the envelope
// output. Polyrhythm Phase uses this exact pattern: the raw
// state-machine envelope value (which can step instantly when
// attack% or release% is 0) gets fed through a smoother before
// being applied to the oscillator, so the actual amplitude ramps
// up over ~3ms instead of jumping in a single sample. That's
// what eliminates the click on attack=0 / release=0 / rest
// transitions without forcing the user-set attack/release
// percentages to be non-zero. exp(-1/(srate * 0.003)) gives a
// ~3ms time constant: after 3ms, the smoother is ~63% of the
// way to the new target.
smooth_coeff = exp(-1 / (srate * 0.003));

// One voice's frequency. The value IS the pitch, in the plugin's Pitch mode:
// Hz, the MIDI note (Semitones), or that times 100 (Cents). Transpose and
// Octave shift move every voice; the fine tune sits on top in its own unit.
// In Semitones this is the same integer exponent the old note picker made,
// so a migrated voice lands on exactly the same frequency.
function voice_hz(pv, pmode, pfine, punit, pref, ptr, poct) local(h) (
  h = pmode == 1 ? pref * pow(2, (pv + ptr + 12 * poct - 69) / 12.0) :
      pmode == 2 ? pref * pow(2, (pv / 100 + ptr + 12 * poct - 69) / 12.0) :
                   pv * pow(2, (ptr + 12 * poct) / 12.0);
  pfine != 0 ? (
    h = punit == 0 ? h + pfine :
        punit == 1 ? h * pow(2, pfine / 12) :
                     h * pow(2, pfine / 1200);
  );
  h;
);
function mel_old_to_new(t) (
  t == 0 ? 0 : t <= 8 ? 14 + 5 * (t - 1) : t == 9 ? 10 :
  t <= 17 ? 16 + 5 * (t - 10) : t <= 25 ? 15 + 5 * (t - 18) : t == 26 ? 5 : 6;
);

function apply_curve(t, shape) (
  shape == 0 ? t :
  shape == 1 ? (0.5 - 0.5 * cos(t * $pi)) :
  shape == 2 ? (log(1 + 9*t) / log(10)) :
               ((pow(10, t) - 1) / 9)
);

function rate_to_cycle_seconds(raw_rate, rmode) (
  // Convert the user's Rate Value + Rate Mode into seconds-per-cycle.
  // BPM:  60 / value     (60 BPM = 1 cycle/sec, so 1 sec/cycle)
  // Sec:  value          (literal seconds per cycle — default mode,
  //                      so per-voice "cycles" are directly seconds
  //                      when Rate Value is left at 1)
  // Hz:   1 / value      (cycles/sec inverted to sec/cycle)
  // Synced: `Every N beats` is used instead, held against a NOMINAL 60 BPM so it stays
  //         tempo-INDEPENDENT. The live project tempo is applied separately
  //         as host_scale (= tempo / 60) in @block, and the two multiply out
  //         (Host x was rate mode 3 until 2026-09-01; sync is now its own
  //         switch, and a synced target takes its cycle length from
  //         `Every N beats` instead of from this function.)
  //
  //         Keeping the tempo OUT of here is the whole trick. @init re-runs
  //         on every transport play and wipes globals, so an earlier version
  //         that remembered "the tempo this derivation was computed against"
  //         had that reference reset on play while the frozen step/note
  //         seconds still described the OLD tempo — pressing play silently
  //         threw the tempo change away. Nothing to remember, nothing to go
  //         stale.
  // R21, and this is the EXACT chain -- "which mode am I", never widened to
  // `>= 3`. The two host modes are held against a NOMINAL 60 BPM, where one
  // beat is one second, so:
  //   Every N beats (3): N beats per cycle -> N nominal seconds. Identical
  //                      arithmetic to Seconds, which is why they share a line.
  //   N per beat    (4): N cycles per beat -> 1/N nominal seconds. Identical
  //                      arithmetic to Hz, which is why it falls through.
  // The two are reciprocals of each other by construction, and the live tempo
  // is applied separately as host_scale in @block -- so mode 3 and mode 4 are
  // the same conversion the free modes already use, plus a multiply.
  rmode == 0 ? 60 / max(raw_rate, 0.001) :
  (rmode == 1 || rmode == 3) ? max(raw_rate, 0.001) :
               1 / max(raw_rate, 0.001)
);

// PolyBLEP: band-limited step correction for the Square and Pulse
// waveforms (slots 12-13). At each discontinuity the naive wave jumps
// instantly, which is infinite bandwidth and aliases badly. This adds a
// small correction over the one sample either side of the edge. bdt is
// the phase increment per sample, so the correction scales with pitch.
// Returns 0 away from an edge, so it costs nothing for other waveforms.
function polyblep(bt, bdt) local(bs) (
  bt < bdt ? (
    bs = bt / bdt;
    bs + bs - bs * bs - 1;
  ) : bt > 1 - bdt ? (
    bs = (bt - 1) / bdt;
    bs * bs + bs + bs + 1;
  ) : (
    0;
  );
);

function db_to_lin(db) (
  pow(10, db / 20)
);

// Shared play/rest gate for Drift and Ramp, byte-identical to the one in the
// Sweeping Filter, Tremolo, Phaser, Bubbler, Dapple, Resonance Bank and the
// Morpher -- a thing learned on one plugin has to be true of all of them.
//
// `tick` is how much of one play/rest unit passes per sample, so the caller
// decides the unit (drift periods, or ramp time units) and this stays unitless.
// Returns 1 while the target is resting. Both play and rest must be above zero
// or the gate is off entirely, which is what makes 0 mean "always".
function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

function count_active_voices() local(n, j) (
  n = 0;
  j = 0;
  loop(8,
    (v_active[j] || (any_solo && v_solo[j])) ? n += 1;
    j += 1;
  );
  n
);

function next_active_voice(start, dir) local(j, tries) (
  // Walk from `start` (inclusive) in direction `dir` looking for
  // the next voice with v_active=1. Wraps around the pool
  // [0, seq_length_eff) if needed. Returns -1 if no active voice
  // exists anywhere in the pool.
  j = start;
  tries = 0;
  loop(8,
    j >= seq_length_eff ? j = 0;
    j < 0 ? j = seq_length_eff - 1;
    (v_active[j] || (any_solo && v_solo[j])) ? ( tries = 999; ); // sentinel to break out
    tries == 999 ? 0 : ( j += dir; tries += 1; );
  );
  tries == 999 ? j : -1
);

function step_in_dir_no_wrap(cur_idx, dir) local(j, found) (
  // Walk one step at a time in direction `dir` from cur_idx + dir,
  // looking for an active voice WITHIN the pool [0, seq_length_eff)
  // without wrapping. Returns the active voice's index, or -1 if we
  // crossed a pool boundary without finding one. Bounce modes use
  // the -1 return as the signal to flip direction.
  j = cur_idx + dir;
  found = -1;
  loop(8,
    found < 0 && j >= 0 && j < seq_length_eff && (v_active[j] || (any_solo && v_solo[j])) ? found = j;
    found < 0 ? j += dir;
  );
  found
);

function simulate_rest_duration_seconds(start_idx, num_steps)
local(saved_dir, saved_bounce, sim_idx, total_sec, ran_out, next_idx, wrap_start) (
  // Simulate exactly what Walk mode would do for the next num_steps
  // handoffs starting from start_idx, summing each visited voice's
  // "Next voice in" — returns the total wall-clock seconds. Used by
  // Freeze mode at rest entry so its rest duration matches the Walk
  // equivalent, instead of just being num_steps × the frozen voice's
  // step duration (which only matches when all active voices share
  // the same Next voice in).
  //
  // Mirrors the bounce_active / loop_enabled / bounce_is_repeat
  // branches from the real handoff logic. Temporarily mutates
  // seq_dir and bounce_count_total via step_in_dir_no_wrap calls
  // and the bounce flips below; saved at the top and restored at
  // the bottom so the actual sequencer state is untouched.
  //
  // If the simulated walk would hit a hard stop (Loop=Off bounce
  // completed, or Loop=Off Up/Down past the pool edge), ran_out is
  // set and the loop stops counting. The returned duration is the
  // partial sum — meaning Freeze mode's rest will end earlier than
  // num_steps × something in that case. That matches Walk mode's
  // actual behavior (Walk hits seq_finished and the gate stops
  // exiting rest), with the caveat that Freeze still cleanly resumes
  // when its timer expires while Walk would just stay finished.
  saved_dir = seq_dir;
  saved_bounce = bounce_count_total;
  sim_idx = start_idx;
  total_sec = 0;
  ran_out = 0;
  loop(num_steps,
    ran_out ? 0 : (
      total_sec += v_step_seconds[sim_idx];
      next_idx = step_in_dir_no_wrap(sim_idx, seq_dir);
      next_idx < 0 ? (
        bounce_active ? (
          seq_dir = -seq_dir;
          bounce_count_total += 1;
          !loop_enabled && bounce_count_total >= 2 ? (
            ran_out = 1;
          ) : (
            bounce_is_repeat ? (
              next_idx = sim_idx;
            ) : (
              next_idx = step_in_dir_no_wrap(sim_idx, seq_dir);
              next_idx < 0 ? ran_out = 1;
            );
            bounce_count_total >= 2 ? bounce_count_total = 0;
          );
        ) : (
          loop_enabled ? (
            wrap_start = seq_dir > 0 ? 0 : seq_length_eff - 1;
            next_idx = next_active_voice(wrap_start, seq_dir);
            next_idx < 0 ? ran_out = 1;
          ) : (
            ran_out = 1;
          );
        );
      );
      !ran_out ? sim_idx = next_idx;
    );
  );
  seq_dir = saved_dir;
  bounce_count_total = saved_bounce;
  total_sec
);

// ---------------------------------------------------------------------------
// Per-cycle pan. Behaviour PORTED from the sweeping filter / sweep dwell /
// tremolo pan block so the same mode NAMES mean the same thing across the
// suite -- the concept already existed in four plugins and the oscillator
// plugins were the ones missing it. Only the TICK differs: there it advances
// on the filter LFO wrap, here on the NOTE TRIGGER. That is
// the point of it -- the pan moves because the sound did, so there is no
// second clock to fall out of step with, and nothing to hand-match.
//
// The filter numbers these 1-9 with Mono at 0. Here they are appended after
// this plugin's existing four modes, so pan_mode 4..12 maps onto its 1..9 --
// hence the -3. Modes 0-3 are untouched and no saved project moves.
function percycle_pan(idx, n_steps) local(steps, step, pos, m) (
  n_steps = max(n_steps, 1);
  steps   = max(ceil((n_steps - 1) / 2.0), 1);
  m       = pan_mode - 3;

  m == 1 ? (
    pos = (idx % 2 == 0) ? -1 : 1;
  ) : m == 2 ? (
    pos = (idx % 2 == 0) ? 1 : -1;
  ) : m == 3 ? (
    n_steps > 1 ? (pos = (idx % n_steps) / (n_steps - 1.0) * 2.0 - 1.0) : (pos = 0);
  ) : m == 4 ? (
    n_steps > 1 ? (pos = 1.0 - (idx % n_steps) / (n_steps - 1.0) * 2.0) : (pos = 0);
  ) : m == 5 ? (
    n_steps > 1 ? (pos = idx / (n_steps - 1.0) * 2.0 - 1.0) : (pos = 0);
  ) : (m == 6 || m == 7) ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = -1.0;
    ) : (
      step = ceil((idx + 1) / 2);
      pos = (idx % 2 == 1) ?  (1.0 - (step - 1.0) / steps)
                            : -(1.0 - (step - 1.0) / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : (m == 8 || m == 9) ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = 0.0;
    ) : (
      step = floor((idx + 1) / 2);
      pos = (idx % 2 == 1) ? -(step / steps)
                            :  (step / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : (m == 10 || m == 11 || m == 12) ? (
    // Alternating every N. Same flip, but it holds each side for N cycles --
    // so bilateral stays usable when the notes themselves are fast. Still
    // driven by the cycle, so it lands exactly on the boundaries.
    step = m == 10 ? 2 : m == 11 ? 4 : 8;
    pos  = (floor(idx / step) % 2 == 0) ? -1 : 1;
  ) : (
    pos = 0;
  );

  pos * pan_spread
);

function trigger_seq_voice(prev_idx) (
  // Fire whatever voice seq_index points to. Shared by three call
  // sites: the first-ever trigger (seq_started == 0 branch, passes
  // prev_idx = -1), the normal handoff (passes the just-replaced
  // prev_seq_index), and Freeze-mode rest exit (passes the saved
  // pr_frozen_prev_voice). Encapsulates the Legato handoff branch,
  // the glide source setup, and the prev_trigger_freq bookkeeping
  // so all three sites stay in sync.
  // Per-cycle pan advances HERE, on the note trigger -- which is what makes
  // these modes immune to the drift that a separate tremolo plugin suffers:
  // the pan moves because a note started, not because a clock said so.
  // Deliberately ABOVE the note-length test, so a rest still consumes its
  // place in the pattern; otherwise the alternation inverts at every rest.
  // Ping-pong modes are 8 / 10 / 12 here, the filter's 5 / 7 / 9.
  pan_mode >= 4 ? (
    (pan_mode == 8 || pan_mode == 10 || pan_mode == 12) ? (
      pan_cycle_index += pan_cycle_dir;
      (pan_cycle_index >= pan_cycle_mod - 1 || pan_cycle_index <= 0) ?
        pan_cycle_dir = -pan_cycle_dir;
    ) : (
      pan_cycle_index = (pan_cycle_index + 1) % pan_cycle_mod;
    );
    v_pan_cycle_pos[seq_index] = percycle_pan(pan_cycle_index, pan_cycle_steps);
  );

  // A note's turn comes round. The voice's own Note duration steps, and the
  // shared Attack/Release step too, because they are read at every trigger.
  // Raised whether or not this voice sounds -- a rest still takes its place in
  // the pattern, exactly as a silenced beat still takes its place in Womb.
  drift_step_mem[12 + 5 * seq_index] = 1;   // this voice's Pitch
  drift_step_mem[13 + 5 * seq_index] = 1;   // its Fine tune
  drift_step_mem[15 + 5 * seq_index] = 1;   // its Note duration
  drift_step_mem[3] = 1;  drift_step_mem[5] = 1;  drift_step_mem[6] = 1;
  drift_step_mem[53] = 1; drift_step_mem[54] = 1;

  v_note_seconds[seq_index] > 0.0001 ? (
    // Sample this note's expressive drift at trigger time and recompute
    // its envelope segments. Note duration drift (targets 18-25, in
    // cycles → seconds via cycle_seconds) wanders how long the note
    // rings; Attack % (26) / Release % (27) drift wander the onset and
    // tail. Done ONCE per note here (not per-sample) — a note's length
    // and envelope shape are fixed for the duration of its ring, which
    // is the musically-correct granularity for articulation. The
    // formula mirrors @slider's segment computation, on the drifted
    // values. The rest-gate above uses BASE v_note_seconds, so a
    // base-rest voice (Note duration 0) stays a rest regardless of drift.
    // Drift AND Speed Ramp offsets both sampled here at trigger (once per
    // note): note dur (18-25) in cycles, Attack % (26) / Release % (27) in
    // percent. Speed Ramp offset for target t = ramp_t[t] * by[t]; read at
    // this site so a note's length/shape stay fixed for its whole ring,
    // exactly like drift.
    eff_note_sec = max(v_note_seconds[seq_index] + (target_drift_offset[15 + 5 * seq_index] + speed_ramp_ramp_t_mem[15 + 5 * seq_index] * speed_ramp_by_mem[15 + 5 * seq_index]) * cycle_seconds, 0);
    eff_att_pct  = max(0, min(1, attack_pct  + (target_drift_offset[5] + speed_ramp_ramp_t_mem[5] * speed_ramp_by_mem[5]) * 0.01));
    eff_rel_pct  = max(0, min(1, release_pct + (target_drift_offset[6] + speed_ramp_ramp_t_mem[6] * speed_ramp_by_mem[6]) * 0.01));
    att_t = eff_att_pct * eff_note_sec;
    rel_t = eff_rel_pct * eff_note_sec;
    att_t + rel_t > eff_note_sec ? (
      total = att_t + rel_t;
      total > 0 ? (
        att_t = att_t / total * eff_note_sec;
        rel_t = rel_t / total * eff_note_sec;
      );
    );
    v_attack_seconds[seq_index]  = att_t;
    v_release_seconds[seq_index] = rel_t;
    v_sustain_seconds[seq_index] = max(0, eff_note_sec - att_t - rel_t);

    legato_enabled && prev_idx >= 0 && voice_state[prev_idx] != 0 ? (
      v_envelope[seq_index]     = v_envelope[prev_idx];
      v_env_smoothed[seq_index] = v_env_smoothed[prev_idx];
      osc_phase_l[seq_index]    = osc_phase_l[prev_idx];
      osc_phase_r[seq_index]    = osc_phase_r[prev_idx];
      pan_smooth[seq_index]     = pan_smooth[prev_idx];
      pan_phase[seq_index]      = pan_phase[prev_idx];
      voice_state[seq_index]    = 2;
      state_elapsed[seq_index]  = 0;
      voice_state[prev_idx]     = 0;
      v_envelope[prev_idx]      = 0;
      v_env_smoothed[prev_idx]  = 0;
    ) : (
      voice_state[seq_index]    = 1;
      state_elapsed[seq_index]  = 0;
    );
    have_prev_trigger ? (
      v_freq_current_l[seq_index] = prev_trigger_freq_l;
      v_freq_current_r[seq_index] = prev_trigger_freq_r;
    ) : (
      v_freq_current_l[seq_index] = v_freq_l[seq_index];
      v_freq_current_r[seq_index] = v_freq_r[seq_index];
      have_prev_trigger = 1;
    );
    prev_trigger_freq_l = v_freq_l[seq_index];
    prev_trigger_freq_r = v_freq_r[seq_index];
    prev_seq_index = seq_index;
  );
);

@slider
// The slider section has now run at least once for this instance. Never reset:
// @init re-running on transport play must not re-arm it, because the slider
// section does NOT re-run on play and the sequencer would never start again.
slider_ran = 1;
rate_mode     = slider2;

rate_value    = slider1;

// --- Host sync (R20/R21) ---------------------------------------------------
// A rate follows the project tempo when its OWN mode says so. Modes 3 and 4 are
// the two host modes -- `Every N beats` and `N per beat` -- and they are
// reciprocals of each other, so the mode picks which end of your music is
// arithmetic-free rather than making you invert a number.
//
// The gate is `>= 3`, not `== 3`, and that distinction is the whole of R21: a
// test meaning "am I host-synced" widens, while a conversion chain asking
// "which mode am I" stays exact. rate_to_cycle_seconds() is the exact one; this
// is the widened one.
//
// Nothing is seeded or converted when the mode changes. Melody's R11 shape used
// to hand the rate slider a fresh number on entering and leaving sync, which is
// a control writing into another control -- forbidden by R20, and unnecessary
// once each rate owns its own unit.
seq_synced = rate_mode >= 3;
waveform      = slider3;
// Pulse duty as a 0..1 fraction of the cycle. Only read by waveform
// slot 13, and the slider only shows there.
pulse_duty    = slider4 * 0.01;
pulse_duty_base = pulse_duty;
slider_show(slider4, waveform == 13);
tuning_ref    = slider7;
// Transpose and Octave shift, feeding the same conversion Root note and Center
// octave used to. Polyrhythm v3's arrangement exactly: base_note is a signed
// half-step offset rather than a pitch class, and Octave shift is the octave
// measured from 4, so 0 / 0 leaves the note names literally true.
base_note     = slider8;
oct_shift     = slider9;
pitch_mode    = slider5;
mel_ui_init && slider5 == 1 ? (
  slider28 != mel_ln[0] ? ( slider29 = slider28; slider_automate(slider29); ) :
  slider29 != mel_lv[0] ? ( slider28 = max(0, min(127, floor(slider29 + 0.5))); slider_automate(slider28); );
);
mel_ln[0] = slider28; mel_lv[0] = slider29;
slider_show(slider28, slider5 == 1);
mel_ui_init && slider5 == 1 ? (
  slider36 != mel_ln[1] ? ( slider37 = slider36; slider_automate(slider37); ) :
  slider37 != mel_lv[1] ? ( slider36 = max(0, min(127, floor(slider37 + 0.5))); slider_automate(slider36); );
);
mel_ln[1] = slider36; mel_lv[1] = slider37;
slider_show(slider36, slider5 == 1);
mel_ui_init && slider5 == 1 ? (
  slider44 != mel_ln[2] ? ( slider45 = slider44; slider_automate(slider45); ) :
  slider45 != mel_lv[2] ? ( slider44 = max(0, min(127, floor(slider45 + 0.5))); slider_automate(slider44); );
);
mel_ln[2] = slider44; mel_lv[2] = slider45;
slider_show(slider44, slider5 == 1);
mel_ui_init && slider5 == 1 ? (
  slider52 != mel_ln[3] ? ( slider53 = slider52; slider_automate(slider53); ) :
  slider53 != mel_lv[3] ? ( slider52 = max(0, min(127, floor(slider53 + 0.5))); slider_automate(slider52); );
);
mel_ln[3] = slider52; mel_lv[3] = slider53;
slider_show(slider52, slider5 == 1);
mel_ui_init && slider5 == 1 ? (
  slider60 != mel_ln[4] ? ( slider61 = slider60; slider_automate(slider61); ) :
  slider61 != mel_lv[4] ? ( slider60 = max(0, min(127, floor(slider61 + 0.5))); slider_automate(slider60); );
);
mel_ln[4] = slider60; mel_lv[4] = slider61;
slider_show(slider60, slider5 == 1);
mel_ui_init && slider5 == 1 ? (
  slider68 != mel_ln[5] ? ( slider69 = slider68; slider_automate(slider69); ) :
  slider69 != mel_lv[5] ? ( slider68 = max(0, min(127, floor(slider69 + 0.5))); slider_automate(slider68); );
);
mel_ln[5] = slider68; mel_lv[5] = slider69;
slider_show(slider68, slider5 == 1);
mel_ui_init && slider5 == 1 ? (
  slider76 != mel_ln[6] ? ( slider77 = slider76; slider_automate(slider77); ) :
  slider77 != mel_lv[6] ? ( slider76 = max(0, min(127, floor(slider77 + 0.5))); slider_automate(slider76); );
);
mel_ln[6] = slider76; mel_lv[6] = slider77;
slider_show(slider76, slider5 == 1);
mel_ui_init && slider5 == 1 ? (
  slider84 != mel_ln[7] ? ( slider85 = slider84; slider_automate(slider85); ) :
  slider85 != mel_lv[7] ? ( slider84 = max(0, min(127, floor(slider85 + 0.5))); slider_automate(slider84); );
);
mel_ln[7] = slider84; mel_lv[7] = slider85;
slider_show(slider84, slider5 == 1);

loop_enabled  = slider27;
master_gain   = db_to_lin(slider92);
binaural_hz   = slider10;
attack_pct    = slider11 / 100;
release_pct   = slider13 / 100;
attack_shape  = slider12;
release_shape = slider14;
seq_length_cfg = slider25;
pan_enabled    = slider17;
pan_mode       = slider18;

pan_spread     = slider19 / 100;
pan_spread_base = pan_spread;
pan_base_rate  = slider22;
// The pan's own rate mode, and its own sync gate. `>= 3` is the widened
// "am I host-synced" test (R21); the exact "which mode am I" question is asked
// only inside rate_to_cycle_seconds().
pan_rate_mode  = slider23;
pan_synced     = pan_rate_mode >= 3;
pan_increment  = slider24;
glide_time     = slider15;
legato_enabled = slider16;
// Glide coefficient: one-pole smoother applied per sample to
// v_freq_current_l/r, with glide_time as the time constant.
// When glide_time = 0 we just snap (handled inline at the
// @sample step), so glide_coeff doesn't need a safe value
// for the glide_time = 0 case; compute defensively anyway.
glide_coeff   = glide_time > 0.0001 ? exp(-1 / max(srate * glide_time, 1)) : 0;
glide_coeff_base = glide_coeff;
glide_time_eff = glide_time;
// Pan smoother coefficient. Default 10ms for snappy-but-click-free
// pan transitions; matches Polyrhythm Phase. In Legato mode with
// Glide > 0, slow it down to match the glide time so pan moves
// at the same perceived speed as pitch — otherwise pan finishes
// its transition in 10-30ms while pitch is still gliding for
// hundreds of ms, which the listener hears as two separate
// transitions at different rates (the pan one feels like a
// sharp position change against the slower pitch slide). Tying
// them together makes the whole transition feel like one
// coherent slide. Floor stays at 10ms so non-Legato use and
// Glide-off still get the snappy-but-click-free behavior.
// Pan glide. Was hardcoded at 10 ms here while Full Feature Tremolo and both
// sweeping filters exposed it -- and 0 (an instant switch) is a genuinely
// different result, not a nicety: bilateral alternation is meant to be a cut,
// not a sweep. Default 10 reproduces the old behaviour exactly, including the
// legato coupling; only an explicit 0 overrides it, so a legato project can
// still reach a hard switch if it asks for one.
pan_glide_sec   = slider20 / 1000;
pan_smooth_time = pan_glide_sec <= 0 ? 0 :
  ((legato_enabled && glide_time > 0.0001) ? max(pan_glide_sec, glide_time) : pan_glide_sec);
pan_smooth_coeff_global = pan_smooth_time <= 0 ? 0 : exp(-1 / (srate * pan_smooth_time));
pan_smooth_coeff_base = pan_smooth_coeff_global;

// Synced: the cycle is `Every N beats`, held as NOMINAL seconds (beats at 60
// BPM) with the live tempo applied as host_scale in @block. That is exactly
// the arrangement Host x used, and the one the sequence placement below relies
// on, because it makes seq_step_elapsed and v_step_seconds both read in beats.
cycle_seconds = rate_to_cycle_seconds(rate_value, rate_mode);

// Effective sequence length: "All Active" (0) means walk all 8
// voice slots and skip the inactive ones; 1..8 truncates the
// sequence to the first N voice slots (still skipping inactives
// within that range).
seq_length_eff = seq_length_cfg == 0 ? 8 : seq_length_cfg;

// Cache per-voice values. Step / Note lengths convert from cycles
// to seconds via the global cycle_seconds.
i = 0;
loop(8,
  // The voice's Pitch value, in the plugin's Pitch mode. Transpose and Octave
  // shift are applied in voice_hz, so the three compose.
  i == 0 ? ( v_semitones[i] = slider29; v_fine[i] = slider30; v_step_cycles = slider31; v_note_cycles = slider32; v_gain_db = slider33; v_active[i] = slider34; v_solo[i] = slider35; );
  i == 1 ? ( v_semitones[i] = slider37; v_fine[i] = slider38; v_step_cycles = slider39; v_note_cycles = slider40; v_gain_db = slider41; v_active[i] = slider42; v_solo[i] = slider43; );
  i == 2 ? ( v_semitones[i] = slider45; v_fine[i] = slider46; v_step_cycles = slider47; v_note_cycles = slider48; v_gain_db = slider49; v_active[i] = slider50; v_solo[i] = slider51; );
  i == 3 ? ( v_semitones[i] = slider53; v_fine[i] = slider54; v_step_cycles = slider55; v_note_cycles = slider56; v_gain_db = slider57; v_active[i] = slider58; v_solo[i] = slider59; );
  i == 4 ? ( v_semitones[i] = slider61; v_fine[i] = slider62; v_step_cycles = slider63; v_note_cycles = slider64; v_gain_db = slider65; v_active[i] = slider66; v_solo[i] = slider67; );
  i == 5 ? ( v_semitones[i] = slider69; v_fine[i] = slider70; v_step_cycles = slider71; v_note_cycles = slider72; v_gain_db = slider73; v_active[i] = slider74; v_solo[i] = slider75; );
  i == 6 ? ( v_semitones[i] = slider77; v_fine[i] = slider78; v_step_cycles = slider79; v_note_cycles = slider80; v_gain_db = slider81; v_active[i] = slider82; v_solo[i] = slider83; );
  i == 7 ? ( v_semitones[i] = slider85; v_fine[i] = slider86; v_step_cycles = slider87; v_note_cycles = slider88; v_gain_db = slider89; v_active[i] = slider90; v_solo[i] = slider91; );

  v_step_seconds[i] = max(v_step_cycles * cycle_seconds, 0.001);
  v_note_seconds[i] = max(v_note_cycles * cycle_seconds, 0);
  v_gain[i] = db_to_lin(v_gain_db);

  // Frequency: voice's note at the configured tuning.
  // L channel uses the base frequency; R channel adds the binaural
  // offset (in Hz, applied to R only). When binaural_hz=0, L and R
  // run at identical frequencies — same shape as Polyrhythm Phase.
  hz_base = voice_hz(v_semitones[i], pitch_mode, v_fine[i], slider6, tuning_ref, base_note, oct_shift);
  v_freq_l[i] = hz_base;
  v_freq_r[i] = hz_base + binaural_hz;

  // Recompute envelope segment durations from the new note length.
  // attack+release together can't exceed the note duration; if the
  // user set both high (90%+90%), scale them proportionally to fit.
  att_t = attack_pct * v_note_seconds[i];
  rel_t = release_pct * v_note_seconds[i];
  att_t + rel_t > v_note_seconds[i] ? (
    total = att_t + rel_t;
    total > 0 ? (
      att_t = att_t / total * v_note_seconds[i];
      rel_t = rel_t / total * v_note_seconds[i];
    );
  );
  // No anti-click floor here on purpose — the @sample loop runs
  // the raw envelope through a one-pole smoother (smooth_coeff)
  // before applying it to the oscillator, which handles the
  // 0-duration ramp case the same way Polyrhythm Phase does.
  // Forcing a minimum ramp here would let a user's "attack = 0"
  // setting silently become "attack = 3ms" — annoying when the
  // user actually wanted a percussive transient.
  v_attack_seconds[i]  = att_t;
  v_release_seconds[i] = rel_t;
  v_sustain_seconds[i] = max(0, v_note_seconds[i] - att_t - rel_t);

  i += 1;
);

// Pan: per-voice LFO frequency for Tremolo / Increment modes.
// Tremolo: every voice pans at Pan Base Rate (same as PRP's
// "use the voice's tremolo rate" idea, except this plugin has
// no per-voice tremolo rate — the sequencer IS the rhythm, so
// we collapse to a single shared pan rate here).
// Increment: voice i pans at Pan Base Rate + i * Pan Increment.
// Spread / Spread Reversed: pan position is static (computed
// below), pan frequency is unused.
i = 0;
loop(8,
  pan_mode == 1 ? (
    pan_rate_i = pan_base_rate + pan_increment * i;
    pan_cycle_sec = rate_to_cycle_seconds(pan_rate_i, pan_rate_mode);
    v_pan_freq[i] = pan_cycle_sec > 0 ? 1 / pan_cycle_sec : 0;
  ) : (
    pan_cycle_sec = rate_to_cycle_seconds(pan_base_rate, pan_rate_mode);
    v_pan_freq[i] = pan_cycle_sec > 0 ? 1 / pan_cycle_sec : 0;
  );
  i += 1;
);

// Solo. A soloed voice joins the pattern even with Active off -- Rozaya: "Sollowing
// things that are switched off should bring them on anyway, that's the point of
// sollow" -- and a voice that is not soloed keeps its turn but makes no sound.
any_solo = 0;
i = 0; loop(8, v_solo[i] ? any_solo = 1; i += 1;);

// Static pan positions for Spread / Spread Reversed modes.
// Rank active voices and place evenly across the stereo field.
// Mirrors Polyrhythm Phase's implementation exactly.
total_active = 0;
i = 0;
loop(8,
  (any_solo ? v_solo[i] : v_active[i]) ? total_active += 1;
  i += 1;
);

// How many positions the Distributed / Converging / Diverging walks step
// through. This is a TEMPORAL pattern length and has nothing to do with how
// many voices exist -- deriving it from the active voice count was wrong, and
// collapsed all seven walk modes into Alternating whenever few voices were up.
// Spread uses the voice count because Spread ranks VOICES across the field;
// that is a different question with a coincidentally similar answer.
pan_cycle_steps = max(2, slider21);
// The every-N alternations count in their own pattern length (2N), not in
// voices -- otherwise a four-voice project could never reach the second half
// of an "every 4" and would sit on one side forever.
pan_cycle_mod = pan_mode == 13 ? 4 : pan_mode == 14 ? 8 : pan_mode == 15 ? 16 : pan_cycle_steps;
(pan_mode == 2 || pan_mode == 3) ? (
  rank = 0;
  i = 0;
  loop(8,
    (any_solo ? v_solo[i] : v_active[i]) ? (
      total_active > 1 ? (
        pos = -1.0 + 2.0 * rank / (total_active - 1);
      ) : (
        pos = 0;
      );
      pan_mode == 3 ? pos = -pos;
      v_pan_static[i] = pos;
      rank += 1;
    ) : (
      v_pan_static[i] = 0;
    );
    i += 1;
  );
);

// Show pan sub-sliders only when pan is enabled, and only the
// ones relevant to the chosen mode (matches PRP's UX).
slider_show(slider18, pan_enabled);
// Shown for every per-cycle mode from Alternating up, matching the filters.
// It is NOT only the walks: the cycle index wraps at Cycle Steps, so an ODD
// value makes Alternating limp -- 0,1,2,0,1,2 gives -1,+1,-1,-1,+1,-1. Hiding
// the control would hide the cause. The every-N modes are excluded because they
// count in their own pattern length (2N) and genuinely ignore this.
slider_show(slider21, pan_enabled && pan_mode >= 4 && pan_mode <= 12);
slider_show(slider20, pan_enabled);
slider_show(slider19, pan_enabled);
slider_show(slider22, pan_enabled && (pan_mode == 0 || pan_mode == 1));
slider_show(slider23, pan_enabled && (pan_mode == 0 || pan_mode == 1));
slider_show(slider24, pan_enabled && pan_mode == 1);

// Start Delay — convert the user-facing value to seconds. BPM beats
// and Hz cycles are interpreted against Rate Value (so 1 beat at
// 60 BPM = 1 second). Seconds mode is literal seconds.
start_delay_units = slider93;
// Every non-Seconds mode means "this many CYCLES", so the conversion is
// just units x cycle_seconds. That's identical to the old per-mode
// arithmetic (BPM: 60/value, Hz: 1/value)
// rather than falling through to the Hz branch and ignoring the tempo.
rate_mode == 1 ? start_delay_sec = start_delay_units :
                 start_delay_sec = start_delay_units * cycle_seconds;

// Direction mode + derived flags. For Up/Down (modes 0/1) we force
// seq_dir to the mode's natural direction every @slider so that
// switching from one to the other mid-playback flips the walk
// immediately. For bounce modes (2-5) we leave seq_dir alone — it's
// managed by the sequencer's bounce logic in @sample.
direction_mode   = slider26;
bounce_active    = (direction_mode >= 2);
bounce_is_repeat = (direction_mode == 2 || direction_mode == 4);
direction_mode == 0 ? seq_dir =  1;
direction_mode == 1 ? seq_dir = -1;

// Play/Rest gate: integer step counts. Both must be > 0 for the
// gate to engage; 0 in either slider disables.
play_for_steps = slider94;
rest_for_steps = slider95;
pr_enabled     = (play_for_steps > 0 && rest_for_steps > 0);
pf_base = play_for_steps; rf_base = rest_for_steps; pr_enabled_base = pr_enabled;
rest_mode      = slider96;

// Speed ramp engage-edge.
// No engage-edge detection. Engage is a freeze/resume gate handled
// in @sample. Only transport play resets ramp_t.

// Drift target selector save/restore (nested-selector pattern).
// Switching slider97 saves sliders 73-76 into the OLD target's slot,
// then loads the NEW target's stored config into sliders 73-76.
// Otherwise captures live edits to the current target's slot. All 28
// targets drift in parallel from @sample regardless of selection.
sel_target = slider97;
sel_up     = slider98;
sel_down   = slider99;
sel_per    = slider100;
sel_shape  = slider103;
sel_moves  = slider102;
sel_dplay  = slider104;
sel_drest  = slider105;

last_target_select != sel_target ? (
  target_drift_up[last_target_select]    = sel_up;
  target_drift_down[last_target_select]  = sel_down;
  target_drift_per[last_target_select]   = sel_per;
  target_drift_shape[last_target_select] = sel_shape;
  target_drift_moves[last_target_select] = sel_moves;
  drift_play_mem[last_target_select]     = sel_dplay;
  drift_rest_mem[last_target_select]     = sel_drest;

  slider98 = target_drift_up[sel_target];
  slider99 = target_drift_down[sel_target];
  slider100 = target_drift_per[sel_target];
  slider103 = target_drift_shape[sel_target];
  slider102 = target_drift_moves[sel_target];
  slider104 = drift_play_mem[sel_target];
  slider105 = drift_rest_mem[sel_target];
  slider_automate(slider98);
  slider_automate(slider99);
  slider_automate(slider100);
  slider_automate(slider103);
  slider_automate(slider104);
  slider_automate(slider105);

  last_target_select = sel_target;
) : (
  target_drift_up[sel_target]    = sel_up;
  target_drift_down[sel_target]  = sel_down;
  target_drift_per[sel_target]   = sel_per;
  target_drift_shape[sel_target] = sel_shape;
  target_drift_moves[sel_target] = sel_moves;
  drift_play_mem[sel_target]     = sel_dplay;
  drift_rest_mem[sel_target]     = sel_drest;
);

// Speed Ramp target selector save/restore (nested-selector, mirrors the
// drift block above). slider106 = target; slider107 = per-target `by`;
// slider109 = per-target duration; slider113 = per-target start delay (all
// three per-target). slider112 (engage) stays GLOBAL. Switching slider106
// saves the three per-target sliders into the OLD target's slots, then
// loads the NEW target's stored values. Otherwise captures live edits. All
// 28 targets ramp in parallel from @sample, each on its own duration/delay.
sr_sel_target = slider106;
sr_sel_by     = slider107;
sr_sel_dur    = slider109;
sr_sel_delay  = slider113;
sr_sel_play   = slider110;
sr_sel_rest   = slider111;

last_sr_target != sr_sel_target ? (
  speed_ramp_by_mem[last_sr_target]    = sr_sel_by;
  speed_ramp_dur_mem[last_sr_target]   = sr_sel_dur;
  speed_ramp_delay_mem[last_sr_target] = sr_sel_delay;
  sr_play_mem[last_sr_target]          = sr_sel_play;
  sr_rest_mem[last_sr_target]          = sr_sel_rest;

  slider107 = speed_ramp_by_mem[sr_sel_target];
  slider109 = speed_ramp_dur_mem[sr_sel_target];
  slider113 = speed_ramp_delay_mem[sr_sel_target];
  slider110 = sr_play_mem[sr_sel_target];
  slider111 = sr_rest_mem[sr_sel_target];
  slider_automate(slider107);
  slider_automate(slider109);
  slider_automate(slider113);
  slider_automate(slider110);
  slider_automate(slider111);

  last_sr_target = sr_sel_target;
) : (
  speed_ramp_by_mem[sr_sel_target]    = sr_sel_by;
  speed_ramp_dur_mem[sr_sel_target]   = sr_sel_dur;
  speed_ramp_delay_mem[sr_sel_target] = sr_sel_delay;
  sr_play_mem[sr_sel_target]          = sr_sel_play;
  sr_rest_mem[sr_sel_target]          = sr_sel_rest;
);

// Samples per one global rate cycle — the "primary cycle" for the
// drift wave period. Recomputed here because cycle_seconds may have
// changed (rate_mode / rate_value sliders).
samples_per_primary_cycle = max(cycle_seconds * srate, 1);

@block
// Adopt the note/value mirrors here, not in @slider, so a restore can never
// read as a user edit (Breath Generator, Womb).
!mel_ui_init ? (
  mel_ln[0] = slider28; mel_lv[0] = slider29;
  mel_ln[1] = slider36; mel_lv[1] = slider37;
  mel_ln[2] = slider44; mel_lv[2] = slider45;
  mel_ln[3] = slider52; mel_lv[3] = slider53;
  mel_ln[4] = slider60; mel_lv[4] = slider61;
  mel_ln[5] = slider68; mel_lv[5] = slider69;
  mel_ln[6] = slider76; mel_lv[6] = slider77;
  mel_ln[7] = slider84; mel_lv[7] = slider85;
  mel_ui_init = 1;
);
// --- No restore-order guard here any more, and that is the point ------------
//     A tracker used to sit here answering "did the user just move Rate Mode?",
//     adopted in @block rather than @slider for the 2026-08-23 reason (@slider
//     runs while REAPER is still handing over saved values, so a tracker adopted
//     there takes a DEFAULT and the real value arriving later reads as a user
//     edit). It existed to serve the entry-edge of the retired ratio picker.
//
//     R20 removed every control whose job was to write into another control, so
//     nothing needs to know whether a mode change was a person or a restore.
//     `last_rate_mode` was left with one write and zero readers when the picker
//     went -- checked case-insensitively, because eel2 folds case and a reader
//     spelled differently would still be a reader -- and it is removed rather
//     than annotated because this change is what orphaned it, and the comment
//     above it described a mechanism that no longer exists.
// Follow the project tempo, for whichever rate is in a host mode.
//
// @slider does NOT re-run when the tempo changes, so everything derived
// from cycle_seconds (v_step_seconds, v_note_seconds, the envelope
// segments) would go stale. Rather than recompute that whole block —
// which would mean lifting ~60 lines of @slider into a function — we
// scale the timeline and let it flow through the same paths Speed Ramp
// and Drift already use. Every duration stretches by the same factor, so
// voice and envelope PROPORTIONS are untouched: the melody simply runs
// faster or slower, which is what a tempo change means.
//
// host_scale is ABSOLUTE (tempo / 60), not a ratio against a remembered
// reference tempo. That matters: @init re-runs on every transport play
// and wipes globals, so a remembered reference was reset on play while
// the frozen step/note seconds still described the old tempo — the
// tempo change vanished the moment you pressed play. cycle_seconds is
// computed against a nominal 60 BPM instead, and the two multiply out.
//
// host_scale is 1 in every other rate mode, so BPM / Seconds / Hz
// projects are bit-identical to before.
//
// Transport-edge detection belongs in @block, not @sample (play_state
// only updates per block) — same reasoning applies to tempo.
// No sync tracker to adopt any more. The R11 shape needed one because entering
// or leaving sync CONVERTED the rate slider, which meant it had to know whether
// the switch had really been moved by a person -- and adopting that in @slider
// was the 2026-08-23 bug. R20 removed the conversion, so there is nothing to
// edge-detect and nothing that can misfire during a restore.
//
// host_scale carries the live tempo into dt for whichever rate is synced.
// Which rates are following the tempo. Derived HERE as well as in @slider,
// and this is the copy that matters: @block runs every block forever, so the
// gate is right on the first block after a transport play, when @slider has
// not run and never will. Must sit above the sequence-placement test below,
// which reads seq_synced in this same block.
//
// `>= 3` is the widened "am I host-synced" gate, covering BOTH host modes.
// Read the RAW sliders, not the @slider-local copies, for the same reason the
// derivation lives here at all.
seq_synced = slider2 >= 3;
pan_synced = slider23 >= 3;
// --- Which tempo to trust, and for how long ---------------------------------
// REAPER reports `tempo` as its 120 placeholder for the first stretch after a
// project opens, before the project's own tempo is applied. host_scale is
// tempo/60, and the sequencer COUNTS against it -- so unlike Womb, where a
// briefly-wrong tempo just makes the heart beat slow for a moment and then
// corrects, here it shifts a step boundary and every boundary after it
// inherits the shift. Measured: 276.4 ms late, on every instance.
//
// So while the transport is stopped and we are still inside the settle window,
// use the tempo this instance last saw settled (restored from @serialize).
// The project already knows its own tempo; there is nothing to guess.
//
// Deliberately limited two ways:
//   * play_state must be stopped/paused. During playback AND during an offline
//     RENDER the transport is moving and `tempo` is already correct, so those
//     paths are untouched -- a render cannot be affected by this either way.
//   * it lapses after tempo_settle_limit, so changing the project tempo without
//     saving still takes effect; it is a head start, not an override.
host_bpm_live = max(tempo, 0.001);
tempo_settle_sec < tempo_settle_limit ? tempo_settle_sec += samplesblock / srate;
host_bpm =
  (host_bpm_saved > 0 && tempo_settle_sec < tempo_settle_limit
   && (play_state == 0 || play_state == 2)) ? host_bpm_saved : host_bpm_live;
// Once settled, remember what we actually see, so the blob saves the truth.
tempo_settle_sec >= tempo_settle_limit ? host_bpm_saved = host_bpm_live;
host_scale     = seq_synced ? host_bpm / 60 : 1;
pan_host_scale = pan_synced ? host_bpm / 60 : 1;

// --- Flag a sequence placement (only while the sequencer is synced) --------
// Detects transport start and seeks; the placement itself happens in @sample
// where the sequencer's own state lives. A seek is spotted by comparing this
// block's actual position against the one the previous block predicted --
// normal playback agrees to far under the 0.25-beat threshold.
transport_moving = (play_state == 1 || play_state == 5);
seq_synced && transport_moving
  && (!was_moving || abs(beat_position - predicted_beat_pos) > 0.25) ?
  ( seq_place_pending = 1; seq_place_beats = max(beat_position, 0); );
predicted_beat_pos = beat_position + samplesblock * max(tempo, 0.001) / (60 * srate);
was_moving = transport_moving;

// Configured. Release the sequencer (see the cfg_ready note in @init).
cfg_ready = 1;

// Has the configuration stopped changing? On load these move once, when the
// project's values arrive; on alt-tab and on transport play they never move,
// so this costs two blocks and nothing else.
cfg_sig_now = cycle_seconds + host_scale * 7
            + v_step_seconds[0] * 13 + v_step_seconds[1] * 17;
cfg_sig_now != cfg_sig ? ( cfg_sig = cfg_sig_now; cfg_stable = 0; )
                       : cfg_stable < CFG_HOLD_BLOCKS ? cfg_stable += 1;

@sample
// Advance speed ramp every sample, then compute musical + slow
// drift offsets to the effective rate. combined_scale stretches
// dt so the sequencer + voice envelopes + pan all track the
// effective tempo (dt is also used for state_elapsed, so scaling
// here keeps Attack %, Release %, Note duration proportions
// intact across speed changes).
// Advance each target's own Speed Ramp clock (v2.14 per-target timeline).
// Engage (slider112, GLOBAL) is the freeze/resume gate: while On, every
// target whose duration > 0 advances its own ramp_t 0->1 over its own
// duration, after its own start delay; while Off, all clocks freeze and
// resume from where they are. Only transport play (via @init) resets them,
// so different targets can wind down over different timelines from one engage.
slider112 ? (
  // Ramp time unit (slider108). One factor turns the block's time values into
  // seconds, so Duration and Start delay always mean the same thing as each
  // other. Cycles counts THIS plugin's own sequencer cycles, referenced against
  // cycle_seconds -- the rate BEFORE drift and ramp touch it, so a ramp cannot
  // alter its own clock. Seconds is wall clock. Minutes is 60 s and is the
  // DEFAULT, because every saved instance has this control unset and moving the
  // default would rewrite their live ramps. A beat is 60/tempo s, recomputed
  // per sample so Beats follows a live tempo change rather than remembering one.
  ramp_time_scale =
    slider108 == 3 ? 60 / max(host_bpm, 0.001) :
    slider108 == 2 ? 60 :
    slider108 == 1 ? 1 :
                    max(cycle_seconds, 0.00001);
  i = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * ramp_time_scale * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        // Staircase (sliders 83/84). The ramp advances for `play`, holds for
        // `rest`, and repeats. The holds come OUT of the duration rather than
        // extending it -- the advancing step is scaled by (play+rest)/play --
        // so Ramp duration goes on meaning "you arrive in about this long".
        sr_pl = sr_play_mem[i];
        sr_rs = sr_rest_mem[i];
        sr_pr_on = sr_pl > 0 && sr_rs > 0;
        sr_hold = pr_frozen(sr_pr_accum_mem, sr_pr_resting_mem, i,
                            1.0 / (ramp_time_scale * srate), sr_pl, sr_rs);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !sr_hold ? (
          sr_step = 1.0 / (srate * speed_ramp_dur_mem[i] * ramp_time_scale);
          sr_pr_on ? sr_step *= (sr_pl + sr_rs) / sr_pl;
          speed_ramp_ramp_t_mem[i] += sr_step;
          speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
        );
      );
    );
    i += 1;
  );
);

// Rate Value Speed Ramp (target 0): offset = ramp_t[0] * by[0], added to
// rate_value and converted to a multiplicative ratio using the same
// mode-aware conversion as Drift. User's mental model: "ramp the rate by N
// (in its current unit)." Audio behavior: "scale dt by that ratio."
// Mode-aware so it works in BPM/Sec/Hz uniformly. No "snapshot at engage" —
// live edits adjust trajectory. Composes with Rate Value drift into
// combined_scale below.
effective_rate_val_ramp = max(rate_value + host_bpm_delta(speed_ramp_ramp_t_mem[0] * speed_ramp_by_mem[0]), 0.001);
// DIRECTION. Which way a positive offset moves the rate depends on whether the
// unit counts TIME PER CYCLE or CYCLES PER TIME, and mode 3 joined the first
// group: `Every N beats` is beats per cycle, so more is SLOWER, exactly as
// Seconds is. `N per beat` (4) is cycles per beat, so more is faster, like Hz.
// Widening this gate is the correction the Polyrhythms needed on 2026-09-04 --
// there, a positive drift ran BACKWARDS in beats mode, giving 57.6 cycles/min
// where 70 was asked for. Getting it wrong here would be silent and would only
// show up as drift pulling the wrong way.
//
// This is an EXACT mode test, not a `>= 3` sync gate. The two host modes fall
// on OPPOSITE sides of it, which is precisely why the widened form would be
// wrong here.
(rate_mode == 1 || rate_mode == 3) ?
  speed_scale_current = rate_value / effective_rate_val_ramp :
  speed_scale_current = effective_rate_val_ramp / max(rate_value, 0.001);

// Per-target drift wave computation. 10 targets (0=Rate Value,
// 1-8=V1-V8 Timing, 9=Pan Rate). Each gets a phase counter advancing
// per sample at speed_scale_current / (per × samples_per_primary_cycle),
// so the wave slows with Speed Ramp (one drift cycle still spans `per`
// rate cycles regardless of tempo). Period unit is global rate cycles
// for all targets.
i = 0;
loop(N_TARGETS,
  up    = target_drift_up[i];
  down  = target_drift_down[i];
  per   = target_drift_per[i];
  shape = target_drift_shape[i];

  drift_offset_local = 0;
  // A period of 0 turns this target's drift OFF. That is the quick disable --
  // Rozaya reaches for it, and until 2026-09-08 the slider's minimum was 1 so
  // 0 was unreachable, and in three plugins it was clamped UP to 1, which is the
  // FASTEST drift the control can make. Exactly backwards from what it reads as.
  (up > 0 || down > 0) && per > 0 ? (
    // Drift period unit (slider101). Cycles is this plugin's native count -- a
    // period of 8 means eight sequencer cycles, and because the advance already
    // carries speed_scale_current and host_scale it follows the rate and the
    // project tempo for free. Seconds is wall clock, so neither factor applies.
    // Beats converts at the LIVE tempo, recomputed per sample so a tempo change
    // is followed rather than remembered.
    //
    // The period is referenced against samples_per_primary_cycle, which comes
    // off the PRE-drift rate, so drifting the rate cannot modulate its own
    // drift period.
    drift_per_tick =
      slider101 == 2 ? 1.0 / max(per * 60 / max(host_bpm, 0.001) * srate, 1) :
      slider101 == 1 ? 1.0 / max(per * srate, 1) :
                      speed_scale_current * host_scale / (per * samples_per_primary_cycle);

    // Drift play/rest (sliders 77/78), per target, counted in PERIODS. While
    // resting the phase does not advance at all, so shape_val below is
    // recomputed from the HELD phase and the offset simply stays where it
    // stopped -- freeze in place, not a return to centre.
    // A STEPPED target gets a whole 1/period, but only on the sample its own
    // turn comes; a continuous one gets the usual per-sample slice. Play/rest
    // ticks on the same quantity, so "rest for N periods" keeps its meaning.
    // STEPPED targets, 2026-09-10. In the first unit, a whole 1/period on the
    // sample the target's turn comes. In Seconds or Beats the clock runs in that
    // unit ONLY while the target's own thing is happening, and freezes between
    // turns -- Rozaya: "stop mid-cycle, freeze the clock mid-whatever unit, then
    // pick up on the next cycle from wherever the clock was last." So the unit
    // means what it says, and each target still keeps its own time.
    // A voice's own targets run while that voice holds the step; the shared ones
    // (Transpose, Attack, Release, Play for, Rest for) while any note does.
    drift_is_stepped(i) ? (
      slider101 == 0 ? (
        drift_per_tick = drift_step_mem[i] ? 1.0 / max(per, 0.001) : 0;
      ) : (
        d_run = seq_started && !seq_finished && !in_frozen_rest &&
                (i < 12 || i >= 52 || seq_index == floor((i - 12) / 5));
        !d_run ? drift_per_tick = 0;
      );
      drift_step_mem[i] = 0;
    );

    d_frozen = pr_frozen(drift_pr_accum_mem, drift_pr_resting_mem, i,
                         drift_per_tick, drift_play_mem[i], drift_rest_mem[i]);
    // One-armed on purpose: an empty else-branch is a silent compile failure in
    // eel2, and this is the shape CLAUDE.md prescribes for it.
    d_frozen ? (
      new_phase = target_drift_phase[i];
    );
    !d_frozen ? (
      new_phase = target_drift_phase[i] + drift_per_tick;
      new_phase >= 1.0 ? (
        new_phase -= 1.0;
        shape == 2 ? (
          target_drift_prev[i] = target_drift_curr[i];
          target_drift_curr[i] = rand(2) - 1;
        );
      );
    );
    target_drift_phase[i] = new_phase;

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = target_drift_prev[i] +
        (target_drift_curr[i] - target_drift_prev[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  target_drift_offset[i] = drift_offset_local;
  i += 1;
);

// Rate Value drift (target 0): offset is in the rate's unit; convert
// to a speed multiplier via the drifted/base ratio (inverted in
// Seconds mode where higher value = slower). Composes with Speed Ramp
// into combined_scale, which scales dt — stretching the whole melody
// timeline while voice envelope proportions stay intact.
drifted_rate = max(rate_value + host_bpm_delta(target_drift_offset[0]), 0.001);
// Same direction rule as the Ramp block above, and for the same reason.
(rate_mode == 1 || rate_mode == 3) ?
  drift_mult = rate_value / drifted_rate :
  drift_mult = drifted_rate / rate_value;

// host_scale folds the live project tempo in alongside Speed Ramp and
// Drift (1 when the sequencer is not synced, so this line is a no-op then).
combined_scale = speed_scale_current * drift_mult * host_scale;
dt = combined_scale / srate;

// Pan Rate drift (target 9): convert the offset to a multiplier on the
// per-voice pan LFO frequency (relative to Pan Base Rate). In BPM/Hz
// modes a positive offset speeds the pan up; in Seconds mode it slows
// it. 1.0 when no Pan Rate drift is configured.
pan_rate_mult = 1.0;
pan_rate_off = target_drift_offset[10] + speed_ramp_ramp_t_mem[10] * speed_ramp_by_mem[10];
pan_rate_off != 0 ? (
  base_pan_cyc  = rate_to_cycle_seconds(pan_base_rate, pan_rate_mode);
  drift_pan_cyc = rate_to_cycle_seconds(max(pan_base_rate + pan_rate_off, 0.001), pan_rate_mode);
  pan_rate_mult = base_pan_cyc / max(drift_pan_cyc, 0.0001);
);

// --- The targets added 2026-09-10. Each applies only while its offset is, or
//     just was, non-zero, so an instance with none configured runs exactly the
//     values @slider set. ---
function mel_off(t) ( target_drift_offset[t] + speed_ramp_ramp_t_mem[t] * speed_ramp_by_mem[t]; );
mo1 = mel_off(1); mo2 = mel_off(2); mo3 = mel_off(3); mo4 = mel_off(4);
mo7 = mel_off(7); mo8 = mel_off(8); mo9 = mel_off(9); mo11 = mel_off(11);
mo52 = mel_off(52); mo53 = mel_off(53); mo54 = mel_off(54);

(mo1 != 0 || mo1_was) ? pulse_duty = max(0.01, min(0.99, pulse_duty_base + mo1 * 0.01));
mo1_was = mo1 != 0;
(mo7 != 0 || mo7_was) ? (
  glide_time_eff = max(0, glide_time + mo7);
  glide_coeff = glide_time_eff > 0.0001 ? exp(-1 / max(srate * glide_time_eff, 1)) : 0;
);
(mo8 != 0 || mo8_was) ? pan_spread = max(0, min(1, pan_spread_base + mo8 * 0.01));
mo8_was = mo8 != 0;
(mo7 != 0 || mo9 != 0 || mo7_was || mo9_was) ? (
  nt_pg  = max(0, slider20 + mo9) / 1000;
  nt_pst = nt_pg <= 0 ? 0 : ((legato_enabled && glide_time_eff > 0.0001) ? max(nt_pg, glide_time_eff) : nt_pg);
  pan_smooth_coeff_global = nt_pst <= 0 ? 0 : exp(-1 / (srate * nt_pst));
);
mo7_was = mo7 != 0; mo9_was = mo9 != 0;
master_gain_eff = mo52 != 0 ? db_to_lin(slider92 + mo52) : master_gain;
(mo53 != 0 || mo54 != 0 || mo53_was) ? (
  play_for_steps = max(0, floor(pf_base + mo53 + 0.5));
  rest_for_steps = max(0, floor(rf_base + mo54 + 0.5));
  pr_enabled = play_for_steps > 0 && rest_for_steps > 0;
);
mo53_was = mo53 != 0 || mo54 != 0;
mo11 != 0 ? (
  nt_j = 0;
  loop(8,
    nt_pcs = rate_to_cycle_seconds(pan_base_rate + (pan_increment + mo11) * nt_j, pan_rate_mode);
    v_pan_freq_d[nt_j] = nt_pcs > 0 ? 1 / nt_pcs : 0;
    nt_j += 1;
  );
);
// Pitch: every voice is recomputed while any pitch offset moves, and once more
// when they all return to zero, which restores exactly the @slider frequencies.
nt_pm = mo2 != 0 || mo3 != 0 || mo4 != 0;
nt_j = 0;
loop(8, (mel_off(12 + 5 * nt_j) != 0 || mel_off(13 + 5 * nt_j) != 0) ? nt_pm = 1; nt_j += 1; );
(nt_pm || pm_prev) ? (
  nt_j = 0;
  loop(8,
    nt_hz = voice_hz(v_semitones[nt_j] + mel_off(12 + 5 * nt_j), pitch_mode,
                     v_fine[nt_j] + mel_off(13 + 5 * nt_j), slider6,
                     tuning_ref + mo2, base_note + mo3, oct_shift);
    v_freq_l[nt_j] = nt_hz;
    v_freq_r[nt_j] = nt_hz + binaural_hz + mo4;
    nt_j += 1;
  );
);
pm_prev = nt_pm;

// (No transport-edge reset here — Path A. REAPER re-runs @init on every
// transport play, which resets all runtime state; the drift config bank
// is preserved across those re-runs by the drift_cfg_inited guard in
// @init. See docs/v2.9-render-state-bug.md.)

// Start Delay gate. During the silent window the sequencer state
// (seq_started, voice envelopes, etc.) doesn't advance, so when the
// delay elapses the sequencer kicks in cleanly from V1 as if just
// loaded. After the gate releases the rest of @sample runs normally.
start_delay_elapsed < start_delay_sec ? (
  // * host_scale so the delay is counted in the SAME time base the cycle
  // lengths are. When synced, cycle_seconds is deliberately nominal
  // (60 BPM) with the real tempo applied as host_scale, so a wall-clock
  // counter here made "8 cycles" mean 8 NOMINAL cycles -- the delayed
  // instance came in late against its partner by exactly the tempo
  // ratio. host_scale is 1 in BPM / Seconds / Hz, so those are unchanged.
  //
  // NOTE this still does not track Speed Ramp / Drift (combined_scale):
  // if the rate is ramping, "8 cycles" of delay is measured against the
  // unramped rate. Pre-existing and left alone deliberately -- changing
  // it would move the start point of existing projects that use both.
  //
  // SAME STARTING LINE AS THE SEQUENCER (2026-09-06). This counter used to
  // start ticking on the first sample after @init, while the sequencer below
  // waits for the config to settle (cfg_ready && slider_ran && cfg_stable).
  // Two clocks, two different origins: a DELAYED instance burned part of its
  // delay during a pause the undelayed ones were still sitting in, and came in
  // early by however long that pause lasted -- a couple of audio buffers, which
  // is a small fraction of a beat and never goes away, because the pause
  // happens again identically on every transport play.
  //
  // Found by ear by Rozaya, who localised it to the ONE instance in
  // simple-sequence carrying a Start delay and then proved it: setting the
  // delay to 0 removed the symptom, restoring 8 brought it back exactly. With
  // no delay the instance skips this counter entirely and falls through to the
  // sequencer's own gate, which is precisely why 0 behaved.
  //
  // The gate is repeated rather than hoisted because the sequencer's copy has
  // to stay where it is -- it also guards the first trigger.
  (cfg_ready && slider_ran && cfg_stable >= CFG_HOLD_BLOCKS) ? (
    start_delay_elapsed += host_scale / srate;
  );
  spl0 = 0;
  spl1 = 0;
) : (

// === Sequencer advance ===
// On the very first sample, trigger the first active voice's attack
// — unless that voice is a rest (Note Length = 0), in which case it
// stays in state 0 (silent) and just consumes its Step Length
// before handing off. Triggering attack on a zero-length note used
// to click: envelope jumped from 0 to 1 to 0 in adjacent samples
// (no time for the ramp to actually ramp), so the listener heard
// the oscillator's sample value at full gain for one sample, then
// silence. Skipping the trigger for rest voices fixes that — a
// rest is now truly silent for its entire step.
seq_started == 0 && cfg_ready && slider_ran && cfg_stable >= CFG_HOLD_BLOCKS ? (
  // Pick starting direction + first voice based on Direction mode.
  // Up / Up-Down: start at the first active voice walking forward
  // from index 0. Down / Down-Up: start at the last active voice
  // walking backward from the end of the pool.
  starts_down = (direction_mode == 1 || direction_mode == 4 || direction_mode == 5);
  seq_dir = starts_down ? -1 : 1;
  bounce_count_total = 0;
  first_idx = starts_down ? next_active_voice(seq_length_eff - 1, -1) : next_active_voice(0, 1);
  first_idx >= 0 ? (
    seq_index = first_idx;
    seq_step_elapsed = 0;
    // Fire the first voice via the shared trigger function. prev_idx
    // = -1 means "no previous voice exists"; the Legato handoff
    // branch needs prev_idx >= 0 so it won't fire, and the glide
    // branch hits the !have_prev_trigger path which snaps the
    // current frequency to this voice's own target.
    // Don't fire voice 1 when a placement is about to move us: REAPER
    // re-runs @init on a locate, which zeroes seq_started, so this branch
    // fires the first note again on EVERY playhead move while playing --
    // audibly, and even where the gate or a finished sequence says silence.
    // The placement below sets the real position and triggers there.
    //
    // DEFERRED, not dropped. The placement owns the trigger from here, and it
    // fires one even when it decides not to move anything -- otherwise a
    // pending flag that leads to no placement eats the first note entirely.
    seq_place_pending ? seq_place_needs_trigger = 1 : trigger_seq_voice(-1);
    seq_started = 1;
    // Count this step toward the play period. No threshold check on
    // the first step (pr_step is 0; threshold is always >= 1 when
    // pr_enabled, so it'd never fire here anyway).
    pr_enabled ? pr_step += 1;
  );
);

// --- Place the sequence from the project (synced sequencer only) -----------
//
// PLACE ONCE, like rhythm-track and shepard-scale: a sequencer that recomputed
// its position every sample would re-decide which note is sounding and jump
// mid-envelope.
//
// When synced, dt already carries tempo/60, so seq_step_elapsed and
// v_step_seconds are both effectively in BEATS -- which is what makes this a
// straight walk against beat_position with no unit conversion.
//
// DELIBERATELY NARROW. Placement only happens for a plain looping Up or Down
// sequence with fixed step lengths and no gate. Everything else falls back to
// today's behaviour of starting from the top, because:
//   - bounce modes and Loop=Off have a path that depends on history, not just
//     on elapsed time;
//   - per-voice timing drift or ramp means the step lengths at bar 40 aren't
//     the ones a walk from bar 0 would have used, so the walk would be a
//     confident guess rather than an answer (the "lock what's constant" rule);
// A narrow correct placement beats a broad approximate one.
//
// The walk is bounded by taking the elapsed time modulo one full pass of the
// pool first, so a project two hours in costs the same as one at bar 2.
//
// On a mid-play seek the landed note retriggers from the start of its envelope
// rather than partway through. You land on the RIGHT note; it just begins
// again. Documented rather than hidden.
// WAIT FOR THE SAME SETTLE HOLD AS THE FIRST NOTE (2026-09-11). Placement used to
// run on the very first sample, while the first-note branch above was still held
// by cfg_stable for CFG_HOLD_BLOCKS blocks. Two blocks later that branch fired,
// set the sequence back to voice 1 and, finding no placement pending any more,
// triggered it -- so the song position was worked out and then thrown away, on
// every play press. Measured with tools/lock_test.py: starting at beat 2 with
// three voices played voice 1, not voice 3.
//
// This does NOT wait for the transport. The hold is the one Melody already has,
// stopped or playing, and placement is only ever flagged while the transport
// moves, so with the transport stopped nothing here changes and Melody sounds
// immediately -- the reverted dcfeead fix held the SEQUENCER until play, which is
// the shape Rozaya ruled out.
seq_place_pending && cfg_ready && slider_ran && cfg_stable >= CFG_HOLD_BLOCKS ? (
  seq_place_pending = 0;
  // Every direction mode is placeable: the walk below handles bounce (period =
  // there and back) and Loop=Off (walk until it ends) directly, so neither is
  // excluded. Only two things are, and for real reasons rather than effort:
  // per-voice timing drift/ramp (the step lengths at bar 40 aren't the ones a
  // walk from bar 0 would have used, so a walk would be a confident guess --
  // the "lock what's constant" rule), and the Play/Rest gate (a second
  // The Play/Rest gate IS placed: it's periodic too, and the walk below
  // simulates it alongside the sequence (including Freeze mode, where each
  // rest injects wall-clock time in which the sequence stands still).
  // Only per-voice timing drift/ramp is excluded, and for a real reason: the
  // step lengths at bar 40 aren't the ones a walk from bar 0 would have used,
  // so the walk would be a confident guess. That's the "lock what's constant"
  // rule the sweeping effects follow too.
  seq_place_ok = seq_synced;
  seq_place_ok ? (
    // Per-voice timing and the Play/Rest counts: a walk from bar 0 would guess.
    i = 0;
    loop(8,
      mel_off(14 + 5 * i) != 0 ? seq_place_ok = 0;
      i += 1;
    );
    (mel_off(53) != 0 || mel_off(54) != 0) ? seq_place_ok = 0;
  );
  seq_place_ok ? (
    // Start where the sequence itself starts: a Down sequence begins at the
    // TOP of the pool, matching the first_idx logic in the branch above.
    place_idx = starts_down ? next_active_voice(seq_length_eff - 1, -1)
                            : next_active_voice(0, 1);
    place_idx >= 0 ? (
      place_dir0 = starts_down ? -1 : 1;

      // PASS 1 -- find the period by walking until the sequence returns to its
      // starting (voice, direction) state. That covers plain Up/Down (period =
      // one pass of the pool) AND both bounce variants (period = there and
      // back, whether or not the edge note repeats) without special-casing
      // either. If it never returns, or Loop is off, there is no period and
      // pass 2 just walks until the sequence ends.
      // Gate state travels with the walk. The combined pattern only repeats
      // when the SEQUENCE and the GATE line up again -- 4 voices against a
      // play-3/rest-2 gate repeats every 20 steps, not 4 and not 5 -- so the
      // period test below requires pr_step and pr_resting to come back too,
      // and the step cap is raised to cover that longer cycle.
      place_period = 0;
      place_walk   = place_idx;
      place_wdir   = place_dir0;
      place_bounce = 0;
      place_prstep = 1;
      place_prrest = 0;
      place_found  = 0;
      place_done   = 0;
      loop(1024,
        place_done ? 0 : (
          place_period += v_step_seconds[place_walk];
          place_nxt = step_in_dir_no_wrap(place_walk, place_wdir);
          place_nxt < 0 ? (
            bounce_active ? (
              place_wdir = -place_wdir;
              place_bounce += 1;
              (!loop_enabled && place_bounce >= 2) ? place_done = 1 :
                place_nxt = bounce_is_repeat ? place_walk
                                             : step_in_dir_no_wrap(place_walk, place_wdir);
            ) : (
              loop_enabled ? place_nxt = next_active_voice(
                               place_wdir > 0 ? 0 : seq_length_eff - 1, place_wdir)
                           : place_done = 1;
            );
          );
          place_done ? 0 : (
            place_walk = place_nxt;
            // Mirror the gate exactly as the step handler does it: threshold
            // check and flip first, then increment for the step about to run.
            pr_enabled ? (
              place_prstep >= (place_prrest ? rest_for_steps : play_for_steps) ? (
                // In FREEZE, a rest is a block of TIME, not a run of steps:
                // the sequence stands still for its whole length and then
                // carries straight on playing. So it's consumed atomically
                // here and the state never sits "resting" between steps.
                // In WALK the sequencer keeps stepping through rest, so the
                // state does flip and the steps are counted normally.
                (!place_prrest && rest_mode == 1) ? (
                  place_period += simulate_rest_duration_seconds(place_walk, rest_for_steps);
                  place_prstep = 0;
                ) : (
                  place_prrest = 1 - place_prrest;
                  place_prstep = 0;
                );
              );
              place_prstep += 1;
            );
            (place_walk == place_idx && place_wdir == place_dir0
             && place_prstep == 1 && place_prrest == 0) ?
              ( place_found = 1; place_done = 1; );
          );
        );
      );

      // PASS 2 -- walk to the target. With a period, reduce first so a project
      // two hours in costs the same as one at bar 2. Without one (Loop off),
      // walk until the time runs out or the sequence ends -- and if it ended
      // first, that IS the answer: it would have finished by now.
      place_t = seq_place_beats;
      (place_found && loop_enabled && place_period > 0.0001) ?
        place_t = place_t - floor(place_t / place_period) * place_period;

      place_walk   = place_idx;
      place_wdir   = place_dir0;
      place_bounce = 0;
      place_prstep = 1;
      place_prrest = 0;
      place_frozen = 0;
      place_done   = 0;
      place_end    = 0;
      loop(4096,
        place_done ? 0 : (
          place_t < v_step_seconds[place_walk] ? place_done = 1 : (
            place_t -= v_step_seconds[place_walk];
            place_nxt = step_in_dir_no_wrap(place_walk, place_wdir);
            place_nxt < 0 ? (
              bounce_active ? (
                place_wdir = -place_wdir;
                place_bounce += 1;
                (!loop_enabled && place_bounce >= 2) ? ( place_end = 1; place_done = 1; ) :
                  place_nxt = bounce_is_repeat ? place_walk
                                               : step_in_dir_no_wrap(place_walk, place_wdir);
              ) : (
                loop_enabled ? place_nxt = next_active_voice(
                                 place_wdir > 0 ? 0 : seq_length_eff - 1, place_wdir)
                             : ( place_end = 1; place_done = 1; );
              );
            );
            place_done ? 0 : (
              place_walk = place_nxt;
              pr_enabled ? (
                place_prstep >= (place_prrest ? rest_for_steps : play_for_steps) ? (
                  (!place_prrest && rest_mode == 1) ? (
                    // Freeze rest: a block of TIME with the sequence standing
                    // still. Either the target lands inside it -- frozen on
                    // this voice, with the timer seeded below -- or the whole
                    // rest is served and play resumes immediately. It is never
                    // left half-entered, which is what made a placement land
                    // "resting" with no rest duration set, and the rest timer
                    // refuses to run without one: silence that never ended.
                    place_rest = simulate_rest_duration_seconds(place_walk, rest_for_steps);
                    place_t < place_rest ? ( place_frozen = 1; place_done = 1; ) : (
                      place_t -= place_rest;
                      place_prstep = 0;
                    );
                  ) : (
                    place_prrest = 1 - place_prrest;
                    place_prstep = 0;
                  );
                );
                place_done ? 0 : place_prstep += 1;
              );
            );
          );
        );
      );

      seq_index          = place_walk;
      seq_dir            = place_wdir;
      bounce_count_total = place_bounce;
      seq_step_elapsed   = (place_end || place_frozen) ? 0 : place_t;
      seq_finished       = place_end;
      pr_enabled ? (
        pr_resting = place_frozen ? 1 : place_prrest;
        pr_step    = place_prstep;
        // Landed inside a Freeze rest: sit frozen on this voice and let the
        // existing rest timer carry the remainder, so it resumes on schedule.
        place_frozen ? (
          pr_rest_duration_samples =
            simulate_rest_duration_seconds(place_walk, rest_for_steps) * srate;
          // place_t is how far INTO the rest we landed (we froze precisely
          // because place_t < the rest's length), so it IS the elapsed
          // amount. Seeding it as duration-minus-that ran the rest backwards.
          pr_rest_elapsed = place_t * srate;
          pr_frozen_prev_voice = -1;
        );
      );
      // Placement owns the deferred trigger now, whatever it decided.
      seq_place_needs_trigger = 0;
      (seq_started && !place_end && !place_frozen && (!pr_enabled || !pr_resting)) ?
        trigger_seq_voice(-1);
    );
  );
  // Placement declined -- wrong mode, per-voice timing drift active, or no
  // active voice to place. Fire the note the start branch deferred, where it
  // would have been anyway.
  seq_place_needs_trigger ? (
    seq_place_needs_trigger = 0;
    trigger_seq_voice(-1);
  );
);

// Once started (and not finished), advance the per-step clock.
// When the current voice's step has elapsed, the sequencer hands
// off to the next active voice. The OUTGOING voice's envelope
// keeps progressing through its own (longer or shorter) note
// duration in parallel — that's where overlap comes from.
//
// Freeze-mode rest exception: when the Play/Rest gate is engaged
// AND we're in the rest period AND Rest mode = Freeze, the step
// clock does NOT advance. This is what keeps the sequencer paused
// at the would-be-next voice (seq_index already points to it from
// the handoff that triggered rest) — no new handoffs fire during
// the silent period. The rest timer block further down handles
// resuming with that frozen voice when the rest duration elapses.
seq_started && !seq_finished ? (
  in_frozen_rest = pr_enabled && pr_resting && rest_mode == 1;
  !in_frozen_rest ? seq_step_elapsed += dt;
  // Per-voice timing drift (targets 1-8): the current voice's step
  // length wanders by its drift offset (in cycles → seconds via the
  // base cycle_seconds, matching v_step_seconds' units). Clamped to a
  // 1 ms floor so a heavy Down-by can't make the step zero/negative.
  cur_step = max(v_step_seconds[seq_index] + (target_drift_offset[14 + 5 * seq_index] + speed_ramp_ramp_t_mem[14 + 5 * seq_index] * speed_ramp_by_mem[14 + 5 * seq_index]) * cycle_seconds, 0.001);
  seq_step_elapsed >= cur_step ? (
    seq_step_elapsed -= cur_step;
    // === Compute next voice based on Direction mode ===
    // Try to step in the current direction WITHIN the pool. If we'd
    // cross a pool boundary (step_in_dir_no_wrap returns -1), handle
    // it according to mode: bounce modes flip direction; Up/Down
    // wrap or stop based on Loop. nxt = -1 at the end of this block
    // means "stop the sequence" (set seq_finished below).
    nxt = step_in_dir_no_wrap(seq_index, seq_dir);
    nxt < 0 ? (
      bounce_active ? (
        // Hit a pool edge — flip direction.
        seq_dir = -seq_dir;
        bounce_count_total += 1;
        // Loop=Off bounce: stop after two boundary crossings (one
        // complete bounce, back to the starting edge). Checked
        // BEFORE picking the next voice so the second bounce's
        // would-be note never plays.
        !loop_enabled && bounce_count_total >= 2 ? (
          nxt = -1;
        ) : (
          bounce_is_repeat ? (
            // Repeat-boundary modes: play the current voice once
            // more with the new direction queued for the next step.
            nxt = seq_index;
          ) : (
            // No-repeat modes: skip the would-be repeat, take one
            // step in the new direction immediately.
            nxt = step_in_dir_no_wrap(seq_index, seq_dir);
          );
          // Loop=On: keep bounce_count_total bounded by resetting
          // every complete cycle (two bounces).
          bounce_count_total >= 2 ? bounce_count_total = 0;
        );
      ) : (
        // Up or Down — wrap to the other end if looping, else stop.
        loop_enabled ? (
          wrap_start = seq_dir > 0 ? 0 : seq_length_eff - 1;
          nxt = next_active_voice(wrap_start, seq_dir);
        );
        // else: nxt stays -1, triggering the seq_finished branch below.
      );
    );
    nxt < 0 ? (
      // No next voice — finalize the sequence. Same Legato release
      // as the original logic so the last note doesn't ring forever.
      seq_finished = 1;
      legato_enabled && voice_state[seq_index] != 0 ? (
        voice_state[seq_index] = 3;
        state_elapsed[seq_index] = 0;
      );
    ) : (
      // Capture the previous (still-playing-or-just-released)
      // voice index BEFORE we advance seq_index. Used by the
      // Legato glide hand-off below — we need to know which
      // voice to inherit envelope + oscillator phase from.
      prev_voice = prev_seq_index;
      seq_index = nxt;

      // Play/Rest gate. Check first whether the step we just
      // completed took us to the threshold for the current period;
      // if so, flip play↔rest and reset the counter. Then increment
      // for the step we're about to (maybe) trigger. The note
      // trigger below is conditioned on !pr_resting so during rest
      // the sequencer walks silently in Walk mode (seq_index still
      // advances, pr_step still increments, just no new attack
      // fires). In Freeze mode the rest-entry block below saves
      // the would-be-next voice and sets up the sample-timed rest
      // window; the sequencer-advance gate higher up keeps
      // seq_step_elapsed pinned so this handoff doesn't re-fire.
      //
      // Legato edge case: in Legato mode the previous voice's
      // sustain doesn't auto-release (it normally only releases when
      // the next voice's Legato handoff inherits it). When PR flips
      // to rest, no handoff fires and the previous voice would ring
      // forever. Force it into release at the rest-entry moment —
      // same trick the seq_finished branch uses for Loop=Off.
      pr_enabled ? (
        pr_step >= (pr_resting ? rest_for_steps : play_for_steps) ? (
          just_entered_rest = !pr_resting;
          just_entered_rest && legato_enabled && voice_state[prev_voice] != 0 ? (
            voice_state[prev_voice]   = 3;
            state_elapsed[prev_voice] = 0;
          );
          pr_resting = 1 - pr_resting;
          pr_step    = 0;
          // Freeze-mode rest entry: remember the voice that was
          // playing (for the trigger function's prev_idx when we
          // resume), and compute the rest duration in samples by
          // simulating exactly what Walk mode would have done from
          // this point — sum the next rest_for_steps voices' Next
          // voice in durations. This makes the slider's wall-clock
          // meaning consistent across Walk and Freeze even when
          // voices have different per-step timings. The sequencer-
          // advance gate higher up keeps seq_index pointing at the
          // frozen voice for the entire rest.
          just_entered_rest && rest_mode == 1 ? (
            pr_frozen_prev_voice = prev_voice;
            pr_rest_duration_samples = simulate_rest_duration_seconds(seq_index, rest_for_steps) * srate;
            pr_rest_elapsed = 0;
          );
        );
        pr_step += 1;
      );

        // Re-trigger the new voice's envelope from attack — unless
        // the voice is a rest (Note Length = 0; the trigger
        // function handles that case internally) or PR is in its
        // rest period.
        !pr_enabled || !pr_resting ? trigger_seq_voice(prev_voice);
    );
  );
);

// Freeze-mode rest timer. When Rest mode = Freeze in place AND we
// entered a rest period, the sequencer-advance gate above keeps
// seq_step_elapsed pinned so no handoffs fire. This block counts
// samples of rest elapsed; when we hit the threshold (rest_for_steps
// × the frozen voice's "Next voice in" duration, in samples), exit
// rest and fire the frozen voice via the shared trigger function.
// pr_step is reset to 1 so the next handoff sees this fired voice
// as step 1 of the new play period — matching how Walk mode counts
// the first fired note of a new play period.
//
// The pr_rest_duration_samples > 0 guard handles the edge case where
// the user changes Rest mode mid-rest (Walk → Freeze): without the
// duration being set, the comparison would fire immediately and
// snap out of rest, leaving state inconsistent. With the guard we
// just sit until the user presses stop/play to reset cleanly.
pr_enabled && pr_resting && rest_mode == 1 && pr_rest_duration_samples > 0 ? (
  // Scale rest accumulation by combined_scale so rest duration tracks
  // the effective tempo set by Speed Ramp + drift (consistent with
  // how Walk-mode rest auto-tracks via the stretched dt).
  pr_rest_elapsed += combined_scale;
  pr_rest_elapsed >= pr_rest_duration_samples ? (
    pr_resting = 0;
    pr_step = 1;
    seq_step_elapsed = 0;
    trigger_seq_voice(pr_frozen_prev_voice);
  );
);

// === Per-voice envelope + oscillator + sum ===
// Walk every voice that's in a non-silent state; update its
// envelope based on its own elapsed-in-state, render its sample,
// sum to L/R. A voice can be ringing here even if it's not the
// "current" sequencer voice (overlap case).
//
// Click prevention: after the state machine produces a raw
// envelope value, that value goes through a one-pole smoother
// (smooth_coeff, ~3ms time constant) before being applied to
// the oscillator. So even when attack% = 0 or release% = 0
// would let the raw envelope jump instantly from 0 to 1 (or
// vice versa), the smoothed amplitude ramps over a few
// milliseconds and the listener hears a clean transition.
// This mirrors Polyrhythm Phase's gain_l[i] = gain_l[i] *
// smooth + target * (1 - smooth) pattern.
//
// Voices in state 0 (silent) still pass through the smoother
// so any tail from a previous note rings out gracefully if
// the voice was just released. We only skip the oscillator
// render once both the raw envelope AND the smoothed value
// are near zero — otherwise the smoothed tail would get cut
// off mid-fade.
out_l = 0;
out_r = 0;

i = 0;
loop(8,
  (v_active[i] || (any_solo && v_solo[i])) && (voice_state[i] != 0 || v_env_smoothed[i] > 0.0001) ? (
    // Advance the state machine ONLY when the voice is in a
    // non-silent state. A voice in state 0 with a non-zero
    // smoothed envelope is decaying its tail — the state machine
    // has nothing more to do; we just let the smoother converge
    // to 0 (v_envelope[i] is already 0, the smoother was set to
    // 0 by the release-end transition).
    voice_state[i] != 0 ? (
      state_elapsed[i] += dt;
      elapsed = state_elapsed[i];

      // State machine: attack → sustain → release → silent.
      // Note Length = 0 (rest voice) never enters here because
      // the sequencer-trigger code refuses to set state to 1
      // when v_note_seconds <= 0.0001 — rests stay silent.
      voice_state[i] == 1 ? (  // attack
        v_attack_seconds[i] > 0.0001 ? (
          t = elapsed / v_attack_seconds[i];
          t >= 1 ? (
            v_envelope[i] = 1;
            voice_state[i] = 2;
            state_elapsed[i] = 0;
          ) : (
            v_envelope[i] = apply_curve(t, attack_shape);
          );
        ) : (
          // attack% = 0 — jump straight to sustain. The smoother
          // below catches the 0→1 jump so no click reaches the
          // listener; this matches Polyrhythm Phase's behavior.
          v_envelope[i] = 1;
          voice_state[i] = 2;
          state_elapsed[i] = 0;
        );
      ) :
      voice_state[i] == 2 ? (  // sustain
        v_envelope[i] = 1;
        // Sustain → release on its own ONLY when Legato is off.
        // In Legato mode, each voice rings continuously until the
        // sequencer's next hand-off silences it via the legato
        // inheritance path — so the user's "Note duration"
        // effectively becomes "ring until the next note takes
        // over," giving a true continuous tone with pitch sliding
        // between voices. End-of-sequence (Loop=Off, walked past
        // the last active voice) is handled separately above by
        // forcing the current voice into release state so the
        // sound doesn't ring forever.
        !legato_enabled && elapsed >= v_sustain_seconds[i] ? (
          voice_state[i] = 3;
          state_elapsed[i] = 0;
        );
      ) :
      voice_state[i] == 3 ? (  // release
        v_release_seconds[i] > 0.0001 ? (
          t = elapsed / v_release_seconds[i];
          t >= 1 ? (
            v_envelope[i] = 0;
            voice_state[i] = 0;
            state_elapsed[i] = 0;
          ) : (
            v_envelope[i] = apply_curve(1 - t, release_shape);
          );
        ) : (
          // release% = 0 — drop to silent. Smoother handles the
          // 1→0 fade so no click reaches the listener.
          v_envelope[i] = 0;
          voice_state[i] = 0;
          state_elapsed[i] = 0;
        );
      );
    );

    // One-pole exponential smoother on the envelope output.
    // smooth_coeff = exp(-1/(srate * 0.003)), so the smoothed
    // value tracks the raw envelope with a ~3ms time constant.
    // This is what prevents clicks on the attack=0 and release=0
    // edge cases — the raw v_envelope[i] may step instantly
    // (0→1 on attack=0, 1→0 on release=0), but the smoother
    // ramps over a few milliseconds and the listener hears a
    // clean transition. Same pattern as Polyrhythm Phase.
    v_env_smoothed[i] = v_env_smoothed[i] * smooth_coeff + v_envelope[i] * (1 - smooth_coeff);

    // Always render the oscillator while the smoothed envelope
    // is non-trivial — covers both the active-state case and the
    // post-release tail-decay case.
    (
      // Glide step: slide v_freq_current_l/r toward this voice's
      // own target (v_freq_l/r[i]) over glide_time seconds via a
      // one-pole smoother. When glide_time = 0, just snap so the
      // pitch jumps cleanly to its target (the original behavior
      // before glide was added).
      glide_time_eff > 0.0001 ? (
        v_freq_current_l[i] = v_freq_current_l[i] * glide_coeff + v_freq_l[i] * (1 - glide_coeff);
        v_freq_current_r[i] = v_freq_current_r[i] * glide_coeff + v_freq_r[i] * (1 - glide_coeff);
      ) : (
        v_freq_current_l[i] = v_freq_l[i];
        v_freq_current_r[i] = v_freq_r[i];
      );
      // Advance oscillator phases using the (possibly gliding)
      // current frequency. L and R are independent so the binaural
      // beat (Hz offset on R only) works cleanly.
      osc_phase_l[i] += v_freq_current_l[i] / srate;
      osc_phase_r[i] += v_freq_current_r[i] / srate;
      osc_phase_l[i] >= 1 ? osc_phase_l[i] -= 1;
      osc_phase_r[i] >= 1 ? osc_phase_r[i] -= 1;

      // Waveform chain — matches Polyrhythm Phase's 10 options.
      // Each branch computes osc_l from osc_phase_l[i] and osc_r
      // from osc_phase_r[i]. (Copy-pasted intentionally; JSFX has
      // no imports, and the alternative is a single sample worth
      // of function-call overhead per voice.)
      pl = osc_phase_l[i];
      pr = osc_phase_r[i];

      waveform == 0 ? (  // Sine
        osc_l = sin(2 * $pi * pl);
        osc_r = sin(2 * $pi * pr);
      ) :
      waveform == 1 ? (  // Triangle
        osc_l = (pl < 0.5 ? 4 * pl - 1 : 3 - 4 * pl);
        osc_r = (pr < 0.5 ? 4 * pr - 1 : 3 - 4 * pr);
      ) :
      waveform == 2 ? (  // Saw
        osc_l = 2 * pl - 1;
        osc_r = 2 * pr - 1;
      ) :
      waveform == 3 ? (  // Golden TS (Polyrhythm-Phase-compatible: golden
                         //   phase warp → SINE output. The originally-
                         //   shipped Melody Phase slot 3 fed the warp into
                         //   a triangle, which sounded different from the
                         //   same-named slot in Polyrhythm Phase. To make
                         //   the two plugins match — and to preserve the
                         //   sound of existing Polyrhythm Phase projects
                         //   that built on this — the triangle-output
                         //   variant moved to the "Phi Triangle" slot at
                         //   the end of this list. See docs for context.)
        inv_phi = 1 / 1.618033988749895;
        wl = pl < inv_phi ? pl / inv_phi * 0.5 : 0.5 + (pl - inv_phi) / (1 - inv_phi) * 0.5;
        wr = pr < inv_phi ? pr / inv_phi * 0.5 : 0.5 + (pr - inv_phi) / (1 - inv_phi) * 0.5;
        osc_l = sin(2 * $pi * wl);
        osc_r = sin(2 * $pi * wr);
      ) :
      waveform == 4 ? (  // Golden SG (Polyrhythm-Phase-compatible: sine
                         //   prewarp + golden phase warp → sine output.
                         //   The originally-shipped Melody Phase slot 4
                         //   was the no-prewarp "clean" version; the
                         //   prewarp version is what Polyrhythm Phase
                         //   has always shipped, and the prewarp adds
                         //   harmonic content. Clean (no-prewarp) version
                         //   moved to "Phi Sine" at the end of this list.)
        inv_phi = 1 / 1.618033988749895;
        pl_pre = (sin((pl - 0.25) * 2 * $pi) + 1) * 0.5;
        pr_pre = (sin((pr - 0.25) * 2 * $pi) + 1) * 0.5;
        wl = pl_pre < inv_phi ? pl_pre / inv_phi * 0.5 : 0.5 + (pl_pre - inv_phi) / (1 - inv_phi) * 0.5;
        wr = pr_pre < inv_phi ? pr_pre / inv_phi * 0.5 : 0.5 + (pr_pre - inv_phi) / (1 - inv_phi) * 0.5;
        osc_l = sin(2 * $pi * wl);
        osc_r = sin(2 * $pi * wr);
      ) :
      waveform == 5 ? (  // Golden GS
        inv_phi = 1 / 1.618033988749895;
        osc_l = sin(2 * $pi * pl + inv_phi * sin(2 * $pi * pl));
        osc_r = sin(2 * $pi * pr + inv_phi * sin(2 * $pi * pr));
      ) :
      waveform == 6 ? (  // Bell — additive partials at 1, 2, 3, 4, 6
        osc_l = 0.55 * sin(2 * $pi * pl)
              + 0.25 * sin(4 * $pi * pl)
              + 0.10 * sin(6 * $pi * pl)
              + 0.07 * sin(8 * $pi * pl)
              + 0.03 * sin(12 * $pi * pl);
        osc_r = 0.55 * sin(2 * $pi * pr)
              + 0.25 * sin(4 * $pi * pr)
              + 0.10 * sin(6 * $pi * pr)
              + 0.07 * sin(8 * $pi * pr)
              + 0.03 * sin(12 * $pi * pr);
      ) :
      waveform == 7 ? (  // Wavefold — sin(2 * sin(phase))
        osc_l = sin(2 * sin(2 * $pi * pl));
        osc_r = sin(2 * sin(2 * $pi * pr));
      ) :
      waveform == 8 ? (  // Half-sine — full-wave rectified, bipolar
        osc_l = 2 * abs(sin(2 * $pi * pl)) - 1;
        osc_r = 2 * abs(sin(2 * $pi * pr)) - 1;
      ) :
      waveform == 9 ? (  // Phi-cascade — fundamental + φ⁻¹·2nd + φ⁻²·3rd
        inv_phi = 1 / 1.618033988749895;
        inv_phi2 = inv_phi * inv_phi;
        osc_l = sin(2 * $pi * pl) + inv_phi * sin(4 * $pi * pl) + inv_phi2 * sin(6 * $pi * pl);
        osc_r = sin(2 * $pi * pr) + inv_phi * sin(4 * $pi * pr) + inv_phi2 * sin(6 * $pi * pr);
      ) :
      waveform == 10 ? (  // Phi Triangle — golden phase warp → TRIANGLE output.
                          //   This is the manual's documented "Golden TS"
                          //   behavior, and was Melody Phase's original
                          //   slot 3 implementation. Moved here so the
                          //   Polyrhythm-compatible sine-output Golden TS
                          //   can live at slot 3 in both plugins. Matches
                          //   the corresponding "Phi Triangle" slot in
                          //   Polyrhythm Phase.
        inv_phi = 1 / 1.618033988749895;
        wl = pl < inv_phi ? pl / inv_phi * 0.5 : 0.5 + (pl - inv_phi) / (1 - inv_phi) * 0.5;
        wr = pr < inv_phi ? pr / inv_phi * 0.5 : 0.5 + (pr - inv_phi) / (1 - inv_phi) * 0.5;
        osc_l = (wl < 0.5 ? 4 * wl - 1 : 3 - 4 * wl);
        osc_r = (wr < 0.5 ? 4 * wr - 1 : 3 - 4 * wr);
      ) :
      waveform == 11 ? (  // Phi Sine — golden phase warp → sine output, no
                          //   pre-warp. The manual's documented "Golden SG"
                          //   behavior, and was Melody Phase's original
                          //   slot 4 implementation. Cleaner / less bright
                          //   than the Polyrhythm-compatible Golden SG at
                          //   slot 4, which adds a sine prewarp. Matches
                          //   the corresponding "Phi Sine" slot in
                          //   Polyrhythm Phase.
        inv_phi = 1 / 1.618033988749895;
        wl = pl < inv_phi ? pl / inv_phi * 0.5 : 0.5 + (pl - inv_phi) / (1 - inv_phi) * 0.5;
        wr = pr < inv_phi ? pr / inv_phi * 0.5 : 0.5 + (pr - inv_phi) / (1 - inv_phi) * 0.5;
        osc_l = sin(2 * $pi * wl);
        osc_r = sin(2 * $pi * wr);
      ) :
      waveform == 12 ? (  // Square — +1 for the first half of the cycle,
                          //   -1 for the second. PolyBLEP-corrected at
                          //   both edges (the wrap at 0 and the fall at
                          //   0.5) so it stays clean at high pitches.
                          //   Matches the Square slot in Polyrhythm Phase.
        dtl = v_freq_current_l[i] / srate;
        dtr = v_freq_current_r[i] / srate;
        sql = pl < 0.5 ? 1 : -1;
        tdl = pl - 0.5; tdl < 0 ? tdl += 1;
        osc_l = sql + polyblep(pl, dtl) - polyblep(tdl, dtl);
        sqr = pr < 0.5 ? 1 : -1;
        tdr = pr - 0.5; tdr < 0 ? tdr += 1;
        osc_r = sqr + polyblep(pr, dtr) - polyblep(tdr, dtr);
      ) : (  // Pulse — same shape, but the falling edge sits at
             //   pulse_duty instead of 0.5. At duty 0.5 this is
             //   identical to Square; narrower gets thinner and more
             //   nasal. A duty other than 50 introduces a DC offset,
             //   which is inaudible and attenuated by the envelope —
             //   the same accepted tradeoff as Half-sine.
        dtl = v_freq_current_l[i] / srate;
        dtr = v_freq_current_r[i] / srate;
        sql = pl < pulse_duty ? 1 : -1;
        tdl = pl - pulse_duty; tdl < 0 ? tdl += 1;
        osc_l = sql + polyblep(pl, dtl) - polyblep(tdl, dtl);
        sqr = pr < pulse_duty ? 1 : -1;
        tdr = pr - pulse_duty; tdr < 0 ? tdr += 1;
        osc_r = sqr + polyblep(pr, dtr) - polyblep(tdr, dtr);
      );

      // Apply this voice's smoothed envelope, per-voice gain, and
      // master gain. Smoothed (not raw) so attack=0 / release=0
      // transitions don't click.
      //
      // Per-voice Gain drift (targets 10-17): a per-sample dB offset
      // on this voice, converted to a linear multiplier. This is the
      // continuous volume swell that makes the line breathe. 1.0 when
      // no Gain drift is configured for this voice.
      gain_drift_db = target_drift_offset[16 + 5 * i] + speed_ramp_ramp_t_mem[16 + 5 * i] * speed_ramp_by_mem[16 + 5 * i];
      gain_drift_mul = gain_drift_db != 0 ? db_to_lin(gain_drift_db) : 1;
      amp = v_env_smoothed[i] * v_gain[i] * gain_drift_mul * master_gain_eff;
      // Solo: a voice that is not soloed keeps its turn but makes no sound.
      any_solo && !v_solo[i] ? amp = 0;

      // Pan — mirrors Polyrhythm Phase. When enabled, each voice's
      // L and R get separate amplitude multipliers based on the
      // pan position, instead of summing straight to out_l/out_r.
      // Pan is applied AFTER the osc/amp split so the binaural
      // beat (frequency difference between channels) is preserved
      // across the pan — collapsing osc_l + osc_r before panning
      // would destroy that.
      pan_enabled ? (
        pan_mode >= 4 ? (
          // Per-cycle modes: one shared position, already scaled by Pan spread
          // inside percycle_pan, held until the next note moves it. The pan
          // smoother below turns each step into a short sweep, so even hard
          // Alternating at 100% spread cannot click.
          raw_pan = v_pan_cycle_pos[i];
        ) : pan_mode < 2 ? (
          // Tremolo / Increment: pan position oscillates via LFO.
          // pan_rate_mult carries the Pan Rate drift (target 9).
          // * host_scale so pan follows the project tempo in Host x mode. Pan

          // advances on its own accumulator rather than through dt, so it does

          // NOT pick up combined_scale and has to be scaled here explicitly.

          pan_phase[i] += (mo11 != 0 ? v_pan_freq_d[i] : v_pan_freq[i]) * pan_rate_mult * pan_host_scale / srate;
          pan_phase[i] >= 1 ? pan_phase[i] -= 1;
          raw_pan = sin(pan_phase[i] * 2 * $pi) * pan_spread;
        ) : (
          // Spread / Spread Reversed: position is static; smoother
          // below handles transitions cleanly when the user flips
          // a voice's Active toggle or changes Pan Mode mid-play.
          raw_pan = v_pan_static[i] * pan_spread;
        );
        // pan_smooth_coeff_global is computed in @slider so we don't
        // call exp() 8 times per sample. Time constant follows
        // Glide time in Legato mode (so pan and pitch glide
        // together), 10ms otherwise.
        pan_smooth[i] = pan_smooth[i] * pan_smooth_coeff_global + raw_pan * (1 - pan_smooth_coeff_global);
        pan_pos   = (pan_smooth[i] + 1.0) * 0.5;
        pan_l_mul = cos(pan_pos * $pi * 0.5);
        pan_r_mul = sin(pan_pos * $pi * 0.5);
        out_l += osc_l * amp * pan_l_mul;
        out_r += osc_r * amp * pan_r_mul;
      ) : (
        out_l += osc_l * amp;
        out_r += osc_r * amp;
      );
    );
  );
  i += 1;
);

spl0 = out_l;
spl1 = out_r;

);  // close start-delay else branch

@serialize
// 2026-09-10: 55 targets, magic 2500055. A save from before that (28 targets,
// magics 2100028-2400028) is read at its own width into scratch banks, then
// every bank is moved to its target's new place. @init has already filled the
// new targets with their defaults, and the old ones' stepping defaults map to
// the same defaults, so only what the old save actually held is copied.
ser_magic = 2600000 + N_TARGETS;   // 2026-09-10: Solo renumber witness; stream unchanged
file_var(0, ser_magic);
(ser_magic == 2600000 + N_TARGETS || ser_magic == 2500000 + N_TARGETS) ? (
  file_mem(0, target_drift_up,    N_TARGETS);
  file_mem(0, target_drift_down,  N_TARGETS);
  file_mem(0, target_drift_per,   N_TARGETS);
  file_mem(0, target_drift_shape, N_TARGETS);
  file_var(0, last_target_select);
  file_mem(0, speed_ramp_by_mem,    N_TARGETS);
  file_mem(0, speed_ramp_dur_mem,   N_TARGETS);
  file_mem(0, speed_ramp_delay_mem, N_TARGETS);
  file_var(0, last_sr_target);
  file_var(0, host_bpm_saved);
  file_mem(0, drift_play_mem, N_TARGETS);
  file_mem(0, drift_rest_mem, N_TARGETS);
  file_mem(0, sr_play_mem,    N_TARGETS);
  file_mem(0, sr_rest_mem,    N_TARGETS);
  file_mem(0, target_drift_moves, N_TARGETS);
  mel_ser_ok = 1;
) : (ser_magic == 2400028 || ser_magic == 2300028 ||
     ser_magic == 2200028 || ser_magic == 2100028) ? (
  file_mem(0, o_up, 28); file_mem(0, o_down, 28); file_mem(0, o_per, 28); file_mem(0, o_shape, 28);
  file_var(0, mel_old_sel);
  file_mem(0, o_by, 28); file_mem(0, o_dur, 28); file_mem(0, o_delay, 28);
  file_var(0, mel_old_sr);
  ser_magic != 2100028 ? file_var(0, host_bpm_saved);
  ser_magic >= 2300028 ? (
    file_mem(0, o_play, 28); file_mem(0, o_rest, 28);
    file_mem(0, o_srplay, 28); file_mem(0, o_srrest, 28);
  );
  ser_magic >= 2400028 ? file_mem(0, o_moves, 28);
  mel_t = 0;
  loop(28,
    mel_n = mel_old_to_new(mel_t);
    target_drift_up[mel_n]      = o_up[mel_t];
    target_drift_down[mel_n]    = o_down[mel_t];
    target_drift_per[mel_n]     = o_per[mel_t];
    target_drift_shape[mel_n]   = o_shape[mel_t];
    speed_ramp_by_mem[mel_n]    = o_by[mel_t];
    speed_ramp_dur_mem[mel_n]   = o_dur[mel_t];
    speed_ramp_delay_mem[mel_n] = o_delay[mel_t];
    ser_magic >= 2300028 ? (
      drift_play_mem[mel_n] = o_play[mel_t]; drift_rest_mem[mel_n] = o_rest[mel_t];
      sr_play_mem[mel_n] = o_srplay[mel_t];  sr_rest_mem[mel_n] = o_srrest[mel_t];
    );
    ser_magic >= 2400028 ? target_drift_moves[mel_n] = o_moves[mel_t];
    mel_t += 1;
  );
  last_target_select = mel_old_to_new(mel_old_sel);
  last_sr_target     = mel_old_to_new(mel_old_sr);
  mel_ser_ok = 1;
) : ( mel_ser_ok = 0; );

// TRACK-DUPLICATE FIX. On read, put the visible Drift and Ramp sliders back to
// the restored banks for the restored selectors. Adds no data.
mel_ser_ok && file_avail(0) >= 0 ? (
  slider98 = target_drift_up[last_target_select];
