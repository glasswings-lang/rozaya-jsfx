desc: Dapple
//tags: bubble bubbles water droplet fizz texture generator
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/
//
// A scattered-droplet texture generator. Random pitched events pop on irregular
// timing, each ringing and chirping upward as it fades, piling up into a
// pointillist wash — somewhere between rain on glass, plinking droplets and a
// resonant fizz. (It set out to synthesize water, never got there, and became
// its own thing.) Each event blends two voices:
//   - NOISE: a noise burst through a resonant lowpass — fizz, gurgle, steam.
//   - TONE:  a clean sine that chirps upward — a bright "plink" (little
//            resonators rise in pitch as they collapse; the tonal approach to
//            water synthesis, after Andy Farnell / Minnaert).
// The Tone-vs-Noise knob blends them: all noise = gurgle bed, all tone = plinky
// droplets, in between = the dappled mix.
//
// GENERATOR or EFFECT: by default it generates from internal noise. Turn up
// "Excite from input" and the noise voice is driven by the audio on the track
// instead — feed it a noisescape / broadband texture and it bubbles THAT.
// (For tonal sources use the sibling Bubbler; Dapple's engine wants broadband.)
//
// POLYPHONIC: 32 independent voices per channel, so overlapping bubbles ring
// out on their own voices instead of cutting each other off. A new bubble takes
// the quietest voice, so it never truncates one that's still audibly ringing.
// Two independent channels give natural stereo. Adds to whatever's on the track
// so it layers; put it on an empty track for bubbles alone.
//
// Resonant lowpass is the Cockos state-variable topology (standard JSFX);
// noise is Park-Miller (MINSTD), one independent stream per channel.

slider1:6<0.001,1000,0.001>Bubble rate (BPM / sec / Hz / beats per bubble / per beat)
slider3:70<0,100,1>Timing randomness (%)
// --- Pitch (R22) ----------------------------------------------------------
// Breath Generator's shipped block, dropped on unchanged. Rozaya, 2026-09-09:
// "use breath gen as an example. They did it perfectly there."
//
// MODE FIRST, deliberately -- it decides whether the number below means
// anything. Defaults to Hz, which is what every saved project holds, so a
// migrated instance reads exactly as it did.
slider4:0<0,2,1{Hz,Semitones,Cents}>Pitch mode
// A REAL control both ways: pick C4 or type 60, move either and the other
// follows. Hidden outside Semitones, where it would be lying.
slider5:60<0,127,1{C-1,C#-1,D-1,D#-1,E-1,F-1,F#-1,G-1,G#-1,A-1,A#-1,B-1,C0,C#0,D0,D#0,E0,F0,F#0,G0,G#0,A0,A#0,B0,C1,C#1,D1,D#1,E1,F1,F#1,G1,G#1,A1,A#1,B1,C2,C#2,D2,D#2,E2,F2,F#2,G2,G#2,A2,A#2,B2,C3,C#3,D3,D#3,E3,F3,F#3,G3,G#3,A3,A#3,B3,C4,C#4,D4,D#4,E4,F4,F#4,G4,G#4,A4,A#4,B4,C5,C#5,D5,D#5,E5,F5,F#5,G5,G#5,A5,A#5,B5,C6,C#6,D6,D#6,E6,F6,F#6,G6,G#6,A6,A#6,B6,C7,C#7,D7,D#7,E7,F7,F#7,G7,G#7,A7,A#7,B7,C8,C#8,D8,D#8,E8,F8,F#8,G8,G#8,A8,A#8,B8,C9,C#9,D9,D#9,E9,F9,F#9,G9}>Note name
// THE pitch. Hz is the frequency; Semitones is the MIDI note number (60 =
// middle C); Cents is the same axis at x100. Range widened from 40..1500 per
// R12 carve-out 1 -- a range may be raised, never lowered.
slider6:150<0,20000,0.001>Pitch value (Hz / semitones / cents)
// The ONE fine tune. There is exactly one.
slider7:0<-1000,1000,0.001>Fine tune
slider8:2<0,2,1{Hz,Semitones,Cents}>Fine tune unit
slider9:440<20,2000,0.1>Tuning reference (Hz)
slider10:50<0,100,1>Pitch spread (%)
slider11:0.85<0,0.97,0.01>Resonance (noise voice)
slider12:120<5,1000,1>Bubble length (ms)
slider13:40<0,100,1>Rise (%)
slider16:80<0,100,1>Stereo width (%)
slider17:0<-24,12,0.01>Output (dB)

// --- Transport -----------------------------------------------------------
// Added 2026-09-05. Part 2 puts transport after the plugin's own controls and
// BEFORE drift and ramp, so the four drift/ramp blocks written earlier today
// shifted up by four to make room. Free to do, because nothing has been
// migrated yet -- this plugin gets ONE migration, at the end.
//
// A "cycle" here is one MEAN bubble interval, i.e. whatever Bubble rate is set
// to. Timing randomness still scatters the individual bubbles inside it.
slider18:0<0,1000,0.001>Start delay (in rate mode units)
slider19:0<0,1000,1>Play for (cycles)
slider20:0<0,1000,1>Rest for (cycles)
// There is no "LFO at rest" here, and deliberately: this plugin has no LFO to
// freeze. Drift carries its own play/rest, which is the equivalent control.
slider21:0<0,1,1{Pass-through,Silence}>Output at rest

// --- Drift ---------------------------------------------------------------
// Added 2026-09-05. Dapple was built after the 2026-06 drift sweep and never
// joined it. Block copied from `veil.jsfx`, the built-and-ear-tested reference.
// Eleven targets -- everything continuous the plugin has.
//
// Bubble length and Pitch are read when a bubble is BORN, so drifting them
// changes new bubbles rather than ones already sounding: the effect arrives over
// about one bubble rather than instantly.
slider22:0<0,10,1{Bubble rate,Timing randomness,Pitch,Pitch spread,Resonance,Bubble length,Rise,Tone vs noise,Excite from input,Stereo width,Output}>Drift target
// Amounts are per target, in the target's own unit -- except Bubble rate, which
// is in BPM in every rate mode (the settled suite rule: the plugin converts,
// you never do).
slider23:0<0,1000,0.01>Drift up amount (units match target)
slider24:0<0,1000,0.01>Drift down amount (units match target)
slider25:20<0,1000,0.01>Drift period (0 = off)
slider26:0<0,2,1{Cycles,Seconds,Beats}>Drift period unit
// WHETHER THIS TARGET'S DRIFT MOVES WITH ITS OWN THING, OR ON A CLOCK.
// Rozaya, 2026-09-09: the choice "should have been a switch from the very
// beginning" -- both are valid artistic decisions and neither is the plugin's
// to make. INSERTED here rather than appended, on her call, with the migration
// accepted: "Don't apend when we can aford not to. we can afford not to."
//
// `With the target` advances the drift one whole step each time that target's
// own thing happens, so a period of 8 counts eight of them. `On a clock`
// advances it continuously, drawing the whole curve.
//
// DEFAULTS REPRODUCE WHAT drift_is_stepped() HARDCODED, so nothing saved moves.
slider27:0<0,1,1{With the target,On a clock}>Drift movement
slider28:0<0,2,1{Sine,Triangle,Random}>Drift shape
slider29:0<0,1000,0.01>Drift play for (periods, 0 = always)
slider30:0<0,1000,0.01>Drift rest for (periods, 0 = always)

// --- Ramp ----------------------------------------------------------------
slider31:0<0,10,1{Bubble rate,Timing randomness,Pitch,Pitch spread,Resonance,Bubble length,Rise,Tone vs noise,Excite from input,Stereo width,Output}>Ramp target
slider32:0<-1000,1000,0.001>Ramp by (units match target)
slider33:2<0,3,1{Cycles,Seconds,Minutes,Beats}>Ramp time unit
slider34:0<0,1000,0.01>Ramp duration (in ramp time units)
slider35:0<0,1000,0.01>Ramp play for (0 = smooth)
slider36:0<0,1000,0.01>Ramp rest for (0 = smooth)
slider37:0<0,1,1{Off,On}>Ramp engage
slider38:0<0,1000,0.01>Ramp start delay (in ramp time units)
slider14:50<0,100,1>Tone vs noise (%, 0 = noise, 100 = tone plink)
slider15:0<0,100,1>Excite from input (%, 0 = internal noise, 100 = input)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output


// --- Host tempo sync (sliders 12-13) ------------------------------------
// Own rate: free-running bubbles per second -- the original behaviour.
// Host x:   Bubble rate becomes beats per bubble, so 4 is one bubble every
//           is one bubble per beat. Two entries only; this plugin has one
//           unit. Appended at the END per the never-renumber rule.
slider2:2<0,4,1{BPM,Seconds,Hz,Every N beats,N per beat}>Rate mode

// Writes a multiplier into Bubble rate on change then gets out of the way.
// "Custom" (default) never writes. Not "Free" -- that means FREE-RUNNING
// in sync UI, which Own rate already is.

@init
// Path A: no ext_noinit, so @init re-runs on transport play and reseeds.
NV = 32;                     // voices per channel
// Park-Miller seeds (nonzero, < 2^31-1), different per channel.
seedL = 1103527590;
seedR = 1234567891;
// Bubble scheduling, 2026-09-05: COUNT UP to a target recomputed every sample,
// the same shape Heartbeat and Womb use, so a rate change lands immediately
// instead of waiting out an interval fixed when the last bubble was born.
// elapsed_* counts samples since the last bubble; jfac_* is that bubble's
// jitter as a PROPORTION of the normal gap, rolled once at birth.
// Seeded so the very first bubble arrives at once, which is what a countdown
// starting at 0 used to do.
elapsedL = 0;  elapsedR = 0;
jfacL    = 0;  jfacR    = 0;
// per-voice state arrays (32 slots each): env, base pitch, SVF n3, SVF n4, sine phase
eL = 0;    p0L = 32;   n3L = 64;    n4L = 96;    phL = 128;   // left  0..159
eR = 160;  p0R = 192;  n3R = 224;   n4R = 256;   phR = 288;   // right 160..319
memset(0, 0, 320);
SINE_LEVEL = 0.3;            // tonal-voice level, roughly matched to the noise voice

// --- Drift / Ramp state. Eleven targets, 16-slot strides; the voice arrays own
//     0..319, so the base is 320. Re-derive rather than trusting this number.
N_TARGETS = 11;
db = 320;
speed_ramp_by_mem            = db;         // CONFIG
speed_ramp_dur_mem           = db + 16;    // CONFIG
speed_ramp_delay_mem         = db + 32;    // CONFIG
speed_ramp_ramp_t_mem        = db + 48;    // RUNTIME
speed_ramp_delay_elapsed_mem = db + 64;    // RUNTIME
sr_play_mem                  = db + 80;    // CONFIG
sr_rest_mem                  = db + 96;    // CONFIG
sr_pr_resting_mem            = db + 112;   // RUNTIME
sr_pr_accum_mem              = db + 128;   // RUNTIME
drift_up_mem                 = db + 144;   // CONFIG
drift_down_mem               = db + 160;   // CONFIG
drift_per_mem                = db + 176;   // CONFIG
drift_shape_mem              = db + 192;   // CONFIG
drift_play_mem               = db + 208;   // CONFIG
drift_rest_mem               = db + 224;   // CONFIG
drift_phase_mem              = db + 240;   // RUNTIME
drift_prev_mem               = db + 256;   // RUNTIME
drift_curr_mem               = db + 272;   // RUNTIME
drift_offset_mem             = db + 288;   // RUNTIME
drift_pr_resting_mem         = db + 304;   // RUNTIME
drift_pr_accum_mem           = db + 320;   // RUNTIME
drift_step_mem               = db + 336;   // RUNTIME -- "your turn came round"
drift_moves_mem              = db + 352;   // CONFIG -- 0 with the target, 1 clock

// WHICH TARGETS STEP, AND WHICH FLOW (2026-09-09). Same rule as Bubbler, whose
// grain engine this one is a sibling of.
//
// The event is A BUBBLE BEING BORN. Three values are read at that moment and
// then belong to that bubble:
//   1 Timing randomness -- the jitter roll for the NEXT gap.
//   2 Pitch             -- baked into this bubble's starting frequency.
//   3 Pitch spread      -- likewise.
// Those three step once per bubble, so a period of 8 is eight bubbles.
//
// Everything else is read every sample, inside the playback loop, and keeps
// drifting continuously: 0 Bubble rate (a threshold compared per sample, and
// its period is referenced against the PRE-drift rate so it never measures
// itself), 4 Resonance, 5 Bubble length, 6 Rise, 7 Tone vs noise,
// 8 Excite from input, 9 Stereo width, 10 Output.
//
// EVERY BIRTH COUNTS, on either channel -- see the note at the spawn site.
function drift_is_stepped(idx) ( drift_moves_mem[idx] == 0; );

// --- Pitch (R22) ----------------------------------------------------------
// Resolve the pitch block to Hz. Lifted from Breath Generator's shipped
// pitch_to_hz(), which is the version Rozaya heard and approved on 2026-09-09.
//
// The VALUE is the pitch -- nothing here is an offset from a note. That was the
// shape she rejected, because making the value an offset turns it into a second
// fine tune with the wrong half labelled coarse.
//
// `voff` is drift + ramp, added to the value and therefore in the VALUE's own
// unit: semitones drift in semitones, Hz in Hz, cents in cents.
function dp_pitch_hz(voff) local(m, v, f, fm, hz) (
  m  = slider4;
  v  = slider6 + voff;
  hz = m == 1 ? tuning_ref * pow(2, (v - 69) / 12) :
       m == 2 ? tuning_ref * pow(2, (v / 100 - 69) / 12) :
                v;
  fm = slider8;
  f  = slider7;
  hz = fm == 1 ? hz * pow(2, f / 12) :
       fm == 2 ? hz * pow(2, f / 1200) :
                 hz + f;
  // Clamped to what the voice can honour, not to the audible band.
  min(max(hz, 20), 20000);
);
// SEEDED: dp_pitch_hz() reads tuning_ref and @block can run before @slider ever
// has. Unseeded that is 0, which puts every note at 0 Hz.
tuning_ref  = 440;
pitch_ui_inited = 0;
last_note   = 60;
last_pval   = 150;

// Shared play/rest window counter. `tick` is how much of ONE window passes per
// sample, which lets each caller keep its own units. Off unless BOTH > 0.
function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

// CONFIG defaults -- ONE TIME ONLY. @init re-runs on every transport play.
drift_cfg_inited != 1 ? (
  j = 0;
  loop(N_TARGETS,
    speed_ramp_by_mem[j] = 0;  speed_ramp_dur_mem[j] = 0;
    speed_ramp_delay_mem[j] = 0;
    sr_play_mem[j] = 0;        sr_rest_mem[j] = 0;
    drift_up_mem[j] = 0;       drift_down_mem[j] = 0;
    drift_per_mem[j] = 20;     drift_shape_mem[j] = 0;
    drift_play_mem[j] = 0;     drift_rest_mem[j] = 0;
    drift_moves_mem[j] = (j >= 1 && j <= 3) ? 0 : 1;
    j += 1;
  );
  drift_cfg_inited = 1;
);

// RUNTIME reset on EVERY @init.
j = 0;
loop(N_TARGETS,
  speed_ramp_ramp_t_mem[j] = 0;  speed_ramp_delay_elapsed_mem[j] = 0;
  sr_pr_resting_mem[j] = 0;      sr_pr_accum_mem[j] = 0;
  drift_phase_mem[j] = rand(1);
  drift_prev_mem[j] = 0;         drift_curr_mem[j] = 0;
  drift_offset_mem[j] = 0;
  drift_pr_resting_mem[j] = 0;   drift_pr_accum_mem[j] = 0;
  drift_step_mem[j] = 0;
  j += 1;
);

host_bpm = max(tempo, 0.001);

// Transport state. All RUNTIME: reset on every @init, i.e. every transport play,
// which is the convention here (no ext_noinit).
start_delay_elapsed = 0;
pr_resting          = 0;
pr_cycle_progress   = 0;
rest_fade           = 1;

// `tempo` is READ-ONLY in JSFX; read only, into a global not named `tempo`.

@slider
rate_mode = slider2;
// RETIRED 2026-09-02 (R13 revised). This picker spared you arithmetic on a
// multiplier; Bubble rate now means beats per bubble, so "every 4 beats" is
// typing 4. Inert and hidden; the slider stays declared because ids can never
// be renumbered.
// Host x: slider1 is beats per bubble. tempo/60 is beats per second, so
// dividing by the beat count gives bubbles per second -- one bubble every N
// beats. @block repeats this so a tempo change lands live.
// `rate` is bubbles per second. R20's four modes convert into it:
//   0 BPM      bubbles per minute  -> /60
//   1 Seconds  seconds per bubble  -> 1/x
//   2 Hz       bubbles per second  -> as-is   (THIS PLUGIN'S DEFAULT, see Rate Mode)
//   3 Host x   every N beats       -> (tempo/60)/x
rate      = rate_mode == 4 ? max((max(tempo,0.001)/60)*max(slider1,0.001), 0.0001)
          : rate_mode == 3 ? max((max(tempo,0.001)/60)/max(slider1,0.001), 0.0001)
          : rate_mode == 2 ? max(slider1, 0.01)
          : rate_mode == 1 ? max(1 / max(slider1, 0.001), 0.0001)
                           : max(slider1 / 60, 0.0001);
jitter    = slider3 * 0.01;
// The note name and the pitch value are ONE control seen two ways while the
// mode is Semitones: move either and the other follows. Outside Semitones the
// note name is hidden and inert, so nothing is written from it.
tuning_ref = slider9;
pitch_ui_inited ? (
  slider4 == 1 ? (
    slider5 != last_note ? (
      slider6 = slider5;                 // picked a name -> that is the value
      slider_automate(slider6);
    ) : slider6 != last_pval ? (
      slider5 = max(0, min(127, floor(slider6 + 0.5)));
      slider_automate(slider5);
    );
  );
);
last_note = slider5;
last_pval = slider6;
// The name is a lie in Hz or Cents, so it does not appear there.
slider_show(slider5, slider4 == 1);

basePitch = dp_pitch_hz(0);
spreadOct = slider10 * 0.01 * 3;      // up to 3 octaves of random pitch
res       = min(slider11, 0.97);
decayCoef = exp(-1 / (srate * max(slider12,1) * 0.001));
rise      = slider13 * 0.01;
width     = slider16 * 0.01;
outlev    = 2 ^ (slider17 / 6);
tone      = slider14 * 0.01;         // 0 = noise voice, 1 = tonal plink
// BASELINES ONLY from here down: @sample rebuilds each of these every sample as
// eff_*, because Drift and Ramp can move all eleven. Left in place rather than
// deleted -- provably inert, and deleting them buys nothing. `rate` is the
// exception; eff_rate is built from it.
inp       = slider15 * 0.01;         // 0 = internal noise, 1 = excite noise voice from input

// Start delay is expressed in RATE MODE UNITS, the same convention the Tremolo
// and the Sweeping Filter use: seconds in Seconds mode, and CYCLES in BPM, Hz
// and Host x -- so "4" waits four bubbles' worth whatever the rate means today.
start_delay_units = slider18;
start_delay_sec   = slider2 == 1 ? start_delay_units
                                  : start_delay_units / max(rate, 0.0001);
play_for_cycles = slider19;
rest_for_cycles = slider20;
pr_enabled      = play_for_cycles > 0 && rest_for_cycles > 0;
// Leaving the gate must not strand it in a rest. One-armed: an empty
// else-branch is a silent compile failure in eel2 (CLAUDE.md).
!pr_enabled && pr_resting ? ( pr_resting = 0; pr_cycle_progress = 0; );
rest_silence = slider21;

// --- Ramp target selector save/restore (nested-selector pattern) ----------
sel_speed_target = slider31;
last_speed_target != sel_speed_target ? (
  speed_ramp_by_mem[last_speed_target]    = slider32;
  speed_ramp_dur_mem[last_speed_target]   = slider34;
  sr_play_mem[last_speed_target]          = slider35;
  sr_rest_mem[last_speed_target]          = slider36;
  speed_ramp_delay_mem[last_speed_target] = slider38;
  slider32 = speed_ramp_by_mem[sel_speed_target];
  slider34 = speed_ramp_dur_mem[sel_speed_target];
  slider35 = sr_play_mem[sel_speed_target];
  slider36 = sr_rest_mem[sel_speed_target];
  slider38 = speed_ramp_delay_mem[sel_speed_target];
  slider_automate(slider32); slider_automate(slider34);
  slider_automate(slider35); slider_automate(slider36);
  slider_automate(slider38);
  last_speed_target = sel_speed_target;
) : (
  speed_ramp_by_mem[sel_speed_target]    = slider32;
  speed_ramp_dur_mem[sel_speed_target]   = slider34;
  sr_play_mem[sel_speed_target]          = slider35;
  sr_rest_mem[sel_speed_target]          = slider36;
  speed_ramp_delay_mem[sel_speed_target] = slider38;
);

// --- Drift target selector save/restore ----------------------------------
sel_target = slider22;
last_target_select != sel_target ? (
  drift_up_mem[last_target_select]    = slider23;
  drift_down_mem[last_target_select]  = slider24;
  drift_per_mem[last_target_select]   = slider25;
  drift_shape_mem[last_target_select] = slider28;
  drift_moves_mem[last_target_select] = slider27;
  drift_play_mem[last_target_select]  = slider29;
  drift_rest_mem[last_target_select]  = slider30;
  slider23 = drift_up_mem[sel_target];
  slider24 = drift_down_mem[sel_target];
  slider25 = drift_per_mem[sel_target];
  slider28 = drift_shape_mem[sel_target];
  slider27 = drift_moves_mem[sel_target];
  slider29 = drift_play_mem[sel_target];
  slider30 = drift_rest_mem[sel_target];
  slider_automate(slider23); slider_automate(slider24);
  slider_automate(slider25); slider_automate(slider28); slider_automate(slider27);
  slider_automate(slider29); slider_automate(slider30);
  last_target_select = sel_target;
) : (
  drift_up_mem[sel_target]    = slider23;
  drift_down_mem[sel_target]  = slider24;
  drift_per_mem[sel_target]   = slider25;
  drift_shape_mem[sel_target] = slider28;
  drift_moves_mem[sel_target] = slider27;
  drift_play_mem[sel_target]  = slider29;
  drift_rest_mem[sel_target]  = slider30;
);
meanIntv  = srate / rate;            // avg samples between bubbles

@block
// ADOPT THE MIRROR HERE, NOT IN @slider. A tracker adopted in @slider can
// capture a DEFAULT -- @slider may run with declared defaults before a project's
// saved values are applied, and the next pass then reads the load itself as a
// user edit and writes one half of the pair over the other. That is the August
// 2026 Sweeping Filter fault, and Breath Generator adopts in @block for exactly
// this reason. While the flag is 0 the binding writes nothing.
!pitch_ui_inited ? (
  last_note = slider5;
  last_pval = slider6;
  pitch_ui_inited = 1;
);
// Project tempo, once per block. Used when Drift period unit or Ramp time
// unit is set to Beats.
host_bpm = max(tempo, 0.001);
// --- Restore-order guard for the change-detecting controls below -----------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the picker then fires and slider_automate()s
//     its ratio over a rate that was set by hand. @block cannot run before the
//     instance is configured, so adopting here is right whatever order the
//     restore paths ran in. (Proved 2026-08-23: a Sweeping Filter in BPM mode
//     with Host ratio "every 2 beats" had Rate Value stamped to 0.5 on every
//     load and every track duplicate.)
// Follow the project tempo live in Host x. @slider does not re-run when the
// tempo changes, so the rate is recomputed here.
rate_mode >= 3 ? (
  rate = rate_mode == 4 ? max((max(tempo,0.001)/60)*max(slider1,0.001), 0.0001)
                        : max((max(tempo,0.001)/60)/max(slider1,0.001), 0.0001);
);

@sample
// --- Ramp clocks, one per target. Engage (slider37) is a freeze/resume gate:
//     while Off, progress HOLDS; only transport play (via @init) resets it.
// Ramp time unit. One factor turns the Ramp block's time values into seconds.
// Cycles counts THIS plugin's own cycles, referenced against the rate BEFORE
// drift and ramp touch it, so a ramp cannot alter its own clock. Seconds is
// wall clock. Minutes is 60 s and is the DEFAULT -- every saved instance has
// this control unset, so the default is what they all run on, and moving it
// would rewrite live ramps (2026-09-05). A beat is 60/tempo s, recomputed per
// sample so Beats follows a live tempo change rather than remembering one.
ramp_time_scale =
  slider33 == 3 ? 60 / max(host_bpm, 0.001) :
  slider33 == 2 ? 60 :
  slider33 == 1 ? 1 :
                  1 / max(rate, 0.00001);
slider37 ? (
  di = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[di] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[di] * ramp_time_scale * srate;
      speed_ramp_delay_elapsed_mem[di] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[di] += 1;
      ) : (
        // Staircase: advance for `play`, hold for `rest`, repeat. The holds come
        // OUT of the duration rather than extending it.
        sr_pl = sr_play_mem[di];
        sr_rs = sr_rest_mem[di];
        sr_pr_on = sr_pl > 0 && sr_rs > 0;
        sr_hold = pr_frozen(sr_pr_accum_mem, sr_pr_resting_mem, di,
                            1.0 / (ramp_time_scale * srate), sr_pl, sr_rs);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !sr_hold ? (
          sr_step = 1.0 / (srate * speed_ramp_dur_mem[di] * ramp_time_scale);
          sr_pr_on ? sr_step *= (sr_pl + sr_rs) / sr_pl;
          speed_ramp_ramp_t_mem[di] += sr_step;
          speed_ramp_ramp_t_mem[di] > 1.0 ? speed_ramp_ramp_t_mem[di] = 1.0;
        );
      );
    );
    di += 1;
  );
);

// --- Per-target drift wave.
di = 0;
loop(N_TARGETS,
  up    = drift_up_mem[di];
  down  = drift_down_mem[di];
  per   = drift_per_mem[di];
  shape = drift_shape_mem[di];
  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    // Cycles is the default and counts THIS plugin's own cycles, referenced
    // against the PRE-drift rate so drifting the rate cannot modulate its own
    // drift period. Seconds is wall clock. Beats follows the live tempo.
    period_samples =
      slider26 == 2 ? max(per * 60 / max(host_bpm, 0.001) * srate, 1) :
      slider26 == 1 ? max(per * srate, 1) :
                      max(per * srate / max(rate, 0.00001), 1);
    // While resting the phase does not advance, so the offset STAYS where it
    // stopped -- freeze in place, not a return to centre. The FRACTION of the
    // play value chooses where it parks: x.25 crest, x.75 trough, x.0 and x.5
    // neutral -- so a whole number parks at no-change every time and is nearly
    // inaudible, and an awkward fraction is the interesting one.
    // A STEPPED target gets a whole 1/period, but only on the sample a bubble
    // was born; a continuous one gets the usual per-sample slice. Play/rest
    // ticks on the same quantity, so "rest for N periods" keeps its meaning.
    drift_is_stepped(di) ? (
      d_tick = drift_step_mem[di] ? 1.0 / max(per, 0.001) : 0;
      drift_step_mem[di] = 0;
    ) : (
      d_tick = 1.0 / period_samples;
    );

    d_frozen = pr_frozen(drift_pr_accum_mem, drift_pr_resting_mem, di,
                         d_tick,
                         drift_play_mem[di], drift_rest_mem[di]);
    d_frozen ? (
      new_phase = drift_phase_mem[di];
    ) : (
      new_phase = drift_phase_mem[di] + d_tick;
      new_phase >= 1.0 ? (
        new_phase -= 1.0;
        shape == 2 ? (
          drift_prev_mem[di] = drift_curr_mem[di];
          drift_curr_mem[di] = rand(2) - 1;
        );
      );
      drift_phase_mem[di] = new_phase;
    );
    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = drift_prev_mem[di] +
        (drift_curr_mem[di] - drift_prev_mem[di]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  drift_offset_mem[di] = drift_offset_local;
  di += 1;
);

// --- Effective values = baseline + drift + ramp, every sample. Targets:
//     0 rate, 1 randomness, 2 pitch, 3 pitch spread, 4 resonance, 5 length,
//     6 rise, 7 tone vs noise, 8 excite from input, 9 width, 10 output.
q0  = drift_offset_mem[0]  + speed_ramp_ramp_t_mem[0]  * speed_ramp_by_mem[0];
q1  = drift_offset_mem[1]  + speed_ramp_ramp_t_mem[1]  * speed_ramp_by_mem[1];
q2  = drift_offset_mem[2]  + speed_ramp_ramp_t_mem[2]  * speed_ramp_by_mem[2];
q3  = drift_offset_mem[3]  + speed_ramp_ramp_t_mem[3]  * speed_ramp_by_mem[3];
q4  = drift_offset_mem[4]  + speed_ramp_ramp_t_mem[4]  * speed_ramp_by_mem[4];
q5  = drift_offset_mem[5]  + speed_ramp_ramp_t_mem[5]  * speed_ramp_by_mem[5];
q6  = drift_offset_mem[6]  + speed_ramp_ramp_t_mem[6]  * speed_ramp_by_mem[6];
q7  = drift_offset_mem[7]  + speed_ramp_ramp_t_mem[7]  * speed_ramp_by_mem[7];
q8  = drift_offset_mem[8]  + speed_ramp_ramp_t_mem[8]  * speed_ramp_by_mem[8];
q9  = drift_offset_mem[9]  + speed_ramp_ramp_t_mem[9]  * speed_ramp_by_mem[9];
q10 = drift_offset_mem[10] + speed_ramp_ramp_t_mem[10] * speed_ramp_by_mem[10];

// Rate amounts are in BPM in EVERY rate mode -- the settled suite rule -- and
// `rate` is bubbles per second, so 60 BPM is 1 per second.
eff_rate      = max(0.0001, rate + q0 / 60);
eff_meanIntv  = srate / eff_rate;
eff_jitter    = max(0, min(100, slider3 + q1)) * 0.01;
// Pitch and Bubble length are read at grain birth, so these change NEW bubbles
// only -- the effect arrives over about one bubble rather than instantly.
eff_pitch     = dp_pitch_hz(q2);
eff_spreadOct = max(0, min(100, slider10 + q3)) * 0.01 * 3;
eff_res       = max(0, min(0.97, slider11 + q4));
eff_len       = max(1, slider12 + q5);
eff_decay     = exp(-1 / (srate * eff_len * 0.001));
eff_rise      = max(0, min(100, slider13 + q6)) * 0.01;
eff_tone      = max(0, min(100, slider14 + q7)) * 0.01;
eff_inp       = max(0, min(100, slider15 + q8)) * 0.01;
eff_width     = max(0, min(100, slider16 + q9)) * 0.01;
eff_out       = 2 ^ ((slider17 + q10) / 6);

// --- Transport: start delay, then the play/rest gate ----------------------
// Start delay counts in whatever the rate mode means (seconds in Seconds mode,
// cycles otherwise), converted to seconds in @slider.
start_delay_elapsed < start_delay_sec ? ( start_delay_elapsed += 1 / srate; );

// Play/Rest advances in CYCLES at the live bubble rate, so it stretches and
// shrinks with the rate exactly as the bubbles do -- including while Drift is
// moving that rate.
pr_enabled ? (
  pr_cycle_progress += eff_rate / srate;
  !pr_resting ? (
    pr_cycle_progress >= play_for_cycles ? ( pr_resting = 1; pr_cycle_progress = 0; );
  ) : (
    pr_cycle_progress >= rest_for_cycles ? ( pr_resting = 0; pr_cycle_progress = 0; );
  );
);

// The gate stops new bubbles being BORN. Ones already sounding decay away
// naturally, which is what makes the entry into a rest smooth rather than a cut.
pr_gate = (start_delay_elapsed >= start_delay_sec) && !(pr_enabled && pr_resting);
// While gated, hold both timers at a full interval so resuming does not fire a
// burst of bubbles that queued up during the silence.
// While gated, hold both clocks at zero so resuming waits a full interval
// rather than firing a burst of bubbles that queued up during the silence.
!pr_gate ? ( elapsedL = 0; elapsedR = 0; );

// Output at rest: Pass-through leaves the input alone (rest_target 1, and the
// bubbles have already stopped); Silence mutes everything. Smoothed over ~3 ms
// so the boundary is not a click.
rest_target = (pr_enabled && pr_resting && rest_silence == 1) ? 0 : 1;
rest_smooth = exp(-1 / (srate * 0.003));
rest_fade   = rest_target + (rest_fade - rest_target) * rest_smooth;
dryL = spl0;
dryR = spl1;
// ============ LEFT ============
seedL = (seedL * 48271) % 2147483647; noiseL = (seedL / 2147483647) * 2 - 1;
exciteL = (1 - eff_inp) * noiseL + eff_inp * dryL;    // internal noise, input, or a blend
elapsedL += 1;
elapsedL >= max(eff_meanIntv * jfacL, 1) ? (
  seedL = (seedL * 48271) % 2147483647; rp = seedL / 2147483647;   // pitch roll
  seedL = (seedL * 48271) % 2147483647; rt = seedL / 2147483647;   // timing roll
  vsel = 0; vmin = abs(n3L[0]) + abs(n4L[0]); j = 1;
  loop(NV - 1,
    e2 = abs(n3L[j]) + abs(n4L[j]);
    e2 < vmin ? (vmin = e2; vsel = j);
    j += 1;
  );
  np = eff_pitch * 2 ^ (eff_spreadOct * (rp * 2 - 1));
  p0L[vsel] = max(20, min(np, srate * 0.1));
  eL[vsel] = 1; n3L[vsel] = 0; n4L[vsel] = 0; phL[vsel] = 0;
  // Roll the jitter as a PROPORTION, not a length. The gap it applies to
  // is re-read every sample above, so drifting or ramping the rate moves
  // this bubble's due time as it goes.
  jfacL = 1 + eff_jitter * (rt * 2 - 1);
  // A bubble was born: the three values it just read take their turn.
  // EVERY birth counts, on either channel -- nothing here is tied to one
  // side. Left and right spawn independently, so when they land together you
  // hear one bubble and this takes one turn, and when Timing randomness
  // scatters them you hear two and it takes two. The count follows what is
  // actually audible instead of a channel we happened to pick.
  drift_step_mem[1] = 1; drift_step_mem[2] = 1; drift_step_mem[3] = 1;
  elapsedL = 0;
);
sumL = 0; j = 0;
loop(NV,
  ev = eL[j];
  pf = p0L[j] * (1 + eff_rise * (1 - ev) * 4);      // pitch rises as the bubble fades
  // noise voice: resonant lowpass swept by pf
  fc = min(pf, srate * 0.1);
  cut = 2 * sin($pi * fc / srate);
  fb = eff_res + eff_res / (1 - cut);
  n3L[j] = n3L[j] + cut * (exciteL * ev - n3L[j] + fb * (n3L[j] - n4L[j]));
  n4L[j] = n4L[j] + cut * (n3L[j] - n4L[j]);
  // tonal voice: sine at pf, chirping up
  phL[j] += 2 * $pi * min(pf, srate * 0.45) / srate;
  phL[j] >= 2*$pi ? phL[j] -= 2*$pi;
  toneV = sin(phL[j]) * ev * SINE_LEVEL;
  sumL += (1 - eff_tone) * n4L[j] + eff_tone * toneV;
  eL[j] = ev * eff_decay;
  j += 1;
);

// ============ RIGHT ============
seedR = (seedR * 69621) % 2147483647; noiseR = (seedR / 2147483647) * 2 - 1;
exciteR = (1 - eff_inp) * noiseR + eff_inp * dryR;
elapsedR += 1;
elapsedR >= max(eff_meanIntv * jfacR, 1) ? (
  seedR = (seedR * 69621) % 2147483647; rp = seedR / 2147483647;
  seedR = (seedR * 69621) % 2147483647; rt = seedR / 2147483647;
  vsel = 0; vmin = abs(n3R[0]) + abs(n4R[0]); j = 1;
  loop(NV - 1,
    e2 = abs(n3R[j]) + abs(n4R[j]);
    e2 < vmin ? (vmin = e2; vsel = j);
    j += 1;
  );
  np = eff_pitch * 2 ^ (eff_spreadOct * (rp * 2 - 1));
  p0R[vsel] = max(20, min(np, srate * 0.1));
  eR[vsel] = 1; n3R[vsel] = 0; n4R[vsel] = 0; phR[vsel] = 0;
  // Roll the jitter as a PROPORTION, not a length. The gap it applies to
  // is re-read every sample above, so drifting or ramping the rate moves
  // this bubble's due time as it goes.
  jfacR = 1 + eff_jitter * (rt * 2 - 1);
  // A bubble was born: the three values it just read take their turn.
  // EVERY birth counts, on either channel -- nothing here is tied to one
  // side. Left and right spawn independently, so when they land together you
  // hear one bubble and this takes one turn, and when Timing randomness
  // scatters them you hear two and it takes two. The count follows what is
  // actually audible instead of a channel we happened to pick.
  drift_step_mem[1] = 1; drift_step_mem[2] = 1; drift_step_mem[3] = 1;
  elapsedR = 0;
);
sumR = 0; j = 0;
loop(NV,
  ev = eR[j];
  pf = p0R[j] * (1 + eff_rise * (1 - ev) * 4);
  fc = min(pf, srate * 0.1);
  cut = 2 * sin($pi * fc / srate);
  fb = eff_res + eff_res / (1 - cut);
  n3R[j] = n3R[j] + cut * (exciteR * ev - n3R[j] + fb * (n3R[j] - n4R[j]));
  n4R[j] = n4R[j] + cut * (n3R[j] - n4R[j]);
  phR[j] += 2 * $pi * min(pf, srate * 0.45) / srate;
  phR[j] >= 2*$pi ? phR[j] -= 2*$pi;
  toneV = sin(phR[j]) * ev * SINE_LEVEL;
  sumR += (1 - eff_tone) * n4R[j] + eff_tone * toneV;
  eR[j] = ev * eff_decay;
  j += 1;
);

// ============ stereo width + output (added to input so it layers) ============
mono = (sumL + sumR) * 0.5;
bubL = (mono + eff_width * (sumL - mono)) * eff_out;
bubR = (mono + eff_width * (sumR - mono)) * eff_out;
// safety soft-clip only when exciting from input (protects against a loud/tonal
// source resonating the noise voice); pure-generator mode is left untouched
eff_inp > 0 ? (
  bubL = bubL / sqrt(1 + bubL * bubL);
  bubR = bubR / sqrt(1 + bubR * bubR);
);
spl0 = (spl0 + bubL) * rest_fade;
spl1 = (spl1 + bubR) * rest_fade;

@serialize
// Dapple had NO @serialize until 2026-09-05. Drift and Ramp remember a separate
// amount per target and that memory has to travel with the project.
// Version-guarded; the magic encodes the target count, so a format change
// degrades to @init defaults rather than to garbage. An OLD project has no blob
// at all, fails the check, and lands on defaults -- drift and ramp both off,
// exactly how this plugin behaved before today.
dp_magic = 3600000 + N_TARGETS;
file_var(0, dp_magic);
(dp_magic == 3600000 + N_TARGETS || dp_magic == 3500000 + N_TARGETS) ? (
  file_mem(0, speed_ramp_by_mem,    N_TARGETS);
  file_mem(0, speed_ramp_dur_mem,   N_TARGETS);
  file_mem(0, speed_ramp_delay_mem, N_TARGETS);
  file_mem(0, sr_play_mem,          N_TARGETS);
  file_mem(0, sr_rest_mem,          N_TARGETS);
  file_var(0, last_speed_target);
  file_mem(0, drift_up_mem,    N_TARGETS);
  file_mem(0, drift_down_mem,  N_TARGETS);
  file_mem(0, drift_per_mem,   N_TARGETS);
  file_mem(0, drift_shape_mem, N_TARGETS);
  file_mem(0, drift_play_mem,  N_TARGETS);
  file_mem(0, drift_rest_mem,  N_TARGETS);
  file_var(0, last_target_select);
  // Drift movement, per target. An older blob has no such field and keeps
  // @init's defaults -- which are exactly the behaviour it was written under.
  dp_magic >= 3600000 ? ( file_mem(0, drift_moves_mem, N_TARGETS); );

  // TRACK-DUPLICATE FIX, and it is not optional: without it a duplicated track
  // silently ZEROES whichever target is selected. On READ file_avail(0) >= 0;
  // on WRITE it is < 0. @serialize is the ONE section that runs on both.
  // sliderchange(-1), NOT slider_automate -- this must not write automation.
  file_avail(0) >= 0 ? (
    slider32 = speed_ramp_by_mem[last_speed_target];
    slider34 = speed_ramp_dur_mem[last_speed_target];
    slider35 = sr_play_mem[last_speed_target];
    slider36 = sr_rest_mem[last_speed_target];
    slider38 = speed_ramp_delay_mem[last_speed_target];
    slider23 = drift_up_mem[last_target_select];
    slider24 = drift_down_mem[last_target_select];
    slider25 = drift_per_mem[last_target_select];
    slider28 = drift_shape_mem[last_target_select];
    slider27 = drift_moves_mem[last_target_select];
    slider29 = drift_play_mem[last_target_select];
    slider30 = drift_rest_mem[last_target_select];
    sliderchange(-1);
  );
);
