desc: Rhythm Track
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/

slider1:120<0.001,1000,0.001>Tempo (BPM / sec / Hz / beats per cycle / per beat)

// --- Host tempo sync: the retired ratio picker ----------------------------
//
// Own BPM  — slider1 is the tempo, as it always was. Free-running; the
//            project tempo is ignored entirely.
// Host x   — slider1 becomes BEATS PER CYCLE against the project tempo. 1 is a
//            tick on every beat, 2 is every other beat, 0.5 is two ticks a
//            beat. A metronome that could not follow the project tempo was the
//            odd one out here.
//
//            A CYCLE HERE IS ONE TICK. The label uses the suite's own phrase
//            rather than a word picked just for this plugin: consistency across
//            the plugins outranks a slightly nicer word in any single file.
//
//            It used to be a MULTIPLIER of the tempo. R13-revised, 2026-09-02:
//            a multiplier is a number you cannot hear without doing arithmetic
//            against the project tempo first.
//
// Two entries rather than four: this plugin only ever had one unit, so
// "Seconds" and "Hz" would be nonsense on it. Appended at the END of the
// slider range per the never-renumber rule, even though it reads better
// next to Tempo -- moving it would scramble every saved project.
slider2:0<0,4,1{BPM,Seconds,Hz,Every N beats,N per beat}>Rate Mode
slider3:4<1,1000,1>Beats per bar
slider4:0<-1,1,0.01>Swing amount
// --- Pitch (R22) ----------------------------------------------------------
// One block behind a target, the same sibling shape Heartbeat's two thumps use.
slider5:0<0,2,1{All,Strong,Weak}>Pitch target
slider6:0<0,2,1{Hz,Semitones,Cents}>Pitch mode
slider7:81<0,127,1{C-1,C#-1,D-1,D#-1,E-1,F-1,F#-1,G-1,G#-1,A-1,A#-1,B-1,C0,C#0,D0,D#0,E0,F0,F#0,G0,G#0,A0,A#0,B0,C1,C#1,D1,D#1,E1,F1,F#1,G1,G#1,A1,A#1,B1,C2,C#2,D2,D#2,E2,F2,F#2,G2,G#2,A2,A#2,B2,C3,C#3,D3,D#3,E3,F3,F#3,G3,G#3,A3,A#3,B3,C4,C#4,D4,D#4,E4,F4,F#4,G4,G#4,A4,A#4,B4,C5,C#5,D5,D#5,E5,F5,F#5,G5,G#5,A5,A#5,B5,C6,C#6,D6,D#6,E6,F6,F#6,G6,G#6,A6,A#6,B6,C7,C#7,D7,D#7,E7,F7,F#7,G7,G#7,A7,A#7,B7,C8,C#8,D8,D#8,E8,F8,F#8,G8,G#8,A8,A#8,B8,C9,C#9,D9,D#9,E9,F9,F#9,G9}>Note name
slider8:880<0,20000,0.001>Pitch value (Hz / semitones / cents)
slider9:0<-1000,1000,0.001>Fine tune
slider10:2<0,2,1{Hz,Semitones,Cents}>Fine tune unit
slider11:440<20,2000,0.1>Tuning reference (Hz)
slider12:1.5<0.5,8,0.1>Tone resonance (Q)
slider13:0.75<0,1,0.01>Strong beat volume
slider14:0.5<0,1,0.01>Weak beat volume
slider15:0.04<0.001,1000,0.001>Strong beat decay (seconds)
slider16:0.02<0.001,1000,0.001>Weak beat decay (seconds)
slider17:1<0,1,0.01>Pan spread (0=mono, 1=full L/R)
slider18:0<0,5,1{Mono,Accent L / Weak R,Alternating,Distributed,Converging,Diverging}>Pan mode
slider19:0<0,1,1{Normal,Flipped}>Pan direction

// Sit silent for N beats after playback starts, then resume normally.
// Counted at the current Tempo. 0 disables the delay. Re-arms on every
// transport stop/start.
slider20:0<0,1000,0.001>Start delay (beats)

// Per-beat Play/Rest gate. Plays N ticks normally, then suppresses
// the next M tick triggers (silent), then resumes — repeats forever.
// Useful as a practice tool ("4 ticks, 4 silent, 4 ticks, 4 silent").
// The previous tick's decay tail continues through the start of the
// rest period — gate is "don't trigger new ticks," not a hard cut.
// The bar grid (beat_index, accent placement) keeps marching during
// rest, so the accent stays locked to Beats per bar regardless of
// where the rest periods fall. If you want the accent to always land
// on beat 1 of every play period, set Play for to a multiple of
// Beats per bar. 0 in either slider disables the gate. Resets on
// every transport stop/start.
slider21:0<0,1000,1>Play for (beats)
slider22:0<0,1000,1>Rest for (beats)

// Speed ramp: signed-delta, nested-selector (brought to Drift parity in
// the automation-replacement sweep, see docs/planned-features.md). Ships
// in v2.14. Pick a target (slider23), then slider24 is the `by` amount for
// THAT target; both targets ramp in parallel and the selector only chooses
// which one slider24 is editing. Engage (slider29) is a freeze/resume gate
// (NOT a restart edge); only transport play resets ramp_t.
//
// The Speed ramp target selector is slider23 (top of this block) so that in
// the UI / NVDA parameter order it reads ABOVE the by/duration/engage
// controls it governs. Achieving that meant renumbering the Speed Ramp +
// Drift blocks (REAPER orders sliders by ID, not file position), so the old
// single-target IDs 17-20 shifted — existing Rhythm Track projects reset
// their Speed Ramp + Drift configs on upgrade (both are off-by-default; the
// metronome sound on sliders 1-16 is untouched). Re-add the instance for
// clean defaults, or reconfigure. See the manual's migration note.
// SIXTEEN since 2026-09-11 (R24), in the order of the controls they reach. Beats
// per bar is one on Rozaya's call: "Beats per bar belongs on there too." Swing
// moved from 1 to 2; the plugin remaps an old save.
slider23:0<0,15,1{Tempo,Beats per bar,Swing amount,Strong pitch,Weak pitch,Strong fine tune,Weak fine tune,Tuning reference,Tone resonance,Strong volume,Weak volume,Strong decay,Weak decay,Pan spread,Play for,Rest for}>Ramp target
slider24:0<-1000,1000,0.001>Ramp by (per target, units match target)
// What the duration and start delay below are counted in -- one unit for both,
// so they always mean the same thing as each other. DEFAULT IS 2, Minutes,
// which is what this block always did; index 0 would silently reinterpret every
// saved ramp. Cycles counts this plugin's own beats, referenced against the
// tempo BEFORE drift and ramp touch it, so a ramp cannot alter its own clock.
slider25:2<0,3,1{Cycles,Seconds,Minutes,Beats}>Ramp time unit (all targets)
slider26:0<0,1000,0.1>Ramp duration (per target, in ramp time units)
// Ramp play/rest, per target, in ramp time units: the ramp advances for `play`,
// holds for `rest`, and repeats -- a staircase instead of a smooth glide. The
// holds come OUT of the duration rather than extending it, so Ramp duration goes
// on meaning "you arrive in about this long". Both zero is the smooth ramp.
slider27:0<0,1000,0.01>Ramp play for (per target, 0 = smooth)
slider28:0<0,1000,0.01>Ramp rest for (per target, 0 = smooth)
slider29:0<0,1,1{Off,On}>Ramp engage (all targets)
slider30:0<0,1000,0.1>Ramp start delay (per target, in ramp time units)

// Per-target drift: nested-selector pattern matching Womb v3 /
// breath gen / heartbeat. Pick a target (slider31), then sliders 23-26
// hold THAT target's drift config. Switching the selector saves current
// values to the old target's memory slot and loads the new target's values
// into the sliders. Both targets drift in parallel; the selector just
// chooses which one you're currently editing. Period unit is beats for both
// targets. For slow wall-clock feel, set a long period (~960 beats ≈ 8 min
// at 120 BPM). (Drift IDs shifted +1 from the old 21-25 layout in the v2.14
// reorg above — same reset story.)
slider31:0<0,15,1{Tempo,Beats per bar,Swing amount,Strong pitch,Weak pitch,Strong fine tune,Weak fine tune,Tuning reference,Tone resonance,Strong volume,Weak volume,Strong decay,Weak decay,Pan spread,Play for,Rest for}>Drift target
slider32:0<0,1000,0.01>Drift up amount (per target, units match target)
slider33:0<0,1000,0.01>Drift down amount (per target, units match target)
slider34:8<0,1000,1>Drift period (per target, 0 = off)
// What the period is COUNTED IN. Cycles is this plugin's native count and the
// default -- one metronome beat is one cycle here, so a period of 8 means eight
// of its own beats, which is exactly what this control did before the unit
// existed. Seconds is wall clock. Beats counts the PROJECT tempo, which is a
// different clock from the metronome's own whenever the two disagree.
slider35:0<0,2,1{Cycles,Seconds,Beats}>Drift period unit (all targets)
// WHETHER THIS TARGET'S DRIFT MOVES WITH ITS OWN THING, OR ON A CLOCK -- the
// switch the six stepping plugins got on 2026-09-09. INSERTED beside the period
// controls, not appended, 2026-09-11: "it should get the switch."
// `With the target` advances the drift one whole step per beat (heard or silent),
// and Beats per bar one step per bar. `On a clock` draws the whole curve, and a
// click catches it wherever it is. Default On a clock: what both old targets did.
slider36:1<0,1,1{With the target,On a clock}>Drift movement (per target)
slider37:0<0,2,1{Sine,Triangle,Random}>Drift shape (per target)
// Drift play/rest, per target, counted in PERIODS. Both must be above zero or
// the gate is off, which is what 0 means. While resting the phase does not
// advance, so the offset FREEZES where it stopped rather than returning to
// centre -- and the FRACTION of the play value chooses where it parks: x.25
// crest, x.75 trough, x.0 and x.5 neutral. A whole number parks at no-change
// every time and is nearly inaudible; an awkward fraction is the useful one.
slider38:0<0,1000,0.01>Drift play for (per target, periods, 0 = always)
slider39:0<0,1000,0.01>Drift rest for (per target, periods, 0 = always)


// RETIRED 2026-09-04 by R13-revised, and hidden. It existed only to spare you
// arithmetic on a multiplier; "every 4 beats" is now typing 4 into Tempo. NOT
// deleted -- slider ids are primary keys and removing one shifts every control
// above it in every saved project.
slider40:0<0,15,1{Custom,every 8 beats,every 4 beats,every 3 beats,every 2 beats,phi slow,2 per 3 beats,3 per 4 beats,1 per beat,4 per 3 beats,3 per 2 beats,phi fast,2 per beat,3 per beat,4 per beat,8 per beat}>Host ratio (retired)

@init
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: REAPER re-runs @init on every transport play / render
// start, resetting all runtime for free (beat clock, tick state, drift
// runtime, Speed Ramp, Start Delay, Play/Rest). Only the drift CONFIG
// bank must survive the re-run; it's guarded by drift_cfg_inited below.

tick_buf_len = 65536;

strong_buf    = 0;
weak_buf      = strong_buf + tick_buf_len;
noise_scratch = weak_buf   + tick_buf_len;
// swing_offset needs its own memory region. Eel2 defaults any
// undeclared variable to 0; without an explicit base address here,
// swing_offset[i] would alias strong_buf[i] and the per-beat swing
// writes in @slider would corrupt the first `timesig` samples of
// the rendered strong-beat audio (~tiny click at the very start of
// the strong beat). 32 slots is generous — slider max is 20.
noise_len    = 300;
swing_offset = noise_scratch + noise_len;

strong_len = 0;
weak_len   = 0;

tick_playing = 0;
tick_pos     = 0;
tick_src     = 0;
tick_len     = 0;
tick_pan     = 0;

// Start beat_phase at 1.0 so the very first @sample call triggers
// the downbeat. With beat_phase=0 the first beat doesn't fire until
// samples_per_beat samples have elapsed — a full beat of silence
// before the metronome actually starts ticking. (Bug pre-dated the
// initial public release; reported by ear.)
beat_phase       = 1.0;
// Seek detection for the Host x beat-grid placement in @block. was_moving = 0
// means the first block after a transport start always places the grid.
was_moving         = 0;
predicted_beat_pos = 0;
host_ratio_inited = 0;   // picker adopts on load rather than firing
beat_index       = 0;

// Seed track_bpm from slider1 in @init so the first @sample call has
// a valid BPM available. @init re-runs on every transport play (Path A,
// no ext_noinit), so this re-seeds each play; it ensures effective_tempo
// computations have a defined baseline even if @sample touches them
// before @slider's first run.
// (NOTE: see @slider for the `tempo` vs `track_bpm` naming gotcha.)
track_bpm        = slider1;
samples_per_beat = (60.0 / max(slider1, 0.001)) * srate;

// rate_units is slider1 in ITS OWN unit — plain BPM in Own BPM mode, beats
// per cycle in Host x — and track_bpm is the real ticks-per-minute it works
// out to. Drift and Ramp offsets are added to TRACK_BPM, in the @sample line
// that computes effective_tempo, so they are deltas in real BPM in both modes
// — which is the suite rule (CLAUDE.md: drift and ramp amounts are in BPM in
// every mode, Host x included; the plugin converts, never the user).
//
// An earlier version of this comment said the offsets were added to rate_units
// before the multiply. They never were; the code has always added them after.
// Corrected 2026-09-04 while converting Host x.
rate_units       = slider1;

// Start Delay state. start_delay_elapsed counts up from 0 at each
// play start; while it's below start_delay_sec the @sample work is
// gated and output is silent.
last_play_state     = 0;
start_delay_elapsed = 0;
start_delay_sec     = 0;

// Play/Rest gate state. pr_beat counts ticks elapsed in the current
// play (or rest) period; threshold compare flips the period. Init
// to 0 because rhythm-track has no init pre-fire — the first tick
// fires via the normal beat_phase >= 1.0 trigger path on sample 1.
pr_resting     = 0;
pr_beat        = 0;
play_for_beats = 0;
rest_for_beats = 0;
pr_enabled     = 0;

// Speed Ramp state. Engage (global) is a freeze/resume gate, not an edge;
// only transport play resets the per-target ramp clocks. As of v2.14 the
// ramp is PER-TARGET: each target has its own `by`, duration, start delay,
// and progress clock (banks defined below).

// --- v2.9 Drift target memory banks ---
//
// 2 targets × 8 fields = 16 slots. Arrays are 16-slot-spaced so
// targets can grow up to 16 later without re-laying-out. Placed right
// after swing_offset's reserved region (131404) at 131520 — no overlap
// with the tick render buffers below.
//
// Targets, in control order since 2026-09-11 (units in brackets):
//   0 Tempo (BPM)   1 Beats per bar (beats, rounded, latched on the downbeat)
//   2 Swing amount (swing fraction, clamped to -1..1)
//   3 Strong pitch, 4 Weak pitch (that beat's Pitch mode)
//   5 Strong fine tune, 6 Weak fine tune (that beat's Fine tune unit)
//   7 Tuning reference (Hz)   8 Tone resonance (Q)
//   9 Strong volume, 10 Weak volume (0-1)   11 Strong decay, 12 Weak decay (s)
//  13 Pan spread (0-1)   14 Play for, 15 Rest for (beats)
// Sixteen exactly fills the 16-slot stride of the banks below.
N_TARGETS = 16;

// --- Pitch banks (R22, 2026-09-09) ----------------------------------------
// 0 = All (writes across), 1 = Strong, 2 = Weak.
// ABOVE THE DRIFT BANKS, NOT BELOW. The first attempt put these at 7000, which
// is INSIDE this plugin's 65536-word tick buffer -- the banks were overwriting
// audio. Caught because a fresh instance stopped rendering bit-identical.
N_PITCH        = 3;
pitch_note_mem = 131856;
pitch_val_mem  = 131872;
pitch_mode_mem = 131888;
pitch_fine_mem = 131904;
pitch_fmod_mem = 131920;
pui_last       = 131936;
function pitch_read_slot(psel) ( psel > 0 ? psel : 1; );
function pitch_write(psel, pbank, pval) (
  psel > 0 ? ( pbank[psel] = pval; ) : ( pbank[1] = pval; pbank[2] = pval; );
);
function pitch_capture(psel, pbank, pval, pslot) (
  pval != pui_last[pslot] ? ( pitch_write(psel, pbank, pval); pui_last[pslot] = pval; );
);
// voff and foff are drift + ramp on the pitch and on its fine tune, each in its
// own unit (2026-09-11). With both zero this is exactly what it was.
function pitch_to_hz(idx, voff, foff) local(mo, v, f, fm, hz) (
  mo = pitch_mode_mem[idx]; v = pitch_val_mem[idx] + voff;
  hz = mo == 1 ? tuning_ref * pow(2, (v - 69) / 12) :
       mo == 2 ? tuning_ref * pow(2, (v / 100 - 69) / 12) : v;
  fm = pitch_fmod_mem[idx]; f = pitch_fine_mem[idx] + foff;
  hz = fm == 1 ? hz * pow(2, f / 12) : fm == 2 ? hz * pow(2, f / 1200) : hz + f;
  min(max(hz, 1), 20000);
);
tuning_ref        = 440;
pitch_ui_inited   = 0;
last_pitch_target = 0;
target_drift_up     = 131520;
target_drift_down   = 131536;
target_drift_per    = 131552;
target_drift_shape  = 131568;
target_drift_phase  = 131584;
target_drift_prev   = 131600;
target_drift_curr   = 131616;
target_drift_offset = 131632;

// Speed ramp per-target banks (v2.14). Mirror the drift banks; 16-slot-spaced
// after target_drift_offset (131632). `by` / duration / start-delay are CONFIG
// (survive transport, restored by @serialize); ramp_t / delay_elapsed are
// RUNTIME (reset every @init / transport play).
speed_ramp_by_mem            = 131648;  // signed delta per target (CONFIG)
speed_ramp_dur_mem           = 131664;  // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 131680;  // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 131696;  // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 131712;  // delay sample counter per target (RUNTIME)

// Drift and Ramp play/rest, per target (2026-09-06). 16-slot-spaced like the
// banks above. play/rest are CONFIG (survive a transport re-init, restored by
// @serialize); accumulator and resting flag are RUNTIME. FIRST FREE SLOT AFTER
// THIS BLOCK IS 131856 -- re-derive rather than trusting this comment.
drift_play_mem       = 131728;  // periods of drift to run  (CONFIG)
drift_rest_mem       = 131744;  // periods to hold frozen   (CONFIG)
sr_play_mem          = 131760;  // ramp time to advance     (CONFIG)
sr_rest_mem          = 131776;  // ramp time to hold        (CONFIG)
drift_pr_accum_mem   = 131792;  // (RUNTIME)
drift_pr_resting_mem = 131808;  // (RUNTIME)
sr_pr_accum_mem      = 131824;  // (RUNTIME)
sr_pr_resting_mem    = 131840;  // (RUNTIME)

// Drift movement and its "your turn came round" flags (2026-09-11). ABOVE the
// pitch banks, which end at 131941 -- re-derive rather than trusting this.
target_drift_moves = 131952;   // CONFIG -- 0 with the target, 1 on a clock
drift_step_mem     = 131968;   // RUNTIME
rt_scratch         = 131984;   // an old save's two, while remapping
function drift_is_stepped(idx) ( target_drift_moves[idx] == 0; );
// Old two-target index -> new: Tempo stays, Swing moves to 2.
function rt_o2n(o) ( o == 1 ? 2 : o; );
// Drift + ramp on one target, in its own unit.
function rt_q(k) ( target_drift_offset[k] + speed_ramp_ramp_t_mem[k] * speed_ramp_by_mem[k]; );

// Shared play/rest gate, byte-identical to the one in Melody, the Sweeping
// Filter, Tremolo, Phaser, Bubbler, Dapple, Resonance Bank and the Morpher.
// `tick` is how much of one play/rest unit passes per sample, so the caller
// owns the unit and this stays unitless. Returns 1 while the target is resting.
function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

// CONFIG banks (drift up/down/period/shape + speed-ramp by/duration/start-delay
// + selector trackers) — guarded by drift_cfg_inited so the @init re-run on
// every transport play (Path A render fix, no ext_noinit) does NOT wipe the
// user's setup. @serialize restores saved configs on project reload.
drift_cfg_inited != 1 ? (
  // The two beat frequencies this plugin has always had, said as pitches.
  pitch_val_mem[0] = 880; pitch_note_mem[0] = 81;
  pitch_val_mem[1] = 880; pitch_note_mem[1] = 81;
  pitch_val_mem[2] = 440; pitch_note_mem[2] = 69;
  pn_i = 0;
  loop(N_PITCH,
    pitch_mode_mem[pn_i] = 0; pitch_fine_mem[pn_i] = 0; pitch_fmod_mem[pn_i] = 2;
    pn_i += 1;
  );
  last_pitch_target = 0;
  i = 0;
  loop(N_TARGETS,
    target_drift_up[i]    = 0;
    target_drift_down[i]  = 0;
    target_drift_per[i]   = 8;
    target_drift_shape[i] = 0;
    speed_ramp_by_mem[i]    = 0;
    speed_ramp_dur_mem[i]   = 0;
    speed_ramp_delay_mem[i] = 0;
    drift_play_mem[i] = 0; drift_rest_mem[i] = 0;
    sr_play_mem[i]    = 0; sr_rest_mem[i]    = 0;
    target_drift_moves[i] = 1;
    i += 1;
  );
  last_target_select = 0;
  last_sr_target     = 0;
  drift_cfg_inited = 1;
);

// Drift + speed-ramp RUNTIME resets on EVERY @init (every transport play).
i = 0;
loop(N_TARGETS,
  target_drift_phase[i]  = 0;
  target_drift_prev[i]   = 0;
  target_drift_curr[i]   = 0;
  target_drift_offset[i] = 0;
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  drift_pr_accum_mem[i]   = 0; drift_pr_resting_mem[i] = 0;
  sr_pr_accum_mem[i]      = 0; sr_pr_resting_mem[i]    = 0;
  drift_step_mem[i]       = 0;
  i += 1;
);
// What each click was last rendered from. -1 matches nothing, so the first click
// of each kind after a transport play renders.
rs_hz = rs_g = rs_d = rs_q = -1;
rw_hz = rw_g = rw_d = rw_q = -1;
// The bar length in force, latched on each downbeat in @sample.
timesig = max(1, floor(slider3 + 0.5));

nx = 1;
i = 0;
loop(noise_len,
  nx = (479 * nx) % 997;
  noise_scratch[i] = (nx / 500.0) - 1.0;
  i += 1;
);


function render_tick(buf, hz, gain, decay_sec, tone_q)
local(i, len, env, raw, lp_out, peak_val, norm,
      lp_w0, lp_alpha, lp_cos, lp_b0, lp_b1, lp_b2, lp_a1, lp_a2,
      lp_x1, lp_x2, lp_y1, lp_y2,
      hp_w0, hp_alpha, hp_cos, hp_b0, hp_b1, hp_b2, hp_a1, hp_a2,
      hpx1, hpx2, hpy1, hpy2,
      hp2x1, hp2x2, hp2y1, hp2y2,
      hp3x1, hp3x2, hp3y1, hp3y2,
      hp4x1, hp4x2, hp4y1, hp4y2,
      hp_out) (

  // Dynamic length: 5 time constants captures tail to ~1% of peak
  len = min(ceil(decay_sec * srate * 5) + noise_len, tick_buf_len - 1);

  // Resonant lowpass at 2*hz, Q controlled by slider
  lp_w0    = 2.0 * $pi * min(srate * 0.45, 2.0 * hz) / srate;
  lp_alpha = sin(lp_w0) / (2.0 * tone_q);
  lp_cos   = cos(lp_w0);
  lp_b0    = (1 - lp_cos) / 2 / (1 + lp_alpha);
  lp_b1    = (1 - lp_cos)     / (1 + lp_alpha);
  lp_b2    = lp_b0;
  lp_a1    = -2 * lp_cos      / (1 + lp_alpha);
  lp_a2    = (1 - lp_alpha)   / (1 + lp_alpha);

  // 4-stage biquad highpass at hz (approximates 8-pole slope)
  hp_w0    = 2.0 * $pi * hz / srate;
  hp_alpha = sin(hp_w0) / (2.0 * 0.707);
  hp_cos   = cos(hp_w0);
  hp_b0    =  (1 + hp_cos) / 2 / (1 + hp_alpha);
  hp_b1    = -(1 + hp_cos)     / (1 + hp_alpha);
  hp_b2    =  hp_b0;
  hp_a1    = -2 * hp_cos       / (1 + hp_alpha);
  hp_a2    =  (1 - hp_alpha)   / (1 + hp_alpha);

  lp_x1 = 0; lp_x2 = 0; lp_y1 = 0; lp_y2 = 0;
  hpx1 = 0; hpx2 = 0; hpy1 = 0; hpy2 = 0;
  hp2x1 = 0; hp2x2 = 0; hp2y1 = 0; hp2y2 = 0;
  hp3x1 = 0; hp3x2 = 0; hp3y1 = 0; hp3y2 = 0;
  hp4x1 = 0; hp4x2 = 0; hp4y1 = 0; hp4y2 = 0;

  peak_val = 0.0001;
  i = 0;
  loop(len,
    // Envelope: short attack ramp, then exponential decay
    // Use noise_scratch for the first noise_len samples, silence after
    raw = (i < noise_len) ? noise_scratch[i] : 0;
    env = (i < 5) ? (i / 5.0) : exp(-i / (decay_sec * srate));
    raw = raw * env;

    // Resonant lowpass
    lp_out = lp_b0*raw + lp_b1*lp_x1 + lp_b2*lp_x2 - lp_a1*lp_y1 - lp_a2*lp_y2;
    lp_x2 = lp_x1; lp_x1 = raw;
    lp_y2 = lp_y1; lp_y1 = lp_out;

    // 4-stage highpass - each stage input is previous stage output
    hp_out = hp_b0*lp_out + hp_b1*hpx1 + hp_b2*hpx2 - hp_a1*hpy1 - hp_a2*hpy2;
    hpx2 = hpx1; hpx1 = lp_out; hpy2 = hpy1; hpy1 = hp_out;

    hp_out = hp_b0*hpy1 + hp_b1*hp2x1 + hp_b2*hp2x2 - hp_a1*hp2y1 - hp_a2*hp2y2;
    hp2x2 = hp2x1; hp2x1 = hpy1; hp2y2 = hp2y1; hp2y1 = hp_out;

    hp_out = hp_b0*hp2y1 + hp_b1*hp3x1 + hp_b2*hp3x2 - hp_a1*hp3y1 - hp_a2*hp3y2;
    hp3x2 = hp3x1; hp3x1 = hp2y1; hp3y2 = hp3y1; hp3y1 = hp_out;

    hp_out = hp_b0*hp3y1 + hp_b1*hp4x1 + hp_b2*hp4x2 - hp_a1*hp4y1 - hp_a2*hp4y2;
    hp4x2 = hp4x1; hp4x1 = hp3y1; hp4y2 = hp4y1; hp4y1 = hp_out;

    buf[i] = hp_out;
    abs(hp_out) > peak_val ? peak_val = abs(hp_out);
    i += 1;
  );

  norm = gain / peak_val;
  i = 0;
  loop(len,
    buf[i] = buf[i] * norm;
    i += 1;
  );

  len
);


function beat_pan(idx) local(n, non_accent, steps, step, pos, flip) (
  n          = max(timesig, 1);
  non_accent = n - 1;
  steps      = ceil(non_accent / 2.0); // number of distinct distances from anchor
  flip       = pan_flip ? -1.0 : 1.0;

  pan_mode == 0 ? (
    // Mono
    pos = 0;

  ) : pan_mode == 1 ? (
    // Accent L / Weak R
    pos = (idx == 0) ? -1 : 1;

  ) : pan_mode == 2 ? (
    // Alternating L/R/L/R
    pos = (idx % 2 == 0) ? -1 : 1;

  ) : pan_mode == 3 ? (
    // Distributed: evenly spaced left to right
    n > 1 ? (pos = (idx / (n - 1.0)) * 2.0 - 1.0) : (pos = 0);

  ) : pan_mode == 4 ? (
    // Converging: accent hard left, pairs walk inward toward center
    // beat 0 = -1, beat 1 = hard right, beat 2 = hard left - 1 step...
    idx == 0 ? (
      pos = -1.0;
    ) : (
      step = ceil((idx + 1) / 2); // 1,2,2,3,3,4... for idx 1,2,3,4,5,6
      pos = (idx % 2 == 1) ? (1.0 - (step - 1.0) / steps)
                            : -(1.0 - (step - 1.0) / steps);
      pos = max(-1.0, min(1.0, pos));
    );

  ) : (
    // Diverging: accent center, pairs walk outward symmetrically
    // beat 0 = 0, beat 1 = slight left, beat 2 = slight right...
    idx == 0 ? (
      pos = 0.0;
    ) : (
      step = floor((idx + 1) / 2); // 1,1,2,2,3,3...
      pos = (idx % 2 == 1) ? -(step / steps)
                            :  (step / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  );

  pos * pan_spread * flip
);


@slider

// NOTE: the variable name `tempo` is RESERVED in JSFX — it's a read-only
// system variable that returns REAPER's current project tempo. Assigning
// to `tempo` is silently ignored, which caused effective_tempo to be
// computed against the project tempo (always ~120 BPM by default) and
// completely ignore slider1. Renamed to `track_bpm` throughout to avoid
// the collision. See JSFX docs: https://www.reaper.fm/sdk/js/var.php
//
// Host x mode is the one place we deliberately READ `tempo` — reading is
// fine and always was; only assignment is ignored.

// --- Host ratio picker: RETIRED (R13-revised) -----------------------------
// The guard is forced to 0 rather than the block being deleted, so the
// reasoning stays beside the code it disabled. Tempo says beats per cycle in
// Host x now, so there is no multiplier for a picker to translate -- and a
// picker that WRITES a value is the exact shape that stamped 0.5 over a
// hand-set rate on every load in infantile.RPP.
0 ? (
  host_ratio_sel = slider40;
  host_ratio_sel > 0 ? (
    slider1 =
      host_ratio_sel ==  1 ? 0.125 :
      host_ratio_sel ==  2 ? 0.25  :
      host_ratio_sel ==  3 ? 1/3   :
      host_ratio_sel ==  4 ? 0.5   :
      host_ratio_sel ==  5 ? 0.618 :
      host_ratio_sel ==  6 ? 2/3   :
      host_ratio_sel ==  7 ? 0.75  :
      host_ratio_sel ==  8 ? 1     :
      host_ratio_sel ==  9 ? 4/3   :
      host_ratio_sel == 10 ? 1.5   :
      host_ratio_sel == 11 ? 1.618 :
      host_ratio_sel == 12 ? 2     :
      host_ratio_sel == 13 ? 3     :
      host_ratio_sel == 14 ? 4     :
                             8;
    slider_automate(slider1);
  );
);
rate_mode = slider2;
slider_show(slider40, 0);
// The LANDING BLOCK is gone (R13-revised step 4). It used to stamp the picker
// to "1 per beat" and Tempo to 1 on entering Host x, because meeting a bare
// MULTIPLIER first was the trap -- 120 as a multiplier is a hundred and twenty
// times the project tempo. There is no trap now: 120 beats per cycle is a
// legible number (a tick every 120 beats, very slow), so nothing needs stamping
// and, crucially, the TEMPO SLIDER NEVER HIDES. Hiding it is what forced the
// stamp in the first place.
rate_mode_inited ? last_rate_mode = rate_mode;


// In Host x, slider1 is BEATS PER CYCLE. The project runs at `tempo` beats per
// minute, so a tick every N beats is tempo/N ticks per minute -- which is what
// track_bpm has always been. Everything downstream (samples_per_beat, the drift
// period, Start Delay, the beat clock itself) derives from track_bpm and so
// follows for free. @block re-does this so a tempo change lands live.
//
// Guarded on the NUMERATOR side: inverting a unit inverts its edge cases, and
// `1/max(raw,0.001)` clamps the DENOMINATOR, turning a stopped metronome into a
// thousand-times-tempo one. The slider's declared minimum is 0.001 so it cannot
// reach zero, but the safe form costs nothing.
rate_units   = slider1;
track_bpm    = rate_mode == 4 ? max(tempo, 0.001) * max(rate_units, 0.001) :
               rate_mode == 3 ?
                 (rate_units > 0.001 ? max(tempo, 0.001) / rate_units : 0.001) :
               rate_mode == 2 ? rate_units * 60 :
               rate_mode == 1 ? 60 / max(rate_units, 0.001) :
                 rate_units;
// Beats per bar (timesig) and Tuning reference are no longer read here: the bar
// is latched on each downbeat and the reference when a click fires, both with
// drift and ramp folded in (2026-09-11).
swing        = slider4;
pitch_ui_inited ? (
  sel_pitch = slider5;
  last_pitch_target != sel_pitch ? (
    prs = pitch_read_slot(sel_pitch);
    slider6 = pitch_mode_mem[prs]; slider7 = pitch_note_mem[prs];
    slider8 = pitch_val_mem[prs];  slider9 = pitch_fine_mem[prs];
    slider10 = pitch_fmod_mem[prs];
    slider_automate(slider6);  slider_automate(slider7); slider_automate(slider8);
    slider_automate(slider9);  slider_automate(slider10);
    pui_last[0] = slider6; pui_last[1] = slider7; pui_last[2] = slider8;
    pui_last[3] = slider9; pui_last[4] = slider10;
    last_pitch_target = sel_pitch;
  ) : (
    slider6 == 1 ? (
      slider7 != pui_last[1] ? ( slider8 = slider7; slider_automate(slider8); ) :
      slider8 != pui_last[2] ? ( slider7 = max(0, min(127, floor(slider8 + 0.5))); slider_automate(slider7); );
    );
    pitch_capture(sel_pitch, pitch_mode_mem, slider6,  0);
    pitch_capture(sel_pitch, pitch_note_mem, slider7,  1);
    pitch_capture(sel_pitch, pitch_val_mem,  slider8,  2);
    pitch_capture(sel_pitch, pitch_fine_mem, slider9,  3);
    pitch_capture(sel_pitch, pitch_fmod_mem, slider10, 4);
  );
);
slider_show(slider7, slider6 == 1);

// Pitch, tone, volume, decay and Pan spread are read when a click FIRES, in
// @sample, so drift and ramp reach them (2026-09-11). They derive from the pitch
// BANKS too, which is where bank-derived values belong anyway.
pan_mode     = slider18;
pan_flip     = slider19;

samples_per_beat = (60.0 / track_bpm) * srate;

// Start Delay — beats at the current Tempo.
start_delay_sec = slider20 * 60 / max(track_bpm, 0.001);

// Play/Rest gate: integer beat counts. Both must be > 0 for the
// gate to engage; 0 in either slider disables.
play_for_beats = slider21;
rest_for_beats = slider22;
pr_enabled     = (play_for_beats > 0 && rest_for_beats > 0);

// Speed ramp engage-edge.
// No engage-edge logic. Engage is a freeze/resume gate handled in
// @sample. Only transport play resets ramp_t.

// Drift target selector save/restore (nested-selector pattern).
// Switching slider31 saves sliders 23-26 into the OLD target's slot,
// then loads the NEW target's stored config into sliders 23-26.
// Otherwise captures live edits to the current target's slot. Both
// targets drift in parallel from @sample regardless of selection.
sel_target = slider31;
sel_up     = slider32;
sel_down   = slider33;
sel_per    = slider34;
sel_shape  = slider37;
sel_moves  = slider36;
sel_dplay  = slider38;
sel_drest  = slider39;

last_target_select != sel_target ? (
  target_drift_up[last_target_select]    = sel_up;
  target_drift_down[last_target_select]  = sel_down;
  target_drift_per[last_target_select]   = sel_per;
  target_drift_shape[last_target_select] = sel_shape;
  target_drift_moves[last_target_select] = sel_moves;
  drift_play_mem[last_target_select]     = sel_dplay;
  drift_rest_mem[last_target_select]     = sel_drest;

  slider32 = target_drift_up[sel_target];
  slider33 = target_drift_down[sel_target];
  slider34 = target_drift_per[sel_target];
  slider37 = target_drift_shape[sel_target];
  slider36 = target_drift_moves[sel_target];
  slider_automate(slider36);
  slider38 = drift_play_mem[sel_target];
  slider39 = drift_rest_mem[sel_target];
  slider_automate(slider32);
  slider_automate(slider33);
  slider_automate(slider34);
  slider_automate(slider37);
  slider_automate(slider38);
  slider_automate(slider39);

  last_target_select = sel_target;
) : (
  target_drift_up[sel_target]    = sel_up;
  target_drift_down[sel_target]  = sel_down;
  target_drift_per[sel_target]   = sel_per;
  target_drift_shape[sel_target] = sel_shape;
  target_drift_moves[sel_target] = sel_moves;
  drift_play_mem[sel_target]     = sel_dplay;
  drift_rest_mem[sel_target]     = sel_drest;
);

// Speed ramp target selector save/restore (nested-selector, mirrors the drift
// block above). slider23 = target; slider24 = per-target `by`; slider26 =
// per-target duration; slider30 = per-target start delay (all three per-target
// as of v2.14). slider29 (engage) stays GLOBAL. Switching slider23 saves the
// three per-target sliders into the OLD target's slots, then loads the NEW
// target's stored values. Otherwise captures live edits. Both targets ramp in
// parallel from @sample, each on its own duration/delay clock.
sr_sel_target = slider23;
sr_sel_by     = slider24;
sr_sel_dur    = slider26;
sr_sel_delay  = slider30;
sr_sel_play   = slider27;
sr_sel_rest   = slider28;

last_sr_target != sr_sel_target ? (
  speed_ramp_by_mem[last_sr_target]    = sr_sel_by;
  speed_ramp_dur_mem[last_sr_target]   = sr_sel_dur;
  speed_ramp_delay_mem[last_sr_target] = sr_sel_delay;
  sr_play_mem[last_sr_target]          = sr_sel_play;
  sr_rest_mem[last_sr_target]          = sr_sel_rest;
  slider24 = speed_ramp_by_mem[sr_sel_target];
  slider26 = speed_ramp_dur_mem[sr_sel_target];
  slider30 = speed_ramp_delay_mem[sr_sel_target];
  slider27 = sr_play_mem[sr_sel_target];
  slider28 = sr_rest_mem[sr_sel_target];
  slider_automate(slider24);
  slider_automate(slider26);
  slider_automate(slider30);
  slider_automate(slider27);
  slider_automate(slider28);
  last_sr_target = sr_sel_target;
) : (
  speed_ramp_by_mem[sr_sel_target]    = sr_sel_by;
  speed_ramp_dur_mem[sr_sel_target]   = sr_sel_dur;
  speed_ramp_delay_mem[sr_sel_target] = sr_sel_delay;
  sr_play_mem[sr_sel_target]          = sr_sel_play;
  sr_rest_mem[sr_sel_target]          = sr_sel_rest;
);

// THE CLICKS ARE NO LONGER RENDERED HERE (2026-09-11). Each is built as it fires,
// in @sample, from wherever drift and ramp have got to -- Rozaya: "Yes". A render
// here would write un-drifted values over the buffer a click is playing from.

// swing_offset[i] precompute removed in v2.9: swing now wanders per
// sample via target_drift_offset[1], so the offset for the current
// beat is computed inline in @sample on beat-wrap (see below).


@block
// ADOPT THE MIRROR HERE, NOT IN @slider -- a tracker adopted in @slider can
// capture a DEFAULT (the August 2026 Sweeping Filter fault).
!pitch_ui_inited ? (
  pui_last[0] = slider6; pui_last[1] = slider7; pui_last[2] = slider8;
  pui_last[3] = slider9; pui_last[4] = slider10;
  last_pitch_target = slider5;
  pitch_ui_inited = 1;
);
// --- Restore-order guard for the change-detecting controls below -----------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the picker then fires and slider_automate()s
//     its ratio over a rate that was set by hand. @block cannot run before the
//     instance is configured, so adopting here is right whatever order the
//     restore paths ran in. (Proved 2026-08-23: a Sweeping Filter in BPM mode
//     with Host ratio "every 2 beats" had Rate Value stamped to 0.5 on every
//     load and every track duplicate.)
!host_ratio_inited ? ( host_ratio_sel = slider40; host_ratio_inited = 1; );
!rate_mode_inited ? ( last_rate_mode = slider2; rate_mode_inited = 1; );
// Follow the project tempo live while Host x is active.
//
// @slider does not re-run when the tempo changes, so these three lines are
// repeated here. They are the only things derived from track_bpm outside the
// per-sample path -- the beat clock itself recomputes effective_tempo every
// sample, so it follows automatically once track_bpm is right.
//
// Nothing is remembered across transport: track_bpm is recomputed from the
// live tempo each block rather than compared against a stored reference. That
// matters because @init re-runs on every transport play and wipes globals -- a
// remembered reference would reset on play and silently discard the change.
rate_mode >= 3 ? (
  rate_units = slider1;
  track_bpm = rate_mode == 4 ? max(tempo, 0.001) * max(rate_units, 0.001)
            : rate_units > 0.001 ? max(tempo, 0.001) / rate_units : 0.001;
  samples_per_beat = (60.0 / max(track_bpm, 0.001)) * srate;
  start_delay_sec = slider20 * 60 / max(track_bpm, 0.001);
);

// --- Place the beat grid from the project (Host x only) -------------------
//
// PLACE ONCE, then run. The LFO plugins recompute their phase every sample,
// which is fine for a smooth shape but wrong here: this clock FIRES EVENTS,
// and re-deciding its position constantly could skip a tick or fire two. So
// the grid is placed when you press play or move the playhead, and left alone
// after that -- a jump can then only happen where you asked for one.
//
// A seek is detected by comparing where this block actually starts against
// where the last block predicted it would. Normal playback matches to well
// under the 0.25-beat threshold; a seek or loop doesn't.
//
// beat_index is "the beat about to fire" (the wrap below fires it, THEN
// increments), so landing part-way through beat N means the next tick is
// N+1. Landing exactly on a beat means that beat is due now: phase 1.0 fires
// it on this very sample, which is the same trick @init uses to avoid a beat
// of silence at the start.
//
// Placed on the straight grid; swing then resumes from the next tick. Start
// Delay and the Play/Rest gate still count from when you pressed play rather
// than from the project position -- they're "after you start" controls, not
// part of the bar grid.
transport_moving = (play_state == 1 || play_state == 5);
rate_mode >= 3 && transport_moving ? (
  (!was_moving || abs(beat_position - predicted_beat_pos) > 0.25) ? (
    // BEATS PER CYCLE, so the tick number at a given project position is the
    // beat position DIVIDED by it. This inverted with the rate conversion
    // above; multiplying here while dividing there would place the grid at a
    // different speed than the metronome runs at, and the ticks would walk.
    // Every N beats divides the beat position; N per beat multiplies it.
    tb = rate_mode == 4 ? max(beat_position, 0) * max(rate_units, 0.001)
       : rate_units > 0.001 ? max(beat_position, 0) / rate_units : 0;
    tb_floor = floor(tb);
    tb_frac  = tb - tb_floor;
    // The bar length drift and ramp have now; the seek starts a bar with it.
    ts_beats = max(1, floor(slider3 + rt_q(1) + 0.5));
    timesig  = ts_beats;
    tb_frac < 0.0001 ? (
      beat_phase = 1.0;
      beat_index = tb_floor % ts_beats;
    ) : (
      beat_phase = tb_frac;
      beat_index = (tb_floor + 1) % ts_beats;
    );
  );
);
predicted_beat_pos = beat_position + samplesblock * max(tempo, 0.001) / (60 * srate);
was_moving = transport_moving;

@sample

// (No transport-edge reset here — Path A. REAPER re-runs @init on every
// transport play / render start, which resets all runtime state — beat
// clock (beat_phase = 1.0 trick), tick state, drift runtime, Speed Ramp,
// Start Delay, Play/Rest; the drift CONFIG bank is preserved across those
// re-runs by the drift_cfg_inited guard in @init. See
// docs/v2.9-render-state-bug.md.)

// Advance each target's own ramp clock (v2.14 per-target timeline). Engage
// (slider29, GLOBAL) is the freeze/resume gate: while On, each target whose
// duration > 0 advances its own ramp_t 0->1 over its own duration, after its
// own start delay; while Off, all clocks freeze and resume from where they
// are. Only transport play (via @init) resets them.
slider29 ? (
  // Ramp time unit (slider25). One factor turns the block's time values into
  // seconds, so Duration and Start delay always mean the same as each other.
  // Cycles counts this plugin's own beats at the PRE-ramp tempo, so a ramp
  // cannot alter its own clock. Beats is 60/project tempo, recomputed per sample
  // so it follows a live tempo change rather than remembering one.
  ramp_time_scale =
    slider25 == 3 ? 60 / max(tempo, 0.001) :
    slider25 == 2 ? 60 :
    slider25 == 1 ? 1 :
                    60 / max(track_bpm, 0.001);
  i = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * ramp_time_scale * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        // Staircase (sliders 22/23): advance for `play`, hold for `rest`, repeat.
        // The holds come OUT of the duration rather than extending it -- the
        // advancing step is scaled by (play+rest)/play -- so Ramp duration goes
        // on meaning "you arrive in about this long".
        sr_pl = sr_play_mem[i];
        sr_rs = sr_rest_mem[i];
        sr_pr_on = sr_pl > 0 && sr_rs > 0;
        sr_hold = pr_frozen(sr_pr_accum_mem, sr_pr_resting_mem, i,
                            1.0 / (ramp_time_scale * srate), sr_pl, sr_rs);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !sr_hold ? (
          sr_step = 1.0 / (srate * speed_ramp_dur_mem[i] * ramp_time_scale);
          sr_pr_on ? sr_step *= (sr_pl + sr_rs) / sr_pl;
          speed_ramp_ramp_t_mem[i] += sr_step;
          speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
        );
      );
    );
    i += 1;
  );
);

// Per-target Speed Ramp offsets (per-target ramp progress × signed `by`). Both
// targets ramp in parallel; index 0 = Tempo BPM, 1 = Swing amount. Applied
// additively at each consumption site below, alongside drift. The drift wave's
// period tracks the Tempo ramp via a Speed-Ramp-adjusted samples_per_beat
// (track_bpm + Tempo ramp, no drift) so it doesn't self-modulate.
speed_ramp_offset_tempo = speed_ramp_ramp_t_mem[0] * speed_ramp_by_mem[0];
speed_ramp_offset_swing = speed_ramp_ramp_t_mem[2] * speed_ramp_by_mem[2];
// Drift and Speed Ramp offsets are in the plugin's OWN unit in every mode --
// BPM here, never a multiplier, even in Host x. Tried it the other way and it
// fails on the slider grid: these amount sliders step in 0.1, chosen for BPM,
// and in multiplier terms 0.1 is a 10% wander with nothing finer reachable.
// The value you want stops being settable, which is worse than the
// inconsistency it fixed. Consequence, deliberate and documented: a ramp does
// NOT stretch when the project tempo changes -- -60 stays -60 BPM.
sr_adjusted_tempo = max(0.01, track_bpm + speed_ramp_offset_tempo);
sr_adjusted_samples_per_beat = (60.0 / sr_adjusted_tempo) * srate;

// Per-target drift wave computation. 2 targets (0=Tempo BPM,
// 1=Swing amount). Each gets a phase counter advancing per sample
// at rate 1 / (period_beats * sr_adjusted_samples_per_beat) — both
// targets share the speed-ramp-adjusted beat as their period reference
// so drift on either target doesn't self-modulate the rate.
i = 0;
loop(N_TARGETS,
  up    = target_drift_up[i];
  down  = target_drift_down[i];
  per   = target_drift_per[i];
  shape = target_drift_shape[i];

  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    // Drift period unit (slider35). Cycles is this plugin's own beat, taken at
    // the Speed-Ramp-adjusted tempo so drift does not self-modulate its period --
    // which is what this control always did. Seconds is wall clock. Beats counts
    // the PROJECT tempo, a different clock whenever the metronome disagrees
    // with the host.
    period_samples =
      slider35 == 2 ? max(per * 60 / max(tempo, 0.001) * srate, 1) :
      slider35 == 1 ? max(per * srate, 1) :
                      max(per * max(sr_adjusted_samples_per_beat, 1), 1);

    // Drift play/rest (sliders 32/33), per target, counted in PERIODS. While
    // resting the phase does not advance at all, so the offset FREEZES where it
    // stopped rather than returning to centre.
    // Drift movement (slider36), Heartbeat's rule. A target on `With the target`,
    // in Cycles, takes a whole 1/period on the sample after its turn: every beat,
    // or every bar for Beats per bar. In Seconds or Beats its clock runs in that
    // unit while the beat grid runs, which is always once the start delay is over.
    // On a clock is the per-sample slice this loop always used.
    drift_is_stepped(i) ? (
      slider35 == 0 ? (
        d_tick = drift_step_mem[i] ? 1.0 / max(per, 0.001) : 0;
      ) : (
        d_tick = start_delay_elapsed >= start_delay_sec ? 1.0 / period_samples : 0;
      );
      drift_step_mem[i] = 0;
    ) : (
      d_tick = 1.0 / period_samples;
    );
    d_frozen = pr_frozen(drift_pr_accum_mem, drift_pr_resting_mem, i,
                         d_tick,
                         drift_play_mem[i], drift_rest_mem[i]);
    // One-armed pairs: an empty else-branch is a silent compile failure in eel2.
    d_frozen ? ( new_phase = target_drift_phase[i]; );
    !d_frozen ? (
      new_phase = target_drift_phase[i] + d_tick;
      new_phase >= 1.0 ? (
        new_phase -= 1.0;
        shape == 2 ? (
          target_drift_prev[i] = target_drift_curr[i];
          target_drift_curr[i] = rand(2) - 1;
        );
      );
    );
    target_drift_phase[i] = new_phase;

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = target_drift_prev[i] +
        (target_drift_curr[i] - target_drift_prev[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  target_drift_offset[i] = drift_offset_local;
  i += 1;
);

// Effective tempo with drift + Speed Ramp, clamped at 10 BPM (matches
// slider1's minimum) so over-aggressive Down amounts can't silence
// or invert the metronome.
effective_tempo = max(0.01, track_bpm + target_drift_offset[0] + speed_ramp_offset_tempo);
effective_samples_per_beat = (60.0 / effective_tempo) * srate;

// Effective swing: baseline + Swing drift + Swing Speed Ramp, clamped to
// [-1, +1] so neither can drive swing outside the meaningful range.
current_swing = max(-1.0, min(1.0, swing + target_drift_offset[2] + speed_ramp_offset_swing));
// Play for and Rest for (14, 15), in beats. Exactly the sliders while drift and
// ramp leave them alone; the gate still switches on only when both SLIDERS are
// above zero.
play_for_beats = max(0, slider21 + rt_q(14));
rest_for_beats = max(0, slider22 + rt_q(15));

// Start Delay gate. During the silent window beat_phase and tick_pos
// don't advance, so when the delay elapses the metronome begins from
// the downbeat as expected.
start_delay_elapsed < start_delay_sec ? (
  start_delay_elapsed += 1 / srate;
  spl0 = 0;
  spl1 = 0;
) : (

beat_phase += 1 / effective_samples_per_beat;

beat_phase >= 1.0 ? (
  beat_phase -= 1.0;

  // BEATS PER BAR IS LATCHED ON THE DOWNBEAT (2026-09-11), rounded to whole beats,
  // so a bar always finishes the way it started and the accent never jumps.
  // Rozaya: "that makes sense re: the bar". A hand edit waits for it too.
  beat_index == 0 ? timesig = max(1, floor(slider3 + rt_q(1) + 0.5));
  // Every target's turn for `With the target` but the bar's, which comes on the
  // downbeat below. Raised on the beat grid, heard or silent, as Heartbeat's is.
  rt_k = 0;
  loop(N_TARGETS, rt_k != 1 ? drift_step_mem[rt_k] = 1; rt_k += 1;);

  // Per-beat Play/Rest gate. Check first whether we've reached the
  // threshold for the current period — if so, flip play↔rest and
  // reset the counter. Then increment the counter for the beat we're
  // about to (maybe) fire. Tick fires only if !pr_resting (or gate
  // is off entirely). The previously-fired tick keeps playing through
  // its decay tail regardless — gate doesn't touch the audio buffer.
  pr_enabled ? (
    pr_beat >= (pr_resting ? rest_for_beats : play_for_beats) ? (
      pr_resting = 1 - pr_resting;
      pr_beat = 0;
    );
    pr_beat += 1;
  );

  (!pr_enabled || !pr_resting) ? (
    is_accent = (beat_index == 0) ? 1 : 0;
    // THE CLICK IS BUILT AS IT FIRES (2026-09-11), from wherever drift and ramp
    // have got to, and whole: it cannot change halfway, the next one can. It
    // re-renders only when a value differs from its last render, so a copy with no
    // drift renders exactly what @slider used to, and costs nothing per beat.
    tuning_ref = max(20, min(2000, slider11 + rt_q(7)));
    tone_q     = max(0.5, min(8, slider12 + rt_q(8)));
    is_accent ? (
      rt_hz = pitch_to_hz(1, rt_q(3), rt_q(5));
      rt_g  = max(0, min(1, slider13 + rt_q(9)));
      rt_d  = max(0.001, slider15 + rt_q(11));
      (rt_hz != rs_hz || rt_g != rs_g || rt_d != rs_d || tone_q != rs_q) ? (
        strong_len = render_tick(strong_buf, rt_hz, rt_g, rt_d, tone_q);
        rs_hz = rt_hz; rs_g = rt_g; rs_d = rt_d; rs_q = tone_q;
      );
    ) : (
      rt_hz = pitch_to_hz(2, rt_q(4), rt_q(6));
      rt_g  = max(0, min(1, slider14 + rt_q(10)));
      rt_d  = max(0.001, slider16 + rt_q(12));
      (rt_hz != rw_hz || rt_g != rw_g || rt_d != rw_d || tone_q != rw_q) ? (
        weak_len = render_tick(weak_buf, rt_hz, rt_g, rt_d, tone_q);
        rw_hz = rt_hz; rw_g = rt_g; rw_d = rt_d; rw_q = tone_q;
      );
    );
    pan_spread = max(0, min(1, slider17 + rt_q(13)));
    tick_src  = is_accent ? strong_buf : weak_buf;
    tick_len  = is_accent ? strong_len : weak_len;
    tick_pan  = beat_pan(beat_index);
    tick_pos  = 0;
    tick_playing = 1;
  );

  // beat_index and swing always advance — preserves the bar grid
  // through rest periods so the accent stays locked to "every
  // timesig beats" regardless of where rest falls.
  //
  // Swing offset is computed inline from current_swing (slider4 +
  // Swing drift, clamped). Pattern is "delay every 2nd beat by
  // swing * 1/3 of a beat" — alternates at beat_index parity.
  beat_index  = (beat_index + 1) % timesig;
  beat_index == 0 ? drift_step_mem[1] = 1;   // a new bar: the bar length's turn
  beat_phase -= current_swing * (1.0 / 3.0) * ((beat_index + 1) % 2);
);

out = 0;
tick_playing ? (
  out = tick_src[tick_pos];
  tick_pos += 1;
  tick_pos >= tick_len ? tick_playing = 0;
);

pan_pos = (tick_pan + 1.0) * 0.5;
spl0 = out * cos(pan_pos * $pi * 0.5);
spl1 = out * sin(pan_pos * $pi * 0.5);

);  // close start-delay else branch

@serialize
// Persist per-target drift AND speed-ramp configurations. Without this,
// only the most-recently-edited target's values survive a save/load
// because the sliders hold whichever target was selected at save time.
//
// VERSION-GUARDED (CLAUDE.md @serialize gotcha): leads with a magic marker so
// format changes degrade to defaults instead of scrambling. Magic bumped to
// 2100000 + N_TARGETS in v2.14 when Speed Ramp went PER-TARGET timeline (added
// the duration + start-delay banks); an older 2000000-base blob won't match
// and falls through to @init defaults (drift + ramp reset — acceptable, this
// is pre-release). Marker is well above any plausible first-field value and
// float32-exact (< 2^24).
// 2026-09-06: four per-target banks added (Drift play/rest, Ramp play/rest), so
// the magic goes 2100000 -> 2200000 and the READ accepts BOTH. A magic bump is
// used rather than a bare append because appending would let an older blob's
// trailing bytes land in the new banks -- "migrate what was RESTORED, never what
// was DEFAULTED". Gated on "this blob HAS the field", so an older blob keeps its
// Drift and Ramp config and simply leaves the new banks at @init's zeros (off).
// 2500016 since 2026-09-11: sixteen targets in control order, Drift movement
// appended LAST. A two-target save (2400002 back to 2100002) is read at its own
// width, each field only where that format held it, then remapped through rt_o2n
// with both remembered selectors. Only what the blob HELD is remapped.
function rt_remap(bank, dflt) local(k) (
  k = 0; loop(2, rt_scratch[k] = bank[k]; k += 1;);
  k = 0; loop(N_TARGETS, bank[k] = dflt; k += 1;);
  k = 0; loop(2, bank[rt_o2n(k)] = rt_scratch[k]; k += 1;);
);
sr_magic = 2500000 + N_TARGETS;
file_var(0, sr_magic);
rt_is_new = sr_magic == 2500000 + N_TARGETS;
rt_is_old = sr_magic == 2400002 || sr_magic == 2300002 || sr_magic == 2200002 || sr_magic == 2100002;
rt_n = rt_is_new ? N_TARGETS : 2;
(rt_is_new || rt_is_old) ? (
  file_mem(0, target_drift_up,     rt_n);
  file_mem(0, target_drift_down,   rt_n);
  file_mem(0, target_drift_per,    rt_n);
  file_mem(0, target_drift_shape,  rt_n);
  file_var(0, last_target_select);
  file_mem(0, speed_ramp_by_mem,    rt_n);
  file_mem(0, speed_ramp_dur_mem,   rt_n);
  file_mem(0, speed_ramp_delay_mem, rt_n);
  file_var(0, last_sr_target);
  // 2300002 saves never wrote these, so they are read from 2200002 and from
  // 2400000 on.
  (sr_magic == 2200002 || sr_magic >= 2400000) ? (
    file_mem(0, drift_play_mem, rt_n);
    file_mem(0, drift_rest_mem, rt_n);
    file_mem(0, sr_play_mem,    rt_n);
    file_mem(0, sr_rest_mem,    rt_n);
  );

  // The pitch banks, LAST in the stream so this was a pure append.
  sr_magic >= 2300000 ? (
    file_mem(0, pitch_note_mem, N_PITCH);
    file_mem(0, pitch_val_mem,  N_PITCH);
    file_mem(0, pitch_mode_mem, N_PITCH);
    file_mem(0, pitch_fine_mem, N_PITCH);
    file_mem(0, pitch_fmod_mem, N_PITCH);
    file_var(0, last_pitch_target);
  );

  // Drift movement, per target -- LAST in the stream. An older blob has none and
  // keeps @init's On a clock, which is what its two targets always did.
  rt_is_new ? ( file_mem(0, target_drift_moves, N_TARGETS); );

  rt_is_old ? (
    rt_remap(target_drift_up, 0);   rt_remap(target_drift_down, 0);
    rt_remap(target_drift_per, 8);  rt_remap(target_drift_shape, 0);
    rt_remap(speed_ramp_by_mem, 0); rt_remap(speed_ramp_dur_mem, 0);
    rt_remap(speed_ramp_delay_mem, 0);
    (sr_magic == 2200002 || sr_magic >= 2400000) ? (
      rt_remap(drift_play_mem, 0);  rt_remap(drift_rest_mem, 0);
      rt_remap(sr_play_mem, 0);     rt_remap(sr_rest_mem, 0);
    );
    last_target_select = rt_o2n(max(0, min(1, last_target_select | 0)));
    last_sr_target     = rt_o2n(max(0, min(1, last_sr_target | 0)));
  );

  // TRACK-DUPLICATE FIX (v2.14). On READ (load/duplicate) file_avail(0) >= 0;
  // on WRITE (save/undo) it is < 0. @serialize is the only section guaranteed
  // to run on both load AND duplicate, so it re-establishes the bank<->slider
  // invariant here: force the visible config sliders to match the restored
  // bank for the restored selectors, correcting any transient @slider clobber
  // (which would otherwise zero whichever target was selected on the copy).
  file_avail(0) >= 0 ? (
    slider24 = speed_ramp_by_mem[last_sr_target];        // Speed ramp `by`
    slider26 = speed_ramp_dur_mem[last_sr_target];       // Speed ramp duration
    slider30 = speed_ramp_delay_mem[last_sr_target];     // Speed ramp start delay
    slider32 = target_drift_up[last_target_select];      // Drift up
    slider33 = target_drift_down[last_target_select];    // Drift down
    slider34 = target_drift_per[last_target_select];     // Drift period
    slider37 = target_drift_shape[last_target_select];   // Drift shape
    // The four new per-target sliders need this exactly as much as the ones
    // above -- they are backed by live sliders, so they are the ones a transient
    // @slider can clobber to zero on a track duplicate.
    slider27 = sr_play_mem[last_sr_target];              // Ramp play for
    slider28 = sr_rest_mem[last_sr_target];              // Ramp rest for
    slider38 = drift_play_mem[last_target_select];       // Drift play for
    slider39 = drift_rest_mem[last_target_select];       // Drift rest for
    slider36 = target_drift_moves[last_target_select];   // Drift movement
    // The selectors themselves, so a remapped old save shows the target it had.
    slider31 = last_target_select;
    slider23 = last_sr_target;
    sliderchange(-1);
  );
);
