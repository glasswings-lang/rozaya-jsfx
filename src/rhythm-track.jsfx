desc: Rhythm Track
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/

slider1:120<0.001,1000,0.001>Tempo (BPM, or beats per cycle in Host x)
slider2:4<1,20,1>Beats per bar
slider3:0<-1,1,0.01>Swing amount
slider4:880<20,2000,1>Strong beat frequency (Hz)
slider5:440<20,2000,1>Weak beat frequency (Hz)
slider6:1.5<0.5,8,0.1>Tone resonance (Q)
slider7:0.75<0,1,0.01>Strong beat volume
slider8:0.5<0,1,0.01>Weak beat volume
slider9:0.04<0.001,1,0.001>Strong beat decay (seconds)
slider10:0.02<0.001,1,0.001>Weak beat decay (seconds)
slider11:1<0,1,0.01>Pan spread (0=mono, 1=full L/R)
slider12:0<0,5,1{Mono,Accent L / Weak R,Alternating,Distributed,Converging,Diverging}>Pan mode
slider13:0<0,1,1{Normal,Flipped}>Pan direction

// Sit silent for N beats after playback starts, then resume normally.
// Counted at the current Tempo. 0 disables the delay. Re-arms on every
// transport stop/start.
slider14:0<0,1000,0.001>Start delay (beats)

// Per-beat Play/Rest gate. Plays N ticks normally, then suppresses
// the next M tick triggers (silent), then resumes — repeats forever.
// Useful as a practice tool ("4 ticks, 4 silent, 4 ticks, 4 silent").
// The previous tick's decay tail continues through the start of the
// rest period — gate is "don't trigger new ticks," not a hard cut.
// The bar grid (beat_index, accent placement) keeps marching during
// rest, so the accent stays locked to Beats per bar regardless of
// where the rest periods fall. If you want the accent to always land
// on beat 1 of every play period, set Play for to a multiple of
// Beats per bar. 0 in either slider disables the gate. Resets on
// every transport stop/start.
slider15:0<0,1000,1>Play for (beats)
slider16:0<0,1000,1>Rest for (beats)

// Speed ramp: signed-delta, nested-selector (brought to Drift parity in
// the automation-replacement sweep, see docs/planned-features.md). Ships
// in v2.14. Pick a target (slider17), then slider18 is the `by` amount for
// THAT target; both targets ramp in parallel and the selector only chooses
// which one slider18 is editing. Engage (slider20) is a freeze/resume gate
// (NOT a restart edge); only transport play resets ramp_t.
//
// The Speed ramp target selector is slider17 (top of this block) so that in
// the UI / NVDA parameter order it reads ABOVE the by/duration/engage
// controls it governs. Achieving that meant renumbering the Speed Ramp +
// Drift blocks (REAPER orders sliders by ID, not file position), so the old
// single-target IDs 17-20 shifted — existing Rhythm Track projects reset
// their Speed Ramp + Drift configs on upgrade (both are off-by-default; the
// metronome sound on sliders 1-16 is untouched). Re-add the instance for
// clean defaults, or reconfigure. See the manual's migration note.
slider17:0<0,1,1{Tempo,Swing amount}>Ramp target
slider18:0<-300,300,0.001>Ramp by (units match target)
slider19:0<0,60,0.1>Ramp duration (minutes)
slider20:0<0,1,1{Off,On}>Ramp engage
slider21:0<0,60,0.1>Ramp start delay (minutes)

// Per-target drift: nested-selector pattern matching Womb v3 /
// breath gen / heartbeat. Pick a target (slider22), then sliders 23-26
// hold THAT target's drift config. Switching the selector saves current
// values to the old target's memory slot and loads the new target's values
// into the sliders. Both targets drift in parallel; the selector just
// chooses which one you're currently editing. Period unit is beats for both
// targets. For slow wall-clock feel, set a long period (~960 beats ≈ 8 min
// at 120 BPM). (Drift IDs shifted +1 from the old 21-25 layout in the v2.14
// reorg above — same reset story.)
slider22:0<0,1,1{Tempo,Swing amount}>Drift target
slider23:0<0,50,0.01>Drift up amount (units match target)
slider24:0<0,50,0.01>Drift down amount (units match target)
slider25:8<1,1000,1>Drift period (beats)
slider26:0<0,2,1{Sine,Triangle,Random}>Drift shape

// --- Host tempo sync (sliders 27-28) --------------------------------------
//
// Own BPM  — slider1 is the tempo, as it always was. Free-running; the
//            project tempo is ignored entirely.
// Host x   — slider1 becomes BEATS PER CYCLE against the project tempo. 1 is a
//            tick on every beat, 2 is every other beat, 0.5 is two ticks a
//            beat. A metronome that could not follow the project tempo was the
//            odd one out here.
//
//            A CYCLE HERE IS ONE TICK. The label uses the suite's own phrase
//            rather than a word picked just for this plugin: consistency across
//            the plugins outranks a slightly nicer word in any single file.
//
//            It used to be a MULTIPLIER of the tempo. R13-revised, 2026-09-02:
//            a multiplier is a number you cannot hear without doing arithmetic
//            against the project tempo first.
//
// Two entries rather than four: this plugin only ever had one unit, so
// "Seconds" and "Hz" would be nonsense on it. Appended at the END of the
// slider range per the never-renumber rule, even though it reads better
// next to Tempo -- moving it would scramble every saved project.
slider27:0<0,1,1{Own BPM,Host x}>Rate Mode

// RETIRED 2026-09-04 by R13-revised, and hidden. It existed only to spare you
// arithmetic on a multiplier; "every 4 beats" is now typing 4 into Tempo. NOT
// deleted -- slider ids are primary keys and removing one shifts every control
// above it in every saved project.
slider28:0<0,15,1{Custom,every 8 beats,every 4 beats,every 3 beats,every 2 beats,phi slow,2 per 3 beats,3 per 4 beats,1 per beat,4 per 3 beats,3 per 2 beats,phi fast,2 per beat,3 per beat,4 per beat,8 per beat}>Host ratio (retired)

@init
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: REAPER re-runs @init on every transport play / render
// start, resetting all runtime for free (beat clock, tick state, drift
// runtime, Speed Ramp, Start Delay, Play/Rest). Only the drift CONFIG
// bank must survive the re-run; it's guarded by drift_cfg_inited below.

tick_buf_len = 65536;

strong_buf    = 0;
weak_buf      = strong_buf + tick_buf_len;
noise_scratch = weak_buf   + tick_buf_len;
// swing_offset needs its own memory region. Eel2 defaults any
// undeclared variable to 0; without an explicit base address here,
// swing_offset[i] would alias strong_buf[i] and the per-beat swing
// writes in @slider would corrupt the first `timesig` samples of
// the rendered strong-beat audio (~tiny click at the very start of
// the strong beat). 32 slots is generous — slider max is 20.
noise_len    = 300;
swing_offset = noise_scratch + noise_len;

strong_len = 0;
weak_len   = 0;

tick_playing = 0;
tick_pos     = 0;
tick_src     = 0;
tick_len     = 0;
tick_pan     = 0;

// Start beat_phase at 1.0 so the very first @sample call triggers
// the downbeat. With beat_phase=0 the first beat doesn't fire until
// samples_per_beat samples have elapsed — a full beat of silence
// before the metronome actually starts ticking. (Bug pre-dated the
// initial public release; reported by ear.)
beat_phase       = 1.0;
// Seek detection for the Host x beat-grid placement in @block. was_moving = 0
// means the first block after a transport start always places the grid.
was_moving         = 0;
predicted_beat_pos = 0;
host_ratio_inited = 0;   // picker adopts on load rather than firing
beat_index       = 0;

// Seed track_bpm from slider1 in @init so the first @sample call has
// a valid BPM available. @init re-runs on every transport play (Path A,
// no ext_noinit), so this re-seeds each play; it ensures effective_tempo
// computations have a defined baseline even if @sample touches them
// before @slider's first run.
// (NOTE: see @slider for the `tempo` vs `track_bpm` naming gotcha.)
track_bpm        = slider1;
samples_per_beat = (60.0 / max(slider1, 0.001)) * srate;

// rate_units is slider1 in ITS OWN unit — plain BPM in Own BPM mode, beats
// per cycle in Host x — and track_bpm is the real ticks-per-minute it works
// out to. Drift and Ramp offsets are added to TRACK_BPM, in the @sample line
// that computes effective_tempo, so they are deltas in real BPM in both modes
// — which is the suite rule (CLAUDE.md: drift and ramp amounts are in BPM in
// every mode, Host x included; the plugin converts, never the user).
//
// An earlier version of this comment said the offsets were added to rate_units
// before the multiply. They never were; the code has always added them after.
// Corrected 2026-09-04 while converting Host x.
rate_units       = slider1;

// Start Delay state. start_delay_elapsed counts up from 0 at each
// play start; while it's below start_delay_sec the @sample work is
// gated and output is silent.
last_play_state     = 0;
start_delay_elapsed = 0;
start_delay_sec     = 0;

// Play/Rest gate state. pr_beat counts ticks elapsed in the current
// play (or rest) period; threshold compare flips the period. Init
// to 0 because rhythm-track has no init pre-fire — the first tick
// fires via the normal beat_phase >= 1.0 trigger path on sample 1.
pr_resting     = 0;
pr_beat        = 0;
play_for_beats = 0;
rest_for_beats = 0;
pr_enabled     = 0;

// Speed Ramp state. Engage (global) is a freeze/resume gate, not an edge;
// only transport play resets the per-target ramp clocks. As of v2.14 the
// ramp is PER-TARGET: each target has its own `by`, duration, start delay,
// and progress clock (banks defined below).

// --- v2.9 Drift target memory banks ---
//
// 2 targets × 8 fields = 16 slots. Arrays are 16-slot-spaced so
// targets can grow up to 16 later without re-laying-out. Placed right
// after swing_offset's reserved region (131404) at 131520 — no overlap
// with the tick render buffers below.
//
// Targets:
//   0 = Tempo BPM      (units: BPM)
//   1 = Swing amount   (units: 0-1 swing fraction, clamped at consumer)
N_TARGETS = 2;
target_drift_up     = 131520;
target_drift_down   = 131536;
target_drift_per    = 131552;
target_drift_shape  = 131568;
target_drift_phase  = 131584;
target_drift_prev   = 131600;
target_drift_curr   = 131616;
target_drift_offset = 131632;

// Speed ramp per-target banks (v2.14). Mirror the drift banks; 16-slot-spaced
// after target_drift_offset (131632). `by` / duration / start-delay are CONFIG
// (survive transport, restored by @serialize); ramp_t / delay_elapsed are
// RUNTIME (reset every @init / transport play).
speed_ramp_by_mem            = 131648;  // signed delta per target (CONFIG)
speed_ramp_dur_mem           = 131664;  // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 131680;  // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 131696;  // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 131712;  // delay sample counter per target (RUNTIME)

// CONFIG banks (drift up/down/period/shape + speed-ramp by/duration/start-delay
// + selector trackers) — guarded by drift_cfg_inited so the @init re-run on
// every transport play (Path A render fix, no ext_noinit) does NOT wipe the
// user's setup. @serialize restores saved configs on project reload.
drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_TARGETS,
    target_drift_up[i]    = 0;
    target_drift_down[i]  = 0;
    target_drift_per[i]   = 8;
    target_drift_shape[i] = 0;
    speed_ramp_by_mem[i]    = 0;
    speed_ramp_dur_mem[i]   = 0;
    speed_ramp_delay_mem[i] = 0;
    i += 1;
  );
  last_target_select = 0;
  last_sr_target     = 0;
  drift_cfg_inited = 1;
);

// Drift + speed-ramp RUNTIME resets on EVERY @init (every transport play).
i = 0;
loop(N_TARGETS,
  target_drift_phase[i]  = 0;
  target_drift_prev[i]   = 0;
  target_drift_curr[i]   = 0;
  target_drift_offset[i] = 0;
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  i += 1;
);

nx = 1;
i = 0;
loop(noise_len,
  nx = (479 * nx) % 997;
  noise_scratch[i] = (nx / 500.0) - 1.0;
  i += 1;
);


function render_tick(buf, hz, gain, decay_sec, tone_q)
local(i, len, env, raw, lp_out, peak_val, norm,
      lp_w0, lp_alpha, lp_cos, lp_b0, lp_b1, lp_b2, lp_a1, lp_a2,
      lp_x1, lp_x2, lp_y1, lp_y2,
      hp_w0, hp_alpha, hp_cos, hp_b0, hp_b1, hp_b2, hp_a1, hp_a2,
      hpx1, hpx2, hpy1, hpy2,
      hp2x1, hp2x2, hp2y1, hp2y2,
      hp3x1, hp3x2, hp3y1, hp3y2,
      hp4x1, hp4x2, hp4y1, hp4y2,
      hp_out) (

  // Dynamic length: 5 time constants captures tail to ~1% of peak
  len = min(ceil(decay_sec * srate * 5) + noise_len, tick_buf_len - 1);

  // Resonant lowpass at 2*hz, Q controlled by slider
  lp_w0    = 2.0 * $pi * min(srate * 0.45, 2.0 * hz) / srate;
  lp_alpha = sin(lp_w0) / (2.0 * tone_q);
  lp_cos   = cos(lp_w0);
  lp_b0    = (1 - lp_cos) / 2 / (1 + lp_alpha);
  lp_b1    = (1 - lp_cos)     / (1 + lp_alpha);
  lp_b2    = lp_b0;
  lp_a1    = -2 * lp_cos      / (1 + lp_alpha);
  lp_a2    = (1 - lp_alpha)   / (1 + lp_alpha);

  // 4-stage biquad highpass at hz (approximates 8-pole slope)
  hp_w0    = 2.0 * $pi * hz / srate;
  hp_alpha = sin(hp_w0) / (2.0 * 0.707);
  hp_cos   = cos(hp_w0);
  hp_b0    =  (1 + hp_cos) / 2 / (1 + hp_alpha);
  hp_b1    = -(1 + hp_cos)     / (1 + hp_alpha);
  hp_b2    =  hp_b0;
  hp_a1    = -2 * hp_cos       / (1 + hp_alpha);
  hp_a2    =  (1 - hp_alpha)   / (1 + hp_alpha);

  lp_x1 = 0; lp_x2 = 0; lp_y1 = 0; lp_y2 = 0;
  hpx1 = 0; hpx2 = 0; hpy1 = 0; hpy2 = 0;
  hp2x1 = 0; hp2x2 = 0; hp2y1 = 0; hp2y2 = 0;
  hp3x1 = 0; hp3x2 = 0; hp3y1 = 0; hp3y2 = 0;
  hp4x1 = 0; hp4x2 = 0; hp4y1 = 0; hp4y2 = 0;

  peak_val = 0.0001;
  i = 0;
  loop(len,
    // Envelope: short attack ramp, then exponential decay
    // Use noise_scratch for the first noise_len samples, silence after
    raw = (i < noise_len) ? noise_scratch[i] : 0;
    env = (i < 5) ? (i / 5.0) : exp(-i / (decay_sec * srate));
    raw = raw * env;

    // Resonant lowpass
    lp_out = lp_b0*raw + lp_b1*lp_x1 + lp_b2*lp_x2 - lp_a1*lp_y1 - lp_a2*lp_y2;
    lp_x2 = lp_x1; lp_x1 = raw;
    lp_y2 = lp_y1; lp_y1 = lp_out;

    // 4-stage highpass - each stage input is previous stage output
    hp_out = hp_b0*lp_out + hp_b1*hpx1 + hp_b2*hpx2 - hp_a1*hpy1 - hp_a2*hpy2;
    hpx2 = hpx1; hpx1 = lp_out; hpy2 = hpy1; hpy1 = hp_out;

    hp_out = hp_b0*hpy1 + hp_b1*hp2x1 + hp_b2*hp2x2 - hp_a1*hp2y1 - hp_a2*hp2y2;
    hp2x2 = hp2x1; hp2x1 = hpy1; hp2y2 = hp2y1; hp2y1 = hp_out;

    hp_out = hp_b0*hp2y1 + hp_b1*hp3x1 + hp_b2*hp3x2 - hp_a1*hp3y1 - hp_a2*hp3y2;
    hp3x2 = hp3x1; hp3x1 = hp2y1; hp3y2 = hp3y1; hp3y1 = hp_out;

    hp_out = hp_b0*hp3y1 + hp_b1*hp4x1 + hp_b2*hp4x2 - hp_a1*hp4y1 - hp_a2*hp4y2;
    hp4x2 = hp4x1; hp4x1 = hp3y1; hp4y2 = hp4y1; hp4y1 = hp_out;

    buf[i] = hp_out;
    abs(hp_out) > peak_val ? peak_val = abs(hp_out);
    i += 1;
  );

  norm = gain / peak_val;
  i = 0;
  loop(len,
    buf[i] = buf[i] * norm;
    i += 1;
  );

  len
);


function beat_pan(idx) local(n, non_accent, steps, step, pos, flip) (
  n          = max(timesig, 1);
  non_accent = n - 1;
  steps      = ceil(non_accent / 2.0); // number of distinct distances from anchor
  flip       = pan_flip ? -1.0 : 1.0;

  pan_mode == 0 ? (
    // Mono
    pos = 0;

  ) : pan_mode == 1 ? (
    // Accent L / Weak R
    pos = (idx == 0) ? -1 : 1;

  ) : pan_mode == 2 ? (
    // Alternating L/R/L/R
    pos = (idx % 2 == 0) ? -1 : 1;

  ) : pan_mode == 3 ? (
    // Distributed: evenly spaced left to right
    n > 1 ? (pos = (idx / (n - 1.0)) * 2.0 - 1.0) : (pos = 0);

  ) : pan_mode == 4 ? (
    // Converging: accent hard left, pairs walk inward toward center
    // beat 0 = -1, beat 1 = hard right, beat 2 = hard left - 1 step...
    idx == 0 ? (
      pos = -1.0;
    ) : (
      step = ceil((idx + 1) / 2); // 1,2,2,3,3,4... for idx 1,2,3,4,5,6
      pos = (idx % 2 == 1) ? (1.0 - (step - 1.0) / steps)
                            : -(1.0 - (step - 1.0) / steps);
      pos = max(-1.0, min(1.0, pos));
    );

  ) : (
    // Diverging: accent center, pairs walk outward symmetrically
    // beat 0 = 0, beat 1 = slight left, beat 2 = slight right...
    idx == 0 ? (
      pos = 0.0;
    ) : (
      step = floor((idx + 1) / 2); // 1,1,2,2,3,3...
      pos = (idx % 2 == 1) ? -(step / steps)
                            :  (step / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  );

  pos * pan_spread * flip
);


@slider

// NOTE: the variable name `tempo` is RESERVED in JSFX — it's a read-only
// system variable that returns REAPER's current project tempo. Assigning
// to `tempo` is silently ignored, which caused effective_tempo to be
// computed against the project tempo (always ~120 BPM by default) and
// completely ignore slider1. Renamed to `track_bpm` throughout to avoid
// the collision. See JSFX docs: https://www.reaper.fm/sdk/js/var.php
//
// Host x mode is the one place we deliberately READ `tempo` — reading is
// fine and always was; only assignment is ignored.

// --- Host ratio picker: RETIRED (R13-revised) -----------------------------
// The guard is forced to 0 rather than the block being deleted, so the
// reasoning stays beside the code it disabled. Tempo says beats per cycle in
// Host x now, so there is no multiplier for a picker to translate -- and a
// picker that WRITES a value is the exact shape that stamped 0.5 over a
// hand-set rate on every load in infantile.RPP.
0 ? (
  host_ratio_sel = slider28;
  host_ratio_sel > 0 ? (
    slider1 =
      host_ratio_sel ==  1 ? 0.125 :
      host_ratio_sel ==  2 ? 0.25  :
      host_ratio_sel ==  3 ? 1/3   :
      host_ratio_sel ==  4 ? 0.5   :
      host_ratio_sel ==  5 ? 0.618 :
      host_ratio_sel ==  6 ? 2/3   :
      host_ratio_sel ==  7 ? 0.75  :
      host_ratio_sel ==  8 ? 1     :
      host_ratio_sel ==  9 ? 4/3   :
      host_ratio_sel == 10 ? 1.5   :
      host_ratio_sel == 11 ? 1.618 :
      host_ratio_sel == 12 ? 2     :
      host_ratio_sel == 13 ? 3     :
      host_ratio_sel == 14 ? 4     :
                             8;
    slider_automate(slider1);
  );
);
rate_mode = slider27;
slider_show(slider28, 0);
// The LANDING BLOCK is gone (R13-revised step 4). It used to stamp the picker
// to "1 per beat" and Tempo to 1 on entering Host x, because meeting a bare
// MULTIPLIER first was the trap -- 120 as a multiplier is a hundred and twenty
// times the project tempo. There is no trap now: 120 beats per cycle is a
// legible number (a tick every 120 beats, very slow), so nothing needs stamping
// and, crucially, the TEMPO SLIDER NEVER HIDES. Hiding it is what forced the
// stamp in the first place.
rate_mode_inited ? last_rate_mode = rate_mode;


// In Host x, slider1 is BEATS PER CYCLE. The project runs at `tempo` beats per
// minute, so a tick every N beats is tempo/N ticks per minute -- which is what
// track_bpm has always been. Everything downstream (samples_per_beat, the drift
// period, Start Delay, the beat clock itself) derives from track_bpm and so
// follows for free. @block re-does this so a tempo change lands live.
//
// Guarded on the NUMERATOR side: inverting a unit inverts its edge cases, and
// `1/max(raw,0.001)` clamps the DENOMINATOR, turning a stopped metronome into a
// thousand-times-tempo one. The slider's declared minimum is 0.001 so it cannot
// reach zero, but the safe form costs nothing.
rate_units   = slider1;
track_bpm    = rate_mode == 1 ?
                 (rate_units > 0.001 ? max(tempo, 0.001) / rate_units : 0.001) :
                 rate_units;
timesig      = slider2;
swing        = slider3;
strong_hz    = slider4;
weak_hz      = slider5;
tone_q       = slider6;
strong_gain  = slider7;
weak_gain    = slider8;
strong_decay = slider9;
weak_decay   = slider10;
pan_spread   = slider11;
pan_mode     = slider12;
pan_flip     = slider13;

samples_per_beat = (60.0 / track_bpm) * srate;

// Start Delay — beats at the current Tempo.
start_delay_sec = slider14 * 60 / max(track_bpm, 0.001);

// Play/Rest gate: integer beat counts. Both must be > 0 for the
// gate to engage; 0 in either slider disables.
play_for_beats = slider15;
rest_for_beats = slider16;
pr_enabled     = (play_for_beats > 0 && rest_for_beats > 0);

// Speed ramp engage-edge.
// No engage-edge logic. Engage is a freeze/resume gate handled in
// @sample. Only transport play resets ramp_t.

// Drift target selector save/restore (nested-selector pattern).
// Switching slider22 saves sliders 23-26 into the OLD target's slot,
// then loads the NEW target's stored config into sliders 23-26.
// Otherwise captures live edits to the current target's slot. Both
// targets drift in parallel from @sample regardless of selection.
sel_target = slider22;
sel_up     = slider23;
sel_down   = slider24;
sel_per    = slider25;
sel_shape  = slider26;

last_target_select != sel_target ? (
  target_drift_up[last_target_select]    = sel_up;
  target_drift_down[last_target_select]  = sel_down;
  target_drift_per[last_target_select]   = sel_per;
  target_drift_shape[last_target_select] = sel_shape;

  slider23 = target_drift_up[sel_target];
  slider24 = target_drift_down[sel_target];
  slider25 = target_drift_per[sel_target];
  slider26 = target_drift_shape[sel_target];
  slider_automate(slider23);
  slider_automate(slider24);
  slider_automate(slider25);
  slider_automate(slider26);

  last_target_select = sel_target;
) : (
  target_drift_up[sel_target]    = sel_up;
  target_drift_down[sel_target]  = sel_down;
  target_drift_per[sel_target]   = sel_per;
  target_drift_shape[sel_target] = sel_shape;
);

// Speed ramp target selector save/restore (nested-selector, mirrors the drift
// block above). slider17 = target; slider18 = per-target `by`; slider19 =
// per-target duration; slider21 = per-target start delay (all three per-target
// as of v2.14). slider20 (engage) stays GLOBAL. Switching slider17 saves the
// three per-target sliders into the OLD target's slots, then loads the NEW
// target's stored values. Otherwise captures live edits. Both targets ramp in
// parallel from @sample, each on its own duration/delay clock.
sr_sel_target = slider17;
sr_sel_by     = slider18;
sr_sel_dur    = slider19;
sr_sel_delay  = slider21;

last_sr_target != sr_sel_target ? (
  speed_ramp_by_mem[last_sr_target]    = sr_sel_by;
  speed_ramp_dur_mem[last_sr_target]   = sr_sel_dur;
  speed_ramp_delay_mem[last_sr_target] = sr_sel_delay;
  slider18 = speed_ramp_by_mem[sr_sel_target];
  slider19 = speed_ramp_dur_mem[sr_sel_target];
  slider21 = speed_ramp_delay_mem[sr_sel_target];
  slider_automate(slider18);
  slider_automate(slider19);
  slider_automate(slider21);
  last_sr_target = sr_sel_target;
) : (
  speed_ramp_by_mem[sr_sel_target]    = sr_sel_by;
  speed_ramp_dur_mem[sr_sel_target]   = sr_sel_dur;
  speed_ramp_delay_mem[sr_sel_target] = sr_sel_delay;
);

strong_len = render_tick(strong_buf, strong_hz, strong_gain, strong_decay, tone_q);
weak_len   = render_tick(weak_buf,   weak_hz,   weak_gain,   weak_decay,   tone_q);

// swing_offset[i] precompute removed in v2.9: swing now wanders per
// sample via target_drift_offset[1], so the offset for the current
// beat is computed inline in @sample on beat-wrap (see below).


@block
// --- Restore-order guard for the change-detecting controls below -----------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the picker then fires and slider_automate()s
//     its ratio over a rate that was set by hand. @block cannot run before the
//     instance is configured, so adopting here is right whatever order the
//     restore paths ran in. (Proved 2026-08-23: a Sweeping Filter in BPM mode
//     with Host ratio "every 2 beats" had Rate Value stamped to 0.5 on every
//     load and every track duplicate.)
!host_ratio_inited ? ( host_ratio_sel = slider28; host_ratio_inited = 1; );
!rate_mode_inited ? ( last_rate_mode = slider27; rate_mode_inited = 1; );
// Follow the project tempo live while Host x is active.
//
// @slider does not re-run when the tempo changes, so these three lines are
// repeated here. They are the only things derived from track_bpm outside the
// per-sample path -- the beat clock itself recomputes effective_tempo every
// sample, so it follows automatically once track_bpm is right.
//
// Nothing is remembered across transport: track_bpm is recomputed from the
// live tempo each block rather than compared against a stored reference. That
// matters because @init re-runs on every transport play and wipes globals -- a
// remembered reference would reset on play and silently discard the change.
rate_mode == 1 ? (
  rate_units = slider1;
  track_bpm = rate_units > 0.001 ? max(tempo, 0.001) / rate_units : 0.001;
  samples_per_beat = (60.0 / max(track_bpm, 0.001)) * srate;
  start_delay_sec = slider14 * 60 / max(track_bpm, 0.001);
);

// --- Place the beat grid from the project (Host x only) -------------------
//
// PLACE ONCE, then run. The LFO plugins recompute their phase every sample,
// which is fine for a smooth shape but wrong here: this clock FIRES EVENTS,
// and re-deciding its position constantly could skip a tick or fire two. So
// the grid is placed when you press play or move the playhead, and left alone
// after that -- a jump can then only happen where you asked for one.
//
// A seek is detected by comparing where this block actually starts against
// where the last block predicted it would. Normal playback matches to well
// under the 0.25-beat threshold; a seek or loop doesn't.
//
// beat_index is "the beat about to fire" (the wrap below fires it, THEN
// increments), so landing part-way through beat N means the next tick is
// N+1. Landing exactly on a beat means that beat is due now: phase 1.0 fires
// it on this very sample, which is the same trick @init uses to avoid a beat
// of silence at the start.
//
// Placed on the straight grid; swing then resumes from the next tick. Start
// Delay and the Play/Rest gate still count from when you pressed play rather
// than from the project position -- they're "after you start" controls, not
// part of the bar grid.
transport_moving = (play_state == 1 || play_state == 5);
rate_mode == 1 && transport_moving ? (
  (!was_moving || abs(beat_position - predicted_beat_pos) > 0.25) ? (
    // BEATS PER CYCLE, so the tick number at a given project position is the
    // beat position DIVIDED by it. This inverted with the rate conversion
    // above; multiplying here while dividing there would place the grid at a
    // different speed than the metronome runs at, and the ticks would walk.
    tb = rate_units > 0.001 ? max(beat_position, 0) / rate_units : 0;
    tb_floor = floor(tb);
    tb_frac  = tb - tb_floor;
    ts_beats = max(slider2, 1);
    tb_frac < 0.0001 ? (
      beat_phase = 1.0;
      beat_index = tb_floor % ts_beats;
    ) : (
      beat_phase = tb_frac;
      beat_index = (tb_floor + 1) % ts_beats;
    );
  );
);
predicted_beat_pos = beat_position + samplesblock * max(tempo, 0.001) / (60 * srate);
was_moving = transport_moving;

@sample

// (No transport-edge reset here — Path A. REAPER re-runs @init on every
// transport play / render start, which resets all runtime state — beat
// clock (beat_phase = 1.0 trick), tick state, drift runtime, Speed Ramp,
// Start Delay, Play/Rest; the drift CONFIG bank is preserved across those
// re-runs by the drift_cfg_inited guard in @init. See
// docs/v2.9-render-state-bug.md.)

// Advance each target's own ramp clock (v2.14 per-target timeline). Engage
// (slider20, GLOBAL) is the freeze/resume gate: while On, each target whose
// duration > 0 advances its own ramp_t 0->1 over its own duration, after its
// own start delay; while Off, all clocks freeze and resume from where they
// are. Only transport play (via @init) resets them.
slider20 ? (
  i = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * 60 * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        speed_ramp_ramp_t_mem[i] += 1.0 / (srate * speed_ramp_dur_mem[i] * 60);
        speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
      );
    );
    i += 1;
  );
);

// Per-target Speed Ramp offsets (per-target ramp progress × signed `by`). Both
// targets ramp in parallel; index 0 = Tempo BPM, 1 = Swing amount. Applied
// additively at each consumption site below, alongside drift. The drift wave's
// period tracks the Tempo ramp via a Speed-Ramp-adjusted samples_per_beat
// (track_bpm + Tempo ramp, no drift) so it doesn't self-modulate.
speed_ramp_offset_tempo = speed_ramp_ramp_t_mem[0] * speed_ramp_by_mem[0];
speed_ramp_offset_swing = speed_ramp_ramp_t_mem[1] * speed_ramp_by_mem[1];
// Drift and Speed Ramp offsets are in the plugin's OWN unit in every mode --
// BPM here, never a multiplier, even in Host x. Tried it the other way and it
// fails on the slider grid: these amount sliders step in 0.1, chosen for BPM,
// and in multiplier terms 0.1 is a 10% wander with nothing finer reachable.
// The value you want stops being settable, which is worse than the
// inconsistency it fixed. Consequence, deliberate and documented: a ramp does
// NOT stretch when the project tempo changes -- -60 stays -60 BPM.
sr_adjusted_tempo = max(0.01, track_bpm + speed_ramp_offset_tempo);
sr_adjusted_samples_per_beat = (60.0 / sr_adjusted_tempo) * srate;

// Per-target drift wave computation. 2 targets (0=Tempo BPM,
// 1=Swing amount). Each gets a phase counter advancing per sample
// at rate 1 / (period_beats * sr_adjusted_samples_per_beat) — both
// targets share the speed-ramp-adjusted beat as their period reference
// so drift on either target doesn't self-modulate the rate.
i = 0;
loop(N_TARGETS,
  up    = target_drift_up[i];
  down  = target_drift_down[i];
  per   = target_drift_per[i];
  shape = target_drift_shape[i];

  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    period_samples = max(per * max(sr_adjusted_samples_per_beat, 1), 1);
    new_phase = target_drift_phase[i] + 1.0 / period_samples;
    new_phase >= 1.0 ? (
      new_phase -= 1.0;
      shape == 2 ? (
        target_drift_prev[i] = target_drift_curr[i];
        target_drift_curr[i] = rand(2) - 1;
      );
    );
    target_drift_phase[i] = new_phase;

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = target_drift_prev[i] +
        (target_drift_curr[i] - target_drift_prev[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  target_drift_offset[i] = drift_offset_local;
  i += 1;
);

// Effective tempo with drift + Speed Ramp, clamped at 10 BPM (matches
// slider1's minimum) so over-aggressive Down amounts can't silence
// or invert the metronome.
effective_tempo = max(0.01, track_bpm + target_drift_offset[0] + speed_ramp_offset_tempo);
effective_samples_per_beat = (60.0 / effective_tempo) * srate;

// Effective swing: baseline + Swing drift + Swing Speed Ramp, clamped to
// [-1, +1] so neither can drive swing outside the meaningful range.
current_swing = max(-1.0, min(1.0, swing + target_drift_offset[1] + speed_ramp_offset_swing));

// Start Delay gate. During the silent window beat_phase and tick_pos
// don't advance, so when the delay elapses the metronome begins from
// the downbeat as expected.
start_delay_elapsed < start_delay_sec ? (
  start_delay_elapsed += 1 / srate;
  spl0 = 0;
  spl1 = 0;
) : (

beat_phase += 1 / effective_samples_per_beat;

beat_phase >= 1.0 ? (
  beat_phase -= 1.0;

  // Per-beat Play/Rest gate. Check first whether we've reached the
  // threshold for the current period — if so, flip play↔rest and
  // reset the counter. Then increment the counter for the beat we're
  // about to (maybe) fire. Tick fires only if !pr_resting (or gate
  // is off entirely). The previously-fired tick keeps playing through
  // its decay tail regardless — gate doesn't touch the audio buffer.
  pr_enabled ? (
    pr_beat >= (pr_resting ? rest_for_beats : play_for_beats) ? (
      pr_resting = 1 - pr_resting;
      pr_beat = 0;
    );
    pr_beat += 1;
  );

  (!pr_enabled || !pr_resting) ? (
    is_accent = (beat_index == 0) ? 1 : 0;
    tick_src  = is_accent ? strong_buf : weak_buf;
    tick_len  = is_accent ? strong_len : weak_len;
    tick_pan  = beat_pan(beat_index);
    tick_pos  = 0;
    tick_playing = 1;
  );

  // beat_index and swing always advance — preserves the bar grid
  // through rest periods so the accent stays locked to "every
  // timesig beats" regardless of where rest falls.
  //
  // Swing offset is computed inline from current_swing (slider3 +
  // Swing drift, clamped). Pattern is "delay every 2nd beat by
  // swing * 1/3 of a beat" — alternates at beat_index parity.
  beat_index  = (beat_index + 1) % timesig;
  beat_phase -= current_swing * (1.0 / 3.0) * ((beat_index + 1) % 2);
);

out = 0;
tick_playing ? (
  out = tick_src[tick_pos];
  tick_pos += 1;
  tick_pos >= tick_len ? tick_playing = 0;
);

pan_pos = (tick_pan + 1.0) * 0.5;
spl0 = out * cos(pan_pos * $pi * 0.5);
spl1 = out * sin(pan_pos * $pi * 0.5);

);  // close start-delay else branch

@serialize
// Persist per-target drift AND speed-ramp configurations. Without this,
// only the most-recently-edited target's values survive a save/load
// because the sliders hold whichever target was selected at save time.
//
// VERSION-GUARDED (CLAUDE.md @serialize gotcha): leads with a magic marker so
// format changes degrade to defaults instead of scrambling. Magic bumped to
// 2100000 + N_TARGETS in v2.14 when Speed Ramp went PER-TARGET timeline (added
// the duration + start-delay banks); an older 2000000-base blob won't match
// and falls through to @init defaults (drift + ramp reset — acceptable, this
// is pre-release). Marker is well above any plausible first-field value and
// float32-exact (< 2^24).
sr_magic = 2100000 + N_TARGETS;
file_var(0, sr_magic);
sr_magic == 2100000 + N_TARGETS ? (
  file_mem(0, target_drift_up,     N_TARGETS);
  file_mem(0, target_drift_down,   N_TARGETS);
  file_mem(0, target_drift_per,    N_TARGETS);
  file_mem(0, target_drift_shape,  N_TARGETS);
  file_var(0, last_target_select);
  file_mem(0, speed_ramp_by_mem,    N_TARGETS);
  file_mem(0, speed_ramp_dur_mem,   N_TARGETS);
  file_mem(0, speed_ramp_delay_mem, N_TARGETS);
  file_var(0, last_sr_target);

  // TRACK-DUPLICATE FIX (v2.14). On READ (load/duplicate) file_avail(0) >= 0;
  // on WRITE (save/undo) it is < 0. @serialize is the only section guaranteed
  // to run on both load AND duplicate, so it re-establishes the bank<->slider
  // invariant here: force the visible config sliders to match the restored
  // bank for the restored selectors, correcting any transient @slider clobber
  // (which would otherwise zero whichever target was selected on the copy).
  file_avail(0) >= 0 ? (
    slider18 = speed_ramp_by_mem[last_sr_target];        // Speed ramp `by`
    slider19 = speed_ramp_dur_mem[last_sr_target];       // Speed ramp duration
    slider21 = speed_ramp_delay_mem[last_sr_target];     // Speed ramp start delay
    slider23 = target_drift_up[last_target_select];      // Drift up
    slider24 = target_drift_down[last_target_select];    // Drift down
    slider25 = target_drift_per[last_target_select];     // Drift period
    slider26 = target_drift_shape[last_target_select];   // Drift shape
    sliderchange(-1);
  );
);
