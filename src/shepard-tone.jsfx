desc: Shepard Tone Generator
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/
//
// A Shepard-Risset glissando generator — an auditory illusion of pitch that
// sweeps upward (or downward) continuously without ever actually getting higher.
//
// HOW IT WORKS:
// Each voice is rooted at a musical note. Inside that voice, multiple oscillators
// are stacked at exact octave intervals from the root. The pitch window is exactly
// as wide as the Octave Count — so spacing is always 1 octave and handoffs are
// always clean. All oscillators sweep continuously in the same direction. Each
// oscillator's volume is shaped by the Fade In/Out controls — loud near the center
// of the window, silent at the edges. When an oscillator exits the top of the window
// it wraps silently to the bottom and begins fading in again, producing seamless
// continuous motion.
//
// VOICES:
// Up to 8 independent voices, each rooted at a different note. Use multiple
// voices to create Shepard chords (e.g. C+E+G), counterpoint (one ascending,
// one descending), or polyrhythmic textures (Independent drift mode with
// different rates per voice).
//
// CONTROLS:
//   Drift Mode       — Synced: all voices share Rate Value; each voice's Drift
//                      slider is a cents detune offset on its oscillators.
//                      Independent: each voice's Drift slider is its own rate
//                      in the current Rate Mode units.
//   Rate Mode/Value  — How fast the sweep cycles: BPM, cycle length in seconds,
//                      or direct Hz.
//   Octave Count     — How many oscillators run per voice (2-12), and how many
//                      octaves wide the pitch window is. These are the same thing.
//   Center Octave    — Which octave sits at the middle of the pitch window.
//   Fade In/Out %    — What fraction of each sweep cycle is spent fading in or
//                      out. Lower values = longer hold at full volume, shorter
//                      crossfades. 20/20 is a good starting point for ambient use.
//   Waveform         — Sine is cleanest for the illusion. Other waveforms add
//                      harmonic color.
//   Binaural Beat    — Offsets the right channel frequency by this many Hz,
//                      producing a binaural beat at the specified frequency.
//   Root Note        — Global tonic. Per-voice Note sliders offset from this.
//   Tuning Ref       — Reference frequency for A4 (default 440Hz).
//
// PER-VOICE:
//   Note             — Pitch class of this voice, relative to Root Note.
//   Pan              — Stereo position. Negative = left, positive = right. 0 = center.
//   Direction        — Ascending or descending sweep.
//   Drift            — Cents detune (Synced) or independent rate (Independent).
//   Gain dB          — Volume of this voice.
//   Active           — Enables the voice. Controls hide when inactive.

// ===== GLOBAL CONTROLS =====
// ===== GLOBAL CONTROLS =====
slider1:0<0,1,1{Synced,Independent}>Drift Mode
slider2:0.5<0.001,1000,0.001>Rate Value (BPM / sec / Hz / beats per cycle / per beat)
slider3:0<0,4,1{BPM,Seconds,Hz,Every N beats,N per beat}>Rate Mode
slider4:8<2,16,1>Octave Count
slider5:3<0,8,1>Center Octave
slider6:20<0,100,0.1>Fade In %
slider7:20<0,100,0.1>Fade Out %
slider8:0<0,13,1{Sine,Triangle,Saw,Golden TS,Golden SG,Golden GS,Bell,Wavefold,Half-sine,Phi-cascade,Phi Triangle,Phi Sine,Square,Pulse}>Waveform
slider9:25<1,99,0.1>Pulse width (%, 50 = square)
slider10:0<0,1000,0.001>Binaural Beat Hz
slider11:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>Root Note
slider12:440<20,2000,0.1>Tuning Reference Hz
slider13:2<0,2,1{Hz,Semitones,Cents}>Fine tune unit (for every voice)

// ===== VOICES: Note, Fine tune, Direction, Rate, Gain, Pan, Active =====
slider14:9<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>V1 Note
slider15:0<-1000,1000,0.001>V1 Fine tune (in fine tune units)
slider16:0<0,1,1{Asc,Desc}>V1 Direction
slider17:0<-1000,1000,0.001>V1 Rate (in rate mode units; 0 = holds still)
slider18:0<-60,6,0.01>V1 Gain dB
slider19:0<-100,100,0.1>V1 Pan (neg=left, pos=right)
slider20:1<0,1,1{Off,On}>V1 Active
slider21:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>V2 Note
slider22:0<-1000,1000,0.001>V2 Fine tune (in fine tune units)
slider23:0<0,1,1{Asc,Desc}>V2 Direction
slider24:0<-1000,1000,0.001>V2 Rate (in rate mode units; 0 = holds still)
slider25:0<-60,6,0.01>V2 Gain dB
slider26:0<-100,100,0.1>V2 Pan (neg=left, pos=right)
slider27:0<0,1,1{Off,On}>V2 Active
slider28:4<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>V3 Note
slider29:0<-1000,1000,0.001>V3 Fine tune (in fine tune units)
slider30:0<0,1,1{Asc,Desc}>V3 Direction
slider31:0<-1000,1000,0.001>V3 Rate (in rate mode units; 0 = holds still)
slider32:0<-60,6,0.01>V3 Gain dB
slider33:0<-100,100,0.1>V3 Pan (neg=left, pos=right)
slider34:0<0,1,1{Off,On}>V3 Active
slider35:7<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>V4 Note
slider36:0<-1000,1000,0.001>V4 Fine tune (in fine tune units)
slider37:0<0,1,1{Asc,Desc}>V4 Direction
slider38:0<-1000,1000,0.001>V4 Rate (in rate mode units; 0 = holds still)
slider39:0<-60,6,0.01>V4 Gain dB
slider40:0<-100,100,0.1>V4 Pan (neg=left, pos=right)
slider41:0<0,1,1{Off,On}>V4 Active
slider42:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>V5 Note
slider43:0<-1000,1000,0.001>V5 Fine tune (in fine tune units)
slider44:0<0,1,1{Asc,Desc}>V5 Direction
slider45:0<-1000,1000,0.001>V5 Rate (in rate mode units; 0 = holds still)
slider46:0<-60,6,0.01>V5 Gain dB
slider47:0<-100,100,0.1>V5 Pan (neg=left, pos=right)
slider48:0<0,1,1{Off,On}>V5 Active
slider49:4<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>V6 Note
slider50:0<-1000,1000,0.001>V6 Fine tune (in fine tune units)
slider51:0<0,1,1{Asc,Desc}>V6 Direction
slider52:0<-1000,1000,0.001>V6 Rate (in rate mode units; 0 = holds still)
slider53:0<-60,6,0.01>V6 Gain dB
slider54:0<-100,100,0.1>V6 Pan (neg=left, pos=right)
slider55:0<0,1,1{Off,On}>V6 Active
slider56:7<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>V7 Note
slider57:0<-1000,1000,0.001>V7 Fine tune (in fine tune units)
slider58:0<0,1,1{Asc,Desc}>V7 Direction
slider59:0<-1000,1000,0.001>V7 Rate (in rate mode units; 0 = holds still)
slider60:0<-60,6,0.01>V7 Gain dB
slider61:0<-100,100,0.1>V7 Pan (neg=left, pos=right)
slider62:0<0,1,1{Off,On}>V7 Active
slider63:0<0,11,1{C,C#,D,D#,E,F,F#,G,G#,A,A#,B}>V8 Note
slider64:0<-1000,1000,0.001>V8 Fine tune (in fine tune units)
slider65:0<0,1,1{Asc,Desc}>V8 Direction
slider66:0<-1000,1000,0.001>V8 Rate (in rate mode units; 0 = holds still)
slider67:0<-60,6,0.01>V8 Gain dB
slider68:0<-100,100,0.1>V8 Pan (neg=left, pos=right)
slider69:0<0,1,1{Off,On}>V8 Active

// ===== TRANSPORT =====
slider70:0<0,1000,0.001>Start delay (in rate mode units)
slider71:0<0,1000,1>Play for (cycles)
slider72:0<0,1000,1>Rest for (cycles)
slider73:0<0,1,1{Walk through,Freeze in place}>Rest mode

// ===== DRIFT: 40 targets in control order =====
slider74:0<0,39,1{Rate value,Fade in,Fade out,Pulse width,Binaural beat,Tuning reference,V1 Fine tune,V1 Rate,V1 Gain,V1 Pan,V2 Fine tune,V2 Rate,V2 Gain,V2 Pan,V3 Fine tune,V3 Rate,V3 Gain,V3 Pan,V4 Fine tune,V4 Rate,V4 Gain,V4 Pan,V5 Fine tune,V5 Rate,V5 Gain,V5 Pan,V6 Fine tune,V6 Rate,V6 Gain,V6 Pan,V7 Fine tune,V7 Rate,V7 Gain,V7 Pan,V8 Fine tune,V8 Rate,V8 Gain,V8 Pan,Play for,Rest for}>Drift target
slider75:0<0,1000,0.01>Drift up amount (units match target)
slider76:0<0,1000,0.01>Drift down amount (units match target)
slider77:8<0,1000,1>Drift period (0 = off)
slider78:0<0,2,1{Cycles,Seconds,Beats}>Drift period unit
slider79:0<0,2,1{Sine,Triangle,Random}>Drift shape
slider80:0<0,1000,0.01>Drift play for (periods, 0 = always)
slider81:0<0,1000,0.01>Drift rest for (periods, 0 = always)

// ===== RAMP: the same 40 targets =====
slider82:0<0,39,1{Rate value,Fade in,Fade out,Pulse width,Binaural beat,Tuning reference,V1 Fine tune,V1 Rate,V1 Gain,V1 Pan,V2 Fine tune,V2 Rate,V2 Gain,V2 Pan,V3 Fine tune,V3 Rate,V3 Gain,V3 Pan,V4 Fine tune,V4 Rate,V4 Gain,V4 Pan,V5 Fine tune,V5 Rate,V5 Gain,V5 Pan,V6 Fine tune,V6 Rate,V6 Gain,V6 Pan,V7 Fine tune,V7 Rate,V7 Gain,V7 Pan,V8 Fine tune,V8 Rate,V8 Gain,V8 Pan,Play for,Rest for}>Ramp target
slider83:0<-1000,1000,0.001>Ramp by (units match target)
slider84:2<0,3,1{Cycles,Seconds,Minutes,Beats}>Ramp time unit
slider85:0<0,1000,0.1>Ramp duration (in ramp time units)
slider86:0<0,1000,0.01>Ramp play for (0 = smooth)
slider87:0<0,1000,0.01>Ramp rest for (0 = smooth)
slider88:0<0,1,1{Off,On}>Ramp engage
slider89:0<0,1000,0.1>Ramp start delay (in ramp time units)

@init
// Rate drift and Speed Ramp are in BPM in EVERY mode, Host x included --
// "BPM is BPM". In Host x the rate slider is a multiplier, so a BPM amount is
// converted to multiplier terms (D BPM = D/tempo) before it's added. The
// PLUGIN does that division, never the user. Rejected alternative: a
// multiplier delta -- consistent on paper, unusable in practice, since
// reaching a musical destination then needs arithmetic (1 - 1/3 = 0.667 for
// "every three beats"), and a ramp deliberately leaves the grid anyway.
// Parameter deliberately NOT a short name: EEL2 folds case, so a global `D`
// anywhere in the file would BE this parameter and the function would
// silently self-assign (the spectral_vowel_probe silence bug in CLAUDE.md).
// Returns the amount in the unit it must be ADDED in. Outside Host x that is
// the rate slider's own unit, so it passes through untouched. In Host x it is
// NOMINAL Hz (cycles/sec as if the project were at 60 BPM), because Rate Value
// there is beats per cycle and cannot take a BPM delta directly. Callers must
// add the Host x result to the HZ, never to the raw slider value.
//
// That distinction did not exist before 2026-09-04, because Host x's Rate Value
// WAS the nominal Hz -- so the two were the same operation. R13-revised
// inverted the unit and broke the identity. The same oversight shipped in both
// Polyrhythms and made drift run BACKWARDS in Host x; simulated at 120 BPM, a
// +10 BPM drift came out as -2.4. Fixed there and never present here, because
// this plugin is converted with the correction already applied.
function host_bpm_delta(bpm_amt) (
  rate_mode >= 3 ? bpm_amt / max(host_bpm, 0.001) : bpm_amt
);
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: REAPER re-runs @init on every transport play / render
// start, resetting all runtime for free (oscillator re-placement flag,
// gate state, drift runtime, Speed Ramp, Start Delay, Play/Rest). Only
// the drift CONFIG bank must survive the re-run; it's guarded by
// drift_cfg_inited below.

// Host tempo capture. `tempo` is one of REAPER's READ-ONLY system variables
// (see CLAUDE.md — assigning to it is silently ignored, which is how
// rhythm-track's Tempo slider did nothing for months). We only READ it, into
// our own global, and the global is deliberately NOT named `tempo`. The live
// tempo is applied as host_scale in @block; nothing here remembers it.
host_bpm   = max(tempo, 0.001);
host_scale = 1;

// The Host ratio picker is a CHANGE-triggered one-shot. On load it must adopt
// the saved slider80 WITHOUT firing, or a project that saved e.g. "every 2
// beats" would have its hand-tuned Rate Value overwritten the moment it
// opened. @init re-runs on transport play, so it re-adopts each play — fine,
// since the picker only needs to write when the user actually turns it.
host_ratio_inited = 0;

PHI = 1.6180339887;
NUM_OSC = 16; // max oscillators per voice

// Memory layout — voice * NUM_OSC + osc = index, max 8*16 = 128 slots
osc_freq    = 0;   // 0-127
osc_phase_l = 128; // 128-255
osc_phase_r = 256; // 256-383
osc_gain    = 384; // 384-511

// Per-voice (8 slots each)
v_active    = 512;
v_gain_lin  = 520;
v_gain_db   = 4096;  // dB before drift/ramp -- above every other bank
v_dir       = 528;
v_root      = 536; // root frequency in Hz
v_note      = 544;
v_pan       = 552; // pan position -100 to 100
shep_rate   = 560; // octaves per second
v_rate      = 568; // per-voice rate, Independent mode
v_fine      = 4104; // per-voice fine tune, in the unit at slider13
placed_pc   = 4112; // the note each voice's oscillators were last placed at

smooth = exp(-1 / (srate * 0.008)); // one-pole smoothing ~8ms — prevents clicks on gain changes
needs_init = 1; // true first-load only — places oscillators before any @sample runs

i = 0;
loop(128,
  osc_freq[i]    = 0;
  osc_phase_l[i] = 0;
  osc_phase_r[i] = 0;
  osc_gain[i]    = 0;
  i += 1;
);

function rate_to_hz(raw_rate, rmode) (
  // Host x (mode 3) returns a NOMINAL rate in cycles/sec, computed as if the
  // project were at 60 BPM, so this stays tempo-INDEPENDENT. The live tempo is
  // applied separately as host_scale in @block, and the two multiply out.
  //
  // Keeping the tempo out of here is what lets the mode survive a transport
  // press: @init re-runs on every play and wipes globals, so anything that had
  // to REMEMBER the tempo a derivation was computed against would be reset
  // while the derived values still described the old one. Nothing to remember,
  // nothing to go stale. (Melody Phase shipped that bug; don't repeat it.)
  rmode == 0 ? max(raw_rate, 0.001) / 60 :
  rmode == 1 ? 1 / max(raw_rate, 0.001) :
  // Host x: Rate Value is BEATS PER CYCLE, not a multiplier (R13-revised,
  // 2026-09-02). At the nominal 60 BPM one beat is one second, so N beats per
  // cycle is 1/N cycles per second; host_scale = tempo/60 in @block then makes
  // it tempo/(60*N).
  //
  // Guarded on the NUMERATOR. Inverting a unit inverts its edge cases:
  // 1/max(raw,0.001) clamps the DENOMINATOR and turns a stopped sweep into a
  // 1000 Hz one. That matters here more than anywhere -- the per-voice rate in
  // Independent mode comes from a -1000..1000 slider that DEFAULTS TO 0, so a
  // fresh voice would have screamed at audio rate.
  rmode == 3 ? (raw_rate > 0.001 ? 1 / raw_rate : 0.001) :
               max(raw_rate, 0.001)
);

function note_to_hz(note, oct, tref) (
  tref * pow(2, ((oct + 1) * 12 + note - 69) / 12.0)
);

// Waveform dispatch — kept in sync with Polyrhythm Phase / Melody Phase
// so all four plugins offer the same palette. See those plugins' source
// for the canonical comment blocks on each waveform. Note that the
// Golden TS / SG slots are the polyrhythm-compatible (sine-output)
// versions, not the manual's strict reading — Phi Triangle / Phi Sine
// are the strict-reading variants. See rozaya-jsfx/CLAUDE.md for why.
// PolyBLEP: band-limited step correction for the Square and Pulse
// waveforms (slots 12-13). At each discontinuity the naive wave jumps
// instantly, which is infinite bandwidth and aliases badly. This adds a
// small correction over the one sample either side of the edge. bdt is
// the phase increment per sample, so the correction scales with pitch.
// Returns 0 away from an edge, so it costs nothing for other waveforms.
function polyblep(bt, bdt) local(bs) (
  bt < bdt ? (
    bs = bt / bdt;
    bs + bs - bs * bs - 1;
  ) : bt > 1 - bdt ? (
    bs = (bt - 1) / bdt;
    bs * bs + bs + bs + 1;
  ) : (
    0;
  );
);

function wave_sample(ph, pbdt) (
  waveform == 0 ? sin(ph * 2 * $pi) :
  waveform == 1 ? (ph < 0.25 ? ph * 4 : ph < 0.75 ? 2 - ph * 4 : ph * 4 - 4) :
  waveform == 2 ? (
    ps = ph + 0.5; ps -= floor(ps); ps * 2 - 1
  ) :
  waveform == 3 ? (
    pg = ph < (1/PHI) ? ph * PHI * 0.5 : 0.5 + (ph - 1/PHI) / (1 - 1/PHI) * 0.5;
    sin(pg * 2 * $pi)
  ) :
  waveform == 4 ? (
    pg = (sin((ph - 0.25) * 2 * $pi) + 1) * 0.5;
    pg = pg < (1/PHI) ? pg * PHI * 0.5 : 0.5 + (pg - 1/PHI) / (1 - 1/PHI) * 0.5;
    sin(pg * 2 * $pi)
  ) :
  waveform == 5 ? (
    pg = ph + (1/PHI) * sin(ph * 2 * $pi) / (2 * $pi);
    pg -= floor(pg);
    sin(pg * 2 * $pi)
  ) :
  waveform == 6 ? (
    // Bell — additive partials at 1, 2, 3, 4, 6
    0.55 * sin(ph * 2 * $pi) + 0.25 * sin(ph * 4 * $pi)
      + 0.10 * sin(ph * 6 * $pi) + 0.07 * sin(ph * 8 * $pi)
      + 0.03 * sin(ph * 12 * $pi)
  ) :
  waveform == 7 ? sin(2 * sin(ph * 2 * $pi)) :          // Wavefold
  waveform == 8 ? (2 * abs(sin(ph * 2 * $pi)) - 1) :    // Half-sine (octave up; see Polyrhythm Phase docs)
  waveform == 9 ? (
    // Phi-cascade — fundamental + φ⁻¹·2nd + φ⁻²·3rd
    sin(ph * 2 * $pi) + (1/PHI) * sin(ph * 4 * $pi)
      + (1/(PHI*PHI)) * sin(ph * 6 * $pi)
  ) :
  waveform == 10 ? (
    // Phi Triangle — manual-correct "Golden TS" (warp → triangle)
    pg = ph < (1/PHI) ? ph * PHI * 0.5 : 0.5 + (ph - 1/PHI) / (1 - 1/PHI) * 0.5;
    pg < 0.5 ? 4 * pg - 1 : 3 - 4 * pg
  ) :
  waveform == 11 ? (
    // Phi Sine — manual-correct "Golden SG" (clean warp → sine, no prewarp)
    pg = ph < (1/PHI) ? ph * PHI * 0.5 : 0.5 + (ph - 1/PHI) / (1 - 1/PHI) * 0.5;
    sin(pg * 2 * $pi)
  ) :
  waveform == 12 ? (
    // Square — +1 for the first half of the cycle, -1 for the second,
    // PolyBLEP-corrected at both edges (the wrap at 0 and the fall at
    // 0.5). Matches the Square slot in Polyrhythm Phase.
    pusq = ph < 0.5 ? 1 : -1;
    putd = ph - 0.5; putd < 0 ? putd += 1;
    pusq + polyblep(ph, pbdt) - polyblep(putd, pbdt)
  ) : (
    // Pulse — same shape with the falling edge at pulse_duty instead of
    // 0.5. At duty 0.5 this is identical to Square; narrower gets
    // thinner and more nasal. A duty other than 50 introduces a DC
    // offset, inaudible and attenuated downstream — the same accepted
    // tradeoff as Half-sine.
    pusq = ph < pulse_duty ? 1 : -1;
    putd = ph - pulse_duty; putd < 0 ? putd += 1;
    pusq + polyblep(ph, pbdt) - polyblep(putd, pbdt)
  )
);

// window_gain: returns 0-1 gain for an oscillator at log-frequency lf.
// pos=0 is the bottom of the pitch window, pos=1 is the top.
// Fade in over the bottom fi fraction, hold at 1, fade out over the top fo fraction.
// Oscillators outside the window (pos<=0 or pos>=1) return 0 — silent wrap zone.
function window_gain(lf, log_lo, log_range, fi, fo) (
  pos = (lf - log_lo) / log_range;
  pos <= 0 || pos >= 1 ? 0 :
  pos < fi ? (fi > 0 ? 0.5 - 0.5 * cos(pos / fi * $pi) : 1) :
  pos > (1 - fo) ? (fo > 0 ? 0.5 - 0.5 * cos((1 - pos) / fo * $pi) : 0) :
  1
);

// Start Delay state.
last_play_state     = 0;
start_delay_elapsed = 0;
start_delay_sec     = 0;

// Play/Rest gate state. pr_cycle_progress is a continuous counter
// (fractional cycles elapsed in the current play or rest period)
// that flips pr_resting and resets when it crosses the relevant
// threshold. Always uses base_rate_hz as the clock, same as
// Start Delay — Rate Value is the master cycle unit regardless of
// drift_mode.
pr_resting        = 0;
pr_cycle_progress = 0;
play_for_cycles   = 0;
rest_for_cycles   = 0;
pr_enabled        = 0;
rest_mode         = 0;

// Speed ramp state. Engage (global) is a freeze/resume gate, not an edge;
// only transport play resets the per-target ramp clocks. As of v2.14 the
// ramp is PER-TARGET: each target has its own `by`, duration, start delay,
// and progress clock, so different targets can wind down over different
// timelines from one engage. speed_scale_current is the Rate-Value ramp's
// multiplicative factor (target 0), recomputed each sample.
speed_scale_current      = 1.0;

// --- v2.9 Drift target memory banks ---
//
// 11 targets × 8 fields. Each array is 16-slot-spaced so targets can
// grow to 16 later without re-laying-out. Placed at 576 — right after
// drifts[] (per-voice array ending at 575), no overlap with osc / v
// arrays below.
//
// Targets:
//   0      = Rate Value        (units: rate's current unit)
//   1..8   = V1..V8 Rate        (units: rate's current unit)
//   9      = Fade In %          (units: %)
//   10     = Fade Out %         (units: %)
// 2026-09-09: 11 -> 28. Per-voice Gain and Pan and the binaural beat were not
// reachable by drift or ramp, while Melody and Polyrhythm could both drift their
// per-voice gain -- the suite's own "unpropagated good decision" failure again.
// Rozaya: "Drift is replacing automation, nobody's gonna automate everything but
// options are better than their absence." APPENDED, so no stored target index
// moves (R18: enum options always append).
// 2026-09-10: the banks are 64 apart. At 16 apart these targets ran into each
// other's banks, so drift offsets overwrote ramp settings while playing.
N_TARGETS = 40;
target_drift_up     = 576;
target_drift_down   = 640;
target_drift_per    = 704;
target_drift_shape  = 768;
target_drift_phase  = 832;
target_drift_prev   = 896;
target_drift_curr   = 960;
target_drift_offset = 1024;

// Speed ramp per-target banks (v2.14). Mirror the drift banks; 16-slot-spaced
// after target_drift_offset (688). `by` / duration / start-delay are CONFIG
// (survive transport, restored by @serialize); ramp_t / delay_elapsed are
// RUNTIME (reset every @init / transport play).
speed_ramp_by_mem            = 1088;  // signed delta per target (CONFIG)
speed_ramp_dur_mem           = 1152;  // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 1216;  // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 1280;  // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 1344;  // delay sample counter per target (RUNTIME)

// Drift and Ramp play/rest, per target (2026-09-06). 16-slot-spaced like the
// banks above. play/rest are CONFIG (survive a transport re-init, restored by
// @serialize); accumulator and resting flag are RUNTIME. FIRST FREE SLOT AFTER
// THIS BLOCK IS 1920 -- re-derive rather than trusting this comment.
drift_play_mem       = 1408;
drift_rest_mem       = 1472;
sr_play_mem          = 1536;
sr_rest_mem          = 1600;
drift_pr_accum_mem   = 1664;
drift_pr_resting_mem = 1728;
sr_pr_accum_mem      = 1792;
sr_pr_resting_mem    = 1856;

// Shared play/rest gate, byte-identical to the one in Melody, the Sweeping
// Filter, Tremolo, Phaser, Bubbler, Dapple, Resonance Bank and the Morpher.
// `tick` is how much of one play/rest unit passes per sample, so the caller owns
// the unit and this stays unitless. Returns 1 while the target is resting.
function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

// CONFIG banks (drift up/down/period/shape + speed-ramp by/duration/start-delay
// + selector trackers) — guarded by drift_cfg_inited so the @init re-run on
// every transport play (Path A render fix, no ext_noinit) does NOT wipe the
// user's setup. @serialize restores saved configs on project reload.
drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_TARGETS,
    target_drift_up[i]    = 0;
    target_drift_down[i]  = 0;
    target_drift_per[i]   = 8;
    target_drift_shape[i] = 0;
    speed_ramp_by_mem[i]    = 0;
    speed_ramp_dur_mem[i]   = 0;
    speed_ramp_delay_mem[i] = 0;
    drift_play_mem[i] = 0; drift_rest_mem[i] = 0;
    sr_play_mem[i]    = 0; sr_rest_mem[i]    = 0;
    i += 1;
  );
  last_target_select = 0;
  last_sr_target     = 0;
  drift_cfg_inited = 1;
);

// Drift + speed-ramp RUNTIME resets on EVERY @init (every transport play).
i = 0;
loop(N_TARGETS,
  target_drift_phase[i]  = 0;
  target_drift_prev[i]   = 0;
  target_drift_curr[i]   = 0;
  target_drift_offset[i] = 0;
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  drift_pr_accum_mem[i] = 0; drift_pr_resting_mem[i] = 0;
  sr_pr_accum_mem[i]    = 0; sr_pr_resting_mem[i]    = 0;
  i += 1;
);


@slider

drift_mode   = slider1;
rate_mode    = slider3;

// --- Host ratio picker (slider80) -> Rate Value ---------------------------
// Fires only when the picker CHANGES, writes the multiplier into Rate Value,
// then stays out of the way. It does not hold Rate Value afterwards, so
// hand-editing or automating it works exactly as before -- the picker just
// shows whatever was last applied. "Custom" (0) never writes anything.
// RETIRED 2026-09-04 (R13-revised). Guard forced to 0 rather than deleted, so
// the reasoning stays beside the code it disabled. Rate Value says beats per
// cycle in Host x now, so there is no multiplier for a picker to translate --
// and a picker that WRITES a value is the shape that stamped 0.5 over a
// hand-set rate on every load in infantile.RPP.
// The LANDING BLOCK is gone (R13-revised step 4). It used to stamp the picker
// to "1 per beat" and Rate Value to 1 on entering Host x, because meeting a
// bare MULTIPLIER first was the trap. There is no trap now: 0.5 beats per cycle
// is a legible number (two sweeps a beat), so nothing needs stamping and,
// crucially, the RATE SLIDER NEVER HIDES. Hiding it is what forced the stamp.
rate_mode_inited ? last_rate_mode = rate_mode;


rate_val     = slider2;
num_osc      = max(2, min(16, floor(slider4 + 0.5)));
center_oct   = floor(slider5 + 0.5);
fade_in_pct  = slider6;
fade_out_pct = slider7;
waveform     = slider8;
// Pulse duty as a 0..1 fraction of the cycle. Only read by waveform
// slot 13, and the slider only shows there.
pulse_duty   = slider9 * 0.01;
pulse_duty_base = pulse_duty;
fine_unit    = slider13;
slider_show(slider9, waveform == 13);
binaural_hz  = slider10;
root_note    = floor(slider11 + 0.5);
tuning_ref   = slider12;

// Pitch window: exactly num_osc octaves wide, centered on center_oct.
// Window width == octave count means spacing is always exactly 1 octave,
// so oscillators always land on exact octave intervals of the root.
center_freq     = tuning_ref * pow(2, center_oct - 4); // A in center octave
pitch_lo        = center_freq * pow(2, -num_osc * 0.5);
pitch_hi        = center_freq * pow(2,  num_osc * 0.5);
log_pitch_lo    = log(pitch_lo);
log_pitch_hi    = log(pitch_hi);
log_pitch_range = log_pitch_hi - log_pitch_lo;

base_rate_hz = rate_to_hz(rate_val, rate_mode);
oct_range    = num_osc; // window is exactly num_osc octaves wide

// Read per-voice sliders and recompute derived values — like polyrhythm, no reinit needed.
// Oscillators keep sweeping; note changes simply update v_root and the @sample loop
// brings each oscillator into the new window on its next wrap.
i = 0;
loop(8,
  base = 14 + i * 7;
  v_note[i]     = slider(base);
  v_fine[i]     = slider(base + 1);
  v_dir[i]      = slider(base + 2);
  v_rate[i]     = slider(base + 3);
  v_gain_db[i]  = slider(base + 4);
  v_gain_lin[i] = pow(10, v_gain_db[i] / 20.0);
  v_pan[i]      = slider(base + 5);
  v_active[i]   = slider(base + 6);
  v_root[i]     = note_to_hz(v_note[i] + root_note, 4, tuning_ref);

  drift_mode == 0 ? (
    shep_rate[i] = base_rate_hz * oct_range;
  ) : (
    // Independent mode: a rate of 0 (or below) means "this voice does
    // not sweep" — it holds its pitch. The old code clamped via
    // max(drifts[i], 0.001), which produced a slow creep in BPM/Hz
    // mode and a wild 1000 Hz sweep in Seconds mode (1/0.001) — so a
    // voice whose Rate slider read 0 was still moving behind the
    // scenes. Guard explicitly: rate > 0 sweeps at that rate;
    // rate <= 0 freezes the voice (shep_rate = 0 → freq_mul = 1).
    v_rate[i] > 0 ? (
      shep_rate[i] = rate_to_hz(v_rate[i], rate_mode) * oct_range;
    ) : (
      shep_rate[i] = 0;
    );
  );

  i += 1;
);

// Fade fractions are now computed per-sample in @sample as eff_fade_*
// (baseline fade_in_pct/fade_out_pct + Fade % drift offset, clamped +
// renormalized). The old @slider fade_in_frac/fade_out_frac precompute
// was removed in v2.9 — fade_in_pct / fade_out_pct carry the baseline.

// Show/hide per-voice controls based on active state.
// Must use actual sliderN variables — slider_show() takes slider variable
// references or bitmasks, NOT integer indices.
// Active toggle always visible; other controls hide when voice is inactive;
// drift additionally requires Independent mode.
slider_show(slider14, slider20); slider_show(slider15, slider20); slider_show(slider16, slider20);
slider_show(slider17, slider20 && drift_mode == 1); slider_show(slider18, slider20); slider_show(slider19, slider20);
slider_show(slider21, slider27); slider_show(slider22, slider27); slider_show(slider23, slider27);
slider_show(slider24, slider27 && drift_mode == 1); slider_show(slider25, slider27); slider_show(slider26, slider27);
slider_show(slider28, slider34); slider_show(slider29, slider34); slider_show(slider30, slider34);
slider_show(slider31, slider34 && drift_mode == 1); slider_show(slider32, slider34); slider_show(slider33, slider34);
slider_show(slider35, slider41); slider_show(slider36, slider41); slider_show(slider37, slider41);
slider_show(slider38, slider41 && drift_mode == 1); slider_show(slider39, slider41); slider_show(slider40, slider41);
slider_show(slider42, slider48); slider_show(slider43, slider48); slider_show(slider44, slider48);
slider_show(slider45, slider48 && drift_mode == 1); slider_show(slider46, slider48); slider_show(slider47, slider48);
slider_show(slider49, slider55); slider_show(slider50, slider55); slider_show(slider51, slider55);
slider_show(slider52, slider55 && drift_mode == 1); slider_show(slider53, slider55); slider_show(slider54, slider55);
slider_show(slider56, slider62); slider_show(slider57, slider62); slider_show(slider58, slider62);
slider_show(slider59, slider62 && drift_mode == 1); slider_show(slider60, slider62); slider_show(slider61, slider62);
slider_show(slider63, slider69); slider_show(slider64, slider69); slider_show(slider65, slider69);
slider_show(slider66, slider69 && drift_mode == 1); slider_show(slider67, slider69); slider_show(slider68, slider69);

// Start Delay: convert to seconds based on Rate Mode. BPM beats and
// Hz cycles are interpreted against Rate Value; Seconds is literal.
start_delay_units = slider70;
// Every non-Seconds mode means "this many CYCLES", and base_rate_hz is already
// cycles-per-second, so the conversion is just units / base_rate_hz. That's
// algebraically identical to the old per-mode arithmetic (BPM: 60/rate,
// Hz: 1/rate) and picks up Host x for free instead of falling through to the
// Hz branch and ignoring the tempo.
rate_mode == 1 ? start_delay_sec = start_delay_units :
                 start_delay_sec = start_delay_units / max(base_rate_hz, 0.001);

// Play/Rest gate: integer cycle counts. Both must be > 0 for the
// gate to engage; 0 in either slider disables.
play_for_cycles = slider71;
rest_for_cycles = slider72;
pf_base = play_for_cycles; rf_base = rest_for_cycles;
new_pr_enabled  = (play_for_cycles > 0 && rest_for_cycles > 0);
// Defensive reset: if user disables the gate (sets either slider to
// 0), drop pr_resting back to play and zero the progress counter so
// the gate doesn't carry stuck state into a future re-enable.
!new_pr_enabled && pr_resting ? (
  pr_resting = 0;
  pr_cycle_progress = 0;
);
pr_enabled = new_pr_enabled;
rest_mode  = slider73;

// Speed ramp engage-edge.
// No engage-edge detection. Engage is a freeze/resume gate handled
// in @sample. Only transport play resets ramp_t.

// Drift target selector save/restore (nested-selector pattern).
// Switching slider74 saves sliders 70-73 into the OLD target's slot,
// then loads the NEW target's stored config into sliders 70-73.
// Otherwise captures live edits to the current target's slot. All 11
// targets drift in parallel from @sample regardless of selection.
sel_target = slider74;
sel_up     = slider75;
sel_down   = slider76;
sel_per    = slider77;
sel_shape  = slider79;
sel_dplay  = slider80;
sel_drest  = slider81;

last_target_select != sel_target ? (
  target_drift_up[last_target_select]    = sel_up;
  target_drift_down[last_target_select]  = sel_down;
  target_drift_per[last_target_select]   = sel_per;
  target_drift_shape[last_target_select] = sel_shape;
  drift_play_mem[last_target_select]     = sel_dplay;
  drift_rest_mem[last_target_select]     = sel_drest;

  slider75 = target_drift_up[sel_target];
  slider76 = target_drift_down[sel_target];
  slider77 = target_drift_per[sel_target];
  slider79 = target_drift_shape[sel_target];
  slider_automate(slider75);
  slider_automate(slider76);
  slider_automate(slider77);
  slider80 = drift_play_mem[sel_target];
  slider81 = drift_rest_mem[sel_target];
  slider_automate(slider79);
  slider_automate(slider80);
  slider_automate(slider81);

  last_target_select = sel_target;
) : (
  target_drift_up[sel_target]    = sel_up;
  target_drift_down[sel_target]  = sel_down;
  target_drift_per[sel_target]   = sel_per;
  target_drift_shape[sel_target] = sel_shape;
  drift_play_mem[sel_target]     = sel_dplay;
  drift_rest_mem[sel_target]     = sel_drest;
);

// Speed ramp target selector save/restore (nested-selector, mirrors the drift
// block above). slider82 = target; slider83 = per-target `by`; slider85 =
// per-target duration; slider89 = per-target start delay (all three are
// per-target as of v2.14). slider88 (engage) stays GLOBAL. Switching slider82
// saves the three per-target sliders into the OLD target's slots, then loads
// the NEW target's stored values. Otherwise captures live edits. All targets
// ramp in parallel from @sample, each on its own duration/delay clock.
sr_sel_target = slider82;
sr_sel_by     = slider83;
sr_sel_dur    = slider85;
sr_sel_delay  = slider89;
sr_sel_play   = slider86;
sr_sel_rest   = slider87;

last_sr_target != sr_sel_target ? (
  speed_ramp_by_mem[last_sr_target]    = sr_sel_by;
  speed_ramp_dur_mem[last_sr_target]   = sr_sel_dur;
  speed_ramp_delay_mem[last_sr_target] = sr_sel_delay;
  sr_play_mem[last_sr_target]          = sr_sel_play;
  sr_rest_mem[last_sr_target]          = sr_sel_rest;
  slider83 = speed_ramp_by_mem[sr_sel_target];
  slider85 = speed_ramp_dur_mem[sr_sel_target];
  slider89 = speed_ramp_delay_mem[sr_sel_target];
  slider_automate(slider83);
  slider_automate(slider85);
  slider86 = sr_play_mem[sr_sel_target];
  slider87 = sr_rest_mem[sr_sel_target];
  slider_automate(slider89);
  slider_automate(slider86);
  slider_automate(slider87);
  last_sr_target = sr_sel_target;
) : (
  speed_ramp_by_mem[sr_sel_target]    = sr_sel_by;
  speed_ramp_dur_mem[sr_sel_target]   = sr_sel_dur;
  speed_ramp_delay_mem[sr_sel_target] = sr_sel_delay;
  sr_play_mem[sr_sel_target]          = sr_sel_play;
  sr_rest_mem[sr_sel_target]          = sr_sel_rest;
);


@block
// --- Restore-order guard for the change-detecting controls below -----------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the picker then fires and slider_automate()s
//     its ratio over a rate that was set by hand. @block cannot run before the
//     instance is configured, so adopting here is right whatever order the
//     restore paths ran in. (Proved 2026-08-23: a Sweeping Filter in BPM mode
//     with Host ratio "every 2 beats" had Rate Value stamped to 0.5 on every
//     load and every track duplicate.)
!rate_mode_inited ? ( last_rate_mode = slider3; rate_mode_inited = 1; );
// Follow the project tempo while Host x mode is active.
//
// host_scale is ABSOLUTE (tempo / 60), never a ratio against a remembered
// reference tempo: @init re-runs on every transport play and wipes globals, so
// a remembered reference would reset on play while the derived rates still
// described the old tempo, and the change would vanish the moment you pressed
// play. rate_to_hz computes mode 3 against a nominal 60 BPM instead, and the
// two multiply out.
//
// host_scale is 1 in every other rate mode, so BPM / Seconds / Hz projects are
// bit-identical to before. Transport-edge detection belongs in @block rather
// than @sample (play_state only updates per block); the same applies to tempo.
host_bpm = max(tempo, 0.001);
// R21: >= 3 covers BOTH host modes -- Every N beats (3) and N per beat (4).
// Both are computed against a NOMINAL 60 BPM and then scaled by the live tempo
// here, which is what keeps them tempo-independent upstream (@init re-runs on
// play and would wipe a remembered tempo).
host_scale = rate_mode >= 3 ? host_bpm / 60 : 1;

@sample

// (No transport-edge reset here — Path A. REAPER re-runs @init on every
// transport play / render start, which resets all runtime state —
// oscillator re-placement flag (needs_init), gate state, drift runtime,
// Speed Ramp, Start Delay, Play/Rest; the drift CONFIG bank is preserved
// across those re-runs by the drift_cfg_inited guard in @init. See
// docs/v2.9-render-state-bug.md.)

// Advance each target's own ramp clock (v2.14 per-target timeline). Engage
// (slider88, GLOBAL) is the freeze/resume gate: while On, every target whose
// duration > 0 advances its own ramp_t 0->1 over its own duration, after its
// own start delay; while Off, all clocks freeze and resume from where they
// are. Only transport play (via @init) resets them. This lets different
// targets wind down over different timelines from a single engage.
slider88 ? (
  // Ramp time unit (slider84). One factor turns the block's time values into
  // seconds, so Duration and Start delay always mean the same as each other.
  // Beats is 60/project tempo, recomputed per sample so it follows a live tempo
  // change rather than remembering one.
  ramp_time_scale =
    slider84 == 3 ? 60 / max(tempo, 0.001) :
    slider84 == 2 ? 60 :
    slider84 == 1 ? 1 :
                    1 / max(base_rate_hz, 0.00001);
  i = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * ramp_time_scale * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        // Staircase: advance for `play`, hold for `rest`, repeat. The holds come
        // OUT of the duration rather than extending it -- the advancing step is
        // scaled by (play+rest)/play -- so Ramp duration goes on meaning "you
        // arrive in about this long".
        sr_pl = sr_play_mem[i];
        sr_rs = sr_rest_mem[i];
        sr_pr_on = sr_pl > 0 && sr_rs > 0;
        sr_hold = pr_frozen(sr_pr_accum_mem, sr_pr_resting_mem, i,
                            1.0 / (ramp_time_scale * srate), sr_pl, sr_rs);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !sr_hold ? (
          sr_step = 1.0 / (srate * speed_ramp_dur_mem[i] * ramp_time_scale);
          sr_pr_on ? sr_step *= (sr_pl + sr_rs) / sr_pl;
          speed_ramp_ramp_t_mem[i] += sr_step;
          speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
        );
      );
    );
    i += 1;
  );
);

// Each target's live ramp offset is speed_ramp_ramp_t_mem[t] *
// speed_ramp_by_mem[t], applied at that target's consumption site alongside
// the matching drift offset. Rate-type targets (Rate Value + per-voice) add
// the offset in the native rate unit BEFORE rate_to_hz, so BPM/Hz/Seconds
// mode-direction is handled for free.
//
// Rate Value (target 0): effective rate value = slider2 + ramp offset,
// converted to Hz and expressed as a multiplicative factor (effective /
// base) so the existing combined_scale-based audio path keeps working.
// WHERE the amount is added matters in Host x, and only since 2026-09-04.
// Rate Value there is BEATS PER CYCLE, so adding a BPM amount to it would
// change the wrong quantity in the wrong direction -- more beats per cycle is
// SLOWER. host_bpm_delta returns nominal Hz in that mode, so it is added to
// the Hz. Outside Host x nothing changes: the amount goes straight onto the
// slider's own unit exactly as before, which is what makes BPM/Seconds/Hz
// mode-direction come out right for free.
sr_bpm_amt = speed_ramp_ramp_t_mem[0] * speed_ramp_by_mem[0];
rate_mode >= 3 ? (
  effective_rate_hz = max(base_rate_hz + host_bpm_delta(sr_bpm_amt), 0.0001);
) : (
  effective_rate_hz = rate_to_hz(slider2 + sr_bpm_amt, rate_mode);
);
speed_scale_current = effective_rate_hz / max(base_rate_hz, 0.001);

// Per-target drift wave computation. 11 targets (0=Rate Value, 1-8=
// V1-V8 Rate, 9=Fade In %, 10=Fade Out %). Each gets a phase counter
// advancing per sample. Period unit is glissando cycles for ALL
// targets, referenced against base_rate_hz * speed_scale_current
// (cycle rate scaled by Speed Ramp but NOT by drift, to avoid a
// self-modulating feedback loop).
drift_cycle_rate = base_rate_hz * speed_scale_current;
i = 0;
loop(N_TARGETS,
  up    = target_drift_up[i];
  down  = target_drift_down[i];
  per   = target_drift_per[i];
  shape = target_drift_shape[i];

  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    // Drift period unit (slider78). Cycles is this plugin's own count, taken at
    // the Speed-Ramp-adjusted rate so drift does not self-modulate its period --
    // what this control always did. Seconds is wall clock. Beats counts the
    // PROJECT tempo.
    period_samples =
      slider78 == 2 ? max(per * 60 / max(tempo, 0.001) * srate, 1) :
      slider78 == 1 ? max(per * srate, 1) :
                      max(per * srate / max(drift_cycle_rate, 0.0001), 1);

    // Drift play/rest, per target, counted in PERIODS. While resting the phase
    // does not advance at all, so the offset FREEZES where it stopped rather
    // than returning to centre.
    d_frozen = pr_frozen(drift_pr_accum_mem, drift_pr_resting_mem, i,
                         1.0 / period_samples,
                         drift_play_mem[i], drift_rest_mem[i]);
    // One-armed pairs: an empty else-branch is a silent compile failure in eel2.
    d_frozen ? ( new_phase = target_drift_phase[i]; );
    !d_frozen ? (
      new_phase = target_drift_phase[i] + 1.0 / period_samples;
      new_phase >= 1.0 ? (
        new_phase -= 1.0;
        shape == 2 ? (
          target_drift_prev[i] = target_drift_curr[i];
          target_drift_curr[i] = rand(2) - 1;
        );
      );
    );
    target_drift_phase[i] = new_phase;

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = target_drift_prev[i] +
        (target_drift_curr[i] - target_drift_prev[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  target_drift_offset[i] = drift_offset_local;
  i += 1;
);

// Rate Value drift (target 0) → global multiplier on base_rate_hz via
// the rate_to_hz ratio (so BPM/Hz/Seconds mode-direction is handled —
// e.g. in Seconds mode a positive offset lengthens the period =
// slower). Folds into combined_scale alongside Speed Ramp. Per-voice
// rate drift (targets 1-8) is applied inside the voice loop below.
rate_mode >= 3 ? (
  rate_value_drift_mult = max(base_rate_hz + host_bpm_delta(target_drift_offset[0]), 0.0001)
                          / max(base_rate_hz, 0.001);
) : (
  rate_value_drift_mult = rate_to_hz(rate_val + target_drift_offset[0], rate_mode)
                          / max(base_rate_hz, 0.001);
);
// host_scale folds the live project tempo in alongside Speed Ramp and Drift
// (1 outside Host x mode, so this is a no-op elsewhere). Everything that rides
// combined_scale — the Play/Rest cycle counter and the Shepard glide rate —
// follows the tempo for free. The oscillator phase accumulators deliberately
// do NOT: those are PITCH, and a tempo change must not transpose the tone.
combined_scale = speed_scale_current * rate_value_drift_mult * host_scale;

// Fade In / Out drift + Speed Ramp (targets 9, 10) → effective fade
// fractions for this sample, clamped to [0,1] and renormalized if they'd
// sum past 1 (same guard as @slider's static fractions).
eff_fade_in_frac  = max(0, min(1, (fade_in_pct  + target_drift_offset[1]  + speed_ramp_ramp_t_mem[1]  * speed_ramp_by_mem[1])  / 100.0));
eff_fade_out_frac = max(0, min(1, (fade_out_pct + target_drift_offset[2]  + speed_ramp_ramp_t_mem[2]  * speed_ramp_by_mem[2])  / 100.0));
// Targets added 2026-09-10, each applied only while its offset is, or just
// was, non-zero.
function tone_off(t) ( target_drift_offset[t] + speed_ramp_ramp_t_mem[t] * speed_ramp_by_mem[t]; );
to3 = tone_off(3); to5 = tone_off(5); to38 = tone_off(38); to39 = tone_off(39);
(to3 != 0 || to3_was) ? pulse_duty = max(0.01, min(0.99, pulse_duty_base + to3 * 0.01));
to3_was = to3 != 0;
tref_mult = to5 != 0 ? max(20, tuning_ref + to5) / tuning_ref : 1;
(to38 != 0 || to39 != 0 || to38_was) ? (
  play_for_cycles = max(0, floor(pf_base + to38 + 0.5));
  rest_for_cycles = max(0, floor(rf_base + to39 + 0.5));
  pr_enabled = play_for_cycles > 0 && rest_for_cycles > 0;
);
to38_was = to38 != 0 || to39 != 0;
eff_fade_in_frac + eff_fade_out_frac > 1.0 ? (
  tf = eff_fade_in_frac + eff_fade_out_frac;
  eff_fade_in_frac  /= tf;
  eff_fade_out_frac /= tf;
);

start_delay_elapsed < start_delay_sec ? (
  // * host_scale so the delay is counted in the SAME time base as the cycle
  // lengths. start_delay_sec is derived from base_rate_hz, which in Host x is
  // NOMINAL, so a wall-clock counter here would make "8 cycles" mean 8 nominal
  // cycles and the delay would be wrong by exactly the tempo ratio while every
  // other timing was right. That is the bug Melody Phase shipped, and its
  // symptom is nasty precisely because it is partial. host_scale is 1 in
  // BPM / Seconds / Hz, so those are unchanged.
  start_delay_elapsed += host_scale / srate;
  spl0 = 0;
  spl1 = 0;
) : (

// First-load init: place oscillators before any sweeping begins.
// Never triggered by slider changes — oscillators keep running through all parameter edits.
needs_init ? (
  i = 0;
  loop(8,
    root_in_window = v_root[i];
    root_in_window < pitch_lo ? root_in_window *= pow(2, ceil(log(pitch_lo / root_in_window) / log(2)));
    root_in_window > pitch_hi ? root_in_window *= pow(2, -ceil(log(root_in_window / pitch_hi) / log(2)));

    placed_pc[i] = v_note[i] + root_note;
    o = 0;
    loop(NUM_OSC,
      oi = i * NUM_OSC + o;
      o < num_osc ? (
        f = root_in_window * pow(2, o);
        f > pitch_hi ? f *= pitch_lo / pitch_hi;
      ) : (
        f = pitch_lo; // park extra slots at bottom — gain=0 there, silent
      );
      osc_freq[oi]    = f;
      osc_phase_l[oi] = 0;
      osc_phase_r[oi] = 0;
      osc_gain[oi]    = 0;
      o += 1;
    );
    i += 1;
  );
  placed_ref = tuning_ref;
  needs_init = 0;
);
// A Tuning reference change scales every oscillator, so it acts at once.
tuning_ref != placed_ref ? (
  tr_ratio = tuning_ref / max(placed_ref, 0.001);
  i = 0; loop(8 * NUM_OSC, osc_freq[i] *= tr_ratio; i += 1; );
  placed_ref = tuning_ref;
);

// Play/Rest gate: advance the cycle counter and flip pr_resting at
// thresholds. base_rate_hz / srate is fractional cycles per sample,
// using the master Rate Value clock regardless of drift_mode (so
// the gate timing matches what Start Delay would do at the same
// Rate Value setting).
pr_enabled ? (
  pr_cycle_progress += base_rate_hz * combined_scale / srate;
  !pr_resting ? (
    pr_cycle_progress >= play_for_cycles ? (
      pr_resting = 1;
      pr_cycle_progress = 0;
    );
  ) : (
    pr_cycle_progress >= rest_for_cycles ? (
      pr_resting = 0;
      pr_cycle_progress = 0;
    );
  );
);

// in_frozen_rest is the Freeze-mode-and-resting condition. Used
// below to gate oscillator frequency and phase advancement, so
// Freeze mode literally pauses the glissando. In Walk mode this
// stays false and oscillators keep sweeping during rest (just
// silently, via the target_gain = 0 branch).
in_frozen_rest = pr_enabled && pr_resting && rest_mode == 1;

out_l = 0;
out_r = 0;
active_count = 0;

i = 0;
loop(8,
  v_active[i] ? (
    active_count += 1;

    // Per-voice drift + Speed Ramp offset (targets 1-8). This offset is
    // MODE-AWARE, matching what the per-voice slider itself controls:
    //   Independent mode → the voice's own RATE (offset applied here as a
    //     rate multiplier on shep_rate[i], via the rate_to_hz ratio so
    //     BPM/Hz/Seconds mode-direction is handled).
    //   Synced mode → the voice's CENTS detune (all voices share the global
    //     sweep rate, so the offset must NOT touch rate — that would break
    //     sync and behave like Independent mode. It's applied as cents in the
    //     detune block below instead; keep the rate multiplier at unity here).
    // A note change moves this voice's oscillators by the interval and wraps
    // them into the window: the set a fresh start at the new note would place.
    v_note[i] + root_note != placed_pc[i] ? (
      nc_ratio = pow(2, (v_note[i] + root_note - placed_pc[i]) / 12);
      o = 0;
      loop(NUM_OSC,
        oi = i * NUM_OSC + o;
        osc_freq[oi] *= nc_ratio;
        loop(4, osc_freq[oi] > pitch_hi ? osc_freq[oi] *= pitch_lo / pitch_hi; );
        loop(4, osc_freq[oi] < pitch_lo ? osc_freq[oi] *= pitch_hi / pitch_lo; );
        o += 1;
      );
      placed_pc[i] = v_note[i] + root_note;
    );
    voff = tone_off(7 + 4 * i);   // this voice's Rate
    vfine = v_fine[i] + tone_off(6 + 4 * i);
    // Fine tune in its unit, and a drifting Tuning reference, applied as the
    // oscillator is read, so the octave fade stays where it is.
    vratio = fine_unit == 1 ? pow(2, vfine / 12) : fine_unit == 2 ? pow(2, vfine / 1200.0) : 1;
    vhz    = fine_unit == 0 ? vfine : 0;
    vmod   = vfine != 0 || tref_mult != 1;
    (drift_mode == 1 && voff != 0) ? (
      vbase    = max(v_rate[i], 0.001);
      vbase_hz = rate_to_hz(vbase, rate_mode);
      // Host x adds in the Hz domain, for the same reason as the master rate
      // above. This one is per voice, so getting it wrong would have made the
      // voices drift against each other in the wrong direction.
      rate_mode >= 3 ? (
        v_rate_mult = max(vbase_hz + host_bpm_delta(voff), 0.0001) / max(vbase_hz, 0.0001);
      ) : (
        v_rate_mult = rate_to_hz(vbase + voff, rate_mode) / max(vbase_hz, 0.0001);
      );
    ) : (
      v_rate_mult = 1.0;
    );

    freq_mul = pow(2, shep_rate[i] * combined_scale * v_rate_mult / srate);

    // Cosine-law pan: negative = left, positive = right
    // Pan is drift/ramp target 19+i, added in its own unit and clamped to the
    // control's own range so a big wander cannot push past hard left/right.
    eff_pan = max(-100, min(100, v_pan[i] + (target_drift_offset[9 + 4 * i] + speed_ramp_ramp_t_mem[9 + 4 * i] * speed_ramp_by_mem[9 + 4 * i])));
    pan_pos = (eff_pan / 100.0 + 1.0) * 0.5; // 0=full left, 0.5=center, 1=full right
    pan_l   = cos(pan_pos * $pi * 0.5);
    pan_r   = sin(pan_pos * $pi * 0.5);

    o = 0;
    loop(num_osc,
      oi = i * NUM_OSC + o;

      // Sweep oscillator frequency along the glissando, unless we
      // are in Freeze-mode rest — in that case the frequency stays
      // pinned so the tone resumes from the exact same position.
      !in_frozen_rest ? (
        v_dir[i] == 0 ? (
          osc_freq[oi] *= freq_mul;
          osc_freq[oi] > pitch_hi ? osc_freq[oi] *= pitch_lo / pitch_hi;
        ) : (
          osc_freq[oi] /= freq_mul;
          osc_freq[oi] < pitch_lo ? osc_freq[oi] *= pitch_hi / pitch_lo;
        );
      );

      // Per-voice detune (synced mode only — cents). The per-voice drift +
      // Speed Ramp offset (voff) IS a cents wander in synced mode, so add it
      // to the static slider cents here. (In Independent mode voff drives rate
      // above and there is no cents detune.)
      freq_l = vmod ? osc_freq[oi] * tref_mult * vratio + vhz : osc_freq[oi];
      // The binaural beat is target 27, in Hz.
      freq_r = freq_l + max(0, binaural_hz + (target_drift_offset[4] + speed_ramp_ramp_t_mem[4] * speed_ramp_by_mem[4]));

      // Target gain — bell window position, unless Play/Rest is
      // resting (Walk OR Freeze mode), in which case force 0 and
      // let the existing smoother fade audio out.
      pr_enabled && pr_resting ? (
        target_gain = 0;
      ) : (
        lf = log(osc_freq[oi]);
        // Gain is target 11+i, and it drifts in dB -- the unit the control is in.
        eff_gain_lin = pow(10, (v_gain_db[i] + (target_drift_offset[8 + 4 * i] + speed_ramp_ramp_t_mem[8 + 4 * i] * speed_ramp_by_mem[8 + 4 * i])) / 20.0);
        target_gain = window_gain(lf, log_pitch_lo, log_pitch_range, eff_fade_in_frac, eff_fade_out_frac) * eff_gain_lin;
      );
      osc_gain[oi] = osc_gain[oi] * smooth + target_gain * (1 - smooth);

      // Advance phases, unless Freeze-mode rest is pinning them so
      // the waveform resumes at the same phase on rest exit.
      !in_frozen_rest ? (
        osc_phase_l[oi] += freq_l / srate;
        osc_phase_l[oi] >= 1 ? osc_phase_l[oi] -= 1;
        osc_phase_r[oi] += freq_r / srate;
        osc_phase_r[oi] >= 1 ? osc_phase_r[oi] -= 1;
      );

      out_l += wave_sample(osc_phase_l[oi], freq_l / srate) * osc_gain[oi] * pan_l;
      out_r += wave_sample(osc_phase_r[oi], freq_r / srate) * osc_gain[oi] * pan_r;

      o += 1;
    );
  );
  i += 1;
);

active_count > 0 ? (
  norm = 1.0 / (active_count * num_osc);
  spl0 = out_l * norm;
  spl1 = out_r * norm;
) : (
  spl0 = 0;
  spl1 = 0;
);

);  // close start-delay else branch


@serialize
// Persist per-target drift AND speed-ramp configurations. Without this,
// only the most-recently-edited target's values survive a save/load because
// the sliders hold whichever target was selected at save time.
//
// VERSION-GUARDED (CLAUDE.md @serialize gotcha): leads with a magic marker so
// format changes degrade to defaults instead of scrambling. Magic bumped to
// 2100000 + N_TARGETS in v2.14 when Speed Ramp went PER-TARGET timeline (added
// the duration + start-delay banks); an older 2000000-base blob won't match
// and falls through to @init defaults (drift + ramp reset — acceptable, this
// is pre-release). Marker is well above any plausible first-field value and
// float32-exact (< 2^24).
// 2026-09-06: four per-target banks added (Drift play/rest, Ramp play/rest), so
// the magic bumps and the READ accepts BOTH. A bump rather than a bare append,
// because appending would let an older blob's trailing bytes land in the new
// banks -- "migrate what was RESTORED, never what was DEFAULTED". Gated on
// "this blob HAS the field", so an older blob keeps its Drift and Ramp config
// and leaves the new banks at @init's zeros, which is off.
sr_magic = 2300000 + N_TARGETS;
file_var(0, sr_magic);
sr_magic == 2300000 + N_TARGETS ? (
  file_mem(0, target_drift_up,     N_TARGETS);
  file_mem(0, target_drift_down,   N_TARGETS);
  file_mem(0, target_drift_per,    N_TARGETS);
  file_mem(0, target_drift_shape,  N_TARGETS);
  file_var(0, last_target_select);
  file_mem(0, speed_ramp_by_mem,    N_TARGETS);
  file_mem(0, speed_ramp_dur_mem,   N_TARGETS);
  file_mem(0, speed_ramp_delay_mem, N_TARGETS);
  file_var(0, last_sr_target);
  1 ? (
    file_mem(0, drift_play_mem, N_TARGETS);
    file_mem(0, drift_rest_mem, N_TARGETS);
    file_mem(0, sr_play_mem,    N_TARGETS);
    file_mem(0, sr_rest_mem,    N_TARGETS);
  );

  // TRACK-DUPLICATE FIX (v2.14). On READ (load/duplicate), file_avail(0) >= 0;
  // on WRITE (save/undo) it is < 0. @serialize is the ONLY section guaranteed
  // to run on both load AND duplicate (on duplicate @init may not re-run at
  // all — memory is copied), so it is the authoritative place to re-establish
  // the bank<->slider invariant. The hazard: @slider's nested-selector "load"
  // branch can run while the bank is momentarily empty and write
  // slider = bank[selected] = 0, which then propagates back into the bank,
  // zeroing whichever target was selected. Here, right after restoring the
  // banks, we force the visible config sliders to match the restored bank for
  // the restored selectors, so any transient @slider clobber is corrected and
  // the invariant "visible slider == bank[selected]" holds again.
  file_avail(0) >= 0 ? (
    slider83 = speed_ramp_by_mem[last_sr_target];       // Speed ramp `by`
    slider85 = speed_ramp_dur_mem[last_sr_target];      // Speed ramp duration
    slider89 = speed_ramp_delay_mem[last_sr_target];    // Speed ramp start delay
    slider75 = target_drift_up[last_target_select];     // Drift up
    slider76 = target_drift_down[last_target_select];   // Drift down
    slider77 = target_drift_per[last_target_select];    // Drift period
    slider79 = target_drift_shape[last_target_select];  // Drift shape
    // The four new per-target sliders need this exactly as much as the ones
    // above -- they are backed by live sliders, so they are what a transient
    // @slider can clobber to zero on a track duplicate.
    slider86 = sr_play_mem[last_sr_target];
    slider87 = sr_rest_mem[last_sr_target];
    slider80 = drift_play_mem[last_target_select];
    slider81 = drift_rest_mem[last_target_select];
    sliderchange(-1);  // refresh the UI display for the sliders set above
  );
);


@gfx 0 0
// Empty — present only to fix REAPER 7.x FX dialog slider display regression
// where sliders 1-5 are hidden when a plugin has no @gfx block.
