desc: Sweep Dwell Filter
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/

slider1:500<20,20000,1>Frequency Low Hz
slider2:5000<20,20000,1>Frequency High Hz
slider3:4<0.001,60,0.001>High Dwell sec
slider4:6<0.001,60,0.001>Low Dwell sec
slider5:1<0.001,30,0.001>Fade Down sec
slider6:1<0,3,1{Linear,Cosine,Logarithmic,Exponential}>Fade Down Shape
slider7:1<0.001,30,0.001>Fade Up sec
slider8:1<0,3,1{Linear,Cosine,Logarithmic,Exponential}>Fade Up Shape
slider9:0.7<0,1,0.01>Resonance
slider10:1<0,1,0.01>Wet/Dry Mix
slider11:0<-180,180,0.1>Stereo Phase Offset degrees
slider12:0<0,1,1{Independent L+R,Offset from L}>Phase Mode
// ===== PAN BLOCK SLIDERS START =====
slider13:0<0,1,1{Off,On}>Pan Enabled
slider14:0<0,12,1{Mono,Alternating,Alternating (Flipped),Distributed,Distributed (Flipped),Distributed (Ping-pong),Converging,Converging (Ping-pong),Diverging,Diverging (Ping-pong),Pan Sweep,Pan Sweep (Flipped),Linked Sweep}>Pan Mode
slider15:1<0,1,0.01>Pan Spread (0=mono, 1=full)
slider16:5<0,100,0.1>Pan Glide ms (0=instant)
slider17:8<2,32,1>Cycle Steps (per-cycle modes)
slider18:2<0.001,1000,0.001>Pan Sweep Rate
// NOTE: this enum is {Hz,Seconds,BPM} — Seconds is index 1 here, but other
// plugins in the suite order it {BPM,Seconds,Hz} and resonance_bank uses
// {BPM,Hz,Seconds}. Key these branches by NAME, never by index; keying by
// index is what put Start Delay 60x out in Tremolo and the sweeping filter.
// Host x appended at the END (index 3) so saved values 0-2 are untouched.
slider19:0<0,3,1{Hz,Seconds,BPM,Host x}>Pan Sweep Rate Unit
slider20:1<0.125,8,0.125>Filter Speed Multiplier (Linked Sweep)

// Named picker for the Linked Sweep multiplier, same idea as Host ratio: the
// raw control is a MULTIPLIER with 0.125 steps, so asking for half speed means
// typing 0.5 and a quarter means 0.25 -- exposed decimals for something you
// could just name. Entries are labelled by what you HEAR, never as note values.
// Only ratios that land on the 0.125 grid are offered (no "every 3 cycles",
// since a third isn't representable there).
// Writes the multiplier on change then gets out of the way; "Custom" (default)
// never writes, and is what a project saved before this slider existed lands
// on, so nothing already tuned by hand is touched.
slider41:0<0,8,1{Custom,every 8 cycles,every 4 cycles,every 2 cycles,same as filter,2 per cycle,3 per cycle,4 per cycle,8 per cycle}>Pan speed (Linked Sweep)
// ===== PAN BLOCK SLIDERS END =====

// Pass-through for N seconds after playback starts, then apply the
// sweep-dwell filter + pan effect normally. As an EFFECT plugin the
// dry signal passes through during the delay. Re-arms on every
// transport stop/start. 0 disables the delay.
slider21:0<0,1000,0.001>Start Delay (seconds)

// Per-cycle Play/Rest gate. Effect is applied normally for N
// cycles, then enters its rest period for M cycles, then resumes
// — repeats forever. One "cycle" is one full dwell pattern (High
// Dwell + Fade Down + Low Dwell + Fade Up). So with the default
// settings (4 + 1 + 6 + 1 = 12 sec/cycle), "Play for = 4" plays
// 48 seconds of the sweep before entering rest. The LFO at rest /
// Output at rest sliders below pick what happens during rest.
// 0 in either slider disables the gate. Resets on every transport
// stop/start.
slider22:0<0,1000,1>Play for (cycles)
slider23:0<0,1000,1>Rest for (cycles)

// What the LFOs do during the rest period.
//   Walk through (default) — filter dwell LFO and pan LFOs keep
//     cycling during rest. When the effect resumes, the LFOs are
//     at new positions reflecting wall-clock time passed.
//   Freeze in place — LFO phases pause, frozen at their values at
//     rest entry. When the effect resumes, the cutoff picks up
//     from the same position. The dwell pattern pauses and
//     resumes in lockstep with the gate.
slider24:0<0,1,1{Walk through,Freeze in place}>LFO at rest

// What the output does during the rest period.
//   Pass-through (default) — dry signal passes through unchanged
//     (matches Start Delay's behavior).
//   Silence — wet+dry mix smooths to 0; audio fades into silence
//     instead of passing dry. Useful when you want the gate to
//     act like a hard mute rather than a filter bypass.
slider25:0<0,1,1{Pass-through,Silence}>Output at rest

// Speed ramp: nested-selector pattern matching Womb v3 / breath_gen.
// Pick a target (one of the 4 dwell sliders), set a signed `by`
// amount in seconds; that dwell phase's length ramps from its
// baseline toward `baseline + by` over the duration. All 4 targets
// ramp in parallel; the selector just changes which one's amount
// you're editing. Engage is a freeze/resume gate (NOT a restart
// edge); only transport play resets ramp_t.
//
// Migration from v2.7: slider 26 changed from multiplier (0.1-4.0)
// to a 4-option target selector. Old projects' multiplier value
// rounds down to a selector index, and slider 29 (the new `by`)
// defaults to 0 — so Speed Ramp produces no effect on reload until
// reconfigured.
slider26:0<0,5,1{High dwell,Fade down,Low dwell,Fade up,Pan Sweep Rate,Resonance}>Speed ramp target
slider27:0<0,60,0.1>Speed ramp duration (minutes)
slider28:0<0,1,1{Off,On}>Speed ramp engage
slider29:0<-60,60,0.001>Speed ramp by (units match target)

// Per-target drift: nested-selector pattern matching Womb v3 / the
// rest of the v2.9 sweep. Pick a target (slider30), then sliders 31-34
// hold THAT target's drift config. Switching the selector saves
// current values to the old target's memory slot and loads the new
// target's values into the sliders. All 6 targets drift in parallel;
// the selector just chooses which one you're currently editing.
//
// Targets:
//   High dwell      — wanders the high-dwell phase length (seconds).
//   Fade down       — wanders the fade-down phase length (seconds).
//   Low dwell       — wanders the low-dwell phase length (seconds).
//   Fade up         — wanders the fade-up phase length (seconds).
//   Pan Sweep Rate  — wanders the Pan Sweep Rate (pan modes 10/11 only).
//   Resonance       — wanders the filter resonance (0-1).
//
// The four dwell targets match the Speed Ramp targets above and use
// the same selector indices — handy for configuring a coordinated
// drift + ramp on the same dwell phase. Drift on the dwell phases is
// ADDITIVE in seconds (like the Speed Ramp `by`), composing at the
// same consumption site.
//
// Period unit is dwell patterns (one full High + Fade Down + Low +
// Fade Up cycle) for ALL targets, scaled by Speed Ramp. For slow
// wall-clock-feel drift, set a long period.
//
// Up/Down amount is in the target's natural unit: seconds for the four
// dwell phases, the Pan Sweep Rate's unit for Pan Sweep Rate, a 0-1
// fraction for Resonance. The 0-100 range covers all; Resonance uses
// the low end (e.g. 0.3).
//
// Migration from v2.8: the old flat drift block (musical_up/down/
// period, slow_up/down/period, drift_shape on sliders 30-36) was 7
// sliders covering the whole dwell period. v2.9 is 5 sliders covering
// 6 independent targets, reusing slider IDs 30-34; sliders 35 and 36
// are no longer declared. Old projects' slider values get reinterpreted
// (selector defaults to High dwell; non-zero amounts on 31-32 produce
// drift on the High dwell phase). Reset drift sliders to defaults after
// upgrade and reconfigure.
slider30:0<0,5,1{High dwell,Fade down,Low dwell,Fade up,Pan Sweep Rate,Resonance}>Drift target
slider31:0<0,100,0.01>Drift up amount (units match target)
slider32:0<0,100,0.01>Drift down amount (units match target)
slider33:8<1,1000,1>Drift period (cycles)
slider34:0<0,2,1{Sine,Triangle,Random}>Drift shape

// Speed ramp start delay (lives here because slider 29 took the
// post-engage slot for the new `by` amount).
slider37:0<0,60,0.1>Speed ramp start delay (minutes)

// Host tempo sync for the dwell cycle.
//   Own durations (default) — the four dwell sliders are literal seconds,
//     exactly as before. Existing projects are untouched.
//   Host x — the four dwell sliders keep their PROPORTIONS but the whole
//     cycle is stretched to Cycle length (beats) at the project tempo.
//     Defaults 4+1+6+1 at 12 beats = the same shape, now beat-locked.
// Consequences worth knowing, both documented on the plugin page:
//   - Drift period (slider33) is counted in cycles, so it follows too.
//   - Drift / Speed Ramp on the four dwell phases become SHAPE controls in
//     Host x: they still shift the balance between high, fade and low, but
//     the total cycle length stays pinned to the tempo.
//   - Start Delay (slider21) stays literal seconds. It is labelled seconds
//     and is a "wait before the effect arrives" control, not musical pacing.
slider38:0<0,1,1{Own durations,Host x}>Cycle mode
slider39:12<0.25,128,0.25>Cycle length (beats)

// How the cycle length is arrived at, in Host x.
//   Fit to durations (default) — the cycle is however long the four dwell
//     sliders ADD UP TO, in beats. So each of the four IS a beat count: type
//     2 into Fade Down and the fade is two beats. Nothing to add up, nothing
//     to convert. This is the plugin's native model (it was born with no rate
//     slider at all — four times whose sum is the cycle) simply expressed in
//     beats instead of seconds, and it's the envelope family's convention.
//   Set in beats — the cycle is pinned to Cycle length (beats) and the four
//     durations act as PROPORTIONS filling it. The LFO family's convention:
//     a fixed shape squeezed into a fixed number of beats.
// Fit uses the four SLIDER values, never the drifted ones, so Drift and Speed
// Ramp still only move the shape and can't make the cycle wander in length.
slider40:0<0,1,1{Fit to durations,Set in beats}>Cycle length mode

// --- Slope, and an honest frequency axis -------------------------------------
// This plugin used to be a fixed two-pole Kellett cascade -- two one-pole
// sections with a resonance feedback path -- whose cutoff coefficient was
// `cut = 2*fc/srate`. That is the standard musicdsp idiom for it and it is
// approximately right at low frequencies, but measured, the real -3 dB corner
// landed at 0.21x to 0.77x the number on the slider, DEPENDING ON RESONANCE:
// at "500 Hz" the corner sat at 103 Hz with Resonance down and 382 Hz with it
// up. So Frequency Hz was never Hz, and Resonance was secretly a second
// frequency control -- sweeping it 0 to 1 moved the corner nearly two octaves.
//
// Replaced with a Butterworth cascade of TPT (zero-delay-feedback) state
// variable sections, 1 to 6 of them, which fixes both and adds the slope
// control this plugin never had. Each section gets its OWN Q from the pole
// angle formula, which is what puts -3 dB exactly on the number at every slope;
// cascading identical sections instead would slide the corner down by
// sqrt(2^(1/N)-1) and the label would drift further from the truth the steeper
// you went. Resonance is spread across the sections rather than applied to
// each, because peaks add in dB -- six mild ones would stack into a wall.
//
// Existing projects are migrated by tools/sweepfilter_migrate_hz.py, which
// rewrites each instance's Frequency Low/High so the real corner lands where it
// used to. The numbers change a lot; the sound does not.
slider42:0<0,5,1{-12,-24,-36,-48,-60,-72}>Slope (dB/oct)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: REAPER re-runs @init on every transport play / render
// start, resetting all runtime for free (dwell LFO phases, filter state +
// cutoff smoothers, pan state, drift runtime, Speed Ramp, Start Delay,
// Play/Rest + effect mix). Only the drift + Speed Ramp CONFIG banks must
// survive the re-run; they're guarded by drift_cfg_inited below.

phase_l = 0;
phase_r = 0;
// (n3/n4/rn3/rn4 were the old Kellett core's state; the cascade keeps its
//  own in svf_l/svf_r, cleared with the memset above.)

// Host tempo, refreshed every block. Seeded here so the first @sample after
// a transport start has a sane value even before @block has run once.
// ABSOLUTE, never a ratio against a remembered reference tempo — @init
// re-runs on every transport play and would wipe the reference.
host_bpm = max(tempo, 0.001);

// Transport-position seeds, so the first @sample after a play has defined
// values even before @block has run once. Nothing is remembered across
// transport — all three are rewritten every block.
host_beat_pos   = beat_position;
host_pos_locked = 0;
blk_sample      = 0;

// Seeded in HZ now, not as a coefficient -- a 0.1 here used to mean a
// harmless 0.1 coefficient and would now mean 0.1 Hz, i.e. an audible
// ramp up from silence on every load.
cut_smooth_l = cut_smooth_r = max(20, slider1);

// ===== PAN BLOCK INIT START =====
pan_l           = 0;
pan_l_smooth    = 0;
pan_cycle_index = 0;
pan_cycle_dir   = 1;
last_phase_l    = 0;
pan_phase       = 0;
// ===== PAN BLOCK INIT END =====


function apply_curve(t, shape) (
  shape == 0 ? t :
  shape == 1 ? 0.5 - 0.5 * cos(t * $pi) :
  shape == 2 ? log(1 + 9*t) / log(10) :
               (10^t - 1) / 9
);

function calc_lfo(ph, high_secs, low_secs, fade_down_secs, fade_up_secs, fade_down_shape, fade_up_shape)
local(period, high_frac, fade_down_frac, low_frac, fade_up_frac, t, result) (
  period         = high_secs + fade_down_secs + low_secs + fade_up_secs;
  high_frac      = high_secs / period;
  fade_down_frac = fade_down_secs / period;
  low_frac       = low_secs / period;
  fade_up_frac   = fade_up_secs / period;
  ph < high_frac ? (
    result = 1;
  ) :
  ph < high_frac + fade_down_frac ? (
    fade_down_frac > 0.0001 ? (
      t = (ph - high_frac) / fade_down_frac;
      result = 1 - apply_curve(t, fade_down_shape);
    ) : (result = 0);
  ) :
  ph < high_frac + fade_down_frac + low_frac ? (
    result = 0;
  ) : (
    fade_up_frac > 0.0001 ? (
      t = (ph - high_frac - fade_down_frac - low_frac) / fade_up_frac;
      result = apply_curve(t, fade_up_shape);
    ) : (result = 1);
  );
  result
);

// ===== PAN BLOCK FUNCTIONS START =====
function percycle_pan(idx, n_steps) local(steps, step, pos) (
  n_steps = max(n_steps, 1);
  steps   = max(ceil((n_steps - 1) / 2.0), 1);

  pan_mode == 0 ? (
    pos = 0;
  ) : pan_mode == 1 ? (
    pos = (idx % 2 == 0) ? -1 : 1;
  ) : pan_mode == 2 ? (
    pos = (idx % 2 == 0) ? 1 : -1;
  ) : pan_mode == 3 ? (
    n_steps > 1 ? (pos = (idx % n_steps) / (n_steps - 1.0) * 2.0 - 1.0) : (pos = 0);
  ) : pan_mode == 4 ? (
    n_steps > 1 ? (pos = 1.0 - (idx % n_steps) / (n_steps - 1.0) * 2.0) : (pos = 0);
  ) : pan_mode == 5 ? (
    n_steps > 1 ? (pos = idx / (n_steps - 1.0) * 2.0 - 1.0) : (pos = 0);
  ) : pan_mode == 6 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = -1.0;
    ) : (
      step = ceil((idx + 1) / 2);
      pos = (idx % 2 == 1) ?  (1.0 - (step - 1.0) / steps)
                            : -(1.0 - (step - 1.0) / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : pan_mode == 7 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = -1.0;
    ) : (
      step = ceil((idx + 1) / 2);
      pos = (idx % 2 == 1) ?  (1.0 - (step - 1.0) / steps)
                            : -(1.0 - (step - 1.0) / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : pan_mode == 8 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = 0.0;
    ) : (
      step = floor((idx + 1) / 2);
      pos = (idx % 2 == 1) ? -(step / steps)
                            :  (step / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : pan_mode == 9 ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = 0.0;
    ) : (
      step = floor((idx + 1) / 2);
      pos = (idx % 2 == 1) ? -(step / steps)
                            :  (step / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : (
    pos = 0;
  );

  pos * pan_spread
);
// ===== PAN BLOCK FUNCTIONS END =====

// Start Delay state.
last_play_state     = 0;
start_delay_elapsed = 0;
start_delay_sec     = 0;

// Play/Rest gate state. Same per-cycle counter + effect_mix design
// used in the other effect plugins. effect_mix smoothly transitions
// between 1 (effect on) and 0 (rest target — either dry pass-through
// or silence, picked by Output at rest).
pr_resting        = 0;
pr_cycle_progress = 0;
play_for_cycles   = 0;
rest_for_cycles   = 0;
pr_enabled        = 0;
rest_lfo_mode     = 0;
rest_output_mode  = 0;
effect_mix        = 1;

// Speed ramp state.
// Speed Ramp state. Engage (global) is a freeze/resume gate; only transport
// play resets the per-target ramp clocks. As of v2.14 the ramp is PER-TARGET:
// each target has its own `by`, duration, start delay, and progress clock.
N_SPEED_TARGETS              = 6;   // v2.14: extended 4 -> 6 to match drift (added Pan Sweep Rate, Resonance)
speed_ramp_target_value_mem  = 4096;  // signed `by` per target (CONFIG)

// --- v2.9 Drift target memory banks ---
//
// 6 targets × 8 fields. Each array is 16-slot-spaced so targets can
// grow to 16 later. Speed ramp bank uses 4 slots at 4096; drift banks
// start at 4112 to keep the 16-slot alignment.
//
// Targets:
//   0 = High dwell      (units: seconds)
//   1 = Fade down       (units: seconds)
//   2 = Low dwell       (units: seconds)
//   3 = Fade up         (units: seconds)
//   4 = Pan Sweep Rate  (units: Pan Sweep Rate's unit; modes 10/11 only)
//   5 = Resonance       (units: 0-1 fraction)
N_TARGETS = 6;
target_drift_up     = 4112;
target_drift_down   = 4128;
target_drift_per    = 4144;
target_drift_shape  = 4160;
target_drift_phase  = 4176;
target_drift_prev   = 4192;
target_drift_curr   = 4208;
target_drift_offset = 4224;

// Speed ramp per-target timeline banks (v2.14). duration + start-delay are
// CONFIG (survive transport, restored by @serialize); ramp_t + delay_elapsed
// are RUNTIME (reset every @init / transport play).
speed_ramp_dur_mem           = 4240;  // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 4256;  // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 4272;  // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 4288;  // delay sample counter per target (RUNTIME)

// CONFIG banks (drift up/down/period/shape + the Speed Ramp by/duration/
// start-delay banks + selector trackers) — guarded by drift_cfg_inited so the
// @init re-run on every transport play (Path A render fix, no ext_noinit) does
// NOT wipe the user's setup. @serialize restores saved configs on reload.
drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_SPEED_TARGETS,
    speed_ramp_target_value_mem[i] = 0;
    speed_ramp_dur_mem[i]          = 0;
    speed_ramp_delay_mem[i]        = 0;
    i += 1;
  );
  last_speed_target = 0;
  i = 0;
  loop(N_TARGETS,
    target_drift_up[i]    = 0;
    target_drift_down[i]  = 0;
    target_drift_per[i]   = 8;
    target_drift_shape[i] = 0;
    i += 1;
  );
  last_target_select = 0;
  drift_cfg_inited = 1;
);

// Drift + speed-ramp RUNTIME resets on EVERY @init (every transport play).
i = 0;
loop(N_SPEED_TARGETS,
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  i += 1;
);
i = 0;
loop(N_TARGETS,
  target_drift_phase[i]  = 0;
  target_drift_prev[i]   = 0;
  target_drift_curr[i]   = 0;
  target_drift_offset[i] = 0;
  i += 1;
);


// --- Butterworth cascade state. Two words per section, per channel, plus the
//     per-section damping table (1/Q). ---
FILT_MAXSTAGES = 6;                       // 6 x 2 poles = 72 dB/oct
FILT_RES_DB_MAX = 34;                     // total emphasis Resonance = 1 asks for
                                          // (34, not 24: the retired core hit ~+29 dB
                                          //  at Resonance 0.98 and migrated projects
                                          //  need to be representable)
svf_l  = 4400;
svf_r  = 4400 + 2*FILT_MAXSTAGES;
svf_qb = 4400 + 4*FILT_MAXSTAGES;     // 1/Q per section
memset(4400, 0, 5*FILT_MAXSTAGES);

@slider

freq_lo         = min(slider1, slider2);
freq_hi         = max(slider1, slider2);
high_secs       = slider3;
low_secs        = slider4;
fade_down_secs  = slider5;
fade_down_shape = slider6;
fade_up_secs    = slider7;
fade_up_shape   = slider8;
resonance       = slider9;
wet             = slider10;
dry             = 1 - wet;
phase_offset    = slider11 / 360;

cycle_mode      = slider38;
cycle_len_mode  = slider40;
// Fit mode: the cycle is the sum of the four dwell sliders, so each of them
// is a beat count directly. Raw slider values on purpose — see slider40.
cycle_beats     = cycle_len_mode == 0
                    ? max(slider3 + slider5 + slider4 + slider7, 0.001)
                    : max(slider39, 0.001);
slider_show(slider39, cycle_mode == 1 && cycle_len_mode == 1);
slider_show(slider40, cycle_mode == 1);

// ===== PAN BLOCK SLIDER READ START =====
pan_enabled     = slider13;
pan_mode        = slider14;
pan_spread      = slider15;
pan_glide_ms    = slider16;
pan_cycle_steps = slider17;
pan_sweep_val   = slider18;
pan_sweep_mode  = slider19;
pan_sweep_ratio = slider20;

slider_show(slider14, pan_enabled);
slider_show(slider15, pan_enabled);
slider_show(slider16, pan_enabled);
slider_show(slider17, pan_enabled && pan_mode >= 1 && pan_mode <= 9);
slider_show(slider18, pan_enabled && (pan_mode == 10 || pan_mode == 11));
slider_show(slider19, pan_enabled && (pan_mode == 10 || pan_mode == 11));
// Linked Sweep pan-speed picker. Adopt-on-load so opening a project never
// overwrites a hand-set multiplier; writes only on a real change.
!pan_speed_inited ? ( pan_speed_sel = slider41; pan_speed_inited = 1; );
pan_speed_sel != slider41 ? (
  pan_speed_sel = slider41;
  pan_speed_sel > 0 ? (
    slider20 =
      pan_speed_sel == 1 ? 0.125 : pan_speed_sel == 2 ? 0.25 :
      pan_speed_sel == 3 ? 0.5   : pan_speed_sel == 4 ? 1    :
      pan_speed_sel == 5 ? 2     : pan_speed_sel == 6 ? 3    :
      pan_speed_sel == 7 ? 4     : 8;
    slider_automate(slider20);
  );
);
slider_show(slider41, pan_enabled && pan_mode == 12);
// Hide the raw multiplier unless Custom -- the named list is the way in, and
// the number only appears when you deliberately want one the list lacks.
slider_show(slider20, pan_enabled && pan_mode == 12 && slider41 == 0);
// ===== PAN BLOCK SLIDER READ END =====

start_delay_sec = slider21;

// Play/Rest gate: integer cycle counts. Both must be > 0 for the
// gate to engage; 0 in either slider disables.
play_for_cycles = slider22;
rest_for_cycles = slider23;
new_pr_enabled  = (play_for_cycles > 0 && rest_for_cycles > 0);
// Defensive reset: if user disables the gate mid-rest, snap pr_resting
// back to 0 and zero the progress counter. effect_mix will smoothly
// ramp back to 1 via the @sample smoother.
!new_pr_enabled && pr_resting ? (
  pr_resting = 0;
  pr_cycle_progress = 0;
);
pr_enabled       = new_pr_enabled;
rest_lfo_mode    = slider24;
rest_output_mode = slider25;

// Speed Ramp target selector save/restore. slider26 = target; slider29 =
// per-target `by`; slider27 = per-target duration; slider37 = per-target start
// delay (all three per-target as of v2.14). slider28 (engage) stays GLOBAL.
// When the selector changes, save the three per-target sliders to the OLD
// slot, then load the NEW slot's stored values. Otherwise capture live edits.
sel_speed_target = slider26;
last_speed_target != sel_speed_target ? (
  speed_ramp_target_value_mem[last_speed_target] = slider29;
  speed_ramp_dur_mem[last_speed_target]          = slider27;
  speed_ramp_delay_mem[last_speed_target]        = slider37;
  slider29 = speed_ramp_target_value_mem[sel_speed_target];
  slider27 = speed_ramp_dur_mem[sel_speed_target];
  slider37 = speed_ramp_delay_mem[sel_speed_target];
  slider_automate(slider29);
  slider_automate(slider27);
  slider_automate(slider37);
  last_speed_target = sel_speed_target;
) : (
  speed_ramp_target_value_mem[sel_speed_target] = slider29;
  speed_ramp_dur_mem[sel_speed_target]          = slider27;
  speed_ramp_delay_mem[sel_speed_target]        = slider37;
);
// No engage-edge detection. Engage is a freeze/resume gate handled
// in @sample. Only transport play resets ramp_t.

// Drift target selector save/restore (nested-selector pattern).
// Switching slider30 saves sliders 31-34 into the OLD target's slot,
// then loads the NEW target's stored config into sliders 31-34.
// Otherwise captures live edits to the current target's slot. All 6
// targets drift in parallel from @sample regardless of selection.
sel_target = slider30;
sel_up     = slider31;
sel_down   = slider32;
sel_per    = slider33;
sel_shape  = slider34;

last_target_select != sel_target ? (
  target_drift_up[last_target_select]    = sel_up;
  target_drift_down[last_target_select]  = sel_down;
  target_drift_per[last_target_select]   = sel_per;
  target_drift_shape[last_target_select] = sel_shape;

  slider31 = target_drift_up[sel_target];
  slider32 = target_drift_down[sel_target];
  slider33 = target_drift_per[sel_target];
  slider34 = target_drift_shape[sel_target];
  slider_automate(slider31);
  slider_automate(slider32);
  slider_automate(slider33);
  slider_automate(slider34);

  last_target_select = sel_target;
) : (
  target_drift_up[sel_target]    = sel_up;
  target_drift_down[sel_target]  = sel_down;
  target_drift_per[sel_target]   = sel_per;
  target_drift_shape[sel_target] = sel_shape;
);


// --- Per-section Butterworth Q for the selected slope. Depends only on the
//     Slope slider, so it belongs here; the Resonance multiplier varies per
//     sample (it drifts) and is applied in @sample. ---
filt_stages = min(FILT_MAXSTAGES, slider42 + 1);
filt_order  = 2 * filt_stages;
filt_i = 0;
loop(filt_stages,
  // 1/Q directly, from the pole angle. Butterworth, 1930 -- textbook, no table.
  svf_qb[filt_i] = 2 * cos($pi * (2*filt_i + 1) / (2*filt_order));
  filt_i += 1;
);
// Resonance spread across the sections: the peak is the SUM of their dB.
filt_res_k = FILT_RES_DB_MAX / filt_stages * (log(10) / 20);

@block

// Project tempo, read once per block (it never changes mid-block, so polling
// it per sample would be wasted work). Absolute — see the note in @init.
host_bpm = max(tempo, 0.001);

// Transport POSITION, for phase-locking the cycle in Host x. Tempo sync sets
// the cycle's speed; this sets where in the cycle we are. Without it the
// pattern is the right length but starts wherever you pressed play, so the
// turnarounds land off the bar — which is what a tempo-synced effect is
// expected NOT to do. Deriving phase from the project position instead of
// accumulating also means it can't drift over a long session, and it survives
// seeking and looping for free.
//
// Only while the transport is actually moving (1 = playing, 5 = recording).
// Stopped or paused, beat_position doesn't advance, so locking to it would
// freeze the LFO for anyone monitoring live — those cases fall back to the
// free-running accumulator below.
host_beat_pos    = beat_position;
host_pos_locked  = (play_state == 1 || play_state == 5);
blk_sample       = 0;


@sample

// (No transport-edge reset here — Path A. REAPER re-runs @init on every
// transport play / render start, which resets all runtime state — dwell
// LFO phases, filter state + cutoff smoothers, pan state, drift runtime,
// Speed Ramp, Start Delay, Play/Rest + effect mix; the CONFIG banks are
// preserved across those re-runs by the drift_cfg_inited guard in @init.
// See docs/v2.9-render-state-bug.md.)

// Where this sample sits in the project, in beats. @block gives the position
// at the START of the block, so step forward by however many samples in we
// are. Counted unconditionally (including through the Start Delay) so the
// position is always right the instant the delay ends.
sample_beat_pos = host_beat_pos + blk_sample * host_bpm / (60 * srate);
blk_sample += 1;

start_delay_elapsed < start_delay_sec ? (
  start_delay_elapsed += 1 / srate;
  // No-op — spl0 and spl1 pass through unchanged.
) : (

freq_lo         = min(slider1, slider2);
freq_hi         = max(slider1, slider2);
high_secs       = slider3;
low_secs        = slider4;
fade_down_secs  = slider5;
fade_down_shape = slider6;
fade_up_secs    = slider7;
fade_up_shape   = slider8;
cycle_mode      = slider38;
cycle_len_mode  = slider40;
// Fit mode: cycle length is the sum of the four dwell sliders (so each one is
// a beat count). Set-in-beats mode: pinned to slider39, the four acting as
// proportions. Raw slider values either way, so drift moves shape not length.
cycle_beats     = cycle_len_mode == 0
                    ? max(slider3 + slider5 + slider4 + slider7, 0.001)
                    : max(slider39, 0.001);
// In Host x the cycle length comes from the tempo, not from the sum of the
// four durations. Computed once here so the drift reference period and the
// dwell LFO frequency below both use exactly the same number.
host_cycle_secs = cycle_beats * 60 / host_bpm;
resonance       = slider9;
wet             = slider10;
dry             = 1 - wet;
phase_offset    = slider11 / 360;

// ===== PAN BLOCK SAMPLE READ START =====
pan_enabled     = slider13;
pan_mode        = slider14;
pan_spread      = slider15;
pan_glide_ms    = slider16;
pan_cycle_steps = slider17;
pan_sweep_val   = slider18;
pan_sweep_mode  = slider19;
pan_sweep_ratio = slider20;
// ===== PAN BLOCK SAMPLE READ END =====

// Advance each target's own ramp clock (v2.14 per-target timeline). Engage
// (slider28, GLOBAL) is the freeze/resume gate: while On, each target whose
// duration > 0 advances its own ramp_t 0->1 over its own duration, after its
// own start delay; while Off, all clocks freeze and resume. Only transport
// play (via @init) resets them.
slider28 ? (
  i = 0;
  loop(N_SPEED_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * 60 * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        speed_ramp_ramp_t_mem[i] += 1.0 / (srate * speed_ramp_dur_mem[i] * 60);
        speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
      );
    );
    i += 1;
  );
);

// Per-target Speed Ramp offsets (parallel — all 4 dwells ramp regardless of
// which target the selector shows). Each offset is its own ramp_t *
// stored_amount in seconds, applied additively to the dwell sliders below.
speed_ramp_high_offset      = speed_ramp_ramp_t_mem[0] * speed_ramp_target_value_mem[0];
speed_ramp_fade_down_offset = speed_ramp_ramp_t_mem[1] * speed_ramp_target_value_mem[1];
speed_ramp_low_offset       = speed_ramp_ramp_t_mem[2] * speed_ramp_target_value_mem[2];
speed_ramp_fade_up_offset   = speed_ramp_ramp_t_mem[3] * speed_ramp_target_value_mem[3];

// Speed-ramp-adjusted dwell phases (drift NOT yet applied). Their sum
// is the stable period reference for the drift wave, so dwell drift
// doesn't self-modulate the drift rate.
ref_high = max(slider3 + speed_ramp_high_offset,      0.001);
ref_fd   = max(slider5 + speed_ramp_fade_down_offset, 0.001);
ref_low  = max(slider4 + speed_ramp_low_offset,       0.001);
ref_fu   = max(slider7 + speed_ramp_fade_up_offset,   0.001);
drift_ref_period = max(ref_high + ref_fd + ref_low + ref_fu, 0.001);

// Host x: one cycle is a fixed number of beats, so the drift period — which
// is counted in cycles — follows the tempo with it.
cycle_mode == 1 ? drift_ref_period = max(host_cycle_secs, 0.001);

// Per-target drift wave computation. 6 targets (0-3 = the four dwell
// phases, 4 = Pan Sweep Rate, 5 = Resonance). Each gets a phase counter
// advancing per sample. Period unit is dwell patterns: one drift cycle
// spans `per` patterns of drift_ref_period seconds each.
i = 0;
loop(N_TARGETS,
  up    = target_drift_up[i];
  down  = target_drift_down[i];
  per   = target_drift_per[i];
  shape = target_drift_shape[i];

  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    period_samples = max(per * srate * drift_ref_period, 1);
    new_phase = target_drift_phase[i] + 1.0 / period_samples;
    new_phase >= 1.0 ? (
      new_phase -= 1.0;
      shape == 2 ? (
        target_drift_prev[i] = target_drift_curr[i];
        target_drift_curr[i] = rand(2) - 1;
      );
    );
    target_drift_phase[i] = new_phase;

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = target_drift_prev[i] +
        (target_drift_curr[i] - target_drift_prev[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  target_drift_offset[i] = drift_offset_local;
  i += 1;
);

// Effective dwell phases: slider + Speed Ramp offset + drift offset
// (targets 0-3, all additive in seconds). Clamp each to a 1 ms floor.
high_secs      = max(slider3 + speed_ramp_high_offset      + target_drift_offset[0], 0.001);
fade_down_secs = max(slider5 + speed_ramp_fade_down_offset + target_drift_offset[1], 0.001);
low_secs       = max(slider4 + speed_ramp_low_offset       + target_drift_offset[2], 0.001);
fade_up_secs   = max(slider7 + speed_ramp_fade_up_offset   + target_drift_offset[3], 0.001);

period = high_secs + fade_down_secs + low_secs + fade_up_secs;

// Host x: pin the cycle to the tempo. The four durations above still set the
// SHAPE — calc_lfo() divides each by `period` to get its fraction of the
// cycle, so their ratios are all that survives — but the total length now
// comes from Cycle length (beats). Drift and Speed Ramp on the dwell phases
// therefore rebalance the cycle rather than lengthening it.
cycle_mode == 1 ? period = max(host_cycle_secs, 0.00001);

freq   = 1 / max(period, 0.00001);

// Resonance drift + Speed Ramp (target 5): clamp to [0, 1] (slider range).
eff_resonance = max(0, min(1, resonance + target_drift_offset[5] + speed_ramp_ramp_t_mem[5] * speed_ramp_target_value_mem[5]));

// Pan Sweep Rate drift + Speed Ramp (target 4): fold into the pan sweep value
// used by pan modes 10/11 below (in the Pan Sweep Rate's own unit).
eff_pan_sweep_val = max(0.001, pan_sweep_val + target_drift_offset[4] + speed_ramp_ramp_t_mem[4] * speed_ramp_target_value_mem[4]);

// Smoother coefficient — used for cut_smooth below and effect_mix
// just below that. Moved up so both can share the same value.
smooth = exp(-1 / (srate * 0.003));

// Play/Rest gate state machine. pr_cycle_progress accumulates
// fractional cycles at the dwell-pattern frequency (1 / total
// period); when it crosses the threshold for the current state,
// pr_resting flips and the counter resets.
pr_enabled ? (
  pr_cycle_progress += freq / srate;
  !pr_resting ? (
    pr_cycle_progress >= play_for_cycles ? (
      pr_resting = 1;
      pr_cycle_progress = 0;
    );
  ) : (
    pr_cycle_progress >= rest_for_cycles ? (
      pr_resting = 0;
      pr_cycle_progress = 0;
    );
  );
);

// LFO at rest = Freeze → in_frozen_rest gates phase_l/r and
// pan_phase advancement during rest.
in_frozen_rest = pr_enabled && pr_resting && rest_lfo_mode == 1;

// effect_mix smoothly transitions between 1 (effect fully on) and
// 0 (rest target) at rest boundaries. The rest target depends on
// Output at rest: dry_l/r (pass-through) for Pass-through, 0
// (silence) for Silence. Below, the play-mode wet/dry mix and the
// rest target are interpolated by effect_mix to produce the final
// spl0/spl1 — soft fade between effect-on and whichever rest
// state was chosen.
target_effect_mix = pr_enabled && pr_resting ? 0 : 1;
effect_mix        = effect_mix * smooth + target_effect_mix * (1 - smooth);
silence_mode      = (rest_output_mode == 1);

// Advance dwell-pattern LFO phases unless Freeze rest is pinning them.
//
// In Host x with the transport rolling, phase is POSITIONED from the project
// rather than accumulated: one cycle spans cycle_beats beats, so the phase is
// just how far through those beats we are. Cycle length is a fixed slider
// here (dwell drift only changes the SHAPE in this mode, never the length),
// so the position formula is exact — nothing is being modulated underneath it.
// Every other case keeps the original accumulator.
//
// Freeze rest still wins: it pins the phase where it was, and on resume the
// lock re-asserts, so the cutoff steps to wherever the project now is. The
// 3 ms cutoff smoother rounds that off.
!in_frozen_rest ? (
  (cycle_mode == 1 && host_pos_locked) ? (
    phase_l = sample_beat_pos / cycle_beats;
    phase_l -= floor(phase_l);
  ) : (
    phase_l += freq / srate;
    phase_l >= 1 ? phase_l -= 1;
  );

  slider12 == 0 ? (
    // Independent L+R: both run at the same rate from the same start, so the
    // locked case is simply the same position.
    (cycle_mode == 1 && host_pos_locked) ? (
      phase_r = phase_l;
    ) : (
      phase_r += freq / srate;
      phase_r >= 1 ? phase_r -= 1;
    );
  ) : (
    phase_r = phase_l + phase_offset;
    phase_r >= 1 ? phase_r -= 1;
    phase_r < 0  ? phase_r += 1;
  );
);

lfo_l = calc_lfo(phase_l, high_secs, low_secs, fade_down_secs, fade_up_secs, fade_down_shape, fade_up_shape);
lfo_r = calc_lfo(phase_r, high_secs, low_secs, fade_down_secs, fade_up_secs, fade_down_shape, fade_up_shape);

target_freq_l = freq_lo + lfo_l * (freq_hi - freq_lo);
target_freq_r = freq_lo + lfo_r * (freq_hi - freq_lo);

// Smooth the CUTOFF IN HZ now, not a raw coefficient. The old code smoothed
// `freq * 2/srate`, which is what made "Hz" a coefficient wearing a Hz label.
cut_target_l = target_freq_l;
cut_target_r = target_freq_r;

cut_smooth_l = cut_smooth_l * smooth + cut_target_l * (1 - smooth);
cut_smooth_r = cut_smooth_r * smooth + cut_target_r * (1 - smooth);

dry_l = spl0;
dry_r = spl1;

filt_g = tan($pi * min(cut_smooth_l, srate*0.49) / srate);
filt_qm_l = exp(-filt_res_k * eff_resonance);
filt_in = spl0;
filt_i = 0;
loop(filt_stages,
  filt_x = filt_i * 2;
  filt_k = svf_qb[filt_i] * filt_qm_l;
  filt_a1 = 1 / (1 + filt_g*(filt_g + filt_k));
  filt_a2 = filt_g * filt_a1;
  filt_a3 = filt_g * filt_a2;
  filt_v3 = filt_in - svf_l[filt_x + 1];
  filt_v1 = filt_a1*svf_l[filt_x] + filt_a2*filt_v3;
  filt_v2 = svf_l[filt_x + 1] + filt_a2*svf_l[filt_x] + filt_a3*filt_v3;
  svf_l[filt_x]     = 2*filt_v1 - svf_l[filt_x];
  svf_l[filt_x + 1] = 2*filt_v2 - svf_l[filt_x + 1];
  filt_in = filt_v2;                  // v2 is the lowpass output
  filt_i += 1;
);
out_l = filt_in;
filt_g = tan($pi * min(cut_smooth_r, srate*0.49) / srate);
filt_qm_r = exp(-filt_res_k * eff_resonance);
filt_in = spl1;
filt_i = 0;
loop(filt_stages,
  filt_x = filt_i * 2;
  filt_k = svf_qb[filt_i] * filt_qm_r;
  filt_a1 = 1 / (1 + filt_g*(filt_g + filt_k));
  filt_a2 = filt_g * filt_a1;
  filt_a3 = filt_g * filt_a2;
  filt_v3 = filt_in - svf_r[filt_x + 1];
  filt_v1 = filt_a1*svf_r[filt_x] + filt_a2*filt_v3;
  filt_v2 = svf_r[filt_x + 1] + filt_a2*svf_r[filt_x] + filt_a3*filt_v3;
  svf_r[filt_x]     = 2*filt_v1 - svf_r[filt_x];
  svf_r[filt_x + 1] = 2*filt_v2 - svf_r[filt_x + 1];
  filt_in = filt_v2;                  // v2 is the lowpass output
  filt_i += 1;
);
out_r = filt_in;

// Compute play-mode output (normal wet/dry mix), then blend with
// the rest target via effect_mix. Rest target: dry_l/r for
// Pass-through, 0 for Silence. Filter state (the cascade) and
// cut_smooth keep running through rest so the filter is "warm"
// and re-engages cleanly on rest exit.
play_spl0 = dry * dry_l + wet * out_l;
play_spl1 = dry * dry_r + wet * out_r;
rest_spl0 = silence_mode ? 0 : dry_l;
rest_spl1 = silence_mode ? 0 : dry_r;
spl0 = effect_mix * play_spl0 + (1 - effect_mix) * rest_spl0;
spl1 = effect_mix * play_spl1 + (1 - effect_mix) * rest_spl1;

// ===== PAN BLOCK SAMPLE LOGIC START =====
pan_enabled ? (
  // Per-cycle pan modes (0-9) advance pan_cycle_index on dwell LFO
  // phase wraps. Since the dwell phase_l advancement above is
  // gated by !in_frozen_rest, cycle_fired never triggers during
  // Freeze rest — pan_cycle_index naturally pauses too.
  cycle_fired  = (phase_l < last_phase_l);
  last_phase_l = phase_l;

  pan_mode <= 9 ? (
    cycle_fired ? (
      pan_mode == 5 || pan_mode == 7 || pan_mode == 9 ? (
        pan_cycle_index += pan_cycle_dir;
        (pan_cycle_index >= pan_cycle_steps - 1 || pan_cycle_index <= 0) ?
          pan_cycle_dir = -pan_cycle_dir;
      ) : (
        pan_cycle_index = (pan_cycle_index + 1) % pan_cycle_steps;
      );
    );
    cur_pan = percycle_pan(pan_cycle_index, pan_cycle_steps);
    pan_l = cur_pan;

  ) : pan_mode == 10 ? (
    // Pan Sweep — gate phase advance for Freeze mode. eff_pan_sweep_val
    // carries the Pan Sweep Rate drift offset (target 4). Branches keyed by
    // the enum's NAMES: 0 Hz, 1 Seconds, 2 BPM, 3 Host x (a multiplier of
    // the project tempo, so higher = faster, same as the rest of the suite).
    pan_sweep_mode == 0 ? (pan_freq = eff_pan_sweep_val) :
    pan_sweep_mode == 1 ? (pan_freq = 1 / max(eff_pan_sweep_val, 0.001)) :
    pan_sweep_mode == 2 ? (pan_freq = eff_pan_sweep_val / 60) :
                          (pan_freq = eff_pan_sweep_val * host_bpm / 60);
    !in_frozen_rest ? (
      pan_phase += pan_freq / srate;
      pan_phase >= 1 ? pan_phase -= 1;
    );
    cur_pan = (pan_phase * 2.0 - 1.0) * pan_spread;
    pan_l = cur_pan;

  ) : pan_mode == 11 ? (
    // Pan Sweep Flipped — gate phase advance for Freeze mode. Same
    // name-keyed branches as mode 10 above.
    pan_sweep_mode == 0 ? (pan_freq = eff_pan_sweep_val) :
    pan_sweep_mode == 1 ? (pan_freq = 1 / max(eff_pan_sweep_val, 0.001)) :
    pan_sweep_mode == 2 ? (pan_freq = eff_pan_sweep_val / 60) :
                          (pan_freq = eff_pan_sweep_val * host_bpm / 60);
    !in_frozen_rest ? (
      pan_phase += pan_freq / srate;
      pan_phase >= 1 ? pan_phase -= 1;
    );
    cur_pan = (1.0 - pan_phase * 2.0) * pan_spread;
    pan_l = cur_pan;

  ) : (
    // Linked Sweep — gate phase advance for Freeze mode. This mode rides the
    // dwell cycle times a fixed multiplier, so when the cycle is position-
    // locked this one can be too, and it stays exactly in step instead of
    // slowly separating from it over a long session.
    //
    // Pan Sweep (modes 10/11) deliberately does NOT lock, even on the Host x
    // unit: its rate can be moved by Drift and Speed Ramp, and positioning
    // from the project assumes a rate that isn't being modulated underneath.
    // The rule across the plugin is lock what's constant, accumulate what's
    // modulated.
    !in_frozen_rest ? (
      (cycle_mode == 1 && host_pos_locked) ? (
        pan_phase = sample_beat_pos * pan_sweep_ratio / cycle_beats;
        pan_phase -= floor(pan_phase);
      ) : (
        pan_phase += (freq * pan_sweep_ratio) / srate;
        pan_phase >= 1 ? pan_phase -= 1;
      );
    );
    cur_pan = (pan_phase * 2.0 - 1.0) * pan_spread;
    pan_l = cur_pan;
  );

  pan_glide_coeff = pan_glide_ms > 0 ? exp(-1 / (srate * pan_glide_ms * 0.001)) : 0;
  pan_l_smooth = pan_l_smooth * pan_glide_coeff + pan_l * (1 - pan_glide_coeff);

  // Apply the pan, then blend with the un-panned signal via
  // effect_mix. During rest, effect_mix → 0 means the output is
  // whatever spl0 was BEFORE the pan block ran — which already
  // reflects the rest target (dry pass-through OR silence)
  // because the wet/dry blend above used effect_mix.
  pan_pos = (pan_l_smooth + 1.0) * 0.5;
  mono = (spl0 + spl1) * 0.5;
  spl0_panned = mono * cos(pan_pos * $pi * 0.5);
  spl1_panned = mono * sin(pan_pos * $pi * 0.5);
  spl0 = spl0 * (1 - effect_mix) + spl0_panned * effect_mix;
  spl1 = spl1 * (1 - effect_mix) + spl1_panned * effect_mix;
);
// ===== PAN BLOCK SAMPLE LOGIC END =====

);  // close start-delay else branch

@serialize
// Persist per-target Speed Ramp (by / duration / start-delay) + drift configs
// so reload restores all targets, not just whichever was selected at save.
//
// VERSION-GUARDED (CLAUDE.md @serialize gotcha; NEW in v2.14). Magic base
// bumped to 2200000 when the Speed Ramp target count grew 4 -> 6 (added Pan
// Sweep Rate + Resonance), which changed the serialized SR-bank size. Older
// blobs (unversioned, or the 2100000 per-target-timeline build) won't match
// and fall through to @init defaults — drift + ramp reset (accepted;
// pre-release). Marker is float32-exact.
sr_magic = 2200000 + N_TARGETS;
file_var(0, sr_magic);
sr_magic == 2200000 + N_TARGETS ? (
  file_mem(0, speed_ramp_target_value_mem, N_SPEED_TARGETS);
  file_mem(0, speed_ramp_dur_mem,          N_SPEED_TARGETS);
  file_mem(0, speed_ramp_delay_mem,        N_SPEED_TARGETS);
  file_var(0, last_speed_target);
  file_mem(0, target_drift_up,    N_TARGETS);
  file_mem(0, target_drift_down,  N_TARGETS);
  file_mem(0, target_drift_per,   N_TARGETS);
  file_mem(0, target_drift_shape, N_TARGETS);
  file_var(0, last_target_select);

  // TRACK-DUPLICATE FIX (v2.14). On READ (load/duplicate) file_avail(0) >= 0;
  // on WRITE it is < 0. @serialize is the only section guaranteed to run on
  // both load AND duplicate, so it re-establishes the bank<->slider invariant:
  // force the visible config sliders to match the restored banks for the
  // restored selectors, correcting any transient @slider clobber.
  file_avail(0) >= 0 ? (
    slider29 = speed_ramp_target_value_mem[last_speed_target]; // Speed ramp `by`
    slider27 = speed_ramp_dur_mem[last_speed_target];          // Speed ramp duration
    slider37 = speed_ramp_delay_mem[last_speed_target];        // Speed ramp start delay
    slider31 = target_drift_up[last_target_select];            // Drift up
    slider32 = target_drift_down[last_target_select];          // Drift down
    slider33 = target_drift_per[last_target_select];           // Drift period
    slider34 = target_drift_shape[last_target_select];         // Drift shape
    sliderchange(-1);
  );
);