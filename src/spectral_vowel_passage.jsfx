  ps_inited ? (
    (slider3 != ps_last[0] || slider4 != ps_last[1]) ? cap_all_scrub = 1;
    ps_all(0,  slider3,  slider3 * 0.01,                  slot_cappoint);
    ps_all(1,  slider4,  max(1, min(CAPAVG_MAX, slider4)), slot_capavg);
    ps_all(2,  slider47, max(0, min(NHARM, slider47)),    slot_ot_harm);
    ps_all(3,  slider48, max(0, min(48, slider48)),       slot_ot_depth);
    ps_all(4,  slider12, slider12,                        slot_fadein);
    ps_all(5,  slider13, slider13,                        slot_linger);
    ps_all(6,  slider14, slider14,                        slot_xfade);
    ps_all(7,  slider15, slider15,                        slot_gap);
    ps_all(8,  slider18, slider18 > 0.5 ? 1 : 0,          slot_xfadeon);
    ps_all(9,  slider19, slider19 > 0.5 ? 1 : 0,          slot_mute);
    ps_all(10, slider61, slider61,                        slot_voicedb);
    ps_all(11, slider20, slider20 * 0.01,                 slot_texture);
    ps_all(12, slider32, slider32,                        slot_spread);
    ps_all(13, slider27,  slider27,                         slot_pitch);
    ps_all(14, slider35, slider35,                        slot_width);
    ps_all(15, slider39, slider39,                        slot_lowcut);
    ps_all(16, slider36, slider36,                        slot_denoise);
    ps_all(32, slider22,  slider22,  slot_srcnote);
    ps_all(33, slider24,  slider24,  slot_srcfine);
    ps_all(34, slider23,  slider23,  slot_srcfunit);
    ps_all(35, slider25,  slider25,  slot_tgtnote);
    ps_all(36, slider26, slider26, slot_tunit);
    ps_all(37, slider29, slider29, slot_fine);
    ps_all(38, slider28, slider28, slot_funit);
    ps_all(39, slider21, slider21, slot_grain);
    ps_all(40, slider44, slider44, slot_hicut);
    ps_all(41, slider11, slider11, slot_tmunit);
    ps_all(44, slider31, slider31, slot_spmode); ps_all(45, slider33, slider33, slot_spfunit); ps_all(46, slider34, slider34, slot_spfine);
    ps_all(47, slider37, slider37, slot_lcmode); ps_all(48, slider40, slider40, slot_lcfunit); ps_all(49, slider41, slider41, slot_lcfine);
    ps_all(50, slider42, slider42, slot_hcmode); ps_all(51, slider45, slider45, slot_hcfunit); ps_all(52, slider46, slider46, slot_hcfine);
  );
  last_cap_slot = cap_slot; last_cap_sel = cap_sel; last_cap_all = cap_all;
) : (
  slot_cappoint[cap_slot] = slider3 * 0.01;         // capture a live scrub of the current slot
  slot_capavg[cap_slot]   = max(1, min(CAPAVG_MAX, slider4));   // live capture-average edit
  slot_ot_harm[cap_slot]  = max(0, min(NHARM, slider47));       // live overtone edits
  slot_ot_depth[cap_slot] = max(0, min(48, slider48));
  slot_fadein[cap_slot]  = slider12;                 // live fade-in edit
  slot_linger[cap_slot]  = slider13;                 // live hold edit
  slot_xfade[cap_slot]   = slider14;                 // live fade-out edit
  slot_gap[cap_slot]     = slider15;                 // live gap edit
  slot_xfadeon[cap_slot] = slider18 > 0.5 ? 1 : 0;   // live crossfade-toggle edit
  slot_mute[cap_slot]    = slider19 > 0.5 ? 1 : 0;   // live mute edit
