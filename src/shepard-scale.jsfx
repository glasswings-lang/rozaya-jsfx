desc: Shepard Scale Generator
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/
//
// A Shepard scale sequencer. Steps through up to 12 chromatic notes (C-B).
// Each note triggers a stack of octave-spaced oscillators. The pitch window
// is exactly as wide as the Octave Count — so each layer is always exactly
// one octave apart and the bell shaping is always consistent. Together this
// creates the Shepard scale illusion — each note sounds higher than the last,
// but after 12 steps you're back where you started.
//
// SKIP vs REST:
//   Skip — inactive notes are skipped; sequence jumps to next active note.
//   Rest — inactive notes hold silence for their full beat duration.
//
// ENVELOPE:
//   Attack and Release shape each note's volume over its beat. The envelope
//   runs continuously from the beat phase — no abrupt resets, no clicks.
//
// CONTROLS:
//   BPM            — Tempo.
//   Direction      — Ascending (C to B) or descending (B to C).
//   Inactive Notes — Skip or Rest behavior.
//   Attack %       — Fraction of beat spent fading in.
//   Release %      — Fraction of beat spent fading out.
//   Note Length %  — How much of each beat the note occupies before silence.
//   Octave Count   — How many octave layers stack per note (2-12), and how
//                    wide the pitch window is. These are the same thing.
//   Center Octave  — Which octave sits at the middle of the stack.
//   Waveform       — Sine is cleanest for the illusion.
//   Binaural Beat  — Right channel Hz offset.
//   Tuning Ref     — A4 reference frequency.
//
// PER NOTE (C through B):
//   Active  — Always visible. Gain and Pan hide when off.
//   Gain dB — Volume of this note.
//   Pan     — Stereo position.

// ===== GLOBAL CONTROLS =====
// ===== GLOBAL CONTROLS =====
slider1:120<0.001,1000,0.001>Rate value (BPM / sec / Hz / beats per cycle / per beat)
slider2:0<0,4,1{BPM,Seconds,Hz,Every N beats,N per beat}>Rate Mode
slider3:0<0,1,1{Asc,Desc}>Direction
slider4:0<0,1,1{Skip,Rest}>Inactive Notes
slider5:10<0,100,0.1>Attack %
slider6:10<0,100,0.1>Release %
slider7:100<1,100,0.1>Note Length %
slider8:8<2,12,1>Octave Count
slider9:4<0,8,1>Center Octave
slider10:0<0,13,1{Sine,Triangle,Saw,Golden TS,Golden SG,Golden GS,Bell,Wavefold,Half-sine,Phi-cascade,Phi Triangle,Phi Sine,Square,Pulse}>Waveform
slider11:25<1,99,0.1>Pulse width (%, 50 = square)
slider12:0<0,1000,0.001>Binaural Beat Hz
slider13:440<20,2000,0.1>Tuning Reference Hz
slider14:2<0,2,1{Hz,Semitones,Cents}>Fine tune unit (for every note)

// ===== NOTES, C through B: Active, Gain, Pan, Fine tune =====
slider15:1<0,1,1{Off,On}>C Active
slider16:0<-60,6,0.01>C Gain dB
slider17:0<-100,100,0.1>C Pan
slider18:0<-1000,1000,0.001>C Fine tune (in fine tune units)
slider19:1<0,1,1{Off,On}>C# Active
slider20:0<-60,6,0.01>C# Gain dB
slider21:0<-100,100,0.1>C# Pan
slider22:0<-1000,1000,0.001>C# Fine tune (in fine tune units)
slider23:1<0,1,1{Off,On}>D Active
slider24:0<-60,6,0.01>D Gain dB
slider25:0<-100,100,0.1>D Pan
slider26:0<-1000,1000,0.001>D Fine tune (in fine tune units)
slider27:1<0,1,1{Off,On}>D# Active
slider28:0<-60,6,0.01>D# Gain dB
slider29:0<-100,100,0.1>D# Pan
slider30:0<-1000,1000,0.001>D# Fine tune (in fine tune units)
slider31:1<0,1,1{Off,On}>E Active
slider32:0<-60,6,0.01>E Gain dB
slider33:0<-100,100,0.1>E Pan
slider34:0<-1000,1000,0.001>E Fine tune (in fine tune units)
slider35:1<0,1,1{Off,On}>F Active
slider36:0<-60,6,0.01>F Gain dB
slider37:0<-100,100,0.1>F Pan
slider38:0<-1000,1000,0.001>F Fine tune (in fine tune units)
slider39:1<0,1,1{Off,On}>F# Active
slider40:0<-60,6,0.01>F# Gain dB
slider41:0<-100,100,0.1>F# Pan
slider42:0<-1000,1000,0.001>F# Fine tune (in fine tune units)
slider43:1<0,1,1{Off,On}>G Active
slider44:0<-60,6,0.01>G Gain dB
slider45:0<-100,100,0.1>G Pan
slider46:0<-1000,1000,0.001>G Fine tune (in fine tune units)
slider47:1<0,1,1{Off,On}>G# Active
slider48:0<-60,6,0.01>G# Gain dB
slider49:0<-100,100,0.1>G# Pan
slider50:0<-1000,1000,0.001>G# Fine tune (in fine tune units)
slider51:1<0,1,1{Off,On}>A Active
slider52:0<-60,6,0.01>A Gain dB
slider53:0<-100,100,0.1>A Pan
slider54:0<-1000,1000,0.001>A Fine tune (in fine tune units)
slider55:1<0,1,1{Off,On}>A# Active
slider56:0<-60,6,0.01>A# Gain dB
slider57:0<-100,100,0.1>A# Pan
slider58:0<-1000,1000,0.001>A# Fine tune (in fine tune units)
slider59:1<0,1,1{Off,On}>B Active
slider60:0<-60,6,0.01>B Gain dB
slider61:0<-100,100,0.1>B Pan
slider62:0<-1000,1000,0.001>B Fine tune (in fine tune units)

// ===== TRANSPORT =====
slider63:0<0,1000,0.001>Start delay (beats)
slider64:0<0,1000,1>Play for (beats)
slider65:0<0,1000,1>Rest for (beats)
slider66:0<0,1,1{Walk through,Freeze in place}>Rest mode

// ===== DRIFT: 45 targets in control order =====
slider67:0<0,44,1{Rate value,Attack,Release,Note length,Pulse width,Binaural beat,Tuning reference,C Gain,C Pan,C Fine tune,C# Gain,C# Pan,C# Fine tune,D Gain,D Pan,D Fine tune,D# Gain,D# Pan,D# Fine tune,E Gain,E Pan,E Fine tune,F Gain,F Pan,F Fine tune,F# Gain,F# Pan,F# Fine tune,G Gain,G Pan,G Fine tune,G# Gain,G# Pan,G# Fine tune,A Gain,A Pan,A Fine tune,A# Gain,A# Pan,A# Fine tune,B Gain,B Pan,B Fine tune,Play for,Rest for}>Drift target
slider68:0<0,1000,0.01>Drift up amount (units match target)
slider69:0<0,1000,0.01>Drift down amount (units match target)
slider70:8<0,1000,1>Drift period (0 = off)
slider71:0<0,2,1{Cycles,Seconds,Beats}>Drift period unit
slider72:0<0,2,1{Sine,Triangle,Random}>Drift shape
slider73:0<0,1000,0.01>Drift play for (periods, 0 = always)
slider74:0<0,1000,0.01>Drift rest for (periods, 0 = always)

// ===== RAMP: the same 45 targets =====
slider75:0<0,44,1{Rate value,Attack,Release,Note length,Pulse width,Binaural beat,Tuning reference,C Gain,C Pan,C Fine tune,C# Gain,C# Pan,C# Fine tune,D Gain,D Pan,D Fine tune,D# Gain,D# Pan,D# Fine tune,E Gain,E Pan,E Fine tune,F Gain,F Pan,F Fine tune,F# Gain,F# Pan,F# Fine tune,G Gain,G Pan,G Fine tune,G# Gain,G# Pan,G# Fine tune,A Gain,A Pan,A Fine tune,A# Gain,A# Pan,A# Fine tune,B Gain,B Pan,B Fine tune,Play for,Rest for}>Ramp target
slider76:0<-1000,1000,0.001>Ramp by (units match target)
slider77:2<0,3,1{Cycles,Seconds,Minutes,Beats}>Ramp time unit
slider78:0<0,1000,0.1>Ramp duration (in ramp time units)
slider79:0<0,1000,0.01>Ramp play for (0 = smooth)
slider80:0<0,1000,0.01>Ramp rest for (0 = smooth)
slider81:0<0,1,1{Off,On}>Ramp engage
slider82:0<0,1000,0.1>Ramp start delay (in ramp time units)

@init
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: REAPER re-runs @init on every transport play / render
// start, resetting all runtime for free (sequencer, note envelopes,
// oscillator re-init flag, drift runtime, Speed Ramp, Start Delay,
// Play/Rest). Only the drift CONFIG bank must survive the re-run; it's
// guarded by drift_cfg_inited below.

// Host tempo capture. `tempo` is READ-ONLY in JSFX (assigning is silently
// ignored -- the rhythm-track bug in CLAUDE.md). Read only, into a global
// deliberately not named `tempo`. Nothing remembers it across transport.
host_bpm = max(tempo, 0.001);
host_ratio_inited = 0;

// rate_units is slider1 in ITS OWN unit — plain BPM in Own BPM mode, beats per
// cycle in Host x — and bpm is the real steps-per-minute it works out to.
// Drift and Ramp offsets are added to BPM, in the effective_bpm line in
// @sample, so they are deltas in real BPM in both modes — which is the suite
// rule (the plugin converts, never the user).
//
// An earlier version of this comment said the offsets were added to rate_units
// before the multiply. They never were; the code has always added them after.
// The same wrong comment sat in rhythm-track. Corrected 2026-09-04.
// Seeded here so @sample has them before @slider's first run.
rate_units = slider1;
bpm        = slider1;

PHI = 1.6180339887;
NUM_OSC = 12; // max octave layers per note

// Memory: note 0-11, osc 0-11 → index = note * NUM_OSC + osc (max 144 slots)
osc_freq    = 0;   // 0-143:   fixed frequency per oscillator
osc_phase_l = 144; // 144-287: oscillator phase left
osc_phase_r = 288; // 288-431: oscillator phase right
osc_gain    = 432; // 432-575: smoothed gain per oscillator

// Per-note (12 slots each)
n_active    = 576; // 576-587
n_gain_lin  = 588; // 588-599
n_gain_db   = 4096; // dB before drift/ramp -- above every other bank
n_fine      = 4112; // per-note detune, in the unit at slider14
n_pan       = 600; // 600-611
n_root      = 612; // 612-623: root Hz for each note
n_env       = 624; // 624-635: per-note envelope gain (smoothed)

// Sequencer state
seq_pos   = 0;   // current note index 0-11
seq_phase = 0.0; // position in current beat 0-1
// Seek detection for the Host x sequence placement in @block. was_moving = 0
// means the first block after a transport start always places the sequence.
was_moving         = 0;
predicted_beat_pos = 0;

smooth_gain = 0; // set in @slider
needs_init   = 1;
last_num_osc = 0;
last_center  = -1;
last_tuning  = -1;

i = 0;
loop(12, n_env[i] = 0; i += 1;);

i = 0;
loop(144,
  osc_freq[i]    = 1; // 1Hz placeholder — avoids log(0)
  osc_phase_l[i] = 0;
  osc_phase_r[i] = 0;
  osc_gain[i]    = 0;
  i += 1;
);

function note_to_hz(semitone, oct, tref) (
  // semitone 0=C ... 11=B, oct=octave number, tref=A4 Hz
  tref * pow(2, (oct * 12 + semitone - 57) / 12.0)
);

// Waveform dispatch — kept in sync with Polyrhythm Phase / Melody Phase
// so all four plugins offer the same palette. See those plugins' source
// for the canonical comment blocks on each waveform. Note that the
// Golden TS / SG slots are the polyrhythm-compatible (sine-output)
// versions, not the manual's strict reading — Phi Triangle / Phi Sine
// are the strict-reading variants. See rozaya-jsfx/CLAUDE.md for why.
// PolyBLEP: band-limited step correction for the Square and Pulse
// waveforms (slots 12-13). At each discontinuity the naive wave jumps
// instantly, which is infinite bandwidth and aliases badly. This adds a
// small correction over the one sample either side of the edge. bdt is
// the phase increment per sample, so the correction scales with pitch.
// Returns 0 away from an edge, so it costs nothing for other waveforms.
function polyblep(bt, bdt) local(bs) (
  bt < bdt ? (
    bs = bt / bdt;
    bs + bs - bs * bs - 1;
  ) : bt > 1 - bdt ? (
    bs = (bt - 1) / bdt;
    bs * bs + bs + bs + 1;
  ) : (
    0;
  );
);

function wave_sample(ph, pbdt) (
  waveform == 0 ? sin(ph * 2 * $pi) :
  waveform == 1 ? (ph < 0.25 ? ph*4 : ph < 0.75 ? 2-ph*4 : ph*4-4) :
  waveform == 2 ? (ps = ph+0.5; ps-=floor(ps); ps*2-1) :
  waveform == 3 ? (
    pg = ph<(1/PHI) ? ph*PHI*0.5 : 0.5+(ph-1/PHI)/(1-1/PHI)*0.5;
    sin(pg*2*$pi)
  ) :
  waveform == 4 ? (
    pg = (sin((ph-0.25)*2*$pi)+1)*0.5;
    pg = pg<(1/PHI) ? pg*PHI*0.5 : 0.5+(pg-1/PHI)/(1-1/PHI)*0.5;
    sin(pg*2*$pi)
  ) :
  waveform == 5 ? (
    pg = ph+(1/PHI)*sin(ph*2*$pi)/(2*$pi); pg-=floor(pg); sin(pg*2*$pi)
  ) :
  waveform == 6 ? (
    // Bell — additive partials at 1, 2, 3, 4, 6
    0.55*sin(ph*2*$pi) + 0.25*sin(ph*4*$pi) + 0.10*sin(ph*6*$pi)
      + 0.07*sin(ph*8*$pi) + 0.03*sin(ph*12*$pi)
  ) :
  waveform == 7 ? sin(2 * sin(ph * 2 * $pi)) :          // Wavefold
  waveform == 8 ? (2 * abs(sin(ph * 2 * $pi)) - 1) :    // Half-sine (octave up; see Polyrhythm Phase docs)
  waveform == 9 ? (
    // Phi-cascade — fundamental + φ⁻¹·2nd + φ⁻²·3rd
    sin(ph*2*$pi) + (1/PHI)*sin(ph*4*$pi) + (1/(PHI*PHI))*sin(ph*6*$pi)
  ) :
  waveform == 10 ? (
    // Phi Triangle — manual-correct "Golden TS" (warp → triangle)
    pg = ph<(1/PHI) ? ph*PHI*0.5 : 0.5+(ph-1/PHI)/(1-1/PHI)*0.5;
    pg < 0.5 ? 4*pg - 1 : 3 - 4*pg
  ) :
  waveform == 11 ? (
    // Phi Sine — manual-correct "Golden SG" (clean warp → sine, no prewarp)
    pg = ph<(1/PHI) ? ph*PHI*0.5 : 0.5+(ph-1/PHI)/(1-1/PHI)*0.5;
    sin(pg*2*$pi)
  ) :
  waveform == 12 ? (
    // Square — +1 for the first half of the cycle, -1 for the second,
    // PolyBLEP-corrected at both edges (the wrap at 0 and the fall at
    // 0.5). Matches the Square slot in Polyrhythm Phase.
    pusq = ph < 0.5 ? 1 : -1;
    putd = ph - 0.5; putd < 0 ? putd += 1;
    pusq + polyblep(ph, pbdt) - polyblep(putd, pbdt)
  ) : (
    // Pulse — same shape with the falling edge at pulse_duty instead of
    // 0.5. At duty 0.5 this is identical to Square; narrower gets
    // thinner and more nasal. A duty other than 50 introduces a DC
    // offset, inaudible and attenuated downstream — the same accepted
    // tradeoff as Half-sine.
    pusq = ph < pulse_duty ? 1 : -1;
    putd = ph - pulse_duty; putd < 0 ? putd += 1;
    pusq + polyblep(ph, pbdt) - polyblep(putd, pbdt)
  )
);

// Bell gain: cosine rolloff centered on center_freq.
// half_width_oct is half the total window width in octaves (== num_osc / 2).
function bell_gain(f, f_center, half_width_oct) (
  dist = (log(f) - log(f_center)) / log(2);
  abs(dist) >= half_width_oct ? 0 :
  0.5 + 0.5 * cos(dist / half_width_oct * $pi)
);

// Beat envelope: cosine attack/release over beat phase 0-1
function beat_env(ph, att, rel) (
  att + rel > 1.0 ? (t = att+rel; att/=t; rel/=t;);
  ph < att ? (att > 0 ? 0.5 - 0.5*cos(ph/att*$pi) : 1) :
  ph > (1-rel) ? (rel > 0 ? 0.5 - 0.5*cos((1-ph)/rel*$pi) : 0) :
  1
);

// Initialize oscillator frequencies for all 12 notes.
// Window is exactly num_osc octaves wide centered on center_freq.
// Each note gets num_osc oscillators at exact octave steps, starting from
// the octave of the root nearest to center_freq.
function init_oscs() (
  n = 0;
  loop(12,
    root = n_root[n];
    // Find octave of root nearest to center_freq
    center_oct_offset = floor(log(center_freq / root) / log(2) + 0.5);
    root_near_center  = root * pow(2, center_oct_offset);

    // Place oscillators at exact octave steps above root_near_center,
    // wrapping back down when they exceed the window top.
    // Window == num_osc octaves wide, so wrap is always exact.
    o = 0;
    loop(NUM_OSC,
      oi = n * NUM_OSC + o;
      o < num_osc ? (
        f = root_near_center * pow(2, o);
        f > pitch_hi ? f *= pitch_lo / pitch_hi;
      ) : (
        f = root_near_center; // park extra slots — osc_gain stays 0
      );
      osc_freq[oi]    = f;
      osc_phase_l[oi] = 0;
      osc_phase_r[oi] = 0;
      osc_gain[oi]    = 0;
      o += 1;
    );
    n += 1;
  );
);

// Start Delay state.
last_play_state     = 0;
start_delay_elapsed = 0;
start_delay_sec     = 0;

// Play/Rest gate state. pr_step counts beats in the current play
// (or rest) period. Init to 1 because the first audible note (whatever
// seq_pos points at initially, default 0 = C) plays from sample 0
// without going through a beat boundary — so that note IS step 1 of
// the first play period. Subsequent beats increment pr_step at each
// boundary fire.
pr_resting               = 0;
pr_step                  = 1;
play_for_beats           = 0;
rest_for_beats           = 0;
pr_enabled               = 0;
rest_mode                = 0;
pr_rest_elapsed          = 0;
pr_rest_duration_samples = 0;

// Speed ramp state.
// Speed Ramp state. Engage is a freeze/resume gate, not an edge;
// only transport play resets the per-target ramp clocks. As of v2.14 the
// ramp is PER-TARGET: each target has its own `by`, duration, start delay,
// and progress clock, so different targets can wind down over different
// timelines from one (global) engage.

// --- v2.9 Drift target memory banks ---
//
// 4 targets × 8 fields = 32 slots. Each array is 16-slot-spaced so
// targets can grow up to 16 later without re-laying-out. Placed at
// 640 — right after n_env (which ends at 635), no overlap with
// per-osc / per-note state.
//
// Targets:
//   0 = BPM             (units: BPM)
//   1 = Note Length %   (units: %, drift sums into slider7 before /100)
//   2 = Attack %        (units: %, drift sums into slider5 before /100)
//   3 = Release %       (units: %, drift sums into slider6 before /100)
// 2026-09-09: 4 -> 29. The twelve per-note Gains and Pans and the binaural beat
// were unreachable by drift or ramp, while Melody and Polyrhythm could both
// drift their per-voice gain. Rozaya: "Drift is replacing automation, nobody's
// gonna automate everything but options are better than their absence."
// APPENDED, so no stored target index moves (R18: enum options always append).
// 2026-09-10: the banks are 64 apart. At 16 apart these targets ran into each
// other's banks, so drift offsets overwrote ramp settings while playing.
N_TARGETS = 45;
target_drift_up     = 640;
target_drift_down   = 704;
target_drift_per    = 768;
target_drift_shape  = 832;
target_drift_phase  = 896;
target_drift_prev   = 960;
target_drift_curr   = 1024;
target_drift_offset = 1088;

// Speed ramp per-target banks (v2.14). Mirror the drift banks; 16-slot-spaced
// after target_drift_offset (752). `by` / duration / start-delay are CONFIG
// (survive transport, restored by @serialize); ramp_t / delay_elapsed are
// RUNTIME (reset every @init / transport play).
speed_ramp_by_mem            = 1152;  // signed delta per target (CONFIG)
speed_ramp_dur_mem           = 1216;  // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 1280;  // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 1344;  // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 1408;  // delay sample counter per target (RUNTIME)

// Drift and Ramp play/rest, per target (2026-09-06). 16-slot-spaced like the
// banks above. play/rest are CONFIG (survive a transport re-init, restored by
// @serialize); accumulator and resting flag are RUNTIME. FIRST FREE SLOT AFTER
// THIS BLOCK IS 1984 -- re-derive rather than trusting this comment.
drift_play_mem       = 1472;
drift_rest_mem       = 1536;
sr_play_mem          = 1600;
sr_rest_mem          = 1664;
drift_pr_accum_mem   = 1728;
drift_pr_resting_mem = 1792;
sr_pr_accum_mem      = 1856;
sr_pr_resting_mem    = 1920;

// Shared play/rest gate, byte-identical to the one in Melody, the Sweeping
// Filter, Tremolo, Phaser, Bubbler, Dapple, Resonance Bank and the Morpher.
// `tick` is how much of one play/rest unit passes per sample, so the caller owns
// the unit and this stays unitless. Returns 1 while the target is resting.
function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

// CONFIG banks (drift up/down/period/shape + speed-ramp by/duration/start-delay
// + selector trackers) — guarded by drift_cfg_inited so the @init re-run on
// every transport play (Path A render fix, no ext_noinit) does NOT wipe the
// user's setup. @serialize restores saved configs on project reload.
drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_TARGETS,
    target_drift_up[i]    = 0;
    target_drift_down[i]  = 0;
    target_drift_per[i]   = 8;
    target_drift_shape[i] = 0;
    speed_ramp_by_mem[i]    = 0;
    speed_ramp_dur_mem[i]   = 0;
    speed_ramp_delay_mem[i] = 0;
    drift_play_mem[i] = 0; drift_rest_mem[i] = 0;
    sr_play_mem[i]    = 0; sr_rest_mem[i]    = 0;
    i += 1;
  );
  last_target_select = 0;
  last_sr_target     = 0;
  drift_cfg_inited = 1;
);

// Drift + speed-ramp RUNTIME resets on EVERY @init (every transport play).
i = 0;
loop(N_TARGETS,
  target_drift_phase[i]  = 0;
  target_drift_prev[i]   = 0;
  target_drift_curr[i]   = 0;
  target_drift_offset[i] = 0;
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  drift_pr_accum_mem[i] = 0; drift_pr_resting_mem[i] = 0;
  sr_pr_accum_mem[i]    = 0; sr_pr_resting_mem[i]    = 0;
  i += 1;
);


@slider
rate_mode     = slider2;
// RETIRED (R13-revised). Guard forced to 0 rather than deleted, so the
// reasoning stays beside the code it disabled. BPM says beats per cycle in
// Host x now, so there is no multiplier for a picker to translate -- and a
// picker that WRITES a value is the shape that stamped 0.5 over a hand-set
// rate on every load in infantile.RPP.
// The LANDING BLOCK is gone (R13-revised step 4). It used to stamp the picker
// to "1 per beat" and BPM to 1 on entering Host x, because meeting a bare
// MULTIPLIER first was the trap -- 120 as a multiplier is 120x the project
// tempo. There is no trap now: 120 beats per cycle is a legible number (a note
// every 120 beats, very slow), so nothing needs stamping and, crucially, the
// BPM SLIDER NEVER HIDES. Hiding it is what forced the stamp.
rate_mode_inited ? last_rate_mode = rate_mode;

// Host x: slider1 is BEATS PER CYCLE. The project runs at `tempo` beats per
// minute, so a step every N beats is tempo/N steps per minute -- which is what
// bpm has always been. beat_hz, effective_bpm, the drift period and Start Delay
// all derive from bpm, and effective_beat_hz is recomputed per sample, so
// feeding the right number in is the whole job. @block repeats it.
//
// Guarded on the NUMERATOR: inverting a unit inverts its edge cases, and
// 1/max(raw,0.001) clamps the DENOMINATOR, turning a stopped sequence into a
// thousand-times-tempo one.
rate_units    = slider1;
bpm           = rate_mode == 4 ? max(tempo, 0.001) * max(rate_units, 0.001) :
                rate_mode == 3 ?
                  (rate_units > 0.001 ? max(tempo, 0.001) / rate_units : 0.001) :
                rate_mode == 2 ? rate_units * 60 :
                rate_mode == 1 ? 60 / max(rate_units, 0.001) :
                  rate_units;
direction     = slider3;
skip_mode     = slider4;
attack_frac   = slider5 / 100.0;
release_frac  = slider6 / 100.0;
note_len_frac = slider7 / 100.0;
num_osc       = max(2, min(12, floor(slider8 + 0.5)));
center_oct    = floor(slider9 + 0.5);
waveform      = slider10;
// Pulse duty as a 0..1 fraction of the cycle. Only read by waveform
// slot 13, and the slider only shows there.
pulse_duty    = slider11 * 0.01;
pulse_duty_base = pulse_duty;
fine_unit     = slider14;
slider_show(slider11, waveform == 13);
binaural_hz   = slider12;
tuning_ref    = slider13;

// Pitch window: exactly num_osc octaves wide, centered on C in center_oct.
// Using C as anchor so the octave grid aligns with the chromatic root grid (C-B).
// Window width == num_osc means spacing is always exactly 1 octave.
center_freq = tuning_ref * pow(2, (center_oct * 12 - 57) / 12.0); // C4=261.63 at oct=4
half_width  = num_osc * 0.5;
pitch_lo    = center_freq * pow(2, -half_width);
pitch_hi    = center_freq * pow(2,  half_width);

beat_hz = bpm / 60.0;

// Smooth constant for osc gain changes (~5ms)
smooth_gain = exp(-1 / (srate * 0.005));

// Read per-note sliders
n = 0;
loop(12,
  base = 15 + n * 4;   // Active, Gain, Pan, Fine tune
  n_active[n]   = slider(base);
  n_gain_db[n]  = slider(base + 1);
  n_gain_lin[n] = pow(10, n_gain_db[n] / 20.0);
  n_pan[n]      = slider(base + 2);
  n_fine[n]     = slider(base + 3);
  // Roots at octave 4 -- bell centers on center_oct via center_freq. The fine
  // tune is applied when each oscillator is read, so it acts while playing.
  n_root[n]     = note_to_hz(n, 4, tuning_ref);
  n += 1;
);

// Show a note's Gain, Pan and Fine tune only while it is active. slider_show
// takes the slider itself; a number there is a bitmask of other sliders.
slider_show(slider16, slider15); slider_show(slider17, slider15); slider_show(slider18, slider15);
slider_show(slider20, slider19); slider_show(slider21, slider19); slider_show(slider22, slider19);
slider_show(slider24, slider23); slider_show(slider25, slider23); slider_show(slider26, slider23);
slider_show(slider28, slider27); slider_show(slider29, slider27); slider_show(slider30, slider27);
slider_show(slider32, slider31); slider_show(slider33, slider31); slider_show(slider34, slider31);
slider_show(slider36, slider35); slider_show(slider37, slider35); slider_show(slider38, slider35);
slider_show(slider40, slider39); slider_show(slider41, slider39); slider_show(slider42, slider39);
slider_show(slider44, slider43); slider_show(slider45, slider43); slider_show(slider46, slider43);
slider_show(slider48, slider47); slider_show(slider49, slider47); slider_show(slider50, slider47);
slider_show(slider52, slider51); slider_show(slider53, slider51); slider_show(slider54, slider51);
slider_show(slider56, slider55); slider_show(slider57, slider55); slider_show(slider58, slider55);
slider_show(slider60, slider59); slider_show(slider61, slider59); slider_show(slider62, slider59);

// Reinit when oscillator layout needs to change
(num_osc != last_num_osc || center_oct != last_center || tuning_ref != last_tuning) ? (
  needs_init   = 1;
  last_num_osc = num_osc;
  last_center  = center_oct;
  last_tuning  = tuning_ref;
);

// Start Delay: convert beats to seconds at the current scale BPM.
start_delay_sec = slider63 * 60 / max(bpm, 0.001);

// Play/Rest gate: integer beat counts. Both must be > 0 for the
// gate to engage; 0 in either slider disables.
play_for_beats = slider64;
rest_for_beats = slider65;
pf_base = play_for_beats; rf_base = rest_for_beats;
pr_enabled     = (play_for_beats > 0 && rest_for_beats > 0);
rest_mode      = slider66;

// Speed ramp engage-edge.
// No engage-edge detection. Engage is a freeze/resume gate handled
// in @sample. Only transport play resets ramp_t.

// Drift target selector save/restore (nested-selector pattern).
// Switching slider67 saves sliders 58-61 into the OLD target's slot,
// then loads the NEW target's stored config into sliders 58-61.
// Otherwise captures live edits to the current target's slot. All 4
// targets drift in parallel from @sample regardless of selection.
sel_target = slider67;
sel_up     = slider68;
sel_down   = slider69;
sel_per    = slider70;
sel_shape  = slider72;
sel_dplay  = slider73;
sel_drest  = slider74;

last_target_select != sel_target ? (
  target_drift_up[last_target_select]    = sel_up;
  target_drift_down[last_target_select]  = sel_down;
  target_drift_per[last_target_select]   = sel_per;
  target_drift_shape[last_target_select] = sel_shape;
  drift_play_mem[last_target_select]     = sel_dplay;
  drift_rest_mem[last_target_select]     = sel_drest;

  slider68 = target_drift_up[sel_target];
  slider69 = target_drift_down[sel_target];
  slider70 = target_drift_per[sel_target];
  slider72 = target_drift_shape[sel_target];
  slider_automate(slider68);
  slider_automate(slider69);
  slider_automate(slider70);
  slider73 = drift_play_mem[sel_target];
  slider74 = drift_rest_mem[sel_target];
  slider_automate(slider72);
  slider_automate(slider73);
  slider_automate(slider74);

  last_target_select = sel_target;
) : (
  target_drift_up[sel_target]    = sel_up;
  target_drift_down[sel_target]  = sel_down;
  target_drift_per[sel_target]   = sel_per;
  target_drift_shape[sel_target] = sel_shape;
  drift_play_mem[sel_target]     = sel_dplay;
  drift_rest_mem[sel_target]     = sel_drest;
);

// Speed ramp target selector save/restore (nested-selector, mirrors the drift
// block above). slider75 = target; slider76 = per-target `by`; slider78 =
// per-target duration; slider82 = per-target start delay (all three per-target
// as of v2.14). slider81 (engage) stays GLOBAL. Switching slider75 saves the
// three per-target sliders into the OLD target's slots, then loads the NEW
// target's stored values. Otherwise captures live edits. All targets ramp in
// parallel from @sample, each on its own duration/delay clock.
sr_sel_target = slider75;
sr_sel_by     = slider76;
sr_sel_dur    = slider78;
sr_sel_delay  = slider82;
sr_sel_play   = slider79;
sr_sel_rest   = slider80;

last_sr_target != sr_sel_target ? (
  speed_ramp_by_mem[last_sr_target]    = sr_sel_by;
  speed_ramp_dur_mem[last_sr_target]   = sr_sel_dur;
  speed_ramp_delay_mem[last_sr_target] = sr_sel_delay;
  sr_play_mem[last_sr_target]          = sr_sel_play;
  sr_rest_mem[last_sr_target]          = sr_sel_rest;
  slider76 = speed_ramp_by_mem[sr_sel_target];
  slider78 = speed_ramp_dur_mem[sr_sel_target];
  slider82 = speed_ramp_delay_mem[sr_sel_target];
  slider_automate(slider76);
  slider_automate(slider78);
  slider79 = sr_play_mem[sr_sel_target];
  slider80 = sr_rest_mem[sr_sel_target];
  slider_automate(slider82);
  slider_automate(slider79);
  slider_automate(slider80);
  last_sr_target = sr_sel_target;
) : (
  speed_ramp_by_mem[sr_sel_target]    = sr_sel_by;
  speed_ramp_dur_mem[sr_sel_target]   = sr_sel_dur;
  speed_ramp_delay_mem[sr_sel_target] = sr_sel_delay;
  sr_play_mem[sr_sel_target]          = sr_sel_play;
  sr_rest_mem[sr_sel_target]          = sr_sel_rest;
);


@block
// --- Restore-order guard for the change-detecting controls below -----------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the picker then fires and slider_automate()s
//     its ratio over a rate that was set by hand. @block cannot run before the
//     instance is configured, so adopting here is right whatever order the
//     restore paths ran in. (Proved 2026-08-23: a Sweeping Filter in BPM mode
//     with Host ratio "every 2 beats" had Rate Value stamped to 0.5 on every
//     load and every track duplicate.)
!rate_mode_inited ? ( last_rate_mode = slider2; rate_mode_inited = 1; );
// Follow the project tempo live in Host x. @slider does not re-run on a tempo
// change, so these two lines repeat here; everything else is per-sample.
rate_mode >= 3 ? (
  rate_units = slider1;
  bpm = rate_mode == 4 ? max(tempo, 0.001) * max(rate_units, 0.001)
      : rate_units > 0.001 ? max(tempo, 0.001) / rate_units : 0.001;
  start_delay_sec = slider63 * 60 / max(bpm, 0.001);
);

// --- Place the sequence from the project (Host x only) --------------------
//
// PLACE ONCE, then run -- the same approach as rhythm-track, and for the same
// reason: this steps through NOTES, so recomputing its position every sample
// would re-decide which note is sounding and jump mid-envelope. Placed on
// transport start or a seek, then left alone.
//
// A seek is spotted by comparing where this block actually starts against
// where the last block predicted it would. Normal playback agrees to well
// under the 0.25-beat threshold; a seek or loop doesn't.
//
// Walking the sequence rather than indexing it, because Skip mode steps over
// inactive notes -- so "40 beats in" is not note 40, it depends on which notes
// are switched off. The walk is bounded by taking the step count modulo the
// sequence's own period first (the active-note count in Skip, 12 in Rest), so
// a project two hours in costs the same handful of steps as one at bar 2.
//
// Consequence worth knowing, documented rather than hidden: toggling notes
// active WHILE playing changes what "where you would have been" means. It
// won't glitch -- placement only happens on play or a seek -- but two
// playbacks can differ if you flipped notes in between.
transport_moving = (play_state == 1 || play_state == 5);
rate_mode >= 3 && transport_moving ? (
  (!was_moving || abs(beat_position - predicted_beat_pos) > 0.25) ? (
    // BEATS PER CYCLE, so the step number at a given project position is the
    // beat position DIVIDED by it. This inverted with the rate conversion
    // above and had to change with it -- multiplying here while dividing there
    // would place the sequence at a different speed than it plays at.
    // Every N beats divides the beat position; N per beat multiplies it.
    seq_total = rate_mode == 4 ? max(beat_position, 0) * max(rate_units, 0.001)
              : rate_units > 0.001 ? max(beat_position, 0) / rate_units : 0;
    seq_steps = floor(seq_total);
    seq_phase = seq_total - seq_steps;

    seq_active_n = 0;
    i = 0;
    loop(12, n_active[i] ? seq_active_n += 1; i += 1;);

    skip_mode == 0 && seq_active_n > 0 ? (
      // Skip: the sequence only visits active notes, so it repeats every
      // seq_active_n steps. Walk that many, hopping over inactive notes.
      seq_steps = seq_steps % seq_active_n;
      seq_pos = 0;
      !n_active[seq_pos] ? (
        seq_tries = 0;
        loop(12, seq_tries < 12 && !n_active[seq_pos] ?
          (seq_pos = direction == 0 ? (seq_pos+1)%12 : (seq_pos+11)%12; seq_tries += 1;););
      );
      loop(seq_steps,
        seq_pos = direction == 0 ? (seq_pos+1)%12 : (seq_pos+11)%12;
        seq_tries = 0;
        loop(12, seq_tries < 12 && !n_active[seq_pos] ?
          (seq_pos = direction == 0 ? (seq_pos+1)%12 : (seq_pos+11)%12; seq_tries += 1;););
      );
    ) : (
      // Rest: inactive notes still take their beat, so it's a plain 12-step
      // cycle and the position is arithmetic.
      seq_steps = seq_steps % 12;
      seq_pos = direction == 0 ? seq_steps : (12 - seq_steps) % 12;
    );
  );
);
predicted_beat_pos = beat_position + samplesblock * max(tempo, 0.001) / (60 * srate);
was_moving = transport_moving;

@sample

// (No transport-edge reset here — Path A. REAPER re-runs @init on every
// transport play / render start, which resets all runtime state —
// sequencer, note envelopes, oscillator re-init flag (needs_init), drift
// runtime, Speed Ramp, Start Delay, Play/Rest; the drift CONFIG bank is
// preserved across those re-runs by the drift_cfg_inited guard in @init.
// See docs/v2.9-render-state-bug.md.)

// Advance each target's own ramp clock (v2.14 per-target timeline). Engage
// (slider81, GLOBAL) is the freeze/resume gate: while On, every target whose
// duration > 0 advances its own ramp_t 0->1 over its own duration, after its
// own start delay; while Off, all clocks freeze and resume from where they
// are. Only transport play (via @init) resets them. Lets different targets
// wind down over different timelines from a single engage.
slider81 ? (
  // Ramp time unit (slider77). One factor turns the block's time values into
  // seconds, so Duration and Start delay always mean the same as each other.
  // Beats is 60/project tempo, recomputed per sample so it follows a live tempo
  // change rather than remembering one.
  ramp_time_scale =
    slider77 == 3 ? 60 / max(tempo, 0.001) :
    slider77 == 2 ? 60 :
    slider77 == 1 ? 1 :
                    1 / max(beat_hz, 0.00001);
  i = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * ramp_time_scale * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        // Staircase: advance for `play`, hold for `rest`, repeat. The holds come
        // OUT of the duration rather than extending it -- the advancing step is
        // scaled by (play+rest)/play -- so Ramp duration goes on meaning "you
        // arrive in about this long".
        sr_pl = sr_play_mem[i];
        sr_rs = sr_rest_mem[i];
        sr_pr_on = sr_pl > 0 && sr_rs > 0;
        sr_hold = pr_frozen(sr_pr_accum_mem, sr_pr_resting_mem, i,
                            1.0 / (ramp_time_scale * srate), sr_pl, sr_rs);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !sr_hold ? (
          sr_step = 1.0 / (srate * speed_ramp_dur_mem[i] * ramp_time_scale);
          sr_pr_on ? sr_step *= (sr_pl + sr_rs) / sr_pl;
          speed_ramp_ramp_t_mem[i] += sr_step;
          speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
        );
      );
    );
    i += 1;
  );
);

// Per-target Speed Ramp offsets (per-target ramp progress × signed `by`). All
// 4 targets ramp in parallel; index 0 = BPM, 1 = Note Length %, 2 = Attack %,
// 3 = Release %. Applied additively at each consumption site below, alongside
// drift. Drift wave's phase advance uses a Speed-Ramp-adjusted beat_hz (BPM
// ramp only, no drift) so the wave's period in beats tracks the tempo ramp.
speed_ramp_offset_bpm     = speed_ramp_ramp_t_mem[0] * speed_ramp_by_mem[0];
speed_ramp_offset_notelen = speed_ramp_ramp_t_mem[3] * speed_ramp_by_mem[3];
speed_ramp_offset_attack  = speed_ramp_ramp_t_mem[1] * speed_ramp_by_mem[1];
speed_ramp_offset_release = speed_ramp_ramp_t_mem[2] * speed_ramp_by_mem[2];
// Drift and Speed Ramp offsets are in the plugin's OWN unit in every mode --
// BPM here, never a multiplier, even in Host x. Tried it the other way and it
// fails on the slider grid: these amount sliders step in 0.1, chosen for BPM,
// and in multiplier terms 0.1 is a 10% wander with nothing finer reachable.
// The value you want stops being settable, which is worse than the
// inconsistency it fixed. Consequence, deliberate and documented: a ramp does
// NOT stretch when the project tempo changes -- -60 stays -60 BPM.
sr_adjusted_bpm       = max(bpm + speed_ramp_offset_bpm, 10);
sr_adjusted_beat_hz   = sr_adjusted_bpm / 60.0;

// Per-target drift wave computation. 4 targets (0=BPM, 1=Note Length%,
// 2=Attack%, 3=Release%). Each gets a phase counter advancing per
// sample at rate 1 / (period_beats * samples_per_speed_ramp_adjusted_beat).
// All 4 targets share the speed-ramp-adjusted beat as their period
// reference so drift on BPM doesn't self-modulate its own rate.
i = 0;
loop(N_TARGETS,
  up    = target_drift_up[i];
  down  = target_drift_down[i];
  per   = target_drift_per[i];
  shape = target_drift_shape[i];

  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    // Drift period unit (slider71). Cycles is this plugin's own count, taken at
    // the Speed-Ramp-adjusted rate so drift does not self-modulate its period --
    // what this control always did. Seconds is wall clock. Beats counts the
    // PROJECT tempo.
    period_samples =
      slider71 == 2 ? max(per * 60 / max(tempo, 0.001) * srate, 1) :
      slider71 == 1 ? max(per * srate, 1) :
                      max(per * srate / max(sr_adjusted_beat_hz, 0.0001), 1);

    // Drift play/rest, per target, counted in PERIODS. While resting the phase
    // does not advance at all, so the offset FREEZES where it stopped rather
    // than returning to centre.
    d_frozen = pr_frozen(drift_pr_accum_mem, drift_pr_resting_mem, i,
                         1.0 / period_samples,
                         drift_play_mem[i], drift_rest_mem[i]);
    // One-armed pairs: an empty else-branch is a silent compile failure in eel2.
    d_frozen ? ( new_phase = target_drift_phase[i]; );
    !d_frozen ? (
      new_phase = target_drift_phase[i] + 1.0 / period_samples;
      new_phase >= 1.0 ? (
        new_phase -= 1.0;
        shape == 2 ? (
          target_drift_prev[i] = target_drift_curr[i];
          target_drift_curr[i] = rand(2) - 1;
        );
      );
    );
    target_drift_phase[i] = new_phase;

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = target_drift_prev[i] +
        (target_drift_curr[i] - target_drift_prev[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  target_drift_offset[i] = drift_offset_local;
  i += 1;
);

// Effective BPM: baseline + BPM drift + Speed Ramp delta, clamped at
// 10 BPM. Drift offsets for note length / attack / release fold into
// effective fractional values below.
effective_bpm = max(bpm + target_drift_offset[0] + speed_ramp_offset_bpm, 10);
// The binaural beat is drift/ramp target 28, in Hz. Computed here with the
// other effective values, once per block rather than per oscillator.
eff_binaural = max(0, binaural_hz + target_drift_offset[5]
                      + speed_ramp_ramp_t_mem[5] * speed_ramp_by_mem[5]);
effective_beat_hz = effective_bpm / 60.0;

// Effective note shape parameters: baseline % + drift offset + Speed Ramp
// offset (all in %), converted to 0..1 fractions. Clamp to keep envelope
// math sane.
effective_note_len_frac = max(0.001, min(1.0, (slider7 + target_drift_offset[3] + speed_ramp_offset_notelen) / 100.0));
effective_attack_frac   = max(0,     min(1.0, (slider5 + target_drift_offset[1] + speed_ramp_offset_attack)  / 100.0));
effective_release_frac  = max(0,     min(1.0, (slider6 + target_drift_offset[2] + speed_ramp_offset_release) / 100.0));
// Targets added 2026-09-10, each applied only while its offset is, or just
// was, non-zero.
function scale_off(t) ( target_drift_offset[t] + speed_ramp_ramp_t_mem[t] * speed_ramp_by_mem[t]; );
so4 = scale_off(4); so6 = scale_off(6); so43 = scale_off(43); so44 = scale_off(44);
(so4 != 0 || so4_was) ? pulse_duty = max(0.01, min(0.99, pulse_duty_base + so4 * 0.01));
so4_was = so4 != 0;
tref_mult = so6 != 0 ? max(20, tuning_ref + so6) / tuning_ref : 1;
(so43 != 0 || so44 != 0 || so43_was) ? (
  play_for_beats = max(0, floor(pf_base + so43 + 0.5));
  rest_for_beats = max(0, floor(rf_base + so44 + 0.5));
  pr_enabled = play_for_beats > 0 && rest_for_beats > 0;
);
so43_was = so43 != 0 || so44 != 0;

start_delay_elapsed < start_delay_sec ? (
  start_delay_elapsed += 1 / srate;
  spl0 = 0;
  spl1 = 0;
) : (

needs_init ? (
  init_oscs();
  needs_init = 0;
);

// Advance beat phase — unless we're in a Freeze-mode Play/Rest
// pause, in which case the sequencer is paused on the would-be-next
// note and seq_phase stays put until the rest timer (further down)
// fires us back into the play period. seq_phase advances at the
// effective_beat_hz (which already includes Speed Ramp's BPM offset
// + drift offsets).
in_frozen_rest = pr_enabled && pr_resting && rest_mode == 1;
!in_frozen_rest ? seq_phase += effective_beat_hz / srate;

// On beat boundary: advance sequencer to next note
seq_phase >= 1.0 ? (
  seq_phase -= 1.0;

  direction == 0 ? (
    next = (seq_pos + 1) % 12;
    skip_mode == 0 ? (
      tries = 0;
      loop(12,
        tries < 12 && !n_active[next] ? (next = (next+1)%12; tries+=1;);
      );
    );
  ) : (
    next = (seq_pos + 11) % 12;
    skip_mode == 0 ? (
      tries = 0;
      loop(12,
        tries < 12 && !n_active[next] ? (next = (next+11)%12; tries+=1;);
      );
    );
  );

  // Play/Rest gate. Check whether the beat we just completed took us
  // to the threshold for the current period; if so, flip play↔rest
  // and reset the counter. Then increment for the beat we're about
  // to (maybe) play. In Walk mode, seq_pos always advances to `next`
  // regardless of pr_resting; the env_target gate further down
  // suppresses audio during rest. In Freeze mode, seq_pos also
  // advances to `next` at the rest-entry boundary (so the frozen
  // note is the would-be-next note), but seq_phase is then pinned
  // by in_frozen_rest above so no further boundary fires until
  // rest exits.
  pr_enabled ? (
    pr_step >= (pr_resting ? rest_for_beats : play_for_beats) ? (
      just_entered_rest = !pr_resting;
      pr_resting = 1 - pr_resting;
      pr_step    = 0;
      just_entered_rest && rest_mode == 1 ? (
        // Freeze-mode rest entry: compute rest duration in samples
        // based on one beat at the current BPM. Same formula every
        // cycle (BPM is global) — unlike Melody Phase where each
        // voice's Next voice in could vary.
        pr_rest_duration_samples = rest_for_beats * srate / effective_beat_hz;
        pr_rest_elapsed = 0;
      );
    );
    pr_step += 1;
  );

  seq_pos = next;
);

// Freeze-mode rest timer. While Rest mode = Freeze AND we're in
// the rest period, count samples elapsed. When the threshold hits,
// exit rest and reset pr_step to 1 so the next beat counts as step 1
// of the new play period. seq_phase is already ~0 (we last touched
// it at the boundary that triggered rest) so the frozen note's beat
// envelope starts cleanly from the beat origin on the next sample.
// The pr_rest_duration_samples > 0 guard handles the edge case where
// the user changes Rest mode mid-rest — without the duration being
// set, the comparison would fire immediately and snap out of rest
// with inconsistent state.
pr_enabled && pr_resting && rest_mode == 1 && pr_rest_duration_samples > 0 ? (
  // Scale rest accumulation by Speed Ramp's effect on tempo so the
  // rest duration tracks effective tempo (faster ramp = shorter
  // rest wall-clock, slower ramp = longer). Use Speed-Ramp-adjusted
  // factor (excludes drift, matches the old combined_scale semantic).
  pr_rest_elapsed += sr_adjusted_bpm / max(bpm, 1);
  pr_rest_elapsed >= pr_rest_duration_samples ? (
    pr_resting               = 0;
    pr_step                  = 1;
    pr_rest_duration_samples = 0;
  );
);

cur = seq_pos;
out_l = 0;
out_r = 0;

n = 0;
loop(12,
  // Envelope target: current active note gets beat shape, all others decay to 0.
  // During Play/Rest's rest period, force env_target = 0 for the current note
  // too — the per-note smoother (n_env) handles the natural tail-out of whatever
  // was playing when rest started.
  n == cur && n_active[cur] && (!pr_enabled || !pr_resting) ? (
    seq_phase < effective_note_len_frac ? (
      env_target = beat_env(seq_phase / effective_note_len_frac, effective_attack_frac, effective_release_frac);
    ) : (
      env_target = 0;
    );
  ) : (
    env_target = 0;
  );

  // Smooth envelope — no resets, no clicks
  n_env[n] = n_env[n] * smooth_gain + env_target * (1 - smooth_gain);

  n_env[n] > 0.0001 ? (
    // Pan is drift/ramp target 16+n, in its own unit, clamped to the control.
    pan_val   = max(-100, min(100, n_pan[n] + (target_drift_offset[8 + 3 * n] + speed_ramp_ramp_t_mem[8 + 3 * n] * speed_ramp_by_mem[8 + 3 * n]))) / 100.0;
    pan_l_amt = cos((pan_val + 1) * 0.25 * $pi);
    pan_r_amt = sin((pan_val + 1) * 0.25 * $pi);

    nfine  = n_fine[n] + scale_off(9 + 3 * n);
    nratio = fine_unit == 1 ? pow(2, nfine / 12) : fine_unit == 2 ? pow(2, nfine / 1200) : 1;
    nhz    = fine_unit == 0 ? nfine : 0;
    nmod   = nfine != 0 || tref_mult != 1;
    o = 0;
    loop(num_osc,
      oi = n * NUM_OSC + o;

      bg = bell_gain(osc_freq[oi], center_freq, half_width);
      // Gain is target 4+n, and it drifts in dB -- the control's own unit.
      eff_gain_lin = pow(10, (n_gain_db[n] + (target_drift_offset[7 + 3 * n] + speed_ramp_ramp_t_mem[7 + 3 * n] * speed_ramp_by_mem[7 + 3 * n])) / 20.0);
      target_gain = bg * eff_gain_lin * n_env[n];
      osc_gain[oi] = osc_gain[oi] * smooth_gain + target_gain * (1 - smooth_gain);

      of = nmod ? osc_freq[oi] * tref_mult * nratio + nhz : osc_freq[oi];
      osc_phase_l[oi] += of / srate;
      osc_phase_l[oi] >= 1 ? osc_phase_l[oi] -= 1;
      osc_phase_r[oi] += (of + eff_binaural) / srate;
      osc_phase_r[oi] >= 1 ? osc_phase_r[oi] -= 1;

      out_l += wave_sample(osc_phase_l[oi], of / srate) * osc_gain[oi] * pan_l_amt;
      out_r += wave_sample(osc_phase_r[oi], (of + eff_binaural) / srate) * osc_gain[oi] * pan_r_amt;

      o += 1;
    );
  );

  n += 1;
);

// Normalize by oscillator count. Gain smoothing handles crossfade level.
norm = 1.0 / max(num_osc, 1);
spl0 = out_l * norm;
spl1 = out_r * norm;

);  // close start-delay else branch

@serialize
// Persist per-target drift AND speed-ramp configurations. Without this,
// only the most-recently-edited target's values survive a save/load because
// the sliders hold whichever target was selected at save time.
//
// VERSION-GUARDED (CLAUDE.md @serialize gotcha): leads with a magic marker so
// format changes degrade to defaults instead of scrambling. Magic bumped to
// 2100000 + N_TARGETS in v2.14 when Speed Ramp went PER-TARGET timeline (added
// the duration + start-delay banks); an older 2000000-base blob won't match
// and falls through to @init defaults (drift + ramp reset — acceptable, this
// is pre-release). Marker is well above any plausible first-field value and
// float32-exact (< 2^24).
// 2026-09-06: four per-target banks added (Drift play/rest, Ramp play/rest), so
// the magic bumps and the READ accepts BOTH. A bump rather than a bare append,
// because appending would let an older blob's trailing bytes land in the new
// banks -- "migrate what was RESTORED, never what was DEFAULTED". Gated on
// "this blob HAS the field", so an older blob keeps its Drift and Ramp config
// and leaves the new banks at @init's zeros, which is off.
sr_magic = 2300000 + N_TARGETS;
file_var(0, sr_magic);
sr_magic == 2300000 + N_TARGETS ? (
  file_mem(0, target_drift_up,     N_TARGETS);
  file_mem(0, target_drift_down,   N_TARGETS);
  file_mem(0, target_drift_per,    N_TARGETS);
  file_mem(0, target_drift_shape,  N_TARGETS);
  file_var(0, last_target_select);
  file_mem(0, speed_ramp_by_mem,    N_TARGETS);
  file_mem(0, speed_ramp_dur_mem,   N_TARGETS);
  file_mem(0, speed_ramp_delay_mem, N_TARGETS);
  file_var(0, last_sr_target);
  1 ? (
    file_mem(0, drift_play_mem, N_TARGETS);
    file_mem(0, drift_rest_mem, N_TARGETS);
    file_mem(0, sr_play_mem,    N_TARGETS);
    file_mem(0, sr_rest_mem,    N_TARGETS);
  );

  // TRACK-DUPLICATE FIX (v2.14). On READ (load/duplicate) file_avail(0) >= 0;
  // on WRITE (save/undo) it is < 0. @serialize is the only section guaranteed
  // to run on both load AND duplicate, so it re-establishes the bank<->slider
  // invariant here: force the visible config sliders to match the restored
  // bank for the restored selectors, correcting any transient @slider clobber
  // (which would otherwise zero whichever target was selected on the copy).
  file_avail(0) >= 0 ? (
    slider76 = speed_ramp_by_mem[last_sr_target];        // Speed ramp `by`
    slider78 = speed_ramp_dur_mem[last_sr_target];       // Speed ramp duration
    slider82 = speed_ramp_delay_mem[last_sr_target];     // Speed ramp start delay
    slider68 = target_drift_up[last_target_select];      // Drift up
    slider69 = target_drift_down[last_target_select];    // Drift down
    slider70 = target_drift_per[last_target_select];     // Drift period
    slider72 = target_drift_shape[last_target_select];   // Drift shape
    // The four new per-target sliders need this exactly as much as the ones
    // above -- they are backed by live sliders, so they are what a transient
    // @slider can clobber to zero on a track duplicate.
    slider79 = sr_play_mem[last_sr_target];
    slider80 = sr_rest_mem[last_sr_target];
    slider73 = drift_play_mem[last_target_select];
    slider74 = drift_rest_mem[last_target_select];
    sliderchange(-1);
  );
);
