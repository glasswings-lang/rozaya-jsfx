desc: Bubbler
//tags: bubble bubbles water granular pitch texture submerge
//
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/
//
// Bubbles whatever you feed it. Each bubble GRABS A SHORT GRAIN of your sound
// and resamples it UPWARD over its life: a droplet made of your material, thrown
// to a random transposition and chirping up as it fades. Scatter your sound into
// rising pitched bubbles.
//   - Transpose / Pitch spread set where each grain lands (random per bubble).
//   - Rise is how far it climbs over the grain (the bubble chirp).
// Dry/Wet blends the bubbled signal back against the original.
//
// Each voice loops its captured grain with a two-tap triangular crossfade, so a
// bubble sustains the full envelope and completes its full rise at ANY pitch
// (no running out of grain). Linear interpolation; a soft-clip bounds the wet
// output to ±1 so it can't spike into REAPER's auto-mute.
//
// POLYPHONIC: 16 voices per channel, each with its own captured grain; a new
// bubble takes the quietest voice. Effect, NOT a generator — needs input.

slider1:6<0.001,1000,0.001>Bubble rate (BPM / sec / Hz / beats per bubble / per beat)
slider3:70<0,100,1>Timing randomness (%)
// --- Transpose (R22 applied to a SHIFT, 2026-09-09) -----------------------
// Rozaya's design, and it is the thing that makes note names work on a plugin
// that did not make its audio: *"I feel like I should be able to enter, like, a
// center note to tell the plugin this is where this audio is ... it can't auto
// detect, so you gotta tell it. just leave it alone if there's no center note
// there ... if you're thinking in music theory anyway, you already have a center
// note in your head, and then you have to go out of that brain and calculate,
// okay, how many semitones down is this?"*
//
// So: `Source note` says where zero is. With it at `None` -- the default, and
// what every saved project holds -- nothing here behaves differently from the
// old `Transpose (semitones)` slider. Set it and `Target note` comes alive: pick
// what you want to hear and the shift is worked out for you.
//
// THE SEMITONE VALUE IS ALWAYS THE CONTROL. Rozaya: *"I think you can get rid of
// the note names, but I don't think you should get rid of the semitones because
// at that point, you leave people dead in the water, and that's a feature I use
// fairly frequently."* Nothing below may gate it, hide it, or take it over.
slider4:0<0,128,1{None,C-1,C#-1,D-1,D#-1,E-1,F-1,F#-1,G-1,G#-1,A-1,A#-1,B-1,C0,C#0,D0,D#0,E0,F0,F#0,G0,G#0,A0,A#0,B0,C1,C#1,D1,D#1,E1,F1,F#1,G1,G#1,A1,A#1,B1,C2,C#2,D2,D#2,E2,F2,F#2,G2,G#2,A2,A#2,B2,C3,C#3,D3,D#3,E3,F3,F#3,G3,G#3,A3,A#3,B3,C4,C#4,D4,D#4,E4,F4,F#4,G4,G#4,A4,A#4,B4,C5,C#5,D5,D#5,E5,F5,F#5,G5,G#5,A5,A#5,B5,C6,C#6,D6,D#6,E6,F6,F#6,G6,G#6,A6,A#6,B6,C7,C#7,D7,D#7,E7,F7,F#7,G7,G#7,A7,A#7,B7,C8,C#8,D8,D#8,E8,F8,F#8,G8,G#8,A8,A#8,B8,C9,C#9,D9,D#9,E9,F9,F#9,G9}>Source note (where zero is)
// Inert and hidden while Source note is None -- it has nothing to measure from.
slider5:60<0,127,1{C-1,C#-1,D-1,D#-1,E-1,F-1,F#-1,G-1,G#-1,A-1,A#-1,B-1,C0,C#0,D0,D#0,E0,F0,F#0,G0,G#0,A0,A#0,B0,C1,C#1,D1,D#1,E1,F1,F#1,G1,G#1,A1,A#1,B1,C2,C#2,D2,D#2,E2,F2,F#2,G2,G#2,A2,A#2,B2,C3,C#3,D3,D#3,E3,F3,F#3,G3,G#3,A3,A#3,B3,C4,C#4,D4,D#4,E4,F4,F#4,G4,G#4,A4,A#4,B4,C5,C#5,D5,D#5,E5,F5,F#5,G5,G#5,A5,A#5,B5,C6,C#6,D6,D#6,E6,F6,F#6,G6,G#6,A6,A#6,B6,C7,C#7,D7,D#7,E7,F7,F#7,G7,G#7,A7,A#7,B7,C8,C#8,D8,D#8,E8,F8,F#8,G8,G#8,A8,A#8,B8,C9,C#9,D9,D#9,E9,F9,F#9,G9}>Target note
// THE shift, and the control of record. Hz is measured from the tuning
// reference, which is what lets a shift be spoken in Hz at all.
slider6:12<-20000,20000,0.001>Transpose value (Hz / semitones / cents)
slider7:1<0,2,1{Hz,Semitones,Cents}>Transpose unit
slider8:0<-1000,1000,0.001>Fine tune
slider9:2<0,2,1{Hz,Semitones,Cents}>Fine tune unit
slider10:440<20,2000,0.1>Tuning reference (Hz)
slider11:7<0,24,1>Pitch spread (semitones)
slider12:12<0,36,1>Rise (semitones)
slider13:150<5,1000,1>Bubble length (ms)
slider14:80<0,100,1>Stereo width (%)
slider15:100<0,100,1>Dry/wet (%)
slider16:0<-24,12,0.01>Output (dB)

// --- Transport -----------------------------------------------------------
// Added 2026-09-05. Part 2 puts transport after the plugin's own controls and
// BEFORE drift and ramp, so the four drift/ramp blocks written earlier today
// shifted up by four to make room. Free to do, because nothing has been
// migrated yet -- this plugin gets ONE migration, at the end.
//
// A "cycle" here is one MEAN bubble interval, i.e. whatever Bubble rate is set
// to. Timing randomness still scatters the individual bubbles inside it.
slider17:0<0,1000,0.001>Start delay (in rate mode units)
slider18:0<0,1000,1>Play for (cycles)
slider19:0<0,1000,1>Rest for (cycles)
// There is no "LFO at rest" here, and deliberately: this plugin has no LFO to
// freeze. Drift carries its own play/rest, which is the equivalent control.
slider20:0<0,1,1{Pass-through,Silence}>Output at rest

// --- Drift ---------------------------------------------------------------
// Added 2026-09-05. Bubbler was built after the 2026-06 drift sweep and never
// joined it. Block copied from `veil.jsfx`, the built-and-ear-tested reference.
// Nine targets -- everything continuous the plugin has. There is no integer
// control here, so nothing has the click risk that keeps Stages off the
// Phaser's list.
//
// Bubble length is read when a bubble is BORN, so drifting it changes the
// length of new bubbles, not ones already sounding: the effect arrives over
// about one bubble rather than instantly.
// Thirteen since 2026-09-11 (R24), in the order of the controls they reach:
// Fine tune, Tuning reference, Play for and Rest for joined. The plugin remaps a
// saved nine-target setup itself (@serialize).
slider21:0<0,12,1{Bubble rate,Timing randomness,Transpose,Fine tune,Tuning reference,Pitch spread,Rise,Bubble length,Stereo width,Dry/wet,Output,Play for,Rest for}>Drift target
// Amounts are per target, in the target's own unit -- except Bubble rate,
// which is in BPM in every rate mode (the suite's settled rule: the plugin
// converts, you never do).
slider22:0<0,1000,0.01>Drift up amount (per target, units match target)
slider23:0<0,1000,0.01>Drift down amount (per target, units match target)
slider24:20<0,1000,0.01>Drift period (per target, 0 = off)
slider25:0<0,2,1{Cycles,Seconds,Beats}>Drift period unit (all targets)
// WHETHER THIS TARGET'S DRIFT MOVES WITH ITS OWN THING, OR ON A CLOCK.
// Rozaya, 2026-09-09: the choice "should have been a switch from the very
// beginning" -- both are valid artistic decisions and neither is the plugin's
// to make. INSERTED here rather than appended, on its call, with the migration
// accepted: "Don't apend when we can aford not to. we can afford not to."
//
// `With the target` advances the drift one whole step each time that target's
// own thing happens, so a period of 8 counts eight of them. `On a clock`
// advances it continuously, drawing the whole curve.
//
// DEFAULTS REPRODUCE WHAT drift_is_stepped() HARDCODED, so nothing saved moves.
slider26:0<0,1,1{With the target,On a clock}>Drift movement (per target)
slider27:0<0,2,1{Sine,Triangle,Random}>Drift shape (per target)
slider28:0<0,1000,0.01>Drift play for (per target, periods, 0 = always)
slider29:0<0,1000,0.01>Drift rest for (per target, periods, 0 = always)

// --- Ramp ----------------------------------------------------------------
slider30:0<0,12,1{Bubble rate,Timing randomness,Transpose,Fine tune,Tuning reference,Pitch spread,Rise,Bubble length,Stereo width,Dry/wet,Output,Play for,Rest for}>Ramp target
slider31:0<-1000,1000,0.001>Ramp by (per target, units match target)
slider32:2<0,3,1{Cycles,Seconds,Minutes,Beats}>Ramp time unit (all targets)
slider33:0<0,1000,0.01>Ramp duration (per target, in ramp time units)
slider34:0<0,1000,0.01>Ramp play for (per target, 0 = smooth)
slider35:0<0,1000,0.01>Ramp rest for (per target, 0 = smooth)
slider36:0<0,1,1{Off,On}>Ramp engage (all targets)
slider37:0<0,1000,0.01>Ramp start delay (per target, in ramp time units)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output


// --- Host tempo sync (sliders 10-11) ------------------------------------
// Own rate: free-running bubbles per second -- the original behaviour.
// Host x:   Bubble rate becomes beats per bubble, so 4 is one bubble every
//           is one bubble per beat. Two entries only; this plugin has one
//           unit. Appended at the END per the never-renumber rule.
slider2:2<0,4,1{BPM,Seconds,Hz,Every N beats,N per beat}>Rate mode

// Writes a multiplier into Bubble rate on change then gets out of the way.
// "Custom" (default) never writes. Not "Free" -- that means FREE-RUNNING
// in sync UI, which Own rate already is.

@init
NV = 16;                         // voices per channel
GC = ceil(srate * 0.3);          // grain length = history length (300 ms)
HALF = GC * 0.5;                 // second crossfade tap offset
histL = 0;      histR = GC;                       // per-channel input history (circular)
grainL = 2 * GC;                                  // NV captured grains, GC each
grainR = 2 * GC + NV * GC;
sc = 2 * GC + 2 * NV * GC;                        // per-voice scalar arrays (NV each)
eL = sc;         rposL = sc + NV;    ratioL = sc + 2*NV;  ageL = sc + 3*NV;
eR = sc + 4*NV;  rposR = sc + 5*NV;  ratioR = sc + 6*NV;  ageR = sc + 7*NV;
memset(0, 0, sc + 8 * NV);
wpos = 0;
seedL = 1103527590;
seedR = 1234567891;
// Bubble scheduling, 2026-09-05: COUNT UP to a target recomputed every sample,
// the same shape Heartbeat and Womb use, so a rate change lands immediately
// instead of waiting out an interval fixed when the last bubble was born.
// elapsed_* counts samples since the last bubble; jfac_* is that bubble's
// jitter as a PROPORTION of the normal gap, rolled once at birth.
// Seeded so the very first bubble arrives at once, which is what a countdown
// starting at 0 used to do.
elapsedL = 0;  elapsedR = 0;
jfacL    = 0;  jfacR    = 0;
FADE = 128;                      // ~2.7 ms onset fade

// --- Drift / Ramp state. Nine targets, 16-slot strides, placed AFTER the
//     grain buffers -- which are srate-dependent, so the base is derived, never
//     a literal. Re-derive rather than trusting any number written here.
N_TARGETS = 13;
db = sc + 8 * NV;
speed_ramp_by_mem            = db;         // CONFIG
speed_ramp_dur_mem           = db + 16;    // CONFIG
speed_ramp_delay_mem         = db + 32;    // CONFIG
speed_ramp_ramp_t_mem        = db + 48;    // RUNTIME
speed_ramp_delay_elapsed_mem = db + 64;    // RUNTIME
sr_play_mem                  = db + 80;    // CONFIG
sr_rest_mem                  = db + 96;    // CONFIG
sr_pr_resting_mem            = db + 112;   // RUNTIME
sr_pr_accum_mem              = db + 128;   // RUNTIME
drift_up_mem                 = db + 144;   // CONFIG
drift_down_mem               = db + 160;   // CONFIG
drift_per_mem                = db + 176;   // CONFIG
drift_shape_mem              = db + 192;   // CONFIG
drift_play_mem               = db + 208;   // CONFIG
drift_rest_mem               = db + 224;   // CONFIG
drift_phase_mem              = db + 240;   // RUNTIME
drift_prev_mem               = db + 256;   // RUNTIME (Random shape)
drift_curr_mem               = db + 272;   // RUNTIME (Random shape)
drift_offset_mem             = db + 288;   // RUNTIME
drift_pr_resting_mem         = db + 304;   // RUNTIME
drift_pr_accum_mem           = db + 320;   // RUNTIME
drift_step_mem               = db + 336;   // RUNTIME -- "your turn came round"
drift_moves_mem              = db + 352;   // CONFIG -- 0 with the target, 1 clock
bb_scratch                   = db + 368;   // an old save's nine, while remapping

// Old nine-target index -> new: Bubble rate, Timing randomness, Transpose stay;
// Pitch spread .. Output move up two, past Fine tune and Tuning reference.
function bb_o2n(o) ( o <= 2 ? o : o + 2; );

// WHICH TARGETS STEP, AND WHICH FLOW (2026-09-09).
//
// A target the engine reads ONCE PER EVENT was being sampled out of a wander
// that never stopped spinning: nearly all the motion was thrown away and the
// period did not count what it said. Rozaya, 2026-09-09.
//
// Here the event is A BUBBLE BEING BORN. Five values are read at that moment
// and then belong to that bubble for its whole life:
//   1 Timing randomness -- the jitter roll for the NEXT gap.
//   2 Transpose         -- baked into this bubble's playback ratio.
//   3 Fine tune         -- likewise (2026-09-11).
//   4 Tuning reference  -- likewise, for a shift said in Hz (2026-09-11).
//   5 Pitch spread      -- likewise.
// Those step once per bubble by default, so a period of 8 is eight bubbles.
//
// Everything else is read every sample and keeps drifting continuously:
//   0 Bubble rate  -- the gap is re-read every sample and compared, so the
//                     wander is expressed, not sampled; and its period is
//                     referenced against the PRE-drift rate, so it never
//                     measures itself.
//   6 Rise         -- applied inside the playback loop, per sample.
//   7 Bubble length-- feeds eff_decay, which is applied to EVERY sounding
//                     bubble every sample, not just new ones.
//   8,9,10 Stereo width / Dry-wet / Output -- continuous.
//   11,12 Play for / Rest for -- compared every sample.
//
// EVERY BIRTH COUNTS, on either channel. Nothing is tied to one side -- see the
// note at the spawn site.
function drift_is_stepped(idx) ( drift_moves_mem[idx] == 0; );

// --- Transpose block -> semitones (R22 for a shift, 2026-09-09) -----------
// Everything resolves to a SEMITONE shift, because that is what the grain ratio
// wants: ratio = 2^(semitones/12). Hz is measured FROM the tuning reference,
// which is what makes a shift expressible in Hz at all.
function bb_semis_from(u, v) local(r) (
  r = max(tuning_ref, 0.001);
  u == 0 ? 12 * log(max(r + v, 0.001) / r) / log(2) :
  u == 2 ? v / 100 :
           v;
);
// voff and foff are drift + ramp on Transpose and Fine tune, each in its own unit.
function bb_transpose_semis(voff, foff) (
  bb_semis_from(slider7, slider6 + voff) + bb_semis_from(slider9, slider8 + foff);
);
tuning_ref    = 440;
tr_ui_inited  = 0;
last_tgt_note = 60;
last_tval     = 12;
last_src_note = 0;

// Shared play/rest window counter. `tick` is how much of ONE window passes per
// sample, which lets each caller keep its own units: Drift passes
// 1/period_samples so its windows are drift periods; Ramp passes
// 1/(unit_seconds*srate) so its windows are minutes or beats. Off unless BOTH
// values are > 0.
function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

// CONFIG defaults -- ONE TIME ONLY. @init re-runs on every transport play, and
// without this guard every press of play would wipe the drift setup.
drift_cfg_inited != 1 ? (
  j = 0;
  loop(N_TARGETS,
    speed_ramp_by_mem[j] = 0;  speed_ramp_dur_mem[j] = 0;
    speed_ramp_delay_mem[j] = 0;
    sr_play_mem[j] = 0;        sr_rest_mem[j] = 0;
    drift_up_mem[j] = 0;       drift_down_mem[j] = 0;
    drift_per_mem[j] = 20;     drift_shape_mem[j] = 0;
    drift_play_mem[j] = 0;     drift_rest_mem[j] = 0;
    drift_moves_mem[j] = (j >= 1 && j <= 5) ? 0 : 1;
    j += 1;
  );
  drift_cfg_inited = 1;
);

// RUNTIME reset on EVERY @init. Phases seeded with rand so targets do not crest
// together.
j = 0;
loop(N_TARGETS,
  speed_ramp_ramp_t_mem[j] = 0;  speed_ramp_delay_elapsed_mem[j] = 0;
  sr_pr_resting_mem[j] = 0;      sr_pr_accum_mem[j] = 0;
  drift_prev_mem[j] = 0;         drift_curr_mem[j] = 0;
  drift_offset_mem[j] = 0;
  drift_pr_resting_mem[j] = 0;   drift_pr_accum_mem[j] = 0;
  drift_step_mem[j] = 0;
  j += 1;
);
// rand() is ONE stream shared with the Random drift shape in @sample. Draw
// exactly what the nine-target plugin drew, in its order, into each target's new
// place -- a draw more shifts every later Random drift in a saved project. The
// four new targets are scattered from those values instead.
j = 0;
loop(9, drift_phase_mem[bb_o2n(j)] = rand(1); j += 1;);
j = 0;
loop(4,
  bb_new_t = j == 0 ? 3 : j == 1 ? 4 : j == 2 ? 11 : 12;
  drift_phase_mem[bb_new_t] = drift_phase_mem[j] + 0.618034 * (j + 1);
  drift_phase_mem[bb_new_t] -= floor(drift_phase_mem[bb_new_t]);
  j += 1;
);

host_bpm = max(tempo, 0.001);

// Transport state. All RUNTIME: reset on every @init, i.e. every transport play,
// which is the convention here (no ext_noinit).
start_delay_elapsed = 0;
pr_resting          = 0;
pr_cycle_progress   = 0;
rest_fade           = 1;

// `tempo` is READ-ONLY in JSFX; read only, into a global not named `tempo`.

@slider
rate_mode = slider2;
// Host x: slider1 is beats per bubble. tempo/60 is beats per second, so
// dividing by the beat count gives bubbles per second -- one bubble every N
// beats. @block repeats this so a tempo change lands live.
// `rate` is bubbles per second. R20's four modes convert into it:
//   0 BPM      bubbles per minute  -> /60
//   1 Seconds  seconds per bubble  -> 1/x
//   2 Hz       bubbles per second  -> as-is   (THIS PLUGIN'S DEFAULT, see Rate Mode)
//   3 Host x   every N beats       -> (tempo/60)/x
rate      = rate_mode == 4 ? max((max(tempo,0.001)/60)*max(slider1,0.001), 0.0001)
          : rate_mode == 3 ? max((max(tempo,0.001)/60)/max(slider1,0.001), 0.0001)
          : rate_mode == 2 ? max(slider1, 0.01)
          : rate_mode == 1 ? max(1 / max(slider1, 0.001), 0.0001)
                           : max(slider1 / 60, 0.0001);
// BASELINES ONLY from here down. @sample now rebuilds each of these every
// sample as eff_*, because Drift and Ramp can move all nine. Left in place
// rather than deleted: they are provably inert (nothing downstream reads them
// since 2026-09-05) and deleting them buys nothing, which is this repo's
// standing rule for dead code. `rate` is the exception -- eff_rate is built
// from it.
jitter    = slider3 * 0.01;
// Source note says where zero is. At `None` (0) nothing here does anything and
// the semitone value stands alone, which is what every saved project holds.
// Set it and Target note comes alive: the shift is target minus source, and the
// two write to each other so either can be the one you reach for.
tuning_ref = slider10;
tr_ui_inited ? (
  slider4 > 0 && slider7 == 1 ? (
    slider5 != last_tgt_note ? (
      slider6 = slider5 - (slider4 - 1);
      slider_automate(slider6);
    ) : (slider6 != last_tval || slider4 != last_src_note) ? (
      // Moving Source note never changes the sound: it re-reads the Target note.
      slider5 = max(0, min(127, floor(slider6 + (slider4 - 1) + 0.5)));
      slider_automate(slider5);
    );
  );
);
last_tgt_note = slider5;
last_tval     = slider6;
last_src_note = slider4;
// Nothing to measure from while Source note is None, so the target is not shown.
slider_show(slider5, slider4 > 0 && slider7 == 1);

transpose = bb_transpose_semis(0, 0);
spreadSemi= slider11;
riseSemi  = slider12;
decayCoef = exp(-4 / (srate * max(slider13,1) * 0.001));   // env ~ -34 dB at the set length
width     = slider14 * 0.01;
wetmix    = slider15 * 0.01;
outlev    = 2 ^ (slider16 / 6);
meanIntv  = srate / rate;

// Start delay is expressed in RATE MODE UNITS, the same convention the Tremolo
// and the Sweeping Filter use: seconds in Seconds mode, and CYCLES in BPM, Hz
// and Host x -- so "4" waits four bubbles' worth whatever the rate means today.
start_delay_units = slider17;
start_delay_sec   = slider2 == 1 ? start_delay_units
                                  : start_delay_units / max(rate, 0.0001);
play_for_cycles = slider18;
rest_for_cycles = slider19;
pr_enabled      = play_for_cycles > 0 && rest_for_cycles > 0;
// Leaving the gate must not strand it in a rest. One-armed: an empty
// else-branch is a silent compile failure in eel2 (CLAUDE.md).
!pr_enabled && pr_resting ? ( pr_resting = 0; pr_cycle_progress = 0; );
rest_silence = slider20;

// --- Ramp target selector save/restore (nested-selector pattern) ----------
// slider30 target; 20 by; 22 duration; 23/24 play/rest; 26 start delay -- all
// per target. slider36 (engage) and slider32 (time unit) stay GLOBAL.
sel_speed_target = slider30;
last_speed_target != sel_speed_target ? (
  speed_ramp_by_mem[last_speed_target]    = slider31;
  speed_ramp_dur_mem[last_speed_target]   = slider33;
  sr_play_mem[last_speed_target]          = slider34;
  sr_rest_mem[last_speed_target]          = slider35;
  speed_ramp_delay_mem[last_speed_target] = slider37;
  slider31 = speed_ramp_by_mem[sel_speed_target];
  slider33 = speed_ramp_dur_mem[sel_speed_target];
  slider34 = sr_play_mem[sel_speed_target];
  slider35 = sr_rest_mem[sel_speed_target];
  slider37 = speed_ramp_delay_mem[sel_speed_target];
  slider_automate(slider31); slider_automate(slider33);
  slider_automate(slider34); slider_automate(slider35);
  slider_automate(slider37);
  last_speed_target = sel_speed_target;
) : (
  speed_ramp_by_mem[sel_speed_target]    = slider31;
  speed_ramp_dur_mem[sel_speed_target]   = slider33;
  sr_play_mem[sel_speed_target]          = slider34;
  sr_rest_mem[sel_speed_target]          = slider35;
  speed_ramp_delay_mem[sel_speed_target] = slider37;
);

// --- Drift target selector save/restore (same pattern) -------------------
sel_target = slider21;
last_target_select != sel_target ? (
  drift_up_mem[last_target_select]    = slider22;
  drift_down_mem[last_target_select]  = slider23;
  drift_per_mem[last_target_select]   = slider24;
  drift_shape_mem[last_target_select] = slider27;
  drift_moves_mem[last_target_select] = slider26;
  drift_play_mem[last_target_select]  = slider28;
  drift_rest_mem[last_target_select]  = slider29;
  slider22 = drift_up_mem[sel_target];
  slider23 = drift_down_mem[sel_target];
  slider24 = drift_per_mem[sel_target];
  slider27 = drift_shape_mem[sel_target];
  slider26 = drift_moves_mem[sel_target];
  slider28 = drift_play_mem[sel_target];
  slider29 = drift_rest_mem[sel_target];
  slider_automate(slider22); slider_automate(slider23);
  slider_automate(slider24); slider_automate(slider27); slider_automate(slider26);
  slider_automate(slider28); slider_automate(slider29);
  last_target_select = sel_target;
) : (
  drift_up_mem[sel_target]    = slider22;
  drift_down_mem[sel_target]  = slider23;
  drift_per_mem[sel_target]   = slider24;
  drift_shape_mem[sel_target] = slider27;
  drift_moves_mem[sel_target] = slider26;
  drift_play_mem[sel_target]  = slider28;
  drift_rest_mem[sel_target]  = slider29;
);

@block
// ADOPT THE MIRROR HERE, NOT IN @slider. A tracker adopted in @slider can
// capture a DEFAULT -- @slider may run with declared defaults before a project's
// saved values are applied, and the next pass then reads the load itself as a
// user edit and writes one half of the pair over the other. That is the August
// 2026 Sweeping Filter fault, and Breath Generator adopts in @block for exactly
// this reason. While the flag is 0 the binding writes nothing.
!tr_ui_inited ? (
  last_tgt_note = slider5;
  last_tval = slider6;
  last_src_note = slider4;
  tr_ui_inited = 1;
);
// Project tempo, once per block. Used when Drift period unit or Ramp time
// unit is set to Beats.
host_bpm = max(tempo, 0.001);
// --- Restore-order guard for the change-detecting controls below -----------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the picker then fires and slider_automate()s
//     its ratio over a rate that was set by hand. @block cannot run before the
//     instance is configured, so adopting here is right whatever order the
//     restore paths ran in. (Proved 2026-08-23: a Sweeping Filter in BPM mode
//     with Host ratio "every 2 beats" had Rate Value stamped to 0.5 on every
//     load and every track duplicate.)
// Follow the project tempo live in Host x. @slider does not re-run when the
// tempo changes, so the rate is recomputed here.
rate_mode >= 3 ? (
  rate = rate_mode == 4 ? max((max(tempo,0.001)/60)*max(slider1,0.001), 0.0001)
                        : max((max(tempo,0.001)/60)/max(slider1,0.001), 0.0001);
);

@sample
// --- Ramp clocks, one per target. Engage (slider36) is a freeze/resume gate:
//     while Off, progress HOLDS; only transport play (via @init) resets it.
//     A minute is 60 s, a beat is 60/tempo s -- recomputed per sample so a
//     tempo change is followed live in Beats mode.
// Ramp time unit. One factor turns the Ramp block's time values into seconds.
// Cycles counts THIS plugin's own cycles, referenced against the rate BEFORE
// drift and ramp touch it, so a ramp cannot alter its own clock. Seconds is
// wall clock. Minutes is 60 s and is the DEFAULT -- every saved instance has
// this control unset, so the default is what they all run on, and moving it
// would rewrite live ramps (2026-09-05). A beat is 60/tempo s, recomputed per
// sample so Beats follows a live tempo change rather than remembering one.
ramp_time_scale =
  slider32 == 3 ? 60 / max(host_bpm, 0.001) :
  slider32 == 2 ? 60 :
  slider32 == 1 ? 1 :
                  1 / max(rate, 0.00001);
slider36 ? (
  di = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[di] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[di] * ramp_time_scale * srate;
      speed_ramp_delay_elapsed_mem[di] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[di] += 1;
      ) : (
        // Staircase: advance for `play`, hold for `rest`, repeat. The holds come
        // OUT of the duration rather than extending it, so Ramp duration still
        // means "you arrive in about this long".
        sr_pl = sr_play_mem[di];
        sr_rs = sr_rest_mem[di];
        sr_pr_on = sr_pl > 0 && sr_rs > 0;
        sr_hold = pr_frozen(sr_pr_accum_mem, sr_pr_resting_mem, di,
                            1.0 / (ramp_time_scale * srate), sr_pl, sr_rs);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !sr_hold ? (
          sr_step = 1.0 / (srate * speed_ramp_dur_mem[di] * ramp_time_scale);
          sr_pr_on ? sr_step *= (sr_pl + sr_rs) / sr_pl;
          speed_ramp_ramp_t_mem[di] += sr_step;
          speed_ramp_ramp_t_mem[di] > 1.0 ? speed_ramp_ramp_t_mem[di] = 1.0;
        );
      );
    );
    di += 1;
  );
);

// --- Per-target drift wave.
di = 0;
loop(N_TARGETS,
  up    = drift_up_mem[di];
  down  = drift_down_mem[di];
  per   = drift_per_mem[di];
  shape = drift_shape_mem[di];
  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    // Cycles is the default and counts THIS plugin's own cycles, referenced
    // against the PRE-drift rate so drifting the rate cannot modulate its own
    // drift period. Seconds is wall clock. Beats follows the live tempo.
    period_samples =
      slider25 == 2 ? max(per * 60 / max(host_bpm, 0.001) * srate, 1) :
      slider25 == 1 ? max(per * srate, 1) :
                      max(per * srate / max(rate, 0.00001), 1);
    // While resting the phase does not advance, so the offset STAYS where it
    // stopped -- freeze in place, not a return to centre. The FRACTION of the
    // play value chooses where it parks: x.25 crest, x.75 trough, x.0 and x.5
    // neutral. A whole number therefore parks at no-change every time and is
    // nearly inaudible; an awkward fraction is the interesting one.
    // A STEPPED target gets a whole 1/period, but only on the sample a bubble
    // was born; a continuous one gets the usual per-sample slice. Play/rest
    // ticks on the same quantity, so "rest for N periods" keeps its meaning.
    // STEPPED targets, 2026-09-10. In the first unit, a whole 1/period on the
    // sample the target's turn comes. In Seconds or Beats the clock runs in that
    // unit ONLY while the target's own thing is happening -- here a bubble is an instant, so each birth adds
    // that bubble's own LENGTH (Rozaya: "those are in ms") -- and freezes between
    // turns -- Rozaya: "stop mid-cycle, freeze the clock mid-whatever unit, then
    // pick up on the next cycle from wherever the clock was last." So the unit
    // means what it says, and each target still keeps its own time.
    drift_is_stepped(di) ? (
      d_tick = drift_step_mem[di] ? (slider25 == 0 ? 1.0 / max(per, 0.001)
                                    : eff_len * 0.001 * srate / period_samples) : 0;
      drift_step_mem[di] = 0;
    ) : (
      d_tick = 1.0 / period_samples;
    );

    d_frozen = pr_frozen(drift_pr_accum_mem, drift_pr_resting_mem, di,
                         d_tick,
                         drift_play_mem[di], drift_rest_mem[di]);
    d_frozen ? (
      new_phase = drift_phase_mem[di];
    ) : (
      new_phase = drift_phase_mem[di] + d_tick;
      new_phase >= 1.0 ? (
        new_phase -= 1.0;
        shape == 2 ? (
          drift_prev_mem[di] = drift_curr_mem[di];
          drift_curr_mem[di] = rand(2) - 1;
        );
      );
      drift_phase_mem[di] = new_phase;
    );
    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = drift_prev_mem[di] +
        (drift_curr_mem[di] - drift_prev_mem[di]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  drift_offset_mem[di] = drift_offset_local;
  di += 1;
);

// --- Effective values = baseline + drift + ramp, every sample. Targets:
//     0 rate, 1 randomness, 2 transpose, 3 fine tune, 4 tuning reference,
//     5 spread, 6 rise, 7 length, 8 width, 9 dry/wet, 10 output,
//     11 play for, 12 rest for.
q0  = drift_offset_mem[0]  + speed_ramp_ramp_t_mem[0]  * speed_ramp_by_mem[0];
q1  = drift_offset_mem[1]  + speed_ramp_ramp_t_mem[1]  * speed_ramp_by_mem[1];
q2  = drift_offset_mem[2]  + speed_ramp_ramp_t_mem[2]  * speed_ramp_by_mem[2];
q3  = drift_offset_mem[3]  + speed_ramp_ramp_t_mem[3]  * speed_ramp_by_mem[3];
q4  = drift_offset_mem[4]  + speed_ramp_ramp_t_mem[4]  * speed_ramp_by_mem[4];
q5  = drift_offset_mem[5]  + speed_ramp_ramp_t_mem[5]  * speed_ramp_by_mem[5];
q6  = drift_offset_mem[6]  + speed_ramp_ramp_t_mem[6]  * speed_ramp_by_mem[6];
q7  = drift_offset_mem[7]  + speed_ramp_ramp_t_mem[7]  * speed_ramp_by_mem[7];
q8  = drift_offset_mem[8]  + speed_ramp_ramp_t_mem[8]  * speed_ramp_by_mem[8];
q9  = drift_offset_mem[9]  + speed_ramp_ramp_t_mem[9]  * speed_ramp_by_mem[9];
q10 = drift_offset_mem[10] + speed_ramp_ramp_t_mem[10] * speed_ramp_by_mem[10];
q11 = drift_offset_mem[11] + speed_ramp_ramp_t_mem[11] * speed_ramp_by_mem[11];
q12 = drift_offset_mem[12] + speed_ramp_ramp_t_mem[12] * speed_ramp_by_mem[12];

// Rate amounts are in BPM in EVERY rate mode -- the settled suite rule -- and
// `rate` is bubbles per second, so 60 BPM is 1 per second.
eff_rate     = max(0.0001, rate + q0 / 60);
eff_meanIntv = srate / eff_rate;
eff_jitter   = max(0, min(100, slider3 + q1)) * 0.01;
// The reference only matters to a shift said in Hz. Clamped to its slider's range.
tuning_ref   = max(20, min(2000, slider10 + q4));
eff_transp   = bb_transpose_semis(q2, q3);
eff_spread   = max(0, slider11 + q5);
eff_rise     = slider12 + q6;
// Bubble length is read at grain birth, so this changes NEW bubbles only --
// the effect arrives over about one bubble rather than instantly.
eff_len      = max(1, slider13 + q7);
eff_decay    = exp(-4 / (srate * eff_len * 0.001));
eff_width    = max(0, min(100, slider14 + q8)) * 0.01;
eff_wet      = max(0, min(100, slider15 + q9)) * 0.01;
eff_out      = 2 ^ ((slider16 + q10) / 6);
// Play for / Rest for, in cycles. The gate still switches on only when both
// SLIDERS are above zero; drift and ramp move how long each lasts.
play_for_cycles = max(0, slider18 + q11);
rest_for_cycles = max(0, slider19 + q12);

// --- Transport: start delay, then the play/rest gate ----------------------
// Start delay counts in whatever the rate mode means (seconds in Seconds mode,
// cycles otherwise), converted to seconds in @slider.
start_delay_elapsed < start_delay_sec ? ( start_delay_elapsed += 1 / srate; );

// Play/Rest advances in CYCLES at the live bubble rate, so it stretches and
// shrinks with the rate exactly as the bubbles do -- including while Drift is
// moving that rate.
pr_enabled ? (
  pr_cycle_progress += eff_rate / srate;
  !pr_resting ? (
    pr_cycle_progress >= play_for_cycles ? ( pr_resting = 1; pr_cycle_progress = 0; );
  ) : (
    pr_cycle_progress >= rest_for_cycles ? ( pr_resting = 0; pr_cycle_progress = 0; );
  );
);

// The gate stops new bubbles being BORN. Ones already sounding decay away
// naturally, which is what makes the entry into a rest smooth rather than a cut.
pr_gate = (start_delay_elapsed >= start_delay_sec) && !(pr_enabled && pr_resting);
// While gated, hold both timers at a full interval so resuming does not fire a
// burst of bubbles that queued up during the silence.
// While gated, hold both clocks at zero so resuming waits a full interval
// rather than firing a burst of bubbles that queued up during the silence.
!pr_gate ? ( elapsedL = 0; elapsedR = 0; );

// Output at rest: Pass-through leaves the input alone (rest_target 1, and the
// bubbles have already stopped); Silence mutes everything. Smoothed over ~3 ms
// so the boundary is not a click.
rest_target = (pr_enabled && pr_resting && rest_silence == 1) ? 0 : 1;
rest_smooth = exp(-1 / (srate * 0.003));
rest_fade   = rest_target + (rest_fade - rest_target) * rest_smooth;

dryL = spl0;
dryR = spl1;
histL[wpos] = dryL;
histR[wpos] = dryR;

// ---- LEFT ----
elapsedL += 1;
elapsedL >= max(eff_meanIntv * jfacL, 1) ? (
  seedL = (seedL * 48271) % 2147483647; rp = seedL / 2147483647;
  seedL = (seedL * 48271) % 2147483647; rt = seedL / 2147483647;
  vsel = 0; vmin = eL[0]; j = 1;
  loop(NV - 1, eL[j] < vmin ? (vmin = eL[j]; vsel = j); j += 1;);
  start = (wpos + 1) % GC; n1 = GC - start;
  memcpy(grainL + vsel * GC, histL + start, n1);
  memcpy(grainL + vsel * GC + n1, histL, start);
  ratioL[vsel] = 2 ^ ((eff_transp + eff_spread * (rp * 2 - 1)) / 12);
  rposL[vsel] = 0; eL[vsel] = 1; ageL[vsel] = 0;
  // Roll the jitter as a PROPORTION, not a length. The gap it applies to
  // is re-read every sample above, so drifting or ramping the rate moves
  // this bubble's due time as it goes.
  jfacL = 1 + eff_jitter * (rt * 2 - 1);
  // A bubble was born: the three values it just read take their turn.
  // EVERY birth counts, on either channel -- nothing here is tied to one
  // side. Left and right spawn independently, so when they land together you
  // hear one bubble and this takes one turn, and when Timing randomness
  // scatters them you hear two and it takes two. The count follows what is
  // actually audible instead of a channel we happened to pick.
  drift_step_mem[1] = 1; drift_step_mem[2] = 1; drift_step_mem[3] = 1;
  drift_step_mem[4] = 1; drift_step_mem[5] = 1;
  elapsedL = 0;
);
sumL = 0; j = 0;
loop(NV,
  eL[j] > 0.02 ? (
    ev = eL[j]; rp2 = rposL[j]; gb = grainL + j * GC; x = rp2 / GC;
    ipA = rp2 | 0; frA = rp2 - ipA; ipA1 = ipA + 1; ipA1 >= GC ? ipA1 -= GC;
    sA = gb[ipA] * (1 - frA) + gb[ipA1] * frA;
    wA = x < 0.5 ? 2 * x : 2 * (1 - x);
    tb = rp2 + HALF; tb >= GC ? tb -= GC;
    ipB = tb | 0; frB = tb - ipB; ipB1 = ipB + 1; ipB1 >= GC ? ipB1 -= GC;
    sB = gb[ipB] * (1 - frB) + gb[ipB1] * frB;
    xb = x + 0.5; xb >= 1 ? xb -= 1; wB = xb < 0.5 ? 2 * xb : 2 * (1 - xb);
    sumL += (sA * wA + sB * wB) * ev * min(ageL[j] / FADE, 1);
    rp2 += ratioL[j] * 2 ^ (eff_rise * (1 - ev) / 12); rp2 >= GC ? rp2 -= GC;
    rposL[j] = rp2; ageL[j] += 1; eL[j] = ev * eff_decay;
  );
  j += 1;
);

// ---- RIGHT ----
elapsedR += 1;
elapsedR >= max(eff_meanIntv * jfacR, 1) ? (
  seedR = (seedR * 69621) % 2147483647; rp = seedR / 2147483647;
  seedR = (seedR * 69621) % 2147483647; rt = seedR / 2147483647;
  vsel = 0; vmin = eR[0]; j = 1;
  loop(NV - 1, eR[j] < vmin ? (vmin = eR[j]; vsel = j); j += 1;);
  start = (wpos + 1) % GC; n1 = GC - start;
  memcpy(grainR + vsel * GC, histR + start, n1);
  memcpy(grainR + vsel * GC + n1, histR, start);
  ratioR[vsel] = 2 ^ ((eff_transp + eff_spread * (rp * 2 - 1)) / 12);
  rposR[vsel] = 0; eR[vsel] = 1; ageR[vsel] = 0;
  // Roll the jitter as a PROPORTION, not a length. The gap it applies to
  // is re-read every sample above, so drifting or ramping the rate moves
  // this bubble's due time as it goes.
  jfacR = 1 + eff_jitter * (rt * 2 - 1);
  // A bubble was born: the three values it just read take their turn.
  // EVERY birth counts, on either channel -- nothing here is tied to one
  // side. Left and right spawn independently, so when they land together you
  // hear one bubble and this takes one turn, and when Timing randomness
  // scatters them you hear two and it takes two. The count follows what is
  // actually audible instead of a channel we happened to pick.
  drift_step_mem[1] = 1; drift_step_mem[2] = 1; drift_step_mem[3] = 1;
  drift_step_mem[4] = 1; drift_step_mem[5] = 1;
  elapsedR = 0;
);
sumR = 0; j = 0;
loop(NV,
  eR[j] > 0.02 ? (
    ev = eR[j]; rp2 = rposR[j]; gb = grainR + j * GC; x = rp2 / GC;
    ipA = rp2 | 0; frA = rp2 - ipA; ipA1 = ipA + 1; ipA1 >= GC ? ipA1 -= GC;
    sA = gb[ipA] * (1 - frA) + gb[ipA1] * frA;
    wA = x < 0.5 ? 2 * x : 2 * (1 - x);
    tb = rp2 + HALF; tb >= GC ? tb -= GC;
    ipB = tb | 0; frB = tb - ipB; ipB1 = ipB + 1; ipB1 >= GC ? ipB1 -= GC;
    sB = gb[ipB] * (1 - frB) + gb[ipB1] * frB;
    xb = x + 0.5; xb >= 1 ? xb -= 1; wB = xb < 0.5 ? 2 * xb : 2 * (1 - xb);
    sumR += (sA * wA + sB * wB) * ev * min(ageR[j] / FADE, 1);
    rp2 += ratioR[j] * 2 ^ (eff_rise * (1 - ev) / 12); rp2 >= GC ? rp2 -= GC;
    rposR[j] = rp2; ageR[j] += 1; eR[j] = ev * eff_decay;
  );
  j += 1;
);

// ---- stereo width, soft-clip safety, dry/wet, output ----
wmono = (sumL + sumR) * 0.5;
wetL = wmono + eff_width * (sumL - wmono);
wetR = wmono + eff_width * (sumR - wmono);
wetL = wetL / sqrt(1 + wetL * wetL);
wetR = wetR / sqrt(1 + wetR * wetR);
spl0 = (dryL * (1 - eff_wet) + wetL * eff_out * eff_wet) * rest_fade;
spl1 = (dryR * (1 - eff_wet) + wetR * eff_out * eff_wet) * rest_fade;

wpos = (wpos + 1) % GC;

@serialize
// Bubbler had NO @serialize until 2026-09-05. Drift and Ramp remember a separate
// amount per target and that memory has to travel with the project.
// Version-guarded; the magic encodes the target count, so a format change
// degrades to @init defaults rather than to garbage. An OLD project has no blob
// at all, fails the check, and lands on defaults -- drift and ramp both off,
// which is exactly how this plugin behaved before today.
// 3600013 since 2026-09-11: thirteen targets in control order. A nine-target save
// (3500009, or 3400009 from before Drift movement) is read at its own width and
// then remapped through bb_o2n, and both remembered selectors with it. Only what
// the blob HELD is remapped: a 3400009 save never stored Drift movement, so those
// stay at @init's defaults, which are already in the new order.
function bb_remap(bank, dflt) local(k) (
  k = 0; loop(9, bb_scratch[k] = bank[k]; k += 1;);
  k = 0; loop(N_TARGETS, bank[k] = dflt; k += 1;);
  k = 0; loop(9, bank[bb_o2n(k)] = bb_scratch[k]; k += 1;);
);
bb_magic = 3600000 + N_TARGETS;
file_var(0, bb_magic);
bb_is_new = bb_magic == 3600000 + N_TARGETS;
bb_is_old = bb_magic == 3500009 || bb_magic == 3400009;
bb_n = bb_is_new ? N_TARGETS : 9;
(bb_is_new || bb_is_old) ? (
  file_mem(0, speed_ramp_by_mem,    bb_n);
  file_mem(0, speed_ramp_dur_mem,   bb_n);
  file_mem(0, speed_ramp_delay_mem, bb_n);
  file_mem(0, sr_play_mem,          bb_n);
  file_mem(0, sr_rest_mem,          bb_n);
  file_var(0, last_speed_target);
  file_mem(0, drift_up_mem,    bb_n);
  file_mem(0, drift_down_mem,  bb_n);
  file_mem(0, drift_per_mem,   bb_n);
  file_mem(0, drift_shape_mem, bb_n);
  file_mem(0, drift_play_mem,  bb_n);
  file_mem(0, drift_rest_mem,  bb_n);
  file_var(0, last_target_select);
  // Drift movement, per target. An older blob has no such field and keeps
  // @init's defaults -- which are exactly the behaviour it was written under.
  bb_magic != 3400009 ? ( file_mem(0, drift_moves_mem, bb_n); );

  bb_is_old ? (
    bb_remap(speed_ramp_by_mem, 0);   bb_remap(speed_ramp_dur_mem, 0);
    bb_remap(speed_ramp_delay_mem, 0);
    bb_remap(sr_play_mem, 0);         bb_remap(sr_rest_mem, 0);
    bb_remap(drift_up_mem, 0);        bb_remap(drift_down_mem, 0);
    bb_remap(drift_per_mem, 20);      bb_remap(drift_shape_mem, 0);
    bb_remap(drift_play_mem, 0);      bb_remap(drift_rest_mem, 0);
    bb_magic == 3500009 ? (
      bb_remap(drift_moves_mem, 1);
      drift_moves_mem[3] = 0; drift_moves_mem[4] = 0;   // new, read at bubble birth
    );
    last_speed_target  = bb_o2n(max(0, min(8, last_speed_target | 0)));
    last_target_select = bb_o2n(max(0, min(8, last_target_select | 0)));
  );

  // TRACK-DUPLICATE FIX, and it is not optional: without it a duplicated track
  // silently ZEROES whichever target is selected. On READ (load or duplicate)
  // file_avail(0) >= 0; on WRITE it is < 0. @serialize is the ONE section that
  // runs on both, so it re-establishes the bank-matches-slider invariant
  // whatever order the restore paths ran in. sliderchange(-1), NOT
  // slider_automate -- this must not write automation.
  file_avail(0) >= 0 ? (
    slider31 = speed_ramp_by_mem[last_speed_target];
    slider33 = speed_ramp_dur_mem[last_speed_target];
    slider34 = sr_play_mem[last_speed_target];
    slider35 = sr_rest_mem[last_speed_target];
    slider37 = speed_ramp_delay_mem[last_speed_target];
    slider22 = drift_up_mem[last_target_select];
    slider23 = drift_down_mem[last_target_select];
    slider24 = drift_per_mem[last_target_select];
    slider27 = drift_shape_mem[last_target_select];
    slider26 = drift_moves_mem[last_target_select];
    slider28 = drift_play_mem[last_target_select];
    slider29 = drift_rest_mem[last_target_select];
    // The selectors themselves, so a remapped old save shows the target it had.
    slider21 = last_target_select;
    slider30 = last_speed_target;
    sliderchange(-1);
  );
);
