desc: Womb Sound Generator v3
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/
//
// === v3 drift system (nested target selector) ===
//
// v2 had two flat 3-slider drift blocks (Heart drift + Breath drift)
// covering 2 targets total. v3 collapses to 5 drift sliders covering 7
// targets via a target-selector nested-pattern (same pattern resonance
// bank uses). The 7 targets: Heart BPM, S1-S2 gap, Inhale Duration,
// Top Pause, Exhale Duration, Bottom Pause, RSA depth.
//
// Workflow: pick the target you want to drift with slider 54, then set
// up amount / down amount / period / shape on sliders 55-58. The drift
// configuration for THAT target is saved automatically. Pick a different
// target — sliders 55-58 snap to that target's saved values. All seven
// targets' drifts run in parallel; the selector just chooses what
// you're currently editing.
//
// Period units auto-match the target: heartbeats for Heart BPM and
// S1-S2 gap, breath cycles for the four segments and RSA depth.
//
// Drift configurations persist across project save/load via @serialize.
//
// === Sigh mechanism ===
//
// Two new sliders (60, 61) for periodic deep-breath sighs. Set sigh
// interval to ~5 minutes and a depth multiplier; about every N minutes
// one breath's inhale will stretch by the multiplier, then return to
// normal. Models the real sleep-breathing pattern of periodic sighs.
// 0 disables.

// --- GLOBAL ---
slider1:70<1,200,1>Heart rate (BPM)
slider2:0<0,1,1{Normal,Flipped}>Master Stereo Flip

// --- HEARTBEAT ---
slider3:1.0<0.0,1.0,0.01>HB Master Volume
slider4:0<0,1,1{Off,Solo}>Heartbeat Solo
// The lub-dub gap, and in Host x it is IN BEATS -- so both halves of the
// heartbeat land where you put them on the grid, instead of the lub landing on
// the beat and the dub falling wherever a fixed millisecond count happens to
// put it at this tempo. It also retires the one control in the plugin whose
// number lived in a different order of magnitude from everything near it:
// 0.25 of a beat means a quarter of a beat at any tempo, where 120 ms only
// means something once you also hold the heart rate in your head.
//
// One slider serves both units because typing works (FX box, or Tab in the
// parameter list), so 100,000 positions is not a navigation problem -- type
// it, then nudge by ear. The step is what decides which values EXIST, and
// 0.01 reaches everything either unit needs.
slider5:120<0.01,1000,0.01>Systole (ms / beats in Host x)
slider6:1.0<0.0,1.0,0.01>S1 Volume
slider7:0.7<0.0,1.0,0.01>S2 Volume
slider8:0.3<0.0,1.0,0.01>Brightness
slider9:60<10,200,1>S1 Decay ms
slider10:25<5,100,1>S2 Decay ms
slider11:45<20,120,1>S1 Frequency Hz
slider12:120<60,300,1>S2 Frequency Hz
slider13:3.0<-15.0,15.0,0.1>HB Stereo Width ms (neg = heart right)

// --- BREATH ---
slider14:0.5<0.0,1.0,0.01>Breath Volume
slider15:0<0,1,1{Off,Solo}>Breath Solo
slider16:4.0<0.02,64.0,0.01>Inhale (sec / beats in Host x)
slider17:0.3<0.0,64.0,0.01>Top pause (sec / beats in Host x)
slider18:4.0<0.02,64.0,0.01>Exhale (sec / beats in Host x)
slider19:0.3<0.0,64.0,0.01>Bottom pause (sec / beats in Host x)
slider20:250<50,2000,1>Inhale Frequency Hz
slider21:170<50,2000,1>Exhale Frequency Hz
slider22:80<20,800,1>Breath High-pass Hz
slider23:0.3<0.0,1.0,0.01>Inhale Fade In
slider24:0.2<0.0,1.0,0.01>Inhale Fade Out
slider25:0.2<0.0,1.0,0.01>Exhale Fade In
slider26:0.3<0.0,1.0,0.01>Exhale Fade Out
slider27:2<1,4,1{Linear,Cosine,Exponential,Natural}>Fade Mode
slider28:0.5<0.0,1.0,0.01>Breath Stereo Width

// --- BLOODFLOW ---
slider29:0.7<0.0,1.0,0.01>Bloodflow Volume
slider30:0<0,1,1{Off,Solo}>Bloodflow Solo
slider31:250<20,2000,1>Bloodflow Filter Hz
slider32:0.1<0,1,0.01>Bloodflow Dicrotic Level
slider33:0.2<0.0,0.95,0.01>Bloodflow Resonance
slider34:0.15<0.005,0.5,0.005>Bloodflow Attack (proportion of cycle)
slider35:0.85<0.05,0.95,0.01>Bloodflow Decay (proportion of cycle)
slider36:0.5<0.0,1.0,0.01>Bloodflow Stereo Width

// --- BREATH POST FILTER ---
slider39:500<50,4000,1>Breath Post-filter Hz
slider40:1.5<0.5,8.0,0.1>Breath Post-filter Q

// Sit silent for N heartbeats after playback starts, then begin normally.
slider41:0<0,1000,0.01>Start Delay (beats)

// --- PLAY/REST GATES (per-layer, independent) ---
slider42:0<0,1000,1>HB: Play for (beats)
slider43:0<0,1000,1>HB: Rest for (beats)
slider44:0<0,1000,1>Breath: Play for (breaths)
slider45:0<0,1000,1>Breath: Rest for (breaths)
slider46:0<0,1000,1>Bloodflow: Play for (heartbeats)
slider47:0<0,1000,1>Bloodflow: Rest for (heartbeats)

// === Speed Ramp ===
// Ramps the selected target by `amount` over `duration` minutes, after a
// `start delay`. All five sliders live in one place. Picking a different
// target preserves the current amount under the old target's slot and
// loads the new target's saved amount into the slider (same nested
// selector pattern as the drift block below).
//
// Amount is a signed DELTA (in the target's natural units), not a
// destination — 0 means no ramp, negative means decrease this parameter
// (slower heart, shorter inhale), positive means increase it (faster
// heart, longer inhale). Each target is additive — Heart BPM ramp
// affects only the heart, not the breath cycle. (v2's organism-wide
// multiplicative wind-down was intentionally NOT carried into v3 —
// Speed Ramp is for independent fine-tuning of one parameter at a time.)
// Bloodflow stays phase-locked to heart by design (cardiac output IS
// the pulse wave) so there's no bloodflow target — see CLAUDE.md for
// the design point on whether bloodflow should ever be an independent
// layer.
slider48:0<0,9,1{Heart rate,S1-S2 gap,Inhale,Top pause,Exhale,Bottom pause,RSA depth,Breaths/min,Inhale Freq,Exhale Freq}>Ramp target
slider49:0<-2000,2000,0.1>Ramp by
slider50:0<0,60,0.1>Ramp duration (minutes)
slider51:0<0,1,1{Off,On}>Ramp engage
slider52:0<0,60,0.1>Ramp start delay (minutes)

// Breaths per minute: one-way SETUP rescale tool for the four breath
// durations — it rewrites sliders 16-19 once, preserving their I:E ratio,
// then reads 0 again. Distinct from the live "Breaths/min" Drift + Speed
// Ramp TARGET (added v2.14), which modulates the breath rate over time
// without touching the sliders. Use this to dial in a starting rate; use
// the target to wander or wind it down while playing.
slider53:0<0,30,0.1>Breaths per minute (Own BPM only; 0=off, rewrites the durations)

// === Drift (nested-selector pattern, see header) ===
// Pick a target, then sliders 55-58 hold THAT target's drift config.
// Switching the selector saves the current values to the old target's
// memory slot and loads the new target's values into the sliders.
// All seven targets' drifts run in parallel.
slider54:0<0,9,1{Heart rate,S1-S2 gap,Inhale,Top pause,Exhale,Bottom pause,RSA depth,Breaths/min,Inhale Freq,Exhale Freq}>Drift target
slider55:0<0,2000,0.1>Drift up amount (units match target)
slider56:0<0,2000,0.1>Drift down amount (units match target)
slider57:8<1,1000,1>Drift period (heartbeats or breath cycles)
slider58:0<0,2,1{Sine,Triangle,Random}>Drift shape

// Heart with breath — RSA baseline coupling depth.
// The RSA depth drift target (slider54=6) wanders THIS baseline value.
slider59:0<0,30,0.1>Heart with breath (BPM peak-to-peak)

// === Sighs ===
// Periodic deep breaths. Sigh interval = average minutes between sighs.
// When a sigh fires, the next breath's inhale stretches by the depth
// multiplier (and reads as deeper because the longer inhale envelope
// rises higher under the same fade shape). 0 interval = no sighs.
slider60:0<0,30,0.1>Sigh interval (minutes, 0=off)
slider61:1.5<1.0,3.0,0.05>Sigh depth multiplier

// --- Host tempo sync (sliders 62-64) ------------------------------------
// Own BPM: free-running, project tempo ignored -- original behaviour.
// Host x:  the rates named in the sync target list below are set in BEATS of
//          the project tempo, and follow it when it changes.
//
// This block replaces the two named-ratio pickers it used to take (a "Host
// ratio" menu for the heart, a "Breath rate" menu for the breath, and a raw
// beats-per-breath number hidden behind the second one). Three reasons it is
// shaped this way instead:
//
//   * A menu of ratios is a GRID. Its entries were fixed fractions of the
//     beat, so one cycle every 5 beats of a 4/4 bar -- an ordinary want in
//     phase music, and the reason this suite syncs by multiplier rather than
//     by note value -- was not on the list at all. A plain number has no
//     entries to be missing from.
//   * One pair of controls covers every rate the plugin has, however many
//     that turns out to be. The breath needed its own pair only because the
//     heart's picker could not point at anything but the heart.
//   * It is the shape Drift and Speed Ramp already use -- pick a target,
//     set its value -- so it is the third instance of one idiom rather than
//     a fourth thing to learn. This plugin is navigated one control at a
//     time through REAPER's parameter list; a control saved is real.
//
// The rate slider each target owns STAYS VISIBLE and stays live. Heart rate
// keeps reading in BPM in both modes (it is no longer a multiplier of the
// tempo -- see the migration in @serialize), so it shows what the sync is
// actually running at, and moving it by hand converts back into beats rather
// than being ignored. Nothing here hides a control because a mode changed.
slider62:0<0,1,1{Own BPM,Host x}>Rate Mode

// Which rate the beats value below is setting. Extend by APPENDING, never by
// inserting -- these indices are stored in projects.
slider63:0<0,0,1{Heart rate}>Host sync target

// One cycle of the selected target takes this many project beats. Free and
// continuous on purpose: 5 beats is exactly as reachable as 4, and so is 5.3,
// which is how two instances are made to slip against each other.
// Step 0.01 -- in the parameter list you can only arrow, never type, so a
// value the step cannot land on is a value that does not exist.
slider64:1<0.25,64,0.01>Every N beats (Host x)

// Slider 64 is the EDITOR. The numbers themselves live in a memory bank saved
// with the project (host_beats_mem, see @init), which is how Drift and Speed
// Ramp have always stored their per-target settings. They were briefly two
// hidden sliders instead; that was wrong twice over -- REAPER's parameter list
// shows every parameter whether or not slider_show() hides it, so they were
// never hidden at all, and a slider that looks editable but is really the
// plugin's notepad invites an edit that means nothing. (Rozaya, 2026-08-30:
// "that looks internal. And I don't know why that's there.")

@init
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: REAPER re-runs @init on every transport play / render
// start, resetting all runtime for free (heartbeat/breath/bloodflow state
// machines, oscillators, filters, HB delay buffer, drift runtime, Speed
// Ramp, Start Delay, Play/Rest per layer, BPM smoother, sigh timer, noise
// seeds). Only the drift + Speed Ramp CONFIG banks must survive the
// re-run; they're guarded by drift_cfg_inited below.

// Host tempo capture. `tempo` is READ-ONLY in JSFX; read only, into a
// global deliberately not named `tempo`. Nothing remembers it across play.
host_bpm = max(tempo, 0.001);

srate_inv = 1.0 / srate;
two_pi = 2.0 * $pi;
israte2 = 2.0 / srate;

// --- HEARTBEAT INIT ---
s1_freq = 45.0; s2_freq = 120.0;
s1_phase_osc_near = 0; s1_phase_osc_far = 0;
s2_phase_osc_near = 0; s2_phase_osc_far = 0;

cycle_len_base = floor(srate * 60.0 / 70.0);
cycle_len = cycle_len_base;
systole_samples = floor(srate * 120.0 * 0.001);
sys_unit_sec    = 0.001;
s1_vol = 1.0;
s2_vol = 0.7;
s1_decay = exp(-srate_inv / 0.060);
s2_decay = exp(-srate_inv / 0.025);
s1_attack_rate = exp(-srate_inv / 0.008);
s2_attack_rate = exp(-srate_inv / 0.004);

hb_delay_buf_size = 4096;
memset(0, 0, hb_delay_buf_size);
hb_delay_write = 0;
hb_delay_samples = floor(srate * 0.003);
hb_delay_sign = 1;

hb_phase = 0;
s1_active = 1; s2_active = 0;
s1_env = 1.0; s2_env = 0;
s1_attack_phase = 0; s2_attack_phase = 0;

s1_res_f_near = min(2.0 * sin($pi * 50.0 * srate_inv), 0.98);
s1_res_q_near = 2.8; s1_res_low_near = 0; s1_res_band_near = 0;
s2_res_f_near = min(2.0 * sin($pi * 138.0 * srate_inv), 0.98);
s2_res_q_near = 2.0; s2_res_low_near = 0; s2_res_band_near = 0;
lp_f_near = min(2.0 * sin($pi * 200.0 * srate_inv), 0.98);
lp_low_near = 0; lp_band_near = 0; lp_low2_near = 0; lp_band2_near = 0;

s1_res_f_far = min(2.0 * sin($pi * 58.0 * srate_inv), 0.98);
s1_res_q_far = 2.2; s1_res_low_far = 0; s1_res_band_far = 0;
s2_res_f_far = min(2.0 * sin($pi * 150.0 * srate_inv), 0.98);
s2_res_q_far = 1.6; s2_res_low_far = 0; s2_res_band_far = 0;
lp_f_far = min(2.0 * sin($pi * 175.0 * srate_inv), 0.98);
lp_low_far = 0; lp_band_far = 0; lp_low2_far = 0; lp_band2_far = 0;
lp_q = 0.5;

// --- BREATH INIT ---
breath_state = 0;
breath_state_pos = 0;
breath_state_len = floor(srate * 4.0);

in_lp_l = 0; in_bp_l = 0; in_lp_r = 0; in_bp_r = 0;
ex_lp_l = 0; ex_bp_l = 0; ex_lp_r = 0; ex_bp_r = 0;
hp_lp_l = 0; hp_lp_r = 0;

bpf_low_l = 0; bpf_band_l = 0;
bpf_low_r = 0; bpf_band_r = 0;
bpf_f = min(2.0 * sin($pi * 500.0 * srate_inv), 0.98);
bpf_q = 0.5;

in_f_l = min(2.0 * sin($pi * 250.0 * srate_inv), 0.98);
in_f_r = min(2.0 * sin($pi * 240.0 * srate_inv), 0.98);
ex_f_l = min(2.0 * sin($pi * 170.0 * srate_inv), 0.98);
ex_f_r = min(2.0 * sin($pi * 160.0 * srate_inv), 0.98);
hp_f   = min(2.0 * sin($pi * 80.0 * srate_inv), 0.98);
breath_lp_q = 0.6;
br_floor = 0.15;

inhale_len = floor(srate * 4.0);
top_len    = floor(srate * 0.3);
exhale_len = floor(srate * 4.0);
bot_len    = floor(srate * 0.3);

// --- BLOODFLOW INIT ---
bf_n3_l = 0; bf_n4_l = 0;
bf_n3_r = 0; bf_n4_r = 0;
bf_filter_hz      = 250.0;
bf_dicrotic_level = 0.1;
bf_res            = 0.2;
bf_attack         = 0.15;
bf_decay          = 0.85;
bf_stereo_width   = 0.5;
bf_floor          = 0.25;

// --- NOISE SEEDS ---
ns1 = 12345; ns2 = 67890; ns3 = 54321;
ns4 = 11111; ns5 = 22222; ns6 = 33333;

function apply_fade(pos, fade_in, fade_out, mode) local(raw, t) (
  raw = 1.0;
  pos < fade_in ? (
    t = pos / fade_in;
    mode == 1 ? raw = t :
    mode == 2 ? raw = 0.5 - 0.5 * cos(t * $pi) :
    mode == 3 ? raw = t * t :
    raw = sin(t * $pi * 0.5);
  ) : pos > (1.0 - fade_out) ? (
    t = (pos - (1.0 - fade_out)) / fade_out;
    mode == 1 ? raw = 1.0 - t :
    mode == 2 ? raw = 0.5 + 0.5 * cos(t * $pi) :
    mode == 3 ? raw = (1.0 - t) * (1.0 - t) :
    raw = cos(t * $pi * 0.5);
  );
  raw;
);

// Start Delay state.
// (last_play_state removed in v2.10 Path A — no transport-edge handler
// anymore; @init re-running on play is the reset.)
start_delay_elapsed = 0;
start_delay_sec     = 0;

// --- Play/Rest state (per-layer, independent) ---
pr_hb_resting    = 0;
pr_hb_beat       = 1;
play_for_hb      = 0;
rest_for_hb      = 0;
pr_hb_enabled    = 0;
this_hb_has_beat = 1;
pr_br_resting            = 0;
pr_br_breath             = 0;
pr_br_rest_elapsed       = 0;
pr_br_rest_duration_samples = 0;
play_for_br              = 0;
rest_for_br              = 0;
pr_br_enabled            = 0;
total_breath_samples     = 0;
pr_bf_resting    = 0;
pr_bf_beat       = 0;
play_for_bf      = 0;
rest_for_bf      = 0;
pr_bf_enabled    = 0;
bf_output_mix    = 1;
pr_smooth = exp(-1 / (srate * 0.003));

// BPM smoother state.
rate_smoother_coeff      = 1.0 - exp(-1.0 / (srate * 0.1));
bpm_target               = slider1;
breath_host_scale = 1;

// Host-sync trackers. All of them are ADOPTED IN @block, not here and not in
// @slider -- see the note at the top of @block. hs_inited stays 0 until then,
// and while it is 0 the sync block in @slider writes nothing at all, which is
// the safe direction to fail in.
hs_inited = 0; last_hs_sel = 0; last_hs_beats = 1; hs_s1_shown = slider1;
// Set by @serialize when the blob it just read predates the beats bank
// (host_beats_seed_pending) and/or heart-rate-in-BPM (host_bpm_migration_pending).
host_beats_seed_pending = 0; host_bpm_migration_pending = 0;
bpm_smoothed             = slider1;

// Speed ramp state. ramp_t advances 0->1 over slider50 minutes while
// engaged. The target selector (slider48) picks which parameter to ramp;
// only that parameter's effective value gets an additive offset. All
// targets are additive — Heart BPM ramp affects only the heart, not the
// breath cycle (the v2 multiplicative all-three-layers wind-down was
// intentionally NOT carried into v3 — Speed Ramp is for independent
// fine-tuning of one parameter at a time).
// Engage (global) is a freeze/resume gate; only transport play resets the
// per-target ramp clocks. As of v2.14 the ramp is PER-TARGET: each target has
// its own `by`, duration, start delay, and progress clock (banks below).

// Per-target memory bank for stored amounts (signed deltas). Lets the
// user configure an amount for Heart BPM (e.g. -35), switch the selector
// to Inhale, configure an amount there (e.g. +4 sec), and have the
// Heart BPM amount preserved for when they switch back. Same pattern as
// the drift system. 7 targets × 1 value = 7 slots; free at 8320 (after
// the drift 16-slot-aligned blocks ending at 8319). CONFIG — contents
// initialized in the drift_cfg_inited guard below so they survive the
// @init re-run on transport play (Path A).
speed_ramp_target_value_mem = 8320;

// Speed ramp per-target timeline banks (v2.14). duration + start-delay are
// CONFIG (survive transport, restored by @serialize); ramp_t + delay_elapsed
// are RUNTIME (reset every @init / transport play). 16-slot-aligned above the
// `by` bank.
speed_ramp_dur_mem           = 8336;  // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 8352;  // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 8368;  // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 8384;  // delay sample counter per target (RUNTIME)

// --- Host-sync per-target beats (2026-08-30) ---
// One cycle of each sync target takes this many project beats. CONFIG:
// restored by @serialize, so it survives transport and reload. Slider 64 is
// the editor over it, exactly as Drift's amount sliders edit their banks.
// 16-slot-aligned like the rest, so targets can be APPENDED later -- and they
// will be; two is where this starts, not where it stops.
// CONTENTS are seeded in the drift_cfg_inited guard below, NOT here: this
// plugin has no ext_noinit, so @init re-runs on every transport play, and a
// default written here would reset the heart to one-per-beat and the breath to
// sixteen every time you pressed play. (Which is exactly what it did -- found
// by ear, 2026-08-30. The address itself is fine unguarded; it is a constant.)
// One target today. The breath used to be the second, until it turned out the
// breath does not want a cycle LENGTH at all -- it wants its four segments to
// be in beats, which is Model B below. Targets APPEND here as they arrive
// (Sigh interval is the obvious next one).
N_HS_TARGETS  = 1;      // 0 = Heart rate
HS_HEART      = 0;
HS_BANK_SLOTS = 2;      // serialised width, frozen so the blob format holds
host_beats_mem = 8400;

// --- v3 Drift target memory banks ---
//
// 7 targets × 7 fields = 49 slots. Each array is 16-slot-aligned so
// there's room to grow targets later (up to 16) without re-laying-out.
// Memory above hb_delay_buf_size (4096) is free for our use.
//
// Targets:
//   0 = Heart BPM
//   1 = S1-S2 gap (Systole ms)
//   2 = Inhale Duration
//   3 = Top Pause
//   4 = Exhale Duration
//   5 = Bottom Pause
//   6 = RSA depth (Heart with breath BPM peak-to-peak)
//   7 = Breaths/min (aggregate — scales all four breath segments in
//       lockstep, preserving I:E ratio; units = breaths per minute, signed)
//   8 = Inhale Freq (breath-noise filter cutoff for the inhale, Hz)
//   9 = Exhale Freq (breath-noise filter cutoff for the exhale, Hz)
N_TARGETS = 10;
target_drift_up     = 8192;   // [0..6]  configured amount, units match target
target_drift_down   = 8208;   // [0..6]
target_drift_per    = 8224;   // [0..6]  in heartbeats (targets 0,1) or breath cycles (2-6)
target_drift_shape  = 8240;   // [0..6]
target_drift_phase  = 8256;   // [0..6]  runtime: [0, 1) advancing per sample
target_drift_prev   = 8272;   // [0..6]  runtime: Random shape previous random target
target_drift_curr   = 8288;   // [0..6]  runtime: Random shape current random target
target_drift_offset = 8304;   // [0..6]  computed each sample, consumed by audio path

// Initialize all per-target state to zero (no drift, sine shape, fresh phase).
// Note: ext_noinit prevents zeroing on transport play, but @init still runs
// on plugin load — so this initializes a fresh instance. @serialize below
// restores saved configs on project reload.
// CONFIG banks (drift up/down/period/shape + the Speed Ramp `by` bank +
// selector trackers) — initialized ONCE per instance, guarded by
// drift_cfg_inited so the @init re-run on every transport play (Path A
// render fix, no ext_noinit) does NOT wipe the user's setup. @serialize
// below restores saved configs on project reload.
drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_TARGETS,
    speed_ramp_target_value_mem[i] = 0;
    speed_ramp_dur_mem[i]          = 0;
    speed_ramp_delay_mem[i]        = 0;
    i += 1;
  );
  last_speed_target = 0;
  i = 0;
  loop(N_TARGETS,
    target_drift_up[i]    = 0;
    target_drift_down[i]  = 0;
    target_drift_per[i]   = 8;   // heartbeats (targets 0,1) / breath cycles (2-6)
    target_drift_shape[i] = 0;
    i += 1;
  );
  last_target_select = 0;
  // Host-sync beats: CONFIG, same as everything else in this guard.
  host_beats_mem[HS_HEART] = 1;     // one heartbeat per beat
  host_beats_mem[1]        = 0;     // retired slot, kept for blob width
  drift_cfg_inited = 1;
);

// Drift + speed-ramp RUNTIME (phase / random-shape targets / computed offset /
// ramp clocks) resets on EVERY @init — i.e. every transport play — so
// Sine/Triangle drift restarts at phase 0 (deterministic renders).
i = 0;
loop(N_TARGETS,
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  i += 1;
);
i = 0;
loop(N_TARGETS,
  target_drift_phase[i]  = 0;
  target_drift_prev[i]   = 0;
  target_drift_curr[i]   = 0;
  target_drift_offset[i] = 0;
  i += 1;
);

// One-way BPM rescale state.
last_bpm = slider53;

// --- Sigh mechanism ---
// Pure wall-clock timer (no scaling — 5-minute interval is 5 real minutes
// regardless of Speed Ramp or drift state). When timer crosses interval and
// we're at a state 3 -> 0 transition, sigh_active flips to 1 for the
// full duration of the next breath (all four states). At each state
// transition during a sigh, breath_state_len is set from the CURRENTLY
// drifted segment length × slider61 (depth multiplier) — so the sigh
// breath inherits whatever drift wander is current for each segment,
// scaled by the depth. sigh_active clears at the next 3->0 transition
// (and may re-arm immediately if the timer fires again).
sigh_time_since_last = 0;
sigh_active          = 0;

@slider
// --- Host tempo sync -------------------------------------------------------
// The beats value (slider 64) and the selected target's own rate slider are
// two views of ONE number, and whichever the user moved is the one that wins.
// Every hs_* tracker is adopted in @block, never here: on a fresh or
// duplicated instance @slider runs while REAPER is still handing over the
// saved values, so a tracker adopted here takes a DEFAULT, and the real value
// arriving a moment later reads as a user edit -- which is how a picker came
// to stamp 0.5 over a hand-set rate on every load. (Proved 2026-08-23.)
rate_mode = slider62;
hs_sel    = min(N_HS_TARGETS - 1, max(0, slider63));  // clamped: this indexes a bank,
                                                     // and a project saved under the old
                                                     // Host ratio menu can hold up to 15

// Adopt HERE as well as in @block, and this is the correction to a bug that
// made the whole block dead while the transport was stopped.
//
// @block only runs when audio is being processed. Configuring a fresh instance
// with the transport stopped, which is exactly how this plugin gets used, meant
// hs_inited stayed 0, every case below was skipped, and moving 'Every N beats'
// wrote nothing at all -- then pressing play adopted and case (d) dragged the
// slider back to the bank. Set 5, press play, get the default back.
//
// Adopting in @slider is the pattern that is normally WRONG (CLAUDE.md,
// 2026-08-23) because a tracker adopted there can capture a default during a
// project restore and read the real value, arriving later, as a user edit. It
// is safe HERE, and the difference is worth being precise about: that bug bites
// controls which write a DIFFERENT slider through a lookup table, so a default
// index maps to a wrong value that then sticks. Case (c) below copies the beats
// value VERBATIM into a bank, and both sides are saved together -- so the worst
// a mistimed restore can do is write the restored value over the identical
// restored value. There is no table and no transformation to get wrong.
//
// The @block adopt stays as a backstop for whichever runs first.
!hs_inited ? (
  last_hs_sel   = hs_sel;
  last_hs_beats = slider64;
  hs_s1_shown   = slider1;
  hs_inited     = 1;
);

(hs_inited && rate_mode == 1) ? (
  // (a) The heart's BPM slider moved by hand. hs_s1_shown is what WE last put
  //     there, so this fires only on a real move. The threshold is above the
  //     slider's own step-rounding (step 1) and below any deliberate nudge,
  //     so REAPER re-quantising our readout can never read as an edit.
  abs(slider1 - hs_s1_shown) > 0.6 ? (
    host_beats_mem[HS_HEART] = max(0.25, min(64, max(tempo, 0.001) / max(slider1, 0.001)));
    hs_s1_shown = slider1;
  );

  hs_sel != last_hs_sel ? (
    // (b) Selector moved: show the new target's own number. Writes nothing --
    //     the rate you set for the other target keeps running untouched, the
    //     same way switching Drift's target does not stop the other drifts.
    slider64 = host_beats_mem[hs_sel];
    slider_automate(slider64);
  ) : (
    slider64 != last_hs_beats ? (
      // (c) The beats value moved: it is the truth, so store it on the target.
      //     Writing a BANK rather than a slider is also what makes this safe:
      //     assigning to a slider only sets a variable, and REAPER hands its
      //     own copy back on the next pass unless you announce the write --
      //     which is exactly how the breath's beats silently reverted when
      //     these lived in hidden sliders. A bank has no such second copy.
      host_beats_mem[hs_sel] = slider64;
    ) : (
      // (d) The stored value moved underneath us (case (a), or a project
      //     load). Follow it, so the two views can never sit there
      //     disagreeing about the same number.
      host_beats_mem[hs_sel] != slider64 ? (
        slider64 = host_beats_mem[hs_sel];
        slider_automate(slider64);
      );
    );
  );
);
last_hs_sel   = hs_sel;
last_hs_beats = slider64;

// --- Landing in Host x, and landing SILENTLY -------------------------------
// Both layers keep exactly what they were doing. The heart's current BPM is
// converted into the beats that reproduce it at this tempo; the breath's four
// segments are converted from seconds into the beats of the same length.
// Nothing you can hear changes at the switch -- the tempo takes over, and the
// numbers keep reading in whatever unit their names now claim.
//
// The old behaviour was worse and this is why the landing existed at all: BPM
// used to become a MULTIPLIER in Host x, so 70 meant seventy times the project
// tempo, and switching mode handed you that. Nothing multiplies now, so there
// is no absurd value to defend against and continuity is available instead.
//
// Guarded on a real in-session mode CHANGE, so opening a saved project never
// overwrites a hand-tuned rate.
rate_mode_inited && last_rate_mode != rate_mode ? (
  rate_mode == 1 ? (
    host_beats_mem[HS_HEART] = max(0.25, min(64, max(tempo, 0.001) / max(slider1, 0.001)));
    slider64 = host_beats_mem[min(N_HS_TARGETS-1, max(0, slider63))];
    slider_automate(slider64);
    last_hs_beats = slider64;
    hs_s1_shown   = slider1;
    // The four breath sliders change UNIT here, so convert them, or a 4-second
    // inhale would silently become a 4-BEAT one. Seconds -> beats at the
    // current tempo keeps the breath sounding identical across the switch,
    // and the numbers stay readable in the unit their name now claims.
    br_u = max(tempo, 0.001) / 60;
    slider16 = min(64, max(0.02, slider16 * br_u));
    slider17 = min(64, max(0,    slider17 * br_u));
    slider18 = min(64, max(0.02, slider18 * br_u));
    slider19 = min(64, max(0,    slider19 * br_u));
    // Systole too: milliseconds -> beats of the same length.
    slider5 = min(1000, max(0.01, slider5 * br_u * 0.001));
    sliderchange(-1);
  );
  // ...and back the other way, for the same reason.
  rate_mode == 0 ? (
    br_u = 60 / max(tempo, 0.001);
    slider16 = min(64, max(0.02, slider16 * br_u));
    slider17 = min(64, max(0,    slider17 * br_u));
    slider18 = min(64, max(0.02, slider18 * br_u));
    slider19 = min(64, max(0,    slider19 * br_u));
    slider5  = min(1000, max(0.01, slider5 * br_u * 1000));
    sliderchange(-1);
  );
  last_rate_mode = rate_mode;
);

// --- Show only what applies ------------------------------------------------
// Heart rate is NEVER hidden. It reads in BPM in both modes, so in Host x it
// is the readout of what the sync is running at, and it is still a control --
// moving it converts back into beats above. Hiding a rate because a mode
// changed is what this whole block exists to undo.
//
// Breaths per minute rewrites sliders 16-19, which cannot be redone on every
// tempo change without writing automation on all four, so it stays an Own BPM
// control and hides rather than sitting there inert.
slider_show(slider53, rate_mode != 1);
slider_show(slider63, rate_mode == 1);
slider_show(slider64, rate_mode == 1);

// Heart rate is plain BPM in both modes. In Host x it is derived from the
// beats value against the project tempo; @block repeats this so a tempo change
// is followed live (@slider does not re-run for one).
bpm_target = rate_mode == 1
  ? max(tempo, 0.001) / max(host_beats_mem[HS_HEART], 0.25)
  : slider1;
systole_samples = floor(srate * slider5 * (rate_mode == 1 ? 60 / max(tempo, 0.001) : 0.001));
s1_vol = slider6;
s2_vol = slider7;
s1_freq = slider11; s2_freq = slider12;

s1_center_near = slider11 * 1.1; s2_center_near = slider12 * 1.15;
s1_center_far  = slider11 * 1.28; s2_center_far = slider12 * 1.25;
lp_cutoff_near = 200.0 + slider8 * 250.0;
lp_cutoff_far  = 175.0 + slider8 * 220.0;

s1_res_f_near = min(2.0 * sin($pi * s1_center_near * srate_inv), 0.98);
s2_res_f_near = min(2.0 * sin($pi * s2_center_near * srate_inv), 0.98);
lp_f_near = min(2.0 * sin($pi * lp_cutoff_near * srate_inv), 0.98);
s1_res_f_far = min(2.0 * sin($pi * s1_center_far * srate_inv), 0.98);
s2_res_f_far = min(2.0 * sin($pi * s2_center_far * srate_inv), 0.98);
lp_f_far = min(2.0 * sin($pi * lp_cutoff_far * srate_inv), 0.98);

s1_decay = exp(-srate_inv / (slider9 * 0.001));
s2_decay = exp(-srate_inv / (slider10 * 0.001));

hb_delay_samples = floor(srate * abs(slider13) * 0.001);
hb_delay_samples = min(hb_delay_samples, hb_delay_buf_size - 1);
new_hb_sign = slider13 >= 0 ? 1 : -1;
new_hb_sign != hb_delay_sign ? (
  s1_res_low_near = 0; s1_res_band_near = 0;
  s2_res_low_near = 0; s2_res_band_near = 0;
  lp_low_near = 0; lp_band_near = 0; lp_low2_near = 0; lp_band2_near = 0;
  s1_res_low_far = 0; s1_res_band_far = 0;
  s2_res_low_far = 0; s2_res_band_far = 0;
  lp_low_far = 0; lp_band_far = 0; lp_low2_far = 0; lp_band2_far = 0;
  memset(0, 0, hb_delay_buf_size);
);
hb_delay_sign = new_hb_sign;

// Breath: one-way BPM rescale of the four phase duration sliders.
slider53 != last_bpm && slider53 > 0 ? (
  current_total_sec = slider16 + slider17 + slider18 + slider19;
  current_total_sec > 0.1 ? (
    target_total_sec = 60.0 / slider53;
    rescale_ratio    = target_total_sec / current_total_sec;
    slider16 *= rescale_ratio; slider_automate(slider16);
    slider17 *= rescale_ratio; slider_automate(slider17);
    slider18 *= rescale_ratio; slider_automate(slider18);
    slider19 *= rescale_ratio; slider_automate(slider19);
  );
);
last_bpm = slider53;

inhale_len = max(floor(srate * slider16), 1);
top_len    = max(floor(srate * slider17), 1);
exhale_len = max(floor(srate * slider18), 1);
bot_len    = max(floor(srate * slider19), 1);

breath_state == 0 ? breath_state_len = inhale_len;
breath_state == 1 ? breath_state_len = top_len;
breath_state == 2 ? breath_state_len = exhale_len;
breath_state == 3 ? breath_state_len = bot_len;
breath_state_pos = min(breath_state_pos, breath_state_len - 1);

in_f_l = min(2.0 * sin($pi * (slider20 * (1.0 + slider28 * 0.15)) * srate_inv), 0.98);
in_f_r = min(2.0 * sin($pi * (slider20 * (1.0 - slider28 * 0.15)) * srate_inv), 0.98);
ex_f_l = min(2.0 * sin($pi * (slider21 * (1.0 + slider28 * 0.12)) * srate_inv), 0.98);
ex_f_r = min(2.0 * sin($pi * (slider21 * (1.0 - slider28 * 0.12)) * srate_inv), 0.98);
hp_f   = min(2.0 * sin($pi * slider22 * srate_inv), 0.98);

// Bloodflow
bf_filter_hz      = slider31;
bf_dicrotic_level = slider32;
bf_res            = slider33;
bf_attack         = max(slider34, 0.001);
bf_decay          = max(slider35, 0.001);
bf_stereo_width   = slider36;

bf_attack + bf_decay > 1.0 ? (
  bf_attack = slider34 / (slider34 + slider35);
  bf_decay  = slider35 / (slider34 + slider35);
);

bpf_f = min(2.0 * sin($pi * slider39 * srate_inv), 0.98);
bpf_q = 1.0 / slider40;

start_delay_sec = slider41 * 60 / max(bpm_target, 0.001);

// Play/Rest reads.
play_for_hb   = slider42;
rest_for_hb   = slider43;
pr_hb_enabled = (play_for_hb > 0 && rest_for_hb > 0);

play_for_br      = slider44;
rest_for_br      = slider45;
new_pr_br_enabled = (play_for_br > 0 && rest_for_br > 0);
total_breath_samples = inhale_len + top_len + exhale_len + bot_len;
!new_pr_br_enabled && pr_br_resting ? (
  pr_br_resting    = 0;
  breath_state     = 0;
  breath_state_len = inhale_len;
  breath_state_pos = 0;
);
pr_br_enabled = new_pr_br_enabled;

play_for_bf   = slider46;
rest_for_bf   = slider47;
pr_bf_enabled = (play_for_bf > 0 && rest_for_bf > 0);

// Speed ramp target selector save/restore. slider48 = target; slider49 =
// per-target `by`; slider50 = per-target duration; slider52 = per-target start
// delay (all three per-target as of v2.14). slider51 (engage) stays GLOBAL.
// When the selector changes, save the three per-target sliders to the OLD
// slot, then load the NEW slot's stored values. Otherwise capture live edits.
sel_speed_target = slider48;
last_speed_target != sel_speed_target ? (
  speed_ramp_target_value_mem[last_speed_target] = slider49;
  speed_ramp_dur_mem[last_speed_target]          = slider50;
  speed_ramp_delay_mem[last_speed_target]        = slider52;
  slider49 = speed_ramp_target_value_mem[sel_speed_target];
  slider50 = speed_ramp_dur_mem[sel_speed_target];
  slider52 = speed_ramp_delay_mem[sel_speed_target];
  slider_automate(slider49);
  slider_automate(slider50);
  slider_automate(slider52);
  last_speed_target = sel_speed_target;
) : (
  speed_ramp_target_value_mem[sel_speed_target] = slider49;
  speed_ramp_dur_mem[sel_speed_target]          = slider50;
  speed_ramp_delay_mem[sel_speed_target]        = slider52;
);

// Speed ramp engage is a freeze/resume gate, NOT a restart trigger.
// While engaged + past start delay, ramp_t advances in @sample.
// Flipping engage Off freezes ramp_t wherever it is; flipping On
// resumes from that position. The only thing that resets ramp_t is a
// transport play edge (handled in @sample). This means a slider change
// while engaged — including switching the target selector — does NOT
// restart the ramp.

// --- v3 Drift target save/restore ---
//
// Detect target-selector change. If the user just switched targets,
// save the current sliders 55-58 into the OLD target's memory slot,
// then load the NEW target's saved values into sliders 55-58.
// If the target didn't change, write the current slider values into
// the current target's slot (so edits are captured live).
sel_target = slider54;
sel_up     = slider55;
sel_down   = slider56;
sel_per    = slider57;
sel_shape  = slider58;

last_target_select != sel_target ? (
  // Save current sliders into the OLD target's slot
  target_drift_up[last_target_select]    = sel_up;
  target_drift_down[last_target_select]  = sel_down;
  target_drift_per[last_target_select]   = sel_per;
  target_drift_shape[last_target_select] = sel_shape;

  // Load the NEW target's saved values into the sliders.
  slider55 = target_drift_up[sel_target];
  slider56 = target_drift_down[sel_target];
  slider57 = target_drift_per[sel_target];
  slider58 = target_drift_shape[sel_target];
  slider_automate(slider55);
  slider_automate(slider56);
  slider_automate(slider57);
  slider_automate(slider58);

  last_target_select = sel_target;
) : (
  // Target didn't change — capture live edits into the current slot.
  target_drift_up[sel_target]    = sel_up;
  target_drift_down[sel_target]  = sel_down;
  target_drift_per[sel_target]   = sel_per;
  target_drift_shape[sel_target] = sel_shape;
);

// Breath-frequency target activity flag (v2.14 Job C — breath frequencies).
// True when Inhale Freq (target 8) or Exhale Freq (target 9) has any Drift or
// Speed Ramp configured. Gates the per-sample breath-filter-coeff recompute in
// @sample so the common case (no breath-freq target) keeps the coeffs cached
// here and pays nothing. When a freq target is un-configured, this @slider
// re-run also resets in_f_l/r + ex_f_l/r back to their base (below).
// breath_freq_active is DERIVED from the drift and Speed Ramp banks, so it is
// computed in @block instead -- see the note there.

@block
// --- Restore-order guard for the change-detecting controls below -----------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the picker then fires and slider_automate()s
//     its ratio over a rate that was set by hand. @block cannot run before the
//     instance is configured, so adopting here is right whatever order the
//     restore paths ran in. (Proved 2026-08-23: a Sweeping Filter in BPM mode
//     with Host ratio "every 2 beats" had Rate Value stamped to 0.5 on every
//     load and every track duplicate.)
!rate_mode_inited ? ( last_rate_mode = slider62; rate_mode_inited = 1; );
!hs_inited ? (
  last_hs_sel   = slider63;
  last_hs_beats = slider64;
  hs_s1_shown   = slider1;
  hs_inited     = 1;
);

// --- One-shot seeding for blobs older than the beats bank -------------------
// Two overlapping histories, both flagged by @serialize:
//
//   * A blob with no host_beats_mem in it. The bank is at @init defaults,
//     which would put the heart on one-per-beat regardless of what the project
//     actually sounded like. Recover it: the heart's beats are whatever
//     reproduces the BPM already on screen at this tempo, and the breath's are
//     the cycle its four shape sliders describe -- the same continuity rule
//     entering Host x uses.
//   * Older still: slider1 in Host x meant "times the project tempo", so 0.5
//     was half-tempo and the number on screen was not a heart rate at all.
//     Convert it to BPM first, then read the beats off it.
//
// Performed HERE rather than in @serialize because @serialize and the slider
// restore have no guaranteed order -- reading slider62 there could catch it
// before REAPER had handed the saved mode over. @block cannot run before the
// instance is configured. Migrate what was RESTORED, never what was DEFAULTED.
//
// If the project is loaded and not saved, the file still holds the old blob
// and this runs again on the next load -- correctly. Save once and it stops.
host_beats_seed_pending && rate_mode_inited && hs_inited ? (
  host_beats_seed_pending = 0;
  slider62 == 1 ? (
    host_bpm_migration_pending ? (
      host_beats_mem[HS_HEART] = max(0.25, min(64, 1 / max(slider1, 0.0001)));
      slider1 = min(200, max(1, slider1 * max(tempo, 0.001)));
    ) : (
      host_beats_mem[HS_HEART] =
        max(0.25, min(64, max(tempo, 0.001) / max(slider1, 0.001)));
    );
    // Old blobs held the breath as a RATIO plus a separate cycle length. The
    // four sliders are beats now, so convert them the same way entering Host x
    // does: whatever they read as seconds becomes the same duration in beats
    // at this tempo. That reproduces what the sliders SAY, which is the thing
    // the user has been reading and adjusting.
    br_u = max(tempo, 0.001) / 60;
    slider16 = min(64, max(0.02, slider16 * br_u));
    slider17 = min(64, max(0,    slider17 * br_u));
    slider18 = min(64, max(0.02, slider18 * br_u));
    slider19 = min(64, max(0,    slider19 * br_u));
    slider5  = min(1000, max(0.01, slider5 * br_u * 0.001));
    hs_s1_shown   = slider1;
    slider64      = host_beats_mem[min(N_HS_TARGETS-1, max(0, slider63))];
    last_hs_beats = slider64;
    sliderchange(-1);
  );
  host_bpm_migration_pending = 0;
);
// --- Gating flag DERIVED from the @serialize banks, and therefore computed
//     here rather than in @slider.
//
// It gates the per-sample breath-filter-coeff recompute below, so the common
// case (no breath-freq target configured) keeps the coeffs cached and pays
// nothing. In @slider it was subject to the restore-order bug: @slider and
// @serialize have no guaranteed order, so on a load or track duplicate where
// @slider ran first this was computed from empty banks, came out 0, and was
// never recomputed once the banks were restored underneath it -- a configured
// breath-frequency drift would simply not move until a control was touched.
// @block runs every block regardless of what happened when. (Same bug found
// in the Morpher on 2026-08-19 and swept across the suite.)
breath_freq_active = (target_drift_up[8] > 0 || target_drift_down[8] > 0 ||
                      target_drift_up[9] > 0 || target_drift_down[9] > 0 ||
                      speed_ramp_target_value_mem[8] != 0 ||
                      speed_ramp_target_value_mem[9] != 0);

// Follow the project tempo live in Host x. @slider does not re-run on a
// tempo change, so these repeat here; everything else is per-sample.
rate_mode == 1 ? (
  bpm_target = max(tempo, 0.001) / max(host_beats_mem[HS_HEART], 0.25);
  // BANK-derived, so it belongs here and not in @slider: @slider and
  // @serialize restore in no guaranteed order, so a value derived there can be
  // computed from an empty bank and never recomputed once the bank lands.

  // Keep the Heart rate slider showing what the sync is actually running at.
  // Clamp FIRST and compare against the clamped value, or a rate outside the
  // slider's range would be rewritten every block forever. The 0.6 threshold
  // matches the hand-move test in @slider: below the slider's own step, so
  // our own readout can never come back looking like a user edit.
  hs_s1_want = min(200, max(1, bpm_target));
  abs(hs_s1_want - hs_s1_shown) > 0.6 ? (
    slider1     = hs_s1_want;
    hs_s1_shown = hs_s1_want;
    sliderchange(-1);
  );
  start_delay_sec = slider41 * 60 / max(bpm_target, 0.001);
  // ...and the BREATH follows the tempo too. It did not, until now: the heart
  // scaled with the project and the breath state machine kept advancing one
  // sample per sample, so a tempo change slid them apart. That is an asymmetry
  // in a plugin whose whole subject is one body -- the heart and the lungs of
  // the same organism do not disagree about how fast time is passing.
  //
  // The first pass at this scaled the breath by tempo/60 against a nominal
  // 60 BPM -- the idiom the rest of the Host x sweep uses. It worked, and it
  // was still wrong, because it left the breath's rate as an emergent sum of
  // four sliders with the tempo applied on top. Nothing NAMED the breath rate,
  // so nothing could say what it was, and the four sliders quietly stopped
  // meaning seconds with no way to tell by looking.
  //
  // The breath cycle is now SET, not inferred: beats-per-breath against the
  // project tempo gives the length it should take, and the scale is however
  // much faster or slower than that the four shape sliders would run on their
  // own. At the tempo where they already sum to the requested length the scale
  // is exactly 1 -- which is what makes entering Host x silent.
  // MODEL B. Sliders 16-19 ARE BEATS in Host x, and the breath is simply their
  // sum -- exactly as in Own BPM they are seconds and the breath is their sum.
  // One mental model, one unit swap, and nothing seeded behind the user.
  //
  // The mechanism is unchanged and costs nothing: segment lengths stay
  // floor(srate * slider), and the state machine advances at tempo/60 samples
  // per sample. A 4-beat inhale is 4*srate length consumed at tempo/60, which
  // is 4*60/tempo seconds. Four beats, at any tempo, immediately -- a tempo
  // change retimes the breath mid-segment because it changes the advance
  // rather than the length.
  //
  // What this replaced: the four sliders were a RATIO and a separate value set
  // the total. It fitted the shape correctly and was still wrong, because
  // 4-0.5-8-1 stopped meaning anything you could count, halving the in and out
  // did not shorten the breath (it only gave the pauses a bigger share), and
  // the total was seeded from the tempo you happened to switch modes at.
  // (Rozaya, three separate reports, 2026-08-30/31.)
  breath_host_scale = max(tempo, 0.001) / 60;
  // Systole rides the same unit swap: beats in Host x, milliseconds in Own BPM.
  sys_unit_sec = 60 / max(tempo, 0.001);
) : (
  breath_host_scale = 1;
  sys_unit_sec = 0.001;          // milliseconds
);

@sample

// Smooth BPM toward bpm_target.
bpm_smoothed += (bpm_target - bpm_smoothed) * rate_smoother_coeff;

// Advance each target's own ramp clock (v2.14 per-target timeline). Engage
// (slider51, GLOBAL) is the freeze/resume gate: while On, each target whose
// duration > 0 advances its own ramp_t 0->1 over its own duration, after its
// own start delay; while Off, all clocks freeze and resume. Only transport
// play (via @init) resets them.
slider51 ? (
  i = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * 60 * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        speed_ramp_ramp_t_mem[i] += 1.0 / (srate * speed_ramp_dur_mem[i] * 60);
        speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
      );
    );
    i += 1;
  );
);

// Compute per-target Speed Ramp effect. ALL 7 targets ramp in parallel
// (same shape as drift — see the drift loop below). Each target's offset
// is `ramp_t * stored_amount` where the stored amount comes from the
// per-target memory bank, not from slider49. The @slider block keeps the
// bank in sync with slider49 for the currently-selected target (live
// edits captured; non-selected targets stay at their saved amounts).
// This way switching the selector doesn't stop any ramp — the selector
// just changes which target's amount you're currently editing.
// Each target is additive: a Heart BPM ramp affects only the heart;
// breath cycle stays at its base rate unless the operator also configures
// Speed Ramp on a breath segment.
speed_ramp_heart_offset   = speed_ramp_ramp_t_mem[0] * speed_ramp_target_value_mem[0];
speed_ramp_systole_offset = speed_ramp_ramp_t_mem[1] * speed_ramp_target_value_mem[1];
speed_ramp_inhale_offset  = speed_ramp_ramp_t_mem[2] * speed_ramp_target_value_mem[2];
speed_ramp_top_offset     = speed_ramp_ramp_t_mem[3] * speed_ramp_target_value_mem[3];
speed_ramp_exhale_offset  = speed_ramp_ramp_t_mem[4] * speed_ramp_target_value_mem[4];
speed_ramp_bot_offset     = speed_ramp_ramp_t_mem[5] * speed_ramp_target_value_mem[5];
speed_ramp_rsa_offset     = speed_ramp_ramp_t_mem[6] * speed_ramp_target_value_mem[6];
speed_ramp_bpm_offset     = speed_ramp_ramp_t_mem[7] * speed_ramp_target_value_mem[7];
speed_ramp_in_freq_offset = speed_ramp_ramp_t_mem[8] * speed_ramp_target_value_mem[8];
speed_ramp_ex_freq_offset = speed_ramp_ramp_t_mem[9] * speed_ramp_target_value_mem[9];

// --- v3 Per-target Drift wave computation ---
//
// Each of 7 targets gets a phase counter advancing per sample. Period
// units differ by target: heartbeats for Heart BPM and S1-S2 gap,
// breath cycles for the four breath segments and RSA depth. Shape +
// up/down amplitudes are read from per-target memory.
//
// The resulting offset is stored back into target_drift_offset[t] and
// consumed later in @sample where each target is applied to its audio
// path parameter (BPM, systole_samples, segment lengths, RSA depth).
i = 0;
loop(N_TARGETS,
  up    = target_drift_up[i];
  down  = target_drift_down[i];
  per   = target_drift_per[i];
  shape = target_drift_shape[i];

  drift_offset_local = 0;
  (up > 0 || down > 0) && per > 0 ? (
    // Period base: heartbeats for targets 0,1; breath cycles for 2-6.
    // Period base: heartbeats for targets 0,1; breath cycles for 2-6. The
    // breath side divides by breath_host_scale because total_breath_samples is
    // the length the four sliders describe, NOT the length actually played --
    // in Host x the cycle is consumed at a different rate, so without this a
    // drift period of "3 breath cycles" would be three cycles of a breath that
    // is not the one you can hear. Heart periods need no equivalent: their base
    // is cycle_len_base, which already scales. (1 in Own BPM, so untouched.)
    period_base = i < 2 ? max(cycle_len_base, 1)
                        : max(total_breath_samples / max(breath_host_scale, 0.0001), 1);
    period_samples = max(per * period_base, 1);

    new_phase = target_drift_phase[i] + 1.0 / period_samples;
    new_phase >= 1.0 ? (
      new_phase -= 1.0;
      shape == 2 ? (
        target_drift_prev[i] = target_drift_curr[i];
        target_drift_curr[i] = rand(2) - 1;
      );
    );
    target_drift_phase[i] = new_phase;

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = target_drift_prev[i] +
        (target_drift_curr[i] - target_drift_prev[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  target_drift_offset[i] = drift_offset_local;
  i += 1;
);

// Heart-with-breath (RSA) modulation — coupled to breath state, not
// to its own phase. Drift target 6 wanders the baseline depth (slider59);
// Speed Ramp target 6 (RSA depth) ramps it toward the configured target
// over the duration. Both add as offsets.
rsa_baseline_bpm = max(slider59 + target_drift_offset[6] + speed_ramp_rsa_offset, 0);
heart_with_breath_offset = 0;
rsa_baseline_bpm > 0 ? (
  rsa_half = rsa_baseline_bpm * 0.5;
  breath_phase_pos_for_rsa = breath_state_pos / max(breath_state_len - 1, 1);
  breath_state == 0 ? heart_with_breath_offset = (breath_phase_pos_for_rsa - 0.5) * rsa_baseline_bpm :
  breath_state == 1 ? heart_with_breath_offset = rsa_half :
  breath_state == 2 ? heart_with_breath_offset = (0.5 - breath_phase_pos_for_rsa) * rsa_baseline_bpm :
                      heart_with_breath_offset = -rsa_half;
);

// Apply heart-side modulation: BPM drift (target 0) + RSA + Speed Ramp
// heart offset. All additive in raw BPM.
// Floor lowered from 20 to 0.01 -- see the heartbeat note; a silent clamp
// would defeat Host x at small multipliers.
// Drift and Speed Ramp offsets are in the plugin's OWN unit in every mode --
// BPM here, never a multiplier, even in Host x. Tried it the other way and it
// fails on the slider grid: these amount sliders step in 0.1, chosen for BPM,
// and in multiplier terms 0.1 is a 10% wander with nothing finer reachable.
// The value you want stops being settable, which is worse than the
// inconsistency it fixed. Consequence, deliberate and documented: a ramp does
// NOT stretch when the project tempo changes -- -60 stays -60 BPM.
effective_bpm  = max(bpm_smoothed + target_drift_offset[0] + heart_with_breath_offset + speed_ramp_heart_offset, 0.01);
cycle_len_base = floor(srate * 60.0 / effective_bpm);

// Apply systole drift (target 1) + Speed Ramp offset: baseline ms + drift + ramp.
// Drift and Speed Ramp offsets are in the slider's own unit, so they ride the
// conversion with it. The floor is 0.001 of a unit rather than 1: in Host x a
// floor of 1 would be a whole beat.
effective_systole = max(slider5 + target_drift_offset[1] + speed_ramp_systole_offset, 0.001);
systole_samples   = floor(srate * effective_systole * sys_unit_sec);

// Breaths/min aggregate (target 7): a proportional scale across ALL four
// segments in lockstep, preserving the I:E ratio — the ratio-based
// aggregate spec'd for Job B. Combined breath-rate delta (drift + Speed
// Ramp, in breaths/min) shifts the whole breath rate; each segment's
// effective duration is then divided by the scale (faster rate = shorter
// segments). Composes with the per-segment drift + ramp offsets below.
base_breath_total = max(slider16 + slider17 + slider18 + slider19, 0.001);
base_breath_rate  = 60 / base_breath_total;
breath_rate_delta = target_drift_offset[7] + speed_ramp_bpm_offset;
breath_rate_scale = max(base_breath_rate + breath_rate_delta, 0.001) / base_breath_rate;

// Apply breath segment drifts (targets 2-5) + Speed Ramp offsets, then the
// Breaths/min aggregate scale. Drift wanders each segment cycle-to-cycle;
// Speed Ramp adds a one-way movement over the configured duration; the
// aggregate scales the whole breath rate.
effective_inhale_sec = max((slider16 + target_drift_offset[2] + speed_ramp_inhale_offset) / breath_rate_scale, 0.01);
effective_top_sec    = max((slider17 + target_drift_offset[3] + speed_ramp_top_offset)    / breath_rate_scale, 0);
effective_exhale_sec = max((slider18 + target_drift_offset[4] + speed_ramp_exhale_offset) / breath_rate_scale, 0.01);
effective_bot_sec    = max((slider19 + target_drift_offset[5] + speed_ramp_bot_offset)    / breath_rate_scale, 0);
inhale_len = max(floor(srate * effective_inhale_sec), 1);
top_len    = max(floor(srate * effective_top_sec), 1);
exhale_len = max(floor(srate * effective_exhale_sec), 1);
bot_len    = max(floor(srate * effective_bot_sec), 1);

// Breath-frequency Drift + Speed Ramp (targets 8, 9). When configured, the
// inhale/exhale breath-noise filter cutoffs (in_f_l/r, ex_f_l/r — cached in
// @slider) are recomputed per sample from the effective frequency (base slider
// + drift offset + ramp offset), so the breath brightens/darkens live. Same
// formula + stereo-width spread as the @slider base computation, on the drifted
// value. Gated by breath_freq_active so unused instances keep the cached coeffs
// and pay nothing. Clamped to 20 Hz so a big negative offset can't invert sin().
breath_freq_active ? (
  eff_in_freq = max(slider20 + target_drift_offset[8] + speed_ramp_in_freq_offset, 20);
  eff_ex_freq = max(slider21 + target_drift_offset[9] + speed_ramp_ex_freq_offset, 20);
  in_f_l = min(2.0 * sin($pi * (eff_in_freq * (1.0 + slider28 * 0.15)) * srate_inv), 0.98);
  in_f_r = min(2.0 * sin($pi * (eff_in_freq * (1.0 - slider28 * 0.15)) * srate_inv), 0.98);
  ex_f_l = min(2.0 * sin($pi * (eff_ex_freq * (1.0 + slider28 * 0.12)) * srate_inv), 0.98);
  ex_f_r = min(2.0 * sin($pi * (eff_ex_freq * (1.0 - slider28 * 0.12)) * srate_inv), 0.98);
);

// Note: the sigh multiplier (slider61) is NOT applied here. It's
// applied at state transitions where breath_state_len is set —
// see the state machine block below. That way drift continues to
// wander each segment's length per sample (this block), and at the
// MOMENT a sigh state starts, the currently-drifted segment length
// is multiplied by slider61 to set breath_state_len. The result is
// "sigh inherits live drift" without storing any extra state.

// Recompute total breath samples after drift, used by Breath rest timer
// and by breath drift periods.
total_breath_samples = inhale_len + top_len + exhale_len + bot_len;

// Breath state_pos advances at 1× sample-rate in Own BPM; segment lengths
// carry any drift or Speed Ramp offset. v3 dropped v2's combined_scale
// multiplicative shape — each target's effect is now contained to its
// own parameter via additive offsets above.
// In Host x it advances at the project's rate instead (see @block), so the
// breath follows the tempo exactly as the heart does. Everything counted in
// breath-time rides this: the Play/Rest timer below already uses it, and the
// segment lengths scale by being CONSUMED faster rather than being rewritten,
// so drift and Speed Ramp offsets survive untouched. The sigh timer
// deliberately does not -- it is wall-clock minutes and stays that way.
breath_state_advance = breath_host_scale;

// Sigh timer advances in wall-clock seconds. Pure wall-clock with no
// scaling: a 5-minute sigh interval is 5 real minutes, regardless of
// what Speed Ramp or drift are doing.
slider60 > 0 ? (
  sigh_time_since_last += 1.0 / srate;
);

// (No transport-edge reset here — Path A. REAPER re-runs @init on every
// transport play / render start, which resets all runtime state — all
// three layer state machines, oscillators, filters, HB delay buffer,
// drift runtime (phase 0 → deterministic renders), Speed Ramp, Start
// Delay, Play/Rest per layer, BPM smoother, sigh timer, noise seeds; the
// CONFIG banks are preserved across those re-runs by the drift_cfg_inited
// guard in @init. See docs/v2.9-render-state-bug.md.)

start_delay_elapsed < start_delay_sec ? (
  start_delay_elapsed += 1 / srate;
  spl0 = 0;
  spl1 = 0;
) : (

// --- NOISE ---
// White noise via Park-Miller / MINSTD (see CLAUDE.md gotcha: EEL2 float64
// rounds an LCG multiply once a*seed exceeds 2^53 — the old 22695477
// streams ns2/ns4/ns6, one per layer's decorrelated channel, overflowed
// into a periodic tone + DC offset on R). Three different multipliers
// (48271 / 69621 / 16807) are spread so each summed output channel
// (L: n1/n3/n5, R: n2/n4/n6) draws from three independent streams. Seeds
// (set in @init) are distinct nonzero values in [1, 2^31-2].
ns1 = (ns1 * 48271) % 2147483647; n1 = ns1 * (2.0 / 2147483647.0) - 1.0;
ns2 = (ns2 * 69621) % 2147483647; n2 = ns2 * (2.0 / 2147483647.0) - 1.0;
ns3 = (ns3 * 16807) % 2147483647; n3 = ns3 * (2.0 / 2147483647.0) - 1.0;
ns4 = (ns4 * 48271) % 2147483647; n4 = ns4 * (2.0 / 2147483647.0) - 1.0;
ns5 = (ns5 * 69621) % 2147483647; n5 = ns5 * (2.0 / 2147483647.0) - 1.0;
ns6 = (ns6 * 16807) % 2147483647; n6 = ns6 * (2.0 / 2147483647.0) - 1.0;

// --- HEARTBEAT CYCLE LENGTH ---
// Cap raised from 200 to 1000 BPM for the same reason.
cycle_len = max(cycle_len_base, floor(srate * 60.0 / 1000.0));

// --- HEARTBEAT ---
hb_phase += 1;
hb_phase >= cycle_len ? (
  hb_phase = 0;
  pr_hb_enabled ? (
    pr_hb_beat >= (pr_hb_resting ? rest_for_hb : play_for_hb) ? (
      pr_hb_resting = 1 - pr_hb_resting;
      pr_hb_beat = 0;
    );
    pr_hb_beat += 1;
  );
  pr_bf_enabled ? (
    pr_bf_beat >= (pr_bf_resting ? rest_for_bf : play_for_bf) ? (
      pr_bf_resting = 1 - pr_bf_resting;
      pr_bf_beat = 0;
    );
    pr_bf_beat += 1;
  );
  this_hb_has_beat = !pr_hb_enabled || !pr_hb_resting;
  this_hb_has_beat ? (
    s1_active = 1; s1_env = 0.0; s1_attack_phase = 1;
  );
);
hb_phase == systole_samples && this_hb_has_beat ? (
  s2_active = 1; s2_env = 0.0; s2_attack_phase = 1;
);

s1_active ? (
  s1_attack_phase ? (
    s1_env += (1.0 - s1_env) * (1.0 - s1_attack_rate);
    s1_env >= 0.98 ? s1_attack_phase = 0;
  ) : (
    s1_env *= s1_decay;
    s1_env < 0.0001 ? s1_active = 0;
  );
) : 0;

s2_active ? (
  s2_attack_phase ? (
    s2_env += (1.0 - s2_env) * (1.0 - s2_attack_rate);
    s2_env >= 0.98 ? s2_attack_phase = 0;
  ) : (
    s2_env *= s2_decay;
    s2_env < 0.0001 ? s2_active = 0;
  );
) : 0;

s1_phase_osc_near += two_pi * s1_freq * srate_inv;
s1_phase_osc_near > two_pi ? s1_phase_osc_near -= two_pi;
s2_phase_osc_near += two_pi * s2_freq * srate_inv;
s2_phase_osc_near > two_pi ? s2_phase_osc_near -= two_pi;
s1_phase_osc_far += two_pi * (s1_freq * 1.003) * srate_inv;
s1_phase_osc_far > two_pi ? s1_phase_osc_far -= two_pi;
s2_phase_osc_far += two_pi * (s2_freq * 0.997) * srate_inv;
s2_phase_osc_far > two_pi ? s2_phase_osc_far -= two_pi;

s1_active ? (
  s1_res_low_near += s1_res_f_near * s1_res_band_near;
  s1_res_high_near = (sin(s1_phase_osc_near)*0.8 + n1*0.2) - s1_res_low_near - s1_res_q_near * s1_res_band_near;
  s1_res_band_near += s1_res_f_near * s1_res_high_near;
  s1_out_near = s1_res_band_near * s1_env * s1_env * 2.0 * s1_vol;
) : s1_out_near = 0;
s2_active ? (
  s2_res_low_near += s2_res_f_near * s2_res_band_near;
  s2_res_high_near = (sin(s2_phase_osc_near)*0.5 + n1*0.5) - s2_res_low_near - s2_res_q_near * s2_res_band_near;
  s2_res_band_near += s2_res_f_near * s2_res_high_near;
  s2_out_near = s2_res_band_near * s2_env * s2_env * s2_vol;
) : s2_out_near = 0;

raw_near = s1_out_near + s2_out_near;
lp_low_near += lp_f_near * lp_band_near;
lp_high_near = raw_near - lp_low_near - lp_q * lp_band_near;
lp_band_near += lp_f_near * lp_high_near;
lp_low2_near += lp_f_near * lp_band2_near;
lp_high2_near = lp_low_near - lp_low2_near - lp_q * lp_band2_near;
lp_band2_near += lp_f_near * lp_high2_near;
heart_near = lp_low2_near * 1.5;

s1_active ? (
  s1_res_low_far += s1_res_f_far * s1_res_band_far;
  s1_res_high_far = (sin(s1_phase_osc_far)*0.8 + n2*0.2) - s1_res_low_far - s1_res_q_far * s1_res_band_far;
  s1_res_band_far += s1_res_f_far * s1_res_high_far;
  s1_out_far = s1_res_band_far * s1_env * s1_env * 2.0 * s1_vol;
) : s1_out_far = 0;
s2_active ? (
  s2_res_low_far += s2_res_f_far * s2_res_band_far;
  s2_res_high_far = (sin(s2_phase_osc_far)*0.5 + n2*0.5) - s2_res_low_far - s2_res_q_far * s2_res_band_far;
  s2_res_band_far += s2_res_f_far * s2_res_high_far;
  s2_out_far = s2_res_band_far * s2_env * s2_env * s2_vol;
) : s2_out_far = 0;

raw_far = s1_out_far + s2_out_far;
lp_low_far += lp_f_far * lp_band_far;
lp_high_far = raw_far - lp_low_far - lp_q * lp_band_far;
lp_band_far += lp_f_far * lp_high_far;
lp_low2_far += lp_f_far * lp_band2_far;
lp_high2_far = lp_low_far - lp_low2_far - lp_q * lp_band2_far;
lp_band2_far += lp_f_far * lp_high2_far;
heart_far_now = lp_low2_far * 1.5;

hb_dw = hb_delay_write & (hb_delay_buf_size - 1);
hb_dr = (hb_delay_write - hb_delay_samples) & (hb_delay_buf_size - 1);
hb_dw[0] = heart_far_now;
heart_far = hb_dr[0];
hb_delay_write = (hb_delay_write + 1) & (hb_delay_buf_size - 1);

hb_delay_sign == 1 ? (
  hb_l = heart_near; hb_r = heart_far;
) : (
  hb_l = heart_far; hb_r = heart_near;
);
hb_l *= slider3; hb_r *= slider3;

// --- BREATH ---
breath_state_pos += breath_state_advance;
breath_state_pos >= breath_state_len ? (
  breath_state_pos = 0;
  breath_state == 3 ? (
    // End of bottom pause — about to start a new breath.
    pr_br_enabled && !pr_br_resting ? (
      pr_br_breath += 1;
      pr_br_breath >= play_for_br ? (
        pr_br_resting = 1;
        pr_br_breath = 0;
        pr_br_rest_elapsed = 0;
      );
    );
    !pr_br_resting ? (
      // Sigh handling at the start of a new breath. Clear any previous
      // sigh first (it covered all 4 states of the breath we just finished),
      // then check the timer — if it's time, this NEW breath is the sigh.
      sigh_active = 0;
      slider60 > 0 && sigh_time_since_last >= slider60 * 60 ? (
        sigh_active = 1;
        sigh_time_since_last = 0;
      );
      breath_state     = 0;
      // Multiply by slider61 if sigh_active; otherwise use the
      // currently-drifted inhale_len as-is. Same pattern applies at every
      // state transition below — drift wanders the underlying segment
      // length, sigh scales it on top at the moment of state entry.
      breath_state_len = sigh_active ? max(floor(inhale_len * slider61), 1) : inhale_len;
    );
  ) : (
    breath_state = (breath_state + 1) % 4;
    // Each state's length is the currently-drifted segment length,
    // multiplied by slider61 if we're mid-sigh. sigh_active stays set
    // through all four states of the sigh breath; it clears at the
    // next 3->0 transition above.
    breath_state == 1 ? breath_state_len = sigh_active ? max(floor(top_len    * slider61), 1) : top_len;
    breath_state == 2 ? breath_state_len = sigh_active ? max(floor(exhale_len * slider61), 1) : exhale_len;
    breath_state == 3 ? breath_state_len = sigh_active ? max(floor(bot_len    * slider61), 1) : bot_len;
  );
);

pr_br_resting ? (
  pr_br_rest_duration_samples = rest_for_br * total_breath_samples;
  pr_br_rest_elapsed += breath_state_advance;
  pr_br_rest_elapsed >= pr_br_rest_duration_samples ? (
    pr_br_resting    = 0;
    pr_br_breath     = 0;
    // Rest-exit forces a fresh inhale — treat it as a new-breath
    // transition for sigh purposes too. Same sigh-fire logic as the
    // normal 3->0 path above.
    sigh_active = 0;
    slider60 > 0 && sigh_time_since_last >= slider60 * 60 ? (
      sigh_active = 1;
      sigh_time_since_last = 0;
    );
    breath_state     = 0;
    breath_state_len = sigh_active ? max(floor(inhale_len * slider61), 1) : inhale_len;
    breath_state_pos = 0;
  );
);

breath_phase_pos = breath_state_pos / max(breath_state_len - 1, 1);

hp_lp_l += hp_f * (n3 - hp_lp_l);
br_hp_l = n3 - hp_lp_l;
in_lp_l += in_f_l * in_bp_l;
in_hp2_l = br_hp_l - in_lp_l - breath_lp_q * in_bp_l;
in_bp_l += in_f_l * in_hp2_l;
ex_lp_l += ex_f_l * ex_bp_l;
ex_hp2_l = br_hp_l - ex_lp_l - breath_lp_q * ex_bp_l;
ex_bp_l += ex_f_l * ex_hp2_l;
hp_lp_r += hp_f * (n4 - hp_lp_r);
br_hp_r = n4 - hp_lp_r;
in_lp_r += in_f_r * in_bp_r;
in_hp2_r = br_hp_r - in_lp_r - breath_lp_q * in_bp_r;
in_bp_r += in_f_r * in_hp2_r;
ex_lp_r += ex_f_r * ex_bp_r;
ex_hp2_r = br_hp_r - ex_lp_r - breath_lp_q * ex_bp_r;
ex_bp_r += ex_f_r * ex_hp2_r;

(breath_state == 0) ? (
  br_env_raw = apply_fade(breath_phase_pos, slider23, slider24, slider27);
  br_env     = br_floor + (1.0 - br_floor) * br_env_raw;
  br_l = in_lp_l * br_env * 1.5;
  br_r = in_lp_r * br_env * 1.5;
) : (breath_state == 1) ? (
  br_l = in_lp_l * br_floor * 1.5;
  br_r = in_lp_r * br_floor * 1.5;
) : (breath_state == 2) ? (
  br_env_raw = apply_fade(breath_phase_pos, slider25, slider26, slider27);
  br_env     = br_floor + (1.0 - br_floor) * br_env_raw;
  br_l = ex_lp_l * br_env * 1.5;
  br_r = ex_lp_r * br_env * 1.5;
) : (
  br_l = ex_lp_l * br_floor * 1.5;
  br_r = ex_lp_r * br_floor * 1.5;
);
br_l *= slider14; br_r *= slider14;

bpf_low_l += bpf_f * bpf_band_l;
bpf_high_l = br_l - bpf_low_l - bpf_q * bpf_band_l;
bpf_band_l += bpf_f * bpf_high_l;
br_l = bpf_low_l;

bpf_low_r += bpf_f * bpf_band_r;
bpf_high_r = br_r - bpf_low_r - bpf_q * bpf_band_r;
bpf_band_r += bpf_f * bpf_high_r;
br_r = bpf_low_r;

// --- BLOODFLOW ---
bf_cycle_pos = hb_phase / max(cycle_len, 1);

bf_cycle_pos < bf_attack ? (
  bf_t = bf_cycle_pos / bf_attack;
  bf_env_main = 0.5 - 0.5 * cos(bf_t * $pi);
) : bf_cycle_pos < (bf_attack + bf_decay) ? (
  bf_t = (bf_cycle_pos - bf_attack) / bf_decay;
  bf_env_main = 0.5 + 0.5 * cos(bf_t * $pi);
) : (
  bf_env_main = 0;
);

bf_dicrotic_center     = bf_attack + bf_decay * 0.7;
bf_dicrotic_half_width = bf_decay * 0.12;
bf_dicrotic_distance   = abs(bf_cycle_pos - bf_dicrotic_center);
bf_dicrotic_distance < bf_dicrotic_half_width ? (
  bf_dt = bf_dicrotic_distance / bf_dicrotic_half_width;
  bf_env_dicrotic = bf_dicrotic_level * (0.5 + 0.5 * cos(bf_dt * $pi));
) : (
  bf_env_dicrotic = 0;
);

bf_env_pulse = bf_env_main + bf_env_dicrotic;
bf_env       = bf_floor + (1.0 - bf_floor) * bf_env_pulse;

bf_cut   = bf_filter_hz * israte2;
bf_cut_l = (bf_cut * (1.0 + bf_stereo_width * 0.08));
bf_cut_r = (bf_cut * (1.0 - bf_stereo_width * 0.08));

bf_fb_l = bf_res + bf_res / (1.0 - bf_cut_l);
bf_n3_l = bf_n3_l + bf_cut_l * (n5 - bf_n3_l + bf_fb_l * (bf_n3_l - bf_n4_l));
bf_n4_l = bf_n4_l + bf_cut_l * (bf_n3_l - bf_n4_l);

bf_fb_r = bf_res + bf_res / (1.0 - bf_cut_r);
bf_n3_r = bf_n3_r + bf_cut_r * (n6 - bf_n3_r + bf_fb_r * (bf_n3_r - bf_n4_r));
bf_n4_r = bf_n4_r + bf_cut_r * (bf_n3_r - bf_n4_r);

bf_l = bf_n4_l * bf_env * slider29 * 12.0;
bf_r = bf_n4_r * bf_env * slider29 * 12.0;

target_bf_mix = pr_bf_enabled && pr_bf_resting ? 0 : 1;
bf_output_mix = bf_output_mix * pr_smooth + target_bf_mix * (1 - pr_smooth);
bf_l *= bf_output_mix;
bf_r *= bf_output_mix;

// --- SOLO LOGIC ---
any_solo = (slider4 > 0) || (slider15 > 0) || (slider30 > 0);
any_solo ? (
  hb_l = slider4  > 0 ? hb_l : 0;
  hb_r = slider4  > 0 ? hb_r : 0;
  br_l = slider15 > 0 ? br_l : 0;
  br_r = slider15 > 0 ? br_r : 0;
  bf_l = slider30 > 0 ? bf_l : 0;
  bf_r = slider30 > 0 ? bf_r : 0;
) : 0;

out_l = hb_l + br_l + bf_l;
out_r = hb_r + br_r + bf_r;

slider2 == 0 ? (
  spl0 = out_l; spl1 = out_r;
) : (
  spl0 = out_r; spl1 = out_l;
);

);  // close start-delay else branch

@serialize
// Persist per-target drift + Speed Ramp (by / duration / start-delay) configs
// so reload restores all targets, not just whichever was selected at save.
//
// VERSION-GUARDED (CLAUDE.md @serialize gotcha; NEW in v2.14 — womb v3's stream
// was previously unversioned). Magic = 2100000 + N_TARGETS marks the
// per-target-timeline format (added the duration + start-delay banks). Older
// (unversioned) blobs won't match and fall through to @init defaults — drift +
// ramp reset on upgrade (accepted; pre-release). Marker is float32-exact.
// Magic 2200000 marks heart-rate-as-BPM in Host x (it was a tempo multiplier
// under 2100000). The PAYLOAD is identical between the two, so both are read
// the same way and an upgrade keeps every drift and ramp config; only the
// migration flag differs. Accepting the old magic rather than falling through
// to defaults is the whole point -- a version bump that resets your settings
// is not a migration.
sr_magic = 2300000 + N_TARGETS;
file_var(0, sr_magic);
(sr_magic == 2300000 + N_TARGETS || sr_magic == 2200000 + N_TARGETS ||
 sr_magic == 2100000 + N_TARGETS) ? (
  file_mem(0, target_drift_up,    N_TARGETS);
  file_mem(0, target_drift_down,  N_TARGETS);
  file_mem(0, target_drift_per,   N_TARGETS);
  file_mem(0, target_drift_shape, N_TARGETS);
  file_var(0, last_target_select);
  file_mem(0, speed_ramp_target_value_mem, N_TARGETS);
  file_mem(0, speed_ramp_dur_mem,          N_TARGETS);
  file_mem(0, speed_ramp_delay_mem,        N_TARGETS);
  file_var(0, last_speed_target);

  // Host-sync beats bank (2300000). Older blobs stop above, so they leave the
  // bank at its @init defaults -- which is why they are flagged for seeding
  // instead of being trusted. Read past the end of a stream leaves the
  // destination untouched and raises nothing, so this cannot corrupt them.
  sr_magic == 2300000 + N_TARGETS ? (
    file_mem(0, host_beats_mem, HS_BANK_SLOTS);
    file_var(0, last_hs_sel);   // which target slider 64 was showing, as the
                                // drift and ramp banks save their selectors
  ) : (
    file_avail(0) >= 0 ? ( host_beats_seed_pending = 1; );
  );

  // TRACK-DUPLICATE FIX (v2.14). On READ (load/duplicate) file_avail(0) >= 0;
  // on WRITE it is < 0. @serialize is the only section guaranteed to run on
  // both load AND duplicate, so it re-establishes the bank<->slider invariant:
  // force the visible config sliders to match the restored banks for the
  // restored selectors, correcting any transient @slider clobber.
  file_avail(0) >= 0 ? (
    slider49 = speed_ramp_target_value_mem[last_speed_target]; // Speed ramp `by`
    slider50 = speed_ramp_dur_mem[last_speed_target];          // Speed ramp duration
    slider52 = speed_ramp_delay_mem[last_speed_target];        // Speed ramp start delay
    slider55 = target_drift_up[last_target_select];            // Drift up
    slider56 = target_drift_down[last_target_select];          // Drift down
    slider57 = target_drift_per[last_target_select];           // Drift period
    slider58 = target_drift_shape[last_target_select];         // Drift shape
    // Host-sync beats. Same invariant as the lines above, and it needs the
    // same repair: @slider and this section restore by two independent paths
    // with no guaranteed order, so an @slider pass that ran while the bank was
    // still empty could have dragged slider 64 down to a default. Whatever
    // happened when, the bank is authoritative by the time we are here.
    last_hs_sel = min(N_HS_TARGETS - 1, max(0, last_hs_sel));
    slider64 = host_beats_mem[last_hs_sel];
    // Old blob: the Host x heart rate it carries is a multiplier. Flag it and
    // let @block do the conversion, where the restored slider values are
    // guaranteed to have landed.
    sr_magic == 2100000 + N_TARGETS ? ( host_bpm_migration_pending = 1; );
    sliderchange(-1);
  );
);
