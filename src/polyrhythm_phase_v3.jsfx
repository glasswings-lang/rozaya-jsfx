desc: Binaural Polyrhythm Oscillator v3 (note-based)
// Designed by Rozaya, developed with Claude (Anthropic)
//
// This work is dedicated to the public domain under CC0 1.0 Universal.
// https://creativecommons.org/publicdomain/zero/1.0/
//
// v3 takes a note-based approach: each voice picks a musical note
// (with a cents-level fine tune) rather than v2's per-voice rate in
// BPM / Hz / seconds. Play/Rest gating carries forward from v2 at
// the same defaults, and per-voice cycle counting keeps fast-drift
// voices paced ahead of slow ones in real time.
//
// v2 is ARCHIVED (archive/versions/polyrhythm_phase/v2.jsfx, 2026-09-10).
// Every project that used it was converted to this plugin by
// tools/polyv1_to_v3_crossing_20260910.py and verified by render, 144 of
// 144 identical. This is the only Polyrhythm.

// ===== GLOBAL CONTROLS =====
// Layout authored in docs/layouts/polyrhythm-phase-v3.md BEFORE anything was
// built, and this block is that document. Reading order (R19/R20): what the
// plugin IS -> its rate (value, then mode) -> the shape of its movement ->
// the voices -> stereo and pan -> transport -> drift -> ramp.
slider1:0<0,1,1{Drift,Independent}>Tremolo Mode
// The rate PAIR: value then mode, adjacent, five modes always in this order.
// `Every N beats` means beats per cycle; `N per beat` is its reciprocal. Both
// are needed -- keeping only the slow half made eight cycles per beat into
// typing 0.125, which is the arithmetic this suite exists to remove.
slider2:60<0.001,1000,0.001>Rate Value — all voices (BPM / sec / Hz / beats per cycle / per beat)
slider3:0<0,4,1{BPM,Seconds,Hz,Every N beats,N per beat}>Rate Mode
slider4:1<0,3,1{Linear,Cosine,Logarithmic,Exponential}>Attack Shape
slider5:1<0,3,1{Linear,Cosine,Logarithmic,Exponential}>Release Shape

// ===== BASE PITCH =====
slider6:440<20,2000,0.1>Tuning Reference Hz
slider7:0<-12,12,1>Transpose (half steps)
slider8:0<-4,4,1>Octave shift
slider9:4<0,1000,0.001>Binaural Beat Hz (L/R offset)

// ===== PULSE WIDTH (Waveform slot 13 only) =====
// Duty cycle for the Pulse waveform: the fraction of each cycle the wave
// spends "high" before snapping low. 50% is a square wave (and equals the
// Square slot); narrower values get thinner and more nasal, wider values
// mirror the same back the other way. GLOBAL on purpose -- Waveform went
// per-voice in this build, Pulse Width did not, because it is refinement
// rather than identity. Shown whenever the visible Waveform is Pulse OR any
// voice is using Pulse, so it can never be live and hidden at the same time.
// Range stops short of 0/100 (which would be silence/DC).
slider10:25<1,99,0.1>Pulse Width % (50 = square)

// ===== CHARACTER (global post-effects) =====
// Four sliders that adjust the character of WHATEVER waveform is selected.
// Applied to the summed output of all voices after all per-voice processing --
// so they shape the overall sound, not each individual voice. Defaults are all
// neutral, so loading the plugin sounds identical until you push one.
//
// Tone (-100..+100): tilt EQ. Negative = warmer/darker, positive =
// brighter/airier. Crossover ~700 Hz, max boost +-~9 dB at the extremes.
// Edge (0-100): soft-clip drive on the summed signal, tanh with gain
// compensation so the level stays roughly constant as you push it.
// Movement (0-100): chorus on the output -- a modulated delay line read at
// two LFO-offset points for stereo shimmer.
// Body (0-100): pitch-tracking peaking EQ at the Transpose + Octave shift
// frequency, up to +6 dB. Useful for the Golden / Phi waves, which can sound
// thin in the low end.
slider11:0<-100,100,0.1>Tone (Warm <-> Bright)
slider12:0<0,100,0.1>Edge
slider13:0<0,100,0.1>Movement
slider14:0<0,100,0.1>Body

// ===== THE VOICES, BEHIND ONE SELECTOR =====
// 48 per-voice sliders became 12, then 15. Pick a voice, then the controls below
// hold THAT voice's settings; the other seven keep playing from the plugin's
// own memory, exactly as the Drift and Ramp targets already do here. The
// values live in a @serialize bank, which is why every derivation from them
// happens in @block and never in @slider (CLAUDE.md's bank-derived rule).
//
// **All** is position 0 and is not a convenience -- it is what makes the
// selector affordable. Once per-voice is cheap, setting things UNIFORMLY
// becomes the expensive case, and arrowing 1..8 to set the same waveform eight
// times trades one hand-wearing problem for another. Park on All, move a
// control, every voice takes it: "all sine except voice five" is two moves.
//
// All IS the global. There are no separate global copies of Waveform, Depth,
// On Duration, Attack % or Release % any more, and no "follow the global"
// sentinel -- no control behaves differently depending on a value you cannot
// see. When the voices DISAGREE, All shows voice 1's value: reading is
// approximate, writing is exact and hits all eight.
//
// Writes are CHANGE-DETECTED, not captured wholesale. Moving Tone while parked
// on All writes nothing to any voice; only a control you actually moved is
// written. That is what stops a stray pass over @slider from flattening eight
// voices into one, and it is why switching the selector needs no save step.
slider15:0<0,8,1{All,Voice 1,Voice 2,Voice 3,Voice 4,Voice 5,Voice 6,Voice 7,Voice 8}>Voice
// THE PITCH BLOCK (R22), Breath Generator's shape, one per voice (2026-09-10).
// Rozaya: "breath gen handled this nicely". Mode FIRST, because it decides
// whether the note name below means anything. Each voice has its own mode and
// its own fine tune unit -- "that would apply to the 'all' option too."
slider16:1<0,2,1{Hz,Semitones,Cents}>Pitch mode
// A real control both ways: pick C4 or type 60 into the value, and the other
// follows. Hidden outside Semitones, where it would be lying.
slider17:60<0,127,1{C-1,C#-1,D-1,D#-1,E-1,F-1,F#-1,G-1,G#-1,A-1,A#-1,B-1,C0,C#0,D0,D#0,E0,F0,F#0,G0,G#0,A0,A#0,B0,C1,C#1,D1,D#1,E1,F1,F#1,G1,G#1,A1,A#1,B1,C2,C#2,D2,D#2,E2,F2,F#2,G2,G#2,A2,A#2,B2,C3,C#3,D3,D#3,E3,F3,F#3,G3,G#3,A3,A#3,B3,C4,C#4,D4,D#4,E4,F4,F#4,G4,G#4,A4,A#4,B4,C5,C#5,D5,D#5,E5,F5,F#5,G5,G#5,A5,A#5,B5,C6,C#6,D6,D#6,E6,F6,F#6,G6,G#6,A6,A#6,B6,C7,C#7,D7,D#7,E7,F7,F#7,G7,G#7,A7,A#7,B7,C8,C#8,D8,D#8,E8,F8,F#8,G8,G#8,A8,A#8,B8,C9,C#9,D9,D#9,E9,F9,F#9,G9}>Note name
// THE pitch, not an offset: Hz is the frequency, Semitones the MIDI note (60 =
// middle C), Cents that times 100. Transpose and Octave shift move every voice.
slider18:60<0,20000,0.001>Pitch value (Hz / semitones / cents)
// The ONE fine tune, in its own unit. Saved voices were cents, and stay so.
slider19:0<-1000,1000,0.001>Fine tune
slider20:2<0,2,1{Hz,Semitones,Cents}>Fine tune unit
// Unit follows Rate Mode. In Drift mode this is an OFFSET from Rate Value; in
// Independent mode it IS the voice's rate.
slider21:0<-1000,1000,0.001>Drift / Rate — offset in Drift mode, this voice's own rate in Independent
// Phase Offset unit follows Rate Mode: BPM = beats, Seconds = seconds,
// Hz = cycles. Values wrap freely -- there is no clamping.
slider22:0<-1000,1000,0.001>Phase Offset
// Per-voice from this build on. Nearly free in the engine: the waveform chain
// was already inside the per-voice loop and already indexed this voice's own
// phase and gain -- only the waveform NUMBER was global.
slider23:0<0,13,1{Sine,Triangle,Saw,Golden TS,Golden SG,Golden GS,Bell,Wavefold,Half-sine,Phi-cascade,Phi Triangle,Phi Sine,Square,Pulse}>Waveform
// The tremolo SHAPE, per voice. Until this build the voices differed in pitch,
// rate and phase but shared one envelope, so the plugin made one kind of sound
// played in a pattern. On Duration is the big one: a voice on for 90% of its
// cycle is a pad, one on for 10% is a rhythm, and they used to be one or the
// other together. The two envelope CURVES (Attack/Release Shape) and the four
// timbre controls stay global -- that is where refinement lives, and this is
// where identity lives.
slider24:-6<-60,0,0.01>Tremolo amount (dB, 0 = strongest)
slider25:100<0,100,0.1>On Duration % of Cycle
slider26:0<0,100,0.1>Attack % of Cycle
slider27:100<0,100,0.1>Release % of Cycle
slider28:-6<-60,6,0.01>Gain dB
// Active bypasses this voice's oscillator entirely. On modern hardware that
// makes no audible difference; on older machines it reduces CPU load. Gain at
// -60 dB is effectively silent but still costs CPU.
slider29:1<0,1,1{Off,On}>Active (Off = no CPU cost)
// Solo. When ANY voice is soloed, only soloed voices sound -- and the level
// normalizer counts the soloed set, so soloing does not change the loudness of
// what is left. Step the selector through the voices with this on and the one
// that is wrong announces itself; until now the only way to hear one voice
// alone was switching seven others off and back on again.
slider30:0<0,1,1{Off,On}>Solo this voice (heard even when Active is off)

// ===== PAN =====
slider31:0<0,1,1{Off,On}>Pan Enabled
slider32:0<0,15,1{Tremolo,Increment,Spread,Spread Reversed,Alternating,Alternating (Flipped),Distributed,Distributed (Flipped),Distributed (Ping-pong),Converging,Converging (Ping-pong),Diverging,Diverging (Ping-pong),Alternating every 2,Alternating every 4,Alternating every 8}>Pan Mode
slider33:100<0,100,0.1>Pan Spread %
// The pan's OWN complete rate pair. It does not borrow the main Rate Mode any
// more -- that borrowing is exactly the gap R21 was written to close, and the
// argument for a shared mode plus a target selector died on it. A plugin with
// two rates has two complete pairs. Only Increment mode uses these; Tremolo
// mode pans at each voice's own tremolo rate and follows the main pair.
//
// The DECLARED DEFAULT of 0 (BPM) is a live value for any instance that never
// touched this control, so the migration writes each instance's actual Rate
// Mode into it rather than relying on the default. A fresh instance has Rate
// Mode 0 too, so the two agree.
slider34:60<0.001,1000,0.001>Pan Base Rate
slider35:0<0,4,1{BPM,Seconds,Hz,Every N beats,N per beat}>Pan rate mode
slider36:0<-1000,1000,0.001>Pan Increment per Voice
// How many positions the Distributed / Converging / Diverging walks step
// through. A TEMPORAL pattern length, nothing to do with how many voices
// exist. Shown for every per-cycle mode from Alternating up: the cycle index
// wraps here, so an ODD value makes Alternating limp (0,1,2 gives -1,+1,-1)
// and hiding the control would hide the cause.
slider37:8<2,1000,1>Cycle Steps (per-cycle modes)
// 0 is an instant switch and is a genuinely different result, not a nicety:
// bilateral alternation is meant to be a cut, not a sweep.
slider38:10<0,1000,0.1>Pan Glide ms (0=instant)

// ===== DIRECTION & REVERSE =====
// Forward            -- 8 voices, current behavior.
// Reverse -- permute -- 8 voices. Drift values mirrored V1<->V8, V2<->V7,
//                       V3<->V6, V4<->V5; notes, gains, phase offsets, active
//                       flags stay in place. The low note now fires at the
//                       highest cadence and vice versa. (Permuting every
//                       setting together is a no-op on the audio sum -- slot
//                       order doesn't change what gets added. Mirroring just
//                       drift is what produces an audible reordering.)
// Reverse -- time    -- 8 voices, tremolo phase decrements instead of
//                       increments. The on/off pattern (and any asymmetric
//                       attack/release envelope) plays backwards.
// Both -- permute    -- 16 voices. Forward layer (slots 0-7) unchanged.
//                       Reverse layer (slots 8-15) is the forward layer with
//                       drift values mirrored -- each note plays at TWO
//                       different cadences across the two layers.
// Both -- time       -- 16 voices. Same drift as the forward layer but the
//                       tremolo phase advances backward, so the asymmetric
//                       envelope fades in where the forward layer fades out --
//                       the pulsing cancels into a continuous drone.
slider39:0<0,4,1{Forward,Reverse — permute,Reverse — time,Both — permute,Both — time}>Direction & Reverse
// Added to every drift/rate value in the reverse layer (slots 8-15) in Both
// modes, so the two layers no longer run at matched cadences. Hidden in
// single-layer modes, where it would only duplicate the global Rate Value.
slider40:0<-1000,1000,0.001>Reverse Drift Offset

// ===== TRANSPORT =====
// Start delay: the plugin sits silent for this many units after playback
// starts, then resumes normally. Units match Rate Mode, interpreted against
// Rate Value for beats and cycles. Re-arms on every transport stop/start.
slider41:0<0,1000,0.001>Start delay (in rate mode units)
// Per-voice cyclic gate. Each voice plays for `Play for` cycles of its OWN
// tremolo rate, then is silent for `Rest for` cycles of the same per-voice
// rate, then resumes. Because counting is per-voice, a fast voice reaches its
// threshold sooner in real time than a slow one and enters rest first -- and
// wakes first too. The "loop" the listener hears is per-voice; the global
// rhythmic identity comes from how the voices' gates interlock.
//
// On the FINAL cycle of each play period the always-on Depth floor is
// cancelled during the release, so the tail decays to genuine 0 instead of
// bottoming at the Depth setting and thudding into the freeze. This needs a
// non-zero Release to do anything: with Release = 0% the release zone has zero
// width and you get the sharp cutoff that Release = 0 implies.
//
// Disabled if either slider is 0. Transport stop/play does NOT preserve gate
// state -- pressing play begins a fresh play period from cycle 0.
slider42:0<0,1000,1>Play for (cycles)
slider43:0<0,1000,1>Rest for (cycles)

// ===== DRIFT (per-target, nested-selector) =====
// Pick a target, then the six controls below hold THAT target's drift config.
// All 88 targets drift in parallel; the selector only chooses which one you
// are currently editing.
//
// Up/Down amount is in the target's natural unit: the rate's current unit for
// the rate targets, Hz for Binaural Beat, dB for the Gain targets and Depth,
// percent for On Duration / Attack / Release.
slider44:0<0,87,1{Base Rate,Tuning reference,Transpose,Binaural Beat,Pulse width,Tone,Edge,Movement,Body,Pitch (all voices),V1 Pitch,V2 Pitch,V3 Pitch,V4 Pitch,V5 Pitch,V6 Pitch,V7 Pitch,V8 Pitch,Fine tune (all voices),V1 Fine tune,V2 Fine tune,V3 Fine tune,V4 Fine tune,V5 Fine tune,V6 Fine tune,V7 Fine tune,V8 Fine tune,Rate (all voices),V1 Rate,V2 Rate,V3 Rate,V4 Rate,V5 Rate,V6 Rate,V7 Rate,V8 Rate,Tremolo amount (all voices),V1 Tremolo amount,V2 Tremolo amount,V3 Tremolo amount,V4 Tremolo amount,V5 Tremolo amount,V6 Tremolo amount,V7 Tremolo amount,V8 Tremolo amount,On duration (all voices),V1 On duration,V2 On duration,V3 On duration,V4 On duration,V5 On duration,V6 On duration,V7 On duration,V8 On duration,Attack (all voices),V1 Attack,V2 Attack,V3 Attack,V4 Attack,V5 Attack,V6 Attack,V7 Attack,V8 Attack,Release (all voices),V1 Release,V2 Release,V3 Release,V4 Release,V5 Release,V6 Release,V7 Release,V8 Release,Gain (all voices),V1 Gain,V2 Gain,V3 Gain,V4 Gain,V5 Gain,V6 Gain,V7 Gain,V8 Gain,Pan spread,Pan base rate,Pan increment,Pan glide,Reverse drift offset,Play for,Rest for}>Drift target
slider45:0<0,1000,0.01>Drift up amount (per target, units match target)
slider46:0<0,1000,0.01>Drift down amount (per target, units match target)
slider47:8<0,1000,1>Drift period (per target, 0 = off)
// What the period is COUNTED IN. Cycles is this plugin's native count and the
// default -- a period of 8 means eight tremolo cycles, and it follows the rate
// for free. Seconds is wall clock. Beats converts at the LIVE project tempo,
// so the wander follows the host rather than the rhythm.
slider48:0<0,2,1{Cycles,Seconds,Beats}>Drift period unit (all targets)
slider49:0<0,2,1{Sine,Triangle,Random}>Drift shape (per target)
// Drift play/rest, per target, counted in PERIODS. Both must be above zero for
// the gate to engage. While resting the drift phase does not advance at all,
// so the offset FREEZES where it stopped rather than returning to centre --
// and the FRACTION of the play value chooses where it parks: x.25 crest, x.75
// trough, x.0 and x.5 neutral. So a whole number parks at no-change every time
// and is nearly inaudible; an awkward fraction is the interesting one, because
// each freeze lands further round the wave than the last.
slider50:0<0,1000,0.01>Drift play for (per target, periods, 0 = always)
slider51:0<0,1000,0.01>Drift rest for (per target, periods, 0 = always)

// ===== RAMP =====
// A one-time slow RIDE of a parameter. Pick a target, where to take it and
// over how long, arm Engage, and it glides there once and holds. Nested-
// selector like Drift; all targets ride in parallel off one Engage.
//
// Base Rate (target 0) rides as a multiplicative RATIO so every voice scales
// in proportional lockstep, preserving the slow beats between them. The other
// 23 targets ride as additive offsets in their own units.
slider52:0<0,87,1{Base Rate,Tuning reference,Transpose,Binaural Beat,Pulse width,Tone,Edge,Movement,Body,Pitch (all voices),V1 Pitch,V2 Pitch,V3 Pitch,V4 Pitch,V5 Pitch,V6 Pitch,V7 Pitch,V8 Pitch,Fine tune (all voices),V1 Fine tune,V2 Fine tune,V3 Fine tune,V4 Fine tune,V5 Fine tune,V6 Fine tune,V7 Fine tune,V8 Fine tune,Rate (all voices),V1 Rate,V2 Rate,V3 Rate,V4 Rate,V5 Rate,V6 Rate,V7 Rate,V8 Rate,Tremolo amount (all voices),V1 Tremolo amount,V2 Tremolo amount,V3 Tremolo amount,V4 Tremolo amount,V5 Tremolo amount,V6 Tremolo amount,V7 Tremolo amount,V8 Tremolo amount,On duration (all voices),V1 On duration,V2 On duration,V3 On duration,V4 On duration,V5 On duration,V6 On duration,V7 On duration,V8 On duration,Attack (all voices),V1 Attack,V2 Attack,V3 Attack,V4 Attack,V5 Attack,V6 Attack,V7 Attack,V8 Attack,Release (all voices),V1 Release,V2 Release,V3 Release,V4 Release,V5 Release,V6 Release,V7 Release,V8 Release,Gain (all voices),V1 Gain,V2 Gain,V3 Gain,V4 Gain,V5 Gain,V6 Gain,V7 Gain,V8 Gain,Pan spread,Pan base rate,Pan increment,Pan glide,Reverse drift offset,Play for,Rest for}>Ramp target
slider53:0<-1000,1000,0.001>Ramp by (per target, units match target)
// What the duration and start delay are COUNTED IN. The DECLARED DEFAULT IS 2,
// Minutes, and that is not a free choice: every saved instance has this control
// unset, so the default is the live value all of them run on, and putting
// Cycles at index 0 would silently rewrite a thirty-minute ramp into a
// two-second one.
slider54:2<0,3,1{Cycles,Seconds,Minutes,Beats}>Ramp time unit (all targets)
slider55:0<0,1000,0.1>Ramp duration (per target, in ramp time units)
// Ramp play/rest, per target: the ramp advances for `play`, holds for `rest`,
// and repeats, so it climbs as a staircase rather than a smooth glide. The
// holds come OUT of the duration rather than extending it -- the advancing
// step is scaled by (play+rest)/play -- so Ramp duration goes on meaning "you
// arrive in about this long". Both zero is the smooth ramp.
slider56:0<0,1000,0.01>Ramp play for (per target, 0 = smooth)
slider57:0<0,1000,0.01>Ramp rest for (per target, 0 = smooth)
// Engage is a freeze/resume gate, NOT a restart edge; only transport play
// resets the ramp clocks.
slider58:0<0,1,1{Off,On}>Ramp engage (all targets)
slider59:0<0,1000,0.1>Ramp start delay (per target, in ramp time units)


@init
// Rate drift and Speed Ramp are in BPM in EVERY mode, Host x included --
// "BPM is BPM". In Host x the rate slider is a multiplier, so a BPM amount is
// converted to multiplier terms (D BPM = D/tempo) before it's added. The
// PLUGIN does that division, never the user. Rejected alternative: a
// multiplier delta -- consistent on paper, unusable in practice, since
// reaching a musical destination then needs arithmetic (1 - 1/3 = 0.667 for
// "every three beats"), and a ramp deliberately leaves the grid anyway.
// Parameter deliberately NOT a short name: EEL2 folds case, so a global `D`
// anywhere in the file would BE this parameter and the function would
// silently self-assign (the spectral_vowel_probe silence bug in CLAUDE.md).
// Returns the amount in the unit it must be ADDED in. Outside Host x that is
// the rate slider's own unit, so the amount passes through untouched. In Host x
// it is NOMINAL Hz (cycles/sec as if the project were at 60 BPM), because Rate
// Value there is beats per cycle and cannot take a BPM delta directly. Callers
// must therefore add the Host x result to the HZ, never to the raw slider
// value -- see the notes at the two call sites.
function host_bpm_delta(bpm_amt) (
  rate_mode >= 3 ? bpm_amt / max(host_bpm, 0.001) : bpm_amt
);
// v2.10 render-state fix (Path A — see docs/v2.9-render-state-bug.md).
// NO ext_noinit: we let REAPER re-run @init on every transport play /
// render start (its default, how the stock filters work), which resets
// all runtime state for free — voice phases/gains, Play/Rest counters,
// Start Delay, Speed Ramp, drift runtime, character chain + chorus
// buffer. That fixes render-after-stop and alt-tab resume, and a note's
// release tail rings out naturally (nothing resets on STOP). The ONLY
// things @init must NOT wipe on a play re-run are the CONFIG banks (drift
// up/down/period/shape + the Speed Ramp `by` bank); those are guarded by
// drift_cfg_inited below so they survive across play presses.
PHI = 1.6180339887;

// Host tempo capture. `tempo` is READ-ONLY in JSFX (assigning is silently
// ignored -- the rhythm-track bug). Read only, into a global deliberately not
// named `tempo`. Nothing here remembers it, so nothing goes stale on replay.
host_bpm   = max(tempo, 0.001);
host_scale = 1;

// Memory layout — 16 slots each
osc_phase_l  = 0;
osc_phase_r  = 16;
trem_phase   = 32;
gain_l       = 48;
gain_r       = 64;
v_freq_l     = 80;
v_freq_r     = 96;
v_trem_freq  = 112;
v_active     = 128;
v_semitones  = 144;
v_dr         = 160;  // Drift (Drift mode) or Rate (Independent mode)
pan_phase    = 176;
pan_smooth   = 192;
v_pan_freq   = 208;
v_gain       = 224;
v_phase_off      = 240;  // Phase offset, stored as raw slider value (unit = Rate Mode unit)
v_phase_off_last = 256;  // Last known offset per voice — used to detect live changes
v_pan_static     = 272;  // Static pan target per voice (-1..+1) for Spread modes
v_resting        = 288;  // Per-voice Play/Rest flag: 1 = frozen (rest), 0 = playing
v_pr_cycle       = 304;  // Per-voice Play/Rest cycle counter — accumulates at the
                         //   voice's own v_trem_freq[i] regardless of play/rest
                         //   state. Compared against play_for_cycles (when playing)
                         //   or rest_for_cycles (when resting); reset to 0 on each
                         //   state flip. This is what makes V8 (fast drift) pause
                         //   sooner in real time than V1 (slow drift) — and wake
                         //   sooner too, since the rest counter also advances at
                         //   the voice's own rate. Symmetric per-voice semantic.

// Character chain state (post-voice-sum DSP, sliders 69-72).
// Tone:  one-pole lowpass state per channel for the tilt EQ.
// Edge:  stateless (tanh) — no state needed.
// Body:  biquad peaking EQ per channel — last 2 in / last 2 out samples each.
tone_lp_l   = 0;
tone_lp_r   = 0;
body_x1_l   = 0;
body_x2_l   = 0;
body_y1_l   = 0;
body_y2_l   = 0;
body_x1_r   = 0;
body_x2_r   = 0;
body_y1_r   = 0;
body_y2_r   = 0;

// Movement: mono delay buffer at slot 320, 8192 samples (enough for ~85 ms
// at 96 kHz, ~170 ms at 48 kHz). Two LFO-offset read taps drive L/R output
// for stereo chorus motion.
chorus_buf       = 320;   // 320..8511 (8192 slots)
chorus_buf_size  = 8192;
chorus_write_pos = 0;
chorus_lfo_phase = 0;
// Clear the delay buffer on every @init (incl. transport-play re-runs)
// so the wet tail doesn't carry across stop/play — REAPER only zeroes
// memory at instantiation, not on the re-run.
memset(chorus_buf, 0, chorus_buf_size);
// Per-cycle pan runtime is seeded per voice in the loop below.

// Initialize 16 slots — slots 0-7 always used; slots 8-15 hold the
// reverse layer in Both modes and stay zeroed otherwise.
i = 0;
loop(16,
  osc_phase_l[i] = 0;
  osc_phase_r[i] = 0;
  trem_phase[i]  = 0;
  gain_l[i]      = 1;
  gain_r[i]      = 1;
  pan_smooth[i]  = 0;
  pan_cycle_index[i] = 0;
  pan_cycle_dir[i]   = 1;
  v_gain[i]      = 1;
  v_phase_off[i]      = 0;
  v_phase_off_last[i] = 0;
  v_resting[i]        = 0;
  v_pr_cycle[i]       = 0;
  i += 1;
);

smooth = exp(-1 / (srate * 0.003));

// Counts up from 0 at each play start until it reaches start_delay_sec,
// then the voice loop runs normally. start_delay_sec is computed in
// @slider from the user-facing units; initialized to 0 here so the
// default behavior (no delay) doesn't gate the first sample.
start_delay_elapsed = 0;
start_delay_sec     = 0;

// Play/Rest gating state. play_for_cycles / rest_for_cycles are read
// from sliders 63/64 in @slider. Each voice has its own cycle counter
// (v_pr_cycle[i]) advancing at its own v_trem_freq[i] — no global
// counter needed. v_resting and v_pr_cycle are zeroed in the slot-init
// loop above, so all voices start in the "playing" state on every
// transport play (since @init re-runs on play).
play_for_cycles = 0;
rest_for_cycles = 0;

// Speed Ramp state. Engage (global) is a freeze/resume gate, not an edge;
// only transport play resets the per-target ramp clocks. As of v2.14 the ramp
// is PER-TARGET (own by/duration/start-delay/clock per target; banks below).
// speed_scale_current is the Base-Rate ramp factor (target 0), recomputed each
// sample.
speed_scale_current      = 1.0;

// (last_play_state removed in v2.10 Path A — no transport-edge handler
// anymore; @init re-running on play is the reset.)

// --- Drift and Ramp target banks (88 targets, 2026-09-10) -------------------
// 128-slot-spaced from 9552. The 24-target banks that lived at 8512..8927 and
// 9152..9407 are now the old24_* SCRATCH banks a 2200024 save is read into.
// The target list is authored in docs/layouts/polyrhythm-phase-v3-r22-r24.md:
//   0 Base Rate   1 Tuning reference   2 Transpose   3 Binaural Beat
//   4 Pulse width   5 Tone   6 Edge   7 Movement   8 Body
//   9 + 9c = <control> (all voices), 10 + 9c + v = V(v+1) <control>, over
//     c = Pitch, Fine tune, Rate, Tremolo amount, On duration, Attack,
//         Release, Gain  (so V1 Rate is 28, V1 Gain is 73)
//   81 Pan spread  82 Pan base rate  83 Pan increment  84 Pan glide
//   85 Reverse drift offset  86 Play for  87 Rest for
// An all-voices entry holds nothing: its banks stay zero, so it never drifts.
N_TARGETS = 88;
target_drift_up     = 9552;
target_drift_down   = 9680;
target_drift_per    = 9808;
target_drift_shape  = 9936;
target_drift_phase  = 10064;
target_drift_prev   = 10192;
target_drift_curr   = 10320;
target_drift_offset = 10448;

// Speed Ramp per-target "by" bank base pointer (v2.10) — one signed `by`
// per target (24), same indexing as the drift bank. Placed just above
// the drift bank (which ends at 8768). CONFIG, like the drift bank.
speed_ramp_by_mem = 10576;

// Speed ramp per-target timeline banks (v2.14). 32-slot-spaced (24 targets
// exceed 16) above the `by` bank. duration + start-delay are CONFIG (survive
// transport, restored by @serialize); ramp_t + delay_elapsed are RUNTIME.
speed_ramp_dur_mem           = 10704;  // duration minutes per target (CONFIG)
speed_ramp_delay_mem         = 10832;  // start-delay minutes per target (CONFIG)
speed_ramp_ramp_t_mem        = 10960;  // ramp progress 0..1 per target (RUNTIME)
speed_ramp_delay_elapsed_mem = 11088;
// Per-cycle pan, PER VOICE. Each voice walks its own pan pattern, advanced by
// its OWN tremolo wrap -- so eight voices at eight rates move through the
// stereo field at eight rates. A single shared index would leave them
// polyrhythmic in time and identical in space, which is the opposite of what
// this plugin is for. When voices DO share a rate they wrap together and this
// behaves exactly like a shared index, so being right costs nothing.
// Placed at 8928 on 2026-09-07; the per-target banks have since moved to 9552+.
pan_cycle_index = 8928;
pan_cycle_dir   = 8944;  // delay sample counter per target (RUNTIME)

// --- Per-voice CONFIG banks (2026-09-07, the voices-behind-a-selector build) --
// Twelve values per voice, eight voices, 16-slot-spaced. These are the plugin's
// per-voice settings: they used to be 48 sliders and are now reached through the
// Voice selector. CONFIG, so they live under the drift_cfg_inited guard below
// and are restored by @serialize.
//
// EVERYTHING DERIVED FROM THESE IS COMPUTED IN @block, NEVER IN @slider.
// @slider and @serialize restore by two independent paths with no guaranteed
// order, so a derivation in @slider can run against @init defaults and then
// never recompute when the banks are filled in underneath -- the bug whose
// signature is "wiggling any slider brings it back, transport does not".
vm_note   = 8960;
vm_fine   = 8976;
vm_dr     = 8992;
vm_phoff  = 9008;
vm_wave   = 9024;
vm_depth  = 9040;
vm_ondur  = 9056;
vm_att    = 9072;
vm_rel    = 9088;
vm_gain   = 9104;
vm_active = 9120;
vm_solo   = 9136;

// Drift and Ramp play/rest, per target. 32-slot-spaced like every other
// per-target bank here. play/rest are CONFIG (survive a transport re-init,
// restored by @serialize); the accumulator and the resting flag are RUNTIME.
drift_play_mem       = 11216;  // periods of drift to run   (CONFIG)
drift_rest_mem       = 11344;  // periods to hold frozen    (CONFIG)
sr_play_mem          = 11472;  // ramp time to advance      (CONFIG)
sr_rest_mem          = 11600;  // ramp time to hold         (CONFIG)
drift_pr_accum_mem   = 11728;  // (RUNTIME)
drift_pr_resting_mem = 11856;  // (RUNTIME)
sr_pr_accum_mem      = 11984;  // (RUNTIME)
sr_pr_resting_mem    = 12112;  // (RUNTIME)

// Per-voice DERIVED runtime, recomputed every @block from the banks above.
// 16-slot-spaced because the Both modes run 16 slots, not 8.
v_wave       = 9408;  // waveform index per slot
v_solo       = 9424;  // solo flag per slot
v_amt_pre    = 9440;  // tremolo depth floor  (1 - 2^(depth/6))
v_sc_pre     = 9456;  // tremolo depth swing  (0.5 * 2^(depth/6))
v_on_pre     = 9472;  // on-duration fraction
v_att_pre    = 9488;  // attack fraction
v_rel_pre    = 9504;  // release fraction
v_re_pre     = 9520;  // phase at which the release segment begins

// Change-detection mirror for the twelve visible per-voice sliders (16..27).
// Adopted in @block, never in @slider -- see the note at the adopt site.
vui_last = 9536;   // fifteen used since the pitch block

// --- 2026-09-10: the pitch block, the target mirrors, and the old scratch -----
vm_pmode = 12240;  // Pitch mode per voice: 0 Hz, 1 Semitones, 2 Cents (CONFIG)
vm_pval  = 12256;  // Pitch value per voice                          (CONFIG)
vm_funit = 12272;  // Fine tune unit per voice                       (CONFIG)
// vm_note is the Note name bank, a MIDI note 0..127 since this build.
dui_last = 12288;  // mirror of the visible Drift (6) and Ramp (5) controls
// Scratch for reading a 24-target (2200024) save at its own width. These are
// the addresses those banks used to occupy, so nothing else lives there.
old24_up    = 8512; old24_down  = 8544; old24_per   = 8576; old24_shape = 8608;
old24_by    = 8768; old24_dur   = 8800; old24_delay = 8832;
old24_dplay = 9152; old24_drest = 9184; old24_splay = 9216; old24_srest = 9248;

// FIRST FREE SLOT AFTER THIS BLOCK IS 12304 -- re-derive it rather than trusting
// this comment, with:
//   grep -nE '^[a-z_]+ *= *[0-9]{3,} *;' src/polyrhythm_phase_v3.jsfx

// CONFIG banks (drift up/down/period/shape + Speed Ramp by/duration/start-delay
// + the selector trackers) — initialized ONCE per plugin instance, guarded by
// drift_cfg_inited so the @init re-run on every transport play does NOT wipe
// the user's setup (Path A render fix relies on @init re-running). A fresh
// instance starts with drift_cfg_inited = 0 (REAPER zeroes memory on
// instantiation); @serialize restores saved configs on project load.
drift_cfg_inited != 1 ? (
  i = 0;
  loop(N_TARGETS,
    target_drift_up[i]    = 0;
    target_drift_down[i]  = 0;
    target_drift_per[i]   = 8;
    target_drift_shape[i] = 0;
    speed_ramp_by_mem[i]    = 0;
    speed_ramp_dur_mem[i]   = 0;
    speed_ramp_delay_mem[i] = 0;
    drift_play_mem[i] = 0; drift_rest_mem[i] = 0;
    sr_play_mem[i]    = 0; sr_rest_mem[i]    = 0;
    i += 1;
  );
  // Per-voice CONFIG defaults. These reproduce a fresh v3 instance exactly as
  // it was before the voices went behind the selector: eight voices at C4,
  // -6 dB, sine, full on-duration, and only VOICE 1 ACTIVE. That last asymmetry
  // is why the banks are seeded per voice rather than from one declared
  // default -- the visible Active slider declares 1, which is voice 1's value,
  // and All shows voice 1 when the voices disagree.
  i = 0;
  loop(8,
    vm_note[i]   = 60;   // C4, as a MIDI note
    vm_pmode[i]  = 1;    // Semitones
    vm_pval[i]   = 60;
    vm_funit[i]  = 2;    // Cents
    vm_fine[i]   = 0;
    vm_dr[i]     = 0;
    vm_phoff[i]  = 0;
    vm_wave[i]   = 0;    // Sine
    vm_depth[i]  = -6;
    vm_ondur[i]  = 100;
    vm_att[i]    = 0;
    vm_rel[i]    = 100;
    vm_gain[i]   = -6;
    vm_active[i] = (i == 0) ? 1 : 0;
    vm_solo[i]   = 0;
    i += 1;
  );
  last_target_select = 0;
  last_speed_target  = 0;
  last_voice_sel     = 0;
  drift_cfg_inited   = 1;
);

// Drift + speed-ramp RUNTIME (phase / random-shape / computed offset / ramp
// clocks) resets on EVERY @init — i.e. every transport play — so drift + ramp
// restart from 0 each play, continue across stop, clean on render.
i = 0;
loop(N_TARGETS,
  speed_ramp_ramp_t_mem[i]        = 0;
  speed_ramp_delay_elapsed_mem[i] = 0;
  target_drift_phase[i]  = 0;
  target_drift_prev[i]   = 0;
  target_drift_curr[i]   = 0;
  target_drift_offset[i] = 0;
  drift_pr_accum_mem[i]   = 0;
  drift_pr_resting_mem[i] = 0;
  sr_pr_accum_mem[i]      = 0;
  sr_pr_resting_mem[i]    = 0;
  i += 1;
);

// Safe values for everything @block derives, in case it ever runs before
// @slider has. Belt and braces: REAPER does run @slider at load, but a loop
// bound of 0 or a tuning reference of 0 would be silent rather than loud, and
// silence is the failure mode that gets misdiagnosed.
n_voices    = 8;
tuning_ref  = 440;
base_note   = 0;
center_octave = 4;
rate_mode   = 0;
rate_val    = 60;
trem_mode   = 0;
any_solo    = 0;
total_active = 1;
voice_ui_inited = 0;
drift_ui_inited = 0;
last_pulse_vis  = -1;

// Drift / Ramp play-rest gate, shared by both. Counts `tick` per sample into
// the target's accumulator; when it passes the current threshold it flips
// between playing and resting and starts again. Returns 1 while frozen. Both
// values must be above zero or the gate is off entirely.
function pr_frozen(accum_bank, resting_bank, idx, tick, play, rest) (
  play > 0 && rest > 0 ? (
    accum_bank[idx] += tick;
    accum_bank[idx] >= (resting_bank[idx] ? rest : play) ? (
      accum_bank[idx] = 0;
      resting_bank[idx] = 1 - resting_bank[idx];
    );
    resting_bank[idx];
  ) : ( 0; );
);

// --- The Voice selector's three operations --------------------------------
// Which bank slot the selector is pointing at for READING. All (0) reads
// voice 1: reading is approximate, writing is exact.
function voice_read_slot(vsel) (
  vsel > 0 ? vsel - 1 : 0;
);

// Write one value through the selector. On a voice, that is one slot; on All,
// it is all eight -- which is the whole point of All, and why there are no
// separate global copies of these controls any more.
function voice_write(vsel, vbank, vval) local(vw_i) (
  vsel > 0 ? (
    vbank[vsel - 1] = vval;
  ) : (
    vw_i = 0;
    loop(8, vbank[vw_i] = vval; vw_i += 1;);
  );
);

// Write only if this control actually MOVED since the last pass, and remember
// the new value. This is what makes parking on All safe: moving Tone, or a
// stray @slider pass during a project load, writes nothing to any voice. It
// also means switching the selector needs no save step, because every edit was
// already written the moment it happened.
function voice_capture(vsel, vbank, vval, vslot) (
  vval != vui_last[vslot] ? (
    voice_write(vsel, vbank, vval);
    vui_last[vslot] = vval;
  );
);

// --- The Drift and Ramp lists' "all voices" entries -------------------------
// Entries 9, 18, 27 ... 72 are "<control> (all voices)". They hold nothing of
// their own: reading shows voice 1's setup, and writing reaches all eight
// voices' targets -- the Voice selector's All, applied to a target list.
function tgt_is_all(t) ( t >= 9 && t <= 72 && (t - 9) % 9 == 0; );
function tgt_read_slot(t) ( tgt_is_all(t) ? t + 1 : t; );
function tgt_write(t, tbank, tval) local(tw_k) (
  tgt_is_all(t) ? (
    tw_k = 1;
    loop(8, tbank[t + tw_k] = tval; tw_k += 1;);
  ) : (
    tbank[t] = tval;
  );
);
// Change-detected, exactly like voice_capture and for the same reason: parked
// on an all-voices entry, a wholesale capture would flatten eight voices' setups
// on any stray @slider pass.
function tgt_capture(t, tbank, tval, tslot) (
  tval != dui_last[tslot] ? (
    tgt_write(t, tbank, tval);
    dui_last[tslot] = tval;
  );
);
// A 24-target save's target number, in this build's list. The four shared
// envelope targets land on their all-voices entries, which copy into eight.
function poly_old_to_new(t) (
  t == 0 ? 0 : t <= 8 ? 27 + t : t == 9 ? 82 : t == 10 ? 83 : t == 11 ? 3 :
  t == 12 ? 45 : t <= 20 ? 60 + t : t == 21 ? 36 : t == 22 ? 54 : 63;
);
function poly_copy_old(ot, nt) (
  tgt_write(nt, target_drift_up,      old24_up[ot]);
  tgt_write(nt, target_drift_down,    old24_down[ot]);
  tgt_write(nt, target_drift_per,     old24_per[ot]);
  tgt_write(nt, target_drift_shape,   old24_shape[ot]);
  tgt_write(nt, speed_ramp_by_mem,    old24_by[ot]);
  tgt_write(nt, speed_ramp_dur_mem,   old24_dur[ot]);
  tgt_write(nt, speed_ramp_delay_mem, old24_delay[ot]);
  tgt_write(nt, drift_play_mem,       old24_dplay[ot]);
  tgt_write(nt, drift_rest_mem,       old24_drest[ot]);
  tgt_write(nt, sr_play_mem,          old24_splay[ot]);
  tgt_write(nt, sr_rest_mem,          old24_srest[ot]);
);

// One voice's frequency from its own pitch block. The value IS the pitch in
// that voice's Pitch mode; Transpose and Octave shift move every voice; the one
// fine tune sits on top in its own unit. vo and fo are drift + ramp in the
// value's and the fine tune's own units; tro is semitones on Transpose, refo Hz
// on the tuning reference.
//
// Semitones with a Cents fine tune is the migrated case, and it keeps the OLD
// arithmetic token for token -- (note - 24) + cents * 0.01 through the old
// exponent -- so every saved voice lands on the identical frequency, fine tune
// included. With every offset idle, x + 0 is x. The other combinations follow
// Melody's voice_hz.
function voice_pitch_hz(pv, pm, pf, pu, vo, fo, tro, refo) local(h, s, rs) (
  pm == 1 && pu == 2 ? (
    s = (pv + vo - 60) + (pf + fo) * 0.01;
    h = (tuning_ref + refo) * pow(2, ((center_octave + 1) * 12 + (base_note + tro) + s - 69) / 12.0);
  ) : (
    rs = (base_note + tro) + 12 * (center_octave - 4);
    h = pm == 1 ? (tuning_ref + refo) * pow(2, (pv + vo + rs - 69) / 12.0) :
        pm == 2 ? (tuning_ref + refo) * pow(2, ((pv + vo) / 100 + rs - 69) / 12.0) :
                  (pv + vo) * pow(2, rs / 12.0);
    h = pu == 0 ? h + (pf + fo) :
        pu == 1 ? h * pow(2, (pf + fo) / 12) :
                  h * pow(2, (pf + fo) / 1200);
  );
  min(max(h, 1), 20000);
);

function semitones_to_hz(base_note, center_octave, semitones) (
  tuning_ref * pow(2, ((center_octave + 1) * 12 + base_note + semitones - 69) / 12.0)
);

function apply_curve(t, shape) (
  shape == 0 ? t :
  shape == 1 ? (0.5 - 0.5 * cos(t * $pi)) :
  shape == 2 ? (log(1 + 9*t) / log(10)) :
               ((pow(10, t) - 1) / 9)
);

function calc_lfo(ph, on_frac, att_frac, rel_frac, att_shape, rel_shape)
local(aw, rw, hold_w, re_start, t, result, total) (
  aw = att_frac;
  rw = rel_frac;
  aw + rw > on_frac ? (
    total = aw + rw;
    aw = aw / total * on_frac;
    rw = rw / total * on_frac;
  );
  hold_w   = on_frac - aw - rw;
  re_start = aw + hold_w;
  ph < aw ? (
    aw > 0.0001 ? (
      t = ph / aw;
      result = apply_curve(t, att_shape);
    ) : (result = 1);
  ) :
  ph < re_start ? (
    result = 1;
  ) :
  ph < on_frac ? (
    rw > 0.0001 ? (
      t = 1 - (ph - re_start) / rw;
      result = apply_curve(t, rel_shape);
    ) : (result = 0);
  ) : (
    result = 0;
  );
  result
);

// ---------------------------------------------------------------------------
// Per-cycle pan. Behaviour PORTED from the sweeping filter / sweep dwell /
// tremolo pan block so the same mode NAMES mean the same thing across the
// suite -- the concept already existed in four plugins and the oscillator
// plugins were the ones missing it. Only the TICK differs: there it advances
// on the filter LFO wrap, here on the reference voice's TREMOLO wrap. That is
// the point of it -- the pan moves because the sound did, so there is no
// second clock to fall out of step with, and nothing to hand-match.
//
// The filter numbers these 1-9 with Mono at 0. Here they are appended after
// this plugin's existing four modes, so pan_mode 4..12 maps onto its 1..9 --
// hence the -3. Modes 0-3 are untouched and no saved project moves.
// Advance ONE voice's pan cycle. Called from that voice's tremolo wrap, so the
// pan pattern is carried by the voice's own rhythm and cannot drift from it.
// Ping-pong modes are 8 / 10 / 12 here, the filter's 5 / 7 / 9.
function advance_pan_cycle(v) (
  pan_mode >= 4 ? (
    (pan_mode == 8 || pan_mode == 10 || pan_mode == 12) ? (
      pan_cycle_index[v] += pan_cycle_dir[v];
      (pan_cycle_index[v] >= pan_cycle_mod - 1 || pan_cycle_index[v] <= 0) ?
        pan_cycle_dir[v] = -pan_cycle_dir[v];
    ) : (
      pan_cycle_index[v] = (pan_cycle_index[v] + 1) % pan_cycle_mod;
    );
  );
);

function percycle_pan(idx, n_steps) local(steps, step, pos, m) (
  n_steps = max(n_steps, 1);
  steps   = max(ceil((n_steps - 1) / 2.0), 1);
  m       = pan_mode - 3;

  m == 1 ? (
    pos = (idx % 2 == 0) ? -1 : 1;
  ) : m == 2 ? (
    pos = (idx % 2 == 0) ? 1 : -1;
  ) : m == 3 ? (
    n_steps > 1 ? (pos = (idx % n_steps) / (n_steps - 1.0) * 2.0 - 1.0) : (pos = 0);
  ) : m == 4 ? (
    n_steps > 1 ? (pos = 1.0 - (idx % n_steps) / (n_steps - 1.0) * 2.0) : (pos = 0);
  ) : m == 5 ? (
    n_steps > 1 ? (pos = idx / (n_steps - 1.0) * 2.0 - 1.0) : (pos = 0);
  ) : (m == 6 || m == 7) ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = -1.0;
    ) : (
      step = ceil((idx + 1) / 2);
      pos = (idx % 2 == 1) ?  (1.0 - (step - 1.0) / steps)
                            : -(1.0 - (step - 1.0) / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : (m == 8 || m == 9) ? (
    idx = idx % n_steps;
    idx == 0 ? (
      pos = 0.0;
    ) : (
      step = floor((idx + 1) / 2);
      pos = (idx % 2 == 1) ? -(step / steps)
                            :  (step / steps);
      pos = max(-1.0, min(1.0, pos));
    );
  ) : (m == 10 || m == 11 || m == 12) ? (
    // Alternating every N. Same flip, but it holds each side for N cycles --
    // so bilateral stays usable when the notes themselves are fast. Still
    // driven by the cycle, so it lands exactly on the boundaries.
    step = m == 10 ? 2 : m == 11 ? 4 : 8;
    pos  = (floor(idx / step) % 2 == 0) ? -1 : 1;
  ) : (
    pos = 0;
  );

  pos * pan_spread
);

function rate_to_hz(raw_rate, rmode) (
  // Host x (mode 3) returns a NOMINAL rate, computed as if the project were
  // at 60 BPM, so this stays tempo-INDEPENDENT; the live tempo is applied as
  // host_scale in @block. Keeping the tempo out of here is what lets the mode
  // survive a transport press -- @init re-runs on play and wipes globals, so
  // anything that REMEMBERED the tempo would reset while the derived values
  // still described the old one. Melody Phase shipped that bug.
  rmode == 0 ? max(raw_rate, 0.001) / 60 :
  rmode == 1 ? 1 / max(raw_rate, 0.001) :
  // Host x: Rate Value is BEATS PER CYCLE, not a multiplier (R13 revised,
  // 2026-09-02). At the nominal 60 BPM one beat is one second, so N beats per
  // cycle is 1/N cycles per second; host_scale = tempo/60 in @block then makes
  // it tempo/(60*N), which is exactly "one cycle every N beats". Same shape as
  // Seconds mode, which is the point -- Host x is a rate mode like any other,
  // and Rate Value simply carries the mode's unit as it always has.
  // Guard the zero and negative end. Beats-per-cycle inverts, so clamping the
  // DENOMINATOR turns 0 into 1000 Hz -- and `Vn Drift / Rate` defaults to 0,
  // which in Independent mode IS the voice's rate. Under the old multiplier 0
  // clamped to 0.001 and meant "effectively stopped"; it has to keep meaning
  // that, not the exact opposite. Anything at or below zero returns the same
  // floor the other modes land on.
  rmode == 3 ? (raw_rate > 0.001 ? 1 / raw_rate : 0.001) :
               max(raw_rate, 0.001)
);

// Hyperbolic tangent — not built into eel2, so define it here. Used
// by the Edge character slider for soft-clip saturation. Clamps the
// exp() input above |x| > 7 to avoid overflow on extreme inputs
// (tanh saturates to ±1 well before that anyway).
function tanh(x) local(e2x) (
  abs(x) > 7 ? sign(x) : (
    e2x = exp(2 * x);
    (e2x - 1) / (e2x + 1)
  )
);

// PolyBLEP correction for a step discontinuity. Returns a small
// corrective bump in the samples immediately before AND after t = 0/1.
// Caller ADDs it at an upward step (-1 → +1) or SUBTRACTs at a downward
// step (+1 → -1) to band-limit the corner over ~2 samples. Used by the
// Square (slot 12) and Pulse (slot 13) waveforms.
//   t  = phase position relative to the edge (0..1)
//   dt = phase increment per sample at this voice's frequency
function polyblep(t, dt) local(s) (
  t < dt ? (
    s = t / dt;
    s + s - s * s - 1;
  ) : t > 1 - dt ? (
    s = (t - 1) / dt;
    s * s + s + s + 1;
  ) : (
    0;
  );
);

@slider
// `entered_host_mode` and the retired Host ratio picker block both lived here
// until 2026-09-07 and are GONE, which is a departure from "prove it, annotate
// it, and leave it alone" and needs its reason on the record.
//
// That rule protects code whose removal buys nothing. Here removal was forced:
// the picker read slider88 and this build's highest slider id is 56, so both
// referred to controls that no longer exist. A reference to an undeclared
// slider is not inert, it is a compile error. Nothing else read either of them
// (checked case-insensitively, because EEL2 folds case and a variant would BE
// the same variable), and no saved value depended on them -- the picker had
// been gated behind a literal `0 ?` since 2026-09-02.

trem_mode     = slider1;
rate_mode     = slider3;

// --- Landing in a host mode, and handing you a usable number ---------------
//
// Rate Value defaults to 60 because 60 BPM is
// one cycle per second -- as a BEAT COUNT that is one cycle every sixty beats,
// thirty seconds at 120 BPM, which is slow enough that you cannot tell what the
// control is doing. Exactly the complaint the original comment described.
//
// So on a real in-session switch INTO Host x, land on 4 -- one cycle per bar in
// 4/4, audible immediately and an obvious number to change. Guarded on a mode
// change, never on load: adopting on load would overwrite a hand-set rate the
// moment a saved project opened, which is the restore-order trap.
rate_mode_inited && last_rate_mode != rate_mode ? (
  // Landing values, one per host mode. The two are RECIPROCAL units, so
  // carrying the number across would change the speed wildly -- 4 means one
  // cycle per bar as beats, and four per beat as the other. Stamping is the
  // right behaviour here for the same reason it was for entering Host x at all.
  rate_mode == 3 && last_rate_mode != 3 ? (
    slider2 = 4;                 // one cycle per bar in 4/4
    slider_automate(slider2);
  );
  rate_mode == 4 && last_rate_mode != 4 ? (
    slider2 = 1;                 // one cycle per beat
    slider_automate(slider2);
  );
);
rate_mode_inited ? last_rate_mode = rate_mode;


rate_val      = slider2;
att_shape     = slider4;
rel_shape     = slider5;
tuning_ref    = slider6;
base_note     = slider7;
center_octave = 4 + slider8;
bin_beat_hz   = slider9;
pan_enabled   = slider31;
pan_mode      = slider32;
pan_base_rate = slider34;
pan_rate_mode = slider35;
pan_increment = slider36;

// --- The Voice selector ----------------------------------------------------
// The twelve visible per-voice sliders (16..27) are an EDITING WINDOW onto the
// vm_* banks, not the values themselves. Nothing here derives anything: every
// use of these banks happens in @block, because @slider can run before
// @serialize has filled them in.
//
// Two directions, and only one of them is a save:
//   selector moved  -> LOAD this voice's twelve values into the sliders.
//   otherwise       -> write back any slider that actually MOVED.
//
// There is no save-on-switch step, and that is deliberate. Every edit is
// written the moment it happens, so at the instant the selector moves there is
// nothing outstanding to save. That removes the failure the ordinary
// nested-selector shape has here: with an All position, a wholesale capture
// would copy the visible values into all eight voices on any @slider pass --
// including the ones REAPER fires with default values while a project is still
// loading. Change detection means such a pass writes nothing at all.
//
// voice_ui_inited is adopted in @block, and while it is 0 this block writes
// NOTHING. That is the safe direction, and it is the same fix the sweeping
// filter needed when an adopt-on-first-@slider tracker stamped a picker's
// ratio over a hand-set rate on every load.
sel_voice = slider15;
voice_ui_inited ? (
  last_voice_sel != sel_voice ? (
    vrs = voice_read_slot(sel_voice);
    slider16 = vm_pmode[vrs];  slider17 = vm_note[vrs];
    slider18 = vm_pval[vrs];   slider19 = vm_fine[vrs];
    slider20 = vm_funit[vrs];
    slider21 = vm_dr[vrs];     slider22 = vm_phoff[vrs];
    slider23 = vm_wave[vrs];   slider24 = vm_depth[vrs];
    slider25 = vm_ondur[vrs];  slider26 = vm_att[vrs];
    slider27 = vm_rel[vrs];    slider28 = vm_gain[vrs];
    slider29 = vm_active[vrs]; slider30 = vm_solo[vrs];
    slider_automate(slider16); slider_automate(slider17);
    slider_automate(slider18); slider_automate(slider19);
    slider_automate(slider20); slider_automate(slider21);
    slider_automate(slider22); slider_automate(slider23);
    slider_automate(slider24); slider_automate(slider25);
    slider_automate(slider26); slider_automate(slider27);
    slider_automate(slider28); slider_automate(slider29);
    slider_automate(slider30);
    // Refresh the mirror to what was just loaded, so the next pass does not
    // read the load as fifteen user edits.
    vui_last[0]  = slider16; vui_last[1]  = slider17; vui_last[2]  = slider18;
    vui_last[3]  = slider19; vui_last[4]  = slider20; vui_last[5]  = slider21;
    vui_last[6]  = slider22; vui_last[7]  = slider23; vui_last[8]  = slider24;
    vui_last[9]  = slider25; vui_last[10] = slider26; vui_last[11] = slider27;
    vui_last[12] = slider28; vui_last[13] = slider29; vui_last[14] = slider30;
    last_voice_sel = sel_voice;
  ) : (
    // RECONCILE THE NOTE NAME AND THE PITCH VALUE FIRST, then capture --
    // Breath Generator's order, because the other one banks the stale half.
    // Safe as a two-way binding for one reason: the mirror says which end the
    // user actually moved this pass, so nothing has to guess.
    slider16 == 1 ? (
      slider17 != vui_last[1] ? (
        slider18 = slider17;              // a note was picked; it IS the pitch
        sliderchange(-1);
      ) : (
        pn_note = min(127, max(0, floor(slider18 + 0.5)));
        pn_note != slider17 ? ( slider17 = pn_note; sliderchange(-1); );
      );
    );
    voice_capture(sel_voice, vm_pmode,  slider16, 0);
    voice_capture(sel_voice, vm_note,   slider17, 1);
    voice_capture(sel_voice, vm_pval,   slider18, 2);
    voice_capture(sel_voice, vm_fine,   slider19, 3);
    voice_capture(sel_voice, vm_funit,  slider20, 4);
    voice_capture(sel_voice, vm_dr,     slider21, 5);
    voice_capture(sel_voice, vm_phoff,  slider22, 6);
    voice_capture(sel_voice, vm_wave,   slider23, 7);
    voice_capture(sel_voice, vm_depth,  slider24, 8);
    voice_capture(sel_voice, vm_ondur,  slider25, 9);
    voice_capture(sel_voice, vm_att,    slider26, 10);
    voice_capture(sel_voice, vm_rel,    slider27, 11);
    voice_capture(sel_voice, vm_gain,   slider28, 12);
    voice_capture(sel_voice, vm_active, slider29, 13);
    voice_capture(sel_voice, vm_solo,   slider30, 14);
  );
);
// The note name only means something in Semitones.
slider_show(slider17, slider16 == 1);

direction_reverse     = slider39;
reverse_drift_offset  = slider40;
slot0_7_permute       = (direction_reverse == 1);
slot8_15_permute      = (direction_reverse == 3);
slot0_7_reverse_time  = (direction_reverse == 2);
slot8_15_reverse_time = (direction_reverse == 4);
is_both               = (direction_reverse == 3 || direction_reverse == 4);
n_voices              = is_both ? 16 : 8;

// Start delay — convert the user-facing units to seconds based on Rate
// Mode. BPM beats and Hz cycles are interpreted against the global
// Rate Value, which is what "1 beat" or "1 cycle" means.
// Seconds mode is literal seconds regardless of Rate Value.
start_delay_units = slider41;
// Non-Seconds modes all mean "this many CYCLES", and rate_to_hz already gives
// cycles-per-second, so it collapses to units / that -- identical for BPM and
// Hz, and correct for Host x rather than falling through the Hz branch.
rate_mode == 1 ? start_delay_sec = start_delay_units :
                 start_delay_sec = start_delay_units / max(rate_to_hz(rate_val, rate_mode), 0.001);

// Play/Rest gating — slider values are integer voice-cycle counts.
// Each voice counts ITS OWN cycles (advancing at v_trem_freq[i],
// which is the voice's tremolo Hz after global rate + per-voice drift
// are applied). Per-voice counting + thresholding lives in the voice
// loop in @sample; nothing global to compute here.
play_for_cycles = slider42;
rest_for_cycles = slider43;

// Speed ramp engage-edge.
// No engage-edge detection. Engage is a freeze/resume gate handled
// in @sample. Only transport play resets ramp_t.

// Speed ramp target selector save/restore (v2.10, nested-selector).
// Speed ramp target selector; per-target `by`, duration, and start delay
// (all three per-target as of v2.14). Engage stays GLOBAL. Switching target saves the three
// per-target sliders into the OLD target's bank slots, then loads the NEW
// target's stored values. Otherwise captures live edits. All targets ride in
// parallel from @sample, each on its own duration/delay clock.
sel_speed_target = slider52;
// Change-detected since 2026-09-10, like the Voice selector: an all-voices
// entry writes into eight targets, so a wholesale capture on a stray @slider
// pass would flatten them. There is no save-on-switch step -- every edit is
// written the moment it happens. Nothing is written until @block has adopted
// the mirror.
drift_ui_inited ? (
  last_speed_target != sel_speed_target ? (
    srs = tgt_read_slot(sel_speed_target);
    slider53 = speed_ramp_by_mem[srs];
    slider55 = speed_ramp_dur_mem[srs];
    slider59 = speed_ramp_delay_mem[srs];
    slider56 = sr_play_mem[srs];
    slider57 = sr_rest_mem[srs];
    slider_automate(slider53);
    slider_automate(slider55);
    slider_automate(slider59);
    slider_automate(slider56);
    slider_automate(slider57);
    dui_last[6] = slider53; dui_last[7] = slider55; dui_last[8] = slider59;
    dui_last[9] = slider56; dui_last[10] = slider57;
    last_speed_target = sel_speed_target;
  ) : (
    tgt_capture(sel_speed_target, speed_ramp_by_mem,    slider53, 6);
    tgt_capture(sel_speed_target, speed_ramp_dur_mem,   slider55, 7);
    tgt_capture(sel_speed_target, speed_ramp_delay_mem, slider59, 8);
    tgt_capture(sel_speed_target, sr_play_mem,          slider56, 9);
    tgt_capture(sel_speed_target, sr_rest_mem,          slider57, 10);
  );
);

// Drift target selector save/restore (nested-selector pattern).
// Switching Drift target saves the Drift up/down/period/shape sliders into the OLD target's slot,
// then loads the NEW target's stored config into sliders 75-78.
// Otherwise captures live edits to the current target's slot. All 13
// targets drift in parallel from @sample regardless of selection.
sel_target = slider44;
drift_ui_inited ? (
  last_target_select != sel_target ? (
    dts = tgt_read_slot(sel_target);
    slider45 = target_drift_up[dts];
    slider46 = target_drift_down[dts];
    slider47 = target_drift_per[dts];
    slider49 = target_drift_shape[dts];
    slider50 = drift_play_mem[dts];
    slider51 = drift_rest_mem[dts];
    slider_automate(slider45);
    slider_automate(slider46);
    slider_automate(slider47);
    slider_automate(slider49);
    slider_automate(slider50);
    slider_automate(slider51);
    dui_last[0] = slider45; dui_last[1] = slider46; dui_last[2] = slider47;
    dui_last[3] = slider49; dui_last[4] = slider50; dui_last[5] = slider51;
    last_target_select = sel_target;
  ) : (
    tgt_capture(sel_target, target_drift_up,    slider45, 0);
    tgt_capture(sel_target, target_drift_down,  slider46, 1);
    tgt_capture(sel_target, target_drift_per,   slider47, 2);
    tgt_capture(sel_target, target_drift_shape, slider49, 3);
    tgt_capture(sel_target, drift_play_mem,     slider50, 4);
    tgt_capture(sel_target, drift_rest_mem,     slider51, 5);
  );
);

// Rate Value only shown in Drift mode; Rate Mode always visible.
// In Independent mode each voice's own `Drift / Rate` IS its rate, so a global
// Rate Value would name a speed nothing runs at.
slider_show(slider2, trem_mode == 0);

// Reverse Drift Offset only meaningful in Both modes — in single-layer
// modes it would duplicate the global Rate Value's effect on tremolo
// rate, so hide to avoid the confusion of two sliders doing the same
// thing.
slider_show(slider40, is_both);

// Show/hide pan controls
slider_show(slider32, pan_enabled);
// Shown for every per-cycle mode from Alternating up, matching the filters.
// It is NOT only the walks: the cycle index wraps at Cycle Steps, so an ODD
// value makes Alternating limp -- 0,1,2,0,1,2 gives -1,+1,-1,-1,+1,-1. Hiding
// the control would hide the cause. The every-N modes are excluded because they
// count in their own pattern length (2N) and genuinely ignore this.
slider_show(slider37, pan_enabled && pan_mode >= 4 && pan_mode <= 12);
slider_show(slider38, pan_enabled);
slider_show(slider33, pan_enabled);
slider_show(slider34, pan_enabled && pan_mode == 1);
slider_show(slider36, pan_enabled && pan_mode == 1);
// The pan's rate MODE travels with its rate VALUE -- one complete pair, shown
// and hidden together. Only Increment mode uses them.
slider_show(slider35, pan_enabled && pan_mode == 1);

// Pulse width, Pan spread and the character chain (Tone, Edge, Movement, Body)
// are derived in @block since 2026-09-10, where their Drift and Ramp targets
// can reach them. The arithmetic is unchanged.


@block
// --- Restore-order guard for the change-detecting controls -----------------
//     These trackers answer "did the user just move this control?". Adopted
//     HERE, not in @slider: on a fresh or duplicated instance @slider runs
//     while REAPER is still handing over the saved values, so a tracker
//     adopted there takes a DEFAULT, and the real value arriving a moment
//     later reads as a user edit -- the control then fires and
//     slider_automate()s its result over a value that was set by hand.
//     @block cannot run before the instance is configured, so adopting here is
//     right whatever order the restore paths ran in. (Proved 2026-08-23: a
//     Sweeping Filter in BPM mode with Host ratio "every 2 beats" had Rate
//     Value stamped to 0.5 on every load and every track duplicate.)
!rate_mode_inited ? ( last_rate_mode = slider3; rate_mode_inited = 1; );
// The Voice selector's mirror, same rule and for the same reason -- and here
// the stakes are higher, because an early @slider pass adopting defaults would
// then read the REAL values arriving as twelve user edits, and on `All` would
// write them across all eight voices. While voice_ui_inited is 0, @slider's
// voice block does nothing at all.
!voice_ui_inited ? (
  vui_last[0]  = slider16; vui_last[1]  = slider17; vui_last[2]  = slider18;
  vui_last[3]  = slider19; vui_last[4]  = slider20; vui_last[5]  = slider21;
  vui_last[6]  = slider22; vui_last[7]  = slider23; vui_last[8]  = slider24;
  vui_last[9]  = slider25; vui_last[10] = slider26; vui_last[11] = slider27;
  vui_last[12] = slider28; vui_last[13] = slider29; vui_last[14] = slider30;
  last_voice_sel  = slider15;
  voice_ui_inited = 1;
);
// The Drift and Ramp selectors' mirrors, same rule, same reason.
!drift_ui_inited ? (
  dui_last[0] = slider45; dui_last[1] = slider46; dui_last[2] = slider47;
  dui_last[3] = slider49; dui_last[4] = slider50; dui_last[5] = slider51;
  dui_last[6] = slider53; dui_last[7] = slider55; dui_last[8] = slider59;
  dui_last[9] = slider56; dui_last[10] = slider57;
  last_target_select = slider44;
  last_speed_target  = slider52;
  drift_ui_inited = 1;
);
// Follow the project tempo while a host mode is active. host_scale is ABSOLUTE
// (tempo / 60), never a ratio against a remembered reference -- @init re-runs
// on transport play and wipes globals, so a reference would reset on play and
// silently discard the change. Eight stored per-voice rates, but one shared
// scale factor reaches them all.
host_bpm = max(tempo, 0.001);
// R21: >= 3 covers BOTH host modes -- Every N beats (3) and N per beat (4).
// Both are computed against a NOMINAL 60 BPM and then scaled by the live tempo
// here, which is what keeps them tempo-independent upstream (@init re-runs on
// play and would wipe a remembered tempo).
host_scale = rate_mode >= 3 ? host_bpm / 60 : 1;
// The pan carries its OWN rate pair, so it gets its own tempo factor from its
// own mode. Borrowing the main one is exactly the mistake R21 exists to stop:
// a pan set to `every 2 beats` while the tremolo runs in Hz would otherwise
// follow no tempo at all.
pan_host_scale = pan_rate_mode >= 3 ? host_bpm / 60 : 1;

// --- Globals a Drift or Ramp target reaches ------------------------------------
// Moved here from @slider on 2026-09-10 so each target's offset (drift + ramp,
// as of the last sample) reaches them every block. Each clamp is the slider's
// own range, and with a target idle its offset is exactly 0 -- x + 0 is x -- so
// an instance with nothing configured computes what it always did.
pulse_duty   = max(1, min(99, slider10 + target_drift_offset[4])) / 100.0;
tone_norm    = max(-100, min(100, slider11 + target_drift_offset[5])) / 100.0;
tone_lp_a    = exp(-2 * $pi * 700 / srate);
tone_lp_b    = 1 - tone_lp_a;
tone_hi_gain = pow(2, tone_norm);
tone_lo_gain = pow(2, -tone_norm);
edge_norm    = max(0, min(100, slider12 + target_drift_offset[6])) / 100.0;
edge_drive   = 1 + edge_norm * 0.7;
edge_wet     = edge_norm * 0.5;
movement_norm   = max(0, min(100, slider13 + target_drift_offset[7])) / 100.0;
chorus_lfo_inc  = 0.5 / srate;
chorus_base_ms  = 0.015;
chorus_depth_ms = 0.005;
chorus_wet      = movement_norm * 0.5;
chorus_active   = movement_norm > 0.001;
body_norm    = max(0, min(100, slider14 + target_drift_offset[8])) / 100.0;
body_active  = body_norm > 0.001;
body_makeup  = pow(10, -body_norm * 3 / 20);
body_active ? (
  body_freq  = semitones_to_hz(base_note, center_octave, 0);
  body_gain  = body_norm * 6;
  body_A     = pow(10, body_gain / 40);
  body_omega = 2 * $pi * body_freq / srate;
  body_cos   = cos(body_omega);
  body_alpha = sin(body_omega) / 2;
  body_a0    = 1 + body_alpha / body_A;
  body_b0    = (1 + body_alpha * body_A) / body_a0;
  body_b1    = -2 * body_cos / body_a0;
  body_b2    = (1 - body_alpha * body_A) / body_a0;
  body_a1    = -2 * body_cos / body_a0;
  body_a2    = (1 - body_alpha / body_A) / body_a0;
);
pan_spread   = max(0, min(100, slider33 + target_drift_offset[81])) / 100.0;

// ===========================================================================
// EVERYTHING PER-VOICE IS DERIVED HERE, AND THIS IS NOT A STYLE CHOICE.
//
// The twelve per-voice values live in @serialize banks. @slider and @serialize
// restore by two independent paths with no guaranteed relative order, so a
// derivation in @slider can run against @init defaults and then never run
// again once @serialize fills the banks in underneath -- the banks are perfect
// and everything computed FROM them is stale. Its signature is unusually
// clean: touching any control fixes it completely and transport play does not.
// @block runs every block forever, so by the first sample of audio these are
// right no matter what ran when.
// ===========================================================================

i = 0;
loop(8,
  v_dr[i]        = vm_dr[i];
  v_phase_off[i] = vm_phoff[i];
  v_active[i]    = vm_active[i];
  v_wave[i]      = vm_wave[i];
  v_solo[i]      = vm_solo[i];
  // dB -> linear. Read from the bank and written to a DIFFERENT array, so
  // running every block cannot compound the way an in-place conversion would.
  v_gain[i]      = pow(10, vm_gain[i] / 20.0);

  // Per-voice tremolo envelope. Precomputed here so the per-sample path costs
  // nothing in the common case where the envelope drift targets are all idle;
  // @sample only recomputes a voice when one of them is actually moving.
  v_on_pre[i]  = max(0.001, min(1, vm_ondur[i] * 0.01));
  v_att_pre[i] = max(0, min(1, vm_att[i] * 0.01));
  v_rel_pre[i] = max(0, min(1, vm_rel[i] * 0.01));
  aw_eff = v_att_pre[i];
  rw_eff = v_rel_pre[i];
  aw_eff + rw_eff > v_on_pre[i] ? (
    rt_total = aw_eff + rw_eff;
    aw_eff = aw_eff / rt_total * v_on_pre[i];
    rw_eff = rw_eff / rt_total * v_on_pre[i];
  );
  v_re_pre[i] = v_on_pre[i] - rw_eff;
  // Depth: `amount` is the always-on floor, `sc` the LFO-driven swing.
  amount      = pow(2, vm_depth[i] / 6);
  v_sc_pre[i] = 0.5 * amount;
  v_amt_pre[i] = 1 - amount;

  i += 1;
);

// Solo. Computed from a bank, so it belongs here too. When ANY voice is
// soloed, only soloed voices sound; when none is, the flag is off and nothing
// changes. Both layers of a Both mode follow the forward voice via (i & 7),
// which is how every other per-voice drift target already reaches them.
any_solo = 0;
i = 0; loop(8, vm_solo[i] ? any_solo = 1; i += 1;);

// Pulse Width is a GLOBAL control over a now-PER-VOICE waveform, so it must be
// visible whenever the visible Waveform is Pulse OR any voice is using Pulse --
// otherwise a live control could sit hidden. Derived from a bank, hence here;
// only called when the answer CHANGES, so it is not a per-block UI rebuild.
pulse_vis = slider23 == 13;
i = 0; loop(8, vm_wave[i] == 13 ? pulse_vis = 1; i += 1;);
pulse_vis != last_pulse_vis ? (
  slider_show(slider10, pulse_vis);
  last_pulse_vis = pulse_vis;
);

// Reverse — permute (single layer, option 1): mirror the per-voice
// drift/rate values V1↔V8, V2↔V7, V3↔V6, V4↔V5. Notes, gains, phase
// offsets, and active flags stay in place — only the cadences swap.
// The audio sum is commutative across voice slots, so swapping a
// voice's COMPLETE identity is a no-op; mirroring just drift means
// V1's note now fires at V8's cadence and vice versa, which is the
// audible effect modders expect from this slider.
slot0_7_permute ? (
  i = 0;
  loop(4,
    j = 7 - i;
    tmp = v_dr[i]; v_dr[i] = v_dr[j]; v_dr[j] = tmp;
    i += 1;
  );
);

// Both modes (options 3, 4): copy slots 0-7 to slots 8-15. Slots 0-7
// keep the forward-layer settings; slots 8-15 hold the reverse-layer
// settings. v_phase_off_last is intentionally NOT copied — leaving it
// at slot 8-15's prior value (0 from @init, or stale) means the
// @sample live-offset-change detector fires when entering Both mode,
// cleanly initializing trem_phase[8..15] from the offset.
is_both ? (
  i = 0;
  loop(8,
    v_gain[i + 8]      = v_gain[i];
    v_dr[i + 8]        = v_dr[i];
    v_phase_off[i + 8] = v_phase_off[i];
    v_active[i + 8]    = v_active[i];
    i += 1;
  );
  // Both — permute: mirror the drift values inside the reverse layer
  // (slots 8↔15, 9↔14, 10↔13, 11↔12), keeping notes/gains/offsets in
  // place. Result: slot 8 plays V1's note at V8's cadence, slot 15
  // plays V8's note at V1's cadence. Each note now fires at TWO
  // different cadences across the two layers — harmonic pairs at the
  // fast cadences, separate notes at the slow ones. Both — time skips
  // the swap (slots 8-15 keep V1..V8's drift unchanged) so the two
  // layers run at matched cadences in opposite time directions, which
  // cancels asymmetric envelope pulses into a continuous drone.
  slot8_15_permute ? (
    i = 0;
    loop(4,
      k = 8 + i;
      j = 15 - i;
      tmp = v_dr[k]; v_dr[k] = v_dr[j]; v_dr[j] = tmp;
      i += 1;
    );
  );

  // Shift every drift value in the reverse layer by the offset. Applied
  // AFTER the optional mirror so the post-mirror values are what get
  // shifted (mirror and offset commute mathematically since mirror is
  // just reordering and offset is a uniform add, but keeping the order
  // "mirror then offset" matches how the manual describes it).
  rdo_eff = reverse_drift_offset + target_drift_offset[85];
  rdo_eff != 0 ? (
    i = 0;
    loop(8,
      v_dr[i + 8] += rdo_eff;
      i += 1;
    );
  );
);


// Per-voice frequencies and tremolo rates, computed AFTER the permutes above
// so they see the mirrored / offset drift values rather than the raw ones.
i = 0;
loop(n_voices,
  // Each voice's own pitch block, plus its Pitch and Fine tune targets and the
  // plugin's Transpose and Tuning reference targets. The reverse layer is the
  // same eight voices, hence (i & 7).
  vi = i & 7;
  hz = voice_pitch_hz(vm_pval[vi], vm_pmode[vi], vm_fine[vi], vm_funit[vi],
                      target_drift_offset[10 + vi], target_drift_offset[19 + vi],
                      target_drift_offset[2], target_drift_offset[1]);
  v_freq_l[i] = hz;
  v_freq_r[i] = hz + bin_beat_hz;

  trem_mode == 0 ? (
    // Drift mode: global rate + per-voice drift offset
    v_trem_freq[i] = rate_to_hz(rate_val + v_dr[i], rate_mode);
  ) : (
    // Independent mode: per-voice rate in whatever unit Rate Mode specifies
    v_trem_freq[i] = rate_to_hz(v_dr[i], rate_mode);
  );
  i += 1;
);

// Static pan positions for Spread / Spread Reversed modes.
// Rank audible voices and place evenly across the stereo field. In Both
// modes the reverse layer's voices participate in the ranking too, so
// 16 voices spread evenly across the field rather than 8 + 8 stacked.
//
// The divisor counts what will actually SOUND, which now means soloing is
// level-neutral: solo one voice out of eight and it keeps its loudness instead
// of dropping 18 dB. That is the same reasoning as Active, and deliberately
// NOT the same as Play/Rest -- a rest is a runtime event and must not move the
// divisor, which is the "sounds louder after rest" bug fixed 2026-05-25.
total_active = 0;
i = 0;
loop(n_voices,
  (any_solo ? v_solo[i & 7] : v_active[i]) ? total_active += 1;
  i += 1;
);
// How many positions the Distributed / Converging / Diverging walks step
// through. This is a TEMPORAL pattern length and has nothing to do with how
// many voices exist -- deriving it from the active voice count was wrong, and
// collapsed all seven walk modes into Alternating whenever few voices were up.
// Spread uses the voice count because Spread ranks VOICES across the field;
// that is a different question with a coincidentally similar answer.
pan_cycle_steps = max(2, slider37);
// Pan glide. A coefficient of 0 makes the smoother pass its input straight
// through, which IS the instant case.
pan_glide_sec    = max(0, slider38 + target_drift_offset[84]) / 1000;
pan_smooth_coeff = pan_glide_sec <= 0 ? 0 : exp(-1 / (srate * pan_glide_sec));
// The every-N alternations count in their own pattern length (2N), not in
// voices -- otherwise a four-voice project could never reach the second half
// of an "every 4" and would sit on one side forever.
pan_cycle_mod = pan_mode == 13 ? 4 : pan_mode == 14 ? 8 : pan_mode == 15 ? 16 : pan_cycle_steps;

(pan_mode == 2 || pan_mode == 3) ? (
  rank = 0;
  i = 0;
  loop(n_voices,
    (any_solo ? v_solo[i & 7] : v_active[i]) ? (
      total_active > 1 ? (
        pos = -1.0 + 2.0 * rank / (total_active - 1);
      ) : (
        pos = 0;
      );
      pan_mode == 3 ? pos = -pos;  // Spread Reversed: flip
      v_pan_static[i] = pos;
      rank += 1;
    ) : (
      v_pan_static[i] = 0;
    );
    i += 1;
  );
);

// Pan frequencies. Increment mode uses Pan Base Rate as the foundation, read
// through the PAN's own rate mode -- the pan pair is complete and independent,
// so `every 2 beats` on the pan means the same thing whatever the tremolo is
// doing. Tremolo mode pans at each voice's own tremolo rate and so follows the
// main pair, which is what that mode means.
i = 0;
loop(n_voices,
  pan_mode == 0 ? (
    v_pan_freq[i] = v_trem_freq[i];
  ) : (
    // In Both modes voice index runs 0..15, so the reverse layer's voices keep
    // extending the pan-rate ramp past slot 7 rather than restarting.
    pan_rate_i = pan_base_rate + pan_increment * i;
    v_pan_freq[i] = rate_to_hz(pan_rate_i, pan_rate_mode);
  );
  i += 1;
);

@sample

// (No transport-edge reset here — Path A. REAPER re-runs @init on every
// transport play, which resets all runtime state — voice slots, drift
// runtime, Start Delay, Speed Ramp, character chain + chorus buffer; the
// CONFIG banks are preserved across those re-runs by the drift_cfg_inited
// guard in @init. See docs/v2.9-render-state-bug.md.)

// Advance each target's own ramp clock (v2.14 per-target timeline). Engage
// (Speed ramp engage, GLOBAL) is the freeze/resume gate: while On, each target whose
// duration > 0 advances its own ramp_t 0->1 over its own duration, after its
// own start delay; while Off, all clocks freeze and resume. Only transport
// play (via @init) resets them.
// The rate in cycles per second, BEFORE drift and ramp touch it. Both the
// Cycles ramp unit and the Cycles drift period reference it, so neither can
// modulate its own clock. Computed once here rather than in three places.
rate_val_hz = rate_to_hz(rate_val, rate_mode);
slider58 ? (
  // Ramp time unit (slider54). One factor turns the block's time values into
  // seconds, so Duration and Start delay always mean the same thing as each
  // other. Cycles counts THIS plugin's own tremolo cycles, at the live tempo
  // (host_scale) so a host-synced ramp counts real cycles rather than nominal
  // ones. Seconds is wall clock. Minutes is 60 s and is the DEFAULT, because
  // every saved instance has this control unset and moving the default would
  // rewrite their live ramps. A beat is 60/tempo s, recomputed per sample so
  // Beats follows a live tempo change rather than remembering one.
  ramp_time_scale =
    slider54 == 3 ? 60 / max(host_bpm, 0.001) :
    slider54 == 2 ? 60 :
    slider54 == 1 ? 1 :
                    1 / max(rate_val_hz * host_scale, 0.00001);
  i = 0;
  loop(N_TARGETS,
    speed_ramp_dur_mem[i] > 0 ? (
      sr_delay_samples = speed_ramp_delay_mem[i] * ramp_time_scale * srate;
      speed_ramp_delay_elapsed_mem[i] < sr_delay_samples ? (
        speed_ramp_delay_elapsed_mem[i] += 1;
      ) : (
        // Staircase (sliders 53/54). The ramp advances for `play`, holds for
        // `rest`, and repeats. The holds come OUT of the duration rather than
        // extending it -- the advancing step is scaled by (play+rest)/play --
        // so Ramp duration goes on meaning "you arrive in about this long".
        sr_pl = sr_play_mem[i];
        sr_rs = sr_rest_mem[i];
        sr_pr_on = sr_pl > 0 && sr_rs > 0;
        sr_hold = pr_frozen(sr_pr_accum_mem, sr_pr_resting_mem, i,
                            1.0 / (ramp_time_scale * srate), sr_pl, sr_rs);
        // One-armed on purpose -- an empty else-branch is a silent compile
        // failure in eel2 (CLAUDE.md).
        !sr_hold ? (
          sr_step = 1.0 / (srate * speed_ramp_dur_mem[i] * ramp_time_scale);
          sr_pr_on ? sr_step *= (sr_pl + sr_rs) / sr_pl;
          speed_ramp_ramp_t_mem[i] += sr_step;
          speed_ramp_ramp_t_mem[i] > 1.0 ? speed_ramp_ramp_t_mem[i] = 1.0;
        );
      );
    );
    i += 1;
  );
);

// Base Rate Speed Ramp (target 0): the `by` is the Base Rate slot of
// the per-target bank (speed_ramp_by_mem[0]) — the `by` slider mirrors it for
// the currently-selected target via @slider. Expressed as a
// multiplicative ratio so all voices stay in proportional lockstep.
// The other 23 targets ride as additive offsets, folded into
// target_drift_offset[] just after the drift loop below.
// WHERE the BPM amount is added changed on 2026-09-04, and it had to.
// Until then, Host x's Rate Value WAS the nominal rate in cycles/sec, so
// adding a converted amount to the raw slider value and adding it to the
// Hz were the same operation. R13-revised inverted the unit -- Rate Value
// became BEATS PER CYCLE -- and that identity broke, but nothing moved the
// addition. Simulated at 120 BPM, a cycle every 2 beats: a Ramp of +10 BPM
// came out as 57.6 cycles/min instead of 70. Wrong size and, worse, the
// WRONG DIRECTION -- ramping up slowed it down, because more beats per
// cycle is slower. So in Host x the amount is now added AFTER the
// inversion. host_bpm_delta's factor was always right; only its
// destination was wrong.
sr_bpm_amt         = speed_ramp_ramp_t_mem[0] * speed_ramp_by_mem[0];
base_rate_hz_ref   = rate_to_hz(rate_val, rate_mode);
rate_mode >= 3 ? (
  effective_rate_hz = max(base_rate_hz_ref + host_bpm_delta(sr_bpm_amt), 0.0001);
) : (
  effective_rate_hz = rate_to_hz(rate_val + sr_bpm_amt, rate_mode);
);
speed_scale_current = effective_rate_hz / max(base_rate_hz_ref, 0.001);
// host_scale folds the live project tempo in alongside Speed Ramp (1 outside
// Host x). All eight voices' tremolo phases, the Play/Rest counters and the
// drift period ride combined_scale, so they follow for free. The oscillator
// phase accumulators deliberately do NOT -- those are PITCH.
combined_scale = speed_scale_current * host_scale;

// ===== DRIFT (per-plugin, nested-selector) =====
// Per-target drift wave computation. 13 targets (0=Base Rate, 1-8=
// V1-V8 Rate, 9=Pan Base Rate, 10=Pan Increment, 11=Binaural Beat,
// 12=Trem On Duration). Each gets a phase counter advancing per sample
// at (rate_val_hz * combined_scale) / (per * srate) — one drift cycle
// spans `per` V1 cycles, scaled by Speed Ramp so drift slows with the
// rest of the rhythm. Period unit is V1 cycles for all targets.
//
// Each target's offset is computed in its natural unit and stored back
// into target_drift_offset[t]; the consumers below (and in the voice
// loop) read those offsets and apply each to its audio path.
// rate_val_hz was computed at the top of @sample, off the PRE-drift rate, so
// drifting the rate cannot modulate its own drift period.
drift_phase_inc_base = (rate_val_hz * combined_scale) / srate;

i = 0;
loop(N_TARGETS,
  up    = target_drift_up[i];
  down  = target_drift_down[i];
  per   = target_drift_per[i];
  shape = target_drift_shape[i];

  drift_offset_local = 0;
  // A period of 0 turns this target's drift OFF. That is the quick disable --
  // Rozaya reaches for it, and until 2026-09-08 the slider's minimum was 1 so
  // 0 was unreachable, and in three plugins it was clamped UP to 1, which is the
  // FASTEST drift the control can make. Exactly backwards from what it reads as.
  (up > 0 || down > 0) && per > 0 ? (
    // Drift period unit (slider48). Cycles is this plugin's native count -- a
    // period of 8 means eight tremolo cycles, and because the advance already
    // carries combined_scale (Speed Ramp x live tempo) it follows the rate and
    // the project tempo for free. Seconds is wall clock, so neither factor
    // applies. Beats converts at the LIVE tempo, recomputed per sample so a
    // tempo change is followed rather than remembered.
    drift_per_tick =
      slider48 == 2 ? 1.0 / max(per * 60 / max(host_bpm, 0.001) * srate, 1) :
      slider48 == 1 ? 1.0 / max(per * srate, 1) :
                      drift_phase_inc_base / per;

    // Drift play/rest (sliders 47/48), per target, counted in PERIODS. While
    // resting the phase does not advance at all, so shape_val below is
    // recomputed from the HELD phase and the offset simply stays where it
    // stopped -- freeze in place, not a return to centre.
    d_frozen = pr_frozen(drift_pr_accum_mem, drift_pr_resting_mem, i,
                         drift_per_tick, drift_play_mem[i], drift_rest_mem[i]);
    // One-armed on purpose: an empty else-branch is a silent compile failure
    // in eel2, and this is the shape CLAUDE.md prescribes for it.
    d_frozen ? (
      new_phase = target_drift_phase[i];
    );
    !d_frozen ? (
      new_phase = target_drift_phase[i] + drift_per_tick;
      new_phase >= 1.0 ? (
        new_phase -= 1.0;
        shape == 2 ? (
          target_drift_prev[i] = target_drift_curr[i];
          target_drift_curr[i] = rand(2) - 1;
        );
      );
    );
    target_drift_phase[i] = new_phase;

    shape == 0 ? (
      shape_val = sin(2 * $pi * new_phase);
    ) : shape == 1 ? (
      shape_val = new_phase < 0.25 ? (4 * new_phase) :
                  new_phase < 0.75 ? (2 - 4 * new_phase) :
                                     (4 * new_phase - 4);
    ) : (
      shape_val = target_drift_prev[i] +
        (target_drift_curr[i] - target_drift_prev[i]) * new_phase;
    );
    drift_offset_local = shape_val > 0 ? shape_val * up : shape_val * down;
  );
  target_drift_offset[i] = drift_offset_local;
  i += 1;
);

// Fold the Speed Ramp per-target offset INTO target_drift_offset[] for
// the 23 additive targets (1..23). ramp_t[t] * by[t] rides each one
// from its baseline toward baseline+by over the duration. After this,
// every consumption site that reads target_drift_offset[t] sees drift
// wander + speed-ramp ride combined — no per-site changes needed.
// Target 0 (Base Rate) is NOT folded: its Speed Ramp is the ratio
// (combined_scale, above) and its drift is the uniform Hz delta below.
i = 1;
loop(N_TARGETS - 1,
  target_drift_offset[i] += speed_ramp_ramp_t_mem[i] * speed_ramp_by_mem[i];
  i += 1;
);

// Base Rate drift (target 0): uniform Hz delta added to every voice's
// tremolo freq below — preserves inter-voice rate relationships (the
// whole pattern breathes together). Same natural→Hz conversion the old
// drift used, with the same clamp so an over-aggressive Down-by can't
// silence or break the plugin.
drift_hz_delta = 0;
target_drift_offset[0] != 0 ? (
  // Host x adds in the Hz domain -- see the note on the Ramp above. Adding
  // to the raw value there would drift the BEATS PER CYCLE, which runs
  // backwards (up = slower) and by the wrong amount.
  rate_mode >= 3 ? (
    drift_hz_delta = max(rate_val_hz + host_bpm_delta(target_drift_offset[0]), 0.0001)
                     - rate_val_hz;
  ) : (
    effective_rate_natural = rate_val + target_drift_offset[0];
    rate_mode == 0 ? effective_rate_natural = max(effective_rate_natural, 10) :
    rate_mode == 1 ? effective_rate_natural = max(effective_rate_natural, 0.1) :
                     effective_rate_natural = max(effective_rate_natural, 0.1);
    drift_hz_delta = rate_to_hz(effective_rate_natural, rate_mode) - rate_val_hz;
  );
);

// Binaural Beat drift (target 3): Hz delta on the L/R offset, added to
// every voice's R-channel oscillator advance below.
binaural_drift_hz = target_drift_offset[3];

// --- The envelope targets are PER VOICE since 2026-09-10 ---------------------
// Tremolo amount, On duration, Attack and Release each have a target per voice
// plus an all-voices entry that copies one setup into eight. The offsets are
// read inside the voice loop, per voice, and the guard stays: a voice whose four
// targets are idle reads its @block values straight out.

// Live phase offset update — fires when an offset slider is moved during
// playback. Runs over n_voices so the reverse layer's slots 8-15 also
// respond when v_phase_off there changes (entry into Both mode, toggle
// between Both — permute and Both — time, etc.).
i = 0;
loop(n_voices,
  v_phase_off[i] != v_phase_off_last[i] ? (
    // Offset means "when does this voice become audible" — so we set the phase
    // such that the on-window leading edge lands at offset seconds/beats/cycles.
    // Subtracting from 1 means: the phase clock is that far *before* phase zero,
    // so it arrives at the on-window start exactly at the requested offset time.
    frac = v_phase_off[i] * v_trem_freq[i];
    frac = frac - floor(frac);
    trem_phase[i] = frac > 0 ? 1.0 - frac : 0;
    v_phase_off_last[i] = v_phase_off[i];
  );
  i += 1;
);

// Whether Play/Rest gating is engaged this sample. Used by the voice
// loop's gate logic and by the "cancel Depth floor on the last
// release" branch. No transport gymnastics — @init runs on every
// play and re-zeros all per-voice state, so stop/play gives a clean
// restart automatically (conventional Reaper behavior).
pr_enabled = (play_for_cycles > 0 && rest_for_cycles > 0);
// Play for and Rest for are targets (R24). The gate still switches on only when
// both SLIDERS are above zero; a target moves the counts, never the switch.
pr_play_eff = max(0.001, play_for_cycles + target_drift_offset[86]);
pr_rest_eff = max(0.001, rest_for_cycles + target_drift_offset[87]);

// Start Delay — gate the voice processing. In the delay window the
// output is zeroed and the elapsed counter advances; the voice loop is
// skipped entirely so phases stay at their play-start reset positions.
// When the delay ends, voices begin cleanly from phase 0 (or their
// phase offsets) rather than from a mid-cycle position.
start_delay_elapsed < start_delay_sec ? (
  // * host_scale: start_delay_sec derives from the NOMINAL rate, so a
  // wall-clock counter here would be wrong by exactly the tempo ratio while
  // everything else was right -- the partial-failure shape Melody Phase hit.
  start_delay_elapsed += host_scale / srate;
  spl0 = 0;
  spl1 = 0;
) : (

// Per-voice Play/Rest gating runs inside the voice loop below
// (search for "v_pr_cycle"). Each voice keeps its own cycle counter
// advancing at its own v_trem_freq, flips v_resting[i] independently
// when its threshold is hit, and freezes in place at whatever phase
// it was at — so drift relationships persist across rest. The rest
// counter advances off the same per-voice rate, so V8 (fast) wakes
// before V1 (slow), preserving the per-voice symmetry. pr_enabled
// was computed earlier (above the play_state transition check) so
// the reset-on-play behavior can also see whether PR is engaged; the
// voice loop references it directly.

out_l = 0;
out_r = 0;

i = 0;
loop(n_voices,
  // Solo, and the reason it reads through (i & 7): a Both mode runs the same
  // eight voices twice, so slot 8+k is voice k's reverse-layer copy and must
  // follow voice k's solo flag. Every per-voice drift target already reaches
  // the reverse layer the same way.
  (any_solo ? v_solo[i & 7] : v_active[i]) ? (
    // Effective per-voice tremolo Hz this sample. Two drift layers:
    //   - Per-voice Rate drift (targets 28-35): wanders THIS voice's own
    //     rate. Recomputed from the voice's natural base rate + its
    //     per-voice offset, so voices drift against each other (the
    //     heart of polyrhythmic feel). In Both modes slot 8+k follows
    //     V(k+1)'s target via (i & 7).
    //   - Base Rate drift (target 0): drift_hz_delta, the uniform Hz
    //     delta added to EVERY voice — shifts the whole pattern together
    //     while preserving inter-voice relationships.
    // Final clamp to a tiny minimum so an over-aggressive Drift Down
    // can't drive the freq ≤0 (which would freeze/reverse trem_phase).
    pv_off = target_drift_offset[28 + (i & 7)];
    pv_off != 0 ? (
      trem_mode == 0 ? pv_base_nat = rate_val + v_dr[i] : pv_base_nat = v_dr[i];
      pv_freq = rate_to_hz(pv_base_nat + pv_off, rate_mode);
    ) : (
      pv_freq = v_trem_freq[i];
    );
    effective_trem_freq = max(pv_freq + drift_hz_delta, 0.001);

    // Per-voice Play/Rest cycle counting. Each voice has its own
    // counter that advances at the voice's own tremolo rate, so V8
    // (fast drift) reaches play_for_cycles in less wall-clock time
    // than V1 (slow drift) and enters rest first. The same per-voice
    // rate drives the rest counter, so V8 also wakes first —
    // preserving the per-voice cadence symmetry through both halves
    // of the loop. Counter advances regardless of v_resting state;
    // the threshold comparison just picks which target to check.
    pr_enabled ? (
      v_pr_cycle[i] += effective_trem_freq * combined_scale / srate;
      !v_resting[i] ? (
        v_pr_cycle[i] >= pr_play_eff ? (
          v_resting[i]  = 1;
          v_pr_cycle[i] = 0;
        );
      ) : (
        v_pr_cycle[i] >= pr_rest_eff ? (
          v_resting[i]  = 0;
          v_pr_cycle[i] = 0;
        );
      );
    );

    // Tremolo phase advances forward by default; in any reverse-time
    // mode it decrements so the envelope shape is traced backwards.
    // Direction is per-slot: slots 0-7 advance backward only in
    // single-layer Reverse — time (option 2). Slots 8-15 advance
    // backward only in Both — time (option 4). Both — permute (option 3)
    // is forward in both layers; the "reverse" there is slot-mirroring,
    // not time. Phase wrap handled in both directions.
    //
    // Phase only advances while !v_resting; once this voice's PR
    // counter flips v_resting[i] to 1 (above), trem_phase stays put
    // until the rest counter expires and v_resting clears. Each voice
    // freezes at WHATEVER phase it was at the rest trigger — not at a
    // cycle boundary — so drift relationships persist across rest.
    !v_resting[i] ? (
      voice_reverse_time = (i < 8) ? slot0_7_reverse_time : slot8_15_reverse_time;
      voice_reverse_time ? (
        trem_phase[i] -= effective_trem_freq * combined_scale / srate;
        trem_phase[i] < 0 ? ( trem_phase[i] += 1; advance_pan_cycle(i); );
      ) : (
        trem_phase[i] += effective_trem_freq * combined_scale / srate;
        trem_phase[i] >= 1 ? ( trem_phase[i] -= 1; advance_pan_cycle(i); );
      );
    );

    // Target gain. Three regimes:
    //
    // 1) Resting: target_gain = 0. By the time v_resting flips, the
    //    depth-cancel branch below has already decayed gain to 0 via
    //    the natural release, so there's almost nothing for the gain
    //    smoother to do here.
    //
    // 2) Playing, NOT in the final cycle's release / silent portion:
    //    target_gain = lfo_val * sc + amount  (normal Polyrhythm Phase).
    //
    // 3) Playing, at or past re_start within the FINAL cycle of the
    //    play period: target_gain = lfo_val * (sc + amount). This drops
    //    the always-on Depth floor (`amount`) and lets the release tail
    //    decay all the way to 0 — so the voice actually reaches silence
    //    before the rest freeze, regardless of Tremolo amount setting.
    //
    //    Peak of release (lfo_val = 1, at re_start): gain = sc + amount,
    //    same as the normal peak. So no discontinuity entering release.
    //    End of release (lfo_val = 0): gain = 0. The override extends
    //    through the silent zone (re_start..1, not re_start..on_frac)
    //    so when On Duration < 100% the silent tail of the final cycle
    //    also stays at 0 — otherwise gain would snap back to `amount`
    //    in the silent zone and need the smoother to bring it down.
    //
    //    Only the final cycle is touched; cycles 1 through (play_for - 1)
    //    play with the normal formula. Release = 0% has zero release
    //    width, so the override never fires and you get a sharp cutoff
    //    at the rest boundary — use a non-zero Release for clean rest
    //    entry.
    //
    // Wake side: when v_resting flips back to 0, target_gain jumps from
    // 0 to whatever the LFO says at the resumed phase. The same 3 ms
    // gain_l/r smoother that already prevents Attack=0% from clicking
    // at normal cycle wraps handles this transition — gain_l ramps from
    // 0 to the new target over ~3 ms, perceptually a clean attack rather
    // than a click. No separate wake-fade machinery needed.
    v_resting[i] ? (
      target_gain = 0;
    ) : (
      // THIS VOICE's envelope. The four values come straight out of @block in
      // the common case; the two guards only fire when the matching drift
      // target is actually moving, which keeps the per-sample cost of going
      // per-voice at roughly zero for a plugin that is not drifting them.
      // (i & 7) because the reverse layer shares the forward voice's envelope.
      vi = i & 7;
      envdrift_ondur = target_drift_offset[46 + vi] * 0.01;
      envdrift_att   = target_drift_offset[55 + vi] * 0.01;
      envdrift_rel   = target_drift_offset[64 + vi] * 0.01;
      envdrift_depth = target_drift_offset[37 + vi];
      envdrift_shape_on = envdrift_ondur != 0 || envdrift_att != 0 || envdrift_rel != 0;
      envdrift_depth_on = envdrift_depth != 0;
      envdrift_shape_on ? (
        ev_on  = max(0.001, min(1, v_on_pre[vi]  + envdrift_ondur));
        ev_att = max(0,     min(1, v_att_pre[vi] + envdrift_att));
        ev_rel = max(0,     min(1, v_rel_pre[vi] + envdrift_rel));
        // Mirror @block's aw/rw normalization on the drifted values, so the
        // depth-cancel branch's release-start check below stays correct.
        ev_aw = ev_att; ev_rw = ev_rel;
        ev_aw + ev_rw > ev_on ? (
          ev_rt = ev_aw + ev_rw;
          ev_aw = ev_aw / ev_rt * ev_on;
          ev_rw = ev_rw / ev_rt * ev_on;
        );
        ev_re = ev_on - ev_rw;
      ) : (
        ev_on  = v_on_pre[vi];
        ev_att = v_att_pre[vi];
        ev_rel = v_rel_pre[vi];
        ev_re  = v_re_pre[vi];
      );
      envdrift_depth_on ? (
        ev_amt = pow(2, (vm_depth[vi] + envdrift_depth) / 6);
        ev_sc  = 0.5 * ev_amt;
        ev_amt = 1 - ev_amt;
      ) : (
        ev_sc  = v_sc_pre[vi];
        ev_amt = v_amt_pre[vi];
      );
      // calc_lfo does its own att/rel-vs-on normalization internally, so
      // passing the fractions is enough for the envelope shape.
      lfo_val = calc_lfo(trem_phase[i], ev_on, ev_att, ev_rel, att_shape, rel_shape);
      in_last_cycle  = pr_enabled && (v_pr_cycle[i] >= pr_play_eff - 1);
      (in_last_cycle && trem_phase[i] >= ev_re) ? (
        target_gain = lfo_val * (ev_sc + ev_amt);
      ) : (
        target_gain = lfo_val * ev_sc + ev_amt;
      );
    );
    gain_l[i] = gain_l[i] * smooth + target_gain * (1 - smooth);
    gain_r[i] = gain_r[i] * smooth + target_gain * (1 - smooth);

    // CPU-saver skip: when fully decayed in rest, bypass osc +
    // waveform + pan computation (voice would contribute ~0 anyway).
    // The gain smoother keeps running above this, so the catch-up
    // ramp is ready the moment v_resting flips back to 0. The
    // divisor (total_active, set in @slider) is NOT decremented when
    // we skip — that level-jump-on-rest was the "sounds louder after
    // rest" bug fixed 2026-05-25.
    v_resting[i] && gain_l[i] < 0.001 ? 0 : (
    osc_phase_l[i] += v_freq_l[i] / srate;
    osc_phase_l[i] >= 1 ? osc_phase_l[i] -= 1;
    // Binaural Beat drift (target 3): wanders the L/R offset by adding
    // binaural_drift_hz to the R-channel advance only (v_freq_r already
    // carries the static bin_beat_hz; this drifts it). The slot-13 Pulse
    // polyblep dt below still uses the static v_freq_r — the sub-Hz
    // binaural drift makes a negligible difference to that correction.
    osc_phase_r[i] += (v_freq_r[i] + binaural_drift_hz) / srate;
    osc_phase_r[i] >= 1 ? osc_phase_r[i] -= 1;

    // THIS VOICE's waveform. The chain below was already inside the per-voice
    // loop and already indexed this voice's own phase and gain -- only the
    // waveform NUMBER was global, which is what made going per-voice cheap.
    // (i & 7) because a Both mode's reverse layer is the same eight voices.
    wf = v_wave[i & 7];

    wf == 0 ? (
      osc_l = sin(osc_phase_l[i] * 2 * $pi) * gain_l[i] * v_gain[i];
      osc_r = sin(osc_phase_r[i] * 2 * $pi) * gain_r[i] * v_gain[i];
    ) : wf == 1 ? (
      ph_l = osc_phase_l[i];
      ph_r = osc_phase_r[i];
      osc_l = (ph_l < 0.25 ? ph_l * 4 :
               ph_l < 0.75 ? 2 - ph_l * 4 :
                             ph_l * 4 - 4) * gain_l[i] * v_gain[i];
      osc_r = (ph_r < 0.25 ? ph_r * 4 :
               ph_r < 0.75 ? 2 - ph_r * 4 :
                             ph_r * 4 - 4) * gain_r[i] * v_gain[i];
    ) : wf == 2 ? (
      ph_l = osc_phase_l[i] + 0.5;
      ph_l = ph_l - floor(ph_l);
      ph_r = osc_phase_r[i] + 0.5;
      ph_r = ph_r - floor(ph_r);
      osc_l = (ph_l * 2 - 1) * gain_l[i] * v_gain[i];
      osc_r = (ph_r * 2 - 1) * gain_r[i] * v_gain[i];
    ) : wf == 3 ? (
      ph_l = osc_phase_l[i];
      ph_r = osc_phase_r[i];
      ph_l = ph_l < (1/PHI) ? ph_l * PHI * 0.5 : 0.5 + (ph_l - 1/PHI) / (1 - 1/PHI) * 0.5;
      ph_r = ph_r < (1/PHI) ? ph_r * PHI * 0.5 : 0.5 + (ph_r - 1/PHI) / (1 - 1/PHI) * 0.5;
      osc_l = sin(ph_l * 2 * $pi) * gain_l[i] * v_gain[i];
      osc_r = sin(ph_r * 2 * $pi) * gain_r[i] * v_gain[i];
    ) : wf == 4 ? (
      ph_l = osc_phase_l[i];
      ph_r = osc_phase_r[i];
      ph_l = (sin((ph_l - 0.25) * 2 * $pi) + 1) * 0.5;
      ph_r = (sin((ph_r - 0.25) * 2 * $pi) + 1) * 0.5;
      ph_l = ph_l < (1/PHI) ? ph_l * PHI * 0.5 : 0.5 + (ph_l - 1/PHI) / (1 - 1/PHI) * 0.5;
      ph_r = ph_r < (1/PHI) ? ph_r * PHI * 0.5 : 0.5 + (ph_r - 1/PHI) / (1 - 1/PHI) * 0.5;
      osc_l = sin(ph_l * 2 * $pi) * gain_l[i] * v_gain[i];
      osc_r = sin(ph_r * 2 * $pi) * gain_r[i] * v_gain[i];
    ) : wf == 5 ? (
      ph_l = osc_phase_l[i];
      ph_r = osc_phase_r[i];
      ph_l = ph_l + (1/PHI) * sin(ph_l * 2 * $pi) / (2 * $pi);
      ph_r = ph_r + (1/PHI) * sin(ph_r * 2 * $pi) / (2 * $pi);
      ph_l = ph_l - floor(ph_l);
      ph_r = ph_r - floor(ph_r);
      osc_l = sin(ph_l * 2 * $pi) * gain_l[i] * v_gain[i];
      osc_r = sin(ph_r * 2 * $pi) * gain_r[i] * v_gain[i];
    ) : wf == 6 ? (
      // Bell: additive partials at integer harmonics with bell-leaning
      // amplitude weights. Real bells have inharmonic partials (2.4, 4.5,
      // ...) but those create discontinuities at each phase wrap; integer
      // partials wrap cleanly. Result is a tonal-rich additive voice that
      // shimmers nicely under tremolo even if it isn't a true singing-bowl.
      ph_l = osc_phase_l[i];
      ph_r = osc_phase_r[i];
      osc_l = (
        sin(ph_l * 1 * 2 * $pi) +
        0.5  * sin(ph_l * 2 * 2 * $pi) +
        0.3  * sin(ph_l * 3 * 2 * $pi) +
        0.4  * sin(ph_l * 4 * 2 * $pi) +
        0.15 * sin(ph_l * 6 * 2 * $pi)
      ) * 0.43 * gain_l[i] * v_gain[i];
      osc_r = (
        sin(ph_r * 1 * 2 * $pi) +
        0.5  * sin(ph_r * 2 * 2 * $pi) +
        0.3  * sin(ph_r * 3 * 2 * $pi) +
        0.4  * sin(ph_r * 4 * 2 * $pi) +
        0.15 * sin(ph_r * 6 * 2 * $pi)
      ) * 0.43 * gain_r[i] * v_gain[i];
    ) : wf == 7 ? (
      // Wavefold: sine-of-sine with index 2. Soft, gentle harmonic
      // enrichment — like a sine that's been "warmed" without any harsh
      // edges. Stays in [-1, +1] naturally; no clipping artifacts.
      osc_l = sin(2 * sin(osc_phase_l[i] * 2 * $pi)) * gain_l[i] * v_gain[i];
      osc_r = sin(2 * sin(osc_phase_r[i] * 2 * $pi)) * gain_r[i] * v_gain[i];
    ) : wf == 8 ? (
      // Half-sine: full-wave rectified sine remapped to bipolar. Even
      // harmonics only — gives a hollow, vaguely-reedy character distinct
      // from any of the other waveforms. Has a small DC offset (mean ≈ 0.27)
      // which speakers won't reproduce; tremolo and pan attenuate it further.
      osc_l = (2 * abs(sin(osc_phase_l[i] * 2 * $pi)) - 1) * gain_l[i] * v_gain[i];
      osc_r = (2 * abs(sin(osc_phase_r[i] * 2 * $pi)) - 1) * gain_r[i] * v_gain[i];
    ) : wf == 9 ? (
      // Phi-cascade: additive harmonics with golden-ratio-decreasing
      // amplitudes — fundamental + (1/φ)*2nd + (1/φ²)*3rd. On theme with
      // the Golden TS/SG/GS family but uses pure additive synthesis rather
      // than phase warping. Continuous across phase wraps (integer harmonic
      // multipliers) so no discontinuity artifacts.
      ph_l = osc_phase_l[i];
      ph_r = osc_phase_r[i];
      osc_l = (
        sin(ph_l * 2 * $pi) +
        (1/PHI)       * sin(ph_l * 2 * 2 * $pi) +
        (1/(PHI*PHI)) * sin(ph_l * 3 * 2 * $pi)
      ) * 0.5 * gain_l[i] * v_gain[i];
      osc_r = (
        sin(ph_r * 2 * $pi) +
        (1/PHI)       * sin(ph_r * 2 * 2 * $pi) +
        (1/(PHI*PHI)) * sin(ph_r * 3 * 2 * $pi)
      ) * 0.5 * gain_r[i] * v_gain[i];
    ) : wf == 10 ? (
      // Phi Triangle: golden-ratio phase warp → TRIANGLE output. This is
      // what the manual originally described as "Golden TS" — but the
      // original polyrhythm slot 3 actually fed the warped phase into a
      // sine, not a triangle. Rather than silently changing slot 3 and
      // breaking existing project files that relied on the sine sound,
      // the triangle-output variant lives here at the end of the list.
      // Matches the corresponding "Phi Triangle" slot in Melody Phase.
      ph_l = osc_phase_l[i];
      ph_r = osc_phase_r[i];
      ph_l = ph_l < (1/PHI) ? ph_l * PHI * 0.5 : 0.5 + (ph_l - 1/PHI) / (1 - 1/PHI) * 0.5;
      ph_r = ph_r < (1/PHI) ? ph_r * PHI * 0.5 : 0.5 + (ph_r - 1/PHI) / (1 - 1/PHI) * 0.5;
      osc_l = (ph_l < 0.5 ? 4 * ph_l - 1 : 3 - 4 * ph_l) * gain_l[i] * v_gain[i];
      osc_r = (ph_r < 0.5 ? 4 * ph_r - 1 : 3 - 4 * ph_r) * gain_r[i] * v_gain[i];
    ) : wf == 11 ? (
      // Phi Sine: golden-ratio phase warp → sine output, with no extra
      // pre-warp. The "clean" version of what the manual described as
      // "Golden SG" — the original polyrhythm slot 4 had an additional
      // sine-prewarp stage before the golden warp that added harmonics
      // the docs didn't describe. Slot 4 keeps the original (bright)
      // sound for back-compat; this slot is the no-prewarp version.
      // Matches the corresponding "Phi Sine" slot in Melody Phase.
      ph_l = osc_phase_l[i];
      ph_r = osc_phase_r[i];
      ph_l = ph_l < (1/PHI) ? ph_l * PHI * 0.5 : 0.5 + (ph_l - 1/PHI) / (1 - 1/PHI) * 0.5;
      ph_r = ph_r < (1/PHI) ? ph_r * PHI * 0.5 : 0.5 + (ph_r - 1/PHI) / (1 - 1/PHI) * 0.5;
      osc_l = sin(ph_l * 2 * $pi) * gain_l[i] * v_gain[i];
      osc_r = sin(ph_r * 2 * $pi) * gain_r[i] * v_gain[i];
    ) : wf == 12 ? (
      // Square: +1 for the first half of the cycle, -1 for the second.
      // PolyBLEP-corrected at both discontinuities — the rising edge at
      // the phase wrap (0) and the falling edge at mid-cycle (0.5) — so
      // it stays clean at high fundamentals. dt is each channel's phase
      // increment per sample (left/right differ by the binaural offset).
      dt_l = v_freq_l[i] / srate;
      dt_r = v_freq_r[i] / srate;
      ph_l = osc_phase_l[i];
      ph_r = osc_phase_r[i];
      // Left: naive square + rising-edge BLEP - falling-edge BLEP.
      // td is the phase distance from the mid-cycle falling edge.
      sq_l = ph_l < 0.5 ? 1 : -1;
      td_l = ph_l - 0.5; td_l < 0 ? td_l += 1;
      sq_l = sq_l + polyblep(ph_l, dt_l) - polyblep(td_l, dt_l);
      osc_l = sq_l * gain_l[i] * v_gain[i];
      // Right
      sq_r = ph_r < 0.5 ? 1 : -1;
      td_r = ph_r - 0.5; td_r < 0 ? td_r += 1;
      sq_r = sq_r + polyblep(ph_r, dt_r) - polyblep(td_r, dt_r);
      osc_r = sq_r * gain_r[i] * v_gain[i];
    ) : (
      // Pulse: +1 while phase < pulse_duty, -1 otherwise. pulse_duty
      // (0..1) comes from slider15. At duty 0.5 this is identical to the
      // Square slot; narrower duty gets thinner and more nasal. PolyBLEP
      // at the rising edge (phase 0) and the falling edge (phase = duty).
      // A non-50% duty introduces a DC offset, which is inaudible on
      // speakers and attenuated by tremolo/master — same accepted
      // tradeoff as the Half-sine waveform.
      dt_l = v_freq_l[i] / srate;
      dt_r = v_freq_r[i] / srate;
      ph_l = osc_phase_l[i];
      ph_r = osc_phase_r[i];
      // Left: naive pulse + rising-edge BLEP - falling-edge BLEP.
      // td is the phase distance from the falling edge at `pulse_duty`.
      pu_l = ph_l < pulse_duty ? 1 : -1;
      td_l = ph_l - pulse_duty; td_l < 0 ? td_l += 1;
      pu_l = pu_l + polyblep(ph_l, dt_l) - polyblep(td_l, dt_l);
      osc_l = pu_l * gain_l[i] * v_gain[i];
      // Right
      pu_r = ph_r < pulse_duty ? 1 : -1;
      td_r = ph_r - pulse_duty; td_r < 0 ? td_r += 1;
      pu_r = pu_r + polyblep(ph_r, dt_r) - polyblep(td_r, dt_r);
      osc_r = pu_r * gain_r[i] * v_gain[i];
    );

    // Per-voice Gain drift (targets 73-80): a per-sample dB offset on
    // this voice's level, applied as a linear multiplier on its output
    // (matching v_gain's 10^(dB/20) convention). This is the dynamics
    // swell — voices rise and recede on their own schedules. In Both
    // modes slot 8+k follows V(k+1) via (i & 7). No-op when this voice
    // has no Gain drift configured.
    vg_drift_db = target_drift_offset[73 + (i & 7)];
    vg_drift_db != 0 ? (
      vg_mul = pow(10, vg_drift_db / 20);
      osc_l *= vg_mul;
      osc_r *= vg_mul;
    );

    pan_enabled ? (
      pan_mode >= 4 ? (
        // Per-cycle modes: THIS VOICE's own position in its own pattern,
        // already scaled by Pan Spread inside percycle_pan. The existing pan
        // smoother below turns each step into a short sweep, so even hard
        // Alternating at 100% spread cannot click.
        raw_pan = percycle_pan(pan_cycle_index[i], pan_cycle_steps);
      ) : pan_mode < 2 ? (
        // Tremolo / Increment: oscillating LFO drives raw_pan.
        // Pan Base Rate (target 82) + Pan Increment (target 83) drift
        // apply only in Increment mode (pan_mode == 1) — the modes that
        // use those controls. When either is active, recompute this
        // voice's pan freq from the drifted base + drifted increment.
        // Tremolo mode (pan_mode == 0) keeps following v_pan_freq[i]
        // (= the voice's tremolo rate), unchanged.
        pan_mode == 1 && (target_drift_offset[82] != 0 || target_drift_offset[83] != 0) ? (
          eff_pan_rate_i = (pan_base_rate + target_drift_offset[82]) + (pan_increment + target_drift_offset[83]) * i;
          eff_pan_freq   = rate_to_hz(eff_pan_rate_i, pan_rate_mode);
        ) : (
          eff_pan_freq = v_pan_freq[i];
        );
        // Which tempo factor rides this pan depends on which rate it is
        // following. Tremolo mode IS the voice's tremolo rate, so it takes the
        // main pair's combined_scale. Increment mode is the pan's own rate in
        // the pan's own mode, so it takes the pan's own host factor -- with
        // the Base Rate ramp still applied, because a ramp of the whole
        // pattern should carry the pan with it.
        pan_phase[i] += eff_pan_freq *
          (pan_mode == 0 ? combined_scale : speed_scale_current * pan_host_scale) / srate;
        pan_phase[i] >= 1 ? pan_phase[i] -= 1;
        raw_pan = sin(pan_phase[i] * 2 * $pi) * pan_spread;
      ) : (
        // Spread / Spread Reversed: static target, smoother handles transitions
        raw_pan = v_pan_static[i] * pan_spread;
      );

      pan_smooth[i] = pan_smooth[i] * pan_smooth_coeff + raw_pan * (1 - pan_smooth_coeff);

      // Apply pan as separate L/R multipliers — keeps osc_l and osc_r independent
      // so the binaural beat (frequency difference between channels) is preserved.
      // Collapsing to mono before panning would sum the channels and destroy it.
      pan_pos   = (pan_smooth[i] + 1.0) * 0.5;
      pan_l_mul = cos(pan_pos * $pi * 0.5);
      pan_r_mul = sin(pan_pos * $pi * 0.5);
      out_l += osc_l * pan_l_mul;
      out_r += osc_r * pan_r_mul;
    ) : (
      out_l += osc_l;
      out_r += osc_r;
    );
    );  // close "fully silent skip" ternary
  );
  i += 1;
);

// Normalize by the count of v_active voices — NOT by how many are
// currently audible. Counting only currently-audible voices makes the
// normalizer drop (and remaining voices get louder) every time a
// voice enters rest, then spike back up on wake. Stable divisor =
// stable level. total_active is precomputed in @slider, updated only
// when the user toggles a voice's Active state.
total_active > 0 ? (
  norm = 1.0 / total_active;
  spl0 = out_l * norm;
  spl1 = out_r * norm;
) : (
  spl0 = 0;
  spl1 = 0;
);

// ===== CHARACTER CHAIN =====
// Apply post-voice-sum character processing (Tone, Edge, Movement,
// Body). Runs only when there's audio (total_active > 0); during
// start delay or all-voices-off it stays bypassed since spl0/spl1
// would be 0 anyway.

// --- Tone (symmetric tilt EQ via one-pole lowpass split) ---
// Split into low + high using a one-pole lowpass at ~700 Hz, then
// apply symmetric boost/cut so the overall level stays neutral as
// the slider moves. tone_lo_gain and tone_hi_gain are precomputed
// in @slider — see the comments there for the gain mapping.
tone_lp_l = tone_lp_l * tone_lp_a + spl0 * tone_lp_b;
tone_lp_r = tone_lp_r * tone_lp_a + spl1 * tone_lp_b;
tone_hi_l = spl0 - tone_lp_l;
tone_hi_r = spl1 - tone_lp_r;
spl0 = tone_lp_l * tone_lo_gain + tone_hi_l * tone_hi_gain;
spl1 = tone_lp_r * tone_lo_gain + tone_hi_r * tone_hi_gain;

// --- Edge (soft-clip drive) ---
// Tanh saturation with gain compensation. Wet/dry mix prevents the
// distortion from taking over completely even at max setting.
edge_wet > 0 ? (
  spl0 = spl0 * (1 - edge_wet) + tanh(spl0 * edge_drive) / edge_drive * edge_wet;
  spl1 = spl1 * (1 - edge_wet) + tanh(spl1 * edge_drive) / edge_drive * edge_wet;
);

// --- Movement (stereo chorus from one delay buffer, two LFO taps) ---
// Write the dry signal (L+R averaged) into the circular buffer; read
// it back at two LFO-modulated positions for L and R. The two LFOs
// are phase-offset by 180° so the stereo motion is "out of phase"
// between channels — gives a wide swirling shimmer.
chorus_active ? (
  // Advance LFO
  chorus_lfo_phase += chorus_lfo_inc;
  chorus_lfo_phase >= 1 ? chorus_lfo_phase -= 1;
  chorus_lfo_l = sin(chorus_lfo_phase * 2 * $pi);
  chorus_lfo_r = sin((chorus_lfo_phase + 0.5) * 2 * $pi);  // 180° offset

  // Compute delay times in samples and read positions
  delay_l = (chorus_base_ms + chorus_depth_ms * chorus_lfo_l) * srate;
  delay_r = (chorus_base_ms + chorus_depth_ms * chorus_lfo_r) * srate;
  read_pos_l = chorus_write_pos - delay_l;
  read_pos_r = chorus_write_pos - delay_r;
  read_pos_l < 0 ? read_pos_l += chorus_buf_size;
  read_pos_r < 0 ? read_pos_r += chorus_buf_size;

  // Linear-interp read for L
  read_int_l  = floor(read_pos_l);
  read_frac_l = read_pos_l - read_int_l;
  read_int2_l = read_int_l + 1;
  read_int2_l >= chorus_buf_size ? read_int2_l -= chorus_buf_size;
  chorus_out_l = chorus_buf[read_int_l] * (1 - read_frac_l)
               + chorus_buf[read_int2_l] * read_frac_l;

  // Linear-interp read for R
  read_int_r  = floor(read_pos_r);
  read_frac_r = read_pos_r - read_int_r;
  read_int2_r = read_int_r + 1;
  read_int2_r >= chorus_buf_size ? read_int2_r -= chorus_buf_size;
  chorus_out_r = chorus_buf[read_int_r] * (1 - read_frac_r)
               + chorus_buf[read_int2_r] * read_frac_r;

  // Write the mono mix into the buffer, advance the write head
  chorus_buf[chorus_write_pos] = (spl0 + spl1) * 0.5;
  chorus_write_pos += 1;
  chorus_write_pos >= chorus_buf_size ? chorus_write_pos = 0;

  // Mix dry + delayed
  spl0 = spl0 * (1 - chorus_wet) + chorus_out_l * chorus_wet;
  spl1 = spl1 * (1 - chorus_wet) + chorus_out_r * chorus_wet;
);

// --- Body (peaking EQ at the root note frequency + makeup gain) ---
// Standard biquad direct-form-I. Per-channel state so L and R filter
// independently (preserves stereo image at the boost frequency). The
// makeup attenuation applied after the filter compensates for the
// peak's energy injection so overall loudness stays roughly neutral
// across the slider's range.
body_active ? (
  body_out_l = body_b0 * spl0 + body_b1 * body_x1_l + body_b2 * body_x2_l
             - body_a1 * body_y1_l - body_a2 * body_y2_l;
  body_x2_l = body_x1_l;  body_x1_l = spl0;
  body_y2_l = body_y1_l;  body_y1_l = body_out_l;
  spl0 = body_out_l * body_makeup;

  body_out_r = body_b0 * spl1 + body_b1 * body_x1_r + body_b2 * body_x2_r
             - body_a1 * body_y1_r - body_a2 * body_y2_r;
  body_x2_r = body_x1_r;  body_x1_r = spl1;
  body_y2_r = body_y1_r;  body_y1_r = body_out_r;
  spl1 = body_out_r * body_makeup;
);

);  // close start-delay else branch

@serialize
// Persist per-target drift + Speed Ramp configurations. Without this,
// only the most-recently-edited target's slider values survive a project
// save/load (sliders 75-78 / 65 hold whichever target was selected at
// save time).
//
// VERSION GUARD (2026-06-15). Polyrhythm's drift target count grew
// 13 -> 24 (v2.10 expressive drift) and gained the Speed Ramp `by` bank,
// both without versioning the serialize format — the stream began
// directly with target_drift_up[0]. Loading a v2.9 project (13-target,
// 53 floats) with 24-target reads runs the sequential file cursor past
// each array into the next, scrambling drift across targets and
// fabricating phantom drift on Base Rate + per-voice Rate + later targets
// — audible as voices drifting out of time even with no drift configured.
// We now lead with a count-encoded magic; on load, if it doesn't match
// this build's value the blob is a different/older format and we leave
// drift + Speed Ramp at the @init defaults (off), matching the suite's
// accepted "old drift configs reset, reconfigure" migration policy. A
// legacy blob's first float is up[0] in [0,20], which can never equal the
// magic, so v2.9 projects deterministically fall through to defaults.
// Magic bumped 1000000 -> 2100000 + N_TARGETS in v2.14 when Speed Ramp went
// PER-TARGET timeline (added the duration + start-delay banks). Older
// (1000000-base) blobs won't match and fall through to @init defaults — drift +
// ramp reset on upgrade (accepted; pre-release). Marker is float32-exact.
// Magic bumped 2100000 -> 2200000 base on 2026-09-07, when the twelve
// per-voice banks and the four drift/ramp play-rest banks joined the stream.
// A version bump proves you MEANT to change the format, not that you did --
// so every bank added here appears in BOTH this file_mem list AND the
// duplicate-fix block below, which is the check Heartbeat's near-miss earned.
// Magic bumped 2200000 -> 2300000 base on 2026-09-10: 88 targets and the three
// pitch-block banks. A save of EXACTLY 2200024 is read at its own width into the
// old24_* scratch banks and remapped; gated on the exact magic, per "migrate
// what was restored, never what was defaulted".
drift_ser_magic = 2300000 + N_TARGETS;   // 2300088 for this 88-target build
file_var(0, drift_ser_magic);
ser_ok = 0;
drift_ser_magic == 2300000 + N_TARGETS ? (
  file_mem(0, target_drift_up,    N_TARGETS);
  file_mem(0, target_drift_down,  N_TARGETS);
  file_mem(0, target_drift_per,   N_TARGETS);
  file_mem(0, target_drift_shape, N_TARGETS);
  file_var(0, last_target_select);
  file_mem(0, speed_ramp_by_mem,    N_TARGETS);
  file_mem(0, speed_ramp_dur_mem,   N_TARGETS);
  file_mem(0, speed_ramp_delay_mem, N_TARGETS);
  file_var(0, last_speed_target);
  file_mem(0, drift_play_mem, N_TARGETS);
  file_mem(0, drift_rest_mem, N_TARGETS);
  file_mem(0, sr_play_mem,    N_TARGETS);
  file_mem(0, sr_rest_mem,    N_TARGETS);
  file_mem(0, vm_note,   8);
  file_mem(0, vm_fine,   8);
  file_mem(0, vm_dr,     8);
  file_mem(0, vm_phoff,  8);
  file_mem(0, vm_wave,   8);
  file_mem(0, vm_depth,  8);
  file_mem(0, vm_ondur,  8);
  file_mem(0, vm_att,    8);
  file_mem(0, vm_rel,    8);
  file_mem(0, vm_gain,   8);
  file_mem(0, vm_active, 8);
  file_mem(0, vm_solo,   8);
  file_var(0, last_voice_sel);
  file_mem(0, vm_pmode,  8);
  file_mem(0, vm_pval,   8);
  file_mem(0, vm_funit,  8);
  ser_ok = 1;
) : drift_ser_magic == 2200024 ? (
  file_mem(0, old24_up,    24);
  file_mem(0, old24_down,  24);
  file_mem(0, old24_per,   24);
  file_mem(0, old24_shape, 24);
  file_var(0, ser_old_sel);
  file_mem(0, old24_by,    24);
  file_mem(0, old24_dur,   24);
  file_mem(0, old24_delay, 24);
  file_var(0, ser_old_sr);
  file_mem(0, old24_dplay, 24);
  file_mem(0, old24_drest, 24);
  file_mem(0, old24_splay, 24);
  file_mem(0, old24_srest, 24);
  file_mem(0, vm_note,   8);
  file_mem(0, vm_fine,   8);
  file_mem(0, vm_dr,     8);
  file_mem(0, vm_phoff,  8);
  file_mem(0, vm_wave,   8);
  file_mem(0, vm_depth,  8);
  file_mem(0, vm_ondur,  8);
  file_mem(0, vm_att,    8);
  file_mem(0, vm_rel,    8);
  file_mem(0, vm_gain,   8);
  file_mem(0, vm_active, 8);
  file_mem(0, vm_solo,   8);
  file_var(0, last_voice_sel);
  // Every target back to its default first: on a duplicate or an undo @init
  // does not run, so the banks could hold anything.
  ser_t = 0;
  loop(N_TARGETS,
    target_drift_up[ser_t] = 0; target_drift_down[ser_t] = 0;
    target_drift_per[ser_t] = 8; target_drift_shape[ser_t] = 0;
    speed_ramp_by_mem[ser_t] = 0; speed_ramp_dur_mem[ser_t] = 0;
    speed_ramp_delay_mem[ser_t] = 0;
    drift_play_mem[ser_t] = 0; drift_rest_mem[ser_t] = 0;
    sr_play_mem[ser_t] = 0; sr_rest_mem[ser_t] = 0;
    ser_t += 1;
  );
  ser_t = 0;
  loop(24,
    ser_n = poly_old_to_new(ser_t);
    poly_copy_old(ser_t, ser_n);
    ser_t += 1;
  );
  last_target_select = poly_old_to_new(ser_old_sel);
  last_speed_target  = poly_old_to_new(ser_old_sr);
  // A voice's note was an index into C2..C6; the list is now the full MIDI
  // range, so it gains 36. That MIDI note IS the pitch in Semitones, and the
  // fine tune it always had was cents.
  ser_v = 0;
  loop(8,
    vm_note[ser_v]  += 36;
    vm_pval[ser_v]  = vm_note[ser_v];
    vm_pmode[ser_v] = 1;
    vm_funit[ser_v] = 2;
    ser_v += 1;
  );
  ser_ok = 1;
);

// TRACK-DUPLICATE FIX, extended. On READ (file_avail >= 0) put every nested
// selector's visible controls back to the restored banks, including the
// selectors themselves, and refresh the mirrors to match -- otherwise the next
// @slider pass could read the restore as user edits and, parked on All or an
// all-voices entry, write them across eight voices.
ser_ok && file_avail(0) >= 0 ? (
  slider44 = last_target_select;
  slider52 = last_speed_target;
  dts = tgt_read_slot(last_target_select);
  srs = tgt_read_slot(last_speed_target);
  slider53 = speed_ramp_by_mem[srs];
  slider55 = speed_ramp_dur_mem[srs];
  slider59 = speed_ramp_delay_mem[srs];
  slider56 = sr_play_mem[srs];
  slider57 = sr_rest_mem[srs];
  slider45 = target_drift_up[dts];
  slider46 = target_drift_down[dts];
  slider47 = target_drift_per[dts];
  slider49 = target_drift_shape[dts];
  slider50 = drift_play_mem[dts];
  slider51 = drift_rest_mem[dts];
  dui_last[0] = slider45; dui_last[1] = slider46; dui_last[2] = slider47;
  dui_last[3] = slider49; dui_last[4] = slider50; dui_last[5] = slider51;
  dui_last[6] = slider53; dui_last[7] = slider55; dui_last[8] = slider59;
  dui_last[9] = slider56; dui_last[10] = slider57;

  slider15 = last_voice_sel;
  vrs = voice_read_slot(last_voice_sel);
  slider16 = vm_pmode[vrs];  slider17 = vm_note[vrs];
  slider18 = vm_pval[vrs];   slider19 = vm_fine[vrs];
  slider20 = vm_funit[vrs];
  slider21 = vm_dr[vrs];     slider22 = vm_phoff[vrs];
  slider23 = vm_wave[vrs];   slider24 = vm_depth[vrs];
  slider25 = vm_ondur[vrs];  slider26 = vm_att[vrs];
  slider27 = vm_rel[vrs];    slider28 = vm_gain[vrs];
  slider29 = vm_active[vrs]; slider30 = vm_solo[vrs];
  vui_last[0]  = slider16; vui_last[1]  = slider17; vui_last[2]  = slider18;
  vui_last[3]  = slider19; vui_last[4]  = slider20; vui_last[5]  = slider21;
  vui_last[6]  = slider22; vui_last[7]  = slider23; vui_last[8]  = slider24;
  vui_last[9]  = slider25; vui_last[10] = slider26; vui_last[11] = slider27;
  vui_last[12] = slider28; vui_last[13] = slider29; vui_last[14] = slider30;
  // sliderchange, NOT slider_automate: this is a restore.
  sliderchange(-1);
);
